<Application x:Class="Ecorex.Agent.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ecorex.Agent.Gui.Converters">
    <Application.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Paleta MONOCROMA de la colmena (translucida, oscura, sin color de marca). Los
             hexagonos activos brillan en blanco/gris; el error es el unico acento (rojo tenue). -->
        <Color x:Key="HiveBgColor">#161618</Color>
        <SolidColorBrush x:Key="HivePanel" Color="#E6161618" />
        <SolidColorBrush x:Key="HiveStroke" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="HiveStrokeSoft" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="HiveInk" Color="#F4F4F5" />
        <SolidColorBrush x:Key="HiveInkDim" Color="#8A8A93" />
        <SolidColorBrush x:Key="HiveFill" Color="#F2F2F3" />
        <SolidColorBrush x:Key="HiveFillDim" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="HiveError" Color="#E5556B" />
        <SolidColorBrush x:Key="HiveOnline" Color="#8FE3A2" />

        <!-- Panal AMBAR (rediseno 2026-08-15): celdas doradas con leve degradado vertical (look 3D
             embebido) y texto oscuro, para que el panal se vea como el mockup dorado. Solo aplica a las
             celdas (HexTile); los flyouts de config siguen oscuros para legibilidad. -->
        <LinearGradientBrush x:Key="HiveAmberFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F6C34A" Offset="0" />
            <GradientStop Color="#EDA92A" Offset="0.55" />
            <GradientStop Color="#E0930E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HiveAmberFillActive" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFD766" Offset="0" />
            <GradientStop Color="#F7B733" Offset="0.55" />
            <GradientStop Color="#EFA114" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="HiveAmberStroke" Color="#9A5B08" />
        <SolidColorBrush x:Key="HiveAmberInk" Color="#2A2004" />
        <Color x:Key="HiveAmberGlow">#FFCF4D</Color>
    </Application.Resources>
</Application>
