<Project Sdk="Microsoft.NET.Sdk">

  <!-- GUI colmena del Agente Conector On-Prem (Ola A: cascara visual). WPF, Windows-first (D7).
       UseWindowsForms se habilita SOLO para el NotifyIcon de la bandeja (System.Windows.Forms),
       evitando una dependencia NuGet externa. La app referencia SOLO los contratos compartidos. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ecorex.Agent.Gui</RootNamespace>
    <AssemblyName>Ecorex.Agent.Gui</AssemblyName>
    <!-- Version visible en la colmena (HiveViewModel.AgentVersion lee el assembly). Debe ir en linea
         con la version reportada al hub (RealHiveConnection.SafeHelloAsync) y con la del instalador
         (-p:ProductVersion). 1.9.2 -> 1.9.3: fix de guardar capacidad en servidor (ADR-0148).
         1.9.3 -> 1.9.4: alinea la version con el MSI que porta el tope del navegador delegado 3->20 min
         (ADR-0151); el fix de codigo vino en 60fc1075, este bump cierra la numeracion.
         1.9.4 -> 1.9.5: instalador robusto -quita la trampa de rollback por arranque del servicio-,
         valida la instalacion con la herramienta (verify) y trae la herramienta de purga (ADR-0152).
         1.9.5 -> 1.9.6: TLS 1.2 fijo + respaldo a transportes HTTP, para conectar desde Windows viejos
         sin TLS 1.3 (Server 2012); guardar identidad escribe la boveda directo; aplana el error TLS.
         1.9.6 -> 1.9.7: TLS adaptativo por SO (1.2+1.3 en modernos, 1.2 en Server 2012) para no limitar a
         los servidores modernos; diagnostico de TLS/arranque en el log; bump de version OBLIGA al MSI a
         sobrescribir los binarios (el de misma version 1.9.6 no reemplazaba Core.dll -> seguia el viejo).
         1.9.7 -> 1.9.8: el instalador ARRANCA el servicio al instalar (ServiceControl Start="install"
         Wait="no"); antes, en instalacion interactiva el servicio quedaba Stopped (exit 1077) porque el
         arranque dependia de una accion que solo corre desatendida. Sin "no conecta" por servicio apagado. -->
    <Version>1.9.8</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: WinForms sugiere configurar DPI por API; aqui el DPI lo gobierna el manifest para
         WPF (no llamamos ApplicationConfiguration.Initialize). Warning benigno, se silencia. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Ecorex.Contracts.Agent\Ecorex.Contracts.Agent.csproj" />
    <!-- Ola 5a (ADR-0039): el canal, el Gateway, Archivos, los stores y el MCP se fueron al Core
         (sin WPF), que comparte con el Worker Service. Aqui queda solo lo que pide escritorio. -->
    <ProjectReference Include="..\Ecorex.Agent.Core\Ecorex.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lo unico propio de esta capa: el navegador. WebView2 es un control visual y solo corre en
         sesion interactiva; por eso no puede vivir en el servicio (ADR-0039 s4). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

</Project>
