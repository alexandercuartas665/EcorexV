<Window x:Class="Ecorex.Agent.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Ecorex.Agent.Gui.Controls"
        Title="ECOREX - Agente Conector"
        Width="520" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.InputBindings>
        <!-- Atajos ocultos: Ctrl+D corre la DEMO (Ola A); Ctrl+K abre/cierra Configuracion. -->
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding RunDemoCommand}" />
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding ToggleConfigCommand}" />
    </Window.InputBindings>

    <!-- Rediseno 2026-08-15: SIN marco ni fondo oscuro. Solo el panal ambar flota sobre el escritorio
         (la Window ya es WindowStyle=None + AllowsTransparency + Background Transparent). La ventana se
         arrastra desde el area vacia del panal (OnDragBackground, con guardas) y cerrar/salir/mostrar
         viven en el icono de bandeja (clic derecho). -->
    <Border Background="Transparent" BorderThickness="0">
        <Grid Margin="2">
            <!-- Area del panal + flyouts superpuestos. Fondo Transparent para capturar el arrastre desde
                 cualquier punto (clic-vs-arrastre por umbral). Clic derecho = menu (Minimizar/Ocultar/Salir),
                 ya que no hay barra con botones. -->
            <Grid Background="Transparent"
                  MouseLeftButtonDown="OnDragBackground"
                  MouseMove="OnDragMove"
                  MouseLeftButtonUp="OnDragEnd">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Minimizar" Click="OnMinimize" />
                        <MenuItem Header="Ocultar a la bandeja" Click="OnClose" />
                        <Separator />
                        <MenuItem Header="Salir" Click="OnExitMenu" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <ItemsControl ItemsSource="{Binding Cells}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="18,6,18,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:HoneycombPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:HexTile Cursor="Hand" MouseLeftButtonUp="OnCellClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Flyout de configuracion (se muestra al hacer clic en la celda Configuracion). -->
                <Border Background="#F21B1B1E" CornerRadius="14" Margin="14"
                        Width="472" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        BorderBrush="{StaticResource HiveStroke}" BorderThickness="1"
                        Visibility="{Binding IsConfigOpen, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#000000" />
                    </Border.Effect>
                    <!-- 2 filas: contenido scrolleable (*) y barra de botones FIJA abajo (Auto).
                         Asi "Guardar"/"Probar conexion" quedan anclados y siempre visibles aunque
                         el contenido (campos + Registro) crezca. -->
                    <Grid Margin="20,18,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Configuracion del agente" Foreground="{StaticResource HiveInk}"
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="&#x2715;" Command="{Binding ToggleConfigCommand}"
                                            HorizontalAlignment="Right" Style="{DynamicResource ChromeButton}" />
                                </Grid>

                                <TextBlock Text="Client ID" Style="{DynamicResource FieldLabel}" Margin="0,16,0,0" />
                                <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource InkTextBox}" />

                                <!-- Tenant/cliente al que conecta: lo entrega el hub en el handshake (solo lectura). -->
                                <TextBlock Text="Tenant / Cliente conectado" Style="{DynamicResource FieldLabel}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding TenantDisplay}" Foreground="{StaticResource HiveInk}"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="URL del Hub (SignalR)" Style="{DynamicResource FieldLabel}" Margin="0,12,0,0" />
                                <TextBox Text="{Binding HubUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource InkTextBox}" />

                                <TextBlock Text="Secreto del cliente (opcional)" Style="{DynamicResource FieldLabel}" Margin="0,12,0,0" />
                                <TextBox Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource InkTextBox}" />

                                <!-- Estado de conexion. -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding IsOnline, Converter={StaticResource BoolToStatusBrush}}" />
                                    <TextBlock Text="Estado:" Foreground="{StaticResource HiveInkDim}"
                                               Margin="8,0,6,0" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource HiveInk}"
                                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Mini-registro de conexion: cada intento, la transicion y el motivo del fallo
                                     (mas nuevo arriba). Sin esto, "Probar conexion" no dejaba rastro accionable.
                                     "Copiar log" vuelca todo el Registro al portapapeles para pegarlo en soporte. -->
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Registro" Style="{DynamicResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Borrar log" Command="{Binding ClearLogCommand}"
                                                Style="{DynamicResource ChromeButton}" Width="Auto" Padding="8,0"
                                                FontSize="11" Margin="0,0,6,0" />
                                        <Button Content="Copiar log" Command="{Binding CopyLogCommand}"
                                                Style="{DynamicResource ChromeButton}" Width="Auto" Padding="8,0"
                                                FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="{StaticResource HiveStroke}"
                                        BorderThickness="1" Height="96">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                                        <ItemsControl ItemsSource="{Binding ConnectionLog}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource HiveInkDim}"
                                                               FontFamily="Consolas" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <!-- Version del agente (abajo-izquierda del flyout). -->
                            <TextBlock Text="{Binding AgentVersion}" Foreground="{StaticResource HiveInkDim}"
                                       FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Guardar" Command="{Binding SaveConfigCommand}"
                                        Style="{DynamicResource GhostButton}" />
                                <Button Content="Probar conexion" Command="{Binding TestConnectionCommand}"
                                        Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Flyout POR capacidad (Navegador/Archivos): consentimiento local + allow-list (doc 06 s4). -->
                <Border Background="#F21B1B1E" CornerRadius="14" Margin="14"
                        Width="472" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        BorderBrush="{StaticResource HiveStroke}" BorderThickness="1"
                        Visibility="{Binding IsCapConfigOpen, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#000000" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,18">
                        <Grid>
                            <TextBlock Text="{Binding CapTitle}" Foreground="{StaticResource HiveInk}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="&#x2715;" Command="{Binding CloseCapabilityCommand}"
                                    HorizontalAlignment="Right" Style="{DynamicResource ChromeButton}" />
                        </Grid>

                        <CheckBox Content="Habilitada por mi (el operador)" IsChecked="{Binding CapEnabled}"
                                  Foreground="{StaticResource HiveInk}" FontSize="12.5" Margin="0,16,0,0" />
                        <TextBlock Text="Sin habilitar, esta capacidad se rechaza aunque la nube la pida."
                                   Foreground="{StaticResource HiveInkDim}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Allow-list" Style="{DynamicResource FieldLabel}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding CapAllowText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource InkTextBox}" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top" Height="110"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" />
                        <TextBlock Text="{Binding CapHint}" Foreground="{StaticResource HiveInkDim}"
                                   FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <!-- Sesiones de login ADMINISTRABLES (SOLO Navegador): lista de perfiles (nombre + URL)
                             que el usuario administra. "Iniciar sesion" abre un navegador persistente para
                             loguearse a mano; el scraping reutiliza esa sesion por su clave (sessionKey). -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsBrowserCap, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Sesiones de login" Style="{DynamicResource FieldLabel}" />
                            <TextBlock Text="Inicia sesion a mano en cada sitio; el scraping reutiliza esa sesion por su clave (sessionKey)."
                                       Foreground="{StaticResource HiveInkDim}" FontSize="10.5"
                                       Margin="0,0,0,8" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding LoginProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#14FFFFFF" BorderBrush="{StaticResource HiveStroke}"
                                                BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource HiveInk}"
                                                               FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SessionKey}" Foreground="{StaticResource HiveInkDim}"
                                                               FontSize="10" FontFamily="Consolas" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="Iniciar sesion" Style="{DynamicResource GhostButton}"
                                                            Command="{Binding DataContext.OpenLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Quitar" Style="{DynamicResource ChromeButton}" Width="Auto" Padding="8,0" Margin="6,0,0,0" FontSize="11"
                                                            Command="{Binding DataContext.RemoveLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding Builtin, Converter={StaticResource InverseBoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Agregar sitio" Style="{DynamicResource FieldLabel}" Margin="0,8,0,0" />
                            <TextBox Text="{Binding NewLoginName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource InkTextBox}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding NewLoginUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource InkTextBox}" />
                            <TextBlock Text="Nombre (ej. MercadoLibre) + URL de login (https://...)."
                                       Foreground="{StaticResource HiveInkDim}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LoginError}" Foreground="#E5556B" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <Button Content="Agregar" Command="{Binding AddLoginCommand}"
                                    Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            <TextBlock Text="Para SCRAPEAR un sitio nuevo, agrega tambien su dominio a la Allow-list de arriba."
                                       Foreground="{StaticResource HiveInkDim}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                            <Button Content="Cerrar" Command="{Binding CloseCapabilityCommand}"
                                    Style="{DynamicResource GhostButton}" />
                            <Button Content="Guardar" Command="{Binding SaveCapabilityCommand}"
                                    Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <!-- Botones de la barra (minimizar/cerrar): planos, monocromos, hover tenue. -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource HiveInkDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource HiveInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de campo. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HiveInkDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Caja de texto monocroma. -->
        <Style x:Key="InkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource HiveInk}" />
            <Setter Property="CaretBrush" Value="{StaticResource HiveInk}" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource HiveStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton primario (relleno claro). -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#161618" />
            <Setter Property="Background" Value="{StaticResource HiveFill}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton fantasma (borde tenue). -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource HiveInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource HiveStroke}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
