<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicacion SELF-CONTAINED (win-x64) del Servicio Windows del Agente Colmena.
  La maquina cliente NO necesita instalar ningun runtime .NET: el runtime viaja dentro.

  Decision (ver ADR-0049 y installer/README): publicacion en CARPETA (no single-file).
  Motivo: el instalador WiX cosecha la carpeta con el elemento <Files> y necesita ver los
  archivos sueltos. Single-file complica WPF/WebView2 y no aporta aqui porque el MSI ya
  empaqueta todo. Sin PDB (DebugType none) para no versionar ni distribuir simbolos.

  El servicio y la GUI se publican en la MISMA carpeta staging: comparten el runtime
  (mismos net10.0-windows) y los .dll identicos se sobreescriben sin conflicto, evitando
  duplicar ~130 MB. Ver installer/build-installer.ps1.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
