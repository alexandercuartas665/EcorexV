<?xml version="1.0" encoding="utf-8"?>
<!-- Herramienta de purga/verificacion del Agente Colmena.
     asInvoker (NO requireAdministrator) a proposito: las operaciones que SI exigen admin (uninstall,
     verify) se AUTO-ELEVAN solas (UAC) desde el codigo; asi el modo 'show-result' -que solo lee un log
     y lo muestra en un cuadro- puede correr SIN elevacion desde la accion impersonada del instalador
     (una CA inmediata corre con el token del usuario, no elevado). Doble clic para purgar => la propia
     herramienta pide UAC una vez. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
