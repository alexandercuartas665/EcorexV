<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // Modo oscuro por clase en <html> con persistencia en localStorage. Corre antes
        // del CSS para evitar el destello claro. window.ecorexTheme.toggle() lo conmuta
        // (boton luna del sidebar); funciona igual en SSR y en paginas interactivas.
        (function () {
            var root = document.documentElement;
            // Estado de UI persistente por usuario: tema oscuro (clase 'dark') y colapso del menu
            // ('sidebar-collapsed'), ambos en <html> + localStorage. Se aplican ANTES del CSS para
            // evitar el destello claro y funcionan igual en SSR y en paginas interactivas.
            function applyUiState() {
                try {
                    root.classList.toggle('dark', localStorage.getItem('ecorex-theme') === 'dark');
                    root.classList.toggle('sidebar-collapsed', localStorage.getItem('ecorex-sidebar') === 'collapsed');
                } catch (e) { }
            }
            applyUiState();
            // Los toggles escriben localStorage PRIMERO y luego la clase, para que el observer de
            // abajo nunca "pelee" contra un cambio legitimo del usuario.
            window.ecorexTheme = {
                toggle: function () {
                    var dark = !root.classList.contains('dark');
                    try { localStorage.setItem('ecorex-theme', dark ? 'dark' : 'light'); } catch (e) { }
                    root.classList.toggle('dark', dark);
                }
            };
            window.ecorexSidebar = {
                toggle: function () {
                    var col = !root.classList.contains('sidebar-collapsed');
                    try { localStorage.setItem('ecorex-sidebar', col ? 'collapsed' : 'open'); } catch (e) { }
                    root.classList.toggle('sidebar-collapsed', col);
                }
            };
            // La navegacion mejorada de Blazor "morphea" el <html> a la respuesta del server (sin las
            // clases de estado): al saltar de modulo se perdian el tema oscuro y el colapso del menu.
            // Se re-aplica en cada enhancedload Y con un MutationObserver sobre la clase de <html> (red
            // de seguridad que cubre cualquier via de navegacion), de modo que AMBOS PERSISTEN siempre.
            document.addEventListener('enhancedload', applyUiState);
            try {
                new MutationObserver(function () {
                    var wantDark = localStorage.getItem('ecorex-theme') === 'dark';
                    var wantCol = localStorage.getItem('ecorex-sidebar') === 'collapsed';
                    if (wantDark !== root.classList.contains('dark') ||
                        wantCol !== root.classList.contains('sidebar-collapsed')) {
                        applyUiState();
                    }
                }).observe(root, { attributes: true, attributeFilter: ['class'] });
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    @* bpmn-js (editor de flujos, ADR-0034): estilos base de diagram-js + iconografia BPMN. *@
    <link rel="stylesheet" href="lib/bpmnio/diagram-js.css" />
    <link rel="stylesheet" href="lib/bpmnio/bpmn.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Ecorex.SuperAdmin.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    @* bpmn-js UMD (expone window.BpmnJS); el modulo interop ecorex-bpmn.js se importa on-demand. *@
    <script src="lib/bpmnio/bpmn-modeler.js"></script>
    <script src="js/wompi.js?v=3"></script>
    <script src="js/pipeline-dnd.js?v=3"></script>
    <script src="js/agent-editor.js?v=3"></script>
    <script src="js/task-timer.js?v=1"></script>
    <script src="js/board-list.js?v=3"></script>
    <script src="js/menu-config.js?v=1"></script>
    <script src="js/dc-canvas.js?v=2"></script>
    <script src="js/form-capture.js?v=2"></script>
    <script src="js/form-canvas.js?v=2"></script>
    <script src="js/gestor-documental.js?v=1"></script>
    @* Apache ECharts UMD (expone window.echarts) + interop del Motor de Reportes (dashboards, Ola 3). *@
    <script src="lib/echarts/echarts.min.js"></script>
    <script src="js/echart-interop.js?v=1"></script>
    @* Interop de Bold Reports (Ola 2): pequenio; los assets pesados de Bold los carga on-demand. *@
    <script src="js/boldreports-interop.js?v=4"></script>
</body>

</html>
