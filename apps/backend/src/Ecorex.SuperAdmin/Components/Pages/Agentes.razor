    private async Task LoadCierreAsync(Guid agentId)
    {
        var cfg = await CierreSvc.GetConfigAsync(agentId);
        _cierreOlvidar = cfg.Olvidar;
        _cierreAlertas = (cfg.Alertas ?? Array.Empty<AgentCierreAlerta>())
            .Select(a => new CierreAlertaRow
            {
                Canal = a.Canal,
                Destino = a.Destino,
                UsuarioId = a.UsuarioId?.ToString(),
                LineaId = a.LineaId?.ToString(),
                Plantilla = a.Plantilla,
                Idioma = a.Idioma,
                Asunto = a.Asunto,
                GrupoJid = a.GrupoJid,
                ChatId = a.ChatId
            }).ToList();
        _cierreSaved = false;
        _cierreError = null;
        _cierreDataLoaded = false;
    }

    private async Task ToggleCierreAsync()
    {
        _cierreOpen = !_cierreOpen;
        if (_cierreOpen && !_cierreDataLoaded)
        {
            _cierreUsers = (await TenantUsersSvc.ListAsync()).ToList();
            _cierreLines = (await LinesSvc.ListAsync()).ToList();
            _cierreTemplates = (await TemplatesSvc.ListAsync()).ToList();
            var tg = await TelegramSvc.GetAsync();
            _tgHasToken = tg.HasToken;
            _tgUsername = tg.BotUsername;
            _tgEnabled = tg.IsEnabled;
            _tgToken = null;
            _tgSaved = false;
            _cierreDataLoaded = true;
        }
    }

    private async Task SaveTelegramAsync()
    {
        _tgSaved = false;
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var tg = await TelegramSvc.SaveAsync(_tgToken, _tgUsername, _tgEnabled, actor);
            _tgHasToken = tg.HasToken;
            _tgUsername = tg.BotUsername;
            _tgEnabled = tg.IsEnabled;
            _tgToken = null; // no se conserva en pantalla
            _tgSaved = true;
        }
        finally { _busy = false; }
    }

    private void AddCierreAlerta() { _cierreAlertas.Add(new CierreAlertaRow()); _cierreSaved = false; }
    private void RemoveCierreAlerta(CierreAlertaRow r) { _cierreAlertas.Remove(r); _cierreSaved = false; }

    private async Task SaveCierreAsync()
    {
        if (_editId is not Guid id) { return; }
        _cierreError = null;
        _busy = true;
        try
        {
            var alertas = _cierreAlertas.Select(r => new AgentCierreAlerta(
                r.Canal,
                r.Destino,
                Guid.TryParse(r.UsuarioId, out var uid) ? uid : (Guid?)null,
                Guid.TryParse(r.LineaId, out var lid) ? lid : (Guid?)null,
                string.IsNullOrWhiteSpace(r.Plantilla) ? null : r.Plantilla,
                string.IsNullOrWhiteSpace(r.Idioma) ? null : r.Idioma,
                string.IsNullOrWhiteSpace(r.Asunto) ? null : r.Asunto,
                string.IsNullOrWhiteSpace(r.GrupoJid) ? null : r.GrupoJid!.Trim(),
                string.IsNullOrWhiteSpace(r.ChatId) ? null : r.ChatId!.Trim())).ToList();

            // Validacion minima por canal.
            var perUser = new[] { CierreCanal.Correo, CierreCanal.WhatsApp };
            foreach (var a in alertas)
            {
                if (perUser.Contains(a.Canal) && a.Destino == CierreDestino.Usuario && a.UsuarioId is null)
                { _cierreError = "Elige el usuario destino en cada alerta 'Otro usuario'."; return; }
                if (a.Canal == CierreCanal.WhatsApp && string.IsNullOrWhiteSpace(a.Plantilla))
                { _cierreError = "Elige la plantilla en cada alerta de WhatsApp."; return; }
                if (a.Canal == CierreCanal.WhatsAppGrupo && string.IsNullOrWhiteSpace(a.GrupoJid))
                { _cierreError = "Indica el jid del grupo (...@g.us) en cada alerta de grupo."; return; }
                if (a.Canal == CierreCanal.Telegram && string.IsNullOrWhiteSpace(a.ChatId))
                { _cierreError = "Indica el chat_id en cada alerta de Telegram."; return; }
            }

            var actor = await ActorAsync();
            var ok = await CierreSvc.SaveConfigAsync(id, new AgentCierreConfig(_cierreOlvidar, alertas), actor);
            _cierreSaved = ok;
            if (!ok) { _cierreError = "No se pudo guardar."; }
        }
        finally { _busy = false; }
    }

    private async Task SaveAgentAsync()
    {
        _editorError = null;
        if (string.IsNullOrWhiteSpace(_fName)) { _editorError = "El nombre es obligatorio."; return; }
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var model = EffectiveModel(_fProvider);
            if (_editId is null)
            {
                var created = await AgentsSvc.CreateAsync(new CreateAiAgentRequest(_fName, _fRole, _fProvider, model, _fPrompt, _disabledTools.ToList(), _fReactionsEnabled, _fReactionN, _fReactionM, _fReactionEmojis), actor);
                if (created is null) { _editorError = "No se pudo crear el agente."; return; }
                _editId = created.Id;
                await ReloadCacheAsync(_editId.Value);
            }
            else
            {
                await AgentsSvc.UpdateAsync(_editId.Value, new UpdateAiAgentRequest(_fName, _fRole, _fProvider, model, _fPrompt, _disabledTools.ToList(), _fReactionsEnabled, _fReactionN, _fReactionM, _fReactionEmojis, _fAllowedBoardIds.ToList()), actor);
                await ReloadVersionsAsync(_editId.Value);
            }
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

