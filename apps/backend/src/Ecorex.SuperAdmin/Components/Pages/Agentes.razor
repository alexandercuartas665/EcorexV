    // ===== Eliminar agente (doble confirmacion) =====
    private void OpenDeleteAgent(AiAgentDto a)
    {
        _deleteAgent = a;
        _deleteStep = 1;
        _delResourcesCount = a.ResourceCount;
        _delPromptsCount = 0;
        _delCacheFieldsCount = 0;
        _delConfirmName = "";
        _delError = null;
    }

    private void CloseDeleteAgent()
    {
        _deleteAgent = null;
        _deleteStep = 1;
        _delConfirmName = "";
        _delError = null;
    }

    private async Task GoToDeleteStep2()
    {
        if (_deleteAgent is null) { return; }
        // Cargamos las cuentas exactas justo antes del paso 2 para que el usuario vea que se borrara.
        try
        {
            var detail = await AgentsSvc.GetAsync(_deleteAgent.Id);
            if (detail is not null)
            {
                _delResourcesCount = detail.Resources.Count;
                _delPromptsCount = detail.Prompts.Count;
            }
            _delCacheFieldsCount = (await CacheSvc.ListFieldsAsync(_deleteAgent.Id)).Count;
        }
        catch { /* si fallan las cuentas seguimos con los valores por defecto */ }
        _deleteStep = 2;
    }

    private async Task ConfirmDeleteAgentAsync()
    {
        if (_deleteAgent is null) { return; }
        if (!string.Equals(_delConfirmName, _deleteAgent.Name, StringComparison.Ordinal))
        {
            _delError = "El nombre no coincide.";
            return;
        }
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var ok = await AgentsSvc.DeleteAsync(_deleteAgent.Id, actor);
            if (!ok) { _delError = "No se pudo eliminar el agente."; return; }
            CloseDeleteAgent();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _delError = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task DeleteResourceAsync(Guid id)
    {
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            await AgentsSvc.DeleteResourceAsync(id, actor);
            _resources.RemoveAll(x => x.Id == id);
        }
        finally { _busy = false; }
    }

    // Hint del navegador para el selector de archivo segun el tipo de recurso.
    private static string? AcceptFor(AgentResourceType t) => t switch
    {
        AgentResourceType.Image => "image/png,image/jpeg",
        AgentResourceType.Video => "video/mp4,video/3gpp",
        AgentResourceType.Audio => "audio/ogg,audio/mpeg,audio/mp4",
        AgentResourceType.Pdf => "application/pdf",
        _ => null
    };

    private async Task<(string Url, string Name)?> SaveAgentFileAsync(IBrowserFile file)
    {
        const long max = 25L * 1024 * 1024;
        if (file.Size <= 0 || file.Size > max) { return null; }
        using var ms = new MemoryStream();
        await file.OpenReadStream(max).CopyToAsync(ms);
        var ext = System.IO.Path.GetExtension(file.Name);
        var dir = System.IO.Path.Combine(Env.WebRootPath, "uploads", "agents");
        System.IO.Directory.CreateDirectory(dir);
        var name = $"agent-{Guid.NewGuid():N}{ext}";
        await System.IO.File.WriteAllBytesAsync(System.IO.Path.Combine(dir, name), ms.ToArray());
        return ($"/uploads/agents/{name}", file.Name);
    }

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

