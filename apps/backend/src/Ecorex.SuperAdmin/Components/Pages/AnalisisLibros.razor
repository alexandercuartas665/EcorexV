@page "/analisis"
@attribute [Authorize(Policy = "Perm:analisis:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Ecorex.Application.Analisis
@using Ecorex.Application.Reporting
@using Ecorex.Application.Roles
@using Ecorex.SuperAdmin.Auth
@using Ecorex.SuperAdmin.Components.Shared.Analisis
@inject IAnalisisService Svc
@inject IAnalisisWidgetRunner Runner
@inject ICurrentPermissions Perms
@inject AuthenticationStateProvider AuthProvider

@* Libros de indicadores (ADR-0158 Ola 2): libro -> hojas (tabs) -> grilla de widgets de 4 columnas.
   Esta pagina es UNA superficie; el pintado de cada widget vive en el componente reutilizable
   Shared/Analisis/AnalisisWidgetCard. Los widgets de una hoja se cargan EN SERIE (uno a la vez) para no
   compartir el DbContext del circuito en paralelo (ADR-0157); un widget roto no tumba la hoja. *@

<PageTitle>Libros de indicadores - ECOREX.tareas</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <span class="cur">Libros de indicadores</span>
</nav>

<div class="an-head">
    <div>
        <h1 class="an-h1">@(_libro?.Nombre ?? "Libros de indicadores")</h1>
        <p class="an-sub">@(_libro?.Descripcion ?? "Hojas de indicadores sobre el Directorio, las Tareas y los Contenedores.")</p>
    </div>
    <div class="an-head-actions">
        @if (_libros.Count > 0)
        {
            <select class="an-select" value="@_libro?.Id" @onchange="CambiarLibroAsync" aria-label="Libro">
                @foreach (var l in _libros)
                {
                    <option value="@l.Id">@l.Nombre</option>
                }
            </select>
        }
        @if (_canCreate)
        {
            <button class="an-btn primary" @onclick="() => _modal = Modal.NuevoLibro">+ Nuevo libro</button>
        }
    </div>
</div>

@if (_mensaje is not null)
{
    <div class="an-alert">@_mensaje <button class="an-x" @onclick="() => _mensaje = null">&#215;</button></div>
}

@if (_cargando)
{
    <p class="an-muted">Cargando...</p>
}
else if (_libro is null)
{
    <div class="an-empty">
        <div class="an-empty-ico">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <strong>Aun no hay libros de indicadores</strong>
        <span class="an-muted">Crea un libro, agrega hojas y pon en cada hoja los widgets que quieras.</span>
        @if (_canCreate)
        {
            <button class="an-btn primary" @onclick="() => _modal = Modal.NuevoLibro">+ Nuevo libro</button>
        }
    </div>
}
else
{
    <div class="an-tabs" role="tablist">
        @foreach (var h in _libro.Hojas)
        {
            <button class="an-tab @(h.Id == _hojaId ? "active" : "")" role="tab" @onclick="() => SeleccionarHojaAsync(h.Id)">@h.Nombre</button>
        }
        @if (_libro.PuedeEditar)
        {
            <button class="an-tab add" @onclick="() => _modal = Modal.NuevaHoja">+ Nueva hoja</button>
        }
        <span class="an-tabs-fill"></span>
        @if (_libro.PuedeEditar && Hoja is not null)
        {
            <button class="an-btn sm" @onclick="() => _modal = Modal.AgregarWidget">+ Agregar widget</button>
            <button class="an-btn sm" @onclick="AbrirRenombrarHoja">Renombrar hoja</button>
            @if (_libro.Hojas.Count > 1)
            {
                <button class="an-btn sm danger" @onclick="EliminarHojaAsync">Eliminar hoja</button>
            }
        }
    </div>

    @if (Hoja is not null)
    {
        @if (Hoja.Widgets.Count == 0)
        {
            <div class="an-empty sm">
                <strong>Esta hoja esta vacia</strong>
                <span class="an-muted">Agrega un widget para empezar.</span>
            </div>
        }
        else
        {
            <div class="an-grid">
                @foreach (var w in Hoja.Widgets)
                {
                    <AnalisisWidgetCard @key="w.Id" Widget="w"
                                        Resultado="@(_resultados.TryGetValue(w.Id, out var r) ? r : null)"
                                        PuedeEditar="_libro.PuedeEditar"
                                        OnMover="d => MoverAsync(w.Id, d)"
                                        OnAncho="n => AnchoAsync(w.Id, n)"
                                        OnEliminar="() => QuitarWidgetAsync(w.Id)" />
                }
            </div>
        }
    }
}

@if (_modal != Modal.Ninguno)
{
    <div class="an-backdrop" @onclick="Cerrar"></div>
    <div class="an-modal" role="dialog" aria-modal="true">
        @switch (_modal)
        {
            case Modal.NuevoLibro:
                <h3 class="an-modal-title">Nuevo libro</h3>
                <label class="an-lbl">Nombre</label>
                <input class="an-input" @bind="_nombre" @bind:event="oninput" maxlength="150" placeholder="Ej. Indicadores comerciales" />
                <label class="an-lbl">Descripcion (opcional)</label>
                <input class="an-input" @bind="_descripcion" maxlength="1000" />
                <div class="an-modal-foot">
                    <button class="an-btn" @onclick="Cerrar">Cancelar</button>
                    <button class="an-btn primary" disabled="@string.IsNullOrWhiteSpace(_nombre)" @onclick="CrearLibroAsync">Crear</button>
                </div>
                break;

            case Modal.NuevaHoja:
            case Modal.RenombrarHoja:
                <h3 class="an-modal-title">@(_modal == Modal.NuevaHoja ? "Nueva hoja" : "Renombrar hoja")</h3>
                <label class="an-lbl">Nombre de la hoja</label>
                <input class="an-input" @bind="_nombre" @bind:event="oninput" maxlength="120" placeholder="Ej. Ventas" />
                <div class="an-modal-foot">
                    <button class="an-btn" @onclick="Cerrar">Cancelar</button>
                    <button class="an-btn primary" disabled="@string.IsNullOrWhiteSpace(_nombre)" @onclick="GuardarHojaAsync">Guardar</button>
                </div>
                break;

            case Modal.AgregarWidget:
                <h3 class="an-modal-title">Agregar widget</h3>
                <p class="an-muted" style="margin:0 0 12px">Widgets de ejemplo. El configurador completo (fuente, medida, dimension, filtros) llega en la proxima ola.</p>
                <div class="an-pick">
                    @foreach (var e in AnalisisEjemplos.Catalogo)
                    {
                        <button class="an-pick-item" @onclick="() => AgregarEjemploAsync(e.Key)">
                            <span class="an-pick-tipo">@e.Widget.Tipo</span>
                            <span>@e.Widget.Titulo</span>
                        </button>
                    }
                </div>
                <div class="an-modal-foot">
                    <button class="an-btn" @onclick="Cerrar">Cerrar</button>
                </div>
                break;
        }
    </div>
}

@code {
    private const string ModuleKey = "analisis";

    private enum Modal { Ninguno, NuevoLibro, NuevaHoja, RenombrarHoja, AgregarWidget }

    private AnalisisActor _actor = new(null, false);
    private bool _canCreate;
    private bool _cargando = true;
    private IReadOnlyList<AnalisisLibroResumen> _libros = Array.Empty<AnalisisLibroResumen>();
    private AnalisisLibroDetalle? _libro;
    private Guid? _hojaId;
    private readonly Dictionary<Guid, AnalisisWidgetResultado> _resultados = new();
    private Modal _modal;
    private string? _nombre;
    private string? _descripcion;
    private string? _mensaje;
    private int _cargaVersion;

    private AnalisisHojaDto? Hoja => _libro?.Hojas.FirstOrDefault(h => h.Id == _hojaId);

    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        var admin = await Perms.IsUnrestrictedAsync();
        _canCreate = admin || eff.Can(ModuleKey, PermissionAction.Create) || eff.Can(ModuleKey, PermissionAction.Edit);
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        Guid? userId = Guid.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var u) ? u : null;
        _actor = new AnalisisActor(userId, admin);

        _libros = await Svc.ListarLibrosAsync(_actor);
        if (_libros.Count > 0)
        {
            await AbrirLibroAsync(_libros[0].Id);
        }

        _cargando = false;
    }

    private async Task AbrirLibroAsync(Guid libroId, Guid? hojaId = null)
    {
        _libro = await Svc.ObtenerLibroAsync(libroId, _actor);
        var hoja = _libro?.Hojas.FirstOrDefault(h => h.Id == hojaId) ?? _libro?.Hojas.FirstOrDefault();
        _hojaId = hoja?.Id;
        await CargarWidgetsAsync();
    }

    /// <summary>Ejecuta los widgets de la hoja visible EN SERIE, pintando cada uno al llegar.</summary>
    private async Task CargarWidgetsAsync(bool soloFaltantes = false)
    {
        var version = ++_cargaVersion;
        if (!soloFaltantes)
        {
            _resultados.Clear();
        }

        var hoja = Hoja;
        if (hoja is null)
        {
            return;
        }

        StateHasChanged();
        var ctx = new ReportContext(Guid.Empty, _actor.UserId); // el tenant real lo fija el filtro EF
        foreach (var w in hoja.Widgets)
        {
            if (soloFaltantes && _resultados.ContainsKey(w.Id))
            {
                continue;
            }

            var r = await Runner.RunAsync(w, ctx);
            if (version != _cargaVersion)
            {
                return; // el usuario cambio de hoja/libro mientras cargaba
            }

            _resultados[w.Id] = r;
            StateHasChanged();
        }
    }

    private async Task CambiarLibroAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            await AbrirLibroAsync(id);
        }
    }

    private async Task SeleccionarHojaAsync(Guid hojaId)
    {
        _hojaId = hojaId;
        await CargarWidgetsAsync();
    }

    private void Cerrar()
    {
        _modal = Modal.Ninguno;
        _nombre = null;
        _descripcion = null;
    }

    private void AbrirRenombrarHoja()
    {
        _nombre = Hoja?.Nombre;
        _modal = Modal.RenombrarHoja;
    }

    private async Task CrearLibroAsync()
    {
        var r = await Svc.CrearLibroAsync(_nombre ?? string.Empty, _descripcion, _actor);
        if (!Resultado(r))
        {
            return;
        }

        Cerrar();
        _libros = await Svc.ListarLibrosAsync(_actor);
        await AbrirLibroAsync(r.Id!.Value);
    }

    private async Task GuardarHojaAsync()
    {
        if (_libro is null)
        {
            return;
        }

        var r = _modal == Modal.NuevaHoja
            ? await Svc.CrearHojaAsync(_libro.Id, _nombre ?? string.Empty, _actor)
            : await Svc.RenombrarHojaAsync(_hojaId!.Value, _nombre ?? string.Empty, _actor);
        if (!Resultado(r))
        {
            return;
        }

        Cerrar();
        await AbrirLibroAsync(_libro.Id, r.Id);
    }

    private async Task EliminarHojaAsync()
    {
        if (_libro is null || _hojaId is null)
        {
            return;
        }

        if (Resultado(await Svc.EliminarHojaAsync(_hojaId.Value, _actor)))
        {
            await AbrirLibroAsync(_libro.Id);
        }
    }

    private async Task AgregarEjemploAsync(string key)
    {
        var ejemplo = AnalisisEjemplos.Find(key);
        if (ejemplo is null || _libro is null || _hojaId is null)
        {
            return;
        }

        var r = await Svc.AgregarWidgetAsync(_hojaId.Value, ejemplo.Widget, _actor);
        if (!Resultado(r))
        {
            return;
        }

        Cerrar();
        await RecargarLayoutAsync();
    }

    private async Task MoverAsync(Guid widgetId, int delta)
    {
        if (Resultado(await Svc.MoverWidgetAsync(widgetId, delta, _actor)))
        {
            await RecargarLayoutAsync();
        }
    }

    private async Task AnchoAsync(Guid widgetId, int colSpan)
    {
        if (Resultado(await Svc.CambiarAnchoWidgetAsync(widgetId, colSpan, _actor)))
        {
            await RecargarLayoutAsync();
        }
    }

    private async Task QuitarWidgetAsync(Guid widgetId)
    {
        if (Resultado(await Svc.EliminarWidgetAsync(widgetId, _actor)))
        {
            _resultados.Remove(widgetId);
            await RecargarLayoutAsync();
        }
    }

    /// <summary>Relee el libro conservando los resultados ya calculados; solo ejecuta los widgets nuevos.</summary>
    private async Task RecargarLayoutAsync()
    {
        if (_libro is null)
        {
            return;
        }

        _libro = await Svc.ObtenerLibroAsync(_libro.Id, _actor);
        await CargarWidgetsAsync(soloFaltantes: true);
    }

    private bool Resultado(AnalisisOpResult r)
    {
        _mensaje = r.Ok ? null : r.Error;
        return r.Ok;
    }
}
