@page "/a/{Token}"
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Analisis
@using Ecorex.Application.Reporting
@using Ecorex.SuperAdmin.Auth
@using Ecorex.SuperAdmin.Components.Shared.Analisis
@inject IAnalisisCompartirService Compartir
@inject IAnalisisWidgetRunner Runner
@inject IReportCatalog Catalogo
@inject IAnalisisZonaHoraria ZonaHoraria
@implements IDisposable

@* Visor publico de SOLO LECTURA de un libro de indicadores (ADR-0158 D7, Ola 6). Sin policy: el acceso lo
   gobierna el token opaco (solo se guarda su hash; rotable, revocable, con expiracion opcional; tope de
   aperturas por IP en Program.cs). La resolucion del token es el UNICO punto cross-tenant; resuelto, cada
   lectura corre con el tenant del token fijado como ambient (AmbientTenantContext.Begin). Se comparte la
   DEFINICION: los datos son en vivo.
   Filtros (Ola 7c): quien abre el enlace puede filtrar la hoja (barra de fechas / vendedor / tablero) y tocar
   un grafico para filtrar los demas. Son TEMPORALES: viven en su vista, no cambian el libro. Los filtros
   GUARDADOS en la hoja son fijos: solo se pueden acotar, nunca ampliar ni quitar (HojaFiltros.DentroDe).
   "Ver registros" solo si el enlace lo permite (AnalisisLibroToken.PermiteRegistros, lo activa un Admin al
   compartir): el token se vuelve a validar en CADA consulta de registros, respeta los filtros fijos y las
   filas no abren la tarea ni el tercero (eso exige sesion). *@

<PageTitle>@(_libro?.Nombre ?? "Libro de indicadores")</PageTitle>

<div class="ap-shell">
    @if (_cargando)
    {
        <p class="ap-muted">Validando enlace...</p>
    }
    else if (_libro is null)
    {
        <div class="ap-neutral">
            <h2>Enlace no disponible</h2>
            <p>Este enlace no esta disponible. Verifica con quien te lo compartio.</p>
        </div>
    }
    else
    {
        <header class="ap-head">
            <div>
                <h1>@_libro.Nombre</h1>
                @if (!string.IsNullOrWhiteSpace(_libro.Descripcion))
                {
                    <p>@_libro.Descripcion</p>
                }
            </div>
            <div class="ap-head-actions">
                <span class="ap-badge">Solo lectura - datos en vivo</span>
                <button class="ap-btn" onclick="window.print()">Imprimir</button>
            </div>
        </header>

        @if (_libro.Hojas.Count > 1)
        {
            <nav class="ap-tabs" role="tablist">
                @foreach (var h in _libro.Hojas)
                {
                    <button class="ap-tab @(h.Id == _hojaId ? "active" : "")" role="tab" @onclick="() => MostrarHojaAsync(h.Id)">@h.Nombre</button>
                }
            </nav>
        }

        @if (Hoja is { } hoja)
        {
            var fijos = Fijos;
            <div class="ap-filters" aria-label="Filtros de la hoja">
                <div class="ap-f">
                    <label>Desde</label>
                    <input type="date" class="ap-input" value="@Fecha(_fDesde)" min="@Fecha(fijos.Desde)" max="@Fecha(fijos.Hasta)"
                           @onchange="e => _fDesde = ParseFecha(e.Value)" />
                </div>
                <div class="ap-f">
                    <label>Hasta</label>
                    <input type="date" class="ap-input" value="@Fecha(_fHasta)" min="@Fecha(fijos.Desde)" max="@Fecha(fijos.Hasta)"
                           @onchange="e => _fHasta = ParseFecha(e.Value)" />
                </div>
                <div class="ap-f">
                    <label>Vendedor</label>
                    <input class="ap-input" value="@_fVendedor" @onchange="e => _fVendedor = e.Value?.ToString()" placeholder="Todos"
                           disabled="@(!string.IsNullOrWhiteSpace(fijos.Vendedor))" title="@(string.IsNullOrWhiteSpace(fijos.Vendedor) ? null : "Fijado por quien compartio")" />
                </div>
                <div class="ap-f">
                    <label>Tablero</label>
                    <input class="ap-input" value="@_fTablero" @onchange="e => _fTablero = e.Value?.ToString()" placeholder="Todos"
                           disabled="@(!string.IsNullOrWhiteSpace(fijos.Tablero))" title="@(string.IsNullOrWhiteSpace(fijos.Tablero) ? null : "Fijado por quien compartio")" />
                </div>
                <div class="ap-f-actions">
                    <button class="ap-btn primary" @onclick="AplicarFiltrosAsync">Aplicar</button>
                    @if (_filtrosTemporales is not null)
                    {
                        <button class="ap-btn" @onclick="RestablecerFiltrosAsync">Restablecer</button>
                    }
                </div>
                @if (_filtrosTemporales is not null)
                {
                    <span class="ap-f-note">Filtro temporal: solo para tu vista, no cambia el libro.</span>
                }
                @if (!fijos.Vacio)
                {
                    <span class="ap-f-note fijo">Fijado por quien compartio (solo se puede acotar): @Resumen(fijos)</span>
                }
            </div>

            @if (_cruces.Count > 0)
            {
                <div class="ap-cruces" aria-label="Filtros por clic">
                    <span class="ap-cruces-lbl">Filtrado al tocar:</span>
                    @foreach (var s in _cruces)
                    {
                        <span class="ap-cruce" title="Desde el indicador: @s.OrigenTitulo">
                            @s.Etiqueta
                            <button type="button" aria-label="Quitar filtro" @onclick="() => QuitarCruceAsync(s.OrigenWidgetId)">&#215;</button>
                        </span>
                    }
                    @if (_cruces.Count > 1)
                    {
                        <button type="button" class="ap-link" @onclick="LimpiarCrucesAsync">Quitar todos</button>
                    }
                </div>
            }
            else if (hoja.Widgets.Any(AnalisisCruce.AdmiteSeleccion))
            {
                <p class="ap-hint">Toca una barra, un sector, una celda o un dia de un grafico para filtrar la hoja.</p>
            }

            @if (hoja.Widgets.Count == 0)
            {
                <p class="ap-muted">Esta hoja no tiene indicadores.</p>
            }
            else
            {
                <div class="ap-grid">
                    @foreach (var w in hoja.Widgets)
                    {
                        <AnalisisWidgetCard @key="w.Id" Widget="w" Resultado="@(_resultados.TryGetValue(w.Id, out var r) ? r : null)"
                                            OnFiltrar="FiltrarPorClicAsync"
                                            OnVerRegistros="VerRegistrosCallback"
                                            Seleccion="@_cruces.FirstOrDefault(c => c.OrigenWidgetId == w.Id)" />
                    }
                </div>
            }
        }

        @if (_detalle is { } det)
        {
            <AnalisisDetallePanel Titulo="@det.Titulo" Subtitulo="@det.Widget" Detalle="det.Resultado" Zona="_zona"
                                  OnCerrar="CerrarRegistros" />
        }

        <footer class="ap-foot">ECOREX - Libros de indicadores</footer>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool _cargando = true;
    private Guid _tenantId;
    private AnalisisLibroDetalle? _libro;
    private Guid? _hojaId;
    private int _version;
    private readonly Dictionary<Guid, AnalisisWidgetResultado> _resultados = new();

    // Una consulta a la vez: cambiar de hoja o filtrar mientras otra carga no comparte el contexto EF.
    private readonly SemaphoreSlim _gate = new(1, 1);

    // Filtros temporales de quien mira (no se guardan) y selecciones por clic (Ola 7c).
    private DateOnly? _fDesde;
    private DateOnly? _fHasta;
    private string? _fVendedor;
    private string? _fTablero;
    private HojaFiltros? _filtrosTemporales;
    private readonly List<SeleccionCruzada> _cruces = new();

    // "Ver registros" (solo si el enlace lo permite).
    private bool _permiteRegistros;
    private DetalleAbierto? _detalle;
    private int _detalleVersion;
    private TimeZoneInfo? _zona;

    private sealed record DetalleAbierto(string Titulo, string Widget, AnalisisDetalle? Resultado);

    private EventCallback<AnalisisPuntoAccion> VerRegistrosCallback =>
        _permiteRegistros ? EventCallback.Factory.Create<AnalisisPuntoAccion>(this, VerRegistrosAsync) : default;

    private AnalisisHojaDto? Hoja => _libro?.Hojas.FirstOrDefault(h => h.Id == _hojaId);

    /// <summary>
    /// Filtros guardados en la hoja: en el enlace publico son un PISO que quien abre el enlace no puede ampliar
    /// (solo acotar), para que compartir una hoja filtrada no exponga los datos que el filtro deja fuera.
    /// </summary>
    private HojaFiltros Fijos => Hoja?.Filtros ?? new HojaFiltros();

    private HojaFiltros FiltrosActivos => (_filtrosTemporales ?? Fijos).DentroDe(Fijos);


    protected override async Task OnInitializedAsync()
    {
        var enlace = await Compartir.ResolverAsync(Token);
        if (enlace is not null)
        {
            _tenantId = enlace.TenantId;
            _permiteRegistros = enlace.PermiteRegistros;
            using (AmbientTenantContext.Begin(_tenantId))
            {
                _libro = await Compartir.LibroPublicoAsync(enlace.LibroId);
            }
        }

        _cargando = false;
        if (_libro?.Hojas.FirstOrDefault() is { } primera)
        {
            await MostrarHojaAsync(primera.Id);
        }
    }

    public void Dispose() => _version++;

    /// <summary>Cambia de hoja: vuelve a los filtros guardados de esa hoja y sin selecciones por clic.</summary>
    private Task MostrarHojaAsync(Guid hojaId)
    {
        _hojaId = hojaId;
        _filtrosTemporales = null;
        _cruces.Clear();
        var f = Hoja?.Filtros ?? new HojaFiltros();
        (_fDesde, _fHasta, _fVendedor, _fTablero) = (f.Desde, f.Hasta, f.Vendedor, f.Tablero);
        return CargarAsync();
    }

    /// <summary>
    /// Corre los widgets de la hoja EN SERIE con el tenant del token como ambient, con los filtros activos y
    /// las selecciones por clic. <paramref name="conservar"/>: widget cuyo resultado no cambia (el de origen
    /// de una seleccion: su propio clic no lo filtra).
    /// </summary>
    private async Task CargarAsync(Guid? conservar = null)
    {
        var version = ++_version;
        foreach (var id in _resultados.Keys.Where(k => k != conservar).ToList())
        {
            _resultados.Remove(id);
        }

        if (Hoja is not { } hoja)
        {
            return;
        }

        StateHasChanged();
        var ctx = new ReportContext(Guid.Empty);
        var filtros = FiltrosActivos;
        var cruces = _cruces.ToList();
        foreach (var w in hoja.Widgets)
        {
            if (_resultados.ContainsKey(w.Id))
            {
                continue;
            }

            AnalisisWidgetResultado r;
            await _gate.WaitAsync();
            try
            {
                if (version != _version)
                {
                    return; // cambio de hoja / filtros o pagina cerrada
                }

                using (AmbientTenantContext.Begin(_tenantId))
                {
                    r = await Runner.RunAsync(w, ctx, default, filtros, null, cruces);
                }
            }
            finally
            {
                _gate.Release();
            }

            if (version != _version)
            {
                return;
            }

            _resultados[w.Id] = r;
            StateHasChanged();
        }
    }

    private Task AplicarFiltrosAsync()
    {
        // Lo escrito se acota a los filtros fijos y la barra muestra lo que realmente se aplica.
        var f = new HojaFiltros
        {
            Desde = _fDesde,
            Hasta = _fHasta,
            Vendedor = string.IsNullOrWhiteSpace(_fVendedor) ? null : _fVendedor.Trim(),
            Tablero = string.IsNullOrWhiteSpace(_fTablero) ? null : _fTablero.Trim()
        }.DentroDe(Fijos);
        _filtrosTemporales = f;
        (_fDesde, _fHasta, _fVendedor, _fTablero) = (f.Desde, f.Hasta, f.Vendedor, f.Tablero);
        return CargarAsync();
    }

    private static string Resumen(HojaFiltros f)
    {
        var partes = new List<string>();
        if (f.Desde is not null || f.Hasta is not null)
        {
            partes.Add($"fechas {f.Desde?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "..."} - {f.Hasta?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "..."}");
        }

        if (!string.IsNullOrWhiteSpace(f.Vendedor))
        {
            partes.Add($"vendedor {f.Vendedor}");
        }

        if (!string.IsNullOrWhiteSpace(f.Tablero))
        {
            partes.Add($"tablero {f.Tablero}");
        }

        return string.Join(", ", partes);
    }

    /// <summary>Vuelve a los filtros con que se compartio la hoja.</summary>
    private Task RestablecerFiltrosAsync()
    {
        _filtrosTemporales = null;
        var f = Hoja?.Filtros ?? new HojaFiltros();
        (_fDesde, _fHasta, _fVendedor, _fTablero) = (f.Desde, f.Hasta, f.Vendedor, f.Tablero);
        return CargarAsync();
    }

    /// <summary>"Filtrar la hoja por esto" sobre un grafico: agrega, reemplaza o quita la seleccion de ese widget.</summary>
    private async Task FiltrarPorClicAsync(AnalisisPuntoAccion a)
    {
        var spec = AnalisisJson.DeserializeSpec(a.Widget.SpecJson);
        ReportSourceDescriptor? fuente = null;
        if (spec is not null)
        {
            await _gate.WaitAsync();
            try
            {
                using (AmbientTenantContext.Begin(_tenantId))
                {
                    fuente = await Catalogo.GetSourceAsync(spec.SourceKey);
                }
            }
            finally
            {
                _gate.Release();
            }
        }

        if (AnalisisCruce.Alternar(_cruces, a.Widget, a.Condiciones, fuente))
        {
            await CargarAsync(conservar: a.Widget.Id);
        }
    }

    /// <summary>
    /// "Ver registros" desde el enlace: se vuelve a validar el token (revocado, vencido o sin el permiso = no),
    /// y se consulta con los filtros activos (acotados por los fijos) y las selecciones por clic.
    /// </summary>
    private async Task VerRegistrosAsync(AnalisisPuntoAccion a)
    {
        var version = ++_detalleVersion;
        _detalle = new DetalleAbierto(a.Etiqueta, a.Widget.Titulo, null);
        StateHasChanged();

        var enlace = await Compartir.ResolverAsync(Token);
        if (enlace is not { PermiteRegistros: true } || enlace.TenantId != _tenantId)
        {
            _permiteRegistros = false;
            if (version == _detalleVersion)
            {
                _detalle = _detalle with { Resultado = AnalisisDetalle.Fallo("Este enlace ya no permite ver los registros.") };
            }

            return;
        }

        var filtros = FiltrosActivos;
        var cruces = _cruces.ToList();
        AnalisisDetalle r;
        await _gate.WaitAsync();
        try
        {
            using (AmbientTenantContext.Begin(_tenantId))
            {
                _zona ??= await ZonaHoraria.ObtenerAsync();
                r = await Runner.DetalleAsync(a.Widget, a.Condiciones, new ReportContext(Guid.Empty, null, _zona), default, filtros, null, cruces);
            }
        }
        finally
        {
            _gate.Release();
        }

        if (version == _detalleVersion && _detalle is not null)
        {
            _detalle = _detalle with { Resultado = r };
        }
    }

    private void CerrarRegistros()
    {
        _detalleVersion++;
        _detalle = null;
    }

    private Task QuitarCruceAsync(Guid origen)
    {
        _cruces.RemoveAll(c => c.OrigenWidgetId == origen);
        return CargarAsync(conservar: origen);
    }

    private Task LimpiarCrucesAsync()
    {
        _cruces.Clear();
        return CargarAsync();
    }

    private static string? Fecha(DateOnly? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private static DateOnly? ParseFecha(object? v) =>
        DateOnly.TryParseExact(v?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;
}
