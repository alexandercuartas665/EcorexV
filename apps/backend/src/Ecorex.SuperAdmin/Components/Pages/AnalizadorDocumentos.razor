@code {
    /// <summary>Clave del modulo en la matriz de roles (coincide con la ruta y el menu).</summary>
    private const string ModuleKey = "analizador-documentos";

    /// <summary>Tope de archivos por lote (defensa; cada uno ademas limitado por tamano).</summary>
    private const int MaxArchivosLote = 200;

    /// <summary>Tipos de campo de metadata admitidos (mismos valores que valida el servicio).</summary>
    private static readonly string[] Tipos = ["texto", "numero", "fecha", "lista"];

    private static int MaxMb => (int)(DocumentoAnalisisService.MaxUploadBytes / (1024 * 1024));

    private bool _cargando = true;
    private bool _canCreate;
    private bool _canDelete;
    private bool _canEdit;
    private bool _subiendo;

    private Tab _tab = Tab.Cargados;

    // ---- Configuracion (agentes del modulo) ----
    private bool _configOpen;
    private bool _ocupadoCfg;
    private string? _configMsg;
    private bool _configMsgErr;
    private Guid? _nuevoAgenteId;
    private List<DocumentoAnalisisAgenteDto> _agentesConfig = new();
    private List<DocumentoAnalisisAgenteOpcionDto> _agentesDisponibles = new();
    private readonly Dictionary<Guid, string> _promptEdit = new();

    // ---- Configuracion (campos de metadata) ----
    private List<DocumentoAnalisisMetadataCampoDto> _campos = new();
    private readonly Dictionary<Guid, CampoEdit> _campoEdit = new();
    private CampoEdit _nuevoCampo = new() { Tipo = "texto", Activo = true, Orden = 0 };

    private string? _mensaje;
    private bool _mensajeEsError;

    private List<DocumentoAnalisisDto> _docs = new();
    private List<DocumentoAnalisisProcesadoDto> _procesados = new();
    private readonly List<ColaItem> _cola = new();
    private readonly HashSet<Guid> _seleccion = new();

    // ---- Modal de resultados ----
    private bool _resultOpen;
    private DocumentoAnalisisProcesadoDto? _resultDoc;
    private List<DocumentoAnalisisPaqueteDto> _resultPaquetes = new();
    private List<DocumentoAnalisisMetadataCampoDto> _camposActivos = new();
    private readonly HashSet<Guid> _pdfVisible = new();
    private bool _marcando;

    // ---- Modal de traza ----
    private bool _trazaOpen;
    private DocumentoAnalisisTrazaDto? _traza;

    /// <summary>Usuario actual (para dejar trazado quien marco cada paquete en la revision QA).</summary>
    private string? _usuarioActual;

    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        _canCreate = eff.Can(ModuleKey, PermissionAction.Create);
        _canDelete = eff.Can(ModuleKey, PermissionAction.Delete);
        _canEdit = eff.Can(ModuleKey, PermissionAction.Edit);
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _usuarioActual = auth.User.Identity?.Name;
        Notifier.DocumentoCambiado += OnDocumentoCambiado;
        await RecargarAsync();
        _cargando = false;
    }

    public void Dispose() => Notifier.DocumentoCambiado -= OnDocumentoCambiado;

    /// <summary>
    /// El worker aviso que un documento cambio de estado (termino o fallo). Como varios archivos corren a la
    /// vez y el aviso llega en un hilo del worker, refrescamos las listas del tenant en el contexto del
    /// circuito de Blazor (InvokeAsync) y volvemos a pintar para mover el spinner.
    /// </summary>
    private async void OnDocumentoCambiado(Guid _)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await RecargarAsync();
                StateHasChanged();
            });
        }
        catch { /* el circuito pudo cerrarse; sin ruido */ }
    }

    private async Task RecargarAsync()
    {
        _docs = (await Docs.ListarAsync()).ToList();
        _procesados = (await Docs.ListarProcesadosAsync()).ToList();
        // Limpia de la seleccion lo que ya no este "Cargado" (encolado, procesado o borrado).
        _seleccion.RemoveWhere(id => !_docs.Any(d => d.Id == id && d.Estado == DocumentoAnalisisEstado.Cargado));
    }

    private async Task CambiarAProcesadosAsync()
    {
        _tab = Tab.Procesados;
        await RecargarAsync();
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (!_canCreate || _subiendo) { return; }

        _mensaje = null;
        _cola.Clear();

        IReadOnlyList<IBrowserFile> archivos;
        try { archivos = e.GetMultipleFiles(MaxArchivosLote); }
        catch { Avisar($"Puedes subir hasta {MaxArchivosLote} archivos por lote.", true); return; }

        if (archivos.Count == 0) { return; }

        foreach (var f in archivos)
        {
            _cola.Add(new ColaItem { Nombre = f.Name, Bytes = f.Size, Estado = ColaEstado.EnCola });
        }

        _subiendo = true;
        StateHasChanged();

        // Un nuevo lote por cada accion de carga: agrupa los documentos subidos juntos.
        var loteId = Guid.CreateVersion7();
        var ok = 0;
        var err = 0;

        for (var i = 0; i < archivos.Count; i++)
        {
            var file = archivos[i];
            var item = _cola[i];
            item.Estado = ColaEstado.Subiendo;
            StateHasChanged();

            var bytes = await LeerPdfAsync(file, item);
            if (bytes is null)
            {
                item.Estado = ColaEstado.Error;
                err++;
                StateHasChanged();
                continue;
            }

            try
            {
                await Docs.SubirAsync(loteId, new DocumentoAnalisisUploadItem(file.Name, "application/pdf", bytes));
                item.Estado = ColaEstado.Ok;
                ok++;
            }
            catch (Exception ex)
            {
                item.Estado = ColaEstado.Error;
                item.Error = ex.Message;
                err++;
            }
            StateHasChanged();
        }

        _subiendo = false;
        await RecargarAsync();
        Avisar(err == 0
            ? $"{ok} documento(s) cargado(s)."
            : $"{ok} cargado(s), {err} con error. Revisa el detalle del lote.", err > 0);
        StateHasChanged();
    }

    /// <summary>
    /// Lee y valida el PDF en el cliente (feedback inmediato): extension, no vacio, tamano y FIRMA de
    /// bytes magicos. El servicio vuelve a validar como defensa. Devuelve los bytes o null (con motivo).
    /// </summary>
    private async Task<byte[]?> LeerPdfAsync(IBrowserFile file, ColaItem item)
    {
        var ext = DocumentUploadGuard.ResolveExtension(file.Name);
        if (ext != ".pdf") { item.Error = "Solo se admiten archivos PDF."; return null; }
        if (file.Size <= 0) { item.Error = "El archivo esta vacio."; return null; }
        if (file.Size > DocumentoAnalisisService.MaxUploadBytes) { item.Error = $"Supera el limite de {MaxMb} MB."; return null; }

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(DocumentoAnalisisService.MaxUploadBytes).CopyToAsync(ms);
            var bytes = ms.ToArray();
            if (!DocumentUploadGuard.MatchesSignature(bytes, ext))
            {
                item.Error = "El contenido no corresponde a un PDF.";
                return null;
            }
            return bytes;
        }
        catch
        {
            item.Error = "No se pudo leer el archivo.";
            return null;
        }
    }

    private async Task EliminarAsync(DocumentoAnalisisDto d)
    {
        if (!_canDelete || _subiendo) { return; }
        await Docs.EliminarAsync(d.Id);
        _seleccion.Remove(d.Id);
        await RecargarAsync();
        Avisar($"Documento '{d.FileName}' eliminado.", false);
    }

    // ---- Procesamiento: encolar para el worker ----

    private void AlternarSeleccion(Guid id, object? valor)
    {
        if (valor is bool b && b) { _seleccion.Add(id); } else { _seleccion.Remove(id); }
    }

    private async Task ProcesarUnoAsync(DocumentoAnalisisDto d)
    {
        if (!_canEdit) { return; }
        await EncolarAsync(new[] { d.Id });
    }

    private async Task ProcesarSeleccionAsync()
    {
        if (!_canEdit || _seleccion.Count == 0) { return; }
        await EncolarAsync(_seleccion.ToArray());
    }

    private async Task EncolarAsync(IReadOnlyList<Guid> ids)
    {
        _mensaje = null;
        try
        {
            var n = await Docs.EncolarAsync(ids);
            _seleccion.Clear();
            await RecargarAsync();
            Avisar(n == 1 ? "1 documento enviado a analisis." : $"{n} documentos enviados a analisis.", false);
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, true);
        }
    }

    // ---- Modal de resultados ----

    private async Task AbrirResultadosAsync(DocumentoAnalisisProcesadoDto d)
    {
        _resultDoc = d;
        _resultPaquetes = (await Docs.ListarPaquetesAsync(d.Id)).ToList();
        _camposActivos = (await Docs.ListarMetadataCamposAsync()).Where(c => c.Activo).ToList();
        _resultOpen = true;
    }

    private void CerrarResultados()
    {
        _resultOpen = false;
