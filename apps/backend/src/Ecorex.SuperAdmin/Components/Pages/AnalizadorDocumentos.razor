    private static string FormatoTamano(long bytes)
    {
        if (bytes <= 0) { return "-"; }
        string[] unidades = ["B", "KB", "MB", "GB"];
        double valor = bytes;
        var i = 0;
        while (valor >= 1024 && i < unidades.Length - 1) { valor /= 1024; i++; }
        return $"{valor:0.#} {unidades[i]}";
    }

    private static string MotorTexto(AiProvider? p, string? modelo)
    {
        if (p is null) { return "-"; }
        return string.IsNullOrWhiteSpace(modelo) ? p.ToString()! : $"{p} / {modelo}";
    }

    private static string TokensTexto(int? inTok, int? outTok)
    {
        if (inTok is null && outTok is null) { return "-"; }
        return $"{inTok ?? 0} / {outTok ?? 0}";
    }

    private static string TiempoTexto(long? ms)
    {
        if (ms is not long v) { return "-"; }
        return v < 1000 ? $"{v} ms" : $"{v / 1000.0:0.0} s";
    }

