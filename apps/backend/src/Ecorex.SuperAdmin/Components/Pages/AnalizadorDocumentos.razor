@page "/analizador-documentos"
@attribute [Authorize(Policy = "Perm:analizador-documentos:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Ecorex.Application.DocumentosAnalisis
@using Ecorex.Application.Roles
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Auth
@using Ecorex.SuperAdmin.RealTime
@using Ecorex.SuperAdmin.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IDocumentoAnalisisService Docs
@inject ICurrentPermissions Perms
@inject IDocumentoAnalisisNotifier Notifier
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable

@* Analizador de documentos. Parrilla que recibe lotes de PDF, los sube al almacenamiento unificado
   (Azure Blob / disco via IFileStorageService), los lista y permite enviarlos a analisis: el agente de
   vision separa cada PDF combinado en sus N soportes de pago y extrae metadata. Procesamiento en
   background (worker) con spinner por archivo via notifier en proceso. Tokens del workspace ECOREX. *@

<PageTitle>Analizador de documentos - ECOREX.tareas</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <span class="cur">Analizador de documentos</span>
</nav>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h4"/></svg>
            </div>
            <span>Analizador de documentos</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Documentos</h1>
        <p class="page-sub" style="margin-bottom:0;">
            Carga lotes de archivos PDF combinados. El agente de vision los separa en sus soportes de pago
            individuales y extrae la metadata configurada.
        </p>
    </div>
    @if (_canEdit)
    {
        <div class="ad-head-actions">
            <button class="ad-btn" @onclick="AbrirConfigAsync">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Configuracion
            </button>
        </div>
    }
</div>

@if (_cargando)
{
    <p class="ad-muted" style="padding:24px 0;">Cargando...</p>
}
else
{
    <div class="ad-tabs" role="tablist">
        <button class="ad-tab @(_tab == Tab.Cargados ? "active" : "")" @onclick="() => _tab = Tab.Cargados" role="tab">
            Cargados @if (_docs.Count > 0) { <span class="ad-tab-count">@_docs.Count</span> }
        </button>
        <button class="ad-tab @(_tab == Tab.Procesados ? "active" : "")" @onclick="CambiarAProcesadosAsync" role="tab">
            Procesados @if (_procesados.Count > 0) { <span class="ad-tab-count">@_procesados.Count</span> }
        </button>
    </div>

    @if (_mensaje is not null)
    {
        <div class="ad-alert @(_mensajeEsError ? "err" : "ok")">@_mensaje</div>
    }

    @if (_tab == Tab.Cargados)
    {
        @if (_canCreate)
        {
            <div class="ad-drop">
                <div class="ad-drop-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5-5 5 5"/><path d="M12 5v12"/></svg>
                </div>
                <div class="ad-drop-txt">
                    <strong>Subir archivos PDF</strong>
                    <span class="ad-muted">Solo PDF &#183; hasta @MaxMb MB por archivo &#183; varios a la vez</span>
                </div>
                <label class="ad-btn primary @(_subiendo ? "disabled" : "")">
                    @(_subiendo ? "Subiendo..." : "Elegir archivos")
                    <InputFile class="ad-file-hidden" accept="application/pdf,.pdf" multiple
                               OnChange="OnFilesSelectedAsync" disabled="@_subiendo" />
                </label>
            </div>
        }

        @if (_cola.Count > 0)
        {
            <div class="ad-cola">
                <div class="ad-cola-head">Lote actual &#183; @_cola.Count archivo(s)</div>
                @foreach (var c in _cola)
                {
                    <div class="ad-cola-row">
                        <span class="ad-cola-name" title="@c.Nombre">@c.Nombre</span>
                        <span class="ad-cola-size">@FormatoTamano(c.Bytes)</span>
                        <span class="ad-chip @ChipClase(c.Estado)">@EstadoTexto(c.Estado)</span>
                        @if (c.Estado == ColaEstado.Error && c.Error is not null)
                        {
                            <span class="ad-cola-err" title="@c.Error">@c.Error</span>
                        }
                    </div>
                }
            </div>
        }

        @if (_canEdit && _seleccion.Count > 0)
        {
            <div class="ad-bulk">
                <span class="ad-muted">@_seleccion.Count seleccionado(s)</span>
                <button class="ad-btn primary sm" @onclick="ProcesarSeleccionAsync" disabled="@_subiendo">
                    Procesar seleccionados
                </button>
                <button class="ad-btn sm" @onclick="() => _seleccion.Clear()">Limpiar</button>
            </div>
        }

        <div class="ad-grid-wrap">
            <table class="ad-grid">
                <thead>
                    <tr>
                        @if (_canEdit) { <th style="width:36px;"></th> }
                        <th>Documento</th>
                        <th style="width:110px;">Tamano</th>
                        <th style="width:130px;">Estado</th>
                        <th style="width:160px;">Cargado</th>
                        <th style="width:210px;" class="ad-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_docs.Count == 0)
                    {
                        <tr>
                            <td colspan="@(_canEdit ? 6 : 5)" class="ad-empty">Aun no hay documentos. Sube uno o varios PDF para empezar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var d in _docs)
                        {
                            var doc = d;
                            <tr>
                                @if (_canEdit)
                                {
                                    <td>
                                        @if (doc.Estado == DocumentoAnalisisEstado.Cargado)
                                        {
                                            <input type="checkbox" checked="@_seleccion.Contains(doc.Id)"
                                                   @onchange="e => AlternarSeleccion(doc.Id, e.Value)" />
                                        }
                                    </td>
                                }
                                <td class="ad-doc-name">
                                    <svg class="ad-doc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                    <span title="@doc.FileName">@doc.FileName</span>
                                </td>
                                <td>@FormatoTamano(doc.SizeBytes)</td>
                                <td>
                                    @if (doc.Estado == DocumentoAnalisisEstado.EnAnalisis)
                                    {
                                        <span class="ad-chip run"><span class="ad-spin"></span> En analisis</span>
                                    }
                                    else
                                    {
                                        <span class="ad-chip @ChipClaseDoc(doc.Estado)" title="@doc.MotivoError">@EstadoDocTexto(doc.Estado)</span>
                                    }
                                </td>
                                <td>@doc.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="ad-right">
                                    @if (_canEdit && doc.Estado == DocumentoAnalisisEstado.Cargado)
                                    {
                                        <button class="ad-btn sm primary" @onclick="() => ProcesarUnoAsync(doc)" disabled="@_subiendo">Procesar</button>
                                    }
                                    @if (_canEdit && doc.Estado == DocumentoAnalisisEstado.Error)
                                    {
                                        <button class="ad-btn sm" @onclick="() => ProcesarUnoAsync(doc)" disabled="@_subiendo">Reintentar</button>
                                    }
                                    @if (_canEdit && doc.Estado == DocumentoAnalisisEstado.Analizado)
                                    {
                                        <button class="ad-btn sm" @onclick="() => ProcesarUnoAsync(doc)" disabled="@_subiendo">Reprocesar</button>
                                    }
                                    @if (doc.Estado == DocumentoAnalisisEstado.Analizado || doc.Estado == DocumentoAnalisisEstado.Error)
                                    {
                                        <button class="ad-btn sm" @onclick="() => AbrirTrazaAsync(doc.Id)">Traza</button>
                                    }
                                    <a class="ad-btn sm" href="@doc.Url" target="_blank" rel="noopener">Ver</a>
                                    @if (_canDelete)
                                    {
                                        <button class="ad-btn sm danger" @onclick="() => EliminarAsync(doc)" disabled="@_subiendo">Eliminar</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ad-grid-wrap">
            <table class="ad-grid">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th style="width:100px;">Paquetes</th>
                        <th style="width:150px;">Agente</th>
                        <th style="width:130px;">Motor</th>
                        <th style="width:110px;">Tokens</th>
                        <th style="width:90px;">Tiempo</th>
                        <th style="width:160px;">Procesado</th>
                        <th style="width:130px;" class="ad-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_procesados.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="ad-empty">Aun no hay documentos procesados. Envia un PDF a analisis desde la pestana Cargados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in _procesados)
                        {
                            var proc = p;
                            <tr>
                                <td class="ad-doc-name">
                                    <svg class="ad-doc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                    <span title="@proc.FileName">@proc.FileName</span>
                                </td>
                                <td>
                                    @if (proc.Estado == DocumentoAnalisisEstado.EnAnalisis)
                                    {
                                        <span class="ad-chip run"><span class="ad-spin"></span></span>
                                    }
                                    else if (proc.Estado == DocumentoAnalisisEstado.Error)
                                    {
                                        <span class="ad-chip err" title="@proc.MotivoError">Error</span>
                                    }
                                    else
                                    {
                                        @(proc.PaquetesCount?.ToString() ?? "-")
                                    }
                                </td>
                                <td title="@FechaVersion(proc.AgenteVersionAt)">@(proc.AgenteNombre ?? "-")</td>
                                <td>@MotorTexto(proc.Proveedor, proc.Modelo)</td>
                                <td>@TokensTexto(proc.InputTokens, proc.OutputTokens)</td>
                                <td>@TiempoTexto(proc.ProcesamientoMs)</td>
                                <td>@(proc.ProcesadoAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td class="ad-right">
                                    @if (proc.Estado == DocumentoAnalisisEstado.Analizado && (proc.PaquetesCount ?? 0) > 0)
                                    {
                                        <button class="ad-btn sm primary" @onclick="() => AbrirResultadosAsync(proc)">Ver resultados</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_configOpen)
{
    <div class="modal-overlay" @onclick="() => _configOpen = false">
        <div class="modal-dialog" style="max-width:760px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Configuracion del Analizador</h3>
                <button class="modal-close" @onclick="() => _configOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                @if (_configMsg is not null)
                {
                    <div class="ad-alert @(_configMsgErr ? "err" : "ok")">@_configMsg</div>
                }

                <h4 class="ad-cfg-section">Agente de analisis</h4>
                <p class="ad-muted" style="margin-top:0;">
                    Selecciona agentes de tu modulo de Agentes y define, para cada uno, su <strong>prompt principal
                    de analisis</strong> (vive aqui, no cambia el prompt global del agente). Marca cual es el
                    <strong>agente activo</strong> del Analizador. Los campos de metadata de abajo se inyectan en el prompt.
                </p>

                <div class="ad-add-row">
                    <select class="ad-input" value="@(_nuevoAgenteId?.ToString() ?? "")"
                            @onchange="e => _nuevoAgenteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">-- Elige un agente --</option>
                        @foreach (var a in _agentesDisponibles)
                        {
                            <option value="@a.AgentId">@a.AgentName@(string.IsNullOrWhiteSpace(a.AgentRole) ? "" : $" ({a.AgentRole})")</option>
                        }
                    </select>
                    <button class="ad-btn primary" @onclick="AgregarAgenteAsync" disabled="@(_nuevoAgenteId is null || _ocupadoCfg)">Agregar</button>
                </div>
                @if (_agentesDisponibles.Count == 0 && _agentesConfig.Count == 0)
                {
                    <p class="ad-muted">No hay agentes en tu tenant todavia. Crealos en el modulo de Agentes y vuelve aqui a seleccionarlos.</p>
                }

                <div class="ad-cfg-list">
                    @foreach (var a in _agentesConfig)
                    {
                        var agente = a;
                        <div class="ad-cfg-card @(agente.IsActive ? "active" : "")">
                            <div class="ad-cfg-top">
                                <div class="ad-cfg-name">
                                    <strong>@agente.AgentName</strong>
                                    @if (!string.IsNullOrWhiteSpace(agente.AgentRole)) { <span class="ad-muted"> &#183; @agente.AgentRole</span> }
                                </div>
                                <div class="ad-cfg-top-actions">
                                    <label class="ad-radio">
                                        <input type="radio" name="agente-activo" checked="@agente.IsActive"
                                               @onchange="() => MarcarActivoAsync(agente.AgentId)" disabled="@_ocupadoCfg" />
                                        Activo
                                    </label>
                                    <button class="ad-btn sm danger" @onclick="() => QuitarAgenteAsync(agente.AgentId)" disabled="@_ocupadoCfg">Quitar</button>
                                </div>
                            </div>
                            <textarea class="ad-input ad-prompt" rows="5" placeholder="Prompt principal de analisis para este agente..."
                                      @bind="_promptEdit[agente.AgentId]"></textarea>
                            <div class="ad-cfg-foot">
                                <button class="ad-btn sm" @onclick="() => GuardarPromptAsync(agente.AgentId)" disabled="@_ocupadoCfg">Guardar prompt</button>
                            </div>
                        </div>
                    }
                </div>

                <h4 class="ad-cfg-section" style="margin-top:22px;">Campos de metadata</h4>
                <p class="ad-muted" style="margin-top:0;">
                    Define que datos debe extraer el agente de cada soporte de pago. Cada campo se inyecta en el prompt
                    y se muestra como columna en el modal de resultados. La <strong>clave</strong> es el identificador
                    tecnico (sin espacios); la <strong>etiqueta</strong> es lo que ve el usuario.
                </p>

                <div class="ad-meta-grid-wrap">
                    <table class="ad-meta-grid">
                        <thead>
                            <tr>
                                <th>Etiqueta</th>
                                <th style="width:150px;">Clave</th>
                                <th style="width:110px;">Tipo</th>
                                <th style="width:70px;">Orden</th>
                                <th style="width:70px;">Activo</th>
                                <th style="width:150px;" class="ad-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _campos)
                            {
                                var campo = c;
                                var m = _campoEdit[campo.Id];
                                <tr>
                                    <td><input class="ad-input sm" @bind="m.Etiqueta" /></td>
                                    <td><input class="ad-input sm" @bind="m.Clave" /></td>
                                    <td>
                                        <select class="ad-input sm" @bind="m.Tipo">
                                            @foreach (var t in Tipos) { <option value="@t">@t</option> }
                                        </select>
                                    </td>
                                    <td><input class="ad-input sm" type="number" @bind="m.Orden" /></td>
                                    <td style="text-align:center;"><input type="checkbox" @bind="m.Activo" /></td>
                                    <td class="ad-right">
                                        <button class="ad-btn sm" @onclick="() => GuardarCampoAsync(campo.Id)" disabled="@_ocupadoCfg">Guardar</button>
                                        <button class="ad-btn sm danger" @onclick="() => EliminarCampoAsync(campo.Id)" disabled="@_ocupadoCfg">Eliminar</button>
                                    </td>
                                </tr>
                            }
                            <tr class="ad-meta-new">
                                <td><input class="ad-input sm" placeholder="Beneficiario" @bind="_nuevoCampo.Etiqueta" /></td>
                                <td><input class="ad-input sm" placeholder="beneficiario" @bind="_nuevoCampo.Clave" /></td>
                                <td>
                                    <select class="ad-input sm" @bind="_nuevoCampo.Tipo">
                                        @foreach (var t in Tipos) { <option value="@t">@t</option> }
                                    </select>
                                </td>
                                <td><input class="ad-input sm" type="number" @bind="_nuevoCampo.Orden" /></td>
                                <td style="text-align:center;"><input type="checkbox" @bind="_nuevoCampo.Activo" /></td>
                                <td class="ad-right">
                                    <button class="ad-btn sm primary" @onclick="AgregarCampoAsync" disabled="@_ocupadoCfg">Agregar</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="ad-muted" style="margin-top:8px;">Tipos: <strong>texto</strong>, <strong>numero</strong>, <strong>fecha</strong>, <strong>lista</strong>. La descripcion de cada campo puede ampliarse editando su etiqueta.</p>
            </div>
            <div class="modal-foot">
                <button class="ad-btn" @onclick="() => _configOpen = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (_resultOpen && _resultDoc is not null)
{
    <div class="modal-overlay" @onclick="CerrarResultados">
        <div class="modal-dialog" style="max-width:900px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Soportes separados &#183; @_resultDoc.FileName</h3>
                <button class="modal-close" @onclick="CerrarResultados">&times;</button>
            </div>
            <div class="modal-body">
                <p class="ad-muted" style="margin-top:0;">
                    @_resultPaquetes.Count paquete(s) generado(s) a partir del PDF combinado.
                    Cada fila es un soporte de pago nuevo: a la izquierda el archivo, a la derecha su metadata.
                </p>
                <div class="ad-res-wrap">
                    <table class="ad-res-grid">
                        <thead>
                            <tr>
                                <th style="width:42%;">Archivo</th>
                                <th>Metadatos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pq in _resultPaquetes)
                            {
                                var paq = pq;
                                <tr>
                                    <td>
                                        <div class="ad-res-file">
                                            <div class="ad-res-fname">
                                                <svg class="ad-doc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                                <span title="@paq.NombreSugerido">@paq.NombreSugerido</span>
                                            </div>
                                            <div class="ad-res-meta-mini">
                                                Paginas @paq.PaginaInicio&#8211;@paq.PaginaFin (@paq.Paginas) &#183; @FormatoTamano(paq.SizeBytes)
                                                @if (paq.Confianza is double cf) { <span> &#183; confianza @((cf * 100).ToString("0")) %</span> }
                                            </div>
                                            <div class="ad-res-actions">
                                                <button class="ad-btn sm" @onclick="() => TogglePdf(paq.Id)">
                                                    @(_pdfVisible.Contains(paq.Id) ? "Ocultar" : "Visualizar")
                                                </button>
                                                <a class="ad-btn sm" href="@paq.Url" target="_blank" rel="noopener">Ver</a>
                                                <a class="ad-btn sm" href="@paq.Url" download>Descargar</a>
                                            </div>
                                            <div class="ad-res-rev">
                                                <span class="ad-chip @ChipRevision(paq.RevisionEstado)">@TextoRevision(paq.RevisionEstado)</span>
                                                @if (_canEdit)
                                                {
                                                    <button class="ad-btn xs ok @(paq.RevisionEstado == PaqueteRevisionEstado.Correcto ? "on" : "")"
                                                            @onclick="() => MarcarAsync(paq.Id, PaqueteRevisionEstado.Correcto)" disabled="@_marcando">Correcto</button>
                                                    <button class="ad-btn xs bad @(paq.RevisionEstado == PaqueteRevisionEstado.Incorrecto ? "on" : "")"
                                                            @onclick="() => MarcarAsync(paq.Id, PaqueteRevisionEstado.Incorrecto)" disabled="@_marcando">Incorrecto</button>
                                                    @if (paq.RevisionEstado != PaqueteRevisionEstado.Pendiente)
                                                    {
                                                        <button class="ad-btn xs" @onclick="() => MarcarAsync(paq.Id, PaqueteRevisionEstado.Pendiente)" disabled="@_marcando">Limpiar</button>
                                                    }
                                                }
                                                @if (paq.RevisadoAt is not null && !string.IsNullOrWhiteSpace(paq.RevisadoPor))
                                                {
                                                    <span class="ad-res-revby" title="@FechaRevision(paq.RevisadoAt)">por @paq.RevisadoPor</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var datos = ParsearMetadata(paq.MetadataJson);
                                        }
                                        @if (_camposActivos.Count == 0 && datos.Count == 0)
                                        {
                                            <span class="ad-muted">Sin metadata.</span>
                                        }
                                        else
                                        {
                                            <dl class="ad-res-dl">
                                                @foreach (var campo in _camposActivos)
                                                {
                                                    <dt>@campo.Etiqueta</dt>
                                                    <dd>@(datos.TryGetValue(campo.Clave, out var v) && !string.IsNullOrWhiteSpace(v) ? v : "-")</dd>
                                                }
                                                @foreach (var extra in datos.Where(kv => !_camposActivos.Any(c => string.Equals(c.Clave, kv.Key, StringComparison.OrdinalIgnoreCase))))
                                                {
                                                    <dt>@extra.Key</dt>
                                                    <dd>@extra.Value</dd>
                                                }
                                            </dl>
                                        }
                                    </td>
                                </tr>
                                @if (_pdfVisible.Contains(paq.Id))
                                {
                                    <tr class="ad-res-pdf-row">
                                        <td colspan="2">
                                            <iframe class="ad-res-pdf" src="@paq.Url" title="@paq.NombreSugerido"></iframe>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-foot">
                <button class="ad-btn" @onclick="CerrarResultados">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (_trazaOpen && _traza is not null)
{
    <div class="modal-overlay" @onclick="() => _trazaOpen = false">
        <div class="modal-dialog" style="max-width:860px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Traza del analisis &#183; @_traza.FileName</h3>
                <button class="modal-close" @onclick="() => _trazaOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                @if (_traza.Estado == DocumentoAnalisisEstado.Error)
                {
                    <div class="ad-alert err"><strong>Fallo:</strong> @(_traza.MotivoError ?? "sin motivo registrado")</div>
                }
                <div class="ad-traza-grid">
                    <div><span class="ad-traza-k">Estado</span><span class="ad-chip @ChipClaseDoc(_traza.Estado)">@EstadoDocTexto(_traza.Estado)</span></div>
                    <div><span class="ad-traza-k">Agente</span>@(_traza.AgenteNombre ?? "-")</div>
                    <div><span class="ad-traza-k">Version agente</span>@(_traza.AgenteVersionAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                    <div><span class="ad-traza-k">Motor</span>@MotorTexto(_traza.Proveedor, _traza.Modelo)</div>
                    <div><span class="ad-traza-k">Tokens (in / out)</span>@TokensTexto(_traza.InputTokens, _traza.OutputTokens)</div>
                    <div><span class="ad-traza-k">Tiempo</span>@TiempoTexto(_traza.ProcesamientoMs)</div>
                    <div><span class="ad-traza-k">Paginas enviadas</span>@(_traza.PaginasEnviadas?.ToString() ?? "-")</div>
                    <div><span class="ad-traza-k">Paquetes</span>@(_traza.PaquetesCount?.ToString() ?? "-")</div>
                    <div><span class="ad-traza-k">Procesado</span>@(_traza.ProcesadoAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                </div>

                <h4 class="ad-cfg-section" style="margin-top:18px;">Lo que recibio el agente (prompt)</h4>
                <p class="ad-muted" style="margin-top:0;">Prompt efectivo (system + campos de metadata). No incluye las imagenes de las paginas.</p>
                <pre class="ad-traza-pre">@(_traza.PromptEnviado ?? "(sin registro)")</pre>

                <h4 class="ad-cfg-section" style="margin-top:18px;">Lo que devolvio el agente (respuesta cruda)</h4>
                <p class="ad-muted" style="margin-top:0;">Respuesta tal cual la entrego el modelo; es lo que se parsea para separar el PDF.</p>
                <pre class="ad-traza-pre">@(_traza.ResultadoJson ?? "(sin respuesta)")</pre>
            </div>
            <div class="modal-foot">
                <button class="ad-btn" @onclick="() => _trazaOpen = false">Cerrar</button>
            </div>
        </div>
    </div>
}

