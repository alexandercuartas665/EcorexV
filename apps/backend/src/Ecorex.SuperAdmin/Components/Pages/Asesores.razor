@page "/asesores"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Asesores
@inject IAsesorService AsesoresSvc

@* Catalogo de asesores (vendedores) del tenant, modulo 000074. Un asesor puede estar o no
   vinculado a un usuario del tenant, y alimenta el "Vendedor asignado" del Directorio General. *@

<PageTitle>Asesores - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span>Catalogo &#183; 000074</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Asesores</h1>
        <p class="page-sub" style="margin-bottom:0;">Catalogo de vendedores del tenant. Un asesor puede o no estar vinculado a un usuario, y alimenta el "Vendedor asignado" del Directorio General.</p>
    </div>
    <button class="btn btn-primary" @onclick="() => OpenModal(null)">+ Nuevo asesor</button>
</div>

@if (_deleteError is not null)
{
    <div class="ase-alert">
        <span>@_deleteError</span>
        <button class="ase-alert-x" @onclick="() => _deleteError = null">&times;</button>
    </div>
}

@if (_loading)
{
    <p><em>Cargando...</em></p>
}
else if (_asesores.Count == 0)
{
    <p class="text-muted">Aun no hay asesores. Usa "+ Nuevo asesor" para crear el primero.</p>
}
else
{
    <div class="card" style="max-width:1100px;padding:6px 16px;">
        <table class="table table-hover align-middle" style="margin-bottom:0;">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Email</th>
                    <th>Telefono</th>
                    <th>Usuario vinculado</th>
                    <th>Estado</th>
                    <th class="text-end">Terceros</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in _asesores)
                {
                    <tr class="@(a.IsActive ? "" : "ase-inactive")">
                        <td style="font-weight:600;">@a.Nombre</td>
                        <td>@(string.IsNullOrWhiteSpace(a.Documento) ? "-" : a.Documento)</td>
                        <td>@(string.IsNullOrWhiteSpace(a.Email) ? "-" : a.Email)</td>
                        <td>@(string.IsNullOrWhiteSpace(a.Telefono) ? "-" : a.Telefono)</td>
                        <td>@(string.IsNullOrWhiteSpace(a.TenantUserNombre) ? "-" : a.TenantUserNombre)</td>
                        <td>
                            @if (a.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">@a.TercerosCount</td>
                        <td class="text-end" style="white-space:nowrap;">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenModal(a)">Editar</button>
                            @if (a.TercerosCount > 0)
                            {
                                <button class="btn btn-sm btn-outline-danger" disabled title="No se puede eliminar: tiene @a.TercerosCount tercero(s) vinculado(s).">Eliminar</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(a)" disabled="@_busy" title="Eliminar asesor">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ===== Modal: nuevo / editar asesor ===== *@
@if (_modalOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-dialog" style="max-width:560px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@(_editingId is null ? "Nuevo asesor" : "Editar asesor")</h3>
                <button class="modal-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Nombre *</label>
                    <input class="form-control" @bind="_f.Nombre" maxlength="200" autocomplete="off" />
                </div>
                <div class="field-row">
                    <div class="field">
                        <label class="form-label">Documento</label>
                        <input class="form-control" @bind="_f.Documento" maxlength="60" autocomplete="off" placeholder="Ej. cedula / NIT" />
                    </div>
                    <div class="field">
                        <label class="form-label">Telefono</label>
                        <input class="form-control" @bind="_f.Telefono" maxlength="60" autocomplete="off" />
                    </div>
                </div>
                <div class="field">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" @bind="_f.Email" maxlength="200" autocomplete="off" />
                </div>
                <div class="field">
                    <label class="form-label">Vincular a usuario</label>
                    <select class="form-control" @bind="TenantUserIdStr">
                        <option value="">-- Sin usuario --</option>
                        @foreach (var u in _users)
                        {
                            <option value="@u.TenantUserId">@u.Nombre (@u.Email)</option>
                        }
                    </select>
                    <div class="text-muted small" style="margin-top:4px;">Opcional. Vincula el asesor a un login del tenant.</div>
                </div>
                <div class="field">
                    <label class="ase-check">
                        <input type="checkbox" @bind="_f.IsActive" />
                        <span>Activo</span>
                    </label>
                </div>
                @if (_modalError is not null)
                {
                    <div class="text-danger small">@_modalError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Nombre))">Guardar</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private List<AsesorDto> _asesores = new();
    private List<AsesorUserOptionDto> _users = new();
    private string? _deleteError;

    private bool _modalOpen;
    private string? _modalError;
    private Guid? _editingId;
    private FormModel _f = new();

    private string TenantUserIdStr
    {
        get => _f.TenantUserId?.ToString() ?? "";
        set => _f.TenantUserId = Guid.TryParse(value, out var g) ? g : (Guid?)null;
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync() =>
        _asesores = (await AsesoresSvc.ListAsync()).ToList();

    private async Task OpenModal(AsesorDto? a)
    {
        _modalError = null;
        _users = (await AsesoresSvc.ListLinkableUsersAsync()).ToList();
        if (a is null)
        {
            _editingId = null;
            _f = new FormModel { IsActive = true };
        }
        else
        {
            _editingId = a.Id;
            _f = new FormModel
            {
                Nombre = a.Nombre,
                Documento = a.Documento,
                Email = a.Email,
                Telefono = a.Telefono,
                TenantUserId = a.TenantUserId,
                IsActive = a.IsActive
            };
        }
        _modalOpen = true;
    }

    private void CloseModal()
    {
        _modalOpen = false;
        _modalError = null;
    }

    private async Task SaveAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_f.Nombre))
        {
            _modalError = "El nombre es obligatorio.";
            return;
        }
        _busy = true;
        try
        {
            var req = new SaveAsesorRequest(
                _f.Nombre.Trim(),
                string.IsNullOrWhiteSpace(_f.Documento) ? null : _f.Documento.Trim(),
                string.IsNullOrWhiteSpace(_f.Email) ? null : _f.Email.Trim(),
                string.IsNullOrWhiteSpace(_f.Telefono) ? null : _f.Telefono.Trim(),
                _f.TenantUserId,
                _f.IsActive);

            var res = _editingId is null
                ? await AsesoresSvc.CreateAsync(req)
                : await AsesoresSvc.UpdateAsync(_editingId.Value, req);

            if (!res.IsOk)
            {
                _modalError = res.Error ?? "No se pudo guardar el asesor.";
                return;
            }
            _modalOpen = false;
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(AsesorDto a)
    {
        _deleteError = null;
        _busy = true;
        try
        {
            var res = await AsesoresSvc.DeleteAsync(a.Id);
            if (!res.IsOk)
            {
                _deleteError = res.Error ?? "No se pudo eliminar el asesor.";
                return;
            }
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private sealed class FormModel
    {
        public string Nombre { get; set; } = "";
        public string? Documento { get; set; }
        public string? Email { get; set; }
        public string? Telefono { get; set; }
        public Guid? TenantUserId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
