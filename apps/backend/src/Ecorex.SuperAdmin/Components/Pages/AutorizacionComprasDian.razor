@page "/autorizacion-compras-dian"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Ecorex.Application.Automatizaciones.ConciliacionDian
@using Ecorex.Application.Crm
@using Ecorex.Application.Forms
@using Ecorex.Application.Storage
@using Ecorex.Application.Tenancy
@using Ecorex.SuperAdmin.Components.Shared.Forms
@inject IConciliacionDianService Svc
@inject IFileStorageService Files
@inject IAutorizacionComprasConfigService Cfg
@inject IConciliacionTareaService TareaSvc
@inject ITenantUserService Users
@inject ITaskItemService Tasks
@inject IFormResponseService FormResponses
@inject Ecorex.Application.Preferences.IUserTablePrefsService Prefs
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Autorizacion facturas compras DIAN - ECOREX.tareas</PageTitle>

<div class="ac-wrap">
    <div class="ac-head">
        <div class="ac-head-row">
            <div>
                <div class="ac-kicker">COMPRAS</div>
                <h1 class="ac-title">Autorizacion facturas compras DIAN</h1>
            </div>
        </div>
        <p class="ac-sub">Facturas de compra reportadas a la DIAN que aun no tienen una orden de compra y estan pendientes de autorizar. Selecciona una para ver su documento.</p>
    </div>

    @* ---- Filtros ---- *@
    <div class="ac-filters">
        <div class="ac-f">
            <label>Proveedor / NIT</label>
            <input class="ac-in" value="@_texto" @onchange="e => _texto = e.Value?.ToString() ?? string.Empty" @onkeydown="OnFilterKey" placeholder="Nombre o NIT..." />
        </div>
        <div class="ac-f">
            <label>Desde</label>
            <input class="ac-in" type="date" value="@_desde" @onchange="e => _desde = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="ac-f">
            <label>Hasta</label>
            <input class="ac-in" type="date" value="@_hasta" @onchange="e => _hasta = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="ac-f ac-f-btn">
            <button class="ac-btn" @onclick="AplicarAsync" disabled="@_busy">Aplicar filtro</button>
            @if (_texto.Length > 0 || _desde.Length > 0 || _hasta.Length > 0)
            {
                <button class="ac-btn ac-btn-ghost" @onclick="LimpiarAsync" disabled="@_busy">Limpiar</button>
            }
        </div>
    </div>

    @* ---- Galeria: lista | visor | (formulario, si el usuario eligio la vista "columna") ---- *@
    <div class="ac-gallery @(ColumnaActiva ? "con-panel" : "")" id="acGallery" style="@(ColumnaActiva ? $"--ac-panel-w:{_panelW}px" : null)">
        @* Lista de facturas por autorizar *@
        <div class="ac-col-list">
            <div class="ac-list-head">
                <strong>Facturas por autorizar</strong>
                <span class="ac-badge">@ItemsMostrados.Count</span>
            </div>
            @if (_aviso is { Length: > 0 })
            {
                <div class="ac-ok" style="margin:0 0 8px;">@_aviso</div>
            }
            @if (_miTenantUserId is not null)
            {
                <label class="ac-mine" title="Muestra solo las facturas asignadas a ti (desde el conciliador)">
                    <input type="checkbox" checked="@_soloMios" @onchange="OnSoloMiosChanged" />
                    <span>Solo mis documentos (asignados a mi)</span>
                </label>
            }
            <div class="ac-list">
                @if (_busy)
                {
                    <div class="ac-muted" style="padding:16px 4px;">Cargando...</div>
                }
                else if (ItemsMostrados.Count == 0)
                {
                    <div class="ac-muted" style="padding:16px 4px;">@(_soloMios && _miTenantUserId is not null ? "No tienes facturas asignadas pendientes de autorizar." : "No hay facturas pendientes de autorizar con el filtro actual.")</div>
                }
                else
                {
                    @foreach (var r in ItemsMostrados)
                    {
                        <div class="ac-card @(_sel?.Id == r.Id ? "activa" : "")" @key="r.Id" @onclick="() => SelectAsync(r)">
                            <h5>@Txt(r.NombreProveedor)</h5>
                            <div class="ac-dato">Factura: <span>@Txt(r.NumFacturaProveedor)</span></div>
                            <div class="ac-dato">Fecha: <span>@Fecha(r.FechaEmision)</span></div>
                            <div class="ac-dato">NIT: <span>@Txt(r.NitProveedor)</span></div>
                            <div class="ac-dato">Total: <span class="ac-total">@Moneda(r.TotalFactura)</span></div>
                            @if (_solicitadas.TryGetValue(r.Id, out var actNum))
                            {
                                <div class="ac-dato">Actividad: <span class="ac-act" title="Actividad con la que quedo asignada esta factura">@actNum</span></div>
                            }
                            @if (!ColumnaActiva)
                            {
                                @* En vista "columna" el formulario ya esta a la derecha: basta con seleccionar la tarjeta. *@
                                @* Con tarea abre su formulario; sin tarea, la asignacion de usuario. *@
                                var conTarea = _solicitadas.ContainsKey(r.Id);
                                <button class="ac-card-btn" @onclick="() => AbrirPanelAsync(r)" @onclick:stopPropagation="true"
                                        title="@(conTarea ? "Abrir el formulario de la actividad" : "Asignar usuario y solicitar la autorizacion")">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8M16 17H8M10 9H8"/></svg>
                                    @(conTarea ? "Formulario" : "Crear tarea")
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Visor del documento *@
        <div class="ac-col-visor">
            <div class="ac-visor">
                @if (_sel is null)
                {
                    <div class="ac-visor-msg"><div class="ac-visor-ico">PDF</div><span>Selecciona una factura de la lista para ver el documento.</span></div>
                }
                else if (_viewLoading)
                {
                    <div class="ac-visor-msg"><span>Cargando documento...</span></div>
                }
                else if (_viewUrl is null)
                {
                    <div class="ac-visor-msg"><div class="ac-visor-ico">PDF</div><span>La factura @Txt(_sel.NumFacturaProveedor) aun no tiene documento descargado.</span></div>
                }
                else
                {
                    <div class="ac-visor-bar">
                        @if (_viewFiles.Count > 1)
                        {
                            @foreach (var f in _viewFiles)
                            {
                                <button class="ac-doc-tab @(_viewFile?.Id == f.Id ? "on" : "")" @onclick="() => SelectFile(f)">@Tag(f)</button>
                            }
                        }
                        else if (_viewFile is { } vf)
                        {
                            <span class="ac-doc-tab on">@Tag(vf)</span>
                        }
                        <div class="ac-zoom">
                            <button type="button" @onclick="ZoomMas" title="Acercar">+</button>
                            <button type="button" @onclick="ZoomMenos" title="Alejar">&minus;</button>
                            <button type="button" @onclick="ZoomAncho" title="Ajustar al ancho">Ancho</button>
                        </div>
                        <div style="flex:1"></div>
                        <a class="ac-doc-open" href="@_viewUrl" target="_blank" rel="noopener">Abrir en pestana &#8599;</a>
                    </div>
                    <div class="ac-pdf-scroll" id="acPdfScroll"><div id="acPdfPages"></div></div>
                }
            </div>
        </div>

        @* Vista "columna": el formulario fijo a la derecha, con ancho ajustable (tirador) que se recuerda por usuario. *@
        @if (ColumnaActiva)
        {
            <div class="ac-col-form">
                <div class="ac-rz" id="acPanelRz" title="Arrastra para cambiar el ancho (doble clic: ancho por defecto)"></div>
                <div class="ac-col-form-head">
                    @if (_sel is null)
                    {
                        <h3>Formulario de autorizacion</h3>
                    }
                    else
                    {
                        <h3 title="@_sel.NombreProveedor">@Txt(_sel.NombreProveedor) &middot; @Txt(_sel.NumFacturaProveedor)</h3>
                    }
                    @VistaToggle
                </div>
                <div class="ac-col-form-body">
                    @if (_sel is null)
                    {
                        <div class="ac-muted" style="padding:14px 4px;">Selecciona una factura de la lista para llenar su formulario.</div>
                    }
                    else
                    {
                        @FormPanel
                    }
                </div>
            </div>
        }

    </div>

    @* Vista "modal": formulario del concepto en ventana (se abre con el boton de cada tarjeta). El detalle de la
       factura ya se ve en la tarjeta y en el visor, asi que el modal va directo al formulario. *@
    @if (!ColumnaActiva && _panelOpen && _sel is not null)
    {
        <div class="ac-modal-backdrop" @onclick="CerrarPanel"></div>
        <div class="ac-modal ac-detail-modal" @onclick:stopPropagation="true">
            <div class="ac-modal-head">
                <h3>@Txt(_sel.NombreProveedor) &middot; @Txt(_sel.NumFacturaProveedor)</h3>
                @VistaToggle
                <button class="ac-modal-close" @onclick="CerrarPanel">&times;</button>
            </div>
            <div class="ac-modal-body">
                @FormPanel
            </div>
        </div>
    }

</div>

@code {
    // Formulario de autorizacion + acciones: el MISMO fragmento se pinta en el modal o en la columna derecha.
    private RenderFragment FormPanel => @<text>
            @if (_sel is not null)
            {
                <div class="ac-panel ac-form-panel">
                    @if (_solicitada is { } snum)
                    {
                        @* CON tarea: SOLO el formulario DE LA TAREA (respuesta anclada a su numero, la misma del detalle de
                           la tarea), asi sus botones operan el flujo de esa tarea. Ya esta asignada: no se ofrece asignar. *@
                        @if (_taskForm is { } tf)
                        {
                            <div class="ac-form-head">
                                <h4>@tf.Titulo</h4>
                                <span class="ac-form-tag">Actividad @tf.Reference</span>
                            </div>
                            <DynamicFormRenderer @ref="_formRenderer" DefinitionId="tf.DefinitionId" ResponseId="tf.ResponseId" Reference="@tf.Reference"
                                                 Mode="@(tf.SoloLectura ? FormRenderMode.ReadOnly : FormRenderMode.Fill)" ShowHeader="false"
                                                 HiddenContainerIds="_hiddenSecsTarea" HonorHideSubmitBar="true" AutosaveWhenHidden="true" OnStepCompleted="OnPasoCompletadoAsync" TaskTokens="@BuildFormTokens()"
                                                 SubmittedByTenantUserId="_miTenantUserId" @key="tf.Key" />
                        }
                        else
                        {
                            <div class="ac-muted" style="padding:12px 2px;">
                                La factura tiene la actividad <b>@snum</b>, pero no se encontro su formulario (la actividad no existe o su concepto no tiene formulario activo).
                            </div>
                        }
                        <div class="ac-acciones">
                            @if (_errMsg is { Length: > 0 })
                            {
                                <div class="ac-err">@_errMsg</div>
                            }
                            @if (_okMsg is { Length: > 0 })
                            {
                                <div class="ac-ok">@_okMsg</div>
                            }
                        </div>
                    }
                    else
                    {
                        @* SIN tarea: SOLO asignar el usuario y crear la tarea (un solo boton). Es la MISMA tarea que crea
                           el conciliador DIAN (IConciliacionTareaService). El formulario aparece cuando ya existe la tarea. *@
                        var salida = SalidaSel;
                        <div class="ac-form-head">
                            <h4>Asignar y crear tarea</h4>
                            @if (salida is not null && !string.IsNullOrWhiteSpace(salida.Subcategoria))
                            {
                                <span class="ac-form-tag">@if (!string.IsNullOrWhiteSpace(salida.Categoria)) { <text>@salida.Categoria &rsaquo; </text> }@salida.Subcategoria</span>
                            }
                        </div>
                        <div class="ac-acciones ac-acciones-solo">
                            <div class="ac-f">
                                <label class="ac-f-lbl">Asignar a</label>
                                <select class="ac-in" style="width:100%" @bind="AsignadoStr">
                                    <option value="">&mdash; Sin asignar &mdash;</option>
                                    @foreach (var u in _usuarios)
                                    {
                                        <option value="@u.Id">@UserLabel(u)</option>
                                    }
                                </select>
                            </div>
                            @if (_salidasRun.Count > 1)
                            {
                                <div class="ac-f">
                                    <label class="ac-f-lbl">Tipo de tarea</label>
                                    <select class="ac-in" style="width:100%" @bind="SalidaStr">
                                        @foreach (var so in _salidasRun)
                                        {
                                            <option value="@so.Id">@so.Nombre</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (_errMsg is { Length: > 0 })
                            {
                                <div class="ac-err">@_errMsg</div>
                            }
                            @if (_okMsg is { Length: > 0 })
                            {
                                <div class="ac-ok">@_okMsg</div>
                            }
                            <button class="ac-btn ac-btn-ok" style="width:100%" @onclick="CrearTareaAsync"
                                    disabled="@(_solicitando || salida is null || _asignadoSel is null)"
                                    title="@CrearTareaTitle(salida)">
                                @(_solicitando ? "Creando..." : "Crear tarea")
                            </button>
                        </div>
                    }
                </div>
            }
        </text>;

    // Selector de vista (modal | columna derecha). En pantalla angosta la columna no cabe y se usa el modal.
    private RenderFragment VistaToggle => @<div class="ac-vista" role="group" aria-label="Como ver el formulario">
            <button type="button" class="@(_vista == VistaModal ? "on" : "")" title="Ver el formulario en una ventana (modal)"
                    @onclick="() => CambiarVistaAsync(VistaModal)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><rect x="7" y="8" width="10" height="8" rx="1"/></svg>
                Modal
            </button>
            <button type="button" class="@(_vista == VistaColumna ? "on" : "")" disabled="@_angosta"
                    title="@(_angosta ? "La pantalla es muy angosta para la columna" : "Ver el formulario como columna a la derecha")"
                    @onclick="() => CambiarVistaAsync(VistaColumna)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg>
                Columna
            </button>
        </div>;
}

@code {
    private string _texto = string.Empty;
    private string _desde = string.Empty;
    private string _hasta = string.Empty;
    private bool _busy;

    private List<ConciliacionDianRenglonDto> _items = new();
    private ConciliacionDianRenglonDto? _sel;
    private bool _panelOpen;   // vista "modal": el formulario esta abierto en la ventana

    // ---- Vista del formulario: modal o columna derecha (preferencia POR USUARIO en BD, sin migracion:
    // reusa UserTablePreference con su propia clave). Por defecto modal. ----
    private const string PrefsKey = "autorizacion-compras-dian";
    private const string VistaModal = "modal";
    private const string VistaColumna = "columna";
    private const int PanelWDefault = 420;
    private const int PanelWMin = 340;
    private const int PanelWMax = 900;
    private const int AnchoMinColumna = 930;    // ancho minimo de la GALERIA (lista 260 + visor 300 + columna 340 + gaps); menos -> modal
    private string _vista = VistaModal;
    private int _panelW = PanelWDefault;
    private bool _angosta;                       // lo informa el navegador (window.innerWidth)
    private bool _refitPdf;                      // re-ajustar el PDF al ancho tras cambiar la distribucion
    private DotNetObjectReference<AutorizacionComprasDian>? _selfRef;
    private bool ColumnaActiva => _vista == VistaColumna && !_angosta;
    private sealed record VistaPrefs(string? Vista, int? PanelW);

    // "Solo mis documentos": filtra las facturas a las asignadas al usuario actual (desde el conciliador). Por
    // defecto ON al abrir el modulo. _miTenantUserId = TenantUser del usuario logueado (mapeo por PlatformUserId).
    private bool _soloMios = true;
    private Guid? _miTenantUserId;
    private IReadOnlyList<ConciliacionDianRenglonDto> ItemsMostrados
        => (_soloMios && _miTenantUserId is Guid me) ? _items.Where(r => r.AssignedTenantUserId == me).ToList() : _items;

    private bool _viewLoading;
    private List<StoredFileDto> _viewFiles = new();
    private StoredFileDto? _viewFile;
    private string? _viewUrl;

    private static readonly CultureInfo Co = CultureInfo.GetCultureInfo("es-CO");

    // ---- Configuracion del modulo (concepto 000270 + formulario). La EDICION se movio al conciliador
    // (/conciliacion-dian -> "Configuracion de tarea", modulo administrativo); aqui solo se LEE (_cfg)
    // para renderizar el formulario en el panel y crear la actividad. ----
    private AutorizacionModConfigDto _cfg = new(null, null, null, null, null);
    // Ref al renderer: con la barra Enviar/Imprimir oculta (HonorHideSubmitBar) no hay boton de guardar;
    // el renderer guarda solo (AutosaveWhenHidden, cada 3 s si hubo cambios) y ademas se fuerza FlushDraftAsync al cambiar de factura o de vista.
    private DynamicFormRenderer? _formRenderer;

    // ---- Acciones: usuarios del sistema + asignacion por factura ----
    private List<TenantUserDto> _usuarios = new();
    private Guid? _asignadoSel;
    private string? _okMsg;

    private static string UserLabel(TenantUserDto u)
        => !string.IsNullOrWhiteSpace(u.DisplayName) ? u.DisplayName!
        : (u.Email.Contains('@') ? char.ToUpperInvariant(u.Email[0]) + u.Email[1..u.Email.IndexOf('@')] : u.Email);

    // Tokens {tareas.campo} para el formulario del panel: el modulo no tiene aun una tarea creada, pero SI
    // conoce el usuario asignado a la factura, asi un campo con origen SystemUser y default "Usuario asignado"
    // (AssignedUser) cae por defecto en ese usuario. Se reconstruye por render (barato) con el asignado vigente.
    private IReadOnlyDictionary<string, string?> BuildFormTokens()
        => new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase)
        {
            ["asignado"] = _asignadoSel?.ToString(),
        };

    // Enlace del desplegable de responsable. Con @bind (no value= ni selected por opcion) Blazor fija el
    // valor del <select> nativo en cada render, asi al cambiar de factura se refresca (incluido a vacio);
    // con selected/value plano el navegador dejaba "pegado" el responsable de la factura anterior.
    private string AsignadoStr
    {
        get => _asignadoSel?.ToString() ?? string.Empty;
        set { _asignadoSel = Guid.TryParse(value, out var g) ? g : null; _okMsg = null; }
    }

    // ---- Tarea de la factura (creada aqui o en el conciliador DIAN) ----
    private string? _errMsg;
    private string? _solicitada;   // numero de actividad ya solicitada para la factura
    private Dictionary<Guid, string> _solicitadas = new();   // renglon -> actividad (para las tarjetas)
    private bool _solicitando;

    // Formulario de la TAREA ya creada para la factura: el mismo que muestra el detalle de la tarea (respuesta
    // anclada a su numero). Sus botones de regla (Redireccionar / Aprobar / Rechazar) resuelven la tarea por esa
    // referencia, por eso deben ver el numero de tarea y no el Id de la factura. null = factura sin tarea.
    private sealed record TaskFormRef(Guid DefinitionId, Guid? ResponseId, string Reference, string Titulo, bool SoloLectura)
    {
        public object Key => (object?)ResponseId ?? Reference;
    }
    private TaskFormRef? _taskForm;
    private IReadOnlyList<Guid> _hiddenSecsTarea = Array.Empty<Guid>();

    // Solo LECTURAS (sin tocar el estado): se llama en serie antes de publicar la seleccion (DbContext compartido).
    private async Task<(TaskFormRef? Form, IReadOnlyList<Guid> Hidden)> CargarFormTareaAsync(string? numero)
    {
        if (string.IsNullOrWhiteSpace(numero)) { return (null, Array.Empty<Guid>()); }
        try
        {
            if (await Cfg.ResolveTaskIdByNumberAsync(numero) is not Guid taskId) { return (null, Array.Empty<Guid>()); }
            var g = await FormResponses.GetTaskConceptFormsAsync(taskId);
            if (g is null) { return (null, Array.Empty<Guid>()); }
            // El activo efectivo; si la tarea aun no tiene respuesta, el renderer crea el borrador anclado a su numero.
            var it = g.Items.FirstOrDefault(x => x.IsActive) ?? g.Items.FirstOrDefault();
            var hidden = await Cfg.GetHiddenContainerIdsForFormAsync(g.DefinitionId);
            // Solo lectura si el formulario ya se envio o la tarea ya termino (sus botones ya no deben actuar).
            var terminada = await Cfg.IsTareaTerminadaAsync(numero);
            var form = new TaskFormRef(g.DefinitionId, it?.ResponseId, it?.Reference ?? numero, g.FormTitle,
                SoloLectura: terminada || it?.Status == Ecorex.Domain.Enums.FormResponseStatus.Submitted);
            return (form, hidden);
        }
        catch { return (null, Array.Empty<Guid>()); }
    }

    // Salidas al flujo (concepto + formulario) configuradas en el conciliador: las MISMAS que usa su "+ Tarea".
    private List<SalidaFlujoDto> _salidasRun = new();
    private Guid? _salidaSelId;
    private SalidaFlujoDto? SalidaSel => _salidasRun.FirstOrDefault(x => x.Id == _salidaSelId) ?? _salidasRun.FirstOrDefault();
    private string SalidaStr
    {
        get => SalidaSel?.Id.ToString() ?? string.Empty;
        set { _salidaSelId = Guid.TryParse(value, out var g) ? g : null; _okMsg = null; }
    }

    private string CrearTareaTitle(SalidaFlujoDto? salida)
        => salida is null ? "Configura primero una salida (concepto) en el conciliador DIAN"
        : _asignadoSel is null ? "Elige el usuario"
        : "Asigna la factura al usuario y crea su tarea (la misma del conciliador DIAN)";

    // Un solo boton: asigna la factura (columna del conciliador, con su historial) y crea la tarea con la misma
    // logica del conciliador DIAN (IConciliacionTareaService): mismo titulo/resumen, formulario prellenado, PDFs
    // como documentos y vinculo factura->tarea. Luego el panel pasa al formulario de la tarea.
    private async Task CrearTareaAsync()
    {
        if (_sel is null || _solicitando) { return; }
        _errMsg = null; _okMsg = null;
        var salida = SalidaSel;
        if (salida is null) { _errMsg = "Configura primero una salida (concepto) en el conciliador DIAN."; return; }
        if (_asignadoSel is not Guid assignee) { _errMsg = "Elige el usuario al que se asigna la tarea."; return; }
        if (_solicitadas.ContainsKey(_sel.Id)) { return; }   // ya tiene tarea
        _solicitando = true;
        try
        {
            var sel = _sel;
            await Svc.SetAssigneeAsync(sel.Id, assignee);
            var asignada = sel with { AssignedTenantUserId = assignee };
            var i = _items.FindIndex(x => x.Id == sel.Id);
            if (i >= 0) { _items[i] = asignada; }
            _sel = asignada;

            var (ok, res) = await TareaSvc.CrearTareaAsync(asignada, salida, assignee, await ActorAsync(), await ActorNameAsync());
            if (!ok) { _errMsg = res; return; }
            var (tform, thidden) = await CargarFormTareaAsync(res);
            _solicitada = res;
            _solicitadas[sel.Id] = res;   // la tarjeta muestra la actividad sin recargar
            _taskForm = tform;
            _hiddenSecsTarea = thidden;
            var userLabel = _usuarios.FirstOrDefault(u => u.Id == assignee) is { } u ? UserLabel(u) : null;
            _okMsg = $"Tarea {res} creada" + (userLabel is { } ul ? $" y asignada a {ul}." : ".");
        }
        catch (Exception ex) { _errMsg = "Error al crear la tarea: " + ex.Message; }
        finally { _solicitando = false; }
    }

    // Aviso sobre la lista (p. ej. "la tarea termino y la factura salio del modulo").
    private string? _aviso;

    // Un boton del formulario cerro el paso del flujo (COMPLETAR_PASO_FLUJO / Aprobar). Si con eso la tarea quedo
    // TERMINADA, la factura ya no esta por autorizar: sale de la lista y se pasa a la siguiente. El retiro va
    // DIFERIDO porque esta callback corre dentro del click del propio renderer: desmontarlo aqui lo romperia.
    private async Task OnPasoCompletadoAsync()
    {
        if (_sel is null || _solicitada is not { } num) { return; }
        bool terminada;
        try { terminada = await Cfg.IsTareaTerminadaAsync(num); }
        catch { return; }
        if (!terminada) { return; }
        var id = _sel.Id;
        _aviso = $"Tarea {num} terminada: la factura sale del modulo.";
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(1500);   // deja ver el resultado de la regla antes de retirar la factura
                await SacarFacturaAsync(id);
            }
            catch (ObjectDisposedException) { /* el usuario salio de la pagina */ }
        });
    }

    private async Task SacarFacturaAsync(Guid id)
    {
        var vis = ItemsMostrados.ToList();
        var idx = vis.FindIndex(x => x.Id == id);
        _items.RemoveAll(x => x.Id == id);
        if (_sel?.Id != id) { StateHasChanged(); return; }
        // Sin flush: el formulario de la tarea terminada ya se persistio (autosave + la propia regla).
        _sel = null; _solicitada = null; _taskForm = null; _hiddenSecsTarea = Array.Empty<Guid>();
        _panelOpen = false;   // modal: se cierra; columna: muestra la siguiente factura
        _viewUrl = null; _viewFiles = new(); _viewFile = null;
        StateHasChanged();
        var restantes = ItemsMostrados;
        if (restantes.Count > 0) { await SelectAsync(restantes[Math.Clamp(idx, 0, restantes.Count - 1)]); }
        StateHasChanged();
    }

    private async Task<Guid> ActorAsync()
    {
        var st = await AuthState.GetAuthenticationStateAsync();
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }
    private async Task<string> ActorNameAsync()
    {
        var st = await AuthState.GetAuthenticationStateAsync();
        return st.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
    }

    protected override async Task OnInitializedAsync()
    {
        _cfg = await Cfg.GetAsync();
        try { _salidasRun = (await Cfg.ListSalidasAsync()).Where(x => x.SubcategoriaId is not null).ToList(); }
        catch { _salidasRun = new(); }
        // Por defecto la salida del concepto configurado en el modulo; si no, la primera.
        _salidaSelId = _salidasRun.FirstOrDefault(x => x.SubcategoriaId == _cfg.SubcategoriaId)?.Id ?? _salidasRun.FirstOrDefault()?.Id;
        _usuarios = (await Users.ListAsync()).ToList();
        // Resolver el TenantUser del usuario actual (por PlatformUserId) para el filtro "solo mis documentos".
        var actor = await ActorAsync();
        _miTenantUserId = _usuarios.FirstOrDefault(u => u.PlatformUserId == actor)?.Id;
        _soloMios = _miTenantUserId is not null;   // por defecto filtra a mis documentos si se pudo resolver
        await CargarVistaAsync();                  // antes de montar el formulario (mismo DbContext, en serie)
        await CargarAsync();
    }

    private async Task CargarVistaAsync()
    {
        try
        {
            var raw = await Prefs.GetAsync(PrefsKey);
            if (string.IsNullOrWhiteSpace(raw)) { return; }
            var p = System.Text.Json.JsonSerializer.Deserialize<VistaPrefs>(raw);
            _vista = p?.Vista == VistaColumna ? VistaColumna : VistaModal;
            if (p?.PanelW is int w) { _panelW = Math.Clamp(w, PanelWMin, PanelWMax); }
        }
        catch { /* preferencia ilegible: se queda la vista por defecto */ }
    }

    private async Task GuardarVistaAsync()
    {
        try { await Prefs.SaveAsync(PrefsKey, System.Text.Json.JsonSerializer.Serialize(new VistaPrefs(_vista, _panelW))); }
        catch { /* no guardar la preferencia nunca debe romper la pantalla */ }
    }

    // Persiste el borrador del formulario MONTADO (modal abierto o columna visible). Con la barra Enviar oculta
    // (HonorHideSubmitBar) no hay autosave: sin esto, cambiar de factura o de vista perdia lo escrito.
    private async Task FlushFormAsync()
    {
        // Solo hay formulario montado cuando la factura tiene tarea (sin tarea el panel es solo la asignacion).
        if (_formRenderer is null || _sel is null || _solicitada is null || _taskForm is null || !(ColumnaActiva || _panelOpen)) { return; }
        try { await _formRenderer.FlushDraftAsync(); } catch { /* no bloquear el cambio por el guardado */ }
    }

    private async Task CambiarVistaAsync(string vista)
    {
        if (vista == _vista || (vista == VistaColumna && _angosta)) { return; }
        await FlushFormAsync();
        _vista = vista;
        // Pasar a modal deja el formulario abierto en la ventana (el usuario no pierde el hilo); a columna, se cierra el modal.
        _panelOpen = vista == VistaModal && _sel is not null;
        _refitPdf = true;
        await GuardarVistaAsync();
    }

    // El navegador avisa si la ventana cruza el ancho minimo de la columna.
    [JSInvokable]
    public async Task OnViewportChanged(bool angosta)
    {
        if (angosta == _angosta) { return; }
        await InvokeAsync(async () =>
        {
            if (angosta) { await FlushFormAsync(); }
            _angosta = angosta;
            _refitPdf = true;
            StateHasChanged();
        });
    }

    // Fin del arrastre del tirador de la columna: se recuerda el ancho del usuario.
    [JSInvokable]
    public async Task OnPanelResized(int ancho)
    {
        await InvokeAsync(async () =>
        {
            _panelW = Math.Clamp(ancho, PanelWMin, PanelWMax);
            await GuardarVistaAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ecorexAutVisor.disposeLayout"); } catch { /* circuito cerrado */ }
        _selfRef?.Dispose();
    }

    private ConciliacionDianFiltro Filtro()
    {
        DateTimeOffset? desde = DateTimeOffset.TryParse(_desde, out var d) ? d : null;
        DateTimeOffset? hasta = DateTimeOffset.TryParse(_hasta, out var h) ? h.AddDays(1).AddTicks(-1) : null; // incluye todo el dia
        return new ConciliacionDianFiltro(string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim(), desde, hasta);
    }

    private async Task CargarAsync()
    {
        _busy = true;
        try
        {
            _items = (await Svc.ListPorAutorizarAsync(Filtro())).ToList();
            // La factura sale del modulo cuando la tarea que la porta ya termino o se cerro.
            try
            {
                var terminadas = await Cfg.GetRenglonesConTareaTerminadaAsync();
                if (terminadas.Count > 0) { _items = _items.Where(r => !terminadas.Contains(r.Id)).ToList(); }
            }
            catch { /* sin el filtro la lista sigue siendo util */ }
            // Actividad ya creada por factura (renglon -> numero), una sola lectura para pintar las tarjetas.
            try { _solicitadas = new Dictionary<Guid, string>(await Cfg.GetSolicitadasMapAsync()); }
            catch { _solicitadas = new(); }
            // Si la seleccion ya no esta en la lista MOSTRADA (respeta "solo mios"), se limpia; si no hay, se abre la primera.
            var vis = ItemsMostrados;
            if (_sel is not null && vis.All(x => x.Id != _sel.Id)) { _sel = null; _viewUrl = null; _viewFiles = new(); _viewFile = null; }
            if (_sel is null && vis.Count > 0) { await SelectAsync(vis[0]); }
        }
        finally { _busy = false; }
    }

    private async Task AplicarAsync() { _sel = null; await CargarAsync(); }

    private async Task OnSoloMiosChanged(ChangeEventArgs e)
    {
        _soloMios = e.Value is bool b && b;
        // Al cambiar el filtro, si la seleccion ya no esta en la lista mostrada se abre la primera de la nueva lista.
        var vis = ItemsMostrados;
        if (_sel is not null && vis.All(x => x.Id != _sel.Id)) { _sel = null; _viewUrl = null; _viewFiles = new(); _viewFile = null; }
        if (_sel is null && vis.Count > 0) { await SelectAsync(vis[0]); }
    }
    private async Task LimpiarAsync() { _texto = _desde = _hasta = string.Empty; _sel = null; await CargarAsync(); }
    private async Task OnFilterKey(KeyboardEventArgs e) { if (e.Key == "Enter") { await AplicarAsync(); } }

    private async Task SelectAsync(ConciliacionDianRenglonDto r)
    {
        // IMPORTANTE (concurrencia del DbContext): hacer TODAS las lecturas de este panel (config +
        // archivos) ANTES de exponer la factura. El DbContext es scoped al circuito y lo comparten estos
        // servicios (Cfg, Files via EcorexDbContext) Y el DynamicFormRenderer. Si asignamos _sel primero,
        // el primer await provoca un render que monta el form (nuevo @key) y este consulta FormDefinitions
        // en el MISMO contexto mientras estas lecturas siguen en vuelo -> "A second operation was started
        // on this context instance" y el circuito muere (la UI, y el responsable, se quedan pegados).
        // Serializando (leer primero, publicar _sel + render al final) no hay dos operaciones a la vez.
        // Vista columna: al saltar a otra factura se guarda primero el borrador de la actual (tambien en serie).
        if (_sel is not null && _sel.Id != r.Id) { await FlushFormAsync(); }
        var asignado = r.AssignedTenantUserId ?? await Cfg.GetAsignadoAsync(r.Id);
        var solicitada = await Cfg.GetSolicitadaAsync(r.Id);
        var (taskForm, hiddenTarea) = await CargarFormTareaAsync(solicitada);
        List<StoredFileDto> viewFiles = new();
        try
        {
            var files = string.IsNullOrWhiteSpace(r.Cufe)
                ? new List<StoredFileDto>()
                : (await Files.ListAsync("ConciliacionDian", r.Cufe)).ToList();
            // Solo PDFs; preferir la representacion grafica de NEWTON, caer al PDF de la DIAN.
            viewFiles = files.Where(f => EsPdf(f)).OrderByDescending(EsNewton).ToList();
        }
        catch { viewFiles = new(); }

        _sel = r;
        _okMsg = null; _errMsg = null;
        // Sin asignado guardado, por defecto el usuario actual (quien gestiona la factura se la asigna a si mismo).
        _asignadoSel = asignado ?? _miTenantUserId;
        _solicitada = solicitada;
        _taskForm = taskForm;
        _hiddenSecsTarea = hiddenTarea;
        _viewFiles = viewFiles;
        _viewFile = viewFiles.FirstOrDefault();
        _viewUrl = _viewFile?.Url;
        _viewLoading = false;
        StateHasChanged();
    }

    private void SelectFile(StoredFileDto f) { _viewFile = f; _viewUrl = f.Url; }

    // Abre el modal de detalle+formulario para una factura (selecciona primero -> carga visor + datos).
    private async Task AbrirPanelAsync(ConciliacionDianRenglonDto r)
    {
        await SelectAsync(r);
        _panelOpen = true;
    }
    // Al cerrar el modal se PERSISTE el borrador: el autosave corre cada 3 s, asi que sin este flush se
    // perderia lo escrito si el usuario cierra (x / fondo) antes del siguiente tick. FlushDraftAsync es no-op si no hay borrador o no hubo cambios.
    private async Task CerrarPanel()
    {
        await FlushFormAsync();   // no-op si la factura no tiene tarea (no hay formulario montado)
        _panelOpen = false;
    }

    // ---- Visor PDF (zoom + arrastre) via interop ----
    private string? _loadedUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Avisos del navegador: ventana angosta (la columna no cabe) y fin del arrastre del ancho de la columna.
            _selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("ecorexAutVisor.initLayout", _selfRef, AnchoMinColumna); } catch { }
        }
        if (ColumnaActiva)
        {
            // El tirador se crea con la columna: engancharlo (idempotente por elemento).
            try { await JS.InvokeVoidAsync("ecorexAutVisor.wireResize", PanelWMin, PanelWMax, PanelWDefault); } catch { }
        }
        if (_refitPdf)
        {
            _refitPdf = false;
            try { await JS.InvokeVoidAsync("ecorexAutVisor.ajustar"); } catch { }
        }
        if (_viewUrl is { } u && u != _loadedUrl)
        {
            _loadedUrl = u;
            try { await JS.InvokeVoidAsync("ecorexAutVisor.cargar", u); } catch { /* el visor muestra su propio error */ }
        }
        else if (_viewUrl is null) { _loadedUrl = null; }
    }

    private async Task ZoomMas() { try { await JS.InvokeVoidAsync("ecorexAutVisor.zoomMas"); } catch { } }
    private async Task ZoomMenos() { try { await JS.InvokeVoidAsync("ecorexAutVisor.zoomMenos"); } catch { } }
    private async Task ZoomAncho() { try { await JS.InvokeVoidAsync("ecorexAutVisor.zoomAncho"); } catch { } }

    private static bool EsPdf(StoredFileDto f)
        => (f.ContentType ?? "").Contains("pdf", StringComparison.OrdinalIgnoreCase)
        || (f.FileName ?? "").EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    private static bool EsNewton(StoredFileDto f)
        => ((f.Ref2 ?? "") + (f.FileName ?? "")).Contains("newton", StringComparison.OrdinalIgnoreCase);
    private static string Tag(StoredFileDto f) => EsNewton(f) ? "NEWTON" : "DIAN";

    private static string Txt(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    private static string Fecha(DateTimeOffset v) => v.ToString("dd/MM/yyyy");
    private static string Moneda(decimal v) => "$" + v.ToString("N2", Co);
