@page "/autorizacion-compras-dian"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Ecorex.Application.Automatizaciones.ConciliacionDian
@using Ecorex.Application.Crm
@using Ecorex.Application.Forms
@using Ecorex.Application.Storage
@using Ecorex.Application.Tenancy
@using Ecorex.SuperAdmin.Components.Shared.Forms
@inject IConciliacionDianService Svc
@inject IFileStorageService Files
@inject IAutorizacionComprasConfigService Cfg
@inject ITenantUserService Users
@inject ITaskItemService Tasks
@inject IFormResponseService FormResponses
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Autorizacion facturas compras DIAN - ECOREX.tareas</PageTitle>

<div class="ac-wrap">
    <div class="ac-head">
        <div class="ac-head-row">
            <div>
                <div class="ac-kicker">COMPRAS</div>
                <h1 class="ac-title">Autorizacion facturas compras DIAN</h1>
            </div>
        </div>
        <p class="ac-sub">Facturas de compra reportadas a la DIAN que aun no tienen una orden de compra y estan pendientes de autorizar. Selecciona una para ver su documento.</p>
    </div>

    @* ---- Filtros ---- *@
    <div class="ac-filters">
        <div class="ac-f">
            <label>Proveedor / NIT</label>
            <input class="ac-in" value="@_texto" @onchange="e => _texto = e.Value?.ToString() ?? string.Empty" @onkeydown="OnFilterKey" placeholder="Nombre o NIT..." />
        </div>
        <div class="ac-f">
            <label>Desde</label>
            <input class="ac-in" type="date" value="@_desde" @onchange="e => _desde = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="ac-f">
            <label>Hasta</label>
            <input class="ac-in" type="date" value="@_hasta" @onchange="e => _hasta = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="ac-f ac-f-btn">
            <button class="ac-btn" @onclick="AplicarAsync" disabled="@_busy">Aplicar filtro</button>
            @if (_texto.Length > 0 || _desde.Length > 0 || _hasta.Length > 0)
            {
                <button class="ac-btn ac-btn-ghost" @onclick="LimpiarAsync" disabled="@_busy">Limpiar</button>
            }
        </div>
    </div>

    @* ---- Galeria de 3 columnas ---- *@
    <div class="ac-gallery">
        @* Lista de facturas por autorizar *@
        <div class="ac-col-list">
            <div class="ac-list-head">
                <strong>Facturas por autorizar</strong>
                <span class="ac-badge">@ItemsMostrados.Count</span>
            </div>
            @if (_miTenantUserId is not null)
            {
                <label class="ac-mine" title="Muestra solo las facturas asignadas a ti (desde el conciliador)">
                    <input type="checkbox" checked="@_soloMios" @onchange="OnSoloMiosChanged" />
                    <span>Solo mis documentos (asignados a mi)</span>
                </label>
            }
            <div class="ac-list">
                @if (_busy)
                {
                    <div class="ac-muted" style="padding:16px 4px;">Cargando...</div>
                }
                else if (ItemsMostrados.Count == 0)
                {
                    <div class="ac-muted" style="padding:16px 4px;">@(_soloMios && _miTenantUserId is not null ? "No tienes facturas asignadas pendientes de autorizar." : "No hay facturas pendientes de autorizar con el filtro actual.")</div>
                }
                else
                {
                    @foreach (var r in ItemsMostrados)
                    {
                        <div class="ac-card @(_sel?.Id == r.Id ? "activa" : "")" @key="r.Id" @onclick="() => SelectAsync(r)">
                            <h5>@Txt(r.NombreProveedor)</h5>
                            <div class="ac-dato">Factura: <span>@Txt(r.NumFacturaProveedor)</span></div>
                            <div class="ac-dato">Fecha: <span>@Fecha(r.FechaEmision)</span></div>
                            <div class="ac-dato">NIT: <span>@Txt(r.NitProveedor)</span></div>
                            <div class="ac-dato">Total: <span class="ac-total">@Moneda(r.TotalFactura)</span></div>
                            <button class="ac-card-btn" @onclick="() => AbrirPanelAsync(r)" @onclick:stopPropagation="true"
                                    title="Ver detalle de la factura y el formulario de autorizacion">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8M16 17H8M10 9H8"/></svg>
                                Detalle y formulario
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        @* Visor del documento *@
        <div class="ac-col-visor">
            <div class="ac-visor">
                @if (_sel is null)
                {
                    <div class="ac-visor-msg"><div class="ac-visor-ico">PDF</div><span>Selecciona una factura de la lista para ver el documento.</span></div>
                }
                else if (_viewLoading)
                {
                    <div class="ac-visor-msg"><span>Cargando documento...</span></div>
                }
                else if (_viewUrl is null)
                {
                    <div class="ac-visor-msg"><div class="ac-visor-ico">PDF</div><span>La factura @Txt(_sel.NumFacturaProveedor) aun no tiene documento descargado.</span></div>
                }
                else
                {
                    <div class="ac-visor-bar">
                        @if (_viewFiles.Count > 1)
                        {
                            @foreach (var f in _viewFiles)
                            {
                                <button class="ac-doc-tab @(_viewFile?.Id == f.Id ? "on" : "")" @onclick="() => SelectFile(f)">@Tag(f)</button>
                            }
                        }
                        else if (_viewFile is { } vf)
                        {
                            <span class="ac-doc-tab on">@Tag(vf)</span>
                        }
                        <div class="ac-zoom">
                            <button type="button" @onclick="ZoomMas" title="Acercar">+</button>
                            <button type="button" @onclick="ZoomMenos" title="Alejar">&minus;</button>
                            <button type="button" @onclick="ZoomAncho" title="Ajustar al ancho">Ancho</button>
                        </div>
                        <div style="flex:1"></div>
                        <a class="ac-doc-open" href="@_viewUrl" target="_blank" rel="noopener">Abrir en pestana &#8599;</a>
                    </div>
                    <div class="ac-pdf-scroll" id="acPdfScroll"><div id="acPdfPages"></div></div>
                }
            </div>
        </div>

    </div>

    @* Detalle de la factura + formulario del concepto, en MODAL (se abre con el boton de cada tarjeta;
       antes era la 3ra columna fija). Deja mas espacio a la lista y al visor. *@
    @if (_panelOpen && _sel is not null)
    {
        <div class="ac-modal-backdrop" @onclick="CerrarPanel"></div>
        <div class="ac-modal ac-detail-modal" @onclick:stopPropagation="true">
            <div class="ac-modal-head">
                <h3>@Txt(_sel.NombreProveedor) &middot; @Txt(_sel.NumFacturaProveedor)</h3>
                <button class="ac-modal-close" @onclick="CerrarPanel">&times;</button>
            </div>
            <div class="ac-modal-body">
                <div class="ac-panel">
                    <h4>Detalle de la factura</h4>
                @if (_sel is { } s)
                {
                    <div class="ac-res">Proveedor<span>@Txt(s.NombreProveedor)</span></div>
                    <div class="ac-res">NIT<span>@Txt(s.NitProveedor)</span></div>
                    <div class="ac-res">Factura<span>@Txt(s.NumFacturaProveedor)</span></div>
                    <div class="ac-res">Tipo doc<span>@Txt(s.TipoDocDian)</span></div>
                    <div class="ac-res">Fecha emision<span>@Fecha(s.FechaEmision)</span></div>
                    <div class="ac-res ac-res-total">Total<span>@Moneda(s.TotalFactura)</span></div>
                    <div class="ac-res">CUFE<span class="ac-cufe" title="@s.Cufe">@(s.Cufe.Length > 22 ? s.Cufe[..22] + "…" : s.Cufe)</span></div>
                }
                else
                {
                    <div class="ac-muted" style="padding:14px 2px;">Selecciona una factura para ver su detalle.</div>
                }
            </div>

            @if (_sel is not null)
            {
                <div class="ac-panel ac-form-panel">
                    @if (_cfg.FormDefinitionId is Guid fid)
                    {
                        <div class="ac-form-head">
                            <h4>@(string.IsNullOrWhiteSpace(_cfg.FormTitle) ? "Datos de la autorizacion" : _cfg.FormTitle)</h4>
                            @if (!string.IsNullOrWhiteSpace(_cfg.Subcategoria))
                            {
                                <span class="ac-form-tag">@_cfg.Categoria @(string.IsNullOrWhiteSpace(_cfg.Categoria) ? "" : "›") @_cfg.Subcategoria</span>
                            }
                        </div>
                        <DynamicFormRenderer @ref="_formRenderer" DefinitionId="fid" Mode="FormRenderMode.Fill" Reference="@_sel.Id.ToString()" ShowHeader="false" HiddenContainerIds="_hiddenSecs" HonorHideSubmitBar="true" TaskTokens="@BuildFormTokens()" @key="_sel.Id" />
                    }
                    else
                    {
                        <div class="ac-muted" style="padding:12px 2px;">
                            Sin formulario configurado. Define el concepto de actividad y el formulario en <b>Conciliacion DIAN Compras &rsaquo; Configuracion de tarea</b> (es el modulo administrativo); aqui se usa esa misma configuracion.
                        </div>
                    }

                    @* ---- Acciones de autorizacion (la de solicitar aun no se codea) ---- *@
                    <div class="ac-acciones">
                        <div class="ac-f">
                            <label class="ac-f-lbl">Asignar a</label>
                            <select class="ac-in" style="width:100%" @bind="AsignadoStr">
                                <option value="">&mdash; Sin asignar &mdash;</option>
                                @foreach (var u in _usuarios)
                                {
                                    <option value="@u.Id">@UserLabel(u)</option>
                                }
                            </select>
                        </div>
                        @if (_errMsg is { Length: > 0 })
                        {
                            <div class="ac-err">@_errMsg</div>
                        }
                        @if (_okMsg is { Length: > 0 })
                        {
                            <div class="ac-ok">@_okMsg</div>
                        }
                        @if (_solicitada is { } snum)
                        {
                            <div class="ac-solic">Autorizacion ya solicitada: <b>@snum</b></div>
                        }
                        <button class="ac-btn" style="width:100%" @onclick="GuardarCambiosAsync" disabled="@_guardando">Guardar cambios</button>
                        <button class="ac-btn ac-btn-ok" style="width:100%" @onclick="SolicitarAutorizacionAsync"
                                disabled="@(_solicitando || _solicitada is not null || _cfg.SubcategoriaId is null)"
                                title="@(_cfg.SubcategoriaId is null ? "Configura primero el concepto de actividad" : "Crea la actividad de autorizacion con el resumen")">
                            @(_solicitando ? "Creando..." : "Solicitar autorizacion")
                        </button>
                    </div>
                </div>
            }
            </div>
        </div>
    }

</div>

@code {
    private string _texto = string.Empty;
    private string _desde = string.Empty;
    private string _hasta = string.Empty;
    private bool _busy;

    private List<ConciliacionDianRenglonDto> _items = new();
    private ConciliacionDianRenglonDto? _sel;
    private bool _panelOpen;   // el detalle+formulario se muestra en modal (boton de la tarjeta), no como columna fija

    // "Solo mis documentos": filtra las facturas a las asignadas al usuario actual (desde el conciliador). Por
    // defecto ON al abrir el modulo. _miTenantUserId = TenantUser del usuario logueado (mapeo por PlatformUserId).
    private bool _soloMios = true;
    private Guid? _miTenantUserId;
    private IReadOnlyList<ConciliacionDianRenglonDto> ItemsMostrados
        => (_soloMios && _miTenantUserId is Guid me) ? _items.Where(r => r.AssignedTenantUserId == me).ToList() : _items;

    private bool _viewLoading;
    private List<StoredFileDto> _viewFiles = new();
    private StoredFileDto? _viewFile;
    private string? _viewUrl;

    private static readonly CultureInfo Co = CultureInfo.GetCultureInfo("es-CO");

    // ---- Configuracion del modulo (concepto 000270 + formulario). La EDICION se movio al conciliador
    // (/conciliacion-dian -> "Configuracion de tarea", modulo administrativo); aqui solo se LEE (_cfg)
    // para renderizar el formulario en el panel y crear la actividad. ----
    private AutorizacionModConfigDto _cfg = new(null, null, null, null, null);
    // Secciones del formulario a OCULTAR aqui (configuradas en la salida del conciliador). Se pasan al renderer.
    private IReadOnlyList<Guid> _hiddenSecs = Array.Empty<Guid>();
    // Ref al renderer: con la barra Enviar/Imprimir oculta (HonorHideSubmitBar) el autosave esta apagado, asi que
    // persistimos el borrador a mano (FlushDraftAsync) al Guardar cambios / Solicitar autorizacion.
    private DynamicFormRenderer? _formRenderer;

    // ---- Acciones: usuarios del sistema + asignacion por factura ----
    private List<TenantUserDto> _usuarios = new();
    private Guid? _asignadoSel;
    private string? _okMsg;
    private bool _guardando;

    private static string UserLabel(TenantUserDto u)
        => !string.IsNullOrWhiteSpace(u.DisplayName) ? u.DisplayName!
        : (u.Email.Contains('@') ? char.ToUpperInvariant(u.Email[0]) + u.Email[1..u.Email.IndexOf('@')] : u.Email);

    // Tokens {tareas.campo} para el formulario del panel: el modulo no tiene aun una tarea creada, pero SI
    // conoce el usuario asignado a la factura, asi un campo con origen SystemUser y default "Usuario asignado"
    // (AssignedUser) cae por defecto en ese usuario. Se reconstruye por render (barato) con el asignado vigente.
    private IReadOnlyDictionary<string, string?> BuildFormTokens()
        => new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase)
        {
            ["asignado"] = _asignadoSel?.ToString(),
        };

    // Enlace del desplegable de responsable. Con @bind (no value= ni selected por opcion) Blazor fija el
    // valor del <select> nativo en cada render, asi al cambiar de factura se refresca (incluido a vacio);
    // con selected/value plano el navegador dejaba "pegado" el responsable de la factura anterior.
    private string AsignadoStr
    {
        get => _asignadoSel?.ToString() ?? string.Empty;
        set { _asignadoSel = Guid.TryParse(value, out var g) ? g : null; _okMsg = null; }
    }

    private async Task GuardarCambiosAsync()
    {
        if (_sel is null) { return; }
        _guardando = true; _okMsg = null; _errMsg = null;
        try
        {
            // La barra Enviar del form esta oculta aqui (autosave apagado): persiste el borrador a mano.
            if (_formRenderer is not null) { await _formRenderer.FlushDraftAsync(); }
            await Cfg.SetAsignadoAsync(_sel.Id, _asignadoSel);
            _okMsg = "Cambios guardados.";
        }
        finally { _guardando = false; }
    }

    // ---- Solicitar autorizacion: crea la actividad con el concepto configurado + resumen ----
    private string? _errMsg;
    private string? _solicitada;   // numero de actividad ya solicitada para la factura
    private bool _solicitando;

    private async Task SolicitarAutorizacionAsync()
    {
        if (_sel is null || _solicitando) { return; }
        _errMsg = null; _okMsg = null;
        if (_cfg.SubcategoriaId is not Guid subId)
        {
            _errMsg = "Configura primero el concepto de actividad en Configuracion.";
            return;
        }
        _solicitando = true;
        try
        {
            // La barra Enviar del form esta oculta aqui (autosave apagado): persiste el borrador ANTES de
            // leerlo, para que el resumen y los datos copiados a la tarea incluyan lo ultimo escrito.
            if (_formRenderer is not null) { await _formRenderer.FlushDraftAsync(); }

            var actor = await ActorAsync();
            var actorName = await ActorNameAsync();

            // Valores del formulario (borrador por factura) para el resumen + para copiarlos a la tarea.
            string? cConcepto = null, cCentro = null, cOrden = null;
            IReadOnlyDictionary<string, Ecorex.Application.Forms.FormFieldValue>? moduleData = null;
            if (_cfg.FormDefinitionId is Guid fid)
            {
                var dr = await FormResponses.GetOrCreateDraftAsync(fid, _sel.Id.ToString());
                if (dr.IsOk && dr.Value is { } resp)
                {
                    moduleData = resp.Data;
                    cConcepto = Campo(resp.Data, "concepto_compra");
                    cCentro = Campo(resp.Data, "centro_costos");
                    cOrden = Campo(resp.Data, "orden_compra");
                }
            }
            var userLabel = _asignadoSel is Guid uid ? _usuarios.FirstOrDefault(u => u.Id == uid) is { } u ? UserLabel(u) : null : null;
            var resumen = BuildResumen(_sel, cConcepto, cCentro, cOrden, userLabel);

            var req = new CreateTaskItemRequest(
                Title: "Autorizacion de compra",
                ActivityTypeId: null,
                Description: resumen,
                AssigneeTenantUserId: _asignadoSel,
                SubcategoriaId: subId,
                RequesterName: _sel.NombreProveedor,
                RequesterDocument: _sel.NitProveedor);

            var result = await Tasks.CreateAsync(req, actor, actorName);
            if (!result.IsOk || result.Value is null)
            {
                _errMsg = result.Error ?? "No se pudo crear la actividad.";
                return;
            }
            var num = result.Value.Item.Number;
            // Copiar los valores del formulario a un borrador keyed por el NUMERO de tarea, para que la
            // actividad muestre el formulario (de la subcategoria) ya diligenciado.
            if (_cfg.FormDefinitionId is Guid fid2 && moduleData is { Count: > 0 })
            {
                try
                {
                    var td = await FormResponses.GetOrCreateDraftAsync(fid2, num);
                    if (td.IsOk && td.Value is { } tdr) { await FormResponses.SaveAsync(tdr.Id, moduleData, false); }
                }
                catch { /* el resumen ya viaja en la descripcion */ }
            }
            await Cfg.SetSolicitadaAsync(_sel.Id, num);
            _solicitada = num;
            _okMsg = $"Actividad {num} de autorizacion creada" + (userLabel is { } ul ? $" (asignada a {ul})." : ".");
        }
        catch (Exception ex) { _errMsg = "Error al crear la actividad: " + ex.Message; }
        finally { _solicitando = false; }
    }

    private static string? Campo(IReadOnlyDictionary<string, Ecorex.Application.Forms.FormFieldValue> data, string code)
        => data.TryGetValue(code, out var v) && !string.IsNullOrWhiteSpace(v.Value) ? v.Value : null;

    private string BuildResumen(ConciliacionDianRenglonDto r, string? concepto, string? centro, string? orden, string? userLabel)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Solicitud de autorizacion de factura de compra DIAN.");
        sb.AppendLine($"Proveedor: {r.NombreProveedor} (NIT {r.NitProveedor})");
        sb.AppendLine($"Factura: {r.NumFacturaProveedor}");
        sb.AppendLine($"Fecha de emision: {Fecha(r.FechaEmision)}");
        sb.AppendLine($"Total: {Moneda(r.TotalFactura)}");
        sb.AppendLine($"CUFE: {r.Cufe}");
        if (concepto is not null || centro is not null || orden is not null)
        {
            sb.AppendLine("---");
            if (concepto is not null) { sb.AppendLine($"Concepto de compra: {concepto}"); }
            if (centro is not null) { sb.AppendLine($"Centro de costos: {centro}"); }
            if (orden is not null) { sb.AppendLine($"Orden de compra: {orden}"); }
        }
        if (userLabel is not null) { sb.AppendLine("---"); sb.AppendLine($"Asignado a: {userLabel}"); }
        sb.AppendLine($"Referencia conciliacion (REG): {r.Id}");
        return sb.ToString().TrimEnd();
    }

    private async Task<Guid> ActorAsync()
    {
        var st = await AuthState.GetAuthenticationStateAsync();
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }
    private async Task<string> ActorNameAsync()
    {
        var st = await AuthState.GetAuthenticationStateAsync();
        return st.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
    }

    protected override async Task OnInitializedAsync()
    {
        _cfg = await Cfg.GetAsync();
        if (_cfg.FormDefinitionId is Guid fid) { _hiddenSecs = await Cfg.GetHiddenContainerIdsForFormAsync(fid); }
        _usuarios = (await Users.ListAsync()).ToList();
        // Resolver el TenantUser del usuario actual (por PlatformUserId) para el filtro "solo mis documentos".
        var actor = await ActorAsync();
        _miTenantUserId = _usuarios.FirstOrDefault(u => u.PlatformUserId == actor)?.Id;
        _soloMios = _miTenantUserId is not null;   // por defecto filtra a mis documentos si se pudo resolver
        await CargarAsync();
    }

    private ConciliacionDianFiltro Filtro()
    {
        DateTimeOffset? desde = DateTimeOffset.TryParse(_desde, out var d) ? d : null;
        DateTimeOffset? hasta = DateTimeOffset.TryParse(_hasta, out var h) ? h.AddDays(1).AddTicks(-1) : null; // incluye todo el dia
        return new ConciliacionDianFiltro(string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim(), desde, hasta);
    }

    private async Task CargarAsync()
    {
        _busy = true;
        try
        {
            _items = (await Svc.ListPorAutorizarAsync(Filtro())).ToList();
            // Si la seleccion ya no esta en la lista MOSTRADA (respeta "solo mios"), se limpia; si no hay, se abre la primera.
            var vis = ItemsMostrados;
            if (_sel is not null && vis.All(x => x.Id != _sel.Id)) { _sel = null; _viewUrl = null; _viewFiles = new(); _viewFile = null; }
            if (_sel is null && vis.Count > 0) { await SelectAsync(vis[0]); }
        }
        finally { _busy = false; }
    }

    private async Task AplicarAsync() { _sel = null; await CargarAsync(); }

    private async Task OnSoloMiosChanged(ChangeEventArgs e)
    {
        _soloMios = e.Value is bool b && b;
        // Al cambiar el filtro, si la seleccion ya no esta en la lista mostrada se abre la primera de la nueva lista.
        var vis = ItemsMostrados;
        if (_sel is not null && vis.All(x => x.Id != _sel.Id)) { _sel = null; _viewUrl = null; _viewFiles = new(); _viewFile = null; }
        if (_sel is null && vis.Count > 0) { await SelectAsync(vis[0]); }
    }
    private async Task LimpiarAsync() { _texto = _desde = _hasta = string.Empty; _sel = null; await CargarAsync(); }
    private async Task OnFilterKey(KeyboardEventArgs e) { if (e.Key == "Enter") { await AplicarAsync(); } }

    private async Task SelectAsync(ConciliacionDianRenglonDto r)
    {
        // IMPORTANTE (concurrencia del DbContext): hacer TODAS las lecturas de este panel (config +
        // archivos) ANTES de exponer la factura. El DbContext es scoped al circuito y lo comparten estos
        // servicios (Cfg, Files via EcorexDbContext) Y el DynamicFormRenderer. Si asignamos _sel primero,
        // el primer await provoca un render que monta el form (nuevo @key) y este consulta FormDefinitions
        // en el MISMO contexto mientras estas lecturas siguen en vuelo -> "A second operation was started
        // on this context instance" y el circuito muere (la UI, y el responsable, se quedan pegados).
        // Serializando (leer primero, publicar _sel + render al final) no hay dos operaciones a la vez.
        var asignado = await Cfg.GetAsignadoAsync(r.Id);
        var solicitada = await Cfg.GetSolicitadaAsync(r.Id);
        List<StoredFileDto> viewFiles = new();
        try
        {
            var files = string.IsNullOrWhiteSpace(r.Cufe)
                ? new List<StoredFileDto>()
                : (await Files.ListAsync("ConciliacionDian", r.Cufe)).ToList();
            // Solo PDFs; preferir la representacion grafica de NEWTON, caer al PDF de la DIAN.
            viewFiles = files.Where(f => EsPdf(f)).OrderByDescending(EsNewton).ToList();
        }
        catch { viewFiles = new(); }

        _sel = r;
        _okMsg = null; _errMsg = null;
        _asignadoSel = asignado;
        _solicitada = solicitada;
        _viewFiles = viewFiles;
        _viewFile = viewFiles.FirstOrDefault();
        _viewUrl = _viewFile?.Url;
        _viewLoading = false;
        StateHasChanged();
    }

    private void SelectFile(StoredFileDto f) { _viewFile = f; _viewUrl = f.Url; }

    // Abre el modal de detalle+formulario para una factura (selecciona primero -> carga visor + datos).
    private async Task AbrirPanelAsync(ConciliacionDianRenglonDto r)
    {
        await SelectAsync(r);
        _panelOpen = true;
    }
    // Al cerrar el modal se PERSISTE el borrador: con la barra Enviar/Imprimir oculta (HonorHideSubmitBar)
    // el autosave periodico esta apagado, asi que sin este flush lo escrito se perdia si el usuario cerraba
    // (x / fondo) sin pulsar "Guardar cambios". FlushDraftAsync es no-op si no hay borrador o no hubo cambios.
    private async Task CerrarPanel()
    {
        if (_formRenderer is not null)
        {
            try { await _formRenderer.FlushDraftAsync(); } catch { /* cerrar nunca debe fallar por el guardado */ }
        }
        _panelOpen = false;
    }

    // ---- Visor PDF (zoom + arrastre) via interop ----
    private string? _loadedUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_viewUrl is { } u && u != _loadedUrl)
        {
            _loadedUrl = u;
            try { await JS.InvokeVoidAsync("ecorexAutVisor.cargar", u); } catch { /* el visor muestra su propio error */ }
        }
        else if (_viewUrl is null) { _loadedUrl = null; }
    }

    private async Task ZoomMas() { try { await JS.InvokeVoidAsync("ecorexAutVisor.zoomMas"); } catch { } }
    private async Task ZoomMenos() { try { await JS.InvokeVoidAsync("ecorexAutVisor.zoomMenos"); } catch { } }
    private async Task ZoomAncho() { try { await JS.InvokeVoidAsync("ecorexAutVisor.zoomAncho"); } catch { } }

    private static bool EsPdf(StoredFileDto f)
        => (f.ContentType ?? "").Contains("pdf", StringComparison.OrdinalIgnoreCase)
        || (f.FileName ?? "").EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    private static bool EsNewton(StoredFileDto f)
        => ((f.Ref2 ?? "") + (f.FileName ?? "")).Contains("newton", StringComparison.OrdinalIgnoreCase);
    private static string Tag(StoredFileDto f) => EsNewton(f) ? "NEWTON" : "DIAN";

    private static string Txt(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    private static string Fecha(DateTimeOffset v) => v.ToString("dd/MM/yyyy");
    private static string Moneda(decimal v) => "$" + v.ToString("N2", Co);
}
