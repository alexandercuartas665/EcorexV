@page "/bitacora-agente"
@attribute [Authorize(Policy = "TenantMember")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Tenancy
@using Ecorex.Domain.Enums
@inject IAiAgentLineService AgentLinesSvc
@inject IJSRuntime JS

<PageTitle>Bitacora del agente - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
            </div>
            <span>Comunicacion e IA</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Bitacora del <span>agente</span></h1>
        <p class="page-sub" style="margin-bottom:0;">Revisa como atendio el agente cada conversacion: mensaje recibido, prompts enviados a la IA, herramientas usadas y respuesta.</p>
    </div>
    <div style="display:flex;gap:8px;align-self:flex-start;flex-wrap:wrap;">
        <button class="btn btn-outline-secondary" @onclick="ReloadAsync" disabled="@(_loading || _busy)">Actualizar</button>
        @if (_tab == "atencion")
        {
            <button class="btn btn-outline-danger" @onclick="ClearAllAsync" disabled="@(_loading || _busy || _convs.Count == 0)"
                    title="Borra los LOGS de la bitacora y el CACHE de datos capturados de toda la empresa. NO borra los mensajes del chat (la memoria conversacional del agente) ni los leads. Para que un agente olvide a un contacto, usa 'Reiniciar memoria' en la fila del contacto.">
                @(_busy ? "Borrando..." : "Limpiar bitacora y cache")
            </button>
        }
    </div>
</div>

@* Pestanas: atencion del agente (SARA) vs fallos de ENTREGA de WhatsApp (el "no llego" con el motivo de Meta). *@
<div style="display:flex;gap:6px;margin-bottom:16px;border-bottom:1px solid var(--border);">
    <button type="button" @onclick="@(() => _tab = "atencion")"
            style="background:none;border:none;cursor:pointer;padding:8px 14px;font-size:13px;font-weight:700;color:@(_tab == "atencion" ? "var(--primary)" : "var(--muted-foreground)");border-bottom:2px solid @(_tab == "atencion" ? "var(--primary)" : "transparent");margin-bottom:-1px;">
        Atencion del agente
    </button>
    <button type="button" @onclick="SwitchToFallosAsync"
            style="background:none;border:none;cursor:pointer;padding:8px 14px;font-size:13px;font-weight:700;color:@(_tab == "fallos" ? "var(--primary)" : "var(--muted-foreground)");border-bottom:2px solid @(_tab == "fallos" ? "var(--primary)" : "transparent");margin-bottom:-1px;">
        Fallos de envio@(_failures.Count > 0 ? $" ({_failures.Count})" : "")
    </button>
</div>

@if (_flash is not null)
{
    <div class="cv-warn" style="background:#ecfdf5;border-color:#a7f3d0;color:#065f46;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <span>@_flash</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _flash = null">Cerrar</button>
    </div>
}

@if (_tab == "atencion" && _held.Count > 0)
{
    <div class="card" style="padding:14px;margin-bottom:14px;border-left:3px solid var(--primary);">
        <div style="font-weight:800;font-size:13px;margin-bottom:8px;display:flex;align-items:center;gap:8px;">
            <span class="badge bg-primary">@_held.Count</span>
            Lineas atendidas por el flujo <span class="text-muted" style="font-weight:600;">(el agente del paso tomo la linea; SARA en silencio hasta que libere la salida)</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;">
            @foreach (var h in _held)
            {
                <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center;font-size:12px;border-bottom:1px solid var(--border);padding-bottom:6px;">
                    <div>
                        <strong>@(string.IsNullOrWhiteSpace(h.ContactName) ? h.ContactPhone : h.ContactName)</strong>
                        <span class="text-muted">@h.ContactPhone @(h.LineLabel is null ? "" : $"- linea {h.LineLabel}")</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                        <span class="text-muted">
                            Tarea <strong>@h.TaskNumber</strong> @h.TaskTitle - paso "@h.NodeName"@(h.HeldUntil is null ? "" : $" - en espera hasta {h.HeldUntil.Value.ToLocalTime():dd MMM HH:mm}")
                        </span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ReleaseHoldAsync(h.ConversationId)" disabled="@_busy"
                                title="Libera esta linea del flujo: el paso vuelve a atencion humana y el agente de la linea (SARA) retoma la conversacion.">
                            @(_busy ? "..." : "Liberar linea")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_loading)
{
    <p><em>Cargando...</em></p>
}
else if (_tab == "atencion")
{
    <div style="display:grid;grid-template-columns:minmax(300px,400px) 1fr;gap:22px;align-items:start;">
        <div class="card" style="padding:14px;">
            @if (_convs.Count == 0)
            {
                <p class="text-muted" style="padding:8px 2px;">Aun no hay atenciones registradas. Cuando un agente atienda una linea, apareceran aqui.</p>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:4px;max-height:68vh;overflow-y:auto;">
                    @foreach (var c in _convs)
                    {
                        <div style="display:flex;align-items:center;gap:10px;padding:9px;border-radius:10px;cursor:pointer;@(_selectedId == c.ConversationId ? "background:var(--primary-soft);" : "")" @onclick="() => SelectAsync(c.ConversationId)">
                            <span style="width:38px;height:38px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;color:#fff;font-weight:800;font-size:12px;background:var(--gradient-violet);">@Initials(c.ContactName ?? c.ContactPhone)</span>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:700;font-size:13px;">@(string.IsNullOrWhiteSpace(c.ContactName) ? c.ContactPhone : c.ContactName)</div>
                                <div class="text-muted" style="font-size:11px;">@c.ContactPhone @(c.LineLabel is null ? "" : $"- linea {c.LineLabel}")</div>
                            </div>
                            <div style="text-align:right;">
                                <span class="badge bg-secondary">@c.Events</span>
                                <div class="text-muted" style="font-size:10.5px;">@(c.LastActivityAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "")</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card" style="padding:22px;">
            @if (_selectedId is not null)
            {
                <div style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px;">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetContextAsync" disabled="@_busy"
                            title="Reinicia la memoria del agente para este contacto SIN borrar los mensajes: arranca de cero en el siguiente mensaje, pero el historial del chat se conserva para leerlo. No toca el lead.">
                        @(_busy ? "Reiniciando..." : "Reiniciar memoria (conservar mensajes)")
                    </button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="ResetConversationAsync" disabled="@_busy"
                            title="Borra logs + cache + mensajes del chat de esta conversacion. El agente arranca de cero en el siguiente mensaje. No toca el lead.">
                        @(_busy ? "Reiniciando..." : "Reiniciar conversacion")
                    </button>
                </div>
            }
            @if (_selectedId is null)
            {
                <p class="text-muted" style="padding:24px 0;text-align:center;">Selecciona una conversacion para ver su bitacora de atencion.</p>
            }
            else if (_log.Count == 0)
            {
                <p class="text-muted">Sin eventos en esta conversacion.</p>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:12px;">
                    @foreach (var e in _log)
                    {
                        <div style="border-left:3px solid @KindColor(e.Kind);padding:6px 0 6px 14px;">
                            <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:center;">
                                <strong style="font-size:13.5px;"><span class="badge @KindBadge(e.Kind)" style="margin-right:6px;">@KindLabel(e.Kind)</span>@e.Title</strong>
                                <span class="text-muted" style="font-size:11.5px;">@e.OccurredAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(e.Content))
                            {
                                <textarea class="form-control" rows="@Rows(e.Content!)" readonly style="margin-top:6px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;line-height:1.45;white-space:pre;">@e.Content</textarea>
                            }
                            @if (!string.IsNullOrWhiteSpace(e.Response))
                            {
                                <div class="text-muted" style="font-size:11px;margin-top:4px;">Resultado / respuesta:</div>
                                <textarea class="form-control" rows="@Rows(e.Response!)" readonly style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;line-height:1.45;white-space:pre;">@e.Response</textarea>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    @* Pestana "Fallos de envio": salientes de WhatsApp que NO llegaron, con el motivo real de Meta (ADR-0135). *@
    <div class="card" style="padding:18px;">
        <div style="font-size:12.5px;color:var(--muted-foreground);margin-bottom:14px;">
            Mensajes SALIENTES de WhatsApp que el proveedor marco como <strong>no entregados</strong>, con el motivo real
            de Meta (codigo + texto). Mas recientes primero. Si el motivo dice "sin detalle", Meta no devolvio texto.
        </div>
        @if (_failures.Count == 0)
        {
            <p class="text-muted" style="padding:8px 2px;">No hay fallos de envio registrados. Cuando un mensaje no llegue, aparecera aqui con el motivo.</p>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;max-height:70vh;overflow-y:auto;">
                @foreach (var f in _failures)
                {
                    <div style="border-left:3px solid var(--destructive);padding:8px 0 8px 14px;">
                        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:center;">
                            <strong style="font-size:13.5px;">
                                @(string.IsNullOrWhiteSpace(f.ContactName) ? f.ContactPhone : f.ContactName)
                                <span class="text-muted" style="font-weight:600;font-size:11.5px;">@f.ContactPhone @(f.LineLabel is null ? "" : $"- linea {f.LineLabel}")</span>
                            </strong>
                            <span class="text-muted" style="font-size:11.5px;">@f.SentAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</span>
                        </div>
                        <div style="margin-top:4px;font-size:12.5px;color:var(--destructive);font-weight:700;">
                            Motivo: @(string.IsNullOrWhiteSpace(f.DeliveryError) ? "sin detalle de Meta" : f.DeliveryError)
                        </div>
                        @if (!string.IsNullOrWhiteSpace(f.Body))
                        {
                            <div class="text-muted" style="font-size:11.5px;margin-top:4px;white-space:pre-wrap;">
                                Mensaje: @Trunc(f.Body!, 220)@(string.IsNullOrWhiteSpace(f.SentByName) ? "" : $"  -  envio: {f.SentByName}")
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _flash;
    private List<AgentConversationDto> _convs = new();
    private List<FlowHeldConversationDto> _held = new();
    private Guid? _selectedId;
    private List<AgentRunLogEntryDto> _log = new();
    // Pestana activa: "atencion" (bitacora de SARA) o "fallos" (entregas de WhatsApp que no llegaron).
    private string _tab = "atencion";
    private List<AgentDeliveryFailureDto> _failures = new();

    private async Task ClearAllAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Limpiar la bitacora y el cache de datos capturados de TODA la empresa? Es irreversible. NO borra los mensajes del chat (la memoria conversacional) ni los leads; para que un agente olvide a un contacto usa 'Reiniciar memoria' en su fila.")) { return; }
        _busy = true; _flash = null;
        try
        {
            var (logs, cache) = await AgentLinesSvc.ClearAllLogsAsync();
            _selectedId = null; _log = new();
            await ReloadAsync();
            _flash = $"Bitacora y cache limpiados: {logs} evento(s) y {cache} dato(s) de cache eliminados. No se tocaron los mensajes del chat.";
        }
        finally { _busy = false; }
    }

    private async Task ResetContextAsync()
    {
        if (_selectedId is not Guid id) { return; }
        if (!await JS.InvokeAsync<bool>("confirm", "Reiniciar la memoria del agente para este contacto? El agente arrancara de cero en el siguiente mensaje, PERO se conservan los mensajes del chat para que puedas leerlos. No toca el lead.")) { return; }
        _busy = true; _flash = null;
        try
        {
            var ok = await AgentLinesSvc.ResetConversationAgentContextAsync(id);
            _flash = ok
                ? "Memoria del agente reiniciada. El historial del chat se conserva."
                : "No se pudo reiniciar (la conversacion no existe).";
        }
        finally { _busy = false; }
    }

    private async Task ResetConversationAsync()
    {
        if (_selectedId is not Guid id) { return; }
        if (!await JS.InvokeAsync<bool>("confirm", "Reiniciar esta conversacion? Borra sus logs, su cache y los mensajes del chat. El agente arranca de cero en el siguiente mensaje. No toca el lead.")) { return; }
        _busy = true; _flash = null;
        try
        {
            var (logs, cache, messages) = await AgentLinesSvc.ResetConversationMemoryAsync(id);
            _selectedId = null; _log = new();
            await ReloadAsync();
            _flash = $"Conversacion reiniciada: {logs} log(s), {cache} dato(s) de cache y {messages} mensaje(s) eliminados.";
        }
        finally { _busy = false; }
    }

    private async Task ReleaseHoldAsync(Guid conversationId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Liberar esta linea del flujo? El paso del agente vuelve a atencion humana y el agente de la linea (SARA) retoma la conversacion.")) { return; }
        _busy = true; _flash = null;
        try
        {
            var n = await AgentLinesSvc.ReleaseFlowHoldAsync(conversationId);
            await ReloadAsync();
            _flash = n > 0
                ? $"Linea liberada: {n} paso(s) devuelto(s) a atencion humana. SARA retoma la conversacion."
                : "No se libero ningun paso (puede que el flujo ya la haya soltado).";
        }
        finally { _busy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _convs = (await AgentLinesSvc.ListAttendedConversationsAsync()).ToList();
        _held = (await AgentLinesSvc.ListFlowHeldConversationsAsync()).ToList();
        _failures = (await AgentLinesSvc.ListDeliveryFailuresAsync()).ToList();
        if (_selectedId is Guid id && _convs.All(c => c.ConversationId != id)) { _selectedId = null; _log = new(); }
    }

    /// <summary>Cambia a la pestana "Fallos de envio" y refresca (para ver el estado mas reciente).</summary>
    private async Task SwitchToFallosAsync()
    {
        _tab = "fallos";
        await ReloadAsync();
    }

    private static string Trunc(string s, int n) => s.Length <= n ? s : s[..n] + "...";

    private async Task SelectAsync(Guid id)
    {
        _selectedId = id;
        _log = (await AgentLinesSvc.GetConversationLogAsync(id)).ToList();
    }

    private static int Rows(string s)
    {
        var lines = s.Count(c => c == '\n') + 1;
        return Math.Clamp(lines, 2, 16);
    }

    private static string KindLabel(AiAgentRunLogKind k) => k switch
    {
        AiAgentRunLogKind.Inbound => "Recibido",
        AiAgentRunLogKind.Prompt => "Prompt IA",
        AiAgentRunLogKind.Tool => "Herramienta",
        AiAgentRunLogKind.Reply => "Respuesta",
        AiAgentRunLogKind.Error => "Error",
        _ => "Info"
    };

    private static string KindBadge(AiAgentRunLogKind k) => k switch
    {
        AiAgentRunLogKind.Inbound => "bg-secondary",
        AiAgentRunLogKind.Prompt => "bg-info",
        AiAgentRunLogKind.Tool => "bg-primary",
        AiAgentRunLogKind.Reply => "bg-success",
        AiAgentRunLogKind.Error => "bg-danger",
        _ => "bg-secondary"
    };

    private static string KindColor(AiAgentRunLogKind k) => k switch
    {
        AiAgentRunLogKind.Reply => "var(--success)",
        AiAgentRunLogKind.Tool => "var(--primary)",
        AiAgentRunLogKind.Error => "var(--destructive)",
        _ => "var(--border)"
    };

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) { return "?"; }
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant() : $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }
}
