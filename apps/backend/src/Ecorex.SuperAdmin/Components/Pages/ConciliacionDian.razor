    // ---- Fuente de datos (Lookup a un contenedor) en COLUMNAS FIJAS (oc / numsol) ----
    private Dictionary<string, DataLookupConfig> _sysSource = new();   // columnKey -> config de lookup
    private HashSet<string> _sysUnique = new();                        // columnKey con "no reusar"
    private static readonly (string Key, string Label)[] _sysConfigurables =
        { ("oc", "Orden de compra"), ("numsol", "N° factura SISTEMA") };
    private string SysLabel(string col) => _sysConfigurables.FirstOrDefault(c => c.Key == col).Label ?? col;

    /// <summary>true (y setea _msg) si "no reusar" esta activo para la columna y el valor ya existe en otro renglon.</summary>
    private async Task<bool> IsDupBlockedAsync(ConciliacionDianRenglonDto r, string col, string? value)
    {
        value = (value ?? "").Trim();
        if (value.Length == 0 || !_sysUnique.Contains(col)) { return false; }
        var used = await Svc.IsColumnValueUsedAsync(_selectedDocId, col, r.Id, value);
        if (used) { _msg = $"«{SysLabel(col)}» {value} ya está usada en otra factura de este documento; no se puede reusar."; }
        return used;
    }
    private (Guid Renglon, string Col)? _editSysCell;
    private bool IsEditingSys(Guid renglonId, string col) => _editSysCell is { } e && e.Renglon == renglonId && e.Col == col;
    private void OpenSysEdit(ConciliacionDianRenglonDto r, string col) { if (_sysSource.ContainsKey(col)) { _editSysCell = (r.Id, col); } }

    /// <summary>Al elegir en el typeahead de una columna fija, guarda el TEXTO elegido en la columna nativa.</summary>
    private async Task SetSysLookup(ConciliacionDianRenglonDto r, string col, string? rowId)
    {
        var text = "";
        if (!string.IsNullOrWhiteSpace(rowId) && _sysSource.TryGetValue(col, out var cfg) && Guid.TryParse(rowId, out var g))
        {
            try { var rows = await Lookups.ResolveAsync(cfg.TableId, new[] { g }, cfg.DisplayColumnId); text = rows.FirstOrDefault()?.Label ?? ""; }
            catch { }
        }
        _msg = null;
        if (await IsDupBlockedAsync(r, col, text)) { _editSysCell = null; return; } // no guarda: valor repetido
        if (col == "oc") { await Svc.UpdateOrdenCompraAsync(r.Id, text); }
        else if (col == "numsol") { await Svc.UpdateNumFacturaSoldarcoAsync(r.Id, text); }
        _editSysCell = null;
        await ReloadAsync();
    }

    private DataLookupConfig? LookupCfgFor(ConciliacionFieldDefDto d)
        => _lookupCfg.TryGetValue(d.Id, out var c) ? c : null;

    /// <summary>Valor a MOSTRAR de un campo dinamico: Lookup -> etiqueta; Calculated -> formula; resto -> crudo.</summary>
    private string DynDisplay(ConciliacionDianRenglonDto r, ConciliacionFieldDefDto d)
    {
        if (d.Type == "Calculated") { return CalcValue(r, d); }
        var raw = DynVal(r.Id, d.Id);
        if (d.Type == "Lookup")
        {
            if (string.IsNullOrEmpty(raw)) { return ""; }
            return _lookupLabels.TryGetValue(d.Id, out var m) && m.TryGetValue(raw, out var lbl) ? lbl : raw;
        }
        return raw;
    }

    // ---- MultiSelect: valores separados por coma ----
    private static HashSet<string> SplitMulti(string? v) =>
        (v ?? "").Split(',').Select(x => x.Trim()).Where(x => x.Length > 0).ToHashSet();

    private async Task ToggleMulti(ConciliacionDianRenglonDto r, ConciliacionFieldDefDto d, string option, ChangeEventArgs e)
    {
        var set = SplitMulti(DynVal(r.Id, d.Id));
        if (e.Value is bool b && b) { set.Add(option); } else { set.Remove(option); }
        // Mantener el orden de las opciones definidas.
        var ordered = d.Options.Where(o => set.Contains(o)).ToList();
        var val = string.Join(", ", ordered);
        await Fields.SetValueAsync(r.Id, d.Id, val);
        if (!_dynValues.TryGetValue(r.Id, out var dict)) { dict = new(); _dynValues[r.Id] = dict; }
        dict[d.Id] = val;
    }

    // ---- Calculated: formula (en OptionsJson) evaluada por renglon ----
    private Dictionary<Guid, FormulaNode?> _calcNodes = new();

    private string CalcValue(ConciliacionDianRenglonDto r, ConciliacionFieldDefDto d)
    {
        if (!_calcNodes.TryGetValue(d.Id, out var node) || node is null) { return ""; }
        try
        {
            var v = FormulaEngine.Evaluate(node, k => ResolveCalcRef(r, k));
            return v is decimal dec ? FormulaEngine.Format(dec) : "";
        }
        catch { return ""; }
    }

    /// <summary>Resuelve una referencia de la formula: campo estatico numerico, campo dinamico (slug) o 0.</summary>
    private decimal ResolveCalcRef(ConciliacionDianRenglonDto r, string key)
    {
        switch (key)
        {
            case "sub_bruto": return r.SubtotalBruto;
            case "descuento": return r.DescuentoComercial;
            case "sub_neto": return r.SubtotalNeto;
            case "iva": return r.IvaDescontable;
            case "total_antes_ret": return r.TotalAntesRetenciones;
            case "retefuente": return r.RetRetefuente;
            case "ica": return r.RetIca;
            case "total": return r.TotalFactura;
        }
        // Campo dinamico por su slug (no por "dyn:"): usa el valor mostrado (num) del campo.
        var def = _dynDefs.FirstOrDefault(x => x.FieldKey == key);
        if (def is not null && def.Type != "Calculated") { return FormulaEngine.ToNumber(DynVal(r.Id, def.Id)); }
        return 0m;
    }

    // ---- Fase 3.1: exponer los campos dinamicos al MOTOR DE REGLAS y al CONSTRUCTOR DE FILTROS ----

    private static RuleFieldType MapDynRuleType(string? t) => t switch
    {
        "Number" => RuleFieldType.Number,
        "Date" => RuleFieldType.Date,
        "Bool" => RuleFieldType.Bool,
        _ => RuleFieldType.Text, // Text | Select
    };

    /// <summary>Catalogo del editor de reglas = campos estaticos + campos a medida (todos escribibles).</summary>
    private IReadOnlyList<RuleField> RuleFieldsForEditor()
    {
        if (_dynDefs.Count == 0) { return ConciliacionRuleFields.All; }
        var list = new List<RuleField>(ConciliacionRuleFields.All);
        foreach (var d in _dynDefs) { list.Add(new RuleField(DynKey(d.FieldKey), d.Label, MapDynRuleType(d.Type), true)); }
        return list;
    }

    private RuleField? RuleFieldByKey(string? key) => RuleFieldsForEditor().FirstOrDefault(f => f.Key == key);

    private static FilterFieldType MapDynFilterType(string? t) => t switch
    {
        "Number" => FilterFieldType.Number,
        "Date" => FilterFieldType.Date,
        "Bool" => FilterFieldType.Bool,
        _ => FilterFieldType.Text, // Text | Select
    };

    /// <summary>Campos a medida como campos filtrables (clave "dyn:{key}", igual que grilla y reglas).</summary>
    private IReadOnlyList<FilterField> FilterExtraFields()
        => _dynDefs.Where(d => d.ShowInFilter).Select(d => new FilterField(DynKey(d.FieldKey), d.Label, MapDynFilterType(d.Type))).ToList();

    /// <summary>Resolver de valores dinamicos para el evaluador del filtro: (renglon, "dyn:key") -> valor.</summary>
    private string? DynFilterValue(ConciliacionDianRenglonDto r, string key)
        => _dynByKey.TryGetValue(key, out var d) ? DynDisplay(r, d) : "";

    private async Task LoadDynDefsAsync()
    {
        var allDefs = (await Fields.ListDefsAsync()).ToList();
        // Las defs "sys:{col}" NO son columnas nuevas: son config (fuente de datos + reglas) de una columna FIJA.
        _sysSource = new();
        _sysUnique = new();
        foreach (var d in allDefs.Where(x => x.FieldKey.StartsWith("sys:", StringComparison.Ordinal)))
        {
            var col = d.FieldKey["sys:".Length..];
            var cfg = DataLookupConfig.TryParse(d.OptionsJson);
            if (cfg is not null) { _sysSource[col] = cfg; }
            if (d.UniqueValue) { _sysUnique.Add(col); }
        }
        _dynDefs = allDefs.Where(d => !d.FieldKey.StartsWith("sys:", StringComparison.Ordinal)).ToList();
        _dynCols = _dynDefs.Select(d => new GridCol(DynKey(d.FieldKey), d.Label, d.Type == "Number", true)).ToList();
        _dynByKey = _dynDefs.ToDictionary(d => DynKey(d.FieldKey), d => d);
        // Config de los campos tipo Lookup (parsea el DataLookupConfig guardado en OptionsJson).
        _lookupCfg = new();
        foreach (var d in _dynDefs.Where(x => x.Type == "Lookup"))
        {
            var cfg = DataLookupConfig.TryParse(d.OptionsJson);
            if (cfg is not null) { _lookupCfg[d.Id] = cfg; }
        }
        // Formulas de los campos Calculated (se parsean una vez; se evaluan por renglon al mostrar).
        _calcNodes = new();
        foreach (var d in _dynDefs.Where(x => x.Type == "Calculated"))
        {
            var formula = FormulaFromJson(d.OptionsJson);
            _calcNodes[d.Id] = string.IsNullOrWhiteSpace(formula) ? null : FormulaEngine.Parse(formula).Node;
        }
        // Asegura que las columnas dinamicas esten en el orden (al final) y limpia claves dyn obsoletas.
        var dynKeys = _dynCols.Select(c => c.Key).ToHashSet();
        _order.RemoveAll(k => k.StartsWith("dyn:") && !dynKeys.Contains(k));
        foreach (var k in dynKeys) { if (!_order.Contains(k)) { _order.Add(k); } }
    }

    private async Task LoadDynValuesAsync()
    {
        try { _dynValues = (await Fields.GetValuesAsync(_renglones.Select(r => r.Id).ToList())).ToDictionary(kv => kv.Key, kv => kv.Value); }
        catch { _dynValues = new(); }
        await ResolveLookupLabelsAsync();
    }

    /// <summary>Resuelve en bloque las etiquetas de los campos Lookup (Id de fila -> texto a mostrar).</summary>
    private async Task ResolveLookupLabelsAsync()
    {
        _lookupLabels = new();
        foreach (var d in _dynDefs.Where(x => x.Type == "Lookup"))
        {
            if (!_lookupCfg.TryGetValue(d.Id, out var cfg)) { continue; }
            // Ids de fila guardados para este campo en todos los renglones cargados.
            var rowIds = _dynValues.Values
                .Select(m => m.TryGetValue(d.Id, out var v) ? v : null)
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Select(v => Guid.TryParse(v, out var g) ? g : Guid.Empty)
                .Where(g => g != Guid.Empty).Distinct().ToList();
            if (rowIds.Count == 0) { continue; }
            try
            {
                var rows = await Lookups.ResolveAsync(cfg.TableId, rowIds, cfg.DisplayColumnId);
                _lookupLabels[d.Id] = rows.ToDictionary(x => x.RowId.ToString(), x => x.Label);
            }
            catch { /* tabla/columna inexistente: se muestra el Id crudo */ }
        }
    }

    private void OpenLookupEdit(ConciliacionDianRenglonDto r, ConciliacionFieldDefDto d)
    {
