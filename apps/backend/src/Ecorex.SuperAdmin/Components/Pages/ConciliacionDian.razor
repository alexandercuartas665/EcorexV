    private void AddSalida() => _salidas.Add(new SalidaEdit { Id = Guid.CreateVersion7(), Nombre = $"Salida {_salidas.Count + 1}" });
    private void OnSalidaSubChange(SalidaEdit s, ChangeEventArgs e)
        => s.Sub = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
    private async Task OnSalidaFormChange(SalidaEdit s, ChangeEventArgs e)
    {
        s.Form = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        s.FormFields = s.Form is Guid ff ? (await TaskCfg.ListFormFieldsAsync(ff)).ToList() : new();
    }

    private async Task GuardarSalidasAsync()
    {
        _busy = true; _cfgMsg = null;
        try
        {
            var dto = _salidas.Select(s => new SalidaFlujoDto(
                s.Id == Guid.Empty ? Guid.CreateVersion7() : s.Id,
                string.IsNullOrWhiteSpace(s.Nombre) ? "Salida" : s.Nombre.Trim(),
                s.Sub, null, null, s.Form, null,
                s.DireEnabled,
                s.DireMaps.Select(m => new DireccionarMapDto(m.FormField, m.Target)).ToList()))
                .ToList();
            await TaskCfg.SaveSalidasAsync(dto);
            await LoadSalidasRunAsync();   // refresca lo que habilita "+ Tarea"
            var conDire = _salidas.Count(s => s.DireEnabled && s.DireMaps.Any(m => !string.IsNullOrWhiteSpace(m.FormField) && !string.IsNullOrWhiteSpace(m.Target)));
            _cfgMsg = conDire > 0
                ? $"Guardado. {_salidasRun.Count} salida(s) con concepto; boton «Direccionar compra» listo en {conDire} formulario(s)."
                : $"Guardado. {_salidasRun.Count} salida(s) con concepto.";
        }
        catch (Exception ex) { _cfgMsg = "Error al guardar: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadSalidasRunAsync()
    {
        // Solo las salidas con concepto pueden crear tarea (el concepto trae el flujo).
        try { _salidasRun = (await TaskCfg.ListSalidasAsync()).Where(s => s.SubcategoriaId is not null).ToList(); }
        catch { _salidasRun = new(); }
    }

    // "+ Tarea" en la grilla: con una sola salida la dispara directo; con varias, abre el selector.
    private async Task OnCrearTareaClick(ConciliacionDianRenglonDto rowArg)
    {
        if (_creandoTarea) { return; }
        var r = _renglones.FirstOrDefault(x => x.Id == rowArg.Id) ?? rowArg;
        if (_salidasRun.Count == 0) { _msg = "Configura primero una salida (concepto) en «Configuracion»."; return; }
        if (r.AssignedTenantUserId is null) { _msg = "Asigna primero un usuario a la factura antes de crear la tarea."; return; }
        if (_tareaDeRenglon.ContainsKey(r.Id)) { return; }   // ya tiene tarea
        if (_salidasRun.Count == 1) { await CrearTareaDesdeRenglonAsync(r, _salidasRun[0]); return; }
        _pickRow = r; _pickSalidaOpen = true;
    }
    private void CerrarPickSalida() { _pickSalidaOpen = false; _pickRow = null; }
    private async Task ElegirSalidaAsync(SalidaFlujoDto salida)
    {
        var r = _pickRow;
        _pickSalidaOpen = false; _pickRow = null;
        if (r is not null) { await CrearTareaDesdeRenglonAsync(r, salida); }
    }

    // Crea la actividad desde la fila con la SALIDA elegida: si el concepto tiene un flujo asociado,
    // CreateAsync lo lanza (la tarea "cae" en ese flujo). Queda asignada al usuario elegido en la fila.
    private async Task CrearTareaDesdeRenglonAsync(ConciliacionDianRenglonDto rowArg, SalidaFlujoDto salida, Guid? assigneeOverride = null)
    {
        if (_creandoTarea) { return; }
        if (salida.SubcategoriaId is null)
        {
            _msg = "La salida elegida no tiene concepto configurado.";
            return;
        }
        // El lambda del boton captura el DTO del render de la grilla, que puede quedar OBSOLETO (OnAssigneeChanged
        // actualiza _renglones pero no reconstruye la grilla). Resolvemos el renglon ACTUAL por Id para tomar el
        // usuario asignado vigente (y el resto de datos frescos).
        var r = _renglones.FirstOrDefault(x => x.Id == rowArg.Id) ?? rowArg;
        if (_tareaDeRenglon.ContainsKey(r.Id)) { return; }   // ya tiene tarea
        var assignee = assigneeOverride ?? r.AssignedTenantUserId;
        if (assignee is null)
        {
            _msg = "Asigna primero un usuario a la factura antes de crear la tarea.";
            return;
        }
        _creandoTarea = true; _msg = null;
        try
        {
            var (ok, res) = await CrearTareaCoreAsync(r, salida, assignee.Value);
            _msg = ok ? $"Tarea {res} creada y asignada a {UserNameById(assignee)}." : res;
        }
        finally { _creandoTarea = false; }
    }

    // Crea la tarea (sin los guards de UI): la usan el boton por fila y el analisis masivo con IA. Devuelve
    // (true, numero) o (false, mensaje de error). NO toca _creandoTarea ni _msg (los maneja quien la llama).
    private async Task<(bool Ok, string Result)> CrearTareaCoreAsync(ConciliacionDianRenglonDto r, SalidaFlujoDto salida, Guid assignee)
    {
        if (salida.SubcategoriaId is not Guid subId) { return (false, "La salida no tiene concepto configurado."); }
        try
        {
            var titulo = $"Compra {r.NumFacturaProveedor} - {r.NombreProveedor}".Trim();
            if (titulo.Length > 120) { titulo = titulo[..120]; }
            var req = new CreateTaskItemRequest(
                Title: titulo,
                ActivityTypeId: null,
                Description: BuildTareaResumen(r),
                AssigneeTenantUserId: assignee,
                RequesterName: r.NombreProveedor,
                RequesterDocument: r.NitProveedor,
                SubcategoriaId: subId);
            var result = await Tasks.CreateAsync(req, _actorId, _userName ?? "Usuario");
            if (!result.IsOk || result.Value is null) { return (false, result.Error ?? "No se pudo crear la tarea."); }
            var num = result.Value.Item.Number;
            // El formulario configurado "cae" en la tarea (via ActividadSubcategoria.FormDefinitionId). Aqui
            // lo prellenamos con los datos de la factura del conciliador, en un borrador keyed por el NUMERO de
            // tarea (los codigos deben existir en el form: proveedor/nit/rut/fecha_compra/num_factura).
            if (salida.FormDefinitionId is Guid fid)
            {
                try
                {
                    var td = await FormResponses.GetOrCreateDraftAsync(fid, num);
                    if (td.IsOk && td.Value is { } tdr)
                    {
                        var data = new Dictionary<string, FormFieldValue>
                        {
                            ["proveedor"] = new FormFieldValue(r.NombreProveedor ?? string.Empty, "Text"),
                            ["nit"] = new FormFieldValue(r.NitProveedor ?? string.Empty, "Text"),
                            ["rut"] = new FormFieldValue(r.RutEscaneado ?? string.Empty, "Text"),
                            ["fecha_compra"] = new FormFieldValue(r.FechaEmision.ToString("yyyy-MM-dd"), "Date"),
                            ["num_factura"] = new FormFieldValue(r.NumFacturaProveedor ?? string.Empty, "Text"),
                        };
                        await FormResponses.SaveAsync(tdr.Id, data, false);
                    }
                }
                catch { /* el resumen ya viaja en la descripcion */ }
            }

            // Adjuntar los PDF del conciliador (por CUFE) como enlaces en la pestana Documentos de la tarea,
            // asi el usuario consulta los documentos de la factura desde la tarea (StoredFileDto.Url = /archivo/{id}).
            if (!string.IsNullOrWhiteSpace(r.Cufe))
            {
                try
                {
                    var docs = (await Files.ListAsync("ConciliacionDian", r.Cufe))
                        .Where(f => (f.ContentType ?? string.Empty).Contains("pdf", StringComparison.OrdinalIgnoreCase)
                                 || (f.FileName ?? string.Empty).EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    foreach (var f in docs)
                    {
                        // Nombre amigable: los archivos del conciliador vienen como {cufe}_dian.pdf / {cufe}_newton.pdf.
                        var fn = f.FileName ?? string.Empty;
                        var nombre = fn.Contains("_newton", StringComparison.OrdinalIgnoreCase) ? "Representacion grafica (NEWTON).pdf"
                            : fn.Contains("_dian", StringComparison.OrdinalIgnoreCase) ? "Factura electronica (DIAN).pdf"
                            : fn;
                        await Tasks.AddAttachmentAsync(
                            new AddTaskAttachmentRequest(result.Value.Item.Id, nombre, f.Url, f.ContentType, f.SizeBytes),
                            _actorId, _userName ?? "Usuario");
                    }
                }
                catch { /* best-effort: los documentos siguen disponibles en el conciliador */ }
            }

            await TaskCfg.SetSolicitadaAsync(r.Id, num);
            _tareaDeRenglon[r.Id] = num;
            return (true, num);
        }
        catch (Exception ex) { return (false, "Error al crear la tarea: " + ex.Message); }
    }

    // ===== Asistente de IA: analisis masivo del documento (propone salida+usuario por factura; se confirma) =====
    private bool _iaBusy;
    private bool _iaPropOpen;
    private string? _iaMsg;
    private sealed class IaProp
    {
        public Guid RenglonId { get; set; }
        public string Factura { get; set; } = string.Empty;
        public string Proveedor { get; set; } = string.Empty;
        public string? Motivo { get; set; }
        public Guid? UserId { get; set; }
        public Guid? SalidaId { get; set; }
        public string Estado { get; set; } = "sin-regla";   // ok | sin-regla | sin-usuario | sin-salida | creada
        public bool Incluir { get; set; }
    }
    private List<IaProp> _iaProps = new();

    private void ToggleAllProps(bool v) { foreach (var p in _iaProps.Where(x => x.Estado == "ok")) { p.Incluir = v; } }

    private async Task AnalizarConIaAsync()
    {
        if (_iaBusy) { return; }
        _iaBusy = true; _busy = true; _msg = null; _iaMsg = null;
        try
        {
            var agentId = await TaskCfg.GetAsistenteAgentIdAsync();
            if (agentId is not Guid aid) { _msg = "Configura primero el agente en «Configuracion → Asistente de IA»."; return; }
            var reglas = (await TaskCfg.GetAsistenteReglasAsync()).Where(r => !string.IsNullOrWhiteSpace(r.Prompt)).ToList();
            if (reglas.Count == 0) { _msg = "No hay reglas por proveedor configuradas (Configuracion → Asistente de IA)."; return; }
            await LoadSalidasRunAsync();   // salidas frescas para resolver la ruta

            static bool ProvMatch(ConciliacionDianRenglonDto r, AsistenteProveedorReglaDto rg)
            {
                var p = (rg.Proveedor ?? string.Empty).Trim();
                if (p.Length == 0) { return false; }
                var nom = r.NombreProveedor ?? string.Empty;
                var nit = r.NitProveedor ?? string.Empty;
                return nom.Contains(p, StringComparison.OrdinalIgnoreCase)
                    || (nit.Length > 0 && nit.Equals(p, StringComparison.OrdinalIgnoreCase))
                    || (nom.Length > 0 && p.Contains(nom, StringComparison.OrdinalIgnoreCase));
            }

            var candidatos = _renglones
                .Where(r => !_tareaDeRenglon.ContainsKey(r.Id))
                .Where(r => reglas.Any(rg => ProvMatch(r, rg)))
                .Take(100)
                .ToList();
            if (candidatos.Count == 0) { _msg = "No hay facturas pendientes cuyo proveedor tenga una regla configurada."; return; }

            // Lista de reglas (indice global; estable entre lotes).
            var reglasText = new System.Text.StringBuilder();
            reglasText.AppendLine("REGLAS (indice global; una regla aplica solo a facturas de su mismo proveedor):");
            for (var k = 0; k < reglas.Count; k++)
            {
                reglasText.AppendLine($"{k + 1}) proveedor=\"{reglas[k].Proveedor}\" condicion=\"{reglas[k].Prompt}\"");
            }

            // El PROMPT DEL AGENTE (criterio general que configuro el usuario) va como base y se REFUERZA con el
            // framing de la tarea; las reglas por proveedor (condiciones especificas) viajan en el mensaje de usuario.
            var basePrompt = (await AiAgents.GetAsync(aid))?.Agent.SystemPrompt?.Trim();
            const string tarea = "Actua como clasificador del conciliador DIAN. Para CADA factura, evalua SOLO las reglas cuyo proveedor coincide (por nombre o NIT) y determina la PRIMERA regla cuya condicion se cumple segun los datos de la factura (incluidos sus campos adicionales). Si ninguna se cumple, usa null. Responde UNICAMENTE con un JSON array, un objeto por factura en el MISMO orden: [{\"f\":<indice_factura>,\"r\":<indice_regla o null>}]. Sin texto fuera del JSON ni markdown.";
            var system = string.IsNullOrWhiteSpace(basePrompt) ? tarea : basePrompt + "\n\n---\n" + tarea;

            // Arma la linea de una factura (indice local del lote) incluyendo sus campos EAV con valor.
            string FacturaLinea(int n, ConciliacionDianRenglonDto r)
            {
                var dyn = string.Join(" ", _dynDefs
                    .Select(d => (d.Label, Val: DynVal(r.Id, d.Id)))
                    .Where(x => !string.IsNullOrWhiteSpace(x.Val))
                    .Select(x => $"{x.Label}=\"{x.Val}\""));
                return $"{n}) proveedor=\"{r.NombreProveedor}\" nit={r.NitProveedor} total={r.TotalFactura} subtotal_neto={r.SubtotalNeto} iva={r.IvaDescontable} fecha={r.FechaEmision:yyyy-MM-dd} tipo_doc={r.TipoDocDian} orden_compra={r.OrdenCompraSoldarco} num_factura={r.NumFacturaProveedor}{(dyn.Length > 0 ? " " + dyn : "")}";
            }

            // Procesar en LOTES (prompts mas chicos y confiables). El indice de factura es LOCAL por lote;
            // el indice de regla es GLOBAL (la lista de reglas es la misma en todos los lotes).
            const int batchSize = 20;
            _iaProps = new();
            var soloUna = _salidasRun.Count == 1 ? _salidasRun[0].Id : (Guid?)null;
            var totalLotes = (candidatos.Count + batchSize - 1) / batchSize;
            var errores = 0;
            for (var bi = 0; bi < totalLotes; bi++)
            {
                var lote = candidatos.Skip(bi * batchSize).Take(batchSize).ToList();
                _iaMsg = $"Analizando lote {bi + 1}/{totalLotes}...";
                StateHasChanged();

                var sb = new System.Text.StringBuilder();
                sb.AppendLine("FACTURAS (evalua cada una contra las reglas de SU proveedor):");
                for (var i = 0; i < lote.Count; i++) { sb.AppendLine(FacturaLinea(i + 1, lote[i])); }
                sb.AppendLine();
                sb.Append(reglasText);

                var res = await AiInfer.TestChatAsync(aid, new List<AiChatTurn> { new("user", sb.ToString()) }, systemPromptOverride: system, actorUserId: _actorId);
                var map = (res.Ok && !string.IsNullOrWhiteSpace(res.Text)) ? ParseIaArray(res.Text!) : new Dictionary<int, int?>();
                if (!res.Ok) { errores++; }

                for (var i = 0; i < lote.Count; i++)
                {
                    var r = lote[i];
                    map.TryGetValue(i + 1, out var ridx);
                    AsistenteProveedorReglaDto? regla = (ridx is int rk && rk >= 1 && rk <= reglas.Count) ? reglas[rk - 1] : null;
                    var prop = new IaProp { RenglonId = r.Id, Factura = r.NumFacturaProveedor ?? string.Empty, Proveedor = r.NombreProveedor ?? string.Empty };
                    if (regla is null) { prop.Estado = "sin-regla"; }
                    else
                    {
                        prop.UserId = regla.AssignUserId ?? r.AssignedTenantUserId;
                        prop.SalidaId = regla.SalidaId ?? soloUna;
                        prop.Estado = prop.UserId is null ? "sin-usuario" : prop.SalidaId is null ? "sin-salida" : "ok";
                        prop.Incluir = prop.Estado == "ok";
                    }
                    _iaProps.Add(prop);
                }
            }
            var aplican = _iaProps.Count(p => p.Estado == "ok");
            _iaMsg = $"{candidatos.Count} factura(s) en {totalLotes} lote(s); {aplican} con regla aplicable." + (errores > 0 ? $" ({errores} lote(s) con error de IA.)" : "");
            _iaPropOpen = true;
        }
        catch (Exception ex) { _msg = "Error en el analisis con IA: " + ex.Message; }
        finally { _iaBusy = false; _busy = false; }
    }

    // Extrae del texto del modelo el mapa indice_factura(1..n) -> indice_regla(1..k) o null.
    private static Dictionary<int, int?> ParseIaArray(string text)
    {
        var map = new Dictionary<int, int?>();
        var a = text.IndexOf('['); var b = text.LastIndexOf(']');
        if (a < 0 || b <= a) { return map; }
        try
        {
            using var doc = JsonDocument.Parse(text.Substring(a, b - a + 1));
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty("f", out var fp)) { continue; }
                var f = fp.ValueKind == JsonValueKind.Number ? fp.GetInt32() : (int.TryParse(fp.GetString(), out var fi) ? fi : -1);
                if (f < 1) { continue; }
                int? r = null;
                if (el.TryGetProperty("r", out var rp) && rp.ValueKind != JsonValueKind.Null)
                {
                    r = rp.ValueKind == JsonValueKind.Number ? rp.GetInt32() : (int.TryParse(rp.GetString(), out var ri) ? ri : (int?)null);
                }
                map[f] = r;
            }
        }
        catch { /* respuesta no parseable -> queda sin reglas */ }
        return map;
    }

    private async Task CrearPropuestasAsync()
    {
        if (_iaBusy) { return; }
        _iaBusy = true; _busy = true;
        var creadas = 0; var fallos = 0;
        try
        {
            foreach (var p in _iaProps.Where(x => x.Incluir && x.Estado == "ok").ToList())
            {
                var r = _renglones.FirstOrDefault(x => x.Id == p.RenglonId);
                var salida = _salidasRun.FirstOrDefault(s => s.Id == p.SalidaId);
                if (r is null || salida is null || p.UserId is not Guid uid) { fallos++; continue; }
                if (_tareaDeRenglon.ContainsKey(r.Id)) { continue; }
                var (ok, _) = await CrearTareaCoreAsync(r, salida, uid);
                if (ok) { creadas++; p.Estado = "creada"; p.Incluir = false; } else { fallos++; }
            }
            _iaMsg = $"{creadas} tarea(s) creada(s)" + (fallos > 0 ? $", {fallos} con error." : ".");
            _msg = _iaMsg;
            RebuildItems();
        }
        catch (Exception ex) { _iaMsg = "Error al crear: " + ex.Message; }
        finally { _iaBusy = false; _busy = false; }
    }

    private string BuildTareaResumen(ConciliacionDianRenglonDto r)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Factura de compra DIAN (desde el conciliador).");
        sb.AppendLine($"Proveedor: {r.NombreProveedor} (NIT {r.NitProveedor})");
        sb.AppendLine($"Factura: {r.NumFacturaProveedor}");
        sb.AppendLine($"Fecha de emision: {r.FechaEmision:dd/MM/yyyy}");
        sb.AppendLine($"Total: {Fmt(r.TotalFactura)}");
        if (!string.IsNullOrWhiteSpace(r.NumFacturaSoldarco)) { sb.AppendLine($"Documento SISTEMA: {r.NumFacturaSoldarco}"); }
        if (!string.IsNullOrWhiteSpace(r.OrdenCompraSoldarco)) { sb.AppendLine($"Orden de compra: {r.OrdenCompraSoldarco}"); }
        if (!string.IsNullOrWhiteSpace(r.Cufe)) { sb.AppendLine($"CUFE: {r.Cufe}"); }
        sb.Append($"Referencia conciliacion (REG): {r.Id}");
        return sb.ToString();
    }

