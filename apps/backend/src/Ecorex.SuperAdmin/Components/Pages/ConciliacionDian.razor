    /// <summary>Guarda la seleccion de un campo Lookup (Id de fila) y refresca su etiqueta.</summary>
    private async Task SetDynLookup(ConciliacionDianRenglonDto r, ConciliacionFieldDefDto d, string? rowId)
    {
        var val = rowId ?? "";
        await Fields.SetValueAsync(r.Id, d.Id, val);
        if (!_dynValues.TryGetValue(r.Id, out var dict)) { dict = new(); _dynValues[r.Id] = dict; }
        dict[d.Id] = val;
        // Resolver la etiqueta de la fila elegida para mostrarla sin recargar todo.
        if (!string.IsNullOrWhiteSpace(val) && _lookupCfg.TryGetValue(d.Id, out var cfg) && Guid.TryParse(val, out var g))
        {
            try
            {
                var rows = await Lookups.ResolveAsync(cfg.TableId, new[] { g }, cfg.DisplayColumnId);
                if (!_lookupLabels.TryGetValue(d.Id, out var m)) { m = new(); _lookupLabels[d.Id] = m; }
                foreach (var row in rows) { m[row.RowId.ToString()] = row.Label; }
            }
            catch { }
        }
        _editCell = null;
        RebuildItems();
    }

