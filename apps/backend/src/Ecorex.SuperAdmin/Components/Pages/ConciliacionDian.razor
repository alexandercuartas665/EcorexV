    // Proveedores sugeridos para el autocompletar: distintos del documento cargado.
    private IEnumerable<string> ProveedoresSugeridos()
        => _renglones.Select(r => r.NombreProveedor).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n).Take(300)!;
    private async Task GuardarAsistenteAsync()
    {
        _busy = true; _cfgMsg = null;
        try
        {
            await TaskCfg.SetAsistenteAgentIdAsync(_asistenteSel);
            await TaskCfg.SaveAsistenteReglasAsync(_asisReglas
                .Select(r => new AsistenteProveedorReglaDto(r.Id, r.Proveedor, r.Prompt, r.AssignUserId, r.SalidaId)).ToList());
            var nombre = _asistenteSel is Guid a ? _agentes.FirstOrDefault(x => x.Id == a)?.Name : null;
            var n = _asisReglas.Count(r => !string.IsNullOrWhiteSpace(r.Proveedor) || !string.IsNullOrWhiteSpace(r.Prompt));
            _cfgMsg = (nombre is null ? "Asistente sin agente" : $"Asistente: {nombre}") + $" · {n} regla(s) por proveedor guardada(s).";
        }
        catch (Exception ex) { _cfgMsg = "Error al guardar el asistente: " + ex.Message; }
