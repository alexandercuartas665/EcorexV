            <div class="cd-rules-foot">
                <div style="flex:1"></div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarPickSalida">Cancelar</button>
            </div>
        </div>
    }

    @* Propuestas del asistente de IA: por cada factura pendiente cuyo proveedor tiene regla, el agente
       evalua y propone la salida+usuario; el usuario revisa y confirma antes de crear las tareas. *@
    @if (_iaPropOpen)
    {
        <div class="cd-doc-backdrop" @onclick="() => _iaPropOpen = false"></div>
        <div class="cd-rules-modal" style="width:min(980px,97vw);height:min(760px,90vh);" @onclick:stopPropagation="true">
            <div class="cd-doc-head">
                <div class="cd-doc-title">
                    <div class="cd-doc-title-main">Propuestas del asistente de IA</div>
                    <div class="cd-doc-title-sub">El agente evaluo las reglas por proveedor. Revisa y marca cuales crear; la tarea se crea solo al confirmar.</div>
                </div>
                <button class="cd-doc-close" title="Cerrar" @onclick="() => _iaPropOpen = false">&times;</button>
            </div>
            <div class="cd-rules-body">
                @if (_iaProps.Count == 0)
                {
                    <div class="cd-muted">Sin propuestas.</div>
                }
                else
                {
                    <table class="cd-ia-tbl">
                        <thead>
                            <tr>
                                <th style="width:34px;"><input type="checkbox" checked="@(_iaProps.Any(p => p.Estado == "ok") && _iaProps.Where(p => p.Estado == "ok").All(p => p.Incluir))" @onchange="e => ToggleAllProps(e.Value is bool b && b)" title="Marcar/desmarcar todas las aplicables" /></th>
                                <th>Factura</th>
                                <th>Proveedor</th>
                                <th>Resultado</th>
                                <th>Usuario</th>
                                <th>Salida (ruta)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _iaProps)
                            {
                                var prop = p;
                                <tr class="@(prop.Estado == "ok" ? "" : "cd-ia-off")">
                                    <td><input type="checkbox" checked="@prop.Incluir" disabled="@(prop.Estado != "ok")" @onchange="e => prop.Incluir = (e.Value is bool b && b)" /></td>
                                    <td>@prop.Factura</td>
                                    <td title="@prop.Proveedor">@prop.Proveedor</td>
                                    <td>
                                        @if (prop.Estado == "ok")
                                        {
                                            <span class="cd-ia-badge ok">Aplica</span>
                                            @if (!string.IsNullOrWhiteSpace(prop.Motivo)) { <span class="cd-muted" style="margin-left:6px; font-size:11px;">@prop.Motivo</span> }
                                        }
                                        else if (prop.Estado == "sin-regla")
                                        {
                                            <span class="cd-ia-badge no">Ninguna regla</span>
                                        }
                                        else if (prop.Estado == "creada")
                                        {
                                            <span class="cd-ia-badge ok">Tarea creada</span>
                                        }
                                        else
                                        {
                                            <span class="cd-ia-badge warn">@(prop.Estado == "sin-usuario" ? "Falta usuario en la regla" : "Falta salida en la regla")</span>
                                        }
                                    </td>
                                    <td>@(prop.UserId is Guid uu ? UserNameById(uu) : "—")</td>
                                    <td>@(_salidasRun.FirstOrDefault(s => s.Id == prop.SalidaId)?.Nombre ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_iaMsg is { Length: > 0 })
                    {
                        <div class="cd-muted" style="margin-top:8px;">@_iaMsg</div>
                    }
                }
            </div>
            <div class="cd-rules-foot">
                <span class="cd-muted">@_iaProps.Count(p => p.Incluir) de @_iaProps.Count seleccionada(s) para crear.</span>
                <div style="flex:1"></div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _iaPropOpen = false" disabled="@_iaBusy">Cerrar</button>
                <button class="btn btn-primary btn-sm" @onclick="CrearPropuestasAsync" disabled="@(_iaBusy || !_iaProps.Any(p => p.Incluir))">Crear tareas seleccionadas</button>
            </div>
        </div>
    }

