                        <span class="cd-pick-salida-sub">@(salida.Categoria is null ? "Sin concepto" : $"{salida.Categoria} › {salida.Subcategoria}")@(salida.FormTitle is null ? "" : $" · {salida.FormTitle}")</span>
                    </button>
                }
