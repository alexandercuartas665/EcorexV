    /// <summary>Extrae la formula cruda del options_json (guardado como string JSON para caber en jsonb).</summary>
    private static string FormulaFromJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return ""; }
        var t = json.TrimStart();
        if (t.Length > 0 && t[0] == '"') { try { return JsonSerializer.Deserialize<string>(json) ?? ""; } catch { return ""; } }
        return json; // compat: por si viniera cruda
    }

