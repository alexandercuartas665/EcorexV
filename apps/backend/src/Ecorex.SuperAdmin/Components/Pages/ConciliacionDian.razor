    // ---- Ordenar ----
    private void QuickSort(string key)
    {
        if (_sorts.Count == 1 && _sorts[0].K == key) { _sorts[0].Dir = -_sorts[0].Dir; }
        else { _sorts = new() { new SortSpec { K = key, Dir = 1 } }; }
        RebuildItems(); _ = SavePrefsAsync();
    }
    private void SetSingleSort(string key, int dir) { _sorts = new() { new SortSpec { K = key, Dir = dir } }; CloseColMenu(); RebuildItems(); _ = SavePrefsAsync(); }
    private void AddSort()
    {
        var used = _sorts.Select(s => s.K).ToHashSet();
        var nx = MenuCols.FirstOrDefault(c => !used.Contains(c.Key)) ?? _allCols[0];
        _sorts.Add(new SortSpec { K = nx.Key, Dir = 1 }); RebuildItems(); _ = SavePrefsAsync();
    }
    private void ChangeSortField(SortSpec s, ChangeEventArgs e) { s.K = e.Value?.ToString() ?? s.K; RebuildItems(); _ = SavePrefsAsync(); }
    private void ToggleSortDir(SortSpec s) { s.Dir = -s.Dir; RebuildItems(); _ = SavePrefsAsync(); }
    private void RemoveSort(SortSpec s) { _sorts.Remove(s); RebuildItems(); _ = SavePrefsAsync(); }

    // ---- Agrupar ----
    private void AddGroup()
    {
        var used = _groups.ToHashSet();
        var nx = MenuCols.FirstOrDefault(c => c.Groupable && !used.Contains(c.Key));
        if (nx is not null) { _groups.Add(nx.Key); RebuildItems(); _ = SavePrefsAsync(); }
    }
    private void ChangeGroupField(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _groups.Count) { _groups[idx] = e.Value?.ToString() ?? _groups[idx]; RebuildItems(); _ = SavePrefsAsync(); } }
    private void RemoveGroup(int idx) { if (idx >= 0 && idx < _groups.Count) { _groups.RemoveAt(idx); RebuildItems(); _ = SavePrefsAsync(); } }
    private void AddGroupKey(string key) { if (!_groups.Contains(key)) { _groups.Add(key); } CloseColMenu(); RebuildItems(); _ = SavePrefsAsync(); }
    private void RemoveGroupKey(string key) { _groups.Remove(key); CloseColMenu(); RebuildItems(); _ = SavePrefsAsync(); }

    // ---- Columnas: mover / ocultar ----
    private void MoveCol(int idx, int dir)
    {
        var ni = idx + dir;
        if (ni < 0 || ni >= _order.Count) { return; }
        (_order[idx], _order[ni]) = (_order[ni], _order[idx]);
        _ = SavePrefsAsync();
    }
    private void OnDropCol(string targetKey)
    {
        var src = _dragCol;
        _dragCol = null;
        if (src is null || src == targetKey) { return; }
        var from = _order.IndexOf(src);
        var to = _order.IndexOf(targetKey);
        if (from < 0 || to < 0) { return; }
        _order.RemoveAt(from);
        to = _order.IndexOf(targetKey); // recalcular tras remover (el indice pudo correrse)
        _order.Insert(to, src);         // deja la arrastrada ANTES de la columna destino
        _ = SavePrefsAsync();
    }
    private void ToggleHidden(string key) { if (!_hidden.Remove(key)) { _hidden.Add(key); } _ = SavePrefsAsync(); }
    private void HideColFromMenu(string key) { _hidden.Add(key); CloseColMenu(); _ = SavePrefsAsync(); }

