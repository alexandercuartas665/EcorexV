    private async Task LoadDynDefsAsync()
    {
        _dynDefs = (await Fields.ListDefsAsync()).ToList();
        _dynCols = _dynDefs.Select(d => new GridCol(DynKey(d.FieldKey), d.Label, d.Type == "Number", true)).ToList();
        _dynByKey = _dynDefs.ToDictionary(d => DynKey(d.FieldKey), d => d);
        // Asegura que las columnas dinamicas esten en el orden (al final) y limpia claves dyn obsoletas.
        var dynKeys = _dynCols.Select(c => c.Key).ToHashSet();
        _order.RemoveAll(k => k.StartsWith("dyn:") && !dynKeys.Contains(k));
        foreach (var k in dynKeys) { if (!_order.Contains(k)) { _order.Add(k); } }
    }

