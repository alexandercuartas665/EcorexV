    private sealed class RuleEdit
    {
        public Guid Id;
        public int SortOrder;
        public string Name = "";
        public string Kind = "Lookup";
        public bool Enabled = true;
        public RuleLookupSpec? Lookup;
        public RuleConditionSpec? Condition;
        public bool Dirty;
    }

    private bool _reglasConfigOpen;
    private List<RuleEdit> _ruleList = new();
    private List<RuleContenedorDto> _contenedores = new();
    private static readonly System.Text.Json.JsonSerializerOptions _rjson = new() { PropertyNameCaseInsensitive = true };

    private IReadOnlyList<string> ColsDe(Guid cid) => _contenedores.FirstOrDefault(c => c.ContainerId == cid)?.Columns ?? Array.Empty<string>();
    private static void DirtyRu(RuleEdit ru) => ru.Dirty = true;

    private async Task AbrirConfigReglasAsync()
    {
        _busy = true; _msg = null;
        try
        {
            _contenedores = (await Reglas.ListContenedoresAsync()).ToList();
            _ruleList = (await Reglas.ListAsync()).Select(d =>
            {
                var e = new RuleEdit { Id = d.Id, SortOrder = d.SortOrder, Name = d.Name, Kind = d.Kind, Enabled = d.Enabled };
                if (string.Equals(d.Kind, "Lookup", StringComparison.OrdinalIgnoreCase))
                {
                    e.Lookup = TryDes<RuleLookupSpec>(d.DefinitionJson) ?? new RuleLookupSpec();
                    if (e.Lookup.Matches.Count == 0) { e.Lookup.Matches.Add(new RuleLookupMatch()); }
                    e.Lookup.Norm ??= new RuleNorm();
                }
                else
                {
                    e.Condition = TryDes<RuleConditionSpec>(d.DefinitionJson) ?? new RuleConditionSpec();
                    e.Condition.When ??= new RuleCond { Kind = "group", Op = "and" };
                    e.Condition.Then ??= new();
                }
                return e;
            }).ToList();
            _reglasConfigOpen = true;
        }
        catch (Exception ex) { _msg = "Error al abrir reglas: " + ex.Message; }
        finally { _busy = false; }
    }

    private void CerrarConfigReglas() { _reglasConfigOpen = false; }

    private static T? TryDes<T>(string json) where T : class
    {
        try { return System.Text.Json.JsonSerializer.Deserialize<T>(json, _rjson); } catch { return null; }
    }

    private static string SerializeSpec(RuleEdit ru) =>
        ru.Kind == "Lookup"
            ? System.Text.Json.JsonSerializer.Serialize(ru.Lookup)
            : System.Text.Json.JsonSerializer.Serialize(ru.Condition);

    private async Task AddLookupAsync() => await AddRuleAsync("Lookup");
    private async Task AddConditionAsync() => await AddRuleAsync("Condition");

    private async Task AddRuleAsync(string kind)
    {
        var ru = new RuleEdit { Kind = kind, SortOrder = _ruleList.Count, Enabled = true, Name = kind == "Lookup" ? "Nueva busqueda" : "Nueva condicion" };
        if (kind == "Lookup") { ru.Lookup = new RuleLookupSpec { Matches = new() { new RuleLookupMatch() } }; }
        else { ru.Condition = new RuleConditionSpec { When = new RuleCond { Kind = "group", Op = "and", Children = new() { new RuleCond { Kind = "cond" } } }, Then = new() { new RuleAssign() } }; }
        var saved = await Reglas.SaveAsync(new ConciliacionRuleDto(Guid.Empty, ru.SortOrder, ru.Name, ru.Kind, ru.Enabled, SerializeSpec(ru)));
        if (saved is not null) { ru.Id = saved.Id; _ruleList.Add(ru); }
    }

    private async Task GuardarRuleAsync(RuleEdit ru)
    {
        var saved = await Reglas.SaveAsync(new ConciliacionRuleDto(ru.Id, ru.SortOrder, ru.Name, ru.Kind, ru.Enabled, SerializeSpec(ru)));
        if (saved is not null) { ru.Id = saved.Id; ru.Dirty = false; }
    }

    private async Task BorrarRuleAsync(RuleEdit ru)
    {
        await Reglas.DeleteAsync(ru.Id);
        _ruleList.Remove(ru);
        for (var k = 0; k < _ruleList.Count; k++) { _ruleList[k].SortOrder = k; }
        await Reglas.ReorderAsync(_ruleList.Select(r => r.Id).ToList());
    }

    private async Task MoveRuleAsync(int idx, int dir)
    {
        var tgt = idx + dir;
        if (tgt < 0 || tgt >= _ruleList.Count) { return; }
        (_ruleList[idx], _ruleList[tgt]) = (_ruleList[tgt], _ruleList[idx]);
        for (var k = 0; k < _ruleList.Count; k++) { _ruleList[k].SortOrder = k; }
        await Reglas.ReorderAsync(_ruleList.Select(r => r.Id).ToList());
    }

