    // "Enviar a Newton": primero corre un dry-run para saber cuanto se radicaria y pide confirmacion.
    private async Task PrepararEnvioAsync()
    {
        _busy = true; _msg = null;
        try
        {
            _envioPreview = await Svc.RadicarEventosAsync(_selectedDocId, Array.Empty<Guid>(), simular: true);
            if (_envioPreview.EventosEnviados == 0)
            {
                _msg = RadicacionMsg(_envioPreview, "No hay eventos para radicar");
                _envioPreview = null;
                return;
            }
            _showEnviarConfirm = true;
        }
        finally { _busy = false; }
    }

    private void CancelarEnvio() { _showEnviarConfirm = false; _envioPreview = null; }

    private async Task ConfirmarEnvioAsync()
    {
        _showEnviarConfirm = false;
        _busy = true; _msg = null;
        try
        {
            var r = await Svc.RadicarEventosAsync(_selectedDocId, Array.Empty<Guid>(), simular: false);
            _msg = r.Error is not null ? $"No se pudo radicar: {r.Error}" : RadicacionMsg(r, "Radicado en NEWTON");
            await ReloadAsync();
        }
        finally { _busy = false; _envioPreview = null; }
    }

