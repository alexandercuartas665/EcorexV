    private static readonly (string Token, string Label, string Hex)[] _palette = new[]
    {
        ("green", "Verde", "#16a34a"), ("yellow", "Amarillo", "#eab308"), ("red", "Rojo", "#dc2626"),
        ("blue", "Azul", "#2563eb"), ("gray", "Gris", "#6b7280"), ("purple", "Morado", "#7c3aed"),
        ("orange", "Naranja", "#ea580c"),
    };
    private static string Hex(string token)
    {
        foreach (var p in _palette) { if (p.Token == token) { return p.Hex; } }
        return "transparent";
    }
