    private async Task AbrirConfigCamposAsync()
    {
        _busy = true; _msg = null;
        try
        {
            _lkModels = (await Lookups.ListModelsAsync()).ToList();
            // Excluir las defs "sys:*" (fuente de datos de columnas fijas): se configuran en la seccion Sistema.
            var defs = (await Fields.ListDefsAsync()).Where(d => !d.FieldKey.StartsWith("sys:", StringComparison.Ordinal)).ToList();
            _fieldEditList = defs.Select(d => new FieldEdit
            {
                Id = d.Id, FieldKey = d.FieldKey, Label = d.Label, Type = d.Type, SortOrder = d.SortOrder,
                OptionsText = string.Join(", ", d.Options),
                Formula = d.Type == "Calculated" ? FormulaFromJson(d.OptionsJson) : "",
                Description = d.Description ?? "", ShowInFilter = d.ShowInFilter,
            }).ToList();
            // Rehidratar la config de los campos Lookup (modelo/tabla/columna) y cargar sus listas.
            foreach (var fe in _fieldEditList.Where(x => x.Type == "Lookup"))
            {
                var d = defs.First(x => x.Id == fe.Id);
                var cfg = DataLookupConfig.TryParse(d.OptionsJson);
                if (cfg is null) { continue; }
                fe.ModelId = cfg.ModelId; fe.TableId = cfg.TableId; fe.DisplayColId = cfg.DisplayColumnId;
                try { fe.Tables = (await Lookups.ListTablesAsync(cfg.ModelId)).ToList(); } catch { }
                try { fe.Columns = (await Lookups.ListColumnsAsync(cfg.TableId)).ToList(); } catch { }
            }
            // Edicion de fuente de datos de columnas fijas (oc/numsol).
            _sysEdits = new();
            foreach (var (key, label) in _sysConfigurables)
            {
                var se = new SysEdit { ColumnKey = key, Label = label, NoReuse = _sysUnique.Contains(key) };
                if (_sysSource.TryGetValue(key, out var cfg))
                {
                    se.SourceType = "Lookup"; se.ModelId = cfg.ModelId; se.TableId = cfg.TableId; se.DisplayColId = cfg.DisplayColumnId;
                    try { se.Tables = (await Lookups.ListTablesAsync(cfg.ModelId)).ToList(); } catch { }
                    try { se.Columns = (await Lookups.ListColumnsAsync(cfg.TableId)).ToList(); } catch { }
                }
                _sysEdits[key] = se;
            }
            _selSysCol = null;
            _selFieldId = _fieldEditList.FirstOrDefault()?.Id ?? Guid.Empty;
            _fieldsConfigOpen = true;
        }
        catch (Exception ex) { _msg = "Error al abrir campos: " + ex.Message; }
        finally { _busy = false; }
    }

