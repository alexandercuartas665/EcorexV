    private static List<string> ParseOptions(string text) =>
        (text ?? "").Split(',').Select(o => o.Trim()).Where(o => o.Length > 0).ToList();

    private ConciliacionFieldDefDto ToDto(FieldEdit fe)
    {
        string? optionsJson = null;
        if (fe.Type == "Lookup" && fe.TableId is Guid tid)
        {
            var tName = fe.Tables.FirstOrDefault(t => t.Id == tid)?.Name;
            var cName = fe.DisplayColId is Guid dc ? fe.Columns.FirstOrDefault(c => c.Id == dc)?.Name : null;
            optionsJson = new DataLookupConfig(tid, fe.ModelId, fe.DisplayColId, TableName: tName, DisplayColumnName: cName).ToJson();
        }
        else if (fe.Type == "Calculated")
        {
            // options_json es jsonb: la formula se guarda como string JSON (entre comillas).
            optionsJson = string.IsNullOrWhiteSpace(fe.Formula) ? null : JsonSerializer.Serialize(fe.Formula.Trim());
        }
        return new(fe.Id, fe.FieldKey, fe.Label, fe.Type, fe.SortOrder, ParseOptions(fe.OptionsText), optionsJson,
            string.IsNullOrWhiteSpace(fe.Description) ? null : fe.Description.Trim(), fe.ShowInFilter);
    }

