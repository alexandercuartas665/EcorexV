    private Dictionary<Guid, string> _tareaDeRenglon = new();
    private bool _creandoTarea;

    private async Task AbrirConfigAsync()
    {
        _busy = true; _cfgMsg = null; _msg = null;
        try
        {
            _taskSubs = (await TaskCfg.ListSubcategoriasAsync()).ToList();
            _taskForms = (await TaskCfg.ListFormulariosAsync()).ToList();
            var salidas = await TaskCfg.ListSalidasAsync();
            _salidas = new();
            foreach (var s in salidas)
            {
                var e = new SalidaEdit
                {
                    Id = s.Id, Nombre = s.Nombre, Sub = s.SubcategoriaId, Form = s.FormDefinitionId,
                    DireEnabled = s.DireccionarEnabled,
                    DireMaps = s.DireccionarMaps.Select(m => new DireEdit { FormField = m.FormField, Target = m.Target }).ToList(),
                };
                if (s.FormDefinitionId is Guid ff) { e.FormFields = (await TaskCfg.ListFormFieldsAsync(ff)).ToList(); }
                _salidas.Add(e);
            }
            await LoadReglasDataAsync();   // contenedores + _ruleList para la pestaña Reglas
            _agentes = (await AiAgents.ListAsync()).ToList();        // pestaña Asistente de IA
            _asistenteSel = await TaskCfg.GetAsistenteAgentIdAsync();
            _asisReglas = (await TaskCfg.GetAsistenteReglasAsync())
                .Select(r => new AsisReglaEdit { Id = r.Id, Proveedor = r.Proveedor, Prompt = r.Prompt, AssignUserId = r.AssignUserId, SalidaId = r.SalidaId }).ToList();
            _cfgTab = "salidas";
