    private void CerrarConfig() => _cfgOpen = false;

    // ---- Asistente de IA ----
    private void OnAsistenteChange(ChangeEventArgs e) => _asistenteSel = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
