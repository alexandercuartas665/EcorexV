@page "/conciliacion-dian"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Ecorex.Application.Automatizaciones.ConciliacionDian
@using Ecorex.Application.Preferences
@using Ecorex.Application.Storage
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Components.Pages.Conciliacion
@using ClosedXML.Excel
@inject IConciliacionDianService Svc
@inject IConciliacionRuleService Reglas
@inject IConciliacionFieldService Fields
@inject IUserTablePrefsService Prefs
@inject ISavedFilterService SavedFilters
@inject IFileStorageService Files
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Conciliacion DIAN Compras - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <span>Automatizaciones</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Conciliacion DIAN Compras</h1>
        <p class="page-sub" style="margin-bottom:0;">Cruza las facturas de compra reportadas a la DIAN contra los documentos internos del ERP, por documento mensual (CCD).</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        @if (_docs.Count == 0)
        {
            <button class="btn btn-primary" @onclick="SeedDummyAsync" disabled="@_busy">Sembrar datos dummy</button>
        }
        <button class="btn btn-outline-secondary" @onclick="ToggleCrear" disabled="@_busy">+ Nuevo documento</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="cd-msg">@_msg</div>
}

@if (_showCrear)
{
    <div class="cd-crear">
        <span>Nuevo CCD:</span>
        <label>Mes <input type="number" min="1" max="12" @bind="_nuevoMes" class="cd-in cd-num" /></label>
        <label>Anio <input type="number" min="2000" max="2100" @bind="_nuevoAnio" class="cd-in cd-num" /></label>
        <button class="btn btn-primary btn-sm" @onclick="CrearDocAsync" disabled="@_busy">Crear</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleCrear" disabled="@_busy">Cancelar</button>
    </div>
}

@if (_docs.Count == 0)
{
    <div class="cd-empty">No hay documentos de conciliacion todavia. Usa "Sembrar datos dummy" para generar un CCD del mes con datos de prueba, o crea uno nuevo.</div>
}
else
{
    <div class="cd-doc-strip">
        <label>Documento CCD:
            <select class="cd-in" @onchange="OnDocChanged">
                @foreach (var d in _docs)
                {
                    <option value="@d.Id" selected="@(d.Id == _selectedDocId)">@d.Consecutivo - @($"{d.Mes:00}/{d.Anio}") (@d.Estado)</option>
                }
            </select>
        </label>
        <span class="cd-doc-meta">Creado: @(_selectedDoc?.FechaCreacion.ToString("dd/MM/yyyy") ?? "-")</span>
        <div style="flex:1"></div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ImportarAsync" disabled="@_busy" title="Trae del bot DIAN las facturas del periodo que falten">Importar del bot</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="CruzarAsync" disabled="@_busy" title="Empareja contra el ERP y auto-aprueba">Cruzar</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="AplicarReglasDryRunAsync" disabled="@_busy" title="Corre las reglas configuradas (VLOOKUP + condiciones) sobre este documento. Primero muestra una simulacion.">Aplicar reglas</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="AbrirConfigReglasAsync" disabled="@_busy" title="Configurar las reglas (VLOOKUP y condiciones) sin codigo">&#9881; Reglas</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="SimularEventosAsync" disabled="@_busy" title="SIMULACION: calcula que eventos RADIAN se enviarian a NEWTON, sin radicar nada">Simular eventos</button>
        <button class="btn btn-primary btn-sm" @onclick="PrepararEnvioAsync" disabled="@_busy" title="Radica los eventos RADIAN en NEWTON (IRREVERSIBLE)">Enviar a Newton</button>
    </div>

    <div class="cd-filtros">
        <button class="cd-tbtn @(FilterCount > 0 ? "on" : "")" @onclick="OpenFilterBuilder" title="Construye un filtro con condiciones Y/O anidadas">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
            <span>Filtros@(FilterCount > 0 ? $" ({FilterCount})" : "")</span>
        </button>

        <div class="cd-dd">
            <button class="cd-tbtn" @onclick="@(() => ToggleMenu("saved"))" title="Filtros guardados del equipo">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                <span>Guardados@(_savedFilters.Count > 0 ? $" ({_savedFilters.Count})" : "")</span>
            </button>
            @if (_openMenu == "saved")
            {
                <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
                <div class="cd-dd-panel" style="min-width:280px;">
                    <div class="cd-dd-title">Filtros del equipo</div>
                    @if (_savedFilters.Count == 0)
                    {
                        <div class="cd-dd-empty">No hay filtros guardados. Arma uno en "Filtros" y usa "Guardar".</div>
                    }
                    else
                    {
                        @foreach (var sf in _savedFilters)
                        {
                            var sfx = sf;
                            <div class="cd-dd-row">
                                <button class="cd-saved-apply" @onclick="() => ApplySavedAsync(sfx)" title="@($"Aplicar · Autor: {sfx.CreatedByName ?? "-"}")">@sfx.Name</button>
                                <button class="cd-saved-ico" @onclick="() => EditSavedAsync(sfx)" title="Editar">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                                </button>
                                <button class="cd-saved-ico cd-saved-del" @onclick="() => DeleteSavedAsync(sfx)" title="Eliminar">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                </button>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @if (FilterCount > 0)
        {
            <span class="cd-filter-active">@FilterCount condici@(FilterCount == 1 ? "ón" : "ones") activa@(FilterCount == 1 ? "" : "s")@(_activeFilterName is { } nm ? $" · {nm}" : "")</span>
            <button class="btn btn-link btn-sm" @onclick="ClearFilter" disabled="@_busy">Limpiar</button>
        }
    </div>

    @* ---- Barra de herramientas de la grilla: Ordenar | Agrupar | Columnas | Columnas fijas ---- *@
    <div class="cd-toolbar">
        @* Ordenar (multi-criterio) *@
        <div class="cd-dd">
            <button class="cd-tbtn @(_sorts.Count > 0 ? "on" : "")" @onclick="@(() => ToggleMenu("sort"))" title="Ordenar por una o varias columnas">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h11M3 12h7M3 18h4M18 5v14M18 19l3-3M18 19l-3-3"/></svg>
                <span>Ordenar@(_sorts.Count > 0 ? $" ({_sorts.Count})" : "")</span>
            </button>
            @if (_openMenu == "sort")
            {
                <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
                <div class="cd-dd-panel">
                    <div class="cd-dd-title">Ordenar por</div>
                    @if (_sorts.Count == 0) { <div class="cd-dd-empty">Sin orden aplicado.</div> }
                    @foreach (var s in _sorts.ToList())
                    {
                        var sc = s;
                        <div class="cd-dd-row">
                            <select class="cd-in" style="flex:1" @onchange="e => ChangeSortField(sc, e)">
                                @foreach (var col in MenuCols)
                                {
                                    <option value="@col.Key" selected="@(col.Key == sc.K)">@LabelOf(col)</option>
                                }
                            </select>
                            <button class="cd-dd-dir" @onclick="() => ToggleSortDir(sc)" title="Cambiar direccion">@(sc.Dir >= 0 ? "A→Z" : "Z→A")</button>
                            <button class="cd-dd-del" @onclick="() => RemoveSort(sc)" title="Quitar">&times;</button>
                        </div>
                    }
                    <button class="cd-dd-add" @onclick="AddSort">+ Agregar orden</button>
                </div>
            }
        </div>

        @* Agrupar (apilable) -> genera subtotales + cantidad *@
        <div class="cd-dd">
            <button class="cd-tbtn @(_groups.Count > 0 ? "on" : "")" @onclick="@(() => ToggleMenu("group"))" title="Agrupar (genera subtotales y cantidad de registros)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                <span>Agrupar@(_groups.Count > 0 ? $" ({_groups.Count})" : "")</span>
            </button>
            @if (_openMenu == "group")
            {
                <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
                <div class="cd-dd-panel">
                    <div class="cd-dd-title">Agrupar por</div>
                    @if (_groups.Count == 0) { <div class="cd-dd-empty">Sin agrupacion. Al agrupar se muestran subtotales de montos y cantidad por grupo.</div> }
                    @for (int gi = 0; gi < _groups.Count; gi++)
                    {
                        var idx = gi;
                        <div class="cd-dd-row">
                            <select class="cd-in" style="flex:1" @onchange="e => ChangeGroupField(idx, e)">
                                @foreach (var col in MenuCols.Where(x => x.Groupable))
                                {
                                    <option value="@col.Key" selected="@(col.Key == _groups[idx])">@LabelOf(col)</option>
                                }
                            </select>
                            <button class="cd-dd-del" @onclick="() => RemoveGroup(idx)" title="Quitar">&times;</button>
                        </div>
                    }
                    @if (_groups.Count < MenuCols.Count(x => x.Groupable))
                    {
                        <button class="cd-dd-add" @onclick="AddGroup">+ Agregar agrupacion</button>
                    }
                </div>
            }
        </div>

        @* Columnas: mover, mostrar/ocultar, restablecer *@
        <div class="cd-dd">
            <button class="cd-tbtn" @onclick="@(() => ToggleMenu("cols"))" title="Mover, mostrar u ocultar columnas">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                <span>Columnas@(_hidden.Count > 0 ? $" ({_order.Count - _hidden.Count}/{_order.Count})" : "")</span>
            </button>
            @if (_openMenu == "cols")
            {
                <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
                <div class="cd-dd-panel cd-dd-cols">
                    <div class="cd-dd-title">Columnas (arrastra el encabezado para reordenar)</div>
                    <div class="cd-collist">
                        @for (int ci = 0; ci < _order.Count; ci++)
                        {
                            var idx = ci;
                            var col = ColByKey(_order[idx]);
                            if (col is null) { continue; }
                            <div class="cd-colit">
                                <button class="cd-col-mv" disabled="@(idx == 0)" @onclick="() => MoveCol(idx, -1)">▲</button>
                                <button class="cd-col-mv" disabled="@(idx == _order.Count - 1)" @onclick="() => MoveCol(idx, 1)">▼</button>
                                <span class="cd-col-name">@LabelOf(col)</span>
                                <button class="cd-col-eye @(_hidden.Contains(col.Key) ? "" : "on")" @onclick="() => ToggleHidden(col.Key)" title="@(_hidden.Contains(col.Key) ? "Mostrar" : "Ocultar")">
                                    @(_hidden.Contains(col.Key) ? "oculta" : "visible")
                                </button>
                            </div>
                        }
                    </div>
                    <div class="cd-col-acts">
                        <button class="cd-col-mass" @onclick="ShowAllCols">Mostrar todas</button>
                        <button class="cd-col-reset" @onclick="ResetCols">Restablecer</button>
                    </div>
                </div>
            }
        </div>

        @* Columnas fijas (freeze) *@
        <div class="cd-dd">
            <button class="cd-tbtn @(_frozen > 0 ? "on" : "")" @onclick="@(() => ToggleMenu("freeze"))" title="Fijar columnas a la izquierda al desplazar en horizontal">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v6H4zM4 10v10M9 10v10"/></svg>
                <span>Columnas fijas@(_frozen > 0 ? $" ({_frozen})" : "")</span>
            </button>
            @if (_openMenu == "freeze")
            {
                <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
                <div class="cd-dd-panel">
                    <div class="cd-dd-title">Fijar desde la 1.a hasta...</div>
                    <button class="cd-dd-item @(_frozen == 0 ? "on" : "")" @onclick="() => SetFrozenAsync(0)">Ninguna (quitar fijas)</button>
                    <button class="cd-dd-item @(_frozen == 1 ? "on" : "")" @onclick="() => SetFrozenAsync(1)">Columna de seleccion</button>
                    @{ var vis = VisibleCols().ToList(); }
                    @for (int fi = 0; fi < vis.Count; fi++)
                    {
                        var n = fi + 2; // +1 por la columna de seleccion, +1 por indice->conteo
                        <button class="cd-dd-item @(_frozen == n ? "on" : "")" @onclick="() => SetFrozenAsync(n)">@LabelOf(vis[fi])</button>
                    }
                </div>
            }
        </div>

        @* Exportar a Excel: respeta filtro, columnas visibles, orden y agrupacion (con subtotales) ACTUALES *@
        <button class="cd-tbtn" @onclick="ExportExcelAsync" disabled="@_busy" title="Exporta a Excel respetando el filtro, las columnas y la agrupacion actuales (incluye subtotales y total general)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
            <span>Exportar Excel</span>
        </button>
        <button class="cd-tbtn" @onclick="AbrirConfigCamposAsync" disabled="@_busy" title="Agregar o editar columnas de campos a medida en la tabla">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            <span>Campos</span>
        </button>

        <div class="cd-toolbar-spacer"></div>
        @if (_groups.Count > 0)
        {
            <span class="cd-toolbar-hint">Agrupado por @string.Join(" > ", _groups.Select(g => LabelOf(g)))</span>
        }
    </div>

    <div class="cd-tabs">
        @foreach (var t in _tabs)
        {
            <button class="cd-tab @(t.Estado == _activeTab ? "on" : "")" @onclick="() => SetTabAsync(t.Estado)">
                @t.Label <span class="cd-badge">@(_counts.TryGetValue(t.Estado, out var c) ? c : 0)</span>
            </button>
        }
    </div>

    <div class="cd-grid-wrap">
        <table class="cd-grid">
            <thead>
                <tr>
                    <th class="cd-th-sel"><input type="checkbox" @onchange="OnSelectAll" checked="@_allSelected" /></th>
                    @foreach (var col in VisibleCols())
                    {
                        var c = col;
                        var sort = _sorts.FirstOrDefault(s => s.K == c.Key);
                        var arrow = sort is null ? "" : (sort.Dir >= 0 ? " ▲" : " ▼");
                        <th class="cd-th @(c.Num ? "num" : "")" draggable="true" data-col="@c.Key"
                            style="@(_widths.TryGetValue(c.Key, out var w) ? $"width:{w}px" : "")"
                            @ondragstart="() => _dragCol = c.Key"
                            @ondragover:preventDefault="true"
                            @ondrop="() => OnDropCol(c.Key)">
                            <span class="cd-th-lbl" @onclick="() => QuickSort(c.Key)">@LabelOf(c)@arrow</span>
                            <button class="cd-th-caret" @onclick="e => OpenColMenu(c, e)" @onclick:stopPropagation="true" title="Opciones de la columna">▾</button>
                            <span class="cd-rz" title="Arrastra para ajustar el ancho (doble clic: auto)"></span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_renglones.Count == 0)
                {
                    <tr><td colspan="@ColSpanAll" class="cd-empty-row">Sin renglones en esta pestana (con el filtro actual).</td></tr>
                }
                else
                {
                    @foreach (var it in _gridItems)
                    {
                        @if (it.Kind == GKind.Group)
                        {
                            <tr class="cd-grp @(it.Level > 0 ? "cd-grp2" : "")">
                                <td colspan="@ColSpanAll">
                                    <span class="cd-grp-lbl" style="padding-left:@(it.Level * 18)px">@it.Label</span>
                                    <span class="cd-grp-n">@it.Count reg.</span>
                                </td>
                            </tr>
                        }
                        else if (it.Kind == GKind.Subtotal)
                        {
                            <tr class="cd-sub @(it.Grand ? "cd-sub-grand" : "")">
                                <td class="cd-mark-cell"></td>
                                @{ var labelPut = false; }
                                @foreach (var c in VisibleCols())
                                {
                                    <td class="@(c.Num ? "num" : null)">
                                        @if (c.Num && it.Sums!.TryGetValue(c.Key, out var sv))
                                        {
                                            <strong>@Fmt(sv)</strong>
                                        }
                                        else if (!c.Num && !labelPut)
                                        {
                                            labelPut = true;
                                            <span class="cd-sub-lbl">@(it.Grand ? "TOTAL GENERAL" : "Subtotal") · @it.Count reg.</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        else
                        {
                            var r = it.R!;
                            <tr class="@(r.MarkerColor is null ? "" : "cd-marked")" @oncontextmenu="e => OpenColorMenu(r, e)" @oncontextmenu:preventDefault="true" title="Clic derecho para marcar con color">
                                <td class="cd-mark-cell" style="@(r.MarkerColor is {} mc ? $"border-left:5px solid {Hex(mc)}" : "border-left:5px solid transparent")">
                                    <input type="checkbox" checked="@r.Seleccionado" @onchange="e => OnSelChanged(r, e)" />
                                    @if (_cufesConArchivos.Contains(r.Cufe))
                                    {
                                        <button class="cd-files-btn" title="Ver documentos de la factura (DIAN / NEWTON)" @onclick="() => OpenFilesAsync(r)" @onclick:stopPropagation="true">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"/></svg>
                                        </button>
                                    }
                                </td>
                                @foreach (var col in VisibleCols())
                                {
                                    var c = col;
                                    <td class="@(c.Num ? "num" : null)">
                                        @switch (c.Key)
                                        {
                                            case "tipodoc": <text>@r.TipoDocDian</text> break;
                                            case "fecha": <text>@r.FechaEmision.ToString("dd/MM/yyyy")</text> break;
                                            case "proveedor": <text>@r.NombreProveedor</text> break;
                                            case "nit": <text>@r.NitProveedor</text> break;
                                            case "numprov": <span class="cd-pill info">@r.NumFacturaProveedor</span> break;
                                            case "numsol":
                                                if (r.NumFacturaSoldarco == "Inconsistencia!") { <span class="cd-pill danger">Inconsistencia!</span> }
                                                else if (!string.IsNullOrEmpty(r.NumFacturaSoldarco)) { <span class="cd-pill primary">@r.NumFacturaSoldarco</span> }
                                                else { <span class="cd-muted">-</span> }
                                                break;
                                            case "oc": <input class="cd-in cd-oc" value="@r.OrdenCompraSoldarco" @onchange="e => OnOcChanged(r, e)" /> break;
                                            case "sub_bruto": <text>@Fmt(r.SubtotalBruto)</text> break;
                                            case "descuento": <text>@Fmt(r.DescuentoComercial)</text> break;
                                            case "sub_neto": <text>@Fmt(r.SubtotalNeto)</text> break;
                                            case "iva": <text>@Fmt(r.IvaDescontable)</text> break;
                                            case "total_antes_ret": <text>@Fmt(r.TotalAntesRetenciones)</text> break;
                                            case "retefuente": <text>@Fmt(r.RetRetefuente)</text> break;
                                            case "ica": <text>@Fmt(r.RetIca)</text> break;
                                            case "total": <strong>@Fmt(r.TotalFactura)</strong> break;
                                            case "tipopago": <text>@r.TipoPago</text> break;
                                            case "plataforma": <text>@(r.PlataformaProveedor ? Si() : No())</text> break;
                                            case "aprobada": <label class="cd-switch"><input type="checkbox" checked="@r.FacturaAprobada" @onchange="e => OnAprobadaChanged(r, e)" /><span></span></label> break;
                                            case "rut": <text>@(string.IsNullOrWhiteSpace(r.RutEscaneado) ? "-" : r.RutEscaneado)</text> break;
                                            case "ev30": <text>@(r.Evento30 ? Check() : Dash())</text> break;
                                            case "ev32": <text>@(r.Evento32 ? Check() : Dash())</text> break;
                                            case "ev33": <text>@(r.Evento33 ? Check() : Dash())</text> break;
                                            case "ev31": <text>@(r.Evento31 ? Check() : Dash())</text> break;
                                            case "ev34": <text>@(r.Evento34 ? Check() : Dash())</text> break;
                                            default:
                                                @if (c.Key.StartsWith("dyn:") && _dynByKey.TryGetValue(c.Key, out var dd))
                                                {
                                                    var val = DynVal(r.Id, dd.Id);
                                                    if (dd.Type == "Bool")
                                                    {
                                                        <label class="cd-switch"><input type="checkbox" checked="@(ConciliacionRuleEngine.IsTrue(val))" @onchange="e => SetDynBool(r, dd, e)" /><span></span></label>
                                                    }
                                                    else if (dd.Type == "Select")
                                                    {
                                                        <select class="cd-in cd-dyn" @onchange="e => SetDynValue(r, dd, e)">
                                                            <option value="" selected="@string.IsNullOrEmpty(val)"></option>
                                                            @foreach (var op in dd.Options) { <option value="@op" selected="@(op == val)">@op</option> }
                                                        </select>
                                                    }
                                                    else if (dd.Type == "Number")
                                                    {
                                                        <input class="cd-in cd-dyn num" type="number" value="@val" @onchange="e => SetDynValue(r, dd, e)" />
                                                    }
                                                    else if (dd.Type == "Date")
                                                    {
                                                        <input class="cd-in cd-dyn" type="date" value="@val" @onchange="e => SetDynValue(r, dd, e)" />
                                                    }
                                                    else
                                                    {
                                                        <input class="cd-in cd-dyn" value="@val" @onchange="e => SetDynValue(r, dd, e)" />
                                                    }
                                                }
                                                break;
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_colMenuOpen && _colMenuCol is not null)
    {
        <div class="cd-ctx-overlay" @onclick="CloseColMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="cd-ctx-menu" style="left:@(Px(_colMenuX)); top:@(Px(_colMenuY));">
            <div class="cd-ctx-title">@LabelOf(_colMenuCol)</div>
            @if (_labelEditKey == _colMenuCol.Key)
            {
                <div class="cd-ctx-labeledit">
                    <input class="cd-in" value="@_labelEditVal" @onchange="e => _labelEditVal = e.Value?.ToString() ?? string.Empty" @onkeydown="OnLabelKey" placeholder="Etiqueta a mostrar" />
                    <div class="cd-ctx-labeledit-acts">
                        <button class="btn btn-primary btn-sm" @onclick="GuardarEtiqueta">Guardar</button>
                        <button class="btn btn-link btn-sm" @onclick="() => ResetEtiqueta(_colMenuCol!.Key)">Restablecer</button>
                    </div>
                </div>
            }
            else
            {
                <button class="cd-ctx-item" @onclick="() => SetSingleSort(_colMenuCol.Key, 1)">Ordenar A → Z</button>
                <button class="cd-ctx-item" @onclick="() => SetSingleSort(_colMenuCol.Key, -1)">Ordenar Z → A</button>
                @if (_colMenuCol.Groupable)
                {
                    @if (_groups.Contains(_colMenuCol.Key))
                    {
                        <button class="cd-ctx-item" @onclick="() => RemoveGroupKey(_colMenuCol.Key)">Quitar agrupacion</button>
                    }
                    else
                    {
                        <button class="cd-ctx-item" @onclick="() => AddGroupKey(_colMenuCol.Key)">Agrupar por este campo</button>
                    }
                }
                <button class="cd-ctx-item" @onclick="() => FijarHastaAsync(_colMenuCol.Key)">Fijar hasta esta columna</button>
                <div class="cd-ctx-sep"></div>
                <button class="cd-ctx-item" @onclick="() => EditarEtiqueta(_colMenuCol)">&#9998; Editar etiqueta</button>
                <button class="cd-ctx-item" @onclick="() => HideColFromMenu(_colMenuCol.Key)">Ocultar columna</button>
            }
        </div>
    }

    @if (_menuOpen)
    {
        <div class="cd-ctx-overlay" @onclick="CloseColorMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="cd-ctx-menu" style="left:@(Px(_menuX)); top:@(Px(_menuY));">
            <div class="cd-ctx-title">Marcar fila</div>
            <div class="cd-ctx-swatches">
                @foreach (var p in _palette)
                {
                    <button type="button" class="cd-swatch" title="@p.Label" style="background:@p.Hex"
                            @onclick="() => SetColorAsync(p.Token)"></button>
                }
            </div>
            <button type="button" class="cd-ctx-clear" @onclick="() => SetColorAsync(null)">Sin color</button>
        </div>
    }

    @if (_showEnviarConfirm && _envioPreview is { } prev)
    {
        <div class="cd-confirm-backdrop" @onclick="CancelarEnvio"></div>
        <div class="cd-confirm" @onclick:stopPropagation="true">
            <div class="cd-confirm-head">Radicar eventos en NEWTON</div>
            <div class="cd-confirm-body">
                <p class="cd-confirm-warn">⚠️ Esto radica eventos RADIAN ante la DIAN. <strong>Es irreversible.</strong></p>
                <p>Se enviaran <strong>@prev.EventosEnviados evento(s)</strong> en <strong>@prev.FacturasElegibles factura(s)</strong> aprobada(s) con plataforma (secuencia ACUSE &rarr; RECIBO &rarr; ACEPTACION, solo los que falten).</p>
                @if (prev.SinEventId > 0) { <p class="cd-muted">@prev.SinEventId sin EventId de NEWTON se omiten (corre la ingesta).</p> }
            </div>
            <div class="cd-confirm-acts">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarEnvio" disabled="@_busy">Cancelar</button>
                <button class="btn btn-danger btn-sm" @onclick="ConfirmarEnvioAsync" disabled="@_busy">Enviar de verdad (irreversible)</button>
            </div>
        </div>
    }

    @if (_filesOpen && _filesRenglon is { } fr)
    {
        <div class="cd-doc-backdrop" @onclick="CloseFiles"></div>
        <div class="cd-doc-modal" @onclick:stopPropagation="true">
            <div class="cd-doc-head">
                <div class="cd-doc-title">
                    <div class="cd-doc-title-main">Documentos de la factura</div>
                    <div class="cd-doc-title-sub">@fr.NombreProveedor &middot; Fact. @fr.NumFacturaProveedor &middot; CUFE @(fr.Cufe.Length > 24 ? fr.Cufe[..24] + "…" : fr.Cufe)</div>
                </div>
                <button class="cd-doc-close" title="Cerrar" @onclick="CloseFiles">&times;</button>
            </div>
            <div class="cd-doc-body">
                @if (_filesLoading)
                {
                    <div class="cd-muted" style="padding:24px;">Cargando…</div>
                }
                else if (_filesList.Count == 0)
                {
                    <div class="cd-muted" style="padding:24px;">No hay archivos para este CUFE todavia. Corre la ingesta / "Procesar" con la opcion "Subir al blob".</div>
                }
                else
                {
                    <div class="cd-doc-list">
                        @foreach (var f in _filesList)
                        {
                            <div class="cd-doc-thumb @(_filesSelected?.Id == f.Id ? "sel" : "")" @key="f.Id" @onclick="() => SelectFile(f)" title="@f.FileName">
                                <div class="cd-doc-thumb-box">
                                    <iframe src="@f.Url" tabindex="-1" scrolling="no"></iframe>
                                    <div class="cd-doc-thumb-ovl"></div>
                                </div>
                                <div class="cd-doc-thumb-meta">
                                    <span class="cd-file-tag @TagClass(f.Ref2)">@TagArchivo(f.Ref2)</span>
                                    <span class="cd-file-size">@FmtSize(f.SizeBytes)</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="cd-doc-viewer">
                        @if (_filesSelected is { } sel)
                        {
                            <div class="cd-doc-viewer-bar">
                                <span class="cd-file-tag @TagClass(sel.Ref2)">@TagArchivo(sel.Ref2)</span>
                                <span class="cd-doc-viewer-name" title="@sel.FileName">@sel.FileName</span>
                                <span class="cd-file-size">@FmtSize(sel.SizeBytes)</span>
                                <a class="cd-doc-viewer-open" href="@sel.Url" target="_blank" rel="noopener" title="Abrir en pestana nueva">Abrir &#8599;</a>
                            </div>
                            <iframe class="cd-doc-frame" src="@sel.Url" @key="sel.Id"></iframe>
                        }
                        else
                        {
                            <div class="cd-muted" style="padding:24px;">Selecciona un documento de la izquierda.</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (_filterOpen)
    {
        <div class="cd-doc-backdrop" @onclick="CloseFilterBuilder"></div>
        <div class="cd-fb-modal" @onclick:stopPropagation="true">
            <div class="cd-doc-head">
                <div class="cd-doc-title">
                    <div class="cd-doc-title-main">Constructor de filtros</div>
                    <div class="cd-doc-title-sub">Combina condiciones con Y / O. Puedes anidar grupos. Se aplica en vivo.</div>
                </div>
                <button class="cd-doc-close" title="Cerrar" @onclick="CloseFilterBuilder">&times;</button>
            </div>
            <div class="cd-fb-body">
                <ConciliacionFilterGroup Group="_filterRoot" Depth="0" ExtraFields="FilterExtraFields()" OnChanged="OnFilterChanged" />
            </div>
            <div class="cd-fb-foot">
                <button class="btn btn-link btn-sm" @onclick="ClearFilterTree" title="Quita todas las condiciones">Vaciar</button>
                <div class="cd-fb-foot-spacer"></div>
                <input class="cd-in" style="width:200px;" placeholder="Nombre para guardar" @bind="_saveName" @bind:event="oninput" />
                <button class="btn btn-outline-secondary btn-sm" @onclick="SaveFilterAsync" disabled="@(string.IsNullOrWhiteSpace(_saveName) || FilterCount == 0)" title="Guarda este filtro para todo el equipo">Guardar</button>
                <button class="btn btn-primary btn-sm" @onclick="CloseFilterBuilder">Aplicar y cerrar</button>
            </div>
        </div>
    }

    @if (_reglasOpen && _reglasResult is { } rr)
    {
        <div class="cd-confirm-backdrop" @onclick="CerrarReglas"></div>
        <div class="cd-confirm" style="max-width:760px;" @onclick:stopPropagation="true">
            <div class="cd-confirm-head">@(rr.Simulado ? "Aplicar reglas · simulacion" : "Reglas aplicadas")</div>
            <div class="cd-confirm-body">
                @if (rr.Error is { } err)
                {
                    <div class="cd-confirm-warn">@err</div>
                }
                else
                {
                    <div class="cd-reglas-kpis">
                        <span><b>@rr.Renglones</b> renglones</span>
                        <span><b>@rr.Encontrados</b> encontrados</span>
                        <span><b>@rr.Aprobados</b> aprobados</span>
                        <span><b>@rr.Cambiados</b> con cambios</span>
                    </div>
                    @if (rr.Muestra.Count > 0)
                    {
                        <div class="cd-reglas-prev">
                            <table>
                                <thead><tr><th>Fact. Prov.</th><th>Proveedor</th><th>N&deg; SISTEMA</th><th>Aprob.</th></tr></thead>
                                <tbody>
                                    @foreach (var p in rr.Muestra)
                                    {
                                        <tr>
                                            <td>@p.NumFacturaProveedor</td>
                                            <td class="cd-reglas-prov" title="@p.Proveedor">@p.Proveedor</td>
                                            <td>@(string.IsNullOrEmpty(p.NumSoldarcoDespues) ? "(vacio)" : p.NumSoldarcoDespues)@(p.NumSoldarcoAntes != p.NumSoldarcoDespues ? $"  (antes: {(string.IsNullOrEmpty(p.NumSoldarcoAntes) ? "vacio" : p.NumSoldarcoAntes)})" : "")</td>
                                            <td>@(p.AprobadaDespues ? "Si" : "No")@(p.AprobadaAntes != p.AprobadaDespues ? (p.AprobadaDespues ? " (nueva)" : " (quitada)") : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (rr.Cambiados > rr.Muestra.Count) { <div class="cd-muted" style="margin-top:6px;">&hellip; y @(rr.Cambiados - rr.Muestra.Count) renglon(es) mas con cambios.</div> }
                        </div>
                    }
                    else
                    {
                        <div class="cd-muted">Ningun renglon cambiaria con las reglas actuales.</div>
                    }
                    @if (rr.Simulado && rr.Cambiados > 0)
                    {
                        <div class="cd-muted" style="margin-top:10px;">Esto es una <b>simulacion</b>: nada se escribio todavia.</div>
                    }
                }
            </div>
            <div class="cd-confirm-acts">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarReglas">Cerrar</button>
                @if (rr.Simulado && rr.Error is null && rr.Cambiados > 0)
                {
                    <button class="btn btn-primary btn-sm" @onclick="AplicarReglasConfirmarAsync" disabled="@_busy">Aplicar de verdad (@rr.Cambiados)</button>
                }
            </div>
        </div>
    }

    @if (_reglasConfigOpen)
    {
        <div class="cd-doc-backdrop" @onclick="CerrarConfigReglas"></div>
        <div class="cd-rules-modal" @onclick:stopPropagation="true">
            <div class="cd-doc-head">
                <div class="cd-doc-title">
                    <div class="cd-doc-title-main">Reglas de conciliacion</div>
                    <div class="cd-doc-title-sub">Se aplican EN ORDEN sobre cada factura; cada regla puede reusar el campo que calculo la anterior.</div>
                </div>
                <button class="cd-doc-close" title="Cerrar" @onclick="CerrarConfigReglas">&times;</button>
            </div>
            <div class="cd-rules-body">
                <div class="cd-rules-tb">
                    <button class="cd-fb-add" @onclick="AddLookupAsync">+ Busqueda (VLOOKUP)</button>
                    <button class="cd-fb-add" @onclick="AddConditionAsync">+ Condicion (SI)</button>
                </div>
                @if (_ruleList.Count == 0)
                {
                    <div class="cd-muted" style="padding:12px 2px;">Sin reglas todavia. Agrega una busqueda o una condicion.</div>
                }
                @for (var i = 0; i < _ruleList.Count; i++)
                {
                    var idx = i; var ru = _ruleList[idx];
                    <div class="cd-rule-card">
                        <div class="cd-rule-head">
                            <span class="cd-rule-ord">@(idx + 1)</span>
                            <input type="checkbox" checked="@ru.Enabled" @onchange="e => ToggleEnabled(ru, e)" title="Activa" />
                            <input class="cd-in cd-rule-name" value="@ru.Name" @onchange="e => SetName(ru, e)" placeholder="Nombre de la regla" />
                            <span class="cd-rule-badge @(ru.Kind == "Lookup" ? "lk" : "cn")">@(ru.Kind == "Lookup" ? "VLOOKUP" : "SI")</span>
                            <div class="cd-rule-actions">
                                <button class="cd-ic" @onclick="() => MoveRuleAsync(idx, -1)" disabled="@(idx == 0)" title="Subir">&#8593;</button>
                                <button class="cd-ic" @onclick="() => MoveRuleAsync(idx, 1)" disabled="@(idx == _ruleList.Count - 1)" title="Bajar">&#8595;</button>
                                <button class="cd-ic-save @(ru.Dirty ? "on" : "")" @onclick="() => GuardarRuleAsync(ru)" disabled="@(!ru.Dirty)" title="Guardar cambios">Guardar</button>
                                <button class="cd-ic cd-ic-del" @onclick="() => BorrarRuleAsync(ru)" title="Eliminar">&times;</button>
                            </div>
                        </div>

                        @if (ru.Kind == "Lookup" && ru.Lookup is { } L)
                        {
                            var cols = ColsDe(L.ContainerId);
                            <div class="cd-rule-grid">
                                <div class="cd-rule-row">
                                    <label class="cd-rule-lbl">Contenedor</label>
                                    <select class="cd-in" style="flex:1" @onchange="e => SetContenedor(ru, e)">
                                        <option value="">(elegir contenedor)...</option>
                                        @foreach (var c in _contenedores)
                                        {
                                            <option value="@c.ContainerId" selected="@(c.ContainerId == L.ContainerId)">@c.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="cd-rule-sub">Buscar donde (todas se cumplen):</div>
                                @foreach (var m in L.Matches.ToList())
                                {
                                    var mm = m;
                                    <div class="cd-rule-row">
                                        <select class="cd-in" @onchange="e => SetMatchColumn(ru, mm, e)">
                                            <option value="">columna del contenedor...</option>
                                            @foreach (var col in cols) { <option value="@col" selected="@(col == mm.Column)">@col</option> }
                                        </select>
                                        <span class="cd-rule-eq">=</span>
                                        <select class="cd-in" @onchange="e => SetMatchSource(ru, mm, e)">
                                            <option value="">campo de la factura...</option>
                                            @foreach (var f in RuleFieldsForEditor()) { <option value="@f.Key" selected="@(f.Key == mm.SourceField)">@f.Label</option> }
                                        </select>
                                        <button class="cd-ic cd-ic-del" @onclick="() => RemoveMatch(ru, mm)" title="Quitar">&times;</button>
                                    </div>
                                }
                                <button class="cd-fb-add" @onclick="() => AddMatch(ru)">+ Condicion de busqueda</button>
                                <div class="cd-rule-row">
                                    <label class="cd-rule-lbl">Devolver columna</label>
                                    <select class="cd-in" @onchange="e => SetReturnColumn(ru, e)">
                                        <option value="">...</option>
                                        @foreach (var col in cols) { <option value="@col" selected="@(col == L.ReturnColumn)">@col</option> }
                                    </select>
                                    <label class="cd-rule-lbl">Escribir en</label>
                                    <select class="cd-in" @onchange="e => SetTargetField(ru, e)">
                                        <option value="">...</option>
                                        @foreach (var f in RuleFieldsForEditor().Where(x => x.Writable)) { <option value="@f.Key" selected="@(f.Key == L.TargetField)">@f.Label</option> }
                                    </select>
                                </div>
                                <div class="cd-rule-row cd-rule-norm">
                                    <span>Normalizar:</span>
                                    <label><input type="checkbox" checked="@L.Norm.Trim" @onchange="e => SetNorm(ru, 't', e)" /> espacios</label>
                                    <label><input type="checkbox" checked="@L.Norm.Upper" @onchange="e => SetNorm(ru, 'u', e)" /> mayusculas</label>
                                    <label><input type="checkbox" checked="@L.Norm.StripLeadingZeros" @onchange="e => SetNorm(ru, 'z', e)" /> quitar ceros</label>
                                    <label><input type="checkbox" checked="@L.Norm.DigitsOnly" @onchange="e => SetNorm(ru, 'd', e)" /> solo digitos</label>
                                </div>
                            </div>
                        }
                        else if (ru.Condition is { } C)
                        {
                            <div class="cd-rule-grid">
                                <div class="cd-rule-sub">
                                    Cuando
                                    <span class="cd-fb-opsw" style="margin-left:8px;">
                                        <button class="cd-fb-op @(C.When.Op == "and" ? "on" : "")" @onclick='() => SetGroupOp(ru, "and")'>Y (todas)</button>
                                        <button class="cd-fb-op @(C.When.Op == "or" ? "on" : "")" @onclick='() => SetGroupOp(ru, "or")'>O (alguna)</button>
                                    </span>
                                </div>
                                @foreach (var cond in C.When.Children.ToList())
                                {
                                    var cc = cond; var fld = RuleFieldByKey(cc.Field);
                                    <div class="cd-rule-row">
                                        <select class="cd-in" @onchange="e => SetCondField(ru, cc, e)">
                                            <option value="">campo...</option>
                                            @foreach (var f in RuleFieldsForEditor()) { <option value="@f.Key" selected="@(f.Key == cc.Field)">@f.Label</option> }
                                        </select>
                                        @if (fld is { } ff)
                                        {
                                            <select class="cd-in" @onchange="e => SetCondOp(ru, cc, e)">
                                                <option value="">operador...</option>
                                                @foreach (var op in ConciliacionRuleFields.OperatorsFor(ff.Type)) { <option value="@op.Key" selected="@(op.Key == cc.Operator)">@op.Label</option> }
                                            </select>
                                            @if (ConciliacionRuleFields.OperatorNeedsValue(cc.Operator))
                                            {
                                                <input class="cd-in" placeholder="valor" value="@cc.Value" @onchange="e => SetCondValue(ru, cc, e)" />
                                            }
                                        }
                                        <button class="cd-ic cd-ic-del" @onclick="() => RemoveCond(ru, cc)" title="Quitar">&times;</button>
                                    </div>
                                }
                                <button class="cd-fb-add" @onclick="() => AddCond(ru)">+ Condicion</button>
                                <div class="cd-rule-sub">Entonces asignar:</div>
                                @foreach (var a in C.Then.ToList())
                                {
                                    var aa = a;
                                    <div class="cd-rule-row">
                                        <select class="cd-in" @onchange="e => SetAssignField(ru, aa, e)">
                                            <option value="">campo...</option>
                                            @foreach (var f in RuleFieldsForEditor().Where(x => x.Writable)) { <option value="@f.Key" selected="@(f.Key == aa.Field)">@f.Label</option> }
                                        </select>
                                        <span class="cd-rule-eq">=</span>
                                        <input class="cd-in" placeholder="valor (ej. true, o {otroCampo})" value="@aa.Value" @onchange="e => SetAssignValue(ru, aa, e)" />
                                        <button class="cd-ic cd-ic-del" @onclick="() => RemoveAssign(ru, aa)" title="Quitar">&times;</button>
                                    </div>
                                }
                                <button class="cd-fb-add" @onclick="() => AddAssign(ru)">+ Asignacion</button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="cd-rules-foot">
                <span class="cd-muted">Guarda cada regla; "Aplicar reglas" las corre en este orden.</span>
                <div style="flex:1"></div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarConfigReglas">Cerrar</button>
            </div>
        </div>
    }

    @if (_fieldsConfigOpen)
    {
        <div class="cd-doc-backdrop" @onclick="CerrarConfigCampos"></div>
        <div class="cd-rules-modal" style="width:min(720px,96vw);height:min(720px,88vh);" @onclick:stopPropagation="true">
            <div class="cd-doc-head">
                <div class="cd-doc-title">
                    <div class="cd-doc-title-main">Campos de la tabla</div>
                    <div class="cd-doc-title-sub">Columnas a medida que se agregan a la tabla de conciliacion (editables por factura).</div>
                </div>
                <button class="cd-doc-close" title="Cerrar" @onclick="CerrarConfigCampos">&times;</button>
            </div>
            <div class="cd-rules-body">
                <div class="cd-rules-tb"><button class="cd-fb-add" @onclick="AddCampoAsync">+ Campo</button></div>
                @if (_fieldEditList.Count == 0)
                {
                    <div class="cd-muted" style="padding:12px 2px;">Sin campos a medida. Agrega el primero.</div>
                }
                @for (var i = 0; i < _fieldEditList.Count; i++)
                {
                    var idx = i; var fe = _fieldEditList[idx];
                    <div class="cd-rule-card">
                        <div class="cd-rule-head">
                            <span class="cd-rule-ord">@(idx + 1)</span>
                            <input class="cd-in cd-rule-name" value="@fe.Label" @onchange="e => SetCampoLabel(fe, e)" placeholder="Etiqueta de la columna" />
                            <select class="cd-in" style="width:130px;" @onchange="e => SetCampoType(fe, e)">
                                @foreach (var t in _tiposCampo)
                                {
                                    <option value="@t.Key" selected="@(t.Key == fe.Type)">@t.Label</option>
                                }
                            </select>
                            <div class="cd-rule-actions">
                                <button class="cd-ic" @onclick="() => MoveCampoAsync(idx, -1)" disabled="@(idx == 0)" title="Subir">&#8593;</button>
                                <button class="cd-ic" @onclick="() => MoveCampoAsync(idx, 1)" disabled="@(idx == _fieldEditList.Count - 1)" title="Bajar">&#8595;</button>
                                <button class="cd-ic-save @(fe.Dirty ? "on" : "")" @onclick="() => GuardarCampoAsync(fe)" disabled="@(!fe.Dirty)" title="Guardar">Guardar</button>
                                <button class="cd-ic cd-ic-del" @onclick="() => BorrarCampoAsync(fe)" title="Eliminar">&times;</button>
                            </div>
                        </div>
                        @if (fe.Type == "Select")
                        {
                            <div class="cd-rule-grid">
                                <div class="cd-rule-row">
                                    <label class="cd-rule-lbl">Opciones (separadas por coma)</label>
                                    <input class="cd-in" style="flex:1" value="@fe.OptionsText" @onchange="e => SetCampoOptions(fe, e)" placeholder="Ej: Alta, Media, Baja" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="cd-rules-foot">
                <span class="cd-muted">Los campos aparecen como columnas al final de la tabla.</span>
                <div style="flex:1"></div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarConfigCampos">Cerrar</button>
            </div>
        </div>
    }
}

@code {
    private bool _busy;
    private string? _msg;

    private List<ConciliacionDianDocumentoDto> _docs = new();
