    // Asignar usuario a la fila. No recargamos (no cambia la pestana): persistimos y refrescamos solo la fila
    // para que el <select> (con @key ligado al asignado) refleje el valor elegido.
    private async Task OnAssigneeChanged(ConciliacionDianRenglonDto r, ChangeEventArgs e)
    {
        Guid? uid = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        await Svc.SetAssigneeAsync(r.Id, uid);
        var i = _renglones.FindIndex(x => x.Id == r.Id);
        if (i >= 0) { _renglones[i] = _renglones[i] with { AssignedTenantUserId = uid }; }
        RebuildItems();   // refresca la grilla para que el boton "+ Tarea" refleje el usuario asignado
    }

