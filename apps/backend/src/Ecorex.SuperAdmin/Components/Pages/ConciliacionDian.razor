        if (saved is not null) { fe.Id = saved.Id; fe.FieldKey = saved.FieldKey; fe.Dirty = false; await RefreshDynAsync(); }
    }

    private async Task BorrarCampoAsync(FieldEdit fe)
    {
        await Fields.DeleteDefAsync(fe.Id);
        _fieldEditList.Remove(fe);
        if (_selFieldId == fe.Id) { _selFieldId = _fieldEditList.FirstOrDefault()?.Id ?? Guid.Empty; }
        for (var k = 0; k < _fieldEditList.Count; k++) { _fieldEditList[k].SortOrder = k; }
        await Fields.ReorderDefsAsync(_fieldEditList.Select(x => x.Id).ToList());
        await RefreshDynAsync();
    }

    private async Task MoveCampoAsync(int idx, int dir)
    {
        var tgt = idx + dir;
        if (tgt < 0 || tgt >= _fieldEditList.Count) { return; }
        (_fieldEditList[idx], _fieldEditList[tgt]) = (_fieldEditList[tgt], _fieldEditList[idx]);
        for (var k = 0; k < _fieldEditList.Count; k++) { _fieldEditList[k].SortOrder = k; }
        await Fields.ReorderDefsAsync(_fieldEditList.Select(x => x.Id).ToList());
        await RefreshDynAsync();
    }

