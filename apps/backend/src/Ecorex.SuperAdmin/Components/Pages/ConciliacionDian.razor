    // Lookup handlers
    private void SetContenedor(RuleEdit ru, ChangeEventArgs e)
    {
        if (ru.Lookup is not { } L) { return; }
        if (Guid.TryParse(e.Value?.ToString(), out var cid)) { L.ContainerId = cid; L.ContainerLabel = _contenedores.FirstOrDefault(c => c.ContainerId == cid)?.Label ?? ""; }
        else { L.ContainerId = Guid.Empty; L.ContainerLabel = ""; }
        DirtyRu(ru);
    }
    private void SetMatchColumn(RuleEdit ru, RuleLookupMatch m, ChangeEventArgs e) { m.Column = e.Value?.ToString() ?? ""; DirtyRu(ru); }
    private void SetMatchSource(RuleEdit ru, RuleLookupMatch m, ChangeEventArgs e) { m.SourceField = e.Value?.ToString() ?? ""; DirtyRu(ru); }
    private void AddMatch(RuleEdit ru) { ru.Lookup?.Matches.Add(new RuleLookupMatch()); DirtyRu(ru); }
    private void RemoveMatch(RuleEdit ru, RuleLookupMatch m) { ru.Lookup?.Matches.Remove(m); DirtyRu(ru); }
    private void SetReturnColumn(RuleEdit ru, ChangeEventArgs e) { if (ru.Lookup is { } L) { L.ReturnColumn = e.Value?.ToString() ?? ""; } DirtyRu(ru); }
    private void SetTargetField(RuleEdit ru, ChangeEventArgs e) { if (ru.Lookup is { } L) { L.TargetField = e.Value?.ToString() ?? ""; } DirtyRu(ru); }
    private void SetNorm(RuleEdit ru, char which, ChangeEventArgs e)
    {
        if (ru.Lookup is not { } L) { return; }
        var v = e.Value is bool b && b;
        switch (which) { case 't': L.Norm.Trim = v; break; case 'u': L.Norm.Upper = v; break; case 'z': L.Norm.StripLeadingZeros = v; break; case 'd': L.Norm.DigitsOnly = v; break; }
        DirtyRu(ru);
    }

    // Condition handlers
    private void SetGroupOp(RuleEdit ru, string op) { if (ru.Condition is { } C) { C.When.Op = op; } DirtyRu(ru); }
    private void SetCondField(RuleEdit ru, RuleCond c, ChangeEventArgs e) { c.Field = e.Value?.ToString() ?? ""; c.Operator = ""; c.Value = null; DirtyRu(ru); }
    private void SetCondOp(RuleEdit ru, RuleCond c, ChangeEventArgs e) { c.Operator = e.Value?.ToString() ?? ""; if (!ConciliacionRuleFields.OperatorNeedsValue(c.Operator)) { c.Value = null; } DirtyRu(ru); }
    private void SetCondValue(RuleEdit ru, RuleCond c, ChangeEventArgs e) { c.Value = e.Value?.ToString(); DirtyRu(ru); }
    private void AddCond(RuleEdit ru) { ru.Condition?.When.Children.Add(new RuleCond { Kind = "cond" }); DirtyRu(ru); }
    private void RemoveCond(RuleEdit ru, RuleCond c) { ru.Condition?.When.Children.Remove(c); DirtyRu(ru); }
    private void SetAssignField(RuleEdit ru, RuleAssign a, ChangeEventArgs e) { a.Field = e.Value?.ToString() ?? ""; DirtyRu(ru); }
    private void SetAssignValue(RuleEdit ru, RuleAssign a, ChangeEventArgs e) { a.Value = e.Value?.ToString() ?? ""; DirtyRu(ru); }
    private void AddAssign(RuleEdit ru) { ru.Condition?.Then.Add(new RuleAssign()); DirtyRu(ru); }
    private void RemoveAssign(RuleEdit ru, RuleAssign a) { ru.Condition?.Then.Remove(a); DirtyRu(ru); }

