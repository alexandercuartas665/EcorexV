    private string? _labelEditKey;
    private string _labelEditVal = "";
    private void EditarEtiqueta(GridCol c) { _labelEditKey = c.Key; _labelEditVal = LabelOf(c); }
    private void GuardarEtiqueta()
    {
        if (_labelEditKey is { } k)
        {
            var v = (_labelEditVal ?? "").Trim();
            var def = ColByKey(k)?.Label ?? k;
            if (string.IsNullOrEmpty(v) || v == def) { _labels.Remove(k); } else { _labels[k] = v; }
            _ = SavePrefsAsync();
        }
        _labelEditKey = null; CloseColMenu();
    }
    private void ResetEtiqueta(string key) { _labels.Remove(key); _labelEditKey = null; _ = SavePrefsAsync(); CloseColMenu(); }
    private void OnLabelKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") { GuardarEtiqueta(); } }
    private void ShowAllCols() { _hidden.Clear(); _ = SavePrefsAsync(); }
    private void ResetCols() { _order = _allCols.Select(c => c.Key).ToList(); _hidden.Clear(); _widths.Clear(); _ = SavePrefsAsync(); }

    // ---- Menu contextual de columna (caret del header) ----
    private bool _colMenuOpen;
    private double _colMenuX, _colMenuY;
    private GridCol? _colMenuCol;
    private void OpenColMenu(GridCol c, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _colMenuCol = c; _colMenuX = e.ClientX; _colMenuY = e.ClientY; _colMenuOpen = true; _openMenu = null;
    }
    private void CloseColMenu() { _colMenuOpen = false; _colMenuCol = null; }

    // ---- Columnas fijas ----
    private async Task SetFrozenAsync(int n)
    {
        _frozen = n; _openMenu = null;
        await SavePrefsAsync();
        await ApplyFreezeAsync();
    }
    private async Task FijarHastaAsync(string key)
    {
        var vis = VisibleCols().ToList();
        var pos = vis.FindIndex(c => c.Key == key);
        CloseColMenu();
        if (pos < 0) { return; }
        _frozen = pos + 2; // +1 sel, +1 indice->conteo
        await SavePrefsAsync();
        await ApplyFreezeAsync();
    }
    private async Task ApplyFreezeAsync()
    {
        try { await JS.InvokeVoidAsync("ecorexCdCols.apply", _frozen); } catch { }
    }

    // ---- Redimensionar columnas (desde JS) ----
    private DotNetObjectReference<ConciliacionDian>? _selfRef;

    [JSInvokable]
    public async Task OnColumnResized(string key, int width)
    {
        if (width <= 0) { _widths.Remove(key); } else { _widths[key] = width; }
        await SavePrefsAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
        }
        // Reaplica freeze + rewire de resize tras cada render (las filas se regeneran).
        try
        {
            await JS.InvokeVoidAsync("ecorexCdCols.apply", _frozen);
            if (_selfRef is not null) { await JS.InvokeVoidAsync("ecorexCdCols.wireResize", _selfRef); }
        }
        catch { }
    }

    public ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    // ---- Marcador de color por fila (menu contextual, persistente) ----
    private bool _menuOpen;
    private double _menuX, _menuY;
    private ConciliacionDianRenglonDto? _menuRenglon;

    private static readonly (string Token, string Label, string Hex)[] _palette = new[]
    {
        ("green", "Verde", "#16a34a"), ("yellow", "Amarillo", "#eab308"), ("red", "Rojo", "#dc2626"),
        ("blue", "Azul", "#2563eb"), ("gray", "Gris", "#6b7280"), ("purple", "Morado", "#7c3aed"),
        ("orange", "Naranja", "#ea580c"),
    };
    private static string Hex(string token)
    {
        foreach (var p in _palette) { if (p.Token == token) { return p.Hex; } }
        return "transparent";
    }
    private static string Px(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture) + "px";

    private void OpenColorMenu(ConciliacionDianRenglonDto r, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _menuRenglon = r;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuOpen = true;
    }
    private void CloseColorMenu() { _menuOpen = false; _menuRenglon = null; }
    private async Task SetColorAsync(string? token)
    {
        if (_menuRenglon is null) { return; }
        var id = _menuRenglon.Id;
        CloseColorMenu();
        await Svc.SetMarkerColorAsync(id, token);
        await ReloadAsync();
    }

    private static string Fmt(decimal d) => d.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static MarkupString Si() => new("<span class=\"cd-pill ok\">Si</span>");
    private static MarkupString No() => new("<span class=\"cd-muted\">No</span>");
    private static MarkupString Check() => new("<span class=\"cd-ev ok\">&#10003;</span>");
    private static MarkupString Dash() => new("<span class=\"cd-muted\">-</span>");
}
