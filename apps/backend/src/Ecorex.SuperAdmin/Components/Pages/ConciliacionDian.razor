    // Exporta a Excel EXACTAMENTE la vista actual (_gridItems): columnas visibles en su orden, filtro,
    // ordenamiento y agrupacion con cabeceras de grupo + subtotales + TOTAL GENERAL.
    private async Task ExportExcelAsync()
    {
        if (_busy) { return; }
        _busy = true; _msg = null;
        try
        {
            var vis = VisibleCols().ToList();
            if (vis.Count == 0) { _msg = "No hay columnas visibles para exportar."; return; }
            var lblCol = vis.FindIndex(c => !c.Num); if (lblCol < 0) { lblCol = 0; } // etiqueta de subtotal en la 1a col no numerica

            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("Conciliacion DIAN");
            var rowN = 1;

            // Encabezado
            for (var i = 0; i < vis.Count; i++)
            {
                var cell = ws.Cell(rowN, i + 1);
                cell.Value = LabelOf(vis[i]);
                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#1F2937");
                cell.Style.Font.FontColor = XLColor.White;
                cell.Style.Alignment.Horizontal = vis[i].Num ? XLAlignmentHorizontalValues.Right : XLAlignmentHorizontalValues.Left;
            }
            ws.SheetView.FreezeRows(1);
            rowN++;

            foreach (var it in _gridItems)
            {
                if (it.Kind == GKind.Group)
                {
                    var cell = ws.Cell(rowN, 1);
                    cell.Value = it.Label ?? "";
                    ws.Range(rowN, 1, rowN, vis.Count).Merge();
                    cell.Style.Font.Bold = true;
                    cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#EEF2FF");
                    if (it.Level > 0) { cell.Style.Alignment.Indent = it.Level; }
                    rowN++;
                }
                else if (it.Kind == GKind.Data && it.R is { } r)
                {
                    for (var i = 0; i < vis.Count; i++)
                    {
                        var c = vis[i];
                        var cell = ws.Cell(rowN, i + 1);
                        if (_moneyKeys.Contains(c.Key)) { cell.Value = Money(c.Key, r); cell.Style.NumberFormat.Format = "#,##0.00"; }
                        else if (c.Key == "fecha") { cell.Value = r.FechaEmision.DateTime; cell.Style.DateFormat.Format = "dd/MM/yyyy"; }
                        else if (c.Key.StartsWith("dyn:") && _dynByKey.TryGetValue(c.Key, out var dde))
                        {
                            var dv = DynDisplay(r, dde);
                            if (dde.Type == "Number" && decimal.TryParse(dv, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var dn)) { cell.Value = dn; cell.Style.NumberFormat.Format = "#,##0.00"; }
                            else { cell.Value = dv; }
                        }
                        else { cell.Value = CellStr(c.Key, r); }
                    }
                    rowN++;
                }
                else if (it.Kind == GKind.Subtotal)
                {
                    for (var i = 0; i < vis.Count; i++)
                    {
                        var c = vis[i];
                        var cell = ws.Cell(rowN, i + 1);
                        if (c.Num && it.Sums is { } s && s.TryGetValue(c.Key, out var sv)) { cell.Value = sv; cell.Style.NumberFormat.Format = "#,##0.00"; }
                        cell.Style.Font.Bold = true;
                        cell.Style.Fill.BackgroundColor = it.Grand ? XLColor.FromHtml("#D1D5DB") : XLColor.FromHtml("#F3F4F6");
                    }
                    ws.Cell(rowN, lblCol + 1).Value = (it.Grand ? "TOTAL GENERAL" : "Subtotal") + " · " + it.Count + " reg.";
                    rowN++;
                }
            }

            ws.Columns().AdjustToContents();
            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var fname = $"Conciliacion_DIAN_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("ecorexDcCanvas.downloadBase64", fname, Convert.ToBase64String(ms.ToArray()),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex) { _msg = "Error al exportar a Excel: " + ex.Message; }
        finally { _busy = false; }
    }

    private sealed class ObjCmp : IComparer<object?>
    {
        public static readonly ObjCmp I = new();
        public int Compare(object? a, object? b)
        {
            if (a is decimal da && b is decimal db) { return da.CompareTo(db); }
            if (a is DateTimeOffset ta && b is DateTimeOffset tb) { return ta.CompareTo(tb); }
            return string.Compare(a?.ToString(), b?.ToString(), StringComparison.OrdinalIgnoreCase);
        }
    }

    private object SortKey(string key, ConciliacionDianRenglonDto r)
    {
        if (_moneyKeys.Contains(key)) { return Money(key, r); }
        if (key == "fecha") { return r.FechaEmision; }
        if (key.StartsWith("dyn:") && _dynByKey.TryGetValue(key, out var d) && d.Type == "Number")
        {
            return decimal.TryParse(DynVal(r.Id, d.Id), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0m;
        }
        return GroupText(key, r);
    }

    private IEnumerable<ConciliacionDianRenglonDto> Sorted(IEnumerable<ConciliacionDianRenglonDto> src)
    {
        if (_sorts.Count == 0) { return src; }
        IOrderedEnumerable<ConciliacionDianRenglonDto>? o = null;
        foreach (var s in _sorts)
        {
            var sc = s;
            Func<ConciliacionDianRenglonDto, object> ks = r => SortKey(sc.K, r);
            o = o is null
                ? (sc.Dir >= 0 ? src.OrderBy(ks, ObjCmp.I) : src.OrderByDescending(ks, ObjCmp.I))
                : (sc.Dir >= 0 ? o.ThenBy(ks, ObjCmp.I) : o.ThenByDescending(ks, ObjCmp.I));
        }
        return o!;
    }

    private static Dictionary<string, decimal> SumsOf(IEnumerable<ConciliacionDianRenglonDto> rows)
    {
        var d = new Dictionary<string, decimal>();
        var list = rows as IList<ConciliacionDianRenglonDto> ?? rows.ToList();
        foreach (var k in _moneyKeys) { d[k] = list.Sum(r => Money(k, r)); }
        return d;
    }

    private void BuildItems(List<ConciliacionDianRenglonDto> rows, int level, List<GridItem> outl)
    {
        if (level >= _groups.Count)
        {
            foreach (var r in Sorted(rows)) { outl.Add(new GridItem { Kind = GKind.Data, R = r }); }
            return;
        }
        var key = _groups[level];
        var label = LabelOf(key);
        var groups = rows.GroupBy(r => GroupText(key, r)).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
        foreach (var g in groups)
        {
            var glist = g.ToList();
            outl.Add(new GridItem { Kind = GKind.Group, Level = level, Label = $"{label}: {g.Key}", Count = glist.Count });
            BuildItems(glist, level + 1, outl);
            outl.Add(new GridItem { Kind = GKind.Subtotal, Level = level, Count = glist.Count, Sums = SumsOf(glist), Grand = false });
        }
    }

    private bool CufeTieneArchivos(string cufe) => _cufesConArchivos.Contains(cufe);

    private void RebuildItems()
    {
        // Filtro del constructor (cliente): se aplica sobre los renglones del tab antes de agrupar/sumar.
        var src = FilterCount > 0
            ? _renglones.Where(r => ConciliacionFilter.Evaluate(_filterRoot, r, CufeTieneArchivos, FilterExtraFields(), DynFilterValue)).ToList()
            : _renglones.ToList();
        var items = new List<GridItem>();
        BuildItems(src, 0, items);
        // Total general (cantidad + sumas) al pie, siempre (sobre lo filtrado).
        if (src.Count > 0)
        {
            items.Add(new GridItem { Kind = GKind.Subtotal, Count = src.Count, Sums = SumsOf(src), Grand = true });
        }
        _gridItems = items;
    }

