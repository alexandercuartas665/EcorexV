    private GridCol? ColByKey(string k) => _allCols.FirstOrDefault(c => c.Key == k);
    private IEnumerable<GridCol> VisibleCols() => _order.Select(ColByKey).Where(c => c is not null && !_hidden.Contains(c!.Key)).Select(c => c!);
    private int ColSpanAll => 1 + VisibleCols().Count();

    // ---- Items renderizables (grupos + filas + subtotales) ----
    private enum GKind { Group, Data, Subtotal }
    private sealed class GridItem
    {
        public GKind Kind;
        public int Level;
        public string? Label;
        public int Count;
        public ConciliacionDianRenglonDto? R;
        public Dictionary<string, decimal>? Sums;
        public bool Grand;
    }
    private List<GridItem> _gridItems = new();

    private static readonly string[] _moneyKeys =
        { "sub_bruto", "descuento", "sub_neto", "iva", "total_antes_ret", "retefuente", "ica", "total" };

    private static decimal Money(string key, ConciliacionDianRenglonDto r) => key switch
    {
        "sub_bruto" => r.SubtotalBruto,
        "descuento" => r.DescuentoComercial,
        "sub_neto" => r.SubtotalNeto,
        "iva" => r.IvaDescontable,
        "total_antes_ret" => r.TotalAntesRetenciones,
        "retefuente" => r.RetRetefuente,
        "ica" => r.RetIca,
        "total" => r.TotalFactura,
        _ => 0m,
    };

    private static string GroupText(string key, ConciliacionDianRenglonDto r)
    {
        var v = key switch
        {
            "tipodoc" => r.TipoDocDian,
            "fecha" => r.FechaEmision.ToString("dd/MM/yyyy"),
            "proveedor" => r.NombreProveedor,
            "nit" => r.NitProveedor,
            "numsol" => r.NumFacturaSoldarco,
            "oc" => r.OrdenCompraSoldarco,
            "tipopago" => r.TipoPago,
            "plataforma" => r.PlataformaProveedor ? "Si" : "No",
            "aprobada" => r.FacturaAprobada ? "Aprobada" : "Pendiente",
            "rut" => r.RutEscaneado ?? "",
            "ev30" => r.Evento30 ? "Si" : "No",
            "ev32" => r.Evento32 ? "Si" : "No",
            "ev33" => r.Evento33 ? "Si" : "No",
            "ev31" => r.Evento31 ? "Si" : "No",
            "ev34" => r.Evento34 ? "Si" : "No",
            _ => "",
        };
        return string.IsNullOrWhiteSpace(v) ? "(sin dato)" : v;
    }

    private sealed class ObjCmp : IComparer<object?>
    {
        public static readonly ObjCmp I = new();
        public int Compare(object? a, object? b)
        {
            if (a is decimal da && b is decimal db) { return da.CompareTo(db); }
            if (a is DateTimeOffset ta && b is DateTimeOffset tb) { return ta.CompareTo(tb); }
            return string.Compare(a?.ToString(), b?.ToString(), StringComparison.OrdinalIgnoreCase);
        }
    }

    private static object SortKey(string key, ConciliacionDianRenglonDto r)
    {
        if (_moneyKeys.Contains(key)) { return Money(key, r); }
        if (key == "fecha") { return r.FechaEmision; }
        return GroupText(key, r);
    }

    private IEnumerable<ConciliacionDianRenglonDto> Sorted(IEnumerable<ConciliacionDianRenglonDto> src)
    {
        if (_sorts.Count == 0) { return src; }
        IOrderedEnumerable<ConciliacionDianRenglonDto>? o = null;
        foreach (var s in _sorts)
        {
            var sc = s;
            Func<ConciliacionDianRenglonDto, object> ks = r => SortKey(sc.K, r);
            o = o is null
                ? (sc.Dir >= 0 ? src.OrderBy(ks, ObjCmp.I) : src.OrderByDescending(ks, ObjCmp.I))
                : (sc.Dir >= 0 ? o.ThenBy(ks, ObjCmp.I) : o.ThenByDescending(ks, ObjCmp.I));
        }
        return o!;
    }

    private static Dictionary<string, decimal> SumsOf(IEnumerable<ConciliacionDianRenglonDto> rows)
    {
        var d = new Dictionary<string, decimal>();
        var list = rows as IList<ConciliacionDianRenglonDto> ?? rows.ToList();
        foreach (var k in _moneyKeys) { d[k] = list.Sum(r => Money(k, r)); }
        return d;
    }

    private void BuildItems(List<ConciliacionDianRenglonDto> rows, int level, List<GridItem> outl)
    {
        if (level >= _groups.Count)
        {
            foreach (var r in Sorted(rows)) { outl.Add(new GridItem { Kind = GKind.Data, R = r }); }
            return;
        }
        var key = _groups[level];
        var label = ColByKey(key)?.Label ?? key;
        var groups = rows.GroupBy(r => GroupText(key, r)).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
        foreach (var g in groups)
        {
            var glist = g.ToList();
            outl.Add(new GridItem { Kind = GKind.Group, Level = level, Label = $"{label}: {g.Key}", Count = glist.Count });
            BuildItems(glist, level + 1, outl);
            outl.Add(new GridItem { Kind = GKind.Subtotal, Level = level, Count = glist.Count, Sums = SumsOf(glist), Grand = false });
        }
    }

    private void RebuildItems()
    {
        var items = new List<GridItem>();
        BuildItems(_renglones.ToList(), 0, items);
        // Total general (cantidad + sumas) al pie, siempre.
        if (_renglones.Count > 0)
        {
            items.Add(new GridItem { Kind = GKind.Subtotal, Count = _renglones.Count, Sums = SumsOf(_renglones), Grand = true });
        }
        _gridItems = items;
    }

    // ---- Persistencia de preferencias (por usuario, en BD) ----
    private sealed class PrefsDto
    {
        public List<string>? order { get; set; }
        public List<string>? hidden { get; set; }
        public Dictionary<string, int>? widths { get; set; }
        public List<SortSpec>? sorts { get; set; }
        public List<string>? groups { get; set; }
        public int frozen { get; set; }
    }

    private async Task LoadPrefsAsync()
    {
        try
        {
            var json = await Prefs.GetAsync(TableKey);
            if (string.IsNullOrWhiteSpace(json)) { return; }
            var p = JsonSerializer.Deserialize<PrefsDto>(json);
            if (p is null) { return; }
            // Orden: respeta lo guardado, agrega al final las columnas nuevas, descarta claves desconocidas.
            var known = _allCols.Select(c => c.Key).ToHashSet();
            var ord = (p.order ?? new()).Where(known.Contains).Distinct().ToList();
            foreach (var k in _allCols.Select(c => c.Key)) { if (!ord.Contains(k)) { ord.Add(k); } }
            _order = ord;
            _hidden = (p.hidden ?? new()).Where(known.Contains).ToHashSet();
            _widths = (p.widths ?? new()).Where(kv => known.Contains(kv.Key)).ToDictionary(kv => kv.Key, kv => kv.Value);
            _sorts = (p.sorts ?? new()).Where(s => known.Contains(s.K)).ToList();
            _groups = (p.groups ?? new()).Where(k => known.Contains(k) && (ColByKey(k)?.Groupable ?? false)).ToList();
            _frozen = Math.Max(0, p.frozen);
        }
        catch { /* preferencias corruptas: se ignoran, se usa el default */ }
    }

    private async Task SavePrefsAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(new PrefsDto
            {
                order = _order,
                hidden = _hidden.ToList(),
                widths = _widths,
                sorts = _sorts,
                groups = _groups,
                frozen = _frozen,
            });
            await Prefs.SaveAsync(TableKey, json);
        }
        catch { /* no bloquear la UI por un fallo de guardado */ }
    }

