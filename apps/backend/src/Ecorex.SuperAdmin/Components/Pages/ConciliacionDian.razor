    // Regla del asistente por proveedor: proveedor (NIT o nombre) + prompt para elegir la ruta de flujo.
    private sealed class AsisReglaEdit { public Guid Id { get; set; } public string Proveedor { get; set; } = string.Empty; public string Prompt { get; set; } = string.Empty; public Guid? AssignUserId { get; set; } public Guid? SalidaId { get; set; } }
    private List<AsisReglaEdit> _asisReglas = new();

    // Un mapeo "Direccionar compra": campo del formulario -> columna del conciliador.
    private sealed class DireEdit { public string FormField { get; set; } = string.Empty; public string Target { get; set; } = string.Empty; }
    // Una salida al flujo en edicion: concepto (trae su flujo) + formulario + su propio Direccionar.
    private sealed class SalidaEdit
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public Guid? Sub { get; set; }
        public Guid? Form { get; set; }
        public bool DireEnabled { get; set; }
        public List<DireEdit> DireMaps { get; set; } = new();
        public List<FormFieldOptionDto> FormFields { get; set; } = new();   // campos del form elegido (para los mapeos)
    }
    private List<SalidaEdit> _salidas = new();          // editor del modal
    private List<SalidaFlujoDto> _salidasRun = new();   // runtime: lo que usa "+ Tarea" en la grilla (solo con concepto)

    // Selector de salida al crear la tarea (solo aparece con >1 salida; con una sola se dispara directo).
    private bool _pickSalidaOpen;
    private ConciliacionDianRenglonDto? _pickRow;

    // ---- Crear tarea desde la fila (cae en el flujo de la salida). Mapa renglon->numero compartido con
