@page "/conectar-ia"
@* ADR-0159: cada usuario emite su token PERSONAL para conectar una IA externa (Claude, Gemini, ChatGPT...)
   al servidor MCP de tableros. La IA actua COMO el usuario: ve y cambia solo lo que el puede. *@
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Common
@using Ecorex.Application.Mcp
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Conectar IA - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4v2h1a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3h1V6a4 4 0 0 1 4-4z"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg>
            </div>
            <span>Mi usuario</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Conectar IA a mis tableros</h1>
        <p class="page-sub" style="margin-bottom:0;">
            Conecta Claude, Gemini u otra IA compatible con MCP para que consulte tus tableros, cree y comente tareas,
            avance tus pasos de flujo y, ademas, DISENE flujos y formularios nuevos. La IA actua con TU usuario: solo
            ve y cambia lo que tu puedes (incluidos tus permisos de flujos y formularios), y todo queda en la bitacora
            como "@(_displayName) (via IA)".
        </p>
    </div>
</div>

@if (_loading)
{
    <div class="card" style="max-width:1040px;padding:22px 24px;">Cargando...</div>
}
else if (_tenantUserId is null)
{
    <div class="card" style="max-width:1040px;padding:22px 24px;">
        Esta opcion es para usuarios de una empresa (tenant). Tu sesion no tiene un usuario de empresa asociado.
    </div>
}
else
{
    <div class="card" style="max-width:1040px;padding:22px 24px;margin-bottom:16px;">
        <label class="form-label" style="font-size:12px;font-weight:700;">Direccion del servidor MCP</label>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:16px;">
            <code style="background:var(--muted);padding:4px 10px;border-radius:7px;font-size:12.5px;word-break:break-all;">@ServerUrl</code>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => Copy(ServerUrl)">Copiar</button>
        </div>

        <label class="form-label" style="font-size:12px;font-weight:700;">Nuevo conector</label>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <input class="form-control" style="max-width:320px;" placeholder="Ej. Claude en mi portatil" maxlength="150" @bind="_newName" />
            <button class="btn btn-primary" disabled="@_busy" @onclick="IssueAsync">@(_busy ? "Generando..." : "Generar token")</button>
        </div>
        @if (_error is not null)
        {
            <div class="text-danger" style="font-size:12.5px;margin-top:8px;">@_error</div>
        }

        @if (_plain is not null)
        {
            <div style="margin-top:18px;padding:14px 16px;border:1px solid var(--border);border-radius:10px;background:var(--muted);">
                <div style="font-weight:700;font-size:13px;margin-bottom:6px;">Tu token (se muestra SOLO esta vez)</div>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px;">
                    <code style="padding:4px 10px;border-radius:7px;font-size:12.5px;word-break:break-all;background:var(--card, #fff);">@_plain</code>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => Copy(_plain!)">Copiar</button>
                </div>

                @foreach (var (title, snippet) in Snippets(_plain))
                {
                    <label class="form-label" style="font-size:12px;font-weight:700;">@title</label>
                    <div style="position:relative;margin-bottom:12px;">
                        <pre style="background:var(--card, #fff);border:1px solid var(--border);border-radius:8px;padding:12px;font-size:11.5px;white-space:pre-wrap;overflow:auto;margin:0;">@snippet</pre>
                        <button class="btn btn-outline-secondary btn-sm" style="position:absolute;top:8px;right:8px;" @onclick="() => Copy(snippet)">Copiar</button>
                    </div>
                }
                <p class="text-muted" style="font-size:11.5px;margin:0;">
                    Guardalo como una clave: quien lo tenga actua como tu en tus tableros. Si lo pierdes, revocalo y genera otro.
                    ChatGPT y claude.ai (web) requieren inicio de sesion OAuth, que llega en una fase posterior.
                </p>
            </div>
        }
    </div>

    <h2 style="font-size:1.05rem;font-weight:700;margin:26px 0 12px;">Mis conectores</h2>
    <div class="card" style="max-width:1040px;padding:6px 16px;">
        @if (_tokens.Count == 0)
        {
            <div class="text-muted" style="padding:14px 0;font-size:13px;">Aun no has creado conectores.</div>
        }
        else
        {
            <table class="table" style="margin:0;font-size:13px;">
                <thead>
                    <tr><th>Nombre</th><th>Creado</th><th>Ultimo uso</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in _tokens)
                    {
                        var tt = t;
                        <tr>
                            <td>@tt.Name</td>
                            <td>@tt.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@(tt.LastUsedAt is { } lu ? lu.LocalDateTime.ToString("dd MMM yyyy HH:mm") : "Nunca")</td>
                            <td><span class="badge bg-@(tt.IsActive ? "success" : "secondary")">@(tt.IsActive ? "Activo" : "Revocado")</span></td>
                            <td style="text-align:right;">
                                @if (tt.IsActive)
                                {
                                    <button class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="() => RevokeAsync(tt.Id)">Revocar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _plain;
    private string _newName = string.Empty;
    private string _displayName = "Usuario";
    private Guid _tenantId;
    private Guid _actor;
    private Guid? _tenantUserId;
    private List<PersonalTokenDto> _tokens = new();

    private string ServerUrl => Nav.BaseUri.TrimEnd('/') + Ecorex.SuperAdmin.Endpoints.McpTablerosEndpoints.Route;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _displayName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
            Guid.TryParse(user.FindFirst("tenant_id")?.Value, out _tenantId);
            Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _actor);
        }
        if (_tenantId != Guid.Empty && _actor != Guid.Empty)
        {
            using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(_tenantId, _actor);
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
            _tenantUserId = await db.TenantUsers.AsNoTracking()
                .Where(u => u.PlatformUserId == _actor)
                .Select(u => (Guid?)u.Id)
                .FirstOrDefaultAsync();
            await LoadAsync(scope.ServiceProvider);
        }
        _loading = false;
    }

    private async Task LoadAsync(IServiceProvider sp)
    {
        if (_tenantUserId is not Guid me) { return; }
        var svc = sp.GetRequiredService<IPersonalAccessTokenService>();
        _tokens = (await svc.ListMineAsync(me)).ToList();
    }

    private async Task IssueAsync()
    {
        if (_tenantUserId is not Guid me) { return; }
        _busy = true; _error = null; _plain = null;
        try
        {
            using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(_tenantId, _actor);
            await using var scope = ScopeFactory.CreateAsyncScope();
            var svc = scope.ServiceProvider.GetRequiredService<IPersonalAccessTokenService>();
            var issued = await svc.IssueAsync(me, _actor, _newName);
            _plain = issued.PlainToken;
            _newName = string.Empty;
            await LoadAsync(scope.ServiceProvider);
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RevokeAsync(Guid tokenId)
    {
        if (_tenantUserId is not Guid me) { return; }
        _busy = true; _error = null;
        try
        {
            using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(_tenantId, _actor);
            await using var scope = ScopeFactory.CreateAsyncScope();
            var svc = scope.ServiceProvider.GetRequiredService<IPersonalAccessTokenService>();
            await svc.RevokeAsync(me, _actor, tokenId);
            await LoadAsync(scope.ServiceProvider);
        }
        finally { _busy = false; }
    }

    /// <summary>Configuraciones listas para copiar, por cliente MCP.</summary>
    private IEnumerable<(string Title, string Snippet)> Snippets(string token)
    {
        var url = ServerUrl;
        yield return ("Claude Code (terminal)",
            $"claude mcp add --transport http ecorex-tableros {url} --header \"Authorization: Bearer {token}\"");
        yield return ("Gemini CLI (~/.gemini/settings.json)",
            "{\n  \"mcpServers\": {\n    \"ecorex-tableros\": {\n      \"httpUrl\": \"" + url + "\",\n" +
            "      \"headers\": { \"Authorization\": \"Bearer " + token + "\" }\n    }\n  }\n}");
        yield return ("Gemini (aplicacion / Code Assist, si el CLI falla; requiere Node) ~/.gemini/settings.json",
            "{\n  \"mcpServers\": {\n    \"ecorex-tableros\": {\n      \"command\": \"npx\",\n" +
            "      \"args\": [\"-y\", \"mcp-remote\", \"" + url + "\", \"--header\", \"Authorization:Bearer " + token + "\"]\n    }\n  }\n}");
        yield return ("Codex (~/.codex/config.toml, requiere Node)",
            "[mcp_servers.ecorex-tableros]\ncommand = \"npx\"\n" +
            "args = [\"-y\", \"mcp-remote\", \"" + url + "\", \"--header\", \"Authorization:Bearer " + token + "\"]");
        yield return ("Claude Desktop (claude_desktop_config.json, requiere Node)",
            "{\n  \"mcpServers\": {\n    \"ecorex-tableros\": {\n      \"command\": \"npx\",\n" +
            "      \"args\": [\"-y\", \"mcp-remote\", \"" + url + "\", \"--header\", \"Authorization:Bearer " + token + "\"]\n    }\n  }\n}");
    }

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); } catch (JSException) { }
    }
}
