@page "/conexiones-datos"
@attribute [Authorize(Policy = "Conexiones.Editar")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Ecorex.Application.Tenancy.DataConnections
@using Ecorex.Application.Reporting.External
@using Ecorex.Domain.Enums
@inject ITenantDataConnectionService Conns
@inject AuthenticationStateProvider AuthProvider

@* Conexiones de datos externas PROPIAS del tenant (tenant-scoped, ADR-0084). Cada empresa gestiona SOLO
   las suyas; la cadena se cifra; la escritura se habilita por conexion. Consola de consulta directa +
   datasets guardados. *@

<PageTitle>Conexiones de datos - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
            </div>
            <span>Sistema / Desarrollo</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Conexiones de <span>datos</span></h1>
        <p class="page-sub" style="margin-bottom:0;">Registra servidores SQL externos de esta empresa. La cadena de conexion se cifra y nunca se vuelve a mostrar. Define datasets (consultas guardadas) o usa la consola directa. La escritura se habilita por conexion.</p>
    </div>
</div>

@if (_loading)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="card-soft" style="padding:18px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <h2 style="font-size:1rem;margin:0;">Conexiones</h2>
            <button class="btn btn-sm btn-primary" @onclick="NewConn">Nueva conexion</button>
        </div>
        @if (_conns.Count == 0)
        {
            <p class="page-sub" style="margin:0;">No hay conexiones registradas.</p>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="table table-sm" style="margin:0;">
                    <thead><tr><th>Nombre</th><th>Motor</th><th>Acceso</th><th>Estado</th><th>Datasets</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in _conns)
                        {
                            <tr class="@(c.Id == _selectedId ? "table-active" : "")">
                                <td>@c.Name @(c.HasConnectionString ? "" : "(sin cadena)")</td>
                                <td>@c.Provider</td>
                                <td>@(c.AllowWrite ? "Lectura/Escritura" : "Solo lectura")</td>
                                <td>@(c.IsEnabled ? "Habilitada" : "Deshabilitada")</td>
                                <td>@c.DatasetCount</td>
                                <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenConn(c.Id)">Abrir</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ===== Modal HUB de la conexion: config + SUS datasets + consola directa ===== *@
    @if (_editing is not null)
    {
        <div style="position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1050;display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;">
            <div class="card-soft" style="width:min(780px,96vw);max-height:90vh;overflow:auto;padding:22px;background:var(--surface-1,#fff);box-shadow:0 24px 60px rgba(0,0,0,.28);" @onclick:stopPropagation="true">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
                    <h2 style="font-size:1.05rem;margin:0;">@(_form.Id is null ? "Nueva conexion" : $"Conexion: {_form.Name}")</h2>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseModal" disabled="@_busy" style="line-height:1;">&times;</button>
                </div>

                @* --- Configuracion de la conexion --- *@
                <div class="auth-field"><label>Nombre</label><input class="form-control" style="width:100%;box-sizing:border-box;" autocomplete="off" @bind="_form.Name" /></div>
                <div class="auth-field" style="margin-top:10px;"><label>Descripcion</label><input class="form-control" style="width:100%;box-sizing:border-box;" autocomplete="off" @bind="_form.Description" /></div>
                <div class="auth-field" style="margin-top:10px;">
                    <label>Motor</label>
                    <select class="form-control" style="width:100%;box-sizing:border-box;" @bind="_form.Provider">
                        <option value="@ExternalDataProvider.SqlServer">SQL Server</option>
                        <option value="@ExternalDataProvider.Postgres">PostgreSQL</option>
                    </select>
                </div>
                <div class="auth-field" style="margin-top:10px;">
                    <label>Cadena de conexion @(_form.HasConnectionString ? "(guardada; deja vacio para conservarla)" : "")</label>
                    @* autocomplete=new-password + name generico evitan que el gestor de contrasenas rellene la cadena. *@
                    <input class="form-control" style="width:100%;box-sizing:border-box;" type="password" name="ecorex-conn-string" autocomplete="new-password" @bind="_form.ConnectionString" placeholder="@(_form.HasConnectionString ? "(sin cambios)" : "Server=host,puerto;Database=..;User Id=..;Password=..")" />
                </div>
                <div class="form-check form-switch" style="margin-top:12px;">
                    <input class="form-check-input" type="checkbox" id="cnEnabled" @bind="_form.IsEnabled" />
                    <label class="form-check-label" for="cnEnabled">Habilitada</label>
                </div>
                <div class="form-check form-switch" style="margin-top:6px;">
                    <input class="form-check-input" type="checkbox" id="cnWrite" @bind="_form.AllowWrite" />
                    <label class="form-check-label" for="cnWrite">Permitir escritura (INSERT/UPDATE/DELETE)</label>
                </div>
                @if (_form.AllowWrite)
                {
                    <div class="text-danger" style="font-size:.8rem;margin-top:4px;">Con escritura habilitada, las consultas de esta conexion pueden MODIFICAR el servidor externo.</div>
                }
                @if (!string.IsNullOrWhiteSpace(_connMsg)) { <div class="@(_connOk ? "text-success" : "text-danger")" style="font-size:.85rem;margin-top:10px;">@_connMsg</div> }
                <div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:flex-end;">
                    @if (_form.Id is not null)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="DeleteConn" disabled="@_busy" style="margin-right:auto;">Eliminar</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="TestConn" disabled="@_busy">Probar conexion</button>
                    }
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CloseModal" disabled="@_busy">Cerrar</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveConn" disabled="@_busy">Guardar</button>
                </div>

                @* --- Datasets ligados a ESTA conexion (solo tras guardar la conexion) --- *@
                @if (_form.Id is Guid connId)
                {
                    <hr style="margin:20px 0;" />
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <h3 style="font-size:.95rem;margin:0;">Datasets de esta conexion</h3>
                        <button class="btn btn-sm btn-primary" @onclick="NewDataset" disabled="@_busy">+ Nuevo dataset</button>
                    </div>
                    @if (_datasets.Count > 0)
                    {
                        <div style="overflow-x:auto;">
                            <table class="table table-sm" style="margin-top:10px;">
                                <thead><tr><th>Nombre</th><th>Descripcion</th><th>Params</th><th>Agentes</th><th>Estado</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var d in _datasets)
                                    {
                                        <tr>
                                            <td>@d.Name</td><td>@d.Description</td>
                                            <td>@d.ParameterCount</td>
                                            <td>@(d.AgentEnabled ? "Si" : "-")</td>
                                            <td>@(d.IsEnabled ? "Habilitado" : "Deshabilitado")</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => RunDataset(d.Id)" disabled="@_busy">Ejecutar</button>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditDataset(d.Id)" disabled="@_busy">Editar</button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteDataset(d.Id)" disabled="@_busy">Borrar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="page-sub" style="margin:8px 0 0;">Aun no hay datasets. Crea uno con "+ Nuevo dataset".</p>
                    }

                    @* Editor de dataset INLINE dentro del modal (no otra ventana) *@
                    @if (_editingDs is not null)
                    {
                        <div class="card-soft" style="margin-top:12px;padding:14px;background:rgba(15,23,42,.03);border:1px solid var(--border,#e2e8f0);">
                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                <strong style="font-size:.9rem;">@(_dsForm.Id is null ? "Nuevo dataset" : "Editar dataset")</strong>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _editingDs = null" disabled="@_busy" style="line-height:1;">&times;</button>
                            </div>
                            <div class="auth-field" style="margin-top:10px;"><label>Nombre</label><input class="form-control" style="width:100%;box-sizing:border-box;" @bind="_dsForm.Name" /></div>
                            <div class="auth-field" style="margin-top:10px;"><label>Descripcion</label><input class="form-control" style="width:100%;box-sizing:border-box;" @bind="_dsForm.Description" /></div>
                            <div class="auth-field" style="margin-top:10px;">
                                <label>Consulta SQL (usa @@nombre para los parametros)</label>
                                <textarea class="form-control" style="width:100%;box-sizing:border-box;" rows="5" @bind="_dsForm.CommandText" placeholder="SELECT * FROM M700_INV.dbo.ITEMS WHERE Codigo = @@codigo"></textarea>
                            </div>

                            @* --- Parametros del dataset --- *@
                            <div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;">
                                <label style="margin:0;font-weight:600;font-size:.82rem;color:var(--ink-2,#475569);">PARAMETROS</label>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="AddParam" disabled="@_busy">+ Parametro</button>
                            </div>
                            @if (_dsForm.Params.Count == 0)
                            {
                                <p class="page-sub" style="margin:4px 0 0;font-size:.8rem;">Sin parametros. La consulta corre tal cual.</p>
                            }
                            else
                            {
                                <div style="overflow-x:auto;margin-top:6px;">
                                    <table class="table table-sm" style="margin:0;">
                                        <thead><tr><th>Nombre (sin @@)</th><th>Tipo</th><th>Valor por defecto</th><th title="Marca el parametro que acota el numero de filas (TOP/LIMIT). En un reporte NO usa su default: trae hasta el tope del sistema.">Limite de filas</th><th>Descripcion</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var p in _dsForm.Params)
                                            {
                                                <tr>
                                                    <td><input class="form-control form-control-sm" @bind="p.Name" placeholder="codigo" /></td>
                                                    <td>
                                                        <select class="form-control form-control-sm" @bind="p.Type">
                                                            @foreach (var t in Enum.GetValues<ExternalDataParameterType>())
                                                            {
                                                                <option value="@t">@t</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td><input class="form-control form-control-sm" @bind="p.Default" /></td>
                                                    <td style="text-align:center;"><input type="checkbox" @bind="p.IsRowLimit" title="Limite de filas: en reportes trae todo (hasta el tope del sistema), ignorando el default." /></td>
                                                    <td><input class="form-control form-control-sm" @bind="p.Description" placeholder="Que significa / que espera el agente" /></td>
                                                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveParam(p)" disabled="@_busy">x</button></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @* --- Campos de salida (REPORTABLES) --- *@
                            <div style="margin-top:14px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
                                <label style="margin:0;font-weight:600;font-size:.82rem;color:var(--ink-2,#475569);">CAMPOS DE SALIDA (REPORTABLES)</label>
                                <div style="display:flex;gap:6px;">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="DetectFields" disabled="@_busy" title="Ejecuta el dataset y prellena las columnas con su tipo inferido.">Detectar campos</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddField" disabled="@_busy">+ Campo</button>
                                </div>
                            </div>
                            <p class="page-sub" style="margin:4px 0 0;font-size:.8rem;">Definen que columnas ve un reporte. Sin campos, el dataset NO aparece en "Nuevo panel".</p>
                            @if (_dsForm.Fields.Count > 0)
                            {
                                <div style="overflow-x:auto;margin-top:6px;">
                                    <table class="table table-sm" style="margin:0;">
                                        <thead><tr><th>Nombre de columna</th><th>Tipo</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var f in _dsForm.Fields)
                                            {
                                                <tr>
                                                    <td><input class="form-control form-control-sm" @bind="f.Name" placeholder="Codigo" /></td>
                                                    <td>
                                                        <select class="form-control form-control-sm" @bind="f.Type">
                                                            @foreach (var t in Enum.GetValues<ExternalDataParameterType>())
                                                            {
                                                                <option value="@t">@t</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveField(f)" disabled="@_busy">x</button></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <div class="form-check form-switch" style="margin-top:10px;">
                                <input class="form-check-input" type="checkbox" id="dsEnabled" @bind="_dsForm.IsEnabled" />
                                <label class="form-check-label" for="dsEnabled">Habilitado</label>
                            </div>
                            <div class="form-check form-switch" style="margin-top:6px;">
                                <input class="form-check-input" type="checkbox" id="dsAgent" @bind="_dsForm.AgentEnabled" />
                                <label class="form-check-label" for="dsAgent">Disponible para agentes de IA</label>
                            </div>
                            @if (_dsForm.AgentEnabled)
                            {
                                <div class="page-sub" style="margin:2px 0 0;font-size:.78rem;">Los agentes podran listar, ver los parametros y EJECUTAR este dataset. Pon descripciones claras en los parametros.</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_dsMsg)) { <div class="@(_dsOk ? "text-success" : "text-danger")" style="font-size:.85rem;margin-top:8px;">@_dsMsg</div> }
                            <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editingDs = null" disabled="@_busy">Cancelar</button>
                                <button class="btn btn-primary btn-sm" @onclick="() => SaveDataset(connId)" disabled="@_busy">Guardar dataset</button>
                            </div>
                        </div>
                    }

                    @* --- Valores de parametros para ejecutar un dataset --- *@
                    @if (_runDsId is not null)
                    {
                        <div class="card-soft" style="margin-top:12px;padding:14px;background:rgba(37,99,235,.05);border:1px solid var(--border,#e2e8f0);">
                            <strong style="font-size:.9rem;">Ejecutar "@_runDsName" - valores de parametros</strong>
                            <div style="overflow-x:auto;margin-top:8px;">
                                <table class="table table-sm" style="margin:0;">
                                    <thead><tr><th>Parametro</th><th>Tipo</th><th>Valor</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in _runParams)
                                        {
                                            <tr>
                                                <td>
                                                    @p.Name
                                                    @if (!string.IsNullOrWhiteSpace(p.Description))
                                                    {
                                                        <div class="page-sub" style="margin:0;font-size:.75rem;">@p.Description</div>
                                                    }
                                                </td>
                                                <td>@p.Type</td>
                                                <td><input class="form-control form-control-sm" @bind="p.Value" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div style="margin-top:10px;display:flex;gap:8px;justify-content:flex-end;">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _runDsId = null" disabled="@_busy">Cancelar</button>
                                <button class="btn btn-primary btn-sm" @onclick="RunDatasetWithParams" disabled="@_busy">Ejecutar</button>
                            </div>
                        </div>
                    }

                    @* --- Resultado --- *@
                    @if (_result is not null)
                    {
                        <div style="margin-top:16px;">
                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                <strong style="font-size:.9rem;">Resultado</strong>
                                <span class="page-sub" style="margin:0;">@_resultCaption</span>
                            </div>
                            @if (!_result.Ok)
                            {
                                <div class="text-danger" style="margin-top:8px;white-space:pre-wrap;">@_result.Error</div>
                            }
                            else if (_result.Grid is { } grid)
                            {
                                <div style="overflow-x:auto;margin-top:8px;max-height:320px;">
                                    <table class="table table-sm" style="margin:0;">
                                        <thead><tr>@foreach (var col in grid.Columns) { <th>@col</th> }</tr></thead>
                                        <tbody>
                                            @foreach (var row in grid.Rows)
                                            {
                                                <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (grid.RowCount == 0)
                                {
                                    <p class="page-sub" style="margin-top:8px;">Sin filas (o comando de escritura ejecutado correctamente).</p>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
}

@code {
    private const int MaxRows = 500;

    private bool _loading = true, _busy;
    private IReadOnlyList<TenantDataConnectionSummary> _conns = Array.Empty<TenantDataConnectionSummary>();
    private IReadOnlyList<TenantDatasetSummary> _datasets = Array.Empty<TenantDatasetSummary>();

    private Guid? _selectedId;
    private object? _editing, _editingDs;
    private ConnForm _form = new();
    private DsForm _dsForm = new();

    // Ejecucion de un dataset con parametros: se piden los valores antes de correr.
    private Guid? _runDsId;
    private string? _runDsName;
    private List<ParamRow> _runParams = new();

    private string? _connMsg, _dsMsg;
    private bool _connOk, _dsOk;

    private TenantQueryResult? _result;
    private string? _resultCaption;

    protected override async Task OnInitializedAsync()
    {
        await ReloadConns();
        _loading = false;
    }

    private async Task ReloadConns() => _conns = await Conns.ListAsync();

    private void NewConn()
    {
        _form = new ConnForm();
        _selectedId = null;
        _datasets = Array.Empty<TenantDatasetSummary>();
        _editingDs = null;
        _result = null;
        _connMsg = null;
        _editing = _form;
    }

    private void CloseModal()
    {
        _editing = null;
        _editingDs = null;
        _result = null;
        _connMsg = null;
        _dsMsg = null;
    }

    // Carga la conexion (form + sus datasets) y ABRE el modal hub.
    private async Task OpenConn(Guid id)
    {
        _selectedId = id;
        var d = await Conns.GetAsync(id);
        if (d is not null)
        {
            _form = new ConnForm
            {
                Id = d.Id, Name = d.Name, Description = d.Description, Provider = d.Provider,
                IsEnabled = d.IsEnabled, AllowWrite = d.AllowWrite, HasConnectionString = d.HasConnectionString
            };
        }
        _datasets = await Conns.ListDatasetsAsync(id);
        _editingDs = null;
        _result = null;
        _connMsg = null;
        _dsMsg = null;
        _editing = _form;
    }

    private async Task SaveConn()
    {
        _busy = true; _connMsg = null;
        try
        {
            var req = new SaveTenantDataConnectionRequest(
                _form.Name?.Trim() ?? "", _form.Description, _form.Provider,
                _form.ConnectionString, _form.AllowWrite, _form.IsEnabled);
            var id = await Conns.SaveAsync(_form.Id, req, await ActorAsync());
            if (id is null) { _connOk = false; _connMsg = "No se pudo guardar (revisa el nombre)."; return; }
            await ReloadConns();
            await OpenConn(id.Value);   // recarga el form (ahora con Id) + sus datasets, deja el modal abierto
            _connOk = true; _connMsg = "Guardada.";
        }
        catch { _connOk = false; _connMsg = "No se pudo guardar."; }
        finally { _busy = false; }
    }

    private async Task TestConn()
    {
        if (_form.Id is not Guid id) { return; }
        _busy = true; _connMsg = null;
        try
        {
            var req = new SaveTenantDataConnectionRequest(
                _form.Name?.Trim() ?? "", _form.Description, _form.Provider,
                _form.ConnectionString, _form.AllowWrite, _form.IsEnabled);
            var err = await Conns.TestConnectionAsync(id, req, await ActorAsync());
            _connOk = err is null;
            _connMsg = err is null ? "Conexion OK." : err;
        }
        catch { _connOk = false; _connMsg = "No se pudo probar."; }
        finally { _busy = false; }
    }

    private async Task DeleteConn()
    {
        if (_form.Id is not Guid id) { return; }
        _busy = true;
        try
        {
            await Conns.DeleteAsync(id, await ActorAsync());
            _selectedId = null; _editing = null; _result = null;
            await ReloadConns();
        }
        finally { _busy = false; }
    }

    private void NewDataset()
    {
        _dsForm = new DsForm();
        _editingDs = _dsForm;
        _runDsId = null;
        _dsMsg = null;
    }

    private async Task EditDataset(Guid id)
    {
        var d = await Conns.GetDatasetAsync(id);
        if (d is null) { return; }
        _dsForm = new DsForm
        {
            Id = d.Id, Name = d.Name, Description = d.Description, CommandText = d.CommandText,
            IsEnabled = d.IsEnabled, AgentEnabled = d.AgentEnabled,
            Params = ExternalDataJson.DeserializeParameters(d.ParametersJson)
                .Select(p => new ParamRow
                {
                    Name = p.Name, Type = p.Type, Default = p.DefaultValue, Description = p.Description,
                    IsRowLimit = p.Binding == ExternalDataParameterBinding.RowLimit
                }).ToList(),
            Fields = ExternalDataJson.DeserializeFields(d.FieldsJson)
                .Select(f => new FieldRow { Name = f.Name, Type = f.Type }).ToList()
        };
        _editingDs = _dsForm;
        _runDsId = null;
        _dsMsg = null;
    }

    private void AddParam() => _dsForm.Params.Add(new ParamRow());
    private void RemoveParam(ParamRow p) => _dsForm.Params.Remove(p);
    private void AddField() => _dsForm.Fields.Add(new FieldRow());
    private void RemoveField(FieldRow f) => _dsForm.Fields.Remove(f);

    // Ejecuta el dataset guardado y prellena los "Campos de salida" con las columnas + tipo inferido.
    private async Task DetectFields()
    {
        if (_dsForm.Id is not Guid dsId)
        {
            _dsOk = false; _dsMsg = "Guarda el dataset antes de detectar sus campos.";
            return;
        }

        _busy = true; _dsMsg = null;
        try
        {
            // Para datasets con parametros, se ejecuta con sus defaults (solo interesan columnas/tipos).
            var inputs = _dsForm.Params
                .Where(p => !string.IsNullOrWhiteSpace(p.Name))
                .ToDictionary(p => p.Name!.Trim(), p => (string?)p.Default, StringComparer.Ordinal);
            var res = await Conns.RunDatasetAsync(dsId, inputs.Count == 0 ? null : inputs, 50, await ActorAsync());
            if (!res.Ok || res.Grid is not { } g || g.Columns.Count == 0)
            {
                _dsOk = false; _dsMsg = "No se pudieron detectar columnas: " + (res.Error ?? "sin columnas.");
                return;
            }

            _dsForm.Fields = g.Columns.Select((c, i) => new FieldRow
            {
                Name = c,
                Type = g.ColumnTypes is { } types && i < types.Count ? types[i] : ExternalDataParameterType.String
            }).ToList();
            _dsOk = true; _dsMsg = $"{_dsForm.Fields.Count} campo(s) detectado(s). Ajusta el tipo si hace falta y Guarda.";
        }
        catch (Exception ex) { _dsOk = false; _dsMsg = "No se pudo detectar: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveDataset(Guid connId)
    {
        _busy = true; _dsMsg = null;
        try
        {
            // Parametros -> JSON de ExternalDataSetParameter (Input, o RowLimit si se marco). Se ignoran los sin nombre.
            var declared = _dsForm.Params
                .Where(p => !string.IsNullOrWhiteSpace(p.Name))
                .Select(p => new ExternalDataSetParameter(p.Name!.Trim(), p.Type,
                    p.IsRowLimit ? ExternalDataParameterBinding.RowLimit : ExternalDataParameterBinding.Input, null,
                    string.IsNullOrWhiteSpace(p.Default) ? null : p.Default!.Trim(),
                    string.IsNullOrWhiteSpace(p.Description) ? null : p.Description!.Trim()))
                .ToList();
            var paramsJson = declared.Count == 0 ? null : ExternalDataJson.SerializeParameters(declared);

            // Campos de salida (reportables) -> JSON de ExternalDataSetField. Se ignoran los sin nombre.
            var fields = _dsForm.Fields
                .Where(f => !string.IsNullOrWhiteSpace(f.Name))
                .Select(f => new ExternalDataSetField(f.Name!.Trim(), f.Type))
                .ToList();
            var fieldsJson = fields.Count == 0 ? null : ExternalDataJson.SerializeFields(fields);
            var fErr = ExternalDataJson.ValidateFieldsJson(fieldsJson);
            if (fErr is not null) { _dsOk = false; _dsMsg = "Campos de salida: " + fErr; return; }

            var req = new SaveTenantDatasetRequest(
                _dsForm.Id, connId, _dsForm.Name?.Trim() ?? "", _dsForm.Description,
                _dsForm.CommandText?.Trim() ?? "", _dsForm.IsEnabled, paramsJson, _dsForm.AgentEnabled, fieldsJson);
            var id = await Conns.SaveDatasetAsync(req, await ActorAsync());
            if (id is null) { _dsOk = false; _dsMsg = "Revisa nombre y consulta."; return; }
            _dsOk = true; _dsMsg = "Guardado.";
            _datasets = await Conns.ListDatasetsAsync(connId);
            _editingDs = null;
            await ReloadConns();
        }
        catch { _dsOk = false; _dsMsg = "No se pudo guardar."; }
        finally { _busy = false; }
    }

    private async Task DeleteDataset(Guid id)
    {
        if (_selectedId is not Guid connId) { return; }
        _busy = true;
        try
        {
            await Conns.DeleteDatasetAsync(id, await ActorAsync());
            _datasets = await Conns.ListDatasetsAsync(connId);
            if (_runDsId == id) { _runDsId = null; }
            await ReloadConns();
        }
        finally { _busy = false; }
    }

    // Ejecutar: si el dataset tiene parametros, pide sus valores primero; si no, corre directo.
    private async Task RunDataset(Guid id)
    {
        _busy = true; _result = null; _runDsId = null;
        try
        {
            var d = await Conns.GetDatasetAsync(id);
            if (d is null) { return; }
            var declared = ExternalDataJson.DeserializeParameters(d.ParametersJson);
            if (declared.Count > 0)
            {
                _runDsId = id;
                _runDsName = d.Name;
                _runParams = declared.Select(p => new ParamRow { Name = p.Name, Type = p.Type, Default = p.DefaultValue, Description = p.Description, Value = p.DefaultValue }).ToList();
                return;
            }
            await RunDatasetNow(id, null);
        }
        finally { _busy = false; }
    }

    private async Task RunDatasetWithParams()
    {
        if (_runDsId is not Guid id) { return; }
        _busy = true;
        try
        {
            var inputs = _runParams
                .Where(p => !string.IsNullOrWhiteSpace(p.Name))
                .ToDictionary(p => p.Name!, p => (string?)p.Value, StringComparer.Ordinal);
            await RunDatasetNow(id, inputs);
            _runDsId = null;
        }
        finally { _busy = false; }
    }

    private async Task RunDatasetNow(Guid id, IReadOnlyDictionary<string, string?>? inputs)
    {
        _result = await Conns.RunDatasetAsync(id, inputs, MaxRows, await ActorAsync());
        _resultCaption = _result.Ok && _result.Grid is { } g ? $"{g.RowCount} fila(s)" + (g.Truncated ? " (truncado)" : "") : "";
    }

    private async Task<Guid> ActorAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private sealed class ConnForm
    {
        public Guid? Id { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public ExternalDataProvider Provider { get; set; } = ExternalDataProvider.SqlServer;
        public string? ConnectionString { get; set; }
        public bool IsEnabled { get; set; } = true;
        public bool AllowWrite { get; set; }
        public bool HasConnectionString { get; set; }
    }

    private sealed class DsForm
    {
        public Guid? Id { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? CommandText { get; set; }
        public bool IsEnabled { get; set; } = true;
        public bool AgentEnabled { get; set; }
        public List<ParamRow> Params { get; set; } = new();
        public List<FieldRow> Fields { get; set; } = new();
    }

    private sealed class ParamRow
    {
        public string? Name { get; set; }
        public ExternalDataParameterType Type { get; set; } = ExternalDataParameterType.String;
        public string? Default { get; set; }
        public string? Description { get; set; }
        public bool IsRowLimit { get; set; }   // binding RowLimit (en reporte -> tope del sistema)
        public string? Value { get; set; }     // valor al ejecutar
    }

    private sealed class FieldRow
    {
        public string? Name { get; set; }
        public ExternalDataParameterType Type { get; set; } = ExternalDataParameterType.String;
    }
}
