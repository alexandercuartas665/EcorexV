@page "/config-calendario"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Calendario operativo - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">CONFIGURACION - ENTIDAD</div>
        <h1>Calendario operativo</h1>
        <p class="module-sub">Marca los dias NO operativos (festivos o dias sin operacion). El calculo de plazos de flujo en modo "habil" y la ventana horaria de los pulsos los saltan, ademas de sabados y domingos.</p>
    </div>
</div>

<CalendarioOperativoEditor />
