@page "/config-voz"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using Ecorex.Application.Voice
@inject IRetellVoiceLineService VozSvc
@inject IRetellVoiceService CallSvc
@inject IJSRuntime JS

<PageTitle>Lineas de voz IA (Retell) - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">CONFIGURACION - VOZ IA</div>
        <h1>Lineas de voz con IA (Retell / Telnyx)</h1>
        <p class="module-sub">Cada linea tiene su nombre, numero saliente y credenciales cifradas. La API key y la clave SIP nunca se muestran ni salen del servidor.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenNew">+ Nueva linea</button>
</div>

@if (_loading)
{
    <p style="color:var(--ink-3);">Cargando...</p>
}
else if (_lines.Count == 0)
{
    <p style="color:var(--ink-3);max-width:560px;">No hay lineas de voz aun. Crea una con "+ Nueva linea" para poder colocar llamadas IA desde el motor de acciones.</p>
}
else
{
    <div class="cv-grid">
        @foreach (var l in _lines)
        {
            <div class="cv-card">
                <div class="cv-card-head">
                    <div class="cv-card-name">
                        <span class="cv-dot @(l.IsEnabled ? "on" : "off")"></span>
                        @l.Name
                    </div>
                    @if (l.IsDefault) { <span class="cv-badge def">Por defecto</span> }
                </div>
                <div class="cv-card-row"><span>Numero</span><strong>@(l.FromNumber ?? "-")</strong></div>
                <div class="cv-card-row"><span>Voz</span><strong>@(l.VoiceId ?? "-")</strong></div>
                <div class="cv-card-row"><span>Idioma</span><strong>@l.Language</strong></div>
                <div class="cv-card-row"><span>API key</span><strong>@(l.HasApiKey ? "configurada" : "sin configurar")</strong></div>
                <div class="cv-card-row"><span>Estado</span><strong>@(l.IsEnabled ? "Habilitada" : "Deshabilitada")</strong></div>
                @if (l.LastValidatedAt is DateTimeOffset v)
                {
                    <div class="cv-card-row"><span>Validada</span><strong>@v.ToLocalTime().ToString("dd MMM HH:mm")</strong></div>
                }
                <div class="cv-card-actions">
                    @if (l.IsEnabled && l.HasApiKey && !string.IsNullOrWhiteSpace(l.FromNumber))
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => OpenTest(l)">Probar</button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(l)">Editar</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ValidateAsync(l.Id)" disabled="@_busy">Validar</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(l.Id)" disabled="@_busy">Eliminar</button>
                </div>
            </div>
        }
    </div>
}

@if (_msg is not null)
{
    <p style="margin-top:12px;color:@(_ok ? "var(--ok)" : "var(--danger)");font-weight:600;">@_msg</p>
}

@* ---- Modal de edicion ---- *@
@if (_editOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-dialog" style="max-width:560px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@(_editId is null ? "Nueva linea" : "Editar linea")</h3>
                <button class="modal-close" @onclick="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Nombre de la linea</label>
                    <input class="form-control" @bind="_fName" placeholder="Ej. Ventas, Cobranzas" autocomplete="off" />
                </div>
                <div class="field">
                    <label class="form-label">API key de Retell</label>
                    <input class="form-control" type="password" autocomplete="new-password" @bind="_fApiKey"
                           placeholder="@(_hasApiKey ? "**** configurada (deja vacio para conservar)" : "Pega la API key de Retell")" />
                </div>
                <div class="field">
                    <label class="form-label">Agent ID (modo simple)</label>
                    <input class="form-control" @bind="_fAgentId" placeholder="agent_... (agente ya armado en Retell)" autocomplete="off" />
                    <small style="color:var(--ink-3);">Si lo pones, la llamada usa ESE agente de Retell (con su voz/idioma/prompt) y no hace falta llenar lo "Avanzado". Dejalo vacio para que ECOREX componga el agente.</small>
                </div>
                <div style="display:flex;gap:12px;flex-wrap:wrap;">
                    <div class="field" style="flex:1;min-width:200px;">
                        <label class="form-label">Numero saliente (E.164)</label>
                        <input class="form-control" @bind="_fFromNumber" placeholder="+57XXXXXXXXXX" autocomplete="off" />
                    </div>
                    <div class="field" style="flex:1;min-width:200px;">
                        <label class="form-label">Telnyx SIP Username (opcional)</label>
                        <input class="form-control" @bind="_fSipUsername" placeholder="Solo si Telnyx lo exige" autocomplete="off" />
                    </div>
                </div>

                <div style="display:flex;gap:18px;flex-wrap:wrap;margin-top:6px;">
                    <label style="display:inline-flex;align-items:center;gap:8px;">
                        <input type="checkbox" checked="@_fEnabled" @onchange="e => _fEnabled = (bool)(e.Value ?? false)" />
                        <span>Habilitada</span>
                    </label>
                    <label style="display:inline-flex;align-items:center;gap:8px;">
                        <input type="checkbox" checked="@_fDefault" @onchange="e => _fDefault = (bool)(e.Value ?? false)" />
                        <span>Por defecto</span>
                    </label>
                </div>

                <details style="margin-top:12px;">
                    <summary style="cursor:pointer;color:var(--ink-3);font-weight:600;">Avanzado (modo compuesto — solo si NO usas Agent ID)</summary>
                    <div style="padding-top:8px;">
                        <div style="display:flex;gap:12px;flex-wrap:wrap;">
                            <div class="field" style="flex:1;min-width:200px;">
                                <label class="form-label">Voz (voice_id)</label>
                                <input class="form-control" @bind="_fVoiceId" placeholder="ej. 11labs-Adrian" autocomplete="off" />
                            </div>
                            <div class="field" style="flex:1;min-width:120px;">
                                <label class="form-label">Idioma</label>
                                <input class="form-control" @bind="_fLanguage" placeholder="es-419" autocomplete="off" />
                            </div>
                        </div>
                        <div class="field">
                            <label class="form-label">Telnyx Termination URI (FQDN)</label>
                            <input class="form-control" @bind="_fTerminationUri" placeholder="ej. sip.telnyx.com" autocomplete="off" />
                        </div>
                        <div class="field">
                            <label class="form-label">Clave SIP de Telnyx</label>
                            <input class="form-control" type="password" autocomplete="new-password" @bind="_fSipPassword"
                                   placeholder="@(_hasSipPassword ? "**** configurada" : "clave del trunk")" />
                        </div>
                    </div>
                </details>

                @if (_editError is not null)
                {
                    <p style="color:var(--danger);font-weight:600;margin-top:8px;">@_editError</p>
                }
            </div>
            <div style="display:flex;justify-content:flex-end;gap:10px;padding:12px 20px;border-top:1px solid var(--line);">
                <button class="btn btn-outline-secondary" @onclick="Close">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Guardar</button>
            </div>
        </div>
    </div>
}

@* ---- Modal de PRUEBA de una linea (llamada REAL + resultado) ---- *@
@if (_testOpen && _testLine is not null)
{
    var simpleMode = !string.IsNullOrWhiteSpace(_testLine.RetellAgentId);
    <div class="modal-overlay" @onclick="CloseTest">
        <div class="modal-dialog" style="max-width:600px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Probar linea</h3>
                <button class="modal-close" @onclick="CloseTest">&times;</button>
            </div>
            <div class="modal-body">
                <div class="cv-test-grid">
                    <div class="cv-test-line">
                        <span class="cv-dot on"></span>
                        <strong>@_testLine.Name</strong>
                        <span>@(_testLine.FromNumber ?? "-")</span>
                        <span>@(simpleMode ? "agente Retell propio" : "agente compuesto por ECOREX")</span>
                    </div>

                    <div class="field">
                        <label class="form-label">Numero destino</label>
                        <input class="form-control" @bind="_testTo" placeholder="ej. 3001234567" autocomplete="off" disabled="@_testBusy" />
                    </div>

                    <div class="field">
                        <label class="form-label">Objetivo</label>
                        <select class="form-control" @bind="_testObjetivo" disabled="@_testBusy">
                            <option value="Llamada de prueba">Llamada de prueba (libre)</option>
                            <option value="OfrecerProducto">Ofrecer producto/servicio</option>
                            <option value="LlenarFormulario">Llenar formulario</option>
                        </select>
                    </div>

                    <div class="field">
                        <label class="form-label">Prompt adicional (opcional)</label>
                        <textarea class="form-control" rows="3" @bind="_testPrompt" disabled="@_testBusy"
                                  placeholder="Instruccion extra para esta llamada (ej. 'Presentate como Sara de Agrometalicas y confirma el interes en tolvas')."></textarea>
                        @if (simpleMode)
                        {
                            <div class="cv-test-warn">
                                Esta linea usa un agente de Retell ya armado (Agent ID). Retell NO permite cambiar su prompt por llamada:
                                el prompt adicional se ignora. Para que aplique, usa una linea en modo compuesto (sin Agent ID) o
                                parametriza con variables dinamicas en el prompt del agente.
                            </div>
                        }
                        else
                        {
                            <div class="cv-test-note">Se agrega al prompt del agente como "Instruccion adicional para esta llamada".</div>
                        }
                    </div>

                    @* ---- Agente (voz/idioma/modelo/prompt) que correra, leido de Retell (modo simple) o compuesto ---- *@
                    <div class="cv-agent">
                        <div class="cv-agent-head">
                            <strong>Agente</strong>
                            @if (_agentBusy) { <span class="cv-spin"></span> }
                            <button type="button" class="cv-linkbtn" @onclick="RefreshAgentAsync" disabled="@(_agentBusy || _testBusy)">Actualizar</button>
                        </div>
                        @if (_agentInfo is not null)
                        {
                            <div class="cv-agent-meta">
                                <span>@(_agentInfo.Mode == "simple" ? "Agente Retell propio" : "Compuesto por ECOREX")</span>
                                @if (!string.IsNullOrWhiteSpace(_agentInfo.VoiceId)) { <span>voz: @_agentInfo.VoiceId</span> }
                                @if (!string.IsNullOrWhiteSpace(_agentInfo.Language)) { <span>idioma: @_agentInfo.Language</span> }
                                @if (!string.IsNullOrWhiteSpace(_agentInfo.Model)) { <span>modelo: @_agentInfo.Model</span> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_agentInfo.Warning)) { <div class="cv-test-note">@_agentInfo.Warning</div> }
                            @if (!string.IsNullOrWhiteSpace(_agentInfo.Prompt))
                            {
                                <details class="cv-agent-prompt">
                                    <summary>Ver prompt del agente</summary>
                                    <div class="cv-transcript">@_agentInfo.Prompt</div>
                                </details>
                            }
                        }
                        else if (!_agentBusy)
                        {
                            <div class="cv-test-note">No se pudo cargar la info del agente (revisa la API key / Agent ID de la linea).</div>
                        }
                    </div>

                    @* ---- Variables dinamicas: {{...}} detectadas en el prompt + manuales. Se mandan a Retell. ---- *@
                    <div class="field">
                        <label class="form-label">Variables</label>
                        @if (_testVars.Count == 0)
                        {
                            <div class="cv-test-note">El prompt no declara variables {{ }}. Si tu agente usa alguna, agregala abajo.</div>
                        }
                        @foreach (var key in _testVars.Keys.ToList())
                        {
                            <div class="cv-var-row">
                                <span class="cv-var-key">@key</span>
                                <input class="form-control" value="@_testVars[key]" disabled="@_testBusy"
                                       placeholder="valor"
                                       @onchange="e => _testVars[key] = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        }
                        <div class="cv-var-add">
                            <input class="form-control" @bind="_newVarKey" placeholder="nueva variable (sin llaves)" disabled="@_testBusy" />
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddVar" disabled="@_testBusy">+ Agregar</button>
                        </div>
                    </div>

                    @if (_testErr is not null) { <p style="color:var(--danger);font-weight:600;margin:0;">@_testErr</p> }

                    @if (_testResult is not null)
                    {
                        var st = _testResult.Status;
                        var done = st is "Analyzed" or "Ended";
                        var err = st is "Error" or "Failed";
                        <div class="cv-result">
                            <div class="cv-result-head">
                                @if (!done && !err) { <span class="cv-spin"></span> }
                                <span class="cv-status @(done ? "done" : err ? "err" : "")">@EstadoEs(st)</span>
                                @if (_testResult.DurationSeconds is int ds) { <span class="cv-result-meta">@ds s</span> }
                                @if (_testResult.CostUsd is decimal c) { <span class="cv-result-meta">US$ @c.ToString("0.0000")</span> }
                                <span class="cv-result-meta">call_id: @_testResult.CallId</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_testResult.RecordingUrl))
                            {
                                <audio class="cv-audio" controls src="@_testResult.RecordingUrl"></audio>
                                <a href="@_testResult.RecordingUrl" target="_blank" rel="noopener" style="font-size:.78rem;">Abrir grabacion</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(_testResult.AnalysisSummary))
                            {
                                <div class="cv-analysis">@_testResult.AnalysisSummary</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_testResult.TranscriptText))
                            {
                                <div class="cv-transcript">@_testResult.TranscriptText</div>
                            }
                            else if (!done && !err)
                            {
                                <div class="cv-result-meta">Esperando que termine la llamada y llegue el webhook de Retell... (la transcripcion/grabacion aparecen al finalizar).</div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 20px;border-top:1px solid var(--line);">
                <small style="color:var(--ink-3);">Llamada <strong>REAL</strong> con IA. Tiene costo.</small>
                <div style="display:flex;gap:10px;">
                    <button class="btn btn-outline-secondary" @onclick="CloseTest">Cerrar</button>
                    <button class="btn btn-primary" @onclick="LaunchTestAsync" disabled="@_testBusy">
                        @(_testBusy ? "Llamando..." : _testResult is null ? "Llamar" : "Llamar de nuevo")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _ok;
    private string? _msg;
    private List<RetellVoiceLineDto> _lines = new();

    private bool _editOpen;
    private Guid? _editId;
    private string? _editError;
    private bool _hasApiKey, _hasSipPassword;
    private string _fName = "";
    private string? _fApiKey, _fFromNumber, _fVoiceId, _fTerminationUri, _fSipUsername, _fSipPassword, _fAgentId;
    private string _fLanguage = "es-419";
    private bool _fEnabled = true;
    private bool _fDefault;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync() => _lines = (await VozSvc.ListAsync()).ToList();

    private void OpenNew()
    {
        _editId = null; _editError = null; _hasApiKey = false; _hasSipPassword = false;
        _fName = ""; _fApiKey = null; _fFromNumber = null; _fVoiceId = null; _fTerminationUri = null;
        _fSipUsername = null; _fSipPassword = null; _fAgentId = null; _fLanguage = "es-419"; _fEnabled = true;
        _fDefault = _lines.Count == 0; // la primera linea es por defecto
        _editOpen = true;
    }

    private void OpenEdit(RetellVoiceLineDto l)
    {
        _editId = l.Id; _editError = null; _hasApiKey = l.HasApiKey; _hasSipPassword = l.HasSipPassword;
        _fName = l.Name; _fApiKey = null; _fFromNumber = l.FromNumber; _fVoiceId = l.VoiceId;
        _fTerminationUri = l.TerminationUri; _fSipUsername = l.SipUsername; _fSipPassword = null;
        _fAgentId = l.RetellAgentId;
        _fLanguage = l.Language; _fEnabled = l.IsEnabled; _fDefault = l.IsDefault;
        _editOpen = true;
    }

    private void Close() => _editOpen = false;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_fName)) { _editError = "La linea necesita un nombre."; return; }
        _busy = true; _editError = null;
        try
        {
            // El numero saliente se guarda SIEMPRE normalizado a E.164 (con '+'), igual que el destino de la prueba.
            // Asi la validacion E.164 de PlaceCallAsync no falla cuando el usuario lo escribe sin '+' (ej. 57XXXXXXXXXX).
            var fromE164 = NormalizeE164(_fFromNumber);
            var req = new SaveRetellVoiceLineRequest(
                Name: _fName, ApiKey: _fApiKey, FromNumber: fromE164, TerminationUri: _fTerminationUri,
                SipUsername: _fSipUsername, SipPassword: _fSipPassword, VoiceId: _fVoiceId,
                Language: _fLanguage, IsEnabled: _fEnabled, IsDefault: _fDefault, AgentId: _fAgentId);
            if (_editId is Guid id) { await VozSvc.UpdateAsync(id, req); }
            else { await VozSvc.CreateAsync(req); }
            await ReloadAsync();
            _ok = true; _msg = "Linea guardada."; _editOpen = false;
        }
        catch (Exception ex) { _editError = "No se pudo guardar: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ValidateAsync(Guid id)
    {
        _busy = true; _msg = null;
        try
        {
            var res = await VozSvc.ValidateAsync(id);
            _ok = res.Ok;
            _msg = res.Ok ? "Key valida contra Retell." : ("Validacion fallo: " + (res.Error ?? "error"));
            if (res.Ok) { await ReloadAsync(); }
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        _busy = true; _msg = null;
        try { await VozSvc.DeleteAsync(id); await ReloadAsync(); _ok = true; _msg = "Linea eliminada."; }
        finally { _busy = false; }
    }

    // ---- Prueba de una linea CONCRETA (llamada REAL + resultado por webhook) ----
    private bool _testOpen;
    private RetellVoiceLineDto? _testLine;
    private string _testTo = "";
    private string _testObjetivo = "Llamada de prueba";
    private string? _testPrompt;
    private bool _testBusy;
    private string? _testErr;
    private VoiceCallResultDto? _testResult;
    private CancellationTokenSource? _pollCts;
    private VoiceTestAgentInfoDto? _agentInfo;
    private bool _agentBusy;
    private readonly Dictionary<string, string> _testVars = new(StringComparer.OrdinalIgnoreCase);
    private string _newVarKey = "";

    private async Task OpenTest(RetellVoiceLineDto l)
    {
        CancelPoll();
        _testLine = l; _testTo = ""; _testObjetivo = "Llamada de prueba"; _testPrompt = null;
        _testErr = null; _testResult = null; _testBusy = false;
        _agentInfo = null; _testVars.Clear(); _newVarKey = "";
        _testOpen = true;
        await LoadAgentInfoAsync();
    }

    // Lee la config del agente (modo simple: de Retell; compuesto: prompt armado) y siembra las variables {{...}}.
    private async Task LoadAgentInfoAsync()
    {
        if (_testLine is null) { return; }
        _agentBusy = true;
        try
        {
            _agentInfo = await CallSvc.GetTestAgentInfoAsync(_testLine.Id, aiAgentId: null, promptExtra: _testPrompt, objetivo: _testObjetivo);
            if (_agentInfo is not null)
            {
                foreach (var v in _agentInfo.Variables)
                {
                    if (!_testVars.ContainsKey(v)) { _testVars[v] = ""; }   // conserva valores ya escritos
                }
            }
        }
        catch (Exception ex) { _testErr = "No se pudo leer el agente: " + ex.Message; }
        finally { _agentBusy = false; }
    }

    private Task RefreshAgentAsync() => LoadAgentInfoAsync();

    private void AddVar()
    {
        var k = (_newVarKey ?? "").Trim().Trim('{', '}', ' ');
        if (k.Length > 0 && !_testVars.ContainsKey(k)) { _testVars[k] = ""; }
        _newVarKey = "";
    }

    private void CloseTest()
    {
        CancelPoll();
        _testOpen = false; _testLine = null; _testResult = null; _testErr = null;
        _agentInfo = null; _testVars.Clear(); _newVarKey = "";
    }

    private async Task LaunchTestAsync()
    {
        if (_testLine is null) { return; }
        _testErr = null;
        var to = NormalizeE164(_testTo);
        if (to is null) { _testErr = "Indica un numero valido (ej. 3001234567)."; return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"Se hara una LLAMADA REAL con IA al {to} por la linea {_testLine.Name}. Tiene costo. ¿Continuar?")) { return; }
        CancelPoll();
        _testBusy = true; _testResult = null;
        try
        {
            var extraVars = _testVars
                .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                .ToDictionary(kv => kv.Key, kv => kv.Value.Trim(), StringComparer.OrdinalIgnoreCase);
            var req = new VoicePlaceCallRequest(
                ToNumber: to, AiAgentId: null,
                PromptExtra: string.IsNullOrWhiteSpace(_testPrompt) ? null : _testPrompt,
                Objetivo: _testObjetivo,
                FormulariosPermitidos: Array.Empty<Guid>(),
                ContactVariables: new Dictionary<string, string?>(),
                ContactWorkflowRunId: null,
                RetellVoiceLineId: _testLine.Id,
                ExtraDynamicVariables: extraVars.Count > 0 ? extraVars : null);
            var r = await CallSvc.PlaceCallAsync(req);
            if (!r.Placed || string.IsNullOrEmpty(r.CallId))
            {
                _testErr = r.Error ?? "No se pudo lanzar la llamada.";
                return;
            }
            _testResult = new VoiceCallResultDto(r.CallId!, "Registered", null, null, null, null, null, null, null);
            _ = PollResultAsync(r.CallId!);   // sondeo en segundo plano; se cancela al cerrar/relanzar
        }
        catch (Exception ex) { _testErr = "Error: " + ex.Message; }
        finally { _testBusy = false; }
    }

    // Sondea el resultado por call_id hasta Analyzed/Error/Failed o ~3 min. Los webhooks de Retell van
    // completando la VoiceCall (started -> ended[+transcript/recording] -> analyzed[+analisis/costo]).
    private async Task PollResultAsync(string callId)
    {
        var cts = new CancellationTokenSource();
        _pollCts = cts;
        var ct = cts.Token;
        try
        {
            for (var i = 0; i < 45 && !ct.IsCancellationRequested; i++)
            {
                await Task.Delay(4000, ct);
                if (ct.IsCancellationRequested) { return; }
                var res = await CallSvc.GetCallResultAsync(callId, ct);
                if (res is not null)
                {
                    _testResult = res;
                    await InvokeAsync(StateHasChanged);
                    if (res.Status is "Analyzed" or "Error" or "Failed") { return; }
                }
            }
        }
        catch (OperationCanceledException) { /* cerrado o relanzado */ }
        catch { /* best-effort: el usuario puede relanzar */ }
    }

    private void CancelPoll()
    {
        try { _pollCts?.Cancel(); _pollCts?.Dispose(); } catch { /* ya dispuesto */ }
        _pollCts = null;
    }

    public void Dispose() => CancelPoll();

    private static string EstadoEs(string status) => status switch
    {
        "Registered" => "Registrada",
        "Ongoing" => "En curso",
        "Ended" => "Finalizada",
        "Analyzed" => "Analizada",
        "Error" => "Error",
        "Failed" => "Fallida",
        _ => status
    };

    /// <summary>Normaliza a E.164: movil CO de 10 digitos (empieza en 3) -> +57; si trae +/indicativo se conserva.</summary>
    private static string? NormalizeE164(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) { return null; }
        var d = new string(s.Where(char.IsDigit).ToArray());
        if (d.Length < 7) { return null; }
        if (d.Length == 10 && d.StartsWith("3")) { d = "57" + d; }
        return "+" + d;
    }
}
