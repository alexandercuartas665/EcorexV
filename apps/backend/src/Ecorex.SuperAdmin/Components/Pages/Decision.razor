@page "/d/{Token}"
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Workflows
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Auth
@using Microsoft.AspNetCore.Hosting
@inject IWorkflowDecisionLinkService DecisionSvc
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

@* Pagina publica de DECISION del cliente (feature generica). SIN policy: el acceso lo gobierna el
   token opaco (secreto, un-solo-uso, caducidad, y ademas exige que el paso de la compuerta siga
   vigente). La validacion es el UNICO punto cross-tenant; aplicado el envio, todo corre con el tenant
   del token fijado como ambient. Los errores de token muestran un mensaje neutro. *@

<PageTitle>Decision - ECOREX</PageTitle>

<div class="dp-page">
    <div class="dp-wrap">
        @if (_loading)
        {
            <div class="dp-state"><p class="dp-state-txt"><em>Validando enlace...</em></p></div>
        }
        else if (_done)
        {
            <div class="dp-state">
                <div class="dp-state-icon ok">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <h2 class="dp-state-h">Gracias, tu respuesta fue registrada.</h2>
                <p class="dp-state-txt">Ya puedes cerrar esta ventana.</p>
            </div>
        }
        else if (_v is null || !_v.IsValid)
        {
            <div class="dp-state">
                <div class="dp-state-icon off">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                </div>
                <h2 class="dp-state-h">Este enlace no esta disponible.</h2>
                <p class="dp-state-txt">El enlace no es valido, expiro o la decision ya fue registrada. Contacta a quien te lo compartio.</p>
            </div>
        }
        else
        {
            @* ===== Header con gradiente (icono + numero + titulo + empresa) ===== *@
            <div class="dp-hero">
                <div class="dp-hero-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m10 13-1.5 4L12 16l1-1 2.5-2.5a1.4 1.4 0 0 0-2-2L11 13z"/></svg>
                </div>
                @if (!string.IsNullOrWhiteSpace(_v.ActivityNumber))
                {
                    <span class="dp-hero-num">@_v.ActivityNumber</span>
                }
                <h1 class="dp-hero-title">@(_v.ButtonLabel ?? "Confirmar")</h1>
                @if (!string.IsNullOrWhiteSpace(_v.CompanyName))
                {
                    <p class="dp-hero-company">@_v.CompanyName</p>
                }
                else if (!string.IsNullOrWhiteSpace(_v.ActivityTitle))
                {
                    <p class="dp-hero-company">@_v.ActivityTitle</p>
                }
            </div>

            @* ===== Tarjeta principal: captura (firma / observacion) ===== *@
            @if (_v.Capture == WorkflowDecisionCapture.Signature)
            {
                <div class="dp-card">
                    <div class="dp-card-head">
                        <span class="dp-card-ico">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        </span>
                        <div>
                            <h2 class="dp-card-title">Firma aqui</h2>
                            <p class="dp-card-desc">Por favor, firme en el espacio a continuacion con su dedo o el mouse. Su firma sera registrada como aprobacion.</p>
                        </div>
                    </div>
                    <div class="dp-sign-wrap">
                        <canvas @ref="_canvas" width="600" height="220" class="dp-sign"
                                @onmousedown="StartSigning" @ontouchstart="StartSigning"></canvas>
                        @if (!_signing)
                        {
                            <div class="dp-sign-hint">@SignHint</div>
                        }
                    </div>
                    <div class="dp-sign-actions">
                        <button type="button" class="dp-linkbtn" @onclick="ClearSignatureAsync">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            Borrar firma
                        </button>
                    </div>
                </div>
            }
            else if (_v.Capture == WorkflowDecisionCapture.Observation)
            {
                <div class="dp-card">
                    <div class="dp-card-head">
                        <span class="dp-card-ico">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </span>
                        <div>
                            <h2 class="dp-card-title">Observacion@(_v.ObservationRequired ? " *" : "")</h2>
                            <p class="dp-card-desc">Escribe tu comentario a continuacion; quedara registrado con tu decision.</p>
                        </div>
                    </div>
                    <textarea class="dp-text" rows="4" @bind="_observation" maxlength="1000"
                              placeholder="Escribe tu comentario..."></textarea>
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="dp-error">@_error</div>
            }

            <button class="dp-submit" @onclick="SubmitAsync" disabled="@_busy">
                <span class="dp-submit-check">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span class="dp-submit-lbl">@(_busy ? "Enviando..." : (_v.ButtonLabel ?? "Enviar"))</span>
                <span class="dp-submit-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
            </button>
        }
    </div>
</div>

<style>
    html, body { margin: 0; }
    .dp-page { min-height: 100vh; background: linear-gradient(180deg, #eef1fc 0%, #e7ecfb 100%); padding: 20px 14px 40px; box-sizing: border-box; font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
    .dp-wrap { max-width: 520px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }

    /* Header con gradiente */
    .dp-hero { position: relative; background: linear-gradient(120deg, #4f6ef7 0%, #6a5cf0 55%, #8b5cf0 100%); border-radius: 22px; padding: 22px 22px 24px; color: #fff; box-shadow: 0 12px 30px rgba(79, 110, 247, .28); overflow: hidden; }
    .dp-hero-icon { width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
    .dp-hero-icon svg { width: 30px; height: 30px; color: #fff; }
    .dp-hero-num { position: absolute; top: 20px; right: 20px; font-size: 12px; font-weight: 800; letter-spacing: .06em; color: #fff; background: rgba(255,255,255,.18); padding: 4px 12px; border-radius: 999px; }
    .dp-hero-title { font-size: 26px; line-height: 1.15; font-weight: 800; margin: 0 0 4px; color: #fff; }
    .dp-hero-company { font-size: 14px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.72); margin: 0; }

    /* Tarjeta blanca */
    .dp-card { background: #fff; border-radius: 20px; padding: 20px; box-shadow: 0 8px 24px rgba(30, 41, 90, .06); }
    .dp-card-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 16px; }
    .dp-card-ico { flex: none; width: 40px; height: 40px; border-radius: 50%; background: #eef3ff; display: flex; align-items: center; justify-content: center; }
    .dp-card-ico svg { width: 20px; height: 20px; color: #4f6ef7; }
    .dp-card-title { font-size: 19px; font-weight: 800; color: #1e2a5a; margin: 2px 0 6px; }
    .dp-card-desc { font-size: 14px; line-height: 1.5; color: #6b7280; margin: 0; }

    /* Firma */
    .dp-sign-wrap { position: relative; background: #f7f9ff; border-radius: 14px; padding: 8px; }
    .dp-sign { width: 100%; height: auto; border: 1.5px dashed #c3ccec; border-radius: 12px; background: #fff; touch-action: none; cursor: crosshair; display: block; }
    .dp-sign-hint { position: absolute; inset: 8px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 18px; color: #aeb7d6; font-size: 13.5px; font-style: italic; line-height: 1.4; pointer-events: none; }
    .dp-sign-actions { display: flex; justify-content: center; margin-top: 12px; }
    .dp-linkbtn { display: inline-flex; align-items: center; gap: 6px; background: none; border: none; color: #6b7280; font-size: 13px; font-weight: 600; cursor: pointer; }
    .dp-linkbtn svg { width: 16px; height: 16px; }
    .dp-linkbtn:hover { color: #4f6ef7; }

    .dp-text { width: 100%; box-sizing: border-box; border: 1.5px solid #e5e7eb; border-radius: 12px; padding: 12px; font-size: 14px; resize: vertical; }
    .dp-error { color: #dc2626; font-size: 13.5px; text-align: center; }

    /* Boton grande */
    .dp-submit { display: flex; align-items: center; gap: 12px; width: 100%; padding: 16px 20px; border: none; border-radius: 999px; background: linear-gradient(120deg, #4f6ef7 0%, #6a5cf0 100%); color: #fff; font-size: 17px; font-weight: 800; cursor: pointer; box-shadow: 0 12px 26px rgba(79, 110, 247, .32); }
    .dp-submit:disabled { opacity: .65; cursor: default; }
    .dp-submit-check { flex: none; width: 34px; height: 34px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; }
    .dp-submit-check svg { width: 18px; height: 18px; color: #4f6ef7; }
    .dp-submit-lbl { flex: 1; text-align: center; }
    .dp-submit-arrow { flex: none; display: flex; align-items: center; }
    .dp-submit-arrow svg { width: 22px; height: 22px; color: rgba(255,255,255,.9); }

    /* Estados (gracias / invalido / cargando) */
    .dp-state { background: #fff; border-radius: 20px; padding: 40px 24px; text-align: center; box-shadow: 0 8px 24px rgba(30, 41, 90, .06); }
    .dp-state-icon { width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .dp-state-icon svg { width: 34px; height: 34px; }
    .dp-state-icon.ok { background: #e8f7ee; color: #16a34a; }
    .dp-state-icon.off { background: #fdecec; color: #dc2626; }
    .dp-state-h { font-size: 19px; font-weight: 800; color: #1e2a5a; margin: 0 0 6px; }
    .dp-state-txt { font-size: 14px; color: #6b7280; margin: 0; }
</style>

@code {
    [Parameter] public string Token { get; set; } = "";

    private DecisionTokenValidation? _v;
    private bool _loading = true;
    private bool _busy;
    private bool _done;
    private string? _error;
    private string? _observation;

    private ElementReference _canvas;
    private IJSObjectReference? _pad;
    private bool _padReady;
    private bool _signing;

    // Texto guia (marca de agua) dentro del pad: explica QUE se firma. Se arma del contexto del enlace.
    private string SignHint
    {
        get
        {
            var accion = string.IsNullOrWhiteSpace(_v?.ButtonLabel) ? "confirmar" : _v!.ButtonLabel!.Trim().ToLowerInvariant();
            var ctx = string.IsNullOrWhiteSpace(_v?.ActivityTitle) ? _v?.ActivityNumber : _v!.ActivityTitle;
            return string.IsNullOrWhiteSpace(ctx)
                ? $"Dibuja tu firma para {accion}"
                : $"Dibuja tu firma para {accion} — {ctx}";
        }
    }

    private void StartSigning() => _signing = true;

    protected override async Task OnInitializedAsync()
    {
        _v = await DecisionSvc.ValidateAsync(Token);
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Inicializa el pad una sola vez cuando la captura es firma y el canvas ya esta en el DOM.
        if (!_padReady && !_done && _v is { IsValid: true, Capture: WorkflowDecisionCapture.Signature })
        {
            try
            {
                _pad = await JS.InvokeAsync<IJSObjectReference>("import", "/js/signature-pad.js");
                await _pad.InvokeVoidAsync("init", _canvas);
                _padReady = true;
            }
            catch { /* si el pad no carga, el submit avisara que falta la firma */ }
        }
    }

    private async Task ClearSignatureAsync()
    {
        if (_pad is not null) { try { await _pad.InvokeVoidAsync("clear", _canvas); } catch { } }
        _signing = false; // vuelve a mostrar la guia
    }

    private async Task SubmitAsync()
    {
        if (_v is not { IsValid: true, TenantId: Guid tenantId }) { return; }
        _busy = true;
        _error = null;

        DecisionSubmit submit;
        try
        {
            if (_v.Capture == WorkflowDecisionCapture.Signature)
            {
                var empty = _pad is null || await _pad.InvokeAsync<bool>("isEmpty", _canvas);
                if (empty) { _error = "Dibuja tu firma antes de enviar."; _busy = false; return; }
                var dataUrl = await _pad!.InvokeAsync<string>("dataUrl", _canvas);
                var (url, size) = SaveSignature(dataUrl);
                if (url is null) { _error = "No se pudo procesar la firma."; _busy = false; return; }
                submit = new DecisionSubmit(url, size, null);
            }
            else if (_v.Capture == WorkflowDecisionCapture.Observation)
            {
                if (_v.ObservationRequired && string.IsNullOrWhiteSpace(_observation))
                { _error = "La observacion es obligatoria."; _busy = false; return; }
                submit = new DecisionSubmit(Observation: _observation);
            }
            else
            {
                submit = new DecisionSubmit();
            }

            DecisionApplyResult result;
            using (AmbientTenantContext.Begin(tenantId))
            {
                result = await DecisionSvc.ApplyAsync(Token, submit);
            }
            if (!result.Ok) { _error = result.Error ?? "No se pudo registrar la decision."; _busy = false; return; }
            _done = true;
        }
        catch
        {
            _error = "No se pudo registrar la decision. Intenta de nuevo.";
        }
        finally { _busy = false; }
    }

    // Guarda el PNG de la firma bajo wwwroot/uploads/decisiones/{guid}.png y devuelve su URL relativa + tamano.
    private (string? url, long size) SaveSignature(string dataUrl)
    {
        try
        {
            var comma = dataUrl.IndexOf(',');
            var b64 = comma >= 0 ? dataUrl[(comma + 1)..] : dataUrl;
            var bytes = Convert.FromBase64String(b64);
            var dir = System.IO.Path.Combine(Env.WebRootPath, "uploads", "decisiones");
            System.IO.Directory.CreateDirectory(dir);
            var name = Guid.NewGuid().ToString("N") + ".png";
            System.IO.File.WriteAllBytes(System.IO.Path.Combine(dir, name), bytes);
            return ($"/uploads/decisiones/{name}", bytes.LongLength);
        }
        catch { return (null, 0); }
    }
}
