@page "/directorio-modular"
@attribute [Authorize(Policy = "TenantMember")]
@* 2do motor de contactos - "Directorio Modular" (Capa 8), version AVANZADA seleccionable.
   PRIMER SLICE VISUAL (Fase 2): pestanas de categorias + tarjetas de conteo + listado, alimentados
   por el seed (opcion A). La ficha por secciones y los modales de configuracion vienen despues. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Directorio
@using Ecorex.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IDirectorioCategoriaService Cats
@inject ITerceroService Terceros
@inject IDirectorioModularFichaService Fichas
@inject IDirectoryVariantService DirVariant
@inject Ecorex.Application.Asesores.IAsesorService Asesores
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Directorio General - ECOREX.tareas</PageTitle>

<div class="dm-wrap">
    <div class="dm-head">
        <div>
            <div class="dm-eyebrow">Catalogo 000232 &middot; negocio</div>
            <h1 class="dm-title">Directorio General</h1>
            <p class="dm-sub">Aqui encontraras todas las personas y organizaciones que han tenido y que mantienen relacion con la empresa, clasificadas segun su categoria dentro del directorio.</p>
        </div>
    </div>

    <div class="dm-toolbar">
        <button class="dm-btn" @onclick="OpenImport"><i class="fa fa-right-left"></i> Importar / Exportar Excel</button>
        <button class="dm-btn" @onclick="() => _configOpen = true"><i class="fa fa-gear"></i> Configurar directorio</button>
        <button class="dm-btn-primary" @onclick="() => _nuevoKey = _activo?.CategoriaKey" disabled="@(_activo is null)"><i class="fa fa-plus"></i> Nuevo en @(_activo?.Title ?? "categoria")</button>
    </div>

    <DirectorioModularFichaModal CategoriaKey="@(_editId is not null ? _editKey : _nuevoKey)" TerceroId="@_editId"
                                 OnClosed="OnFichaClosed" OnSaved="OnFichaSavedAsync" />
    <DirectorioModularConfigModal Show="_configOpen" OnClosed="OnConfigClosedAsync" />

    @* --- Mini-modal: nueva categoria --- *@
    @if (_nuevaCatOpen)
    {
        <div class="dm-ov" @onclick="() => _nuevaCatOpen = false">
            <div class="dm-dlg" @onclick:stopPropagation="true">
                <div class="dm-dlg-head">
                    <div class="dm-dlg-title">Nueva categoria</div>
                    <button class="dm-dlg-x" @onclick="() => _nuevaCatOpen = false">&times;</button>
                </div>
                <div class="dm-dlg-body">
                    <label class="dm-dlg-lbl">Nombre de la categoria</label>
                    <input class="dm-dlg-input" @bind="_nuevaCatTitle" @bind:event="oninput" placeholder="Ej. Aliados, Transportadores..." />
                    <p class="dm-dlg-hint">Se creara vacia; luego le agregas secciones desde "Configurar directorio".</p>
                    @if (_nuevaCatError is not null) { <div class="dm-dlg-err">@_nuevaCatError</div> }
                </div>
                <div class="dm-dlg-foot">
                    <button class="dm-btn" @onclick="() => _nuevaCatOpen = false" disabled="@_busy">Cancelar</button>
                    <button class="dm-btn-primary" @onclick="CrearCategoriaAsync" disabled="@_busy">@(_busy ? "Creando..." : "Crear")</button>
                </div>
            </div>
        </div>
    }

    @* --- Mini-modal: confirmar eliminacion --- *@
    @if (_delTarget is not null)
    {
        <div class="dm-ov" @onclick="() => _delTarget = null">
            <div class="dm-dlg" @onclick:stopPropagation="true">
                <div class="dm-dlg-head">
                    <div class="dm-dlg-title">Eliminar tercero</div>
                    <button class="dm-dlg-x" @onclick="() => _delTarget = null">&times;</button>
                </div>
                <div class="dm-dlg-body">
                    <p class="dm-dlg-hint">Vas a eliminar a <strong>@_delTarget.Nombre</strong>. Se marca como eliminado (borrado suave) y deja de aparecer en el directorio.</p>
                    @if (_delError is not null) { <div class="dm-dlg-err">@_delError</div> }
                </div>
                <div class="dm-dlg-foot">
                    <button class="dm-btn" @onclick="() => _delTarget = null" disabled="@_busy">Cancelar</button>
                    <button class="dm-btn-primary dm-btn-danger" @onclick="EliminarConfirmadoAsync" disabled="@_busy">@(_busy ? "Eliminando..." : "Eliminar")</button>
                </div>
            </div>
        </div>
    }

    @* --- Modal: Importar por archivo (reusa la plantilla del Directorio basico) --- *@
    @if (_impOpen)
    {
        <div class="dm-ov" @onclick="CloseImport">
            <div class="dm-dlg dm-dlg-lg" @onclick:stopPropagation="true">
                <div class="dm-dlg-head">
                    <div class="dm-dlg-title">Importar contactos por archivo</div>
                    <button class="dm-dlg-x" @onclick="CloseImport">&times;</button>
                </div>
                <div class="dm-dlg-body">
                    <p class="dm-dlg-hint">Los contactos se crean en la categoria <strong>@(_activo?.Title ?? "Publico")</strong> del motor Modular. Usa la misma plantilla del Directorio basico.</p>
                    <div class="dm-imp-actions">
                        <button class="dm-btn" @onclick="DownloadTemplateAsync" disabled="@_downloadingTpl">
                            <i class="fa fa-download"></i> @(_downloadingTpl ? "Generando..." : "Descargar plantilla")
                        </button>
                        <label class="dm-btn dm-imp-file">
                            <i class="fa fa-file-arrow-up"></i> Elegir archivo .xlsx
                            <InputFile OnChange="OnImportFileAsync" accept=".xlsx" style="display:none" />
                        </label>
                        @if (_impFileName is not null) { <span class="dm-muted">@_impFileName</span> }
                    </div>

                    @if (_impBusy && _impParse is null) { <div class="dm-muted">Leyendo archivo...</div> }
                    @if (_impFatal is not null) { <div class="dm-dlg-err">@_impFatal</div> }

                    @if (_impParse is not null && _impFatal is null)
                    {
                        <div class="dm-imp-sum">
                            <span class="dm-imp-chip">Total: <strong>@_impParse.Total</strong></span>
                            <span class="dm-imp-chip dm-imp-ok">A crear: <strong>@ImportableCount</strong></span>
                            @if (_impParse.Invalid > 0) { <span class="dm-imp-chip dm-imp-bad">Con error: <strong>@_impParse.Invalid</strong></span> }
                            @if (_impDupRows.Count > 0) { <span class="dm-imp-chip dm-imp-dup">Duplicados (se omiten): <strong>@_impDupRows.Count</strong></span> }
                        </div>
                        @if (_impFinished)
                        {
                            <div class="dm-dlg-hint">Importacion terminada: <strong>@_impDone creado(s)</strong>@(_impFailed > 0 ? $", {_impFailed} con error" : "")@(_impSkipped > 0 ? $", {_impSkipped} omitido(s)" : "").</div>
                        }
                    }
                </div>
                <div class="dm-dlg-foot">
                    <button class="dm-btn" @onclick="CloseImport" disabled="@_impBusy">@(_impFinished ? "Cerrar" : "Cancelar")</button>
                    @if (!_impFinished)
                    {
                        <button class="dm-btn-primary" @onclick="RunImportAsync" disabled="@(_impBusy || ImportableCount == 0)">
                            @(_impBusy && _impParse is not null ? $"Importando... ({_impDone})" : $"Importar {ImportableCount}")
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @* --- Mini-modal: confirmar migracion Clasico -> Modular --- *@
    @if (_migrarOpen)
    {
        <div class="dm-ov" @onclick="() => _migrarOpen = false">
            <div class="dm-dlg" @onclick:stopPropagation="true">
                <div class="dm-dlg-head">
                    <div class="dm-dlg-title">Migrar del Directorio Clasico</div>
                    <button class="dm-dlg-x" @onclick="() => _migrarOpen = false">&times;</button>
                </div>
                <div class="dm-dlg-body">
                    <p class="dm-dlg-hint">Se pasaran <strong>@_clasicoCount contacto(s)</strong> del motor Clasico al Modular. Cada uno entra a la categoria <strong>Publico</strong> y conserva sus datos (nombre, identificacion, correo, telefono, ciudad). No se borra nada del Clasico.</p>
                    @if (_migrarError is not null) { <div class="dm-dlg-err">@_migrarError</div> }
                </div>
                <div class="dm-dlg-foot">
                    <button class="dm-btn" @onclick="() => _migrarOpen = false" disabled="@_busy">Cancelar</button>
                    <button class="dm-btn-primary" @onclick="MigrarAsync" disabled="@_busy">@(_busy ? "Migrando..." : $"Migrar {_clasicoCount}")</button>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <p class="dm-muted">Cargando...</p>
    }
    else
    {
        @* --- Aviso de migracion pendiente desde el motor Clasico --- *@
        @if (_clasicoCount > 0)
        {
            <div class="dm-migra">
                <div class="dm-migra-txt">
                    <i class="fa fa-arrows-turn-right"></i>
                    <span>Hay <strong>@_clasicoCount contacto(s)</strong> en el Directorio Clasico que aun no estan en este motor.</span>
                </div>
                <button class="dm-btn-primary" @onclick="() => { _migrarOpen = true; _migrarError = null; }"><i class="fa fa-right-left"></i> Migrar al Modular</button>
            </div>
        }

        @* --- Tarjetas de conteo: clicables como filtro (org/persona/por asignar), como el prototipo --- *@
        <div class="dm-cards">
            @{ var accent = _activo?.Color ?? "#4f46e5"; }
            <div class="dm-card dm-card-clic @(_cardFilter is null ? "on" : "")" style="@(_cardFilter is null ? $"border-color:{accent}" : "")" @onclick='() => _cardFilter = null'>
                <span class="dm-card-ico" style="background:@Tint(accent)"><i class="fa @(_activo?.Icono ?? "fa-address-book")" style="color:@accent"></i></span>
                <div><div class="dm-card-n" style="color:@accent">@(_activo is null ? _total : CatCount(_activo))</div><div class="dm-card-l">@(_activo?.Title ?? "Total")</div></div>
            </div>
            <div class="dm-card dm-card-clic @(_cardFilter == "org" ? "on" : "")" style="@(_cardFilter == "org" ? "border-color:#0ea5e9" : "")" @onclick='() => ToggleCard("org")'>
                <span class="dm-card-ico" style="background:@Tint("#0ea5e9")"><i class="fa fa-building" style="color:#0ea5e9"></i></span>
                <div><div class="dm-card-n" style="color:#0ea5e9">@_orgs</div><div class="dm-card-l">Organizaciones</div></div>
            </div>
            <div class="dm-card dm-card-clic @(_cardFilter == "per" ? "on" : "")" style="@(_cardFilter == "per" ? "border-color:#10b981" : "")" @onclick='() => ToggleCard("per")'>
                <span class="dm-card-ico" style="background:@Tint("#10b981")"><i class="fa fa-user" style="color:#10b981"></i></span>
                <div><div class="dm-card-n" style="color:#10b981">@_personas</div><div class="dm-card-l">Personas</div></div>
            </div>
            <div class="dm-card dm-card-clic @(_cardFilter == "porasignar" ? "on" : "")" style="@(_cardFilter == "porasignar" ? "border-color:#f59e0b" : "")" @onclick='() => ToggleCard("porasignar")'>
                <span class="dm-card-ico" style="background:@Tint("#f59e0b")"><i class="fa fa-circle-question" style="color:#f59e0b"></i></span>
                <div><div class="dm-card-n" style="color:#f59e0b">@_porAsignar</div><div class="dm-card-l">Por asignar</div></div>
            </div>
            <div class="dm-card">
                <span class="dm-card-ico" style="background:@Tint("#8b5cf6")"><i class="fa fa-seedling" style="color:#8b5cf6"></i></span>
                <div><div class="dm-card-n" style="color:#8b5cf6">@_nuevos</div><div class="dm-card-l">Nuevos (30 dias)</div></div>
            </div>
        </div>

        @* --- Pestanas de categorias con conteo --- *@
        <div class="dm-tabs">
            <span class="dm-tabs-lbl">Categoria:</span>
            @* Orden como el prototipo: Publico (base) primero, el resto alfabetico. *@
            @foreach (var c in _cats.OrderBy(x => x.CategoriaKey == "publico" ? 0 : 1).ThenBy(x => x.Title, StringComparer.OrdinalIgnoreCase))
            {
                var on = _activo?.CategoriaKey == c.CategoriaKey;
                <button class="dm-tab @(on ? "on" : "")" style="@(on ? $"--dm-accent:{c.Color ?? "#4f46e5"}" : "")"
                        @onclick="() => _activo = c">
                    <i class="fa @c.Icono"></i> @c.Title
                    <span class="dm-tab-n">@CatCount(c)</span>
                    @if (c.Protegido) { <span class="dm-lock" title="Categoria base (no se elimina)"><i class="fa fa-lock"></i></span> }
                </button>
            }
            <button class="dm-tab-add" title="Crear categoria" @onclick="() => { _nuevaCatOpen = true; _nuevaCatTitle = string.Empty; _nuevaCatError = null; }"><i class="fa fa-plus"></i></button>
        </div>

        @* --- Buscador --- *@
        <div class="dm-search">
            <i class="fa fa-search"></i>
            <input placeholder="Buscar por nombre, contacto, NIT, telefono, correo o codigo..." @bind="_search" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button class="dm-search-x" title="Limpiar" @onclick="() => _search = string.Empty"><i class="fa fa-xmark"></i></button>
            }
        </div>

        @* --- Listado (filtrado por categoria activa + busqueda) --- *@
        @if (Visibles().Count == 0)
        {
            <div class="dm-empty">
                @if (_rows.Count == 0)
                {
                    <text>Aun no hay terceros en el catalogo.</text>
                }
                else
                {
                    <text>Ningun tercero coincide con el filtro actual.</text>
                }
            </div>
        }
        else
        {
            <div class="dm-table-wrap">
                <table class="dm-table">
                    <thead>
                        <tr>
                            <th class="dm-th-exp"></th>
                            <th>Tercero</th>
                            <th>Identificacion</th>
                            <th>Responsable</th>
                            <th>Estado</th>
                            <th class="dm-th-acc">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Visibles())
                        {
                            var tid = t.Id;
                            var canExpand = t.EsEmpresa && t.ContadorContactos > 0;
                            <tr>
                                <td class="dm-td-exp">
                                    @if (canExpand)
                                    {
                                        <button class="dm-exp @(_expanded.Contains(tid) ? "on" : "")" title="Ver contactos" @onclick="() => ToggleExpand(tid)"><i class="fa fa-chevron-right"></i></button>
                                    }
                                </td>
                                <td>
                                    <div class="dm-tercero">
                                        <span class="dm-avatar" style="background:@AvatarColor(t.Nombre)">@Initials(t.Nombre)</span>
                                        <div class="dm-tercero-body">
                                            <div class="dm-tercero-top">
                                                <span class="dm-name">@t.Nombre</span>
                                                @if (t.EsEmpresa)
                                                {
                                                    <span class="dm-nat dm-nat-org">Organizacion@(t.ContadorContactos > 0 ? $" · {t.ContadorContactos}" : "")</span>
                                                }
                                                else
                                                {
                                                    <span class="dm-nat dm-nat-per">Persona</span>
                                                }
                                            </div>
                                            <div class="dm-chiprow">
                                                @if (!ChipsDe(tid).Any())
                                                {
                                                    <span class="dm-por-asignar">Por asignar</span>
                                                }
                                                else
                                                {
                                                    @foreach (var ch in ChipsDe(tid))
                                                    {
                                                        <span class="dm-catchip" style="background:@Tint(ch.Color);color:@ch.Color">@ch.Title</span>
                                                    }
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(t.Sub) || (!t.EsEmpresa && !string.IsNullOrWhiteSpace(t.EmpresaNombre)))
                                            {
                                                <div class="dm-tercero-sub">
                                                    @if (!string.IsNullOrWhiteSpace(t.Sub)) { <span>@t.Sub</span> }
                                                    @if (!t.EsEmpresa && !string.IsNullOrWhiteSpace(t.EmpresaNombre))
                                                    {
                                                        <span class="dm-link"><i class="fa fa-link"></i> @t.EmpresaNombre</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="dm-mono">@(string.IsNullOrWhiteSpace(t.Identificacion) ? "-" : t.Identificacion)</td>
                                <td class="dm-resp">@Responsable(t)</td>
                                <td>
                                    @if (t.Estado == TerceroEstado.Inactivo)
                                    {
                                        <span class="dm-chip dm-chip-off">Inactivo</span>
                                    }
                                    else
                                    {
                                        <span class="dm-chip dm-chip-on">Activo</span>
                                    }
                                </td>
                                <td class="dm-acc">
                                    <button class="dm-acc-btn" title="Editar" @onclick="() => OpenEditar(t)"><i class="fa fa-pen"></i></button>
                                    <button class="dm-acc-btn dm-acc-del" title="Eliminar" @onclick="() => PedirEliminar(t)"><i class="fa fa-trash"></i></button>
                                </td>
                            </tr>
                            @if (canExpand && _expanded.Contains(tid))
                            {
                                <tr class="dm-exp-row">
                                    <td></td>
                                    <td colspan="5" class="dm-exp-cell">
                                        @if (!_childs.TryGetValue(tid, out var hijos))
                                        {
                                            <span class="dm-exp-lbl"><i class="fa fa-users"></i> Cargando contactos...</span>
                                        }
                                        else if (hijos.Count == 0)
                                        {
                                            <span class="dm-exp-lbl"><i class="fa fa-users"></i> Sin contactos asociados.</span>
                                        }
                                        else
                                        {
                                            <span class="dm-exp-lbl"><i class="fa fa-users"></i> @hijos.Count contacto(s) asociado(s)</span>
                                            <div class="dm-childs">
                                                @foreach (var h in hijos)
                                                {
                                                    <div class="dm-child">
                                                        <span class="dm-child-av" style="background:@AvatarColor(h.Nombre)">@Initials(h.Nombre)</span>
                                                        <div class="dm-child-body">
                                                            <div class="dm-child-name">@h.Nombre @if (!string.IsNullOrWhiteSpace(h.Cargo)) { <span class="dm-child-cargo">&middot; @h.Cargo</span> }</div>
                                                            <div class="dm-child-meta">
                                                                @if (!string.IsNullOrWhiteSpace(h.Telefono)) { <span><i class="fa fa-phone"></i> @h.Telefono</span> }
                                                                @if (!string.IsNullOrWhiteSpace(h.Email)) { <span><i class="fa fa-envelope"></i> @h.Email</span> }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="dm-foot">
            <span class="dm-muted">@_cats.Count categorias &middot; @_secciones secciones &middot; @_campos campos configurados (seed del prototipo)</span>
        </div>
    }
</div>

<style>
    .dm-wrap { font-family: 'Inter', system-ui, sans-serif; color: #1f2937; padding: 22px 26px; max-width: 1240px; }
    .dm-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 18px; }
    .dm-eyebrow { font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #6366f1; }
    .dm-title { font-size: 24px; font-weight: 800; margin: 2px 0 4px; }
    .dm-sub { font-size: 13px; color: #6b7280; margin: 0; max-width: 640px; }
    .dm-muted { color: #9ca3af; font-size: 12.5px; }
    .dm-btn-primary { background: #111827; color: #fff; border: none; border-radius: 9px; padding: 9px 16px; font-size: 13px; font-weight: 700; cursor: pointer; white-space: nowrap; display: inline-flex; align-items: center; gap: 7px; }
    .dm-btn-primary:hover { background: #0b0f1a; }
    .dm-btn-primary:disabled { opacity: .5; cursor: not-allowed; }
    .dm-btn-danger { background: #dc2626; } .dm-btn-danger:hover { background: #b91c1c; }

    .dm-tabs { display: flex; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid #eef0f3; padding-bottom: 12px; margin-bottom: 16px; }
    .dm-tab { --dm-accent: #4f46e5; display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1px solid #e5e7eb; color: #374151; border-radius: 999px; padding: 7px 15px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .12s; }
    .dm-tab:hover { border-color: #c7cbd1; }
    .dm-tab.on { background: #111827; border-color: #111827; color: #fff; }
    .dm-tab i { font-size: 12px; }
    .dm-lock { opacity: .6; font-size: 10px; }

    .dm-toolbar { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .dm-btn { display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1px solid #e5e7eb; color: #374151; border-radius: 9px; padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .dm-btn:disabled { opacity: .55; cursor: not-allowed; }
    .dm-toolbar .dm-btn-primary { margin-left: auto; }

    .dm-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 16px; }
    .dm-card { background: #fff; border: 1px solid #eef0f3; border-radius: 12px; padding: 13px 15px; box-shadow: 0 1px 2px rgba(16,24,40,.04); display: flex; align-items: center; gap: 12px; }
    .dm-card-ico { width: 38px; height: 38px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
    .dm-card-clic { cursor: pointer; transition: border-color .15s ease, box-shadow .15s ease; }
    .dm-card-clic:hover { box-shadow: 0 2px 8px rgba(16,24,40,.08); }
    .dm-card.on { border-width: 1.5px; box-shadow: 0 2px 8px rgba(16,24,40,.08); }
    .dm-card-n { font-size: 24px; font-weight: 800; line-height: 1; }
    .dm-card-l { font-size: 12px; color: #6b7280; margin-top: 5px; }

    .dm-tabs-lbl { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; align-self: center; margin-right: 2px; }
    .dm-tab-n { background: rgba(17,24,39,.06); color: inherit; font-size: 11px; font-weight: 700; border-radius: 999px; padding: 1px 7px; margin-left: 2px; }
    .dm-tab.on .dm-tab-n { background: rgba(255,255,255,.22); color: #fff; }
    .dm-tab-add { border: 1px dashed #c7cbd1; background: #fff; color: #6b7280; border-radius: 999px; width: 30px; height: 30px; cursor: pointer; font-size: 12px; display: inline-flex; align-items: center; justify-content: center; }
    .dm-tab-add:hover { border-color: #4f46e5; color: #4f46e5; }

    .dm-ov { position: fixed; inset: 0; background: rgba(17,24,39,.45); display: flex; align-items: center; justify-content: center; z-index: 70; padding: 20px; }
