    .dm-th-acc { text-align: right; }
    .dm-mono { font-variant-numeric: tabular-nums; color: #4b5563; }
    .dm-resp { color: #4b5563; }

    .dm-exp { border: none; background: none; color: #9ca3af; cursor: pointer; padding: 4px; transition: transform .12s; }
    .dm-exp.on { transform: rotate(90deg); color: #4f46e5; }

    .dm-tercero { display: flex; align-items: center; gap: 11px; }
    .dm-avatar { width: 34px; height: 34px; border-radius: 9px; color: #fff; font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .dm-tercero-body { min-width: 0; }
    .dm-tercero-top { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .dm-name { font-weight: 700; color: #111827; }
    .dm-nat { font-size: 10.5px; font-weight: 700; border-radius: 999px; padding: 2px 8px; }
    .dm-nat-org { background: #eff6ff; color: #1d4ed8; }
    .dm-nat-per { background: #f0fdf4; color: #15803d; }
    .dm-chiprow { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }
    .dm-catchip { font-size: 10.5px; font-weight: 700; border-radius: 6px; padding: 1px 7px; }
    .dm-tercero-sub { font-size: 11.5px; color: #9ca3af; margin-top: 3px; }

    .dm-acc { text-align: right; white-space: nowrap; }
    .dm-acc-btn { border: 1px solid #e5e7eb; background: #fff; color: #6b7280; border-radius: 7px; width: 30px; height: 30px; cursor: pointer; margin-left: 5px; }
    .dm-acc-btn:hover { background: #f9fafb; }
    .dm-acc-del:hover { color: #dc2626; border-color: #fecaca; }

    .dm-exp-row td { background: #fafafe; }
    .dm-exp-cell { color: #6b7280; font-size: 12px; }
    .dm-exp-cell i { color: #4f46e5; margin-right: 6px; }

    .dm-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600; border-radius: 999px; padding: 3px 9px; }
    .dm-chip-on { background: #ecfdf5; color: #059669; }
    .dm-chip-off { background: #f3f4f6; color: #6b7280; }

    .dm-empty { background: #fff; border: 1px dashed #e5e7eb; border-radius: 12px; padding: 40px; text-align: center; color: #9ca3af; font-size: 13.5px; }
    .dm-foot { margin-top: 14px; }
</style>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _nuevoKey;   // categoria del modal de creacion abierto (null = cerrado)
    private bool _nuevaCatOpen;
    private string _nuevaCatTitle = string.Empty;
    private string? _nuevaCatError;
    private IReadOnlyList<DirectorioCategoriaDto> _cats = Array.Empty<DirectorioCategoriaDto>();
    private IReadOnlyDictionary<string, int> _catCounts = new Dictionary<string, int>();
    private IReadOnlyDictionary<Guid, List<string>> _memberships = new Dictionary<Guid, List<string>>();
    private readonly HashSet<Guid> _expanded = new();
    private DirectorioCategoriaDto? _activo;
    private IReadOnlyList<TerceroListItemDto> _rows = Array.Empty<TerceroListItemDto>();
    private int _total, _orgs, _personas, _porAsignar, _nuevos, _secciones, _campos;

    protected override async Task OnInitializedAsync()
    {
        // ListAsync siembra las categorias/secciones/campos por defecto si el tenant no las tiene (seed opcion A).
        _cats = await Cats.ListAsync();
        _catCounts = await Cats.CountByCategoriaAsync();
        _memberships = await Cats.MembershipsAsync();
        _activo = _cats.FirstOrDefault();

        _rows = await Terceros.ListAsync(new TerceroListFilter());
        _total = _rows.Count;
        _orgs = _rows.Count(r => r.EsEmpresa);
        _personas = _rows.Count(r => r.EsPersona);
        // En este slice, "por asignar" = todos (aun no hay pertenencias a categorias); "nuevos" queda en 0.
        _porAsignar = _total;
        _nuevos = 0;

        _secciones = DirectorioModularDefaults.Secciones.Length;
        _campos = DirectorioModularDefaults.Campos.Length;

        _loading = false;
    }

    private async Task OnCreatedAsync()
    {
        _nuevoKey = null; // cierra el modal
        // Recarga listado y contadores tras crear un tercero.
        _rows = await Terceros.ListAsync(new TerceroListFilter());
        _total = _rows.Count;
        _orgs = _rows.Count(r => r.EsEmpresa);
        _personas = _rows.Count(r => r.EsPersona);
        _porAsignar = _total;
        _catCounts = await Cats.CountByCategoriaAsync();
        _memberships = await Cats.MembershipsAsync();
    }

    // Conteo por pestana: la categoria base (Publico) es el total del catalogo; las demas, por membership.
    private int CatCount(DirectorioCategoriaDto c)
        => c.Protegido ? _total : (_catCounts.TryGetValue(c.CategoriaKey, out var n) ? n : 0);

    // Fondo tenue del color de acento para el icono de la tarjeta / chip.
    private static string Tint(string hex) => $"color-mix(in srgb, {hex} 14%, #fff)";

    private async Task CrearCategoriaAsync()
    {
        _nuevaCatError = null;
        var title = (_nuevaCatTitle ?? string.Empty).Trim();
        if (title.Length is 0 or > 80) { _nuevaCatError = "El nombre es obligatorio (maximo 80)."; return; }
        _busy = true;
        try
        {
            var dto = await Cats.CreateAsync(new CreateDirectorioCategoriaRequest(title));
            if (dto is null) { _nuevaCatError = "No se pudo crear la categoria."; return; }
            _nuevaCatOpen = false;
            _cats = await Cats.ListAsync();
            _catCounts = await Cats.CountByCategoriaAsync();
            _activo = _cats.FirstOrDefault(c => c.CategoriaKey == dto.CategoriaKey) ?? _activo;
        }
        catch (Exception ex) { _nuevaCatError = ex.Message; }
        finally { _busy = false; }
    }

    private void ToggleExpand(Guid id)
    {
        if (!_expanded.Add(id)) { _expanded.Remove(id); }
    }

    // Chips de categoria de una fila: Publico (base, siempre) + sus membresias, mapeadas a titulo/color.
    private IEnumerable<(string Title, string Color)> ChipsDe(Guid tid)
    {
        var keys = new List<string> { "publico" };
        if (_memberships.TryGetValue(tid, out var ms)) { keys.AddRange(ms); }
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var k in keys)
        {
            if (!seen.Add(k)) { continue; }
            var cat = _cats.FirstOrDefault(c => string.Equals(c.CategoriaKey, k, StringComparison.OrdinalIgnoreCase));
            yield return (cat?.Title ?? k, cat?.Color ?? "#4f46e5");
        }
    }

    private static string Responsable(TerceroListItemDto t)
        => !string.IsNullOrWhiteSpace(t.VendedorAsesorNombre) ? t.VendedorAsesorNombre!
         : !string.IsNullOrWhiteSpace(t.Vendedor) ? t.Vendedor! : "—";

    private static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) { return "?"; }
        var a = parts[0][..1];
        var b = parts.Length > 1 ? parts[1][..1] : "";
        return (a + b).ToUpperInvariant();
    }

    private static readonly string[] _avPalette = { "#4f46e5", "#0ea5e9", "#10b981", "#f59e0b", "#8b5cf6", "#ef4444", "#0891b2", "#db2777" };
    private static string AvatarColor(string? name)
    {
        var h = 0;
        foreach (var ch in name ?? "") { h = (h * 31 + ch) & 0x7fffffff; }
        return _avPalette[h % _avPalette.Length];
    }
}
