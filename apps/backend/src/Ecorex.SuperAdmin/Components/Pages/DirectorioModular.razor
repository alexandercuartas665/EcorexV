</style>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _nuevoKey;   // categoria del modal de creacion abierto (null = cerrado)
    private Guid? _editId;       // tercero en edicion (null = no editando)
    private string? _editKey;    // categoria base para abrir el modal de edicion
    private bool _configOpen;    // modal "Configurar directorio" abierto
    private string _search = string.Empty;   // texto de busqueda del listado
    private string? _cardFilter;             // filtro por tarjeta de conteo: null | "org" | "per" | "porasignar"
    private TerceroListItemDto? _delTarget;   // tercero pendiente de confirmar eliminacion
    private string? _delError;
    private int _clasicoCount;               // contactos del motor Clasico pendientes de migrar
    private bool _migrarOpen;
    private string? _migrarError;

    // --- Importar por archivo (reusa el parser/plantilla del Directorio basico) ---
    private bool _impOpen, _impBusy, _impFinished, _downloadingTpl;
    private string? _impFileName, _impFatal;
    private TerceroImportXlsx.TerceroImportParse? _impParse;
    private readonly HashSet<int> _impDupRows = new();
    private int _impDone, _impFailed, _impSkipped;
    private int ImportableCount => _impParse?.Rows.Count(r => r.IsValid && !_impDupRows.Contains(r.RowNumber)) ?? 0;
    private const long ImpMaxBytes = 12L * 1024 * 1024;
    private bool _nuevaCatOpen;
    private string _nuevaCatTitle = string.Empty;
    private string? _nuevaCatError;
    private IReadOnlyList<DirectorioCategoriaDto> _cats = Array.Empty<DirectorioCategoriaDto>();
    private IReadOnlyDictionary<string, int> _catCounts = new Dictionary<string, int>();
    private IReadOnlyDictionary<Guid, List<string>> _memberships = new Dictionary<Guid, List<string>>();
    private readonly HashSet<Guid> _expanded = new();
    private readonly Dictionary<Guid, IReadOnlyList<TerceroContactoDto>> _childs = new();
    private DirectorioCategoriaDto? _activo;
    private IReadOnlyList<TerceroListItemDto> _rows = Array.Empty<TerceroListItemDto>();
    private int _total, _orgs, _personas, _porAsignar, _nuevos, _secciones, _campos;

    protected override async Task OnInitializedAsync()
    {
        // Gate: esta pagina solo la atiende el tenant con la variante Modular (hoy SOLDARCO). Otros,
        // redirigen al Directorio General clasico. Defensa en profundidad ademas del menu.
        if (await DirVariant.GetAsync() != DirectoryVariant.Modular)
        {
            Nav.NavigateTo("/directorio-general", forceLoad: false, replace: true);
            return;
        }

        // ListAsync siembra las categorias/secciones/campos por defecto si el tenant no las tiene (seed opcion A).
        _cats = await Cats.ListAsync();
        _catCounts = await Cats.CountByCategoriaAsync();
        _memberships = await Cats.MembershipsAsync();
        _activo = _cats.FirstOrDefault();

        _nuevos = 0;
        await ReloadListAsync();

        _secciones = DirectorioModularDefaults.Secciones.Length;
        _campos = DirectorioModularDefaults.Campos.Length;

        _loading = false;
    }

    // Recarga listado, contadores por categoria, membresias y el conteo de Clasico pendiente de migrar.
    private async Task ReloadListAsync()
    {
        _rows = await Terceros.ListAsync(new TerceroListFilter(Engine: DirectoryEngine.Modular, IncludeSubContacts: true));
        _total = _rows.Count;
        _orgs = _rows.Count(r => r.EsEmpresa);
        _personas = _rows.Count(r => r.EsPersona);
        _catCounts = await Cats.CountByCategoriaAsync();
        _memberships = await Cats.MembershipsAsync();
        // "Por asignar" = terceros sin categoria mas alla de la base (se calcula tras cargar membresias).
        _porAsignar = _rows.Count(r => SoloBase(r.Id));
        _clasicoCount = await Fichas.CountClasicoAsync();
    }

    private void OpenImport()
    {
        _impOpen = true; _impParse = null; _impFatal = null; _impFileName = null;
        _impDone = 0; _impFailed = 0; _impSkipped = 0; _impFinished = false; _impDupRows.Clear();
    }

    private void CloseImport() { if (!_impBusy) { _impOpen = false; } }

    private async Task DownloadTemplateAsync()
    {
        _downloadingTpl = true;
        try
        {
            var asesores = await Asesores.ListOptionsAsync();
            var vendedores = asesores.Select(a => a.Nombre);
            var ciudades = _rows.Select(r => r.Ciudad).Where(c => !string.IsNullOrWhiteSpace(c)).Select(c => c!);
            var bytes = TerceroTemplateXlsx.Build(vendedores, ciudades);
            await JS.InvokeVoidAsync("ecorexDescargarArchivo", "plantilla-directorio.xlsx", TerceroTemplateXlsx.Mime, Convert.ToBase64String(bytes));
        }
        finally { _downloadingTpl = false; }
    }

    private async Task OnImportFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _impFileName = file.Name;
        _impParse = null; _impFatal = null; _impDone = 0; _impFailed = 0; _impSkipped = 0; _impFinished = false; _impDupRows.Clear();
        _impBusy = true;
        try
        {
            if (file.Size > ImpMaxBytes) { _impFatal = "El archivo supera el limite de 12 MB."; return; }
            using var ms = new System.IO.MemoryStream();
            await file.OpenReadStream(ImpMaxBytes).CopyToAsync(ms);
            ms.Position = 0;
            var asesores = await Asesores.ListOptionsAsync();
            var byName = new Dictionary<string, Guid>(StringComparer.OrdinalIgnoreCase);
            foreach (var a in asesores) { byName[a.Nombre] = a.Id; }
            _impParse = TerceroImportXlsx.Parse(ms, byName);
            if (_impParse.FatalError is not null) { _impFatal = _impParse.FatalError; }
            else { await ComputeDuplicatesAsync(); }
        }
        catch (Exception ex) { _impFatal = "No se pudo procesar el archivo: " + ex.Message; }
        finally { _impBusy = false; }
    }

    private async Task ComputeDuplicatesAsync()
    {
        _impDupRows.Clear();
        if (_impParse is null) { return; }
        var keys = await Terceros.GetDedupKeysAsync();
        var seenDocs = new HashSet<string>(keys.Documentos, StringComparer.Ordinal);
        var seenNames = new HashSet<string>(keys.Nombres, StringComparer.Ordinal);
        foreach (var row in _impParse.Rows.Where(r => r.IsValid))
        {
            var dup = row.DocKey is not null ? !seenDocs.Add(row.DocKey) : !seenNames.Add(row.NameKey);
            if (dup) { _impDupRows.Add(row.RowNumber); }
        }
    }

    private async Task RunImportAsync()
    {
        if (_impParse is null || _impBusy) { return; }
        var toCreate = _impParse.Rows.Where(r => r.IsValid && !_impDupRows.Contains(r.RowNumber)).ToList();
        _impSkipped = _impParse.Rows.Count(r => r.IsValid && _impDupRows.Contains(r.RowNumber));
        if (toCreate.Count == 0) { _impFinished = true; return; }
        _impBusy = true; _impDone = 0; _impFailed = 0;
        try
        {
            var (done, failed) = await Fichas.ImportAsync(_activo?.CategoriaKey ?? "publico", toCreate);
            _impDone = done; _impFailed = failed; _impFinished = true;
            await ReloadListAsync();
        }
        finally { _impBusy = false; }
    }

    private async Task MigrarAsync()
    {
        _migrarError = null;
        _busy = true;
        try
        {
            await Fichas.MigrateAllFromClasicoAsync();
            _migrarOpen = false;
            await ReloadListAsync();
        }
        catch (Exception ex) { _migrarError = ex.Message; }
        finally { _busy = false; }
    }

    // Abre el modal de ficha en modo EDICION para el tercero dado. La categoria base es su primera
    // pertenencia (o la activa/Publico como respaldo); el modal re-deduce la real al cargar.
    private void OpenEditar(TerceroListItemDto t)
    {
        _editKey = (_memberships.TryGetValue(t.Id, out var ks) && ks.Count > 0)
            ? ks[0]
            : (_activo?.CategoriaKey ?? "publico");
        _editId = t.Id;
    }

    private void OnFichaClosed()
    {
        _nuevoKey = null;
        _editId = null;
        _editKey = null;
    }

    // Tras crear o editar un tercero: cierra el modal y recarga listado, contadores y membresias.
    private async Task OnFichaSavedAsync()
    {
        _nuevoKey = null;
        _editId = null;
        _editKey = null;
        await ReloadListAsync();
    }

    // Al cerrar "Configurar directorio": recarga categorias y conteos (pudo cambiar la composicion).
    private async Task OnConfigClosedAsync()
    {
        _configOpen = false;
        _cats = await Cats.ListAsync();
        _catCounts = await Cats.CountByCategoriaAsync();
        _memberships = await Cats.MembershipsAsync();
        if (_activo is not null)
        {
            _activo = _cats.FirstOrDefault(c => c.CategoriaKey == _activo.CategoriaKey) ?? _cats.FirstOrDefault();
        }
    }

    private void PedirEliminar(TerceroListItemDto t)
    {
        _delTarget = t;
        _delError = null;
    }

    private async Task EliminarConfirmadoAsync()
    {
        if (_delTarget is null) { return; }
        _delError = null;
        _busy = true;
        try
        {
            var res = await Terceros.DeleteAsync(_delTarget.Id);
            if (!res.IsOk) { _delError = res.Error ?? "No se pudo eliminar."; return; }
            _delTarget = null;
            await ReloadListAsync();   // recarga listado y contadores tras el borrado suave
        }
        catch (Exception ex) { _delError = ex.Message; }
        finally { _busy = false; }
    }

    // Filas visibles del listado: filtradas por la categoria activa (la base Publico muestra todo) y por
    // el texto de busqueda (nombre, identificacion, ciudad, subtitulo y valores filtrables).
    private List<TerceroListItemDto> Visibles()
    {
        IEnumerable<TerceroListItemDto> q = _rows;

        // Filtro por categoria: la base (Publico/protegida) no filtra; las demas, por pertenencia.
        if (_activo is not null && !_activo.Protegido)
        {
            var key = _activo.CategoriaKey;
            q = q.Where(t => _memberships.TryGetValue(t.Id, out var ks) && ks.Contains(key));
        }

        // Filtro por tarjeta de conteo (se combina con la categoria y la busqueda).
        q = _cardFilter switch
        {
            "org" => q.Where(t => t.EsEmpresa),
            "per" => q.Where(t => t.EsPersona),
            "porasignar" => q.Where(t => SoloBase(t.Id)),
            _ => q
        };

        // Busqueda libre (case/acentos-insensible simple por minusculas).
        var term = (_search ?? string.Empty).Trim();
        if (term.Length > 0)
        {
            var needle = term.ToLowerInvariant();
            q = q.Where(t => Coincide(t, needle));
        }

        return q.ToList();
    }

    private void ToggleCard(string key) => _cardFilter = _cardFilter == key ? null : key;

    // "Por asignar": el tercero no pertenece a ninguna categoria mas alla de la base "publico".
    private bool SoloBase(Guid id)
        => !_memberships.TryGetValue(id, out var ks) || ks.Count == 0 || ks.All(k => k == "publico");

    private static bool Coincide(TerceroListItemDto t, string needle)
    {
        if (Contiene(t.Nombre, needle) || Contiene(t.Identificacion, needle)
            || Contiene(t.Ciudad, needle) || Contiene(t.Sub, needle)
            || Contiene(t.Vendedor, needle) || Contiene(t.VendedorAsesorNombre, needle))
        {
            return true;
        }
        if (t.Filtrables is not null)
        {
            foreach (var v in t.Filtrables.Values)
            {
                if (Contiene(v, needle)) { return true; }
            }
        }
        return false;
    }

    private static bool Contiene(string? hay, string needle)
        => !string.IsNullOrEmpty(hay) && hay.ToLowerInvariant().Contains(needle);

    // Conteo por pestana: la categoria base (Publico) es el total del catalogo; las demas, por membership.
    private int CatCount(DirectorioCategoriaDto c)
        => c.Protegido ? _total : (_catCounts.TryGetValue(c.CategoriaKey, out var n) ? n : 0);

    // Fondo tenue del color de acento para el icono de la tarjeta / chip.
    private static string Tint(string hex) => $"color-mix(in srgb, {hex} 14%, #fff)";

    private async Task CrearCategoriaAsync()
    {
        _nuevaCatError = null;
        var title = (_nuevaCatTitle ?? string.Empty).Trim();
        if (title.Length is 0 or > 80) { _nuevaCatError = "El nombre es obligatorio (maximo 80)."; return; }
        _busy = true;
        try
        {
            var dto = await Cats.CreateAsync(new CreateDirectorioCategoriaRequest(title));
            if (dto is null) { _nuevaCatError = "No se pudo crear la categoria."; return; }
            _nuevaCatOpen = false;
            _cats = await Cats.ListAsync();
            _catCounts = await Cats.CountByCategoriaAsync();
            _activo = _cats.FirstOrDefault(c => c.CategoriaKey == dto.CategoriaKey) ?? _activo;
        }
        catch (Exception ex) { _nuevaCatError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleExpand(Guid id)
    {
        if (!_expanded.Add(id)) { _expanded.Remove(id); return; }
        // Carga perezosa de los contactos hijos la primera vez que se expande.
        if (!_childs.ContainsKey(id))
        {
            _childs[id] = await Terceros.ListContactosAsync(id);
        }
    }

    // Chips de categoria de una fila: Publico (base, siempre) + sus membresias, mapeadas a titulo/color.
    // Chips de categoria de la fila = sus membresias reales. Sin ninguna (p.ej. una persona vinculada a una
    // empresa que no esta en categoria), el listado muestra "Por asignar", como el prototipo (chipsTipo).
    private IEnumerable<(string Title, string Color)> ChipsDe(Guid tid)
    {
        if (!_memberships.TryGetValue(tid, out var ms) || ms.Count == 0) { yield break; }
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var k in ms)
        {
            if (!seen.Add(k)) { continue; }
            var cat = _cats.FirstOrDefault(c => string.Equals(c.CategoriaKey, k, StringComparison.OrdinalIgnoreCase));
            yield return (cat?.Title ?? k, cat?.Color ?? "#4f46e5");
        }
    }

    private static string Responsable(TerceroListItemDto t)
        => !string.IsNullOrWhiteSpace(t.VendedorAsesorNombre) ? t.VendedorAsesorNombre!
         : !string.IsNullOrWhiteSpace(t.Vendedor) ? t.Vendedor! : "—";

    private static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) { return "?"; }
        var a = parts[0][..1];
        var b = parts.Length > 1 ? parts[1][..1] : "";
        return (a + b).ToUpperInvariant();
    }

    private static readonly string[] _avPalette = { "#4f46e5", "#0ea5e9", "#10b981", "#f59e0b", "#8b5cf6", "#ef4444", "#0891b2", "#db2777" };
    private static string AvatarColor(string? name)
    {
        var h = 0;
        foreach (var ch in name ?? "") { h = (h * 31 + ch) & 0x7fffffff; }
        return _avPalette[h % _avPalette.Length];
    }
}
