@page "/directorio-modular"
@attribute [Authorize(Policy = "TenantMember")]
@* 2do motor de contactos - "Directorio Modular" (Capa 8), version AVANZADA seleccionable.
   PRIMER SLICE VISUAL (Fase 2): pestanas de categorias + tarjetas de conteo + listado, alimentados
   por el seed (opcion A). La ficha por secciones y los modales de configuracion vienen despues. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Directorio
@using Ecorex.Domain.Enums
@inject IDirectorioCategoriaService Cats
@inject ITerceroService Terceros

<PageTitle>Directorio Modular - ECOREX.tareas</PageTitle>

<div class="dm-wrap">
    <div class="dm-head">
        <div>
            <div class="dm-eyebrow">Catalogo 000232 &middot; motor avanzado</div>
            <h1 class="dm-title">Directorio Modular</h1>
            <p class="dm-sub">Catalogo de terceros por categorias. La ficha se arma con las secciones que cada categoria escoge.</p>
        </div>
    </div>

    <div class="dm-toolbar">
        <button class="dm-btn" disabled title="Proximamente"><i class="fa fa-right-left"></i> Importar / Exportar Excel</button>
        <button class="dm-btn" disabled title="Proximamente"><i class="fa fa-gear"></i> Configurar directorio</button>
        <button class="dm-btn-primary" @onclick="() => _nuevoKey = _activo?.CategoriaKey" disabled="@(_activo is null)"><i class="fa fa-plus"></i> Nuevo en @(_activo?.Title ?? "categoria")</button>
    </div>

    <DirectorioModularFichaModal CategoriaKey="@_nuevoKey" OnClosed="() => _nuevoKey = null" OnSaved="OnCreatedAsync" />

    @* --- Mini-modal: nueva categoria --- *@
    @if (_nuevaCatOpen)
    {
        <div class="dm-ov" @onclick="() => _nuevaCatOpen = false">
            <div class="dm-dlg" @onclick:stopPropagation="true">
                <div class="dm-dlg-head">
                    <div class="dm-dlg-title">Nueva categoria</div>
                    <button class="dm-dlg-x" @onclick="() => _nuevaCatOpen = false">&times;</button>
                </div>
                <div class="dm-dlg-body">
                    <label class="dm-dlg-lbl">Nombre de la categoria</label>
                    <input class="dm-dlg-input" @bind="_nuevaCatTitle" @bind:event="oninput" placeholder="Ej. Aliados, Transportadores..." />
                    <p class="dm-dlg-hint">Se creara vacia; luego le agregas secciones desde "Configurar directorio".</p>
                    @if (_nuevaCatError is not null) { <div class="dm-dlg-err">@_nuevaCatError</div> }
                </div>
                <div class="dm-dlg-foot">
                    <button class="dm-btn" @onclick="() => _nuevaCatOpen = false" disabled="@_busy">Cancelar</button>
                    <button class="dm-btn-primary" @onclick="CrearCategoriaAsync" disabled="@_busy">@(_busy ? "Creando..." : "Crear")</button>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <p class="dm-muted">Cargando...</p>
    }
    else
    {
        @* --- Tarjetas de conteo (sobre la categoria activa), con icono --- *@
        <div class="dm-cards">
            @{ var accent = _activo?.Color ?? "#4f46e5"; }
            <div class="dm-card">
                <span class="dm-card-ico" style="background:@Tint(accent)"><i class="fa @(_activo?.Icono ?? "fa-address-book")" style="color:@accent"></i></span>
                <div><div class="dm-card-n" style="color:@accent">@(_activo is null ? _total : CatCount(_activo))</div><div class="dm-card-l">@(_activo?.Title ?? "Total")</div></div>
            </div>
            <div class="dm-card">
                <span class="dm-card-ico" style="background:@Tint("#0ea5e9")"><i class="fa fa-building" style="color:#0ea5e9"></i></span>
                <div><div class="dm-card-n" style="color:#0ea5e9">@_orgs</div><div class="dm-card-l">Organizaciones</div></div>
            </div>
            <div class="dm-card">
                <span class="dm-card-ico" style="background:@Tint("#10b981")"><i class="fa fa-user" style="color:#10b981"></i></span>
                <div><div class="dm-card-n" style="color:#10b981">@_personas</div><div class="dm-card-l">Personas</div></div>
            </div>
            <div class="dm-card dm-card-act">
                <span class="dm-card-ico" style="background:@Tint("#f59e0b")"><i class="fa fa-circle-question" style="color:#f59e0b"></i></span>
                <div><div class="dm-card-n" style="color:#f59e0b">@_porAsignar</div><div class="dm-card-l">Por asignar</div></div>
            </div>
            <div class="dm-card">
                <span class="dm-card-ico" style="background:@Tint("#8b5cf6")"><i class="fa fa-seedling" style="color:#8b5cf6"></i></span>
                <div><div class="dm-card-n" style="color:#8b5cf6">@_nuevos</div><div class="dm-card-l">Nuevos (30 dias)</div></div>
            </div>
        </div>

        @* --- Pestanas de categorias con conteo --- *@
        <div class="dm-tabs">
            <span class="dm-tabs-lbl">Categoria:</span>
            @foreach (var c in _cats)
            {
                var on = _activo?.CategoriaKey == c.CategoriaKey;
                <button class="dm-tab @(on ? "on" : "")" style="@(on ? $"--dm-accent:{c.Color ?? "#4f46e5"}" : "")"
                        @onclick="() => _activo = c">
                    <i class="fa @c.Icono"></i> @c.Title
                    <span class="dm-tab-n">@CatCount(c)</span>
                    @if (c.Protegido) { <span class="dm-lock" title="Categoria base (no se elimina)"><i class="fa fa-lock"></i></span> }
                </button>
            }
            <button class="dm-tab-add" title="Crear categoria" @onclick="() => { _nuevaCatOpen = true; _nuevaCatTitle = string.Empty; _nuevaCatError = null; }"><i class="fa fa-plus"></i></button>
        </div>

        @* --- Buscador (visual en este slice) --- *@
        <div class="dm-search"><i class="fa fa-search"></i><input placeholder="Buscar por nombre, NIT, telefono, correo, codigo..." disabled /></div>

        @* --- Listado --- *@
        @if (_rows.Count == 0)
        {
            <div class="dm-empty">Aun no hay terceros en el catalogo.</div>
        }
        else
        {
            <div class="dm-table-wrap">
                <table class="dm-table">
                    <thead>
                        <tr>
                            <th class="dm-th-exp"></th>
                            <th>Tercero</th>
                            <th>Identificacion</th>
                            <th>Responsable</th>
                            <th>Estado</th>
                            <th class="dm-th-acc">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _rows)
                        {
                            var tid = t.Id;
                            var canExpand = t.EsEmpresa && t.ContadorContactos > 0;
                            <tr>
                                <td class="dm-td-exp">
                                    @if (canExpand)
                                    {
                                        <button class="dm-exp @(_expanded.Contains(tid) ? "on" : "")" title="Ver contactos" @onclick="() => ToggleExpand(tid)"><i class="fa fa-chevron-right"></i></button>
                                    }
                                </td>
                                <td>
                                    <div class="dm-tercero">
                                        <span class="dm-avatar" style="background:@AvatarColor(t.Nombre)">@Initials(t.Nombre)</span>
                                        <div class="dm-tercero-body">
                                            <div class="dm-tercero-top">
                                                <span class="dm-name">@t.Nombre</span>
                                                @if (t.EsEmpresa)
                                                {
                                                    <span class="dm-nat dm-nat-org">Organizacion@(t.ContadorContactos > 0 ? $" · {t.ContadorContactos}" : "")</span>
                                                }
                                                else
                                                {
                                                    <span class="dm-nat dm-nat-per">Persona</span>
                                                }
                                            </div>
                                            <div class="dm-chiprow">
                                                @foreach (var ch in ChipsDe(tid))
                                                {
                                                    <span class="dm-catchip" style="background:@Tint(ch.Color);color:@ch.Color">@ch.Title</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(t.Sub))
                                            {
                                                <div class="dm-tercero-sub">@t.Sub</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="dm-mono">@(string.IsNullOrWhiteSpace(t.Identificacion) ? "-" : t.Identificacion)</td>
                                <td class="dm-resp">@Responsable(t)</td>
                                <td>
                                    @if (t.Estado == TerceroEstado.Inactivo)
                                    {
                                        <span class="dm-chip dm-chip-off">Inactivo</span>
                                    }
                                    else
                                    {
                                        <span class="dm-chip dm-chip-on">Activo</span>
                                    }
                                </td>
                                <td class="dm-acc">
                                    <button class="dm-acc-btn" title="Editar (proximamente)"><i class="fa fa-pen"></i></button>
                                    <button class="dm-acc-btn dm-acc-del" title="Eliminar (proximamente)"><i class="fa fa-trash"></i></button>
                                </td>
                            </tr>
                            @if (canExpand && _expanded.Contains(tid))
                            {
                                <tr class="dm-exp-row">
                                    <td></td>
                                    <td colspan="5" class="dm-exp-cell"><i class="fa fa-users"></i> @t.ContadorContactos contacto(s) asociado(s). El detalle se listara aqui.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="dm-foot">
            <span class="dm-muted">@_cats.Count categorias &middot; @_secciones secciones &middot; @_campos campos configurados (seed del prototipo)</span>
        </div>
    }
</div>

<style>
    .dm-wrap { font-family: 'Inter', system-ui, sans-serif; color: #1f2937; padding: 22px 26px; max-width: 1240px; }
    .dm-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 18px; }
    .dm-eyebrow { font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #6366f1; }
    .dm-title { font-size: 24px; font-weight: 800; margin: 2px 0 4px; }
    .dm-sub { font-size: 13px; color: #6b7280; margin: 0; max-width: 640px; }
    .dm-muted { color: #9ca3af; font-size: 12.5px; }
    .dm-btn-primary { background: #4f46e5; color: #fff; border: none; border-radius: 9px; padding: 9px 16px; font-size: 13px; font-weight: 700; cursor: not-allowed; opacity: .55; white-space: nowrap; }

    .dm-tabs { display: flex; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid #eef0f3; padding-bottom: 12px; margin-bottom: 16px; }
    .dm-tab { --dm-accent: #4f46e5; display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1px solid #e5e7eb; color: #374151; border-radius: 999px; padding: 7px 15px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .12s; }
    .dm-tab:hover { border-color: #c7cbd1; }
    .dm-tab.on { background: color-mix(in srgb, var(--dm-accent) 12%, #fff); border-color: var(--dm-accent); color: var(--dm-accent); }
    .dm-tab i { font-size: 12px; }
    .dm-lock { opacity: .6; font-size: 10px; }

    .dm-toolbar { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .dm-btn { display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1px solid #e5e7eb; color: #374151; border-radius: 9px; padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .dm-btn:disabled { opacity: .55; cursor: not-allowed; }
    .dm-toolbar .dm-btn-primary { margin-left: auto; }

    .dm-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 16px; }
    .dm-card { background: #fff; border: 1px solid #eef0f3; border-radius: 12px; padding: 13px 15px; box-shadow: 0 1px 2px rgba(16,24,40,.04); display: flex; align-items: center; gap: 12px; }
    .dm-card-ico { width: 38px; height: 38px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
    .dm-card-act { border-style: dashed; }
    .dm-card-n { font-size: 24px; font-weight: 800; line-height: 1; }
    .dm-card-l { font-size: 12px; color: #6b7280; margin-top: 5px; }

    .dm-tabs-lbl { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; align-self: center; margin-right: 2px; }
    .dm-tab-n { background: rgba(17,24,39,.06); color: inherit; font-size: 11px; font-weight: 700; border-radius: 999px; padding: 1px 7px; margin-left: 2px; }
    .dm-tab.on .dm-tab-n { background: color-mix(in srgb, var(--dm-accent) 22%, #fff); }
    .dm-tab-add { border: 1px dashed #c7cbd1; background: #fff; color: #6b7280; border-radius: 999px; width: 30px; height: 30px; cursor: pointer; font-size: 12px; display: inline-flex; align-items: center; justify-content: center; }
    .dm-tab-add:hover { border-color: #4f46e5; color: #4f46e5; }

    .dm-ov { position: fixed; inset: 0; background: rgba(17,24,39,.45); display: flex; align-items: center; justify-content: center; z-index: 70; padding: 20px; }
    .dm-dlg { background: #fff; border-radius: 13px; width: 440px; max-width: 94vw; box-shadow: 0 20px 50px rgba(16,24,40,.25); }
    .dm-dlg-head { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #eef0f3; }
    .dm-dlg-title { font-size: 16px; font-weight: 800; color: #111827; }
    .dm-dlg-x { background: none; border: none; font-size: 22px; color: #9ca3af; cursor: pointer; line-height: 1; }
    .dm-dlg-body { padding: 18px 20px; }
    .dm-dlg-lbl { font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px; }
    .dm-dlg-input { width: 100%; box-sizing: border-box; border: 1px solid #d1d5db; border-radius: 8px; padding: 9px 11px; font-size: 13px; outline: none; }
    .dm-dlg-input:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.12); }
    .dm-dlg-hint { font-size: 11.5px; color: #9ca3af; margin: 8px 0 0; }
    .dm-dlg-err { color: #dc2626; font-size: 12.5px; font-weight: 600; margin-top: 8px; }
    .dm-dlg-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 12px 20px; border-top: 1px solid #eef0f3; }

    .dm-search { display: flex; align-items: center; gap: 9px; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 9px 13px; margin-bottom: 14px; color: #9ca3af; }
    .dm-search input { border: none; outline: none; flex: 1; font-size: 13px; color: #374151; background: transparent; }

    .dm-table-wrap { border: 1px solid #eef0f3; border-radius: 12px; overflow: hidden; background: #fff; }
    .dm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .dm-table thead th { text-align: left; background: #f9fafb; color: #6b7280; font-weight: 600; font-size: 11.5px; text-transform: uppercase; letter-spacing: .04em; padding: 10px 14px; border-bottom: 1px solid #eef0f3; }
    .dm-table tbody td { padding: 10px 14px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    .dm-table tbody tr:last-child td { border-bottom: none; }
