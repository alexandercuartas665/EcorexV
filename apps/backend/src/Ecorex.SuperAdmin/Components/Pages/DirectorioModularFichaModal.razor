@* Modal de creacion v1 del motor Modular (Capa 8): la ficha se arma con las secciones de la
   categoria (un solo scroll), la naturaleza se deduce de lo que se llena. Se abre por @ref. *@
@using Ecorex.Application.Directorio
@using Ecorex.Domain.Enums
@inject IDirectorioModularFichaService Fichas

@if (CategoriaKey is not null)
{
    <div class="fm-overlay" @onclick="Close">
        <div class="fm-dialog" @onclick:stopPropagation="true">
            <div class="fm-head">
                <div>
                    <div class="fm-eyebrow">Nuevo tercero &middot; @(_ficha?.CategoriaTitle)</div>
                    <div class="fm-naturaleza">
                        @{ var (nat, natCls) = NaturalezaPill(); }
                        <span class="fm-pill @natCls">@nat</span>
                    </div>
                </div>
                <button class="fm-x" @onclick="Close">&times;</button>
            </div>

            <div class="fm-body">
                @if (_ficha is null)
                {
                    <p class="fm-muted">Cargando ficha...</p>
                }
                else if (_ficha.Secciones.Count == 0)
                {
                    <p class="fm-muted">Esta categoria no tiene secciones configuradas.</p>
                }
                else
                {
                    @foreach (var sec in _ficha.Secciones)
                    {
                        <div class="fm-sec">
                            <div class="fm-sec-head"><i class="fa @sec.Icono"></i> @sec.Title</div>
                            <div class="fm-grid">
                                @foreach (var f in sec.Campos)
                                {
                                    @if (f.Type == TerceroFieldType.Separator)
                                    {
                                        <div class="fm-sep" style="grid-column: span 3;">@f.Label</div>
                                    }
                                    else
                                    {
                                        <div class="fm-field" style="grid-column: span @(Math.Clamp(f.Column, 1, 3));">
                                            <label class="fm-label">
                                                @f.Label
                                                @if (EsRequerido(f)) { <span class="fm-req">*</span> }
                                            </label>
                                            @RenderControl(sec.FichaKey, f)
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="fm-foot">
                @if (_error is not null) { <span class="fm-err">@_error</span> }
                <div class="fm-foot-btns">
                    <button class="fm-btn" @onclick="Close" disabled="@_saving">Cancelar</button>
                    <button class="fm-btn fm-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Guardando..." : "Guardar")</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .fm-overlay { position: fixed; inset: 0; background: rgba(17,24,39,.45); display: flex; align-items: flex-start; justify-content: center; z-index: 70; padding: 40px 16px; overflow: auto; }
    .fm-dialog { background: #fff; border-radius: 14px; width: 860px; max-width: 96vw; box-shadow: 0 20px 50px rgba(16,24,40,.25); display: flex; flex-direction: column; max-height: 90vh; font-family: 'Inter', system-ui, sans-serif; }
    .fm-head { display: flex; justify-content: space-between; align-items: flex-start; padding: 18px 22px; border-bottom: 1px solid #eef0f3; }
    .fm-eyebrow { font-size: 15px; font-weight: 800; color: #111827; }
    .fm-naturaleza { margin-top: 6px; }
    .fm-pill { display: inline-block; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 3px 11px; }
    .fm-pill.org { background: #eff6ff; color: #1d4ed8; }
    .fm-pill.per { background: #f0fdf4; color: #15803d; }
    .fm-pill.none { background: #fef3c7; color: #b45309; }
    .fm-x { background: none; border: none; font-size: 24px; color: #9ca3af; cursor: pointer; line-height: 1; }
    .fm-body { padding: 8px 22px 4px; overflow: auto; }
    .fm-muted { color: #9ca3af; font-size: 13px; padding: 20px 0; }
    .fm-sec { margin: 16px 0; }
    .fm-sec-head { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #4f46e5; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .fm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 14px; }
    .fm-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .fm-label { font-size: 12px; font-weight: 600; color: #374151; }
    .fm-req { color: #dc2626; margin-left: 2px; }
    .fm-sep { border-top: 1px solid #eef0f3; padding-top: 10px; margin-top: 4px; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; }
    .fm-input, .fm-select, .fm-textarea { border: 1px solid #d1d5db; border-radius: 8px; padding: 8px 10px; font-size: 13px; color: #111827; outline: none; font-family: inherit; width: 100%; box-sizing: border-box; background: #fff; }
    .fm-input:focus, .fm-select:focus, .fm-textarea:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.12); }
    .fm-input:disabled { background: #f9fafb; color: #9ca3af; }
    .fm-textarea { resize: vertical; min-height: 64px; }
    .fm-check { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #374151; padding-top: 4px; }
    .fm-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 22px; border-top: 1px solid #eef0f3; }
    .fm-err { color: #dc2626; font-size: 12.5px; font-weight: 600; }
    .fm-foot-btns { display: flex; gap: 10px; margin-left: auto; }
    .fm-btn { border: 1px solid #e5e7eb; background: #fff; color: #374151; border-radius: 9px; padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .fm-btn-primary { background: #4f46e5; color: #fff; border-color: #4f46e5; }
    .fm-btn:disabled { opacity: .6; cursor: default; }
</style>

@code {
    // Modal DRIVEN POR PARAMETRO (mas robusto que @ref): el padre setea CategoriaKey para abrir y la
    // pone en null para cerrar (via OnClosed). Se carga la ficha cuando cambia CategoriaKey.
    [Parameter] public string? CategoriaKey { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _saving;
    private string? _error;
    private string? _loadedFor;
    private ModularFichaDto? _ficha;
    // ficha (seccion) -> campo -> valor
    private readonly Dictionary<string, Dictionary<string, string>> _valores = new(StringComparer.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        if (CategoriaKey is null) { _loadedFor = null; return; }
        if (CategoriaKey == _loadedFor) { return; } // ya cargada

        _loadedFor = CategoriaKey;
        _error = null;
        _saving = false;
        _ficha = null;
        _valores.Clear();

        _ficha = await Fichas.GetFichaAsync(CategoriaKey);
        if (_ficha is not null)
        {
            foreach (var sec in _ficha.Secciones)
            {
                _valores[sec.FichaKey] = new Dictionary<string, string>(StringComparer.Ordinal);
            }
        }
    }

    private async Task Close() => await OnClosed.InvokeAsync();

    private string GetVal(string ficha, string campo)
        => _valores.TryGetValue(ficha, out var d) && d.TryGetValue(campo, out var v) ? v : "";

    private void SetVal(string ficha, string campo, string? valor)
    {
        if (!_valores.TryGetValue(ficha, out var d)) { d = _valores[ficha] = new(StringComparer.Ordinal); }
        d[campo] = valor ?? "";
    }

    private static bool EsRequerido(ModularCampoDto f) => !string.IsNullOrWhiteSpace(f.RequeridoEn);

    private string? Find(string campo)
    {
        foreach (var d in _valores.Values)
        {
            if (d.TryGetValue(campo, out var v) && !string.IsNullOrWhiteSpace(v)) { return v; }
        }
        return null;
    }

    private (string, string) NaturalezaPill()
    {
        var emp = Find("nombre_empresa") ?? Find("razon_social") ?? Find("nombre_comercial");
        var per = Find("contacto");
        if (!string.IsNullOrWhiteSpace(emp)) { return ("Se creara: Organizacion", "org"); }
        if (!string.IsNullOrWhiteSpace(per)) { return ("Se creara: Persona", "per"); }
        return ("Falta un nombre (empresa o contacto)", "none");
    }

    private RenderFragment RenderControl(string ficha, ModularCampoDto f) => builder =>
    {
        var val = GetVal(ficha, f.FieldKey);
        switch (f.Type)
        {
            case TerceroFieldType.TextArea:
                builder.OpenElement(0, "textarea");
                builder.AddAttribute(1, "class", "fm-textarea");
                builder.AddAttribute(2, "value", val);
                builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, e.Value?.ToString())));
                builder.CloseElement();
                break;
            case TerceroFieldType.Select:
            case TerceroFieldType.MultiSelect:
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "fm-select");
                if (f.Type == TerceroFieldType.MultiSelect) { builder.AddAttribute(2, "multiple", true); }
                builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, e.Value?.ToString())));
                builder.OpenElement(4, "option"); builder.AddAttribute(5, "value", ""); builder.AddContent(6, "-- seleccionar --"); builder.CloseElement();
                foreach (var op in (f.Options ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    builder.OpenElement(7, "option");
                    builder.AddAttribute(8, "value", op);
                    if (op == val) { builder.AddAttribute(9, "selected", true); }
                    builder.AddContent(10, op);
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;
            case TerceroFieldType.Checkbox:
                builder.OpenElement(0, "label");
                builder.AddAttribute(1, "class", "fm-check");
                builder.OpenElement(2, "input");
                builder.AddAttribute(3, "type", "checkbox");
                builder.AddAttribute(4, "checked", val == "true");
                builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, (e.Value is true).ToString().ToLowerInvariant())));
                builder.CloseElement();
                builder.AddContent(6, "Si");
                builder.CloseElement();
                break;
            case TerceroFieldType.Lookup:
            case TerceroFieldType.DirectoryLookup:
            case TerceroFieldType.Calculated:
            case TerceroFieldType.Table:
                // v1: placeholder (estos controles ricos llegan en un slice posterior).
                builder.OpenElement(0, "input");
                builder.AddAttribute(1, "class", "fm-input");
                builder.AddAttribute(2, "disabled", true);
                builder.AddAttribute(3, "placeholder", $"({f.Type}) proximamente");
                builder.CloseElement();
                break;
            default:
                builder.OpenElement(0, "input");
                builder.AddAttribute(1, "class", "fm-input");
                builder.AddAttribute(2, "type", InputType(f.Type));
                builder.AddAttribute(3, "value", val);
                builder.AddAttribute(4, "disabled", f.ReadOnly);
                builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, e.Value?.ToString())));
                builder.CloseElement();
                break;
        }
    };

    private static string InputType(TerceroFieldType t) => t switch
    {
        TerceroFieldType.Number or TerceroFieldType.Currency => "number",
        TerceroFieldType.Date => "date",
        _ => "text"
    };

    private async Task SaveAsync()
    {
        _error = null;
        if (_ficha is null) { return; }

        // Obligatorios (por naturaleza deducida).
        var (_, natCls) = NaturalezaPill();
        if (natCls == "none") { _error = "Escribe al menos un nombre (empresa o contacto)."; return; }
        var natEmpresa = natCls == "org";
        foreach (var sec in _ficha.Secciones)
        {
            foreach (var f in sec.Campos)
            {
                if (string.IsNullOrWhiteSpace(f.RequeridoEn)) { continue; }
                var aplica = f.RequeridoEn.Contains(natEmpresa ? "empresa" : "contacto", StringComparison.OrdinalIgnoreCase);
                if (aplica && string.IsNullOrWhiteSpace(GetVal(sec.FichaKey, f.FieldKey)))
                {
                    _error = $"Falta un campo obligatorio: {f.Label}.";
                    return;
                }
            }
        }

        _saving = true;
        try
        {
            var req = new CreateModularTerceroRequest(_ficha.CategoriaKey,
                _valores.ToDictionary(k => k.Key, v => new Dictionary<string, string>(v.Value, StringComparer.Ordinal)));
            var (id, err) = await Fichas.CreateTerceroAsync(req);
            if (err is not null) { _error = err; return; }
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
