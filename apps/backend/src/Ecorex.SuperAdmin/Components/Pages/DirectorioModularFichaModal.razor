    .fm-tabla .fm-input, .fm-tabla .fm-select { padding: 6px 8px; font-size: 12.5px; }
    .fm-tabla-acc { width: 40px; text-align: center; }
    .fm-tabla-empty { color: #9ca3af; text-align: center; padding: 14px; font-size: 12px; }
    .fm-tabla-del { border: none; background: none; color: #dc2626; cursor: pointer; font-size: 13px; padding: 4px; }
