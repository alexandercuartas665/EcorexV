@* Modal de creacion v1 del motor Modular (Capa 8): la ficha se arma con las secciones de la
   categoria (un solo scroll), la naturaleza se deduce de lo que se llena. Se abre por @ref. *@
@using Ecorex.Application.Directorio
@using Ecorex.Domain.Enums
@inject IDirectorioModularFichaService Fichas
@inject IJSRuntime JS

@if (CategoriaKey is not null)
{
    <div class="fm-overlay" @onclick="Close">
        <div class="fm-dialog" @onclick:stopPropagation="true">
            <div class="fm-head">
                <div class="fm-head-l">
                    <span class="fm-head-ico"><i class="fa fa-address-card"></i></span>
                    <div>
                        <div class="fm-eyebrow">DIRECTORIO GENERAL &middot; 000232</div>
                        <div class="fm-title">Nuevo registro &middot; @(_ficha?.CategoriaTitle)</div>
                    </div>
                </div>
                <button class="fm-x" @onclick="Close">&times;</button>
            </div>

            <div class="fm-body">
                @if (_ficha is null)
                {
                    <p class="fm-muted">Cargando ficha...</p>
                }
                else if (_ficha.Secciones.Count == 0)
                {
                    <p class="fm-muted">Esta categoria no tiene secciones configuradas.</p>
                }
                else
                {
                    @* Categoria + Estado *@
                    <div class="fm-toprow">
                        <div class="fm-topcat">
                            <div class="fm-toplbl">Categoria</div>
                            <span class="fm-catchip"><i class="fa fa-globe"></i> @_ficha.CategoriaTitle</span>
                            <div class="fm-tophint">Se define al crear el tercero desde una categoria, o con el boton "+ nombre de la categoria" que aparece en el listado al buscarlo.</div>
                        </div>
                        <div class="fm-topest">
                            <div class="fm-toplbl">Estado</div>
                            <select class="fm-select" @bind="_estado"><option value="Activo">Activo</option><option value="Inactivo">Inactivo</option></select>
                        </div>
                    </div>

                    @* Banner de naturaleza deducida *@
                    <div class="fm-banner @NatClass">
                        <i class="fa @(NatClass == "none" ? "fa-circle-question" : "fa-circle-check")"></i>
                        <span>@NatText</span>
                    </div>

                    @* Tabs de seccion (llevan a cada seccion del scroll) con contador de obligatorios faltantes *@
                    <div class="fm-sectabs">
                        @foreach (var s in _ficha.Secciones)
                        {
                            <a class="fm-sectab" href="#sec-@s.FichaKey">
                                <span class="fm-dot" style="background:@(SeccionColor(s))"></span> @s.Title
                                @if (FaltantesEnSeccion(s) > 0)
                                {
                                    <span class="fm-tab-badge" title="Campos obligatorios pendientes">@FaltantesEnSeccion(s)</span>
                                }
                            </a>
                        }
                    </div>

                    @foreach (var sec in _ficha.Secciones)
                    {
                        <div class="fm-sec" id="sec-@sec.FichaKey">
                            <div class="fm-sec-head">
                                <span class="fm-sec-ico"><i class="fa @sec.Icono"></i></span>
                                <div>
                                    <div class="fm-sec-title">@sec.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(sec.Descripcion))
                                    {
                                        <div class="fm-sec-desc">@sec.Descripcion</div>
                                    }
                                </div>
                            </div>
                            <div class="fm-grid">
                                @foreach (var f in sec.Campos)
                                {
                                    @if (f.Type == TerceroFieldType.Separator)
                                    {
                                        <div class="fm-sep" style="grid-column: span 3;">@f.Label</div>
                                    }
                                    else
                                    {
                                        <div class="fm-field" style="grid-column: span @(Math.Clamp(f.Column, 1, 3));">
                                            <label class="fm-label">
                                                @f.Label
                                                @if (EsRequerido(f)) { <span class="fm-req">*</span> }
                                            </label>
                                            @RenderControl(sec.FichaKey, f)
                                            @if (!string.IsNullOrWhiteSpace(f.Descripcion))
                                            {
                                                <div class="fm-hint">@f.Descripcion</div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="fm-foot">
                @if (_error is not null) { <span class="fm-err">@_error</span> }
                <div class="fm-foot-btns">
                    <button class="fm-btn" @onclick="Close" disabled="@_saving">Cancelar</button>
                    <button class="fm-btn fm-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Guardando..." : "Guardar")</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .fm-overlay { position: fixed; inset: 0; background: rgba(17,24,39,.45); display: flex; align-items: flex-start; justify-content: center; z-index: 70; padding: 40px 16px; overflow: auto; }
    .fm-dialog { background: #fff; border-radius: 14px; width: 860px; max-width: 96vw; box-shadow: 0 20px 50px rgba(16,24,40,.25); display: flex; flex-direction: column; max-height: 90vh; font-family: 'Inter', system-ui, sans-serif; }
    .fm-head { display: flex; justify-content: space-between; align-items: flex-start; padding: 18px 22px; border-bottom: 1px solid #eef0f3; }
    .fm-head-l { display: flex; align-items: center; gap: 13px; }
    .fm-head-ico { width: 42px; height: 42px; border-radius: 11px; background: #eef2ff; color: #4f46e5; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .fm-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .06em; color: #6366f1; }
    .fm-title { font-size: 18px; font-weight: 800; color: #111827; margin-top: 1px; }
    .fm-x { background: none; border: none; font-size: 24px; color: #9ca3af; cursor: pointer; line-height: 1; }
    .fm-body { padding: 12px 22px 4px; overflow: auto; }
    .fm-muted { color: #9ca3af; font-size: 13px; padding: 20px 0; }

    .fm-toprow { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; padding-bottom: 14px; border-bottom: 1px solid #f3f4f6; margin-bottom: 12px; }
    .fm-toplbl { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; margin-bottom: 6px; }
    .fm-catchip { display: inline-flex; align-items: center; gap: 6px; background: #eef2ff; color: #4f46e5; font-size: 12.5px; font-weight: 700; border-radius: 999px; padding: 4px 12px; }
    .fm-tophint { font-size: 11.5px; color: #9ca3af; margin-top: 6px; max-width: 560px; }
    .fm-topest { min-width: 150px; }

    .fm-banner { display: flex; align-items: center; gap: 9px; border-radius: 10px; padding: 10px 14px; font-size: 12.5px; font-weight: 600; margin-bottom: 14px; }
    .fm-banner.none { background: #f5f3ff; color: #6d28d9; }
    .fm-banner.org { background: #eff6ff; color: #1d4ed8; }
    .fm-banner.per { background: #f0fdf4; color: #15803d; }

    .fm-sectabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 4px; }
    .fm-sectab { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-size: 12px; font-weight: 600; color: #4f46e5; background: #f5f3ff; border-radius: 999px; padding: 4px 11px; }
    .fm-sectab .fm-dot { width: 6px; height: 6px; border-radius: 50%; background: #4f46e5; display: inline-block; }
    .fm-tab-badge { background: #dc2626; color: #fff; font-size: 10.5px; font-weight: 800; border-radius: 999px; min-width: 16px; height: 16px; padding: 0 4px; display: inline-flex; align-items: center; justify-content: center; margin-left: 3px; }

    .fm-sec { margin: 18px 0; }
    .fm-sec-head { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; }
    .fm-sec-ico { width: 30px; height: 30px; border-radius: 8px; background: #eef2ff; color: #4f46e5; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; }
    .fm-sec-title { font-size: 14px; font-weight: 700; color: #111827; }
    .fm-sec-desc { font-size: 12px; color: #6b7280; margin-top: 2px; max-width: 640px; }
    .fm-hint { font-size: 11px; color: #9ca3af; }
    .fm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 14px; }
    .fm-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .fm-label { font-size: 12px; font-weight: 600; color: #374151; }
    .fm-req { color: #dc2626; margin-left: 2px; }
    .fm-sep { border-top: 1px solid #eef0f3; padding-top: 10px; margin-top: 4px; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; }
    .fm-input, .fm-select, .fm-textarea { border: 1px solid #d1d5db; border-radius: 8px; padding: 8px 10px; font-size: 13px; color: #111827; outline: none; font-family: inherit; width: 100%; box-sizing: border-box; background: #fff; }
    .fm-input:focus, .fm-select:focus, .fm-textarea:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.12); }
    .fm-input:disabled { background: #f9fafb; color: #9ca3af; }
    .fm-textarea { resize: vertical; min-height: 64px; }
