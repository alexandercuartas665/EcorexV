@* Modal de creacion v1 del motor Modular (Capa 8): la ficha se arma con las secciones de la
   categoria (un solo scroll), la naturaleza se deduce de lo que se llena. Se abre por @ref. *@
@using Ecorex.Application.Directorio
@using Ecorex.Domain.Enums
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Ecorex.SuperAdmin.Components.Shared.Directorio
@inject IDirectorioModularFichaService Fichas
@inject Ecorex.Application.Asesores.IAsesorService AsesorSvc
@inject Ecorex.SuperAdmin.Services.CircuitFormGate FormGate
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="fm-overlay" @onclick="Close">
        <div class="fm-dialog" @onclick:stopPropagation="true">
            <div class="fm-head">
                <div class="fm-head-l">
                    <span class="fm-head-ico"><i class="fa fa-address-card"></i></span>
                    <div>
                        <div class="fm-eyebrow">DIRECTORIO GENERAL &middot; 000232</div>
                        <div class="fm-title">@(_isEdit ? "Editar" : "Nuevo registro") &middot; @(_ficha?.CategoriaTitle)</div>
                    </div>
                </div>
                <button class="fm-x" @onclick="Close">&times;</button>
            </div>

            <div class="fm-body">
                @if (_notModular)
                {
                    <div class="fm-notmod">
                        <i class="fa fa-circle-info"></i>
                        <span>Este contacto se creo con el motor <strong>Clasico</strong>. Editalo desde el Directorio General clasico; aqui solo se editan los contactos del motor Modular.</span>
                    </div>
                }
                else if (_ficha is null)
                {
                    <p class="fm-muted">Cargando ficha...</p>
                }
                else if (_ficha.Secciones.Count == 0)
                {
                    <p class="fm-muted">Esta categoria no tiene secciones configuradas.</p>
                }
                else
                {
                    @* Categoria + Estado *@
                    <div class="fm-toprow">
                        <div class="fm-topcat">
                            <div class="fm-toplbl">Categoria</div>
                            <span class="fm-catchip"><i class="fa fa-globe"></i> @_ficha.CategoriaTitle</span>
                            <div class="fm-tophint">Se define al crear el tercero desde una categoria, o con el boton "+ nombre de la categoria" que aparece en el listado al buscarlo.</div>
                        </div>
                        <div class="fm-topest">
                            <div class="fm-toplbl">Estado</div>
                            <select class="fm-select" @bind="_estado"><option value="Activo">Activo</option><option value="Inactivo">Inactivo</option></select>
                        </div>
                    </div>

                    @* Banner de naturaleza deducida *@
                    <div class="fm-banner @NatClass">
                        <i class="fa @(NatClass == "none" ? "fa-circle-question" : "fa-circle-check")"></i>
                        <span>@NatText</span>
                    </div>

                    @* O2-1: alerta de duplicidad en vivo (por identificacion / correo / telefono) *@
                    @if (_duplicados.Count > 0)
                    {
                        <div class="fm-dup">
                            <div class="fm-dup-head"><i class="fa fa-triangle-exclamation"></i> Posible duplicado ya registrado:</div>
                            <ul class="fm-dup-list">
                                @foreach (var d in _duplicados)
                                {
                                    <li>
                                        <span class="fm-dup-name">@d.Nombre</span>
                                        <span class="fm-dup-why">coincide por @MotivoTexto(d.Motivo)@(string.IsNullOrWhiteSpace(d.Categoria) ? "" : $" · {d.Categoria}")</span>
                                        @if (OnAbrirTercero.HasDelegate)
                                        {
                                            <button type="button" class="fm-dup-open" @onclick="() => OnAbrirTercero.InvokeAsync(d.Id)">Abrir ficha</button>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @* O3-3: homologacion Fiscal (el RUT sobrescribe el directorio publico) - notificacion en vivo *@
                    @if (EsHomologante)
                    {
                        var homo = HomologacionRut.Mapear(_valores);
                        <div class="fm-homo">
                            <div class="fm-homo-head"><i class="fa fa-wand-magic-sparkles"></i> El directorio publico se homologa desde el RUT:</div>
                            @if (homo.Etiquetas.Count == 0)
                            {
                                <div class="fm-homo-empty">Diligencia el RUT (tipo de contribuyente, razon social o nombres): aqui veras que campos publicos se homologan.</div>
                            }
                            else
                            {
                                <ul class="fm-homo-list">@foreach (var e in homo.Etiquetas) { <li>@e</li> }</ul>
                            }
                        </div>
                    }
                    else if (HomologacionSuaveDisponible)
                    {
                        var homo = HomologacionRut.Mapear(_valores);
                        if (homo.Publico.Count > 0)
                        {
                            <div class="fm-homo fm-homo-soft">
                                <div class="fm-homo-head"><i class="fa fa-wand-magic-sparkles"></i> Hay datos de RUT: los campos publicos vacios se completan solos.</div>
                                @if (HayConflictoRut(homo))
                                {
                                    <div class="fm-homo-conf">Algunos campos publicos difieren del RUT.
                                        <button type="button" class="fm-homo-btn" @onclick="() => UsarLosDelRut(homo)">Usar los del RUT</button>
                                    </div>
                                }
                            </div>
                        }
                    }

                    @* O5-1: aviso de secciones ocultas por permisos (no revela su contenido) *@
                    @if (_ficha.SeccionesOcultas > 0)
                    {
                        <div class="fm-oculta">
                            <i class="fa fa-lock"></i>
                            <span>Hay @_ficha.SeccionesOcultas seccion(es) oculta(s) por permisos de tu rol.</span>
                        </div>
                    }

                    @* Tabs de seccion (llevan a cada seccion del scroll) con contador de obligatorios faltantes *@
                    <div class="fm-sectabs">
                        @foreach (var s in _ficha.Secciones.Where(MostrarSeccion))
                        {
                            <a class="fm-sectab" href="#sec-@s.FichaKey">
                                <span class="fm-dot" style="background:@(SeccionColor(s))"></span> @s.Title
                                @if (FaltantesEnSeccion(s) > 0)
                                {
                                    <span class="fm-tab-badge" title="Campos obligatorios pendientes">@FaltantesEnSeccion(s)</span>
                                }
                            </a>
                        }
                    </div>

                    @foreach (var sec in _ficha.Secciones.Where(MostrarSeccion))
                    {
                        <div class="fm-sec" id="sec-@sec.FichaKey">
                            <div class="fm-sec-head">
                                <span class="fm-sec-ico"><i class="fa @sec.Icono"></i></span>
                                <div>
                                    <div class="fm-sec-title">@sec.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(sec.Descripcion))
                                    {
                                        <div class="fm-sec-desc">@sec.Descripcion</div>
                                    }
                                </div>
                            </div>
                            <div class="fm-grid">
                                @foreach (var f in sec.Campos.Where(MostrarCampo))
                                {
                                    @if (f.Type == TerceroFieldType.Separator)
                                    {
                                        <div class="fm-sep" style="grid-column: span 3;">@f.Label</div>
                                    }
                                    else if (f.Type == TerceroFieldType.Table)
                                    {
                                        var cols = ParseTablaCols(f.Options);
                                        var rows = GetTablaRows(sec.FichaKey, f.FieldKey);
                                        <div class="fm-field" style="grid-column: span 3;">
                                            <label class="fm-label">@f.Label</label>
                                            <div class="fm-tabla-wrap">
                                                <table class="fm-tabla">
                                                    <thead>
                                                        <tr>
                                                            @foreach (var col in cols) { <th>@col.Label</th> }
                                                            <th class="fm-tabla-acc"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (rows.Count == 0)
                                                        {
                                                            <tr><td colspan="@(cols.Count + 1)" class="fm-tabla-empty">Sin filas. Usa "Agregar fila".</td></tr>
                                                        }
                                                        @for (var ri = 0; ri < rows.Count; ri++)
                                                        {
                                                            var rowIdx = ri;
                                                            <tr>
                                                                @foreach (var col in cols)
                                                                {
                                                                    <td>
                                                                        @if (col.Type == "select")
                                                                        {
                                                                            <select class="fm-select" @onchange="e => SetTablaCell(sec.FichaKey, f.FieldKey, rowIdx, col, e.Value?.ToString())">
                                                                                <option value="">-- seleccionar --</option>
                                                                                @foreach (var op in col.Options)
                                                                                {
                                                                                    <option value="@op.Value" selected="@(op.Value == rows[rowIdx].GetValueOrDefault(col.Key, ""))">@(op.Value == op.Label ? op.Label : $"{op.Value} - {op.Label}")</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            <input class="fm-input" value="@rows[rowIdx].GetValueOrDefault(col.Key, "")" disabled="@col.ReadOnly"
                                                                                   @onchange="e => SetTablaCell(sec.FichaKey, f.FieldKey, rowIdx, col, e.Value?.ToString())" />
                                                                        }
                                                                    </td>
                                                                }
                                                                <td class="fm-tabla-acc">
                                                                    <button type="button" class="fm-tabla-del" title="Quitar fila" @onclick="() => RemoveTablaRow(sec.FichaKey, f.FieldKey, rowIdx)"><i class="fa fa-trash"></i></button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                                <button type="button" class="fm-tabla-add" @onclick="() => AddTablaRow(sec.FichaKey, f.FieldKey)"><i class="fa fa-plus"></i> Agregar fila</button>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(f.Descripcion))
                                            {
                                                <div class="fm-hint">@f.Descripcion</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fm-field" style="grid-column: span @(Math.Clamp(f.Column, 1, 3));">
                                            <label class="fm-label">
                                                @f.Label
                                                @if (EsRequerido(f)) { <span class="fm-req">*</span> }
                                            </label>
                                            @RenderControl(sec.FichaKey, f)
                                            @if (!string.IsNullOrWhiteSpace(f.Descripcion))
                                            {
                                                <div class="fm-hint">@f.Descripcion</div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @* O4-1: panel de relaciones bidireccional (solo en edicion, cuando el tercero ya existe) *@
                    @if (_isEdit && _editId is Guid _relId && _natFijo is TerceroTipo _relTipo)
                    {
                        <DmRelacionesPanel TerceroId="_relId" EsEmpresa="_relTipo == TerceroTipo.Empresa"
                                           OnAbrirTercero="OnAbrirTercero" />
                    }
                }
            </div>

            <div class="fm-foot">
                @if (_error is not null) { <span class="fm-err">@_error</span> }
                <div class="fm-foot-btns">
                    <button class="fm-btn" @onclick="Close" disabled="@_saving">@(_notModular ? "Cerrar" : "Cancelar")</button>
                    @if (!_notModular)
                    {
                        <button class="fm-btn fm-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Guardando..." : (_isEdit ? "Guardar cambios" : "Guardar"))</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .fm-overlay { position: fixed; inset: 0; background: rgba(17,24,39,.45); display: flex; align-items: flex-start; justify-content: center; z-index: 1100; padding: 40px 16px; overflow: auto; }
    .fm-dialog { background: #fff; border-radius: 14px; width: 1140px; max-width: 96vw; box-shadow: 0 20px 50px rgba(16,24,40,.25); display: flex; flex-direction: column; max-height: 90vh; font-family: 'Inter', system-ui, sans-serif; }
