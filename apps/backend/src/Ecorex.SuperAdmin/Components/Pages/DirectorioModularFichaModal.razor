    .fm-btn { border: 1px solid #e5e7eb; background: #fff; color: #374151; border-radius: 9px; padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .fm-btn-primary { background: #111827; color: #fff; border-color: #111827; }
    .fm-btn:disabled { opacity: .6; cursor: default; }
</style>

@code {
    // Modal DRIVEN POR PARAMETRO (mas robusto que @ref): el padre setea CategoriaKey para abrir y la
    // pone en null para cerrar (via OnClosed). Se carga la ficha cuando cambia CategoriaKey.
    [Parameter] public string? CategoriaKey { get; set; }
    // Si se pasa, el modal edita ese tercero (carga sus valores); si es null, crea uno nuevo.
    [Parameter] public Guid? TerceroId { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    // Devuelve el id del tercero guardado (creado o editado) para que el padre lo pueda seleccionar.
    // Un handler sin parametros (p.ej. GestorContactos.OnModularSavedAsync) tambien enlaza sin problema.
    [Parameter] public EventCallback<Guid?> OnSaved { get; set; }
    // O2-1: al hacer clic en un duplicado detectado, abre esa ficha existente (el padre lo maneja).
    [Parameter] public EventCallback<Guid> OnAbrirTercero { get; set; }

    private bool _saving;
    private string? _error;
    private string? _loadedFor;
    private bool _isEdit;
    private bool _notModular;   // el tercero a editar no es del motor Modular
    private Guid? _editId;
    // Naturaleza FIJA en edicion (O1-2): la ficha se adapta a ese tipo y no permite convertirlo.
    // Null = alta (la naturaleza se deduce de lo que se llena).
    private TerceroTipo? _natFijo;

    // R1: el tercero en edicion es un CONTACTO (persona vinculada a una organizacion). Se edita como
    // "publico basico": solo la seccion publica, sin secciones de perfilamiento (comercial/cliente/...).
    private bool _esContacto;

    // O2-1: coincidencias de duplicidad detectadas en vivo (por identificacion/correo/telefono).
    private IReadOnlyList<ModularDuplicadoDto> _duplicados = Array.Empty<ModularDuplicadoDto>();
    private bool _dupChecking;
    private string _estado = "Activo";
    private ModularFichaDto? _ficha;
    // ficha (seccion) -> campo -> valor
    private readonly Dictionary<string, Dictionary<string, string>> _valores = new(StringComparer.Ordinal);

    // Usuario actual (para AllowCreate de los campos tipo lista del Contenedor).
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private Guid _actorId;

    private bool IsOpen => CategoriaKey is not null || TerceroId is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen) { _loadedFor = null; return; }

        // Clave de carga: distingue crear (categoria) de editar (tercero) para no recargar en cada render.
        var loadKey = TerceroId is Guid tid ? $"edit:{tid}" : $"new:{CategoriaKey}";
        if (loadKey == _loadedFor) { return; }

        _loadedFor = loadKey;
        _error = null;
        _saving = false;
        if (_actorId == Guid.Empty && AuthState is not null)
        {
            var st = await AuthState;
            _actorId = Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : Guid.Empty;
        }
        _ficha = null;
        _valores.Clear();
        _estado = "Activo";
        _notModular = false;
        _natFijo = null;
        _esContacto = false;
        _duplicados = Array.Empty<ModularDuplicadoDto>();

        var catKey = CategoriaKey;
        Dictionary<string, Dictionary<string, string>>? cargados = null;
        _isEdit = TerceroId is not null;
        _editId = TerceroId;

        if (TerceroId is Guid id)
        {
            var ed = await Fichas.GetTerceroParaEditarAsync(id);
            if (ed is null) { _notModular = true; return; }
            catKey = ed.CategoriaKey ?? CategoriaKey;
            cargados = ed.Valores;
            _estado = ed.Estado;
            _natFijo = ed.Tipo;   // naturaleza inmutable en edicion (O1-2)
            _esContacto = ed.EsContacto;   // R1: contacto -> publico basico
        }

        if (catKey is null) { return; }
        _ficha = await Fichas.GetFichaAsync(catKey);
        if (_ficha is not null)
        {
            foreach (var sec in _ficha.Secciones)
            {
                var dict = new Dictionary<string, string>(StringComparer.Ordinal);
                // En edicion, precarga los valores guardados de esa seccion.
                if (cargados is not null && cargados.TryGetValue(sec.FichaKey, out var prev))
                {
                    foreach (var kv in prev) { dict[kv.Key] = kv.Value; }
                }
                _valores[sec.FichaKey] = dict;
            }

            // Si la ficha tiene algun campo tipo Asesor, carga el catalogo de asesores una vez (para el desplegable).
            if (_ficha.Secciones.Any(s => s.Campos.Any(c => c.Type == TerceroFieldType.Asesor)))
            {
                _asesores = (await AsesorSvc.ListOptionsAsync()).ToList();
            }
        }
    }

    // Catalogo de asesores/comerciales del tenant (000074), para los campos tipo Asesor.
    private List<Ecorex.Application.Asesores.AsesorOptionDto> _asesores = new();

    private async Task Close() => await OnClosed.InvokeAsync();

    private string GetVal(string ficha, string campo)
        => _valores.TryGetValue(ficha, out var d) && d.TryGetValue(campo, out var v) ? v : "";

    private void SetVal(string ficha, string campo, string? valor)
    {
        if (!_valores.TryGetValue(ficha, out var d)) { d = _valores[ficha] = new(StringComparer.Ordinal); }
        d[campo] = valor ?? "";
    }

    // ---- O2-1: alerta de duplicidad en vivo (identificacion / correo / telefono) ----
    private static readonly string[] CamposIdentidad = { "ide", "nit", "numero_identificacion", "correo", "telefono_empresa", "telefono_contacto" };

    /// <summary>Setea el valor y, si es un campo de identidad, revisa duplicados en tiempo real.</summary>
    private async Task OnValorChanged(string ficha, string campo, string? valor)
    {
        SetVal(ficha, campo, valor);
        // O3-4: al cambiar un campo del RUT, completa los publicos vacios (homologacion suave).
        if (CamposRut.Contains(campo, StringComparer.Ordinal)) { RellenarPublicoVacio(); }
        // O2-1: al cambiar un campo de identidad, revisa duplicados en vivo.
        if (CamposIdentidad.Contains(campo, StringComparer.Ordinal)) { await CheckDuplicadosAsync(); }
    }

    private async Task CheckDuplicadosAsync()
    {
        if (_dupChecking) { return; }   // serializa: 2 operaciones en el DbContext del circuito revientan
        _dupChecking = true;
        try
        {
            var ide = Find("ide") ?? Find("nit") ?? Find("numero_identificacion");
            var correo = Find("correo");
            var tel = Find("telefono_empresa") ?? Find("telefono_contacto");
            await FormGate.Gate.WaitAsync();
            try { _duplicados = await Fichas.BuscarDuplicadosAsync(ide, correo, tel, _editId); }
            finally { FormGate.Gate.Release(); }
        }
        catch { _duplicados = Array.Empty<ModularDuplicadoDto>(); }
        finally { _dupChecking = false; }
        StateHasChanged();
    }

    private static string MotivoTexto(string motivo) => motivo switch
    {
        "identificacion" => "identificacion",
        "correo" => "correo",
        "telefono" => "telefono",
        _ => motivo
    };

    // ---- Campos tipo lista del Contenedor/Directorio (Lookup/DirectoryLookup) ----

    /// <summary>Todos los valores de la ficha, con clave cualificada "{seccion}/{campo}", para la
    /// cascada de los lookups (que mira el formulario completo). Mismo formato que el motor Clasico.</summary>
    private Dictionary<string, string?> FlattenValores()
    {
        var todos = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var (ficha, campos) in _valores)
        {
            foreach (var (key, val) in campos) { todos[$"{ficha}/{key}"] = val; }
        }
        return todos;
    }

    /// <summary>Al elegir una fila del lookup, vuelca las columnas de autollenado en sus campos destino
    /// (clave "{seccion}/{campo}").</summary>
    private void AplicarAutollenado(IReadOnlyDictionary<string, string?> valores)
    {
        foreach (var (target, val) in valores)
        {
            var i = target.IndexOf('/');
            if (i <= 0 || i >= target.Length - 1) { continue; }
            SetVal(target[..i], target[(i + 1)..], val);
        }
    }

    // ---- Cascada geografica (Pais -> Departamento -> Ciudad), resuelta a nivel de seccion ----

    /// <summary>Cambia el Pais; si deja de ser Colombia limpia Departamento/Ciudad de la seccion
    /// (solo Colombia tiene catalogo de ciudades).</summary>
    private void OnPaisChanged(string ficha, string campo, string? valor)
    {
        SetVal(ficha, campo, valor);
        if (valor == Ecorex.Application.Catalogos.GeoPaises.Colombia) { return; }
        var sec = _ficha?.Secciones.FirstOrDefault(s => s.FichaKey == ficha);
        if (sec is null) { return; }
        foreach (var c in sec.Campos.Where(c => c.Type is TerceroFieldType.Departamento or TerceroFieldType.Ciudad))
        {
            SetVal(ficha, c.FieldKey, "");
        }
    }

    /// <summary>Cambia el Departamento; limpia la(s) Ciudad(es) de la seccion (dependen del departamento).</summary>
    private void OnDepartamentoChanged(string ficha, string campo, string? valor)
    {
        SetVal(ficha, campo, valor);
        var sec = _ficha?.Secciones.FirstOrDefault(s => s.FichaKey == ficha);
        if (sec is null) { return; }
        foreach (var c in sec.Campos.Where(c => c.Type == TerceroFieldType.Ciudad))
        {
            SetVal(ficha, c.FieldKey, "");
        }
    }

    private static bool EsRequerido(ModularCampoDto f) => !string.IsNullOrWhiteSpace(f.RequeridoEn);

    private string? Find(string campo)
    {
        foreach (var d in _valores.Values)
        {
            if (d.TryGetValue(campo, out var v) && !string.IsNullOrWhiteSpace(v)) { return v; }
        }
        return null;
    }

    private string NatText => NaturalezaPill().Item1;
    private string NatClass => NaturalezaPill().Item2;

    private static string SeccionColor(ModularSeccionDto s) => string.IsNullOrWhiteSpace(s.Color) ? "#4f46e5" : s.Color!;

    // Obligatorios pendientes en una seccion, segun la naturaleza deducida (empresa/contacto). Sin
    // naturaleza aun, cuenta todos los requeridos como pendientes (hay que definir un nombre primero).
    private int FaltantesEnSeccion(ModularSeccionDto sec)
    {
        var nat = NatClass;
        var n = 0;
        foreach (var f in sec.Campos)
        {
            if (!MostrarCampo(f)) { continue; }
            if (string.IsNullOrWhiteSpace(f.RequeridoEn)) { continue; }
            var aplica = nat switch
            {
                "org" => f.RequeridoEn.Contains("empresa", StringComparison.OrdinalIgnoreCase),
                "per" => f.RequeridoEn.Contains("contacto", StringComparison.OrdinalIgnoreCase),
                _ => true
            };
            if (aplica && string.IsNullOrWhiteSpace(GetVal(sec.FichaKey, f.FieldKey))) { n++; }
        }
        return n;
    }

    private static string FieldDomId(string ficha, string field) => $"fld-{ficha}-{field}";

    // ---- Campo tipo TABLA (filas dinamicas): la definicion de columnas viene serializada en Options ----
    private static readonly JsonSerializerOptions _jsonCi = new() { PropertyNameCaseInsensitive = true };

    private sealed class TablaSpec { public List<TablaCol> Columns { get; set; } = new(); }
    private sealed class TablaCol
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "texto";
        public bool ReadOnly { get; set; }
        public string? Autollena { get; set; }
        public List<TablaOpt> Options { get; set; } = new();
    }
    private sealed class TablaOpt { public string Value { get; set; } = ""; public string Label { get; set; } = ""; }

    private List<TablaCol> ParseTablaCols(string? optionsJson)
    {
        if (string.IsNullOrWhiteSpace(optionsJson)) { return new(); }
        try { return JsonSerializer.Deserialize<TablaSpec>(optionsJson, _jsonCi)?.Columns ?? new(); }
        catch { return new(); }
    }

    private List<Dictionary<string, string>> GetTablaRows(string ficha, string fieldKey)
    {
        var raw = GetVal(ficha, fieldKey);
        if (string.IsNullOrWhiteSpace(raw)) { return new(); }
        try { return JsonSerializer.Deserialize<List<Dictionary<string, string>>>(raw) ?? new(); }
        catch { return new(); }
    }

    private void SetTablaRows(string ficha, string fieldKey, List<Dictionary<string, string>> rows)
        => SetVal(ficha, fieldKey, JsonSerializer.Serialize(rows));

    private void AddTablaRow(string ficha, string fieldKey)
    {
        var rows = GetTablaRows(ficha, fieldKey);
        rows.Add(new Dictionary<string, string>(StringComparer.Ordinal));
        SetTablaRows(ficha, fieldKey, rows);
    }

    private void RemoveTablaRow(string ficha, string fieldKey, int index)
    {
        var rows = GetTablaRows(ficha, fieldKey);
        if (index >= 0 && index < rows.Count) { rows.RemoveAt(index); SetTablaRows(ficha, fieldKey, rows); }
    }

    private void SetTablaCell(string ficha, string fieldKey, int index, TablaCol col, string? value)
    {
        var rows = GetTablaRows(ficha, fieldKey);
        if (index < 0 || index >= rows.Count) { return; }
        rows[index][col.Key] = value ?? "";
        // Autollenado: al escoger el codigo se completa la columna destino con la etiqueta del catalogo.
        if (!string.IsNullOrWhiteSpace(col.Autollena))
        {
            var opt = col.Options.FirstOrDefault(o => o.Value == value);
            rows[index][col.Autollena!] = opt?.Label ?? "";
        }
        SetTablaRows(ficha, fieldKey, rows);
    }

    // Primer obligatorio pendiente (seccion, campo, etiqueta) segun la naturaleza deducida, o null.
    private (string Ficha, string Field, string Label)? FindFirstMissing()
    {
        if (_ficha is null) { return null; }
        var nat = NatClass;
        foreach (var sec in _ficha.Secciones.Where(MostrarSeccion))
        {
            foreach (var f in sec.Campos)
            {
                if (!MostrarCampo(f)) { continue; }
                if (string.IsNullOrWhiteSpace(f.RequeridoEn)) { continue; }
                var aplica = nat switch
                {
                    "org" => f.RequeridoEn.Contains("empresa", StringComparison.OrdinalIgnoreCase),
                    "per" => f.RequeridoEn.Contains("contacto", StringComparison.OrdinalIgnoreCase),
                    _ => true
                };
                if (aplica && string.IsNullOrWhiteSpace(GetVal(sec.FichaKey, f.FieldKey)))
                {
                    return (sec.FichaKey, f.FieldKey, f.Label);
                }
            }
        }
        return null;
    }

    private (string, string) NaturalezaPill()
    {
        // Edicion: la naturaleza es fija (O1-2), no se deduce ni se puede convertir.
        if (_natFijo is TerceroTipo nat)
        {
            return nat == TerceroTipo.Empresa ? ("Es una Organizacion.", "org") : ("Es una Persona.", "per");
        }
        // Homologacion Fiscal (O3-1): la naturaleza se deduce del RUT (casilla 24 / razon social / nombres).
        if (EsHomologante)
        {
            var t = HomologacionRut.Mapear(_valores).Tipo;
            if (t == TerceroTipo.Empresa) { return ("Se creara una Organizacion (desde el RUT).", "org"); }
            if (t == TerceroTipo.Persona) { return ("Se creara una Persona (desde el RUT).", "per"); }
            return ("Sin definir. Diligencia el RUT: tipo de contribuyente, razon social o nombres y apellidos.", "none");
        }
        var emp = Find("nombre_empresa") ?? Find("razon_social") ?? Find("nombre_comercial");
        var per = Find("contacto");
        if (!string.IsNullOrWhiteSpace(emp) && !string.IsNullOrWhiteSpace(per)) { return ("Se crearan una Organizacion y una Persona vinculada.", "org"); }
        if (!string.IsNullOrWhiteSpace(emp)) { return ("Se creara una Organizacion.", "org"); }
        if (!string.IsNullOrWhiteSpace(per)) { return ("Se creara una Persona.", "per"); }
        return ("Sin definir. Escribe el nombre de la empresa, el del contacto o ambos: de eso depende que se crea.", "none");
    }

    // ---- Visibilidad por naturaleza (O1-2): en EDICION la ficha muestra solo lo de su tipo. ----

    /// <summary>Naturaleza a la que aplica un campo, inferida de RequeridoEn o del sufijo del key.
    /// "org"/"per"/"" (ambos). Sin marca explicita, un campo aplica a las dos naturalezas.</summary>
    private static string CampoNaturaleza(ModularCampoDto f)
    {
        var req = f.RequeridoEn ?? "";
        var esEmp = req.Contains("empresa", StringComparison.OrdinalIgnoreCase) || f.FieldKey.EndsWith("_empresa", StringComparison.Ordinal);
        var esPer = req.Contains("contacto", StringComparison.OrdinalIgnoreCase) || f.FieldKey.EndsWith("_contacto", StringComparison.Ordinal);
        if (esEmp && !esPer) { return "org"; }
        if (esPer && !esEmp) { return "per"; }
        return "";
    }

    // Clave de la seccion publica (unica que ve un contacto en modo "publico basico", R1).
    private static readonly string PublicaKey = DirectorioModularDefaults.SeccionKey("publica");

    /// <summary>Muestra la seccion? R1: un contacto (persona vinculada a una organizacion) solo ve la
    /// seccion publica. Si no, en edicion se oculta lo que no aplica a la naturaleza fija (O1-2).</summary>
    private bool MostrarSeccion(ModularSeccionDto sec)
    {
        if (_esContacto) { return string.Equals(sec.FichaKey, PublicaKey, StringComparison.Ordinal); }
        if (_natFijo is not TerceroTipo nat) { return true; }
        if (string.IsNullOrWhiteSpace(sec.AplicaA)) { return true; }
        var token = nat == TerceroTipo.Empresa ? "empresa" : "contacto";
        return sec.AplicaA!.Contains(token, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Muestra el campo? En edicion oculta los exclusivos de la otra naturaleza.</summary>
    private bool MostrarCampo(ModularCampoDto f)
    {
        if (_natFijo is not TerceroTipo nat) { return true; }
        var cn = CampoNaturaleza(f);
        if (cn.Length == 0) { return true; }
        return cn == (nat == TerceroTipo.Empresa ? "org" : "per");
    }

    // ---- O3: homologacion RUT -> Directorio publico (regla 2.2) ----
    private bool EsHomologante => !string.IsNullOrWhiteSpace(_ficha?.HomologaSeccion);
    private bool TieneRut => _ficha?.Secciones.Any(s => s.Campos.Any(c => c.FieldKey is "razon_social" or "nit")) == true;
    private bool TienePublica => _ficha?.Secciones.Any(s => s.Campos.Any(c => c.FieldKey is "nombre_empresa" or "contacto")) == true;
    // O3-4: homologacion suave = categoria NO fiscal que compone RUT + publica a la vez.
    private bool HomologacionSuaveDisponible => !EsHomologante && TieneRut && TienePublica;

    // Campos del RUT cuyo cambio dispara la homologacion suave (rellenar publicos vacios).
    private static readonly string[] CamposRut =
    {
        "tipo_contribuyente", "razon_social", "nombre_comercial", "sigla",
        "primer_nombre", "otros_nombres", "primer_apellido", "segundo_apellido",
        "nit", "numero_identificacion", "correo_rut", "ciudad_rut", "pais_rut",
        "telefono_1", "telefono_2"
    };

    private bool HayConflictoRut(HomologacionRut.Resultado homo)
    {
        foreach (var kv in homo.Publico)
        {
            var actual = Find(kv.Key);
            if (!string.IsNullOrWhiteSpace(actual) && !string.Equals(actual.Trim(), kv.Value.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        return false;
    }

    // Escribe un valor publico en la seccion de la ficha que contiene ese campo.
    private void SetPublico(string campo, string valor)
    {
        var sec = _ficha?.Secciones.FirstOrDefault(s => s.Campos.Any(c => c.FieldKey == campo));
        if (sec is not null) { SetVal(sec.FichaKey, campo, valor); }
    }

    // O3-4: completa SOLO los campos publicos vacios desde el RUT (no pisa lo ya escrito).
    private void RellenarPublicoVacio()
    {
        if (!HomologacionSuaveDisponible) { return; }
        var homo = HomologacionRut.Mapear(_valores);
        foreach (var kv in homo.Publico)
        {
            if (string.IsNullOrWhiteSpace(Find(kv.Key))) { SetPublico(kv.Key, kv.Value); }
        }
    }

    // O3-4: el usuario acepta usar los del RUT (sobrescribe los publicos en conflicto).
    private void UsarLosDelRut(HomologacionRut.Resultado homo)
    {
        foreach (var kv in homo.Publico) { SetPublico(kv.Key, kv.Value); }
    }

    private RenderFragment RenderControl(string ficha, ModularCampoDto f) => builder =>
    {
        var val = GetVal(ficha, f.FieldKey);
        switch (f.Type)
        {
            case TerceroFieldType.TextArea:
                builder.OpenElement(0, "textarea");
                builder.AddAttribute(1, "class", "fm-textarea");
                builder.AddAttribute(20, "id", FieldDomId(ficha, f.FieldKey));
                builder.AddAttribute(2, "value", val);
                builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, e.Value?.ToString())));
                builder.CloseElement();
                break;
            case TerceroFieldType.Select:
            case TerceroFieldType.MultiSelect:
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "fm-select");
                builder.AddAttribute(20, "id", FieldDomId(ficha, f.FieldKey));
                if (f.Type == TerceroFieldType.MultiSelect) { builder.AddAttribute(2, "multiple", true); }
                builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, e.Value?.ToString())));
                builder.OpenElement(4, "option"); builder.AddAttribute(5, "value", ""); builder.AddContent(6, "-- seleccionar --"); builder.CloseElement();
                foreach (var op in (f.Options ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    builder.OpenElement(7, "option");
                    builder.AddAttribute(8, "value", op);
                    if (op == val) { builder.AddAttribute(9, "selected", true); }
                    builder.AddContent(10, op);
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;
            case TerceroFieldType.Checkbox:
                builder.OpenElement(0, "label");
                builder.AddAttribute(1, "class", "fm-check");
                builder.OpenElement(2, "input");
                builder.AddAttribute(3, "type", "checkbox");
                builder.AddAttribute(4, "checked", val == "true");
                builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, (e.Value is true).ToString().ToLowerInvariant())));
                builder.CloseElement();
                builder.AddContent(6, "Si");
                builder.CloseElement();
                break;
            case TerceroFieldType.Currency:
                // Moneda: prefijo "$" + input numerico (como el prototipo: input-group con addon).
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "class", "fm-money");
                builder.OpenElement(2, "span"); builder.AddAttribute(3, "class", "fm-money-sym"); builder.AddContent(4, "$"); builder.CloseElement();
                builder.OpenElement(5, "input");
                builder.AddAttribute(6, "class", "fm-input");
                builder.AddAttribute(7, "id", FieldDomId(ficha, f.FieldKey));
                builder.AddAttribute(8, "type", "number");
                builder.AddAttribute(9, "inputmode", "decimal");
                builder.AddAttribute(10, "value", val);
                builder.AddAttribute(11, "disabled", f.ReadOnly);
                builder.AddAttribute(12, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, e.Value?.ToString())));
                builder.CloseElement();
                builder.CloseElement();
                break;
            case TerceroFieldType.Pais:
                // Pais: lista corta (catalogo en codigo). Al cambiar a un pais != Colombia limpia
                // departamento/ciudad de la seccion (solo Colombia tiene catalogo de ciudades).
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "fm-select");
                builder.AddAttribute(20, "id", FieldDomId(ficha, f.FieldKey));
                builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => OnPaisChanged(ficha, f.FieldKey, e.Value?.ToString())));
                builder.OpenElement(4, "option"); builder.AddAttribute(5, "value", ""); builder.AddContent(6, "-- Pais --"); builder.CloseElement();
                foreach (var p in Ecorex.Application.Catalogos.GeoPaises.Todos)
                {
                    builder.OpenElement(7, "option");
                    builder.AddAttribute(8, "value", p);
                    if (p == val) { builder.AddAttribute(9, "selected", true); }
                    builder.AddContent(10, p);
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;
            case TerceroFieldType.Departamento:
            {
                var secD = _ficha?.Secciones.FirstOrDefault(s => s.FichaKey == ficha);
                var paisD = secD?.Campos.FirstOrDefault(c => c.Type == TerceroFieldType.Pais);
                var habilitado = paisD is null || GetVal(ficha, paisD.FieldKey) == Ecorex.Application.Catalogos.GeoPaises.Colombia;
                builder.OpenComponent<Ecorex.SuperAdmin.Components.Shared.Directorio.DmDepartamentoSelect>(0);
                builder.AddAttribute(1, "Value", val);
                builder.AddAttribute(2, "Enabled", habilitado);
                builder.AddAttribute(3, "ValueChanged", EventCallback.Factory.Create<string>(this, v => OnDepartamentoChanged(ficha, f.FieldKey, v)));
                builder.CloseComponent();
                break;
            }
            case TerceroFieldType.Ciudad:
            {
                var secC = _ficha?.Secciones.FirstOrDefault(s => s.FichaKey == ficha);
                var deptoC = secC?.Campos.FirstOrDefault(c => c.Type == TerceroFieldType.Departamento);
                if (deptoC is not null)
                {
                    // La seccion tiene Departamento: Ciudad = municipios de ese departamento (encadenado).
                    builder.OpenComponent<Ecorex.SuperAdmin.Components.Shared.Directorio.DmMunicipioSelect>(0);
                    builder.AddAttribute(1, "Value", val);
                    builder.AddAttribute(2, "Departamento", GetVal(ficha, deptoC.FieldKey));
                    builder.AddAttribute(3, "ValueChanged", EventCallback.Factory.Create<string>(this, v => SetVal(ficha, f.FieldKey, v)));
                    builder.CloseComponent();
                }
                else
                {
                    // Sin Departamento en la seccion (ej. Seccion publica): autocompletar sobre todos los municipios.
                    builder.OpenComponent<Ecorex.SuperAdmin.Components.Shared.Directorio.DmCiudadAutocomplete>(0);
                    builder.AddAttribute(1, "Value", val);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => SetVal(ficha, f.FieldKey, v)));
                    builder.CloseComponent();
                }
                break;
            }
            case TerceroFieldType.Asesor:
                // Lista de asesores/comerciales del tenant (catalogo 000074), en vivo. Guarda el nombre.
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "fm-select");
                builder.AddAttribute(20, "id", FieldDomId(ficha, f.FieldKey));
                builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetVal(ficha, f.FieldKey, e.Value?.ToString())));
                builder.OpenElement(4, "option"); builder.AddAttribute(5, "value", ""); builder.AddContent(6, "-- seleccionar --"); builder.CloseElement();
                foreach (var a in _asesores)
                {
                    builder.OpenElement(7, "option");
                    builder.AddAttribute(8, "value", a.Nombre);
                    if (a.Nombre == val) { builder.AddAttribute(9, "selected", true); }
                    builder.AddContent(10, a.Nombre);
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;
            case TerceroFieldType.Lookup:
            {
                // Lista alimentada por una tabla del Contenedor de datos. La config (tabla/columna/
                // cascada/autollenado) va en Options como JSON. Guarda el Id de la fila.
                var lkCfg = Ecorex.Application.DataLookups.DataLookupConfig.TryParse(f.Options);
                if (lkCfg is not null)
                {
                    builder.OpenComponent<Ecorex.SuperAdmin.Components.Shared.Lookups.DataLookupField>(0);
                    builder.AddAttribute(1, "Config", lkCfg);
                    builder.AddAttribute(2, "Value", (string?)val);
                    builder.AddAttribute(3, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetVal(ficha, f.FieldKey, v)));
                    builder.AddAttribute(4, "FormValues", (IReadOnlyDictionary<string, string?>)FlattenValores());
                    builder.AddAttribute(5, "OnAutofill", EventCallback.Factory.Create<IReadOnlyDictionary<string, string?>>(this, AplicarAutollenado));
                    builder.AddAttribute(6, "ActorUserId", _actorId);
                    builder.AddAttribute(7, "Placeholder", $"Buscar {f.Label.ToLowerInvariant()}...");
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenElement(0, "div");
                    builder.AddAttribute(1, "class", "fm-hint");
                    builder.AddContent(2, "Este campo aun no tiene configurada su tabla de origen.");
                    builder.CloseElement();
                }
                break;
            }
            case TerceroFieldType.DirectoryLookup:
            {
                // Lista alimentada por el Directorio de terceros (filtra por perfil). Guarda el Id del tercero.
                var dirCfg = Ecorex.Application.Forms.Lookups.DirectoryLookupConfig.TryParse(f.Options)
                             ?? new Ecorex.Application.Forms.Lookups.DirectoryLookupConfig();
                builder.OpenComponent<Ecorex.SuperAdmin.Components.Shared.Lookups.DirectoryLookupField>(0);
                builder.AddAttribute(1, "Config", dirCfg);
                builder.AddAttribute(2, "Value", (string?)val);
                builder.AddAttribute(3, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetVal(ficha, f.FieldKey, v)));
                builder.AddAttribute(4, "Placeholder", $"Buscar {f.Label.ToLowerInvariant()}...");
                builder.CloseComponent();
                break;
            }
            case TerceroFieldType.Calculated:
            case TerceroFieldType.Table:
                // v1: placeholder (estos controles ricos llegan en un slice posterior).
                builder.OpenElement(0, "input");
                builder.AddAttribute(1, "class", "fm-input");
                builder.AddAttribute(2, "disabled", true);
                builder.AddAttribute(3, "placeholder", $"({f.Type}) proximamente");
                builder.CloseElement();
                break;
            default:
                builder.OpenElement(0, "input");
                builder.AddAttribute(1, "class", "fm-input");
                builder.AddAttribute(20, "id", FieldDomId(ficha, f.FieldKey));
                builder.AddAttribute(2, "type", InputType(f.Type));
                builder.AddAttribute(3, "value", val);
                builder.AddAttribute(4, "disabled", f.ReadOnly);
                builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => OnValorChanged(ficha, f.FieldKey, e.Value?.ToString())));
                builder.CloseElement();
                break;
        }
    };

    private static string InputType(TerceroFieldType t) => t switch
    {
        TerceroFieldType.Number => "number",
        TerceroFieldType.Date => "date",
        TerceroFieldType.Email => "email",
        TerceroFieldType.Phone => "tel",
        _ => "text"
    };

    private async Task SaveAsync()
    {
        _error = null;
        if (_ficha is null) { return; }

        // Obligatorios (por naturaleza deducida): al primero que falte, salta a su seccion y lo enfoca
        // (como el prototipo). Usa la MISMA regla que el contador de las pestanas.
        var natCls = NatClass;
        var falta = FindFirstMissing();
        if (falta is { } m)
        {
            _error = natCls == "none"
                ? "Escribe al menos un nombre (empresa o contacto)."
                : $"Falta un campo obligatorio: {m.Label}.";
            await JS.InvokeVoidAsync("dmScrollToField", $"sec-{m.Ficha}", FieldDomId(m.Ficha, m.Field));
            return;
        }

        _saving = true;
        try
        {
            var req = new CreateModularTerceroRequest(_ficha.CategoriaKey,
                _valores.ToDictionary(k => k.Key, v => new Dictionary<string, string>(v.Value, StringComparer.Ordinal)));
            Guid? savedId;
            if (_isEdit && _editId is Guid id)
            {
                var err = await Fichas.UpdateTerceroAsync(id, req, _estado);
                if (err is not null) { _error = err; return; }
                savedId = id;
            }
            else
            {
                var (createdId, err) = await Fichas.CreateTerceroAsync(req);
                if (err is not null) { _error = err; return; }
                savedId = createdId;
            }
            await OnSaved.InvokeAsync(savedId);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
