    private static string RunDuration(ScrapeFlowRunDto r)
    {
        if (r.FinishedAt is not DateTimeOffset f) { return "-"; }
        // Pasos registrados antes del arreglo: inicio == fin exacto (no se media). Mejor "-" que un falso "0.0 s".
        if (f == r.FiredAt) { return "-"; }
        var d = f - r.FiredAt;
        if (d < TimeSpan.Zero) { d = TimeSpan.Zero; }
        if (d.TotalSeconds < 60) { return $"{d.TotalSeconds:0.0} s"; }
        if (d.TotalMinutes < 60) { return $"{(int)d.TotalMinutes} min {d.Seconds:00} s"; }
        return $"{(int)d.TotalHours} h {d.Minutes:00} min";
    }

    // Filas afectadas por la corrida/paso = nuevas + actualizadas + borradas (antes solo se mostraban las
    // nuevas, y un paso que solo actualizaba salia en 0). El detalle va en el tooltip.
    // KPI "Filas (ult.)": la ultima corrida COMPLETA exitosa (varios pasos); si no hay, la ultima exitosa.
    // Antes tomaba la ultima fila OK, que suele ser el paso "Cerrar navegador" (siempre 0).
    private ScrapeFlowRunDto? UltimaCorridaOk() =>
        _runs.FirstOrDefault(r => r.Result == ImportRunResult.Ok && r.StepCount > 1)
        ?? _runs.FirstOrDefault(r => r.Result == ImportRunResult.Ok);
    private static int FilasTotal(ScrapeFlowRunDto r) => r.Inserted + r.Updated + r.Deleted;
