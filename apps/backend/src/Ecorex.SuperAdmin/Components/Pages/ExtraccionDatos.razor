    /// <summary>Etiquetas de los tramos con fechas reales si la tarea corriera hoy ("1: 14-16 nov").</summary>
    private IEnumerable<string> TramoChips(FlowSequenceSpec sp)
    {
        var tramos = sp.Tramos();
        for (var i = 0; i < tramos.Count; i++)
        {
            if (i == 18 && tramos.Count > 20) { yield return "..."; i = tramos.Count - 2; continue; }
            var t = tramos[i];
            var fin = _wzToday.AddDays(-t.Desde);
            var ini = _wzToday.AddDays(-(t.Desde + t.Largo - 1));
            var txt = t.Largo == 1 ? fin.ToString("dd MMM", Es)
                : ini.Month == fin.Month ? $"{ini:dd}-{fin.ToString("dd MMM", Es)}"
                : $"{ini.ToString("dd MMM", Es)}-{fin.ToString("dd MMM", Es)}";
            yield return $"{t.Numero}: {txt.Replace(".", "")}";
        }
    }

    /// <summary>Resumen en lenguaje natural de los tramos.</summary>
    private static string SeqHuman(FlowSequenceSpec sp)
    {
        var t = sp.Tramos();
        if (t.Count == 0) { return "Sin tramos."; }
        var desde = sp.Desde == 0 ? "desde hoy" : $"desde hace {sp.Desde} dias";
        var veces = t.Count == 1 ? "1 corrida" : $"{t.Count} corridas seguidas";
        return $"Barre {sp.Hasta - sp.Desde} dias hacia atras {desde}, en {veces} de {sp.Paso} dia(s); pausa {sp.PausaMin} min entre corridas"
            + (sp.Reintentos > 0 ? $"; si una falla, reintenta a los {sp.ReintentoMin} min" : "")
            + (sp.MaxHoras > 0 ? $"; se detiene a las {sp.MaxHoras} h" : "") + ".";
    }

    // ---- Secuencia de tramos (ADR-0171): lanzar ya, detener y seguir el progreso ----

    private void RunSequenceNow(ScrapeScheduleDto s)
    {
        if (_selected is null || s.Sequence is null) { return; }
        if (Tenant.TenantId is not Guid tid) { Flash("No se pudo resolver el tenant.", true); return; }
        if (RunSvc.IsFlowRunning(_selected.Id)) { Flash("El flujo ya tiene una corrida en curso. Espera a que termine.", true); return; }
        if (!Sequences.TryStart(tid, _selected.Id, s.Id, s.Name, s.Sequence, ImportRunTrigger.Manual, out var err))
        {
            Flash("No se pudo iniciar la secuencia: " + err, true);
            return;
        }
        Flash($"Secuencia \"{s.Name}\" iniciada: {s.Sequence.Describe()}.");
        RefreshSeqStatus();
    }

    public void Dispose() { _seqTimer?.Dispose(); _seqTimer = null; }

    private void StopSequence()
    {
        if (_selected is null) { return; }
        if (Sequences.Cancel(_selected.Id)) { Flash("Se detendra al terminar el tramo en curso."); }
        RefreshSeqStatus();
    }

    private void RefreshSeqStatus()
    {
        _seqStatus = _selected is null ? null : Sequences.GetStatus(_selected.Id);
        // Mientras haya una secuencia viva, refresca solo cada 20 s (estado del tramo, pausa, reintento).
        if (_seqStatus is { Finished: false })
        {
            _seqTimer ??= new System.Threading.Timer(_ => InvokeAsync(() =>
            {
                _seqStatus = _selected is null ? null : Sequences.GetStatus(_selected.Id);
                if (_seqStatus is null || _seqStatus.Finished)
                {
                    _seqTimer?.Dispose(); _seqTimer = null;
                }
                StateHasChanged();
            }), null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
        }
    }

    private async Task RunFlowAsync()
    {
        if (_selected is null) { return; }
        if (Tenant.TenantId is not Guid tenantId) { Flash("No se pudo resolver el tenant.", true); return; }
        _busy = true;
        try
        {
            var result = await RunSvc.RunFlowNowAsync(_selected.Id, tenantId, ImportRunTrigger.Manual);
            if (result.Offline)
            {
                Flash("El agente asignado no esta en linea. La corrida quedo esperando a que vuelva.");
            }
            else if (!result.Dispatched)
            {
                Flash(result.Error ?? "No se pudo ejecutar el flujo.", true);
            }
            else
            {
                Flash("Flujo despachado al agente. El resultado aparecera en el historial al completarse.");
            }
            // Recarga la bitacora y el flujo (LastRunAt/estado pudieron cambiar).
            await SelectFlowAsync(_selected.Id);
            await ReloadFlowsAsync();
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { _busy = false; }
    }

    // ---- Paso a paso (sesion viva) ----

    private int _stepCursor;
    private StepRunResult? _stepResult;

    private async Task RunStepAsync(ScrapeStepDto s, int index)
    {
        await ExecStepCore(s);
        // El cursor avanza al siguiente del paso que se corrio (asi "Ejecutar siguiente" continua desde aqui).
        _stepCursor = Math.Min(index + 1, _selected?.Steps.Count ?? index + 1);
    }

    private async Task RunNextStepAsync()
    {
        if (_selected is null || _stepCursor < 0 || _stepCursor >= _selected.Steps.Count) { return; }
        var s = _selected.Steps.ElementAt(_stepCursor);
        await ExecStepCore(s);
        _stepCursor = Math.Min(_stepCursor + 1, _selected.Steps.Count);
    }

    private void ResetCursor() { _stepCursor = 0; _stepResult = null; }

    private async Task RunLoopAsync(ScrapeStepDto s)
    {
        if (_selected is null) { return; }
        if (Tenant.TenantId is not Guid tenantId) { Flash("No se pudo resolver el tenant.", true); return; }
        _busy = true; _stepResult = null;
        var flowId = _selected.Id;
        try
        {
            _stepResult = await RunSvc.RunLoopNowAsync(flowId, s.Id, tenantId);
            if (_stepResult.Offline) { Flash("El agente no esta en linea. Conectalo contra este servidor y reintenta.", true); }
            else if (!_stepResult.Ok) { Flash(_stepResult.Error ?? "El bucle fallo.", true); }
            else { Flash($"Bucle \"{s.Name}\": {_stepResult.Detail}"); }
            await SelectFlowAsync(flowId);
            await ReloadFlowsAsync();
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task ExecStepCore(ScrapeStepDto s)
    {
        if (_selected is null) { return; }
        if (Tenant.TenantId is not Guid tenantId) { Flash("No se pudo resolver el tenant.", true); return; }
        _busy = true; _stepResult = null;
        var flowId = _selected.Id;
        try
        {
            _stepResult = await RunSvc.RunStepNowAsync(flowId, s.Id, tenantId);
            if (_stepResult.Offline) { Flash("El agente no esta en linea. Conectalo contra este servidor y reintenta.", true); }
            else if (!_stepResult.Ok) { Flash(_stepResult.Error ?? "El paso fallo.", true); }
            else { Flash($"Paso \"{s.Name}\": {_stepResult.Detail}"); }
            // Refresca la bitacora/flujo (cada paso queda registrado), preservando el resultado y el cursor.
            await SelectFlowAsync(flowId);
            await ReloadFlowsAsync();
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { _busy = false; }
    }

