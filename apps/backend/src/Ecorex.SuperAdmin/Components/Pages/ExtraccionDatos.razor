@page "/extraccion-datos"
@attribute [Authorize(Policy = "ExtraccionDatos.Editar")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Ecorex.Application.Scraping
@using Ecorex.Application.DataContainers
@using Ecorex.Application.Admin
@using Ecorex.Application.Common
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Agents
@inject IScrapeFlowService FlowSvc
@inject IOtpMailboxConfigService OtpSvc
@inject IDataImportConfigService ConfigSvc
@inject IBrowserRunService RunSvc
@inject IFlowSequenceRunner Sequences
@implements IDisposable
@inject IAiServerConfigService AiSvc
@inject IAgentRegistry Agents
@inject ITenantContext Tenant
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject Ecorex.Application.Actividades.IActividadCatalogoService Catalogo
@inject Ecorex.Application.Tenancy.ITenantUserService UsersSvc
@inject Ecorex.Application.Forms.IFormDefinitionService FormDefs
@inject Ecorex.Application.Tenancy.IWhatsAppLineService WaLines
@inject Ecorex.Application.Tenancy.IWhatsAppTemplateService WaTemplates

<PageTitle>Extraccion de datos - ECOREX.tareas</PageTitle>

<div class="xd-page">

    @* ===== Topbar (proto: breadcrumb + MOD 000730 + acciones) ===== *@
    <div class="xd-topbar">
        <nav class="xd-crumb" aria-label="Ruta de navegacion">
            <span>Home</span><span class="sep">/</span>
            <span>Utilidades</span><span class="sep">/</span>
            <span class="last">Extraccion de datos</span>
            <span class="xd-mod-code">MOD 000730</span>
        </nav>
        <div class="xd-top-actions">
            <button class="xd-btn xd-new-btn primary" @onclick="NewFlow">+ Nueva configuracion</button>
        </div>
    </div>

    @if (_flash is not null)
    {
        <div class="xd-flash @(_flashError ? "err" : "ok")" role="status">
            <span>@_flash</span>
            <button class="xd-flash-x" @onclick="() => _flash = null" title="Cerrar">x</button>
        </div>
    }

    <div class="xd-layout">

        @* ---- Sidebar: lista de flujos ---- *@
        <aside class="xd-side">
            <div class="xd-side-head">
                <div class="xd-side-title">Configuraciones <span class="xd-side-count">@_flows.Count</span></div>
            </div>
            <div class="xd-side-search">
                <DebouncedInput placeholder="Buscar..." @bind-Value="_search" />
            </div>
            <div class="xd-side-list">
                @if (FilteredFlows.Count == 0)
                {
                    <div class="xd-empty">@(_flows.Count == 0 ? "Aun no hay flujos. Crea el primero con + Nueva configuracion." : "Sin resultados.")</div>
                }
                @foreach (var f in FilteredFlows)
                {
                    <div class="xd-item @(_selected?.Id == f.Id && !_isNew ? "active" : "")" @onclick="() => PickFlowAsync(f.Id)">
                        <div class="xd-item-icon">@Initial(f.Name)</div>
                        <div class="xd-item-body">
                            <div class="xd-item-name" title="@f.Name">@f.Name</div>
                            <div class="xd-item-meta">
                                <span class="xd-dot @DotClass(f.Status)"></span>
                                @StatusLabel(f.Status) &middot; @f.StepCount paso@(f.StepCount == 1 ? "" : "s")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <div class="xd-main">

            @if (_isNew)
            {
                @* ---- Alta de un flujo nuevo (cabecera minima) ---- *@
                <div class="xd-card">
                    <div class="xd-card-head"><div class="xd-card-title">Nueva configuracion</div></div>
                    <div class="xd-props-body">
                        <div class="xd-prop">
                            <label>Nombre</label>
                            <input class="xd-input" placeholder="Ej. Precios competencia Homecenter" @bind="_hName" />
                        </div>
                        <div class="xd-prop">
                            <label>URL de arranque</label>
                            <input class="xd-input" placeholder="https://..." @bind="_hUrl" />
                        </div>
                        @if (_headError is not null) { <div class="xd-error-box">@_headError</div> }
                        <div class="xd-props-actions">
                            <button class="xd-btn primary" @onclick="CreateFlowAsync" disabled="@_busy">Crear</button>
                            <button class="xd-btn" @onclick="CancelNew">Cancelar</button>
                        </div>
                    </div>
                </div>
            }
            else if (_selected is null)
            {
                <div class="xd-card"><div class="xd-card-empty">Elige un flujo de la izquierda, o crea uno nuevo.</div></div>
            }
            else
            {
                var flow = _selected;

                @* ---- Pestanas del flujo: Configuracion | Programacion | Historial ---- *@
                <div class="xd-tabs" role="tablist">
                    <button type="button" role="tab" class="xd-tab @(_tab == TabConfig ? "active" : "")"
                            aria-selected="@(_tab == TabConfig)" @onclick="() => _tab = TabConfig">Configuracion</button>
                    <button type="button" role="tab" class="xd-tab @(_tab == TabProg ? "active" : "")"
                            aria-selected="@(_tab == TabProg)" @onclick="() => _tab = TabProg">
                        Programacion <span class="xd-num-badge">@_schedules.Count</span>
                    </button>
                    <button type="button" role="tab" class="xd-tab @(_tab == TabHist ? "active" : "")"
                            aria-selected="@(_tab == TabHist)" @onclick="() => _tab = TabHist">
                        Historial <span class="xd-num-badge">@_runs.Count</span>
                    </button>
                </div>

                @* ---- Hero ---- *@
                <div class="xd-hero">
                    <div class="xd-hero-head">
                        <div>
                            <h1 class="xd-hero-title">
                                <span>@flow.Name</span>
                                <span class="xd-hero-badge">@StatusLabel(flow.Status)</span>
                            </h1>
                            <div class="xd-hero-url">@flow.StartUrl</div>
                        </div>
                        <div class="xd-hero-actions">
                            <button class="xd-hero-btn" @onclick="RunFlowAsync" disabled="@(_busy || flow.Steps.Count == 0)">
                                @(_busy ? "Ejecutando..." : "Ejecutar ahora")
                            </button>
                            <button class="xd-hero-btn ghost" @onclick="ToggleHeaderEdit">@(_editHeader ? "Cerrar" : "Editar")</button>
                            <button class="xd-hero-btn ghost" @onclick="DeleteFlowAsync" disabled="@_busy">Eliminar</button>
                        </div>
                    </div>
                    <div class="xd-kpis">
                        <div class="xd-kpi"><div class="lbl">Corridas</div><div class="val">@_runs.Count</div></div>
                        <div class="xd-kpi"><div class="lbl">Exitosas</div><div class="val">@_runs.Count(r => r.Result == ImportRunResult.Ok)</div></div>
                        <div class="xd-kpi"><div class="lbl">Filas (ult.)</div><div class="val">@(UltimaCorridaOk() is { } lastOk ? FilasTotal(lastOk).ToString() : "-")</div></div>
                        <div class="xd-kpi"><div class="lbl">Ultima corrida</div><div class="val">@(flow.LastRunAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "nunca")</div></div>
                    </div>
                </div>

                @if (_tab == TabConfig)
                {
                @* ---- Banda: el runtime es la colmena, no esta pantalla ---- *@
                <div class="xd-strip">
                    <strong>Runtime:</strong>&nbsp; "Ejecutar ahora" ejecuta el flujo paso a paso en el
                    <strong>sub-agente Navegador</strong> del agente asignado (WebView2 + acciones tipadas + JS firmado).
                    Los pasos de <strong>IA</strong> los maneja un agente con las tools del navegador (acotado por su
                    allow-list y sus topes), y requieren un proveedor de IA habilitado en el Super Admin.
                    Si el agente no esta en linea, la corrida queda <strong>esperando</strong> y se reintenta cuando vuelva.
                </div>

                @if (_editHeader)
                {
                    @* ---- Edicion de cabecera ---- *@
                    <div class="xd-card">
                        <div class="xd-card-head"><div class="xd-card-title">Cabecera del flujo</div></div>
                        <div class="xd-props-body">
                            <div class="xd-prop"><label>Nombre</label><input class="xd-input" @bind="_hName" /></div>
                            <div class="xd-prop"><label>Descripcion</label><input class="xd-input" @bind="_hDesc" /></div>
                            <div class="xd-prop"><label>URL de arranque</label><input class="xd-input" @bind="_hUrl" /></div>
                            <div class="xd-prop">
                                <label>Estado</label>
                                <select class="xd-input" @bind="_hStatus">
                                    @foreach (var st in Enum.GetValues<ScrapeSourceStatus>())
                                    { <option value="@st">@StatusLabel(st)</option> }
                                </select>
                            </div>
                            <div class="xd-prop">
                                <label>Paginacion (opcional): variable de pagina</label>
                                <input class="xd-input mono" placeholder="PAGINA" @bind="_hPageVar" />
                            </div>
                            <div class="xd-two">
                                <div class="xd-prop"><label>Desde</label><input class="xd-input" type="number" @bind="_hPageFrom" /></div>
                                <div class="xd-prop"><label>Hasta</label><input class="xd-input" type="number" @bind="_hPageTo" /></div>
                            </div>
                            <div class="xd-help">Si defines una variable de pagina y un rango, el flujo se repite por cada
                                pagina, sustituyendo {{ese nombre}} en las URLs/scripts.</div>
                            @if (_headError is not null) { <div class="xd-error-box">@_headError</div> }
                            <div class="xd-props-actions">
                                <button class="xd-btn primary" @onclick="SaveHeaderAsync" disabled="@_busy">Guardar</button>
                                <button class="xd-btn" @onclick="() => _editHeader = false">Cancelar</button>
                            </div>
                        </div>
                    </div>
                }

                <div class="xd-cols">

                    @* ===== Pasos ===== *@
                    <div class="xd-card">
                        <div class="xd-card-head">
                            <div class="xd-card-title">Pasos de ejecucion <span class="xd-num-badge">@flow.Steps.Count</span></div>
                            <div style="display:flex; gap:8px; align-items:center;">
                                <button class="xd-btn sm" @onclick="ExportStepsAsync"
                                        disabled="@(_busy || flow.Steps.Count == 0)"
                                        title="Descargar los pasos de este flujo como JSON (sin variables)">Exportar pasos</button>
                                <label class="xd-btn sm" style="margin:0;"
                                       title="Reemplazar los pasos de este flujo con los de un archivo JSON">
                                    Importar pasos
                                    <InputFile OnChange="OnImportStepsSelected" accept=".json" style="display:none;" />
                                </label>
                                <button class="xd-btn sm primary" @onclick="() => OpenStepEditor(null)">+ Agregar paso</button>
                            </div>
                        </div>

                        @* ---- Confirmacion de importacion (reemplazo total de pasos) ---- *@
                        @if (_importJson is not null)
                        {
                            <div style="border:1px solid var(--xd-warn, #e0a800); background:rgba(224,168,0,.08); border-radius:8px; padding:12px; margin:8px 0;">
                                <div>Importar <strong>@_importFileName</strong> <strong>REEMPLAZARA</strong> los @flow.Steps.Count paso(s) actuales de este flujo. Las variables no se tocan.</div>
                                <div style="display:flex; gap:8px; margin-top:10px;">
                                    <button class="xd-btn sm primary" @onclick="ConfirmImportStepsAsync" disabled="@_busy">@(_busy ? "Importando..." : "Reemplazar pasos")</button>
                                    <button class="xd-btn sm" @onclick="CancelImportSteps" disabled="@_busy">Cancelar</button>
                                </div>
                            </div>
                        }
                        @if (_importWarnings.Count > 0)
                        {
                            <div style="border:1px solid var(--xd-warn, #e0a800); background:rgba(224,168,0,.08); border-radius:8px; padding:12px; margin:8px 0;">
                                <div><strong>Importado con avisos</strong> (referencias de otro entorno que quedaron sin asignar; re-enlazalas en cada paso):</div>
                                <ul style="margin:6px 0 0 18px;">
                                    @foreach (var w in _importWarnings) { <li>@w</li> }
                                </ul>
                            </div>
                        }

                        @* ---- Paso a paso (sesion viva): inyecta un paso a la vez sobre la MISMA ventana del agente ---- *@
                        @if (flow.Steps.Count > 0)
                        {
                            <div class="xd-stepper">
                                <div class="xd-stepper-info">
                                    <span class="xd-stepper-label">Paso a paso</span>
                                    <span class="xd-stepper-next">
                                        @if (_stepCursor < flow.Steps.Count)
                                        { <text>Proximo: @(_stepCursor + 1). @flow.Steps.ElementAt(_stepCursor).Name</text> }
                                        else
                                        { <text>Fin del flujo</text> }
                                    </span>
                                </div>
                                <div class="xd-stepper-actions">
                                    <button class="xd-btn sm primary" @onclick="RunNextStepAsync"
                                            disabled="@(_busy || _stepCursor >= flow.Steps.Count)">
                                        @(_busy ? "Ejecutando..." : "Ejecutar siguiente ▶")
                                    </button>
                                    <button class="xd-btn sm" @onclick="ResetCursor" disabled="@(_busy || _stepCursor == 0)">Reiniciar</button>
                                    <button class="xd-btn sm" @onclick="CloseLiveSessionAsync" disabled="@_busy" title="Cierra la ventana que el agente mantiene abierta">Cerrar navegador</button>
                                </div>
                            </div>
                            <div class="xd-stepper-help">Cada paso se inyecta en el navegador del agente y la ventana <strong>queda abierta</strong>
                                para el siguiente (login &rarr; OTP &rarr; continuar). Pulsa &#9654; en un paso para correr ese, o "Ejecutar siguiente"
                                para avanzar en orden. Al terminar, "Cerrar navegador".</div>
                        }

                        <div class="xd-steps">
                            @if (flow.Steps.Count == 0)
                            {
                                <div class="xd-empty">Sin pasos. Agrega el primero (navegar, inyectar script, extraer, o un paso de IA).</div>
                            }
                            @{ var idx = 0; }
                            @foreach (var s in flow.Steps)
                            {
                                var i = idx++;
                                <div class="xd-step @(i == _stepCursor ? "cursor" : "")">
                                    <div class="xd-step-num">@(i + 1)</div>
                                    <div class="xd-step-body">
                                        <h4>@s.Name <span class="xd-tag @TagClass(s.Kind)">@KindLabel(s.Kind)</span></h4>
                                        <div class="xd-step-desc">@StepSummary(s)</div>
                                        @if (!string.IsNullOrWhiteSpace(s.Url)) { <span class="xd-step-url">@s.Url</span> }
                                        @if (!string.IsNullOrWhiteSpace(s.Script))
                                        { <pre class="xd-code-editor">@Shorten(s.Script, 240)</pre> }
                                        @if (s.Kind == ScrapeStepKind.Ai && !string.IsNullOrWhiteSpace(s.Instruction))
                                        { <div class="xd-step-ai">"@s.Instruction"</div> }
                                    </div>
                                    <div class="xd-step-actions">
                                        <button class="xd-icon-btn play" title="Ejecutar este paso (sesion viva)" disabled="@_busy" @onclick="() => RunStepAsync(s, i)">&#9654;</button>
                                        @if (!string.IsNullOrWhiteSpace(s.LoopOverVar))
                                        {
                                            <button class="xd-icon-btn loop" title="Ejecutar bucle (consumir todas las filas)" disabled="@_busy" @onclick="() => RunLoopAsync(s)">&#8635;</button>
                                        }
                                        <button class="xd-icon-btn" title="Subir" disabled="@(i == 0)" @onclick="() => MoveStepAsync(i, -1)">&uarr;</button>
                                        <button class="xd-icon-btn" title="Bajar" disabled="@(i == flow.Steps.Count - 1)" @onclick="() => MoveStepAsync(i, 1)">&darr;</button>
                                        <button class="xd-icon-btn" title="Editar" @onclick="() => OpenStepEditor(s)">&#9998;</button>
                                        <button class="xd-icon-btn" title="Eliminar" @onclick="() => DeleteStepAsync(s.Id)">&times;</button>
                                    </div>
                                </div>
                            }
                        </div>

                        @* ---- Resultado del ultimo paso ejecutado (paso a paso) ---- *@
                        @if (_stepResult is not null)
                        {
                            <div class="xd-step-result @(_stepResult.Ok ? "ok" : "err")">
                                <div class="xd-step-result-head">
                                    <strong>@(_stepResult.Ok ? "✓ Paso OK" : "✕ Paso con error")</strong>
                                    @if (!string.IsNullOrWhiteSpace(_stepResult.Detail)) { <span class="xd-step-result-detail">@_stepResult.Detail</span> }
                                    <button class="xd-flash-x" @onclick="() => _stepResult = null" title="Cerrar">x</button>
                                </div>
                                @if (!_stepResult.Ok && !string.IsNullOrWhiteSpace(_stepResult.Error))
                                { <div class="xd-step-result-err">@_stepResult.Error</div> }
                                @if (!string.IsNullOrWhiteSpace(_stepResult.Value))
                                { <pre class="xd-step-result-val">@_stepResult.Value</pre> }
                                @if (!string.IsNullOrEmpty(_stepResult.ScreenshotBase64))
                                { <img class="xd-step-shot" src="data:image/png;base64,@_stepResult.ScreenshotBase64" alt="Captura del paso" /> }
                            </div>
                        }

                        @if (_showStepEditor)
                        {
                            <div class="xd-modal-backdrop" @onclick="() => _showStepEditor = false">
                              <div class="xd-modal" @onclick:stopPropagation="true">
                                <div class="xd-modal-head">
                                    <div class="xd-card-title" style="font-size:14px;">@(_editingStepId is null ? "Nuevo paso" : "Editar paso")</div>
                                    <button class="xd-icon-btn" title="Cerrar" @onclick="() => _showStepEditor = false">&times;</button>
                                </div>
                                <div class="xd-modal-body">
                                <div class="xd-prop">
                                    <label>Tipo de paso</label>
                                    <select class="xd-input" @bind="_sKind" @bind:after="OnStepKindChangedAsync">
                                        @foreach (var k in Enum.GetValues<ScrapeStepKind>())
                                        { <option value="@k">@KindLabel(k)</option> }
                                    </select>
                                </div>
                                <div class="xd-prop"><label>Nombre</label><input class="xd-input" placeholder="Ej. Login con credenciales" @bind="_sName" /></div>

                                @if (_sKind == ScrapeStepKind.Navigate)
                                {
                                    <div class="xd-prop"><label>URL (admite {{VAR}})</label><input class="xd-input" @bind="_sUrl" /></div>
                                }
                                else if (IsScriptKind(_sKind))
                                {
                                    <div class="xd-prop"><label>Script JS (cuerpo de funcion: usa <code>return</code>; el servidor lo firma al ejecutar)</label>
                                        <textarea class="xd-input xd-code-input" rows="6"
                                            placeholder="return Array.from(document.querySelectorAll('.fila')).map(r => ({ CODIGO: r.dataset.id, NOMBRE: r.querySelector('.nombre').innerText }));"
                                            @bind="_sScript"></textarea></div>
                                    @if (IsExtractKind(_sKind))
                                    {
                                        <div class="xd-prop"><label>Mapeo campo -> columna (JSON, opcional)</label>
                                            <textarea class="xd-input xd-code-input" rows="3" placeholder='{"sku":"CODIGO","nombre":"NOMBRE"}' @bind="_sMappingJson"></textarea></div>
                                        <div class="xd-prop"><label>Tabla destino (si difiere de la del flujo)</label>
                                            <select class="xd-input" @bind="_sTargetContainer">
                                                <option value="">(la del flujo)</option>
                                                @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                            </select></div>
                                    }
                                }
                                else if (_sKind == ScrapeStepKind.Wait)
                                {
                                    <div class="xd-prop"><label>Selector a esperar (opcional)</label><input class="xd-input" @bind="_sSelector" /></div>
                                    <div class="xd-prop"><label>Espera (ms)</label><input class="xd-input" type="number" @bind="_sWaitMs" /></div>
                                }
                                else if (IsClickKind(_sKind))
                                {
                                    <div class="xd-prop"><label>Selector a clicar</label><input class="xd-input" @bind="_sSelector" /></div>
                                }
                                else if (_sKind == ScrapeStepKind.Ai)
                                {
                                    <div class="xd-prop"><label>Instruccion (lenguaje natural)</label>
                                        <textarea class="xd-input" rows="3" placeholder="Ej. saca la tabla de precios y ponla en Productos" @bind="_sInstruction"></textarea></div>
                                    <div class="xd-prop"><label>Tabla destino</label>
                                        <select class="xd-input" @bind="_sTargetContainer">
                                            <option value="">(la del flujo)</option>
                                            @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                        </select></div>
                                    <div class="xd-prop"><label>Tools permitidas (browser.*, separadas por coma)</label>
                                        <input class="xd-input" placeholder="navigate, eval, screenshot" @bind="_sToolAllow" /></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Tope de pasos</label><input class="xd-input" type="number" @bind="_sMaxSteps" /></div>
                                        <div class="xd-prop"><label>Tope de segundos</label><input class="xd-input" type="number" @bind="_sMaxSeconds" /></div>
                                    </div>
                                    <div class="xd-prop"><label>IA (entre las habilitadas por el Super Admin)</label>
                                        @if (_aiProviders.Count == 0)
                                        {
                                            <div class="xd-hint">No hay IAs habilitadas. Habilita un proveedor en Super Admin -&gt; Servidores de IA.</div>
                                        }
                                        else
                                        {
                                            <select class="xd-input" @bind="_sAiProviderId">
                                                <option value="">(elige una IA)</option>
                                                @foreach (var p in _aiProviders) { <option value="@p.ConfigId">@p.DisplayName</option> }
                                            </select>
                                        }
                                    </div>
                                    <div class="xd-prop"><label>Modelo (lo fija el Super Admin)</label>
                                        <input class="xd-input" value="@SelectedAiModel()" disabled /></div>
                                }
                                else if (_sKind == ScrapeStepKind.LeerCorreoOtp)
                                {
                                    <div class="xd-prop"><label>Buzon OTP</label>
                                        @if (_buzones.Count == 0)
                                        {
                                            <div class="xd-hint">No hay buzones. Configura uno en Automatizaciones -&gt; Buzones OTP.</div>
                                        }
                                        else
                                        {
                                            <select class="xd-input" @bind="_sOtpMailbox">
                                                <option value="">(elige un buzon)</option>
                                                @foreach (var m in _buzones) { <option value="@m.Id">@m.Nombre (@m.Usuario)</option> }
                                            </select>
                                        }
                                    </div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Remitente contiene (opcional)</label><input class="xd-input" placeholder="no-reply@@..." @bind="_sOtpFrom" /></div>
                                        <div class="xd-prop"><label>Asunto contiene (opcional)</label><input class="xd-input" placeholder="codigo, verificacion" @bind="_sOtpSubject" /></div>
                                    </div>
                                    <div class="xd-prop"><label>Regex del token (grupo 1 si existe)</label><input class="xd-input" @bind="_sOtpRegex" /></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Variable destino (se inserta como &#123;&#123;NOMBRE&#125;&#125; en pasos siguientes)</label><input class="xd-input" placeholder="TOKEN" @bind="_sOtpVar" /></div>
                                        <div class="xd-prop"><label>Timeout de espera (seg)</label><input class="xd-input" type="number" @bind="_sOtpTimeout" /></div>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_sOtpUrlDecode" /> Decodificar enlace (&amp;amp; &rarr; &amp;, %XX)</label>
                                    <div class="xd-help">Actualo si el token es un ENLACE que llega HTML-escapado en el correo (p.ej. DIAN: <code>AuthToken?pk=..&amp;amp;rk=..</code>). Lo deja navegable. Para un OTP numerico, dejalo apagado.</div>
                                    <div class="xd-props-actions">
                                        <button class="xd-btn" @onclick="ProbarOtpAsync" disabled="@(_busy || string.IsNullOrEmpty(_sOtpMailbox))">@(_busy ? "Leyendo..." : "Probar lectura")</button>
                                    </div>
                                    @if (_otpTest is not null)
                                    {
                                        <div class="xd-hint" style="margin-top:6px">
                                            @if (_otpTest.Ok) { <span>Token leido: <strong>@_otpTest.Token</strong> (@_otpTest.MatchedSubject)</span> }
                                            else { <span style="color:var(--danger,#b91c1c)">@_otpTest.Error</span> }
                                        </div>
                                    }
                                }
                                else if (_sKind == ScrapeStepKind.IngestaNewton)
                                {
                                    <div class="xd-help">Baja los documentos recibidos en NEWTON (API) como <code>{CUFE}.xml</code> y <code>{CUFE}_newton.pdf</code> a una carpeta propia. Las credenciales salen de variables del flujo (la del token debe ser <b>secreta</b>).</div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Variable con la URL base</label><input class="xd-input mono" placeholder="NEWTON_URL" @bind="_nwUrlVar" /></div>
                                        <div class="xd-prop"><label>Variable con el Auth-Token (secreta)</label><input class="xd-input mono" placeholder="NEWTON_TOKEN" @bind="_nwTokenVar" /></div>
                                    </div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Variable con la carpeta destino</label><input class="xd-input mono" placeholder="RutaDescargaNewton" @bind="_nwCarpetaVar" /><div class="xd-help">Si esa variable no existe, usa una subcarpeta <code>Newton</code> de <code>RutaDescargaBot</code>.</div></div>
                                        <div class="xd-prop"><label>Dias hacia atras</label><input class="xd-input" type="number" @bind="_nwDiasAtras" /></div>
                                    </div>
                                    <div class="xd-two">
                                        <label class="xd-check"><input type="checkbox" @bind="_nwBajarXml" /> Bajar XML (&#123;CUFE&#125;.xml)</label>
                                        <label class="xd-check"><input type="checkbox" @bind="_nwBajarPdf" /> Bajar PDF (&#123;CUFE&#125;_newton.pdf)</label>
                                    </div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Tope de documentos (0 = todos)</label><input class="xd-input" type="number" @bind="_nwMax" /></div>
                                        <label class="xd-check"><input type="checkbox" @bind="_nwSoloNuevos" /> Solo nuevos (no re-baja PDF si ya existe)</label>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_nwMarcarPlataforma" /> Marcar Plataforma (puebla la fuente NEWTON por CUFE; el "Cruzar" enciende la columna Plataforma)</label>
                                    <label class="xd-check"><input type="checkbox" @bind="_nwReflejarEventos" /> Reflejar eventos RADIAN (Ev.30/32/33/31/34) del listado de NEWTON sobre el renglon por CUFE (solo marca Si)</label>
                                    <label class="xd-check"><input type="checkbox" @bind="_nwSubirBlob" /> Subir los xml/pdf al blob por CUFE (para verlos desde el modulo de conciliacion)</label>
                                }
                                else if (_sKind == ScrapeStepKind.CerrarNavegador)
                                {
                                    <div class="xd-help">Cierra el navegador: el agente cierra la ventana viva (WebView2) que el flujo mantiene abierta para conservar el login y la saca de su cache. No navega ni inyecta y no lleva configuracion. Util como ULTIMO paso del flujo para no dejar la ventana abierta.</div>
                                }
                                else if (_sKind == ScrapeStepKind.CrearActividad)
                                {
                                    <div class="xd-help">Crea <b>una tarea</b> del concepto elegido por el registro que el flujo tiene en ese momento (p.ej. el pedido que acaba de leer el bucle) y deja el <b>formulario del concepto</b> diligenciado. Ponlo DENTRO del bucle, despues del paso que ingiere el registro. <b>No duplica</b>: anota el numero de la tarea en la columna indicada de la fila del contenedor y, si ya lo tiene, la omite. Valores: una ruta (<code>DETALLE.cabecera.petof</code>) o una plantilla (<code>Pedido &#123;&#123;DETALLE.cabecera.petof&#125;&#125;</code>).</div>
                                    <div class="xd-prop"><label>Concepto de la actividad (define tablero y formulario)</label>
                                        <select class="xd-input" @bind="_caSub" @bind:after="LoadCaFormFieldsAsync">
                                            <option value="">(elige un concepto)</option>
                                            @foreach (var c in _caConceptos) { <option value="@c.Id">@c.Codigo - @c.Nombre@(c.FormDefinitionId is null ? " (sin formulario)" : "")</option> }
                                        </select>
                                        @if (!string.IsNullOrEmpty(_caFormFields)) { <div class="xd-help">Campos del formulario: <code>@_caFormFields</code></div> }
                                    </div>
                                    <div class="xd-prop"><label>Titulo de la tarea (plantilla)</label><input class="xd-input mono" placeholder="Pedido INCAUCA {{DETALLE.cabecera.petof}}" @bind="_caTitulo" /></div>
                                    <div class="xd-prop"><label>Descripcion (plantilla, opcional)</label><textarea class="xd-input mono" rows="2" @bind="_caDesc"></textarea></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Clave del registro (ruta)</label><input class="xd-input mono" placeholder="DETALLE.cabecera.petof" @bind="_caClave" /></div>
                                        <div class="xd-prop"><label>Responsable (opcional)</label>
                                            <select class="xd-input" @bind="_caResp">
                                                <option value="">(sin asignar)</option>
                                                @foreach (var u in _caUsuarios) { <option value="@u.Id">@(u.DisplayName ?? u.Email)</option> }
                                            </select></div>
                                    </div>
                                    <div class="xd-prop"><label>Contenedor del registro (anti-duplicado)</label>
                                        <select class="xd-input" @bind="_caCont">
                                            <option value="">(ninguno: anti-duplicado por titulo)</option>
                                            @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                        </select></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Columna con la clave</label><input class="xd-input mono" placeholder="PETOF" @bind="_caColClave" /></div>
                                        <div class="xd-prop"><label>Columna donde anotar la tarea</label><input class="xd-input mono" placeholder="TAREA" @bind="_caColTarea" /></div>
                                    </div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Solicitante (plantilla, opcional)</label><input class="xd-input mono" placeholder="{{DETALLE.cabecera.contactoIngenio}}" @bind="_caSolic" /></div>
                                        <div class="xd-prop"><label>Documento solicitante (opcional)</label><input class="xd-input mono" @bind="_caDoc" /></div>
                                    </div>
                                    <div class="xd-prop"><label>Campos del formulario: codigo -&gt; ruta (JSON)</label>
                                        <textarea class="xd-input xd-code-input" rows="4" placeholder='{"petof":"DETALLE.cabecera.petof","solicitud":"DETALLE.cabecera.solicitud"}' @bind="_caCampos"></textarea></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Campo grilla (GridDetail)</label><input class="xd-input mono" placeholder="items" @bind="_caGrilla" /></div>
                                        <div class="xd-prop"><label>Ruta de los items (arreglo)</label><input class="xd-input mono" placeholder="DETALLE.items" @bind="_caItems" /></div>
                                    </div>
                                    <div class="xd-prop"><label>Columnas de la grilla: id de columna -&gt; propiedad del item (JSON)</label>
                                        <textarea class="xd-input xd-code-input" rows="3" placeholder='{"codigo":"codigo","material":"material","cnt_sol":"cntSol"}' @bind="_caCols"></textarea></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>No crear si la ruta... (opcional)</label><input class="xd-input mono" placeholder="DETALLE.cabecera.estado" @bind="_caSaltarRuta" /></div>
                                        <div class="xd-prop"><label>...vale</label><input class="xd-input" placeholder="Concluida" @bind="_caSaltarValor" /></div>
                                    </div>
                                    <div class="xd-prop"><label>Vencimiento de la tarea (ruta o plantilla de fecha, opcional)</label><input class="xd-input mono" placeholder="DETALLE.cabecera.plazoOferta" @bind="_caVence" /></div>
                                    <div class="xd-prop"><label>Valores fijos: codigo -&gt; valor (JSON, acepta {hoy+N}; no pisa lo leido)</label>
                                        <textarea class="xd-input xd-code-input" rows="3" placeholder='{"moneda":"PESO COLOMBIANO","vigencia_precios":"{hoy+30}"}' @bind="_caFijos"></textarea></div>
                                    <div class="xd-prop"><label>Prellenar la grilla con la ultima respuesta del mismo codigo (JSON, opcional)</label>
                                        <textarea class="xd-input xd-code-input" rows="5" placeholder='{"contenedorId":"...","claveGrilla":"codigo","columnaClave":"CODIGO","ordenColumna":"PETOF","excluirColumna":"PETOF","requiereColumna":"VLR_UNI","columnas":{"marca":"MARCA","vlr_uni":"VLR_UNI"}}' @bind="_caPrellenado"></textarea></div>
                                }
                                else if (_sKind == ScrapeStepKind.Notificar)
                                {
                                    <div class="xd-help">Avisa que la tarea del registro esta creada. Ponlo DESPUES de "Crear actividad" (ese paso deja <code>&#123;&#123;TAREA&#125;&#125;</code> y <code>&#123;&#123;TAREA_NUEVA&#125;&#125;</code>). El mensaje admite los tokens de la tarea: <code>{tarea.numero}</code>, <code>{tarea.titulo}</code>, <code>{tarea.cliente}</code>, <code>{usuario.nombre}</code>, <code>{form.petof}</code>, <code>{tarea.enlace}</code>, y rutas del dron como <code>&#123;&#123;DETALLE.cabecera.solicitud&#125;&#125;</code>. Un fallo de envio no detiene el dron: queda en la bitacora de la tarea.</div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Canal</label>
                                            <select class="xd-input" @bind="_ntCanal" @bind:after="LoadNtListsAsync">
                                                <option value="@ScrapeNotificar.Canal.Campana">Campana (notificacion en la app)</option>
                                                <option value="@ScrapeNotificar.Canal.Correo">Correo</option>
                                                <option value="@ScrapeNotificar.Canal.WhatsApp">WhatsApp (plantilla aprobada)</option>
                                                <option value="@ScrapeNotificar.Canal.WhatsAppGrupo">Grupo de WhatsApp</option>
                                                <option value="@ScrapeNotificar.Canal.Telegram">Telegram</option>
                                            </select></div>
                                        <div class="xd-prop"><label>Tarea (ruta)</label><input class="xd-input mono" placeholder="TAREA" @bind="_ntTarea" /></div>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_ntSoloNueva" /> Solo si la tarea se creo en esta corrida (no repite el aviso al re-correr)</label>
                                    @if (_ntCanal is ScrapeNotificar.Canal.Campana or ScrapeNotificar.Canal.Correo or ScrapeNotificar.Canal.WhatsApp)
                                    {
                                        <div class="xd-prop"><label>A quien</label>
                                            <select class="xd-input" @bind="_ntDestino">
                                                <option value="@ScrapeNotificar.Destino.Responsable">Responsable de la tarea</option>
                                                <option value="@ScrapeNotificar.Destino.Usuarios">Usuarios elegidos</option>
                                                <option value="@ScrapeNotificar.Destino.Concepto">Destinatarios del concepto</option>
                                                @if (_ntCanal == ScrapeNotificar.Canal.WhatsApp)
                                                {
                                                    <option value="@ScrapeNotificar.Destino.Numeros">Solo numeros de WhatsApp</option>
                                                }
                                            </select></div>
                                        @if (_ntDestino == ScrapeNotificar.Destino.Usuarios)
                                        {
                                            <div class="xd-prop" style="max-height:160px;overflow:auto">
                                                @foreach (var u in _caUsuarios)
                                                {
                                                    <label class="xd-check"><input type="checkbox" checked="@_ntUsuarios.Contains(u.Id)" @onchange="e => ToggleNtUsuario(u.Id, e.Value is true)" /> @(u.DisplayName ?? u.Email)</label>
                                                }
                                            </div>
                                        }
                                    }
                                    @if (_ntCanal == ScrapeNotificar.Canal.WhatsApp)
                                    {
                                        <div class="xd-prop"><label>@(_ntDestino == ScrapeNotificar.Destino.Numeros ? "Numeros de WhatsApp" : "Numeros adicionales (opcional)")</label>
                                            <textarea class="xd-input mono" rows="3" placeholder="573001234567&#10;3109876543" @bind="_ntTelefonos"></textarea>
                                            <small class="muted-cell">Uno por linea (o separados por coma). 10 digitos que empiezan por 3 se toman como celular de Colombia (+57). Se suman a los destinatarios elegidos, sin repetir.</small></div>
                                    }
                                    @if (_ntCanal is ScrapeNotificar.Canal.WhatsApp or ScrapeNotificar.Canal.WhatsAppGrupo)
                                    {
                                        <div class="xd-prop"><label>Linea de WhatsApp</label>
                                            <select class="xd-input" @bind="_ntLinea">
                                                <option value="">(elige la linea)</option>
                                                @foreach (var l in _ntLineas) { <option value="@l.Id">@l.InstanceName @(string.IsNullOrWhiteSpace(l.PhoneNumber) ? "" : "(" + l.PhoneNumber + ")")</option> }
                                            </select></div>
                                    }
                                    @if (_ntCanal == ScrapeNotificar.Canal.WhatsApp)
                                    {
                                        <div class="xd-prop"><label>Plantilla aprobada</label>
                                            <select class="xd-input" @bind="_ntPlantillaSel">
                                                <option value="">(elige la plantilla)</option>
                                                @foreach (var t in NtPlantillasDeLinea()) { <option value="@(t.Name + "|" + t.Language)">@t.Name (@t.Language) - @t.Status</option> }
                                            </select>
                                            @if (NtPlantillaActual() is { } tp)
                                            {
                                                <div class="xd-help">Texto: @tp.BodyText<br />Variables: <code>@string.Join(", ", tp.Variables.Select(v => v.Token))</code></div>
                                            }
                                        </div>
                                        <div class="xd-prop"><label>Variables de la plantilla: variable -&gt; valor con tokens (JSON)</label>
                                            <textarea class="xd-input xd-code-input" rows="3" placeholder='{"numero":"{tarea.numero}","titulo":"{tarea.titulo}","enlace":"{tarea.enlace}"}' @bind="_ntVars"></textarea>
                                            <div class="xd-help">Si la variable se llama igual que un token (numero, titulo, cliente, enlace...) se llena sola; aqui solo van las que difieren.</div></div>
                                    }
                                    @if (_ntCanal == ScrapeNotificar.Canal.WhatsAppGrupo)
                                    {
                                        <div class="xd-prop"><label>Grupo (JID ...@@g.us)</label><input class="xd-input mono" placeholder="120363000000000000@@g.us" @bind="_ntGrupo" /></div>
                                    }
                                    @if (_ntCanal == ScrapeNotificar.Canal.Telegram)
                                    {
                                        <div class="xd-prop"><label>Chat de Telegram (id)</label><input class="xd-input mono" placeholder="-1001234567890" @bind="_ntChat" /></div>
                                    }
                                    @if (_ntCanal != ScrapeNotificar.Canal.WhatsApp)
                                    {
                                        @if (_ntCanal is ScrapeNotificar.Canal.Campana or ScrapeNotificar.Canal.Correo)
                                        {
                                            <div class="xd-prop"><label>@(_ntCanal == ScrapeNotificar.Canal.Correo ? "Asunto" : "Titulo") (plantilla)</label><input class="xd-input mono" placeholder="@ScrapeNotificar.DefaultAsunto" @bind="_ntAsunto" /></div>
                                        }
                                        <div class="xd-prop"><label>Mensaje (plantilla)</label><textarea class="xd-input mono" rows="3" placeholder="@ScrapeNotificar.DefaultMensaje" @bind="_ntMensaje"></textarea></div>
                                        <label class="xd-check"><input type="checkbox" @bind="_ntEnlace" /> Agregar el enlace directo a la tarea</label>
                                    }
                                }

                                @if (_sKind != ScrapeStepKind.LeerCorreoOtp && _sKind != ScrapeStepKind.IngestaNewton && _sKind != ScrapeStepKind.CerrarNavegador && _sKind != ScrapeStepKind.CrearActividad && _sKind != ScrapeStepKind.Notificar)
                                {
                                    <div class="xd-prop">
                                        <label>Guardar salida como (motor: variable del flujo)</label>
                                        <input class="xd-input mono" placeholder="LISTADO" @bind="_sOutputVar" />
                                        <div class="xd-help">Opcional. Si lo pones, lo que devuelve este paso queda disponible para los
                                            siguientes como <code>&#123;&#123;NOMBRE.ruta&#125;&#125;</code> o <code>@("@@")NOMBRE.ruta@("@@")</code>
                                            (ej. <code>&#123;&#123;LISTADO.compras[0].btnDiligenciarId&#125;&#125;</code>).</div>
                                    </div>

                                    @* ---- Bucle (ForEach) + ingesta: motor del dron, Ola 2 ---- *@
                                    <div class="xd-prop">
                                        <label>Recorrer (ForEach) la variable (inicia bucle)</label>
                                        <input class="xd-input mono" placeholder="LISTADO.compras" @bind="_sLoopOverVar" />
                                        <div class="xd-help">Si lo pones, "Ejecutar bucle" recorre ese array; en cada vuelta la fila actual
                                            queda como <code>&#123;&#123;ROW.campo&#125;&#125;</code> / <code>@("@@")ROW.campo@("@@")</code>. El cuerpo va de este paso al marcado "fin del bucle".
                                            Para probar con pocas filas crea la variable del flujo <code>TopeFilasBucle</code> (ej. 2): el bucle se detiene al llegar a ese numero.</div>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_sIsLoopEnd" /> Este paso es el FIN del cuerpo del bucle</label>
                                    <div class="xd-prop">
                                        <label>Paginacion: ruta al total de paginas (en el paso que inicia el bucle)</label>
                                        <input class="xd-input mono" placeholder="LISTADO.totalPaginas" @bind="_sPageCountVar" />
                                        <div class="xd-help">Si lo pones, tras consumir las filas de una pagina el motor avanza a la siguiente
                                            (corriendo los pasos marcados abajo) hasta ese total. La pagina actual queda como <code>@("@@")PAG@("@@")</code>.</div>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_sIsPageNext" /> Este paso AVANZA de pagina / recarga el listado (se corre entre paginas)</label>
                                    <div class="xd-prop">
                                        <label>Ingerir al Contenedor la ruta (opcional)</label>
                                        <input class="xd-input mono" placeholder="DETALLE.cabecera" @bind="_sIngestPath" />
                                        <div class="xd-help">Tras el paso, ingiere lo que haya en esa ruta (objeto = 1 fila; array = varias) a la
                                            tabla destino de abajo (o la del flujo). Usa el mapeo campo-&gt;columna.</div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_sIngestPath))
                                    {
                                        <div class="xd-prop"><label>Tabla destino de la ingesta</label>
                                            <select class="xd-input" @bind="_sTargetContainer">
                                                <option value="">(la del flujo)</option>
                                                @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                            </select></div>
                                        <div class="xd-prop"><label>Mapeo campo -&gt; columna (JSON, opcional)</label>
                                            <textarea class="xd-input xd-code-input" rows="3" placeholder='{"petof":"PETICION","solicitud":"SOLICITUD"}' @bind="_sMappingJson"></textarea></div>
                                        <div class="xd-prop"><label>Clave de idempotencia (columna, opcional)</label>
                                            <input class="xd-input mono" placeholder="PETOF" @bind="_sIngestKeyColumn" />
                                            <div class="xd-help">Si la pones, la ingesta hace <b>Upsert</b> por esa columna destino (debe estar mapeada):
                                                re-correr el flujo NO duplica (inserta si no existe, actualiza si coincide). Para 1 fila por entidad
                                                usa su id (p.ej. <code>PETOF</code>); para varias filas por entidad usa una clave por fila
                                                (p.ej. una columna <code>CLAVE</code>). Vacio = Append (agrega siempre).</div>
                                        </div>
                                    }

                                    @* ---- ENSAMBLADO -> Regla: motor del dron, Ola 4 ---- *@
                                    @if (_sKind == ScrapeStepKind.Ensamblado)
                                    {
                                        <div class="xd-prop">
                                            <label>Regla a invocar (ENSAMBLADO)</label>
                                            @if (_rules.Count == 0)
                                            {
                                                <div class="xd-hint">No hay reglas en este tenant. Crea una en el modulo Reglas.</div>
                                            }
                                            else
                                            {
                                                <select class="xd-input" @bind="_sRuleId">
                                                    <option value="">(ninguna)</option>
                                                    @foreach (var r in _rules) { <option value="@r.Id">@r.Label</option> }
                                                </select>
                                            }
                                        </div>
                                        <div class="xd-prop">
                                            <label>Entrada de la regla (ruta del contexto, objeto)</label>
                                            <input class="xd-input mono" placeholder="DETALLE.cabecera" @bind="_sRuleInputVar" />
                                            <div class="xd-help">El JSON de esa ruta se aplana y se entrega a la regla como datos (FormData). Vacio = <code>DETALLE</code>.</div>
                                        </div>
                                    }
                                }

                                @if (_sKind == ScrapeStepKind.ProcesarArchivos)
                                {
                                    <div class="xd-prop"><label>Carpeta de descargas (opcional; vacio = variable RutaDescargaBot)</label>
                                        <input class="xd-input mono" placeholder="C:\descargas\dian" @bind="_paCarpeta" /></div>
                                    <div class="xd-prop"><label class="xd-check"><input type="checkbox" @bind="_paAutoImportar" /> Auto-importar a la conciliacion del mes</label></div>
                                    <div class="xd-prop"><label class="xd-check"><input type="checkbox" @bind="_paSubirBlob" /> Subir PDF/XML al gestor (blob) por CUFE</label></div>
                                    <div class="xd-prop"><label class="xd-check"><input type="checkbox" @bind="_paMoverProcesados" /> Limpiar los procesados tras confirmar</label></div>
                                    <div class="xd-prop"><label class="xd-check"><input type="checkbox" @bind="_paForzarViaAgente" /> Forzar lectura via agente (sub-agente Archivos)</label>
                                        <div class="xd-help">Normalmente automatico: si el servidor NO ve la carpeta (prod Linux + agente Windows) lee los ZIP a traves del agente. Marca esto para PROBAR en dev con una sola maquina (app y agente en la misma PC). Requiere capacidad <code>Archivos</code> habilitada en la colmena y la carpeta en la allow-list (con prefijo <code>rw:</code> para poder limpiar).</div></div>
                                }

                                @if (_sKind != ScrapeStepKind.Ai && _sKind != ScrapeStepKind.LeerCorreoOtp && _sKind != ScrapeStepKind.IngestaNewton && _sKind != ScrapeStepKind.CerrarNavegador && _sKind != ScrapeStepKind.CrearActividad && _sKind != ScrapeStepKind.Notificar)
                                {
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Advertencia: etiqueta a vigilar (opcional)</label>
                                            <input class="xd-input" placeholder="captcha" @bind="_sWarnLabel" /></div>
                                        <div class="xd-prop"><label>Si aparece</label>
                                            <select class="xd-input" @bind="_sWarnAction">
                                                <option value="@ScrapeWarningAction.None">Nada</option>
                                                <option value="@ScrapeWarningAction.Notify">Notificar (seguir)</option>
                                                <option value="@ScrapeWarningAction.Stop">Detener la corrida</option>
                                            </select></div>
                                    </div>
                                }

                                @if (_stepError is not null) { <div class="xd-error-box">@_stepError</div> }
                                <div class="xd-props-actions">
                                    <button class="xd-btn primary" @onclick="SaveStepAsync" disabled="@_busy">Guardar paso</button>
                                    <button class="xd-btn" @onclick="() => _showStepEditor = false">Cancelar</button>
                                </div>
                                </div>
                              </div>
                            </div>
                        }
                    </div>

                    @* ===== Cliente y variables ===== *@
                    <div class="xd-card">
                        <div class="xd-card-head"><div class="xd-card-title">Cliente y variables</div></div>
                        <div class="xd-props-body">
                            <div class="xd-prop">
                                <label>Agente (bot asignado)</label>
                                <select class="xd-input" @bind="_hClient" @bind:after="OnAgentChanged">
                                    <option value="">(sin agente)</option>
                                    @foreach (var c in _clients) { <option value="@c.Id">@c.Name</option> }
                                </select>
                                <div class="xd-agent-actions">
                                    <button class="xd-btn sm" @onclick="TestConnectionAsync" disabled="@(_busy || string.IsNullOrEmpty(_hClient))">Test de conexion</button>
                                    @* El alta/rotacion de agentes vive en su modulo propio (ADR-0045). Aqui solo se ELIGE. *@
                                    <a class="xd-btn sm" href="/agentes-colmena" target="_blank">Gestionar agentes</a>
                                </div>
                                @if (_probe is { } pr)
                                {
                                    <div class="xd-probe @(pr.Online ? "ok" : "off")">@pr.Text</div>
                                }
                            </div>
                            <div class="xd-prop">
                                <label>Tabla destino</label>
                                <select class="xd-input" @bind="_hContainer" @bind:after="SaveAssignmentsAsync">
                                    <option value="">(sin tabla)</option>
                                    @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                </select>
                            </div>

                            <div class="xd-prop">
                                <label>Variables (se usan como {{Nombre}} en los scripts)</label>
                                <div class="xd-var-list">
                                    @foreach (var v in flow.Variables)
                                    {
                                        <div class="xd-var-row">
                                            <span class="xd-var-name">@v.Name</span>
                                            @if (!v.IsSecret)
                                            {
                                                @* No secreta: el valor esta en texto plano, se muestra tal cual (modulo tecnico). *@
                                                <span class="xd-var-value mono @(string.IsNullOrEmpty(v.Value) ? "empty" : "")">@(string.IsNullOrEmpty(v.Value) ? "(vacia)" : v.Value)</span>
                                            }
                                            else if (_revealed.TryGetValue(v.Id, out var rv))
                                            {
                                                @if (rv.Ok)
                                                { <span class="xd-var-value mono">@(string.IsNullOrEmpty(rv.Value) ? "(vacia)" : rv.Value)</span> }
                                                else
                                                { <span class="xd-var-value err" title="@rv.Error">no se pudo descifrar</span> }
                                                <button class="xd-icon-btn" title="Ocultar" @onclick="() => HideSecret(v.Id)">&#128584;</button>
                                            }
                                            else
                                            {
                                                <span class="xd-var-value">********</span>
                                                <button class="xd-icon-btn" title="Ver valor" disabled="@_busy" @onclick="() => RevealSecretAsync(v.Id)">&#128065;</button>
                                            }
                                            @if (v.IsSecret) { <span class="xd-lock" title="Secreta (cifrada)">&#128274;</span> }
                                            @if (v.AskOnRun) { <span class="xd-lock" title="@("Se pide al ejecutar desde un modulo" + (string.IsNullOrEmpty(v.Prompt) ? "" : ": " + v.Prompt))">&#10067;</span> }
                                            <button class="xd-icon-btn" title="Editar" @onclick="() => OpenVarEditorFor(v)">&#9998;</button>
                                            <button class="xd-icon-btn" title="Eliminar" @onclick="() => DeleteVariableAsync(v.Id)">&times;</button>
                                        </div>
                                    }
                                    @if (!_showVarEditor)
                                    {
                                        <div class="xd-var-add" @onclick="OpenVarEditor">+ Nueva variable</div>
                                    }
                                </div>
                            </div>

                            @if (_showVarEditor)
                            {
                                <div class="xd-modal-backdrop" @onclick="() => _showVarEditor = false">
                                  <div class="xd-modal" @onclick:stopPropagation="true">
                                    <div class="xd-modal-head">
                                        <div class="xd-card-title" style="font-size:14px;">@(_vEditId is null ? "Nueva variable" : "Editar variable")</div>
                                        <button class="xd-icon-btn" title="Cerrar" @onclick="() => _showVarEditor = false">&times;</button>
                                    </div>
                                    <div class="xd-modal-body">
                                        <div class="xd-prop"><label>Nombre</label><input class="xd-input" placeholder="USER" autocomplete="off" @bind="_vName" /></div>
                                        <div class="xd-prop">
                                            <label>Valor</label>
                                            <input class="xd-input" type="@(_vSecret ? "password" : "text")" placeholder="@(_vEditId is null ? "" : "Dejar vacio para conservar el valor actual")" autocomplete="new-password" @bind="_vValue" />
                                        </div>
                                        <label class="xd-check"><input type="checkbox" @bind="_vSecret" /> Secreta (se cifra; el valor se consulta con el boton Ver)</label>
                                        @if (!_vSecret)
                                        {
                                            <label class="xd-check"><input type="checkbox" @bind="_vAsk" /> Pedir al ejecutar (al disparar el flujo desde un modulo, p.ej. "Importar del bot", se pregunta mostrando este valor por defecto; lo que se escriba vale solo para esa corrida)</label>
                                            @if (_vAsk)
                                            {
                                                <div class="xd-prop"><label>Pregunta</label><input class="xd-input" placeholder="Ej.: Empezar desde cuantos dias atras" autocomplete="off" maxlength="200" @bind="_vPrompt" /></div>
                                            }
                                        }
                                        @if (_vEditId is not null)
                                        {
                                            <div style="font-size:11.5px;color:var(--ink-3);margin:2px 0 0;">Si cambias el tipo (secreta/no), reingresa el valor.</div>
                                        }
                                        @if (_varError is not null) { <div class="xd-error-box">@_varError</div> }
                                        <div class="xd-props-actions">
                                            <button class="xd-btn primary" @onclick="SaveVariableAsync" disabled="@_busy">Guardar</button>
                                            <button class="xd-btn" @onclick="() => _showVarEditor = false">Cancelar</button>
                                        </div>
                                    </div>
                                  </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
                }

                @if (_tab == TabProg)
                {
                @* ===== Programacion (Ola 5: reusa ImportProcess/recurrencia) ===== *@
                <div class="xd-card">
                    <div class="xd-card-head">
                        <div class="xd-card-title">Programacion</div>
                        @if (_seqStatus is { Finished: false } sst)
                        {
                            <span class="xd-pill run"><span class="d"></span>Secuencia: tramo @sst.Current/@sst.Total</span>
                        }
                        else if (_schedules.Where(s => s.IsActive && s.NextRunAt is not null).OrderBy(s => s.NextRunAt).FirstOrDefault() is { } prox)
                        {
                            <span class="xd-pill ok"><span class="d"></span>Proxima: @prox.NextRunAt!.Value.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        }
                        else
                        {
                            <span class="xd-pill wait"><span class="d"></span>@(_schedules.Count == 0 ? "Sin programar" : "Manual/inactiva")</span>
                        }
                    </div>
                    <div class="xd-props-body">
                        @* --- Secuencia de tramos en curso / ultima (ADR-0171) --- *@
                        @if (_seqStatus is { } sq)
                        {
                            <div class="xd-seq-box">
                                <div class="xd-seq-head">
                                    <b>@sq.Name</b>
                                    <span class="xd-seq-est">@(sq.Finished ? "Terminada" : sq.Estado)</span>
                                </div>
                                @if (!sq.Finished && sq.NextActionAt is DateTimeOffset na)
                                {
                                    <div class="xd-seq-sub">Siguiente accion: @na.ToLocalTime().ToString("HH:mm")</div>
                                }
                                <div class="xd-seq-tramos">
                                    @foreach (var d in sq.Done)
                                    {
                                        <span class="xd-seq-chip @(d.Ok ? "ok" : "bad")" title="@(d.Error ?? "ok") (@d.Intentos intento/s)">
                                            @(d.Largo == 1 ? $"{d.Desde}" : $"{d.Desde}-{d.Desde + d.Largo - 1}")
                                        </span>
                                    }
                                    @for (var i = sq.Done.Count; i < sq.Total; i++)
                                    {
                                        <span class="xd-seq-chip @(i == sq.Done.Count && !sq.Finished ? "run" : "")">@(i + 1)</span>
                                    }
                                </div>
                                @if (sq.Summary is { } sum) { <div class="xd-seq-sub">@sum</div> }
                                <div class="xd-props-actions">
                                    <button class="xd-btn" @onclick="RefreshSeqStatus">Actualizar</button>
                                    @if (!sq.Finished)
                                    {
                                        <button class="xd-btn danger" @onclick="StopSequence">Detener secuencia</button>
                                    }
                                </div>
                            </div>
                        }

                        @* --- Biblioteca de tareas programadas del flujo (estilo Programador de tareas de Windows, ADR-0171) --- *@
                        <div class="xd-lib-bar">
                            <button class="xd-btn primary sm" @onclick="() => NewScheduleAsync(SchPreset.EnBlanco)">+ Crear tarea</button>
                            <span class="xd-lib-tpl">Plantillas:</span>
                            <button class="xd-btn sm" title="Todos los dias a las 6:00, revisa los ultimos 6 dias de a 3" @onclick="() => NewScheduleAsync(SchPreset.Diaria)">Diaria</button>
                            <button class="xd-btn sm" title="Domingos a la 1:00, revisa los ultimos 60 dias de a 3" @onclick="() => NewScheduleAsync(SchPreset.Semanal)">Barrido semanal</button>
                        </div>
                        @if (_schedules.Count == 0)
                        {
                            <div class="xd-card-empty">Sin tareas programadas. El flujo solo corre con "Ejecutar ahora".</div>
                        }
                        @foreach (var s in _schedules)
                        {
                            var corriendo = _seqStatus is { Finished: false } css && css.ScheduleId == s.Id;
                            <div class="xd-sch-row">
                                <div class="xd-sch-main">
                                    <div class="xd-sch-name">@s.Name
                                        @if (corriendo) { <span class="xd-pill run"><span class="d"></span>En ejecucion</span> }
                                        else if (!s.IsActive) { <span class="xd-pill wait"><span class="d"></span>Deshabilitada</span> }
                                        else { <span class="xd-pill ok"><span class="d"></span>Lista</span> }
                                    </div>
                                    <div class="xd-sch-meta"><b>Cuando:</b> @TriggerLabel(s)</div>
                                    <div class="xd-sch-meta"><b>Que hace:</b> @(s.Sequence is { } sp ? SeqHuman(sp) : "Una corrida con los valores guardados del flujo.")</div>
                                    <div class="xd-sch-meta">
                                        Proxima: @(s.IsActive && s.NextRunAt is DateTimeOffset snr ? Fmt(snr) : "-")
                                        &middot; Ultima: @(s.LastRunAt is DateTimeOffset slr ? Fmt(slr) : "nunca")
                                    </div>
                                    @if (s.DisabledReason is { } sdr) { <div class="xd-sch-meta">@sdr</div> }
                                </div>
                                <div class="xd-sch-acts">
                                    <button class="xd-btn sm" title="Ejecutar ahora" @onclick="() => RunScheduleNowAsync(s)" disabled="@(_busy || (_seqStatus is { Finished: false }))">Ejecutar</button>
                                    <button class="xd-btn sm" @onclick="() => EditScheduleAsync(s)">Propiedades</button>
                                    <button class="xd-btn sm" @onclick="() => ToggleScheduleAsync(s)" disabled="@_busy">@(s.IsActive ? "Deshabilitar" : "Habilitar")</button>
                                    <button class="xd-btn sm danger" @onclick="() => DeleteScheduleAsync(s)" disabled="@_busy">Eliminar</button>
                                </div>
                            </div>
                        }

                        @* --- Asistente "Crear tarea" (pasos como el Programador de tareas de Windows) --- *@
                        @if (_wz)
                        {
                            <div class="xd-modal-backdrop">
                              <div class="xd-modal xd-wz" @onclick:stopPropagation="true">
                                <div class="xd-modal-head">
                                    <b>@(_wzId is null ? "Crear tarea programada" : "Propiedades de la tarea")</b>
                                    <button class="xd-btn sm" @onclick="CloseWizard">Cerrar</button>
                                </div>
                                <div class="xd-wz-wrap">
                                    <nav class="xd-wz-steps">
                                        @for (var i = 0; i < WzSteps.Length; i++)
                                        {
                                            var wzi = i;
                                            <button type="button" class="xd-wz-step @(wzi == _wzStep ? "on" : "") @(wzi < _wzStep ? "done" : "")"
                                                    @onclick="() => GoStepAsync(wzi)"><span class="n">@(wzi + 1)</span><span class="t">@WzSteps[wzi]</span></button>
                                        }
                                    </nav>
                                    <div class="xd-wz-body">
                                        @if (_wzStep == 0)
                                        {
                                            <div class="xd-wz-title">General</div>
                                            <div class="xd-wz-help">Ponle un nombre para reconocerla en la lista.</div>
                                            <div class="xd-prop"><label>Nombre</label>
                                                <input class="xd-input" placeholder="Diaria, Barrido semanal..." @bind="_schName" /></div>
                                            <div class="xd-prop"><label>Flujo que ejecuta</label>
                                                <div class="xd-wz-ro">@_selected?.Name</div></div>
                                            <label class="xd-check"><input type="checkbox" @bind="_schActive" /> Habilitada (corre sola en su horario)</label>
                                        }
                                        else if (_wzStep == 1)
                                        {
                                            <div class="xd-wz-title">Desencadenador</div>
                                            <div class="xd-wz-help">Cuando desea que se inicie la tarea?</div>
                                            <div class="xd-wz-radios">
                                                @foreach (var o in TgOptions)
                                                {
                                                    var on = TgOn(o.Key);
                                                    <label class="xd-wz-radio @(on ? "on" : "")">
                                                        <input type="radio" name="xd-tg" checked="@on" @onchange="() => SetTg(o.Key)" />
                                                        <span><b>@o.Label</b><small>@o.Hint</small></span>
                                                    </label>
                                                }
                                            </div>
                                            @if (_tgLegacy is not null)
                                            {
                                                <div class="xd-wz-warn">Antes tenia un horario avanzado (@_tgLegacy). Al guardar se reemplaza por el que elijas aqui.</div>
                                            }
                                            @if (!_tgManual)
                                            {
                                                <div class="xd-wz-sec">
                                                    <div class="xd-sch-inline">
                                                        <label>@(_tgTipo == TriggerTipo.UnaVez ? "El dia" : "Iniciar el") <input class="xd-input xd-date" type="date" @bind="_tgFecha" /></label>
                                                        <label>a las <input class="xd-input xd-time" type="time" @bind="_tgHora" /></label>
                                                    </div>
                                                    @if (_tgTipo == TriggerTipo.Diaria)
                                                    {
                                                        <div class="xd-sch-inline"><label>Repetir cada <input class="xd-input xd-num" type="number" min="1" max="365" @bind="_tgCada" /> dia(s)</label></div>
                                                    }
                                                    else if (_tgTipo == TriggerTipo.Semanal)
                                                    {
                                                        <div class="xd-sch-inline"><label>Repetir cada <input class="xd-input xd-num" type="number" min="1" max="52" @bind="_tgCada" /> semana(s) el:</label></div>
                                                        <div class="xd-day-chips">
                                                            @foreach (var chip in DayChips)
                                                            {
                                                                <button type="button" class="xd-day-chip @(_tgDias.Contains(chip.Day) ? "on" : "")" @onclick="() => Toggle(_tgDias, chip.Day)">@chip.Label</button>
                                                            }
                                                        </div>
                                                    }
                                                    else if (_tgTipo == TriggerTipo.Mensual)
                                                    {
                                                        <div class="xd-wz-lbl">Meses <button type="button" class="xd-linkbtn" @onclick="() => _tgMeses.Clear()">todos</button></div>
                                                        <div class="xd-day-chips">
                                                            @for (var m = 1; m <= 12; m++)
                                                            {
                                                                var mm = m;
                                                                <button type="button" class="xd-day-chip @(_tgMeses.Count == 0 || _tgMeses.Contains(mm) ? "on" : "")" @onclick="() => ToggleMes(mm)">@MonthChips[mm - 1]</button>
                                                            }
                                                        </div>
                                                        <label class="xd-check xd-wz-mt"><input type="radio" name="xd-tgm" checked="@_tgPorDia" @onchange="() => _tgPorDia = true" /> Dias del mes:</label>
                                                        @if (_tgPorDia)
                                                        {
                                                            <div class="xd-wz-dom">
                                                                @for (var d = 1; d <= 31; d++)
                                                                {
                                                                    var dd = d;
                                                                    <button type="button" class="xd-day-chip @(_tgDiasMes.Contains(dd) ? "on" : "")" @onclick="() => Toggle(_tgDiasMes, dd)">@dd</button>
                                                                }
                                                                <button type="button" class="xd-day-chip wide @(_tgDiasMes.Contains(ScheduleTrigger.UltimoDia) ? "on" : "")" @onclick="() => Toggle(_tgDiasMes, ScheduleTrigger.UltimoDia)">Ultimo</button>
                                                            </div>
                                                        }
                                                        <label class="xd-check xd-wz-mt"><input type="radio" name="xd-tgm" checked="@(!_tgPorDia)" @onchange="() => _tgPorDia = false" /> El</label>
                                                        @if (!_tgPorDia)
                                                        {
                                                            <div class="xd-sch-inline">
                                                                <select class="xd-input xd-unit" @bind="_tgOrdinal">
                                                                    @for (var k = 1; k <= 5; k++) { <option value="@k">@OrdinalOpts[k]</option> }
                                                                </select>
                                                                <select class="xd-input xd-unit" @bind="_tgDiaSemana">
                                                                    @foreach (var chip in DayChips) { <option value="@chip.Day">@DayNamesEs[chip.Day]</option> }
                                                                </select>
                                                                <span>del mes</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                                <details class="xd-sch-adv" open="@(_tgRepetir || _tgCaduca)">
                                                    <summary>Configuracion avanzada</summary>
                                                    <div class="xd-sch-inline">
                                                        <label class="xd-check"><input type="checkbox" @bind="_tgRepetir" /> Repetir la tarea cada</label>
                                                        <select class="xd-input xd-unit" @bind="_tgRepCada" disabled="@(!_tgRepetir)">
                                                            @foreach (var r in RepCadaOpts) { <option value="@r.Min">@r.Label</option> }
                                                        </select>
                                                        <span>durante</span>
                                                        <select class="xd-input xd-unit" @bind="_tgRepDurante" disabled="@(!_tgRepetir)">
                                                            @foreach (var r in RepDuranteOpts) { <option value="@r.Min">@r.Label</option> }
                                                        </select>
                                                    </div>
                                                    <div class="xd-sch-inline">
                                                        <label class="xd-check"><input type="checkbox" @bind="_tgCaduca" /> Caduca el</label>
                                                        <input class="xd-input xd-date" type="date" @bind="_tgCadFecha" disabled="@(!_tgCaduca)" />
                                                        <input class="xd-input xd-time" type="time" @bind="_tgCadHora" disabled="@(!_tgCaduca)" />
                                                    </div>
                                                </details>
                                            }
                                            <div class="xd-sch-sum">@TriggerPreviewText()</div>
                                        }
                                        else if (_wzStep == 2)
                                        {
                                            <div class="xd-wz-title">Accion</div>
                                            <div class="xd-wz-help">Que debe hacer la tarea?</div>
                                            <div class="xd-wz-radios">
                                                <label class="xd-wz-radio @(!_seqOn ? "on" : "")">
                                                    <input type="radio" name="xd-act" checked="@(!_seqOn)" @onchange="() => _seqOn = false" />
                                                    <span><b>Ejecutar el flujo una vez</b><small>Una corrida con los valores guardados del flujo.</small></span>
                                                </label>
                                                <label class="xd-wz-radio @(_seqOn ? "on" : "")">
                                                    <input type="radio" name="xd-act" checked="@_seqOn" @onchange="() => _seqOn = true" />
                                                    <span><b>Barrer por tramos</b><small>Varias corridas seguidas, cada una revisa unos pocos dias (DIAN: ~3 dias por corrida).</small></span>
                                                </label>
                                            </div>
                                            @if (_seqOn)
                                            {
                                                <div class="xd-wz-sec">
                                                    <div class="xd-sch-inline">
                                                        <label>Revisar <input class="xd-input xd-num" type="number" min="1" @bind="_seqTotal" /> dias hacia atras,</label>
                                                        <label>empezando hace <input class="xd-input xd-num" type="number" min="0" @bind="_seqDesde" /> dias (0 = hoy),</label>
                                                        <label>en tramos de <input class="xd-input xd-num" type="number" min="1" @bind="_seqPaso" /> dias.</label>
                                                    </div>
                                                    @{ var pv = BuildSeqSpec(); var pvErr = pv.Validate(); }
                                                    @if (pvErr is not null) { <div class="xd-error-box">@pvErr</div> }
                                                    else
                                                    {
                                                        <div class="xd-wz-lbl">@pv.Tramos().Count corrida(s), en este orden (si corriera hoy):</div>
                                                        <div class="xd-seq-tramos">
                                                            @foreach (var c in TramoChips(pv)) { <span class="xd-seq-chip">@c</span> }
                                                        </div>
                                                    }
                                                </div>
                                                <details class="xd-sch-adv">
                                                    <summary>Variables del flujo que reciben los dias</summary>
                                                    <datalist id="xd-seq-vars">
                                                        @foreach (var v in _selected!.Variables.Where(v => !v.IsSecret)) { <option value="@v.Name"></option> }
                                                    </datalist>
                                                    <div class="xd-seq-grid">
                                                        <div class="xd-prop"><label>"Desde cuantos dias atras"</label>
                                                            <input class="xd-input mono" list="xd-seq-vars" @bind="_seqVarDesde" /></div>
                                                        <div class="xd-prop"><label>"Cuantos dias"</label>
                                                            <input class="xd-input mono" list="xd-seq-vars" @bind="_seqVarLargo" /></div>
                                                    </div>
                                                    <div class="xd-help">Cada corrida recibe sus dias en esas dos variables (solo para esa corrida; no se guardan).</div>
                                                </details>
                                            }
                                        }
                                        else if (_wzStep == 3)
                                        {
                                            <div class="xd-wz-title">Configuracion</div>
                                            <div class="xd-wz-help">Que hacer si algo sale mal.</div>
                                            @if (_seqOn)
                                            {
                                                <div class="xd-wz-sec">
                                                    <div class="xd-sch-inline">
                                                        <label>Si un tramo falla, reintentar <input class="xd-input xd-num" type="number" min="0" max="5" @bind="_seqReintentos" /> vez/veces</label>
                                                        <label>despues de <input class="xd-input xd-num" type="number" min="0" @bind="_seqReintentoMin" /> minutos</label>
                                                    </div>
                                                    <div class="xd-sch-inline">
                                                        <label>Esperar <input class="xd-input xd-num" type="number" min="0" @bind="_seqPausa" /> minutos entre un tramo y el siguiente</label>
                                                    </div>
                                                    <div class="xd-sch-inline">
                                                        <label class="xd-check"><input type="checkbox" @bind="_seqLimitar" /> Detener la tarea si dura mas de</label>
                                                        <input class="xd-input xd-num" type="number" min="1" max="48" @bind="_seqMaxHoras" disabled="@(!_seqLimitar)" /> <span>horas</span>
                                                    </div>
                                                </div>
                                            }
                                            <ul class="xd-wz-info">
                                                <li>Si la tarea ya se esta ejecutando, no se inicia otra encima.</li>
                                                <li>Si el agente esta desconectado a la hora programada, la tarea corre en cuanto se conecte.</li>
                                                @if (_seqOn) { <li>Los documentos ya cargados se saltan: repetir un tramo no duplica nada.</li> }
                                            </ul>
                                        }
                                        else
                                        {
                                            <div class="xd-wz-title">Resumen</div>
                                            <div class="xd-wz-help">Revisa y pulsa Finalizar.</div>
                                            <dl class="xd-wz-sum">
                                                <dt>Nombre</dt><dd>@(string.IsNullOrWhiteSpace(_schName) ? "(sin nombre)" : _schName)</dd>
                                                <dt>Cuando</dt><dd>@TriggerPreviewText()</dd>
                                                <dt>Que hace</dt><dd>@(_seqOn ? SeqHuman(BuildSeqSpec()) : "Una corrida con los valores guardados del flujo.")</dd>
                                                <dt>Estado</dt><dd>@(_schActive ? "Habilitada" : "Deshabilitada (no corre sola)")</dd>
                                            </dl>
                                            @if (!_tgManual)
                                            {
                                                <div class="xd-wz-lbl">Proximas ejecuciones</div>
                                                @if (_wzPreview.Count == 0) { <div class="xd-sch-sum">Ninguna (revisa las fechas).</div> }
                                                else
                                                {
                                                    <ul class="xd-wz-next">
                                                        @foreach (var d in _wzPreview) { <li>@d.ToString("dddd dd 'de' MMMM yyyy, HH:mm", Es)</li> }
                                                    </ul>
                                                }
                                            }
                                        }
                                        @if (_schError is not null) { <div class="xd-error-box">@_schError</div> }
                                    </div>
                                </div>
                                <div class="xd-wz-foot">
                                    <button class="xd-btn" @onclick="CloseWizard">Cancelar</button>
                                    <span class="sp"></span>
                                    <button class="xd-btn" disabled="@(_wzStep == 0)" @onclick="() => GoStepAsync(_wzStep - 1)">&lt; Atras</button>
                                    @if (_wzStep < WzSteps.Length - 1)
                                    {
                                        @if (_wzId is not null) { <button class="xd-btn" @onclick="SaveScheduleAsync" disabled="@_busy">Guardar</button> }
                                        <button class="xd-btn primary" @onclick="() => GoStepAsync(_wzStep + 1)">Siguiente &gt;</button>
                                    }
                                    else
                                    {
                                        <button class="xd-btn primary" @onclick="SaveScheduleAsync" disabled="@_busy">Finalizar</button>
                                    }
                                </div>
                              </div>
                            </div>
                        }
                        <div class="xd-help">La corrida programada la ejecuta el mismo agente asignado; si esta
                            offline queda esperando y se reintenta al reconectar. Requiere un agente asignado.</div>
                    </div>
                </div>
                }

                @if (_tab == TabHist)
                {
                @* ===== Historial de corridas (bitacora, Ola 3) ===== *@
                <div class="xd-card">
                    <div class="xd-card-head">
                        <div class="xd-card-title">Historial de corridas <span class="xd-num-badge">@_runs.Count</span></div>
                    </div>
                    @if (_runs.Count == 0)
                    {
