    private static void Toggle(HashSet<int> set, int v) { if (!set.Remove(v)) { set.Add(v); } }

    /// <summary>Meses: vacio = todos. Al desmarcar uno con "todos" activo, quedan los otros 11.</summary>
    private void ToggleMes(int m)
    {
        if (_tgMeses.Count == 0) { for (var i = 1; i <= 12; i++) { if (i != m) { _tgMeses.Add(i); } } return; }
        Toggle(_tgMeses, m);
        if (_tgMeses.Count == 12) { _tgMeses.Clear(); }
    }

    private bool TgOn(string key) => key switch
    {
        "manual" => _tgManual,
        "una" => !_tgManual && _tgTipo == TriggerTipo.UnaVez,
        "semanal" => !_tgManual && _tgTipo == TriggerTipo.Semanal,
        "mensual" => !_tgManual && _tgTipo == TriggerTipo.Mensual,
        _ => !_tgManual && _tgTipo == TriggerTipo.Diaria,
    };

    private void SetTg(string key)
    {
        _tgManual = key == "manual";
        if (_tgManual) { return; }
        _tgTipo = key switch
        {
            "una" => TriggerTipo.UnaVez,
            "semanal" => TriggerTipo.Semanal,
            "mensual" => TriggerTipo.Mensual,
            _ => TriggerTipo.Diaria,
        };
        if (_tgTipo == TriggerTipo.Semanal && _tgDias.Count == 0) { _tgDias.Add((int)_tgFecha.DayOfWeek); }
        if (_tgTipo == TriggerTipo.Mensual && _tgDiasMes.Count == 0) { _tgDiasMes.Add(1); }
    }

    private async Task<DateTime> SafeTenantNowAsync()
    {
        try { return await FlowSvc.TenantNowAsync(); }
        catch { return DateTime.Now; }
    }

    private void ResetWizard(DateTime now)
    {
        _wzToday = now.Date;
        _schName = ""; _schActive = true; _schError = null; _wzPreview = Array.Empty<DateTime>();
        _tgManual = false; _tgTipo = TriggerTipo.Diaria; _tgFecha = now.Date; _tgHora = new TimeOnly(6, 0); _tgCada = 1;
        _tgDias.Clear(); _tgMeses.Clear(); _tgPorDia = true; _tgDiasMes.Clear(); _tgDiasMes.Add(1);
        _tgOrdinal = 1; _tgDiaSemana = 1; _tgRepetir = false; _tgRepCada = 60; _tgRepDurante = 0;
        _tgCaduca = false; _tgCadFecha = now.Date.AddMonths(1); _tgCadHora = new TimeOnly(23, 59); _tgLegacy = null;
        _seqOn = false; (_seqVarDesde, _seqVarLargo) = ("DIAS_DESDE", "DIAS_ATRAS");
        _seqDesde = 0; _seqTotal = 6; _seqPaso = 3; _seqPausa = 5; _seqReintentos = 1; _seqReintentoMin = 20;
        _seqLimitar = false; _seqMaxHoras = 6;
    }

    private async Task NewScheduleAsync(SchPreset preset)
    {
        ResetWizard(await SafeTenantNowAsync());
        switch (preset)
        {
            case SchPreset.Diaria:
                _schName = "Diaria"; _tgTipo = TriggerTipo.Diaria; _tgHora = new TimeOnly(6, 0);
                _seqOn = true; _seqTotal = 6; _seqPaso = 3;
                break;
            case SchPreset.Semanal:
                _schName = "Barrido semanal"; _tgTipo = TriggerTipo.Semanal; _tgHora = new TimeOnly(1, 0); _tgDias.Add(0);
                _seqOn = true; _seqTotal = 60; _seqPaso = 3; _seqLimitar = true; _seqMaxHoras = 10;
                break;
        }
        _wzId = null; _wzStep = 0; _wz = true;
    }

    private async Task EditScheduleAsync(ScrapeScheduleDto s)
    {
        ResetWizard(await SafeTenantNowAsync());
        _wzId = s.Id; _schName = s.Name; _schActive = s.IsActive;
        if (s.Trigger is { } t)
        {
            _tgTipo = t.Tipo; _tgFecha = t.Inicio.Date; _tgHora = TimeOnly.FromDateTime(t.Inicio); _tgCada = t.Cada;
            _tgDias.Clear(); foreach (var d in t.Dias) { _tgDias.Add(d); }
            _tgMeses.Clear(); foreach (var m in t.Meses) { _tgMeses.Add(m); }
            _tgPorDia = t.PorDiaDelMes;
            _tgDiasMes.Clear(); foreach (var d in t.DiasMes) { _tgDiasMes.Add(d); }
            if (_tgDiasMes.Count == 0) { _tgDiasMes.Add(1); }
            _tgOrdinal = t.Ordinal; _tgDiaSemana = t.DiaSemana;
            _tgRepetir = t.RepetirCadaMin is not null; _tgRepCada = t.RepetirCadaMin ?? 60; _tgRepDurante = t.RepetirDuranteMin ?? 0;
            _tgCaduca = t.Caduca is not null;
            if (t.Caduca is DateTime c) { _tgCadFecha = c.Date; _tgCadHora = TimeOnly.FromDateTime(c); }
        }
        else if (s.Kind == ImportScheduleKind.Manual) { _tgManual = true; }
        else
        {
            // Programacion de antes del asistente (cron/intervalo): se traduce a desencadenador si es simple.
            var f = FriendlySchedule.FromStorage(s.Kind, s.IntervalMinutes, s.CronExpression);
            switch (f?.Recurrence)
            {
                case ScheduleRecurrence.Daily:
                    _tgTipo = TriggerTipo.Diaria; _tgHora = f.Time ?? _tgHora; break;
                case ScheduleRecurrence.Weekly:
                    _tgTipo = TriggerTipo.Semanal; _tgHora = f.Time ?? _tgHora;
                    foreach (var d in f.DaysOfWeek ?? Array.Empty<int>()) { _tgDias.Add(d); }
                    break;
                case ScheduleRecurrence.Monthly:
                    _tgTipo = TriggerTipo.Mensual; _tgHora = f.Time ?? _tgHora;
                    _tgDiasMes.Clear(); _tgDiasMes.Add(f.DayOfMonth ?? 1);
                    break;
                case ScheduleRecurrence.EveryN:
                    var n = (f.EveryValue ?? 60) * (f.EveryUnit == ScheduleEveryUnit.Hours ? 60 : 1);
                    _tgTipo = TriggerTipo.Diaria; _tgHora = new TimeOnly(0, 0); _tgRepetir = true;
                    _tgRepCada = RepCadaOpts.MinBy(o => Math.Abs(o.Min - n)).Min;
                    break;
                default:
                    _tgLegacy = FriendlySchedule.Describe(s.Kind, s.IntervalMinutes, s.CronExpression);
                    break;
            }
        }
        if (s.Sequence is { } q)
        {
            _seqOn = true; _seqVarDesde = q.VarDesde; _seqVarLargo = q.VarLargo;
            _seqDesde = q.Desde; _seqTotal = Math.Max(1, q.Hasta - q.Desde); _seqPaso = q.Paso;
            _seqPausa = q.PausaMin; _seqReintentos = q.Reintentos; _seqReintentoMin = q.ReintentoMin;
            _seqLimitar = q.MaxHoras > 0; _seqMaxHoras = q.MaxHoras > 0 ? q.MaxHoras : 6;
        }
        _wzStep = 0; _wz = true;
    }

    private void CloseWizard() { _wz = false; _schError = null; }

    private ScheduleTrigger BuildTrigger() => new()
    {
        Tipo = _tgTipo,
        Inicio = _tgFecha.Date + _tgHora.ToTimeSpan(),
        Cada = _tgTipo is TriggerTipo.Diaria or TriggerTipo.Semanal ? _tgCada : 1,
        Dias = _tgTipo == TriggerTipo.Semanal ? _tgDias.Order().ToArray() : Array.Empty<int>(),
        Meses = _tgTipo == TriggerTipo.Mensual ? _tgMeses.Order().ToArray() : Array.Empty<int>(),
        PorDiaDelMes = _tgPorDia,
        DiasMes = _tgTipo == TriggerTipo.Mensual && _tgPorDia ? _tgDiasMes.Order().ToArray() : Array.Empty<int>(),
        Ordinal = _tgOrdinal,
        DiaSemana = _tgDiaSemana,
        RepetirCadaMin = _tgRepetir ? _tgRepCada : null,
        RepetirDuranteMin = _tgRepetir && _tgRepDurante > 0 ? _tgRepDurante : null,
        Caduca = _tgCaduca ? _tgCadFecha.Date + _tgCadHora.ToTimeSpan() : null,
    };

    private FlowSequenceSpec BuildSeqSpec() => new()
    {
        VarDesde = (_seqVarDesde ?? "").Trim(), VarLargo = (_seqVarLargo ?? "").Trim(),
        Desde = _seqDesde, Hasta = _seqDesde + _seqTotal, Paso = _seqPaso,
        PausaMin = _seqPausa, Reintentos = _seqReintentos, ReintentoMin = _seqReintentoMin,
        MaxHoras = _seqLimitar ? _seqMaxHoras : 0,
    };

    private string? ValidateStep(int step) => step switch
    {
        0 => string.IsNullOrWhiteSpace(_schName) ? "Ponle un nombre a la tarea." : null,
        1 => _tgManual ? null : BuildTrigger().Validate(),
        2 or 3 => _seqOn ? BuildSeqSpec().Validate() : null,
        _ => null,
    };

    private async Task GoStepAsync(int target)
    {
        if (target < 0 || target >= WzSteps.Length) { return; }
        if (target > _wzStep)
        {
            for (var i = _wzStep; i < target; i++)
            {
                if (ValidateStep(i) is { } e) { _schError = e; _wzStep = i; return; }
            }
        }
        _schError = null;
        _wzStep = target;
        if (_wzStep == WzSteps.Length - 1)
        {
            try { _wzPreview = _tgManual ? Array.Empty<DateTime>() : await FlowSvc.PreviewTriggerAsync(BuildTrigger(), 5); }
            catch { _wzPreview = Array.Empty<DateTime>(); }
        }
    }

    private async Task SaveScheduleAsync()
    {
        if (_selected is null || !_wz) { return; }
        for (var i = 0; i < WzSteps.Length; i++)
