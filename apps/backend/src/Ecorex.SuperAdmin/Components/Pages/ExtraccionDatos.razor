    // ---- Helpers ----

    private void Flash(string msg, bool error = false) { _flash = msg; _flashError = error; }

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
    private static string? NullIfBlank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    private static Guid? ParseGuid(string s) => Guid.TryParse(s, out var g) ? g : null;
    private static int? ParseInt(string s) => int.TryParse(s, out var n) ? n : null;

    // Modelo (solo lectura) de la IA elegida en el paso: lo fija el Super Admin en ese proveedor.
    private string SelectedAiModel()
        => Guid.TryParse(_sAiProviderId, out var id)
            ? _aiProviders.FirstOrDefault(p => p.ConfigId == id)?.DefaultModel ?? ""
            : "";
    private static string Shorten(string? s, int max) => string.IsNullOrEmpty(s) ? "" : (s.Length <= max ? s : s[..max] + "...");

    private static string StatusLabel(ScrapeSourceStatus s) => s switch
    {
        ScrapeSourceStatus.Active => "Activa",
        ScrapeSourceStatus.Inactive => "Inactiva",
        _ => "Con errores"
    };

    private static string DotClass(ScrapeSourceStatus s) => s == ScrapeSourceStatus.Error ? "err" : "";

    private static string RunLabel(ImportRunResult r) => r switch
    {
        ImportRunResult.Ok => "OK",
        ImportRunResult.Running => "Ejecutando",
        ImportRunResult.PendingOffline => "Esperando al agente",
        ImportRunResult.Skipped => "Omitida",
        _ => "Error"
    };

    private static string RunPillClass(ImportRunResult r) => r switch
    {
        ImportRunResult.Ok => "ok",
        ImportRunResult.Running or ImportRunResult.PendingOffline => "wait",
        _ => "err"
    };

    private static string RunDuration(ScrapeFlowRunDto r) =>
        r.FinishedAt is DateTimeOffset f ? $"{(f - r.FiredAt).TotalSeconds:0.0} s" : "-";

    private static string KindLabel(ScrapeStepKind k) => k switch
    {
        ScrapeStepKind.Navigate => "Navegar",
        ScrapeStepKind.InjectScript => "Inyectar JS",
        ScrapeStepKind.Extract => "Extraer",
        ScrapeStepKind.Wait => "Esperar",
        ScrapeStepKind.Click => "Clic",
        ScrapeStepKind.Screenshot => "Captura",
        ScrapeStepKind.Ai => "IA",
        ScrapeStepKind.Tabla => "Tabla (legacy)",
        ScrapeStepKind.TablaID => "Tabla por ID (legacy)",
        ScrapeStepKind.Exploracion => "Exploracion (legacy)",
        ScrapeStepKind.Ensamblado => "Ensamblado/Regla (legacy)",
        ScrapeStepKind.WebResponse => "Web response (legacy)",
        ScrapeStepKind.EjecutarSql => "Ejecutar SQL (legacy)",
        ScrapeStepKind.Variable => "Variable (legacy)",
        ScrapeStepKind.Api => "API (legacy)",
        ScrapeStepKind.Tramite => "Tramite (legacy)",
        ScrapeStepKind.CerrarDron => "Cerrar dron (legacy)",
        ScrapeStepKind.Mouse => "Mouse (legacy)",
        ScrapeStepKind.LeerCorreoOtp => "Leer token de correo",
        ScrapeStepKind.ProcesarArchivos => "Procesar archivos descargados",
        ScrapeStepKind.IngestaNewton => "Ingesta NEWTON (API)",
        _ => k.ToString()
    };

    // Familias de comportamiento del paso (nativos + legacy):
    // - Extract-like: el script devuelve filas que se ingieren (muestra mapeo + tabla destino).
    private static bool IsExtractKind(ScrapeStepKind k) => k is ScrapeStepKind.Extract
        or ScrapeStepKind.Tabla or ScrapeStepKind.TablaID or ScrapeStepKind.Exploracion or ScrapeStepKind.WebResponse;
    // - Script-only: solo ejecuta JS (muestra solo el script).
    private static bool IsScriptOnlyKind(ScrapeStepKind k) => k is ScrapeStepKind.InjectScript
        or ScrapeStepKind.Variable or ScrapeStepKind.Ensamblado or ScrapeStepKind.EjecutarSql
        or ScrapeStepKind.Api or ScrapeStepKind.Tramite or ScrapeStepKind.CerrarDron;
    // - Cualquier paso con campo de script (extract-like o script-only).
    private static bool IsScriptKind(ScrapeStepKind k) => IsExtractKind(k) || IsScriptOnlyKind(k);
    // - Basado en selector (clic/mouse).
    private static bool IsClickKind(ScrapeStepKind k) => k is ScrapeStepKind.Click or ScrapeStepKind.Mouse;

    private static string TagClass(ScrapeStepKind k) => k switch
    {
        ScrapeStepKind.Navigate => "nav",
        ScrapeStepKind.Wait => "wait",
        ScrapeStepKind.Ai => "ai",
        _ when IsExtractKind(k) => "extract",
        _ => "script"
    };

    private static string StepSummary(ScrapeStepDto s) => s.Kind switch
    {
        ScrapeStepKind.Navigate => "Va a la URL indicada.",
        ScrapeStepKind.Wait => s.WaitMs is int ms ? $"Espera {ms} ms." : "Espera a que aparezca el selector.",
        ScrapeStepKind.Click => "Hace clic sobre el selector.",
        ScrapeStepKind.Mouse => "Accion de mouse sobre el selector (legacy).",
        ScrapeStepKind.Screenshot => "Captura de pantalla.",
        ScrapeStepKind.Ai => $"Un agente de IA maneja el navegador (tope {s.MaxSteps?.ToString() ?? "-"} pasos / {s.MaxSeconds?.ToString() ?? "-"} s).",
        ScrapeStepKind.LeerCorreoOtp => "Lee un OTP/token de un buzon por correo (IMAP) y lo pone en una variable del flujo.",
        ScrapeStepKind.ProcesarArchivos => "Parsea (server-side) los archivos ya descargados y los vuelca al modulo destino, sin duplicar.",
        ScrapeStepKind.IngestaNewton => "Baja por la API de NEWTON los documentos recibidos como {CUFE}.xml y {CUFE}_newton.pdf a una carpeta propia.",
        _ when IsExtractKind(s.Kind) => "Inyecta JS que devuelve filas y las ingiere en la tabla destino.",
        _ => "Inyecta/ejecuta JavaScript (firmado por el servidor)."
    };
