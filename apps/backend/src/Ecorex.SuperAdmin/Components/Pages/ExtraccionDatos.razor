@page "/extraccion-datos"
@attribute [Authorize(Policy = "ExtraccionDatos.Editar")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Ecorex.Application.Scraping
@using Ecorex.Application.DataContainers
@using Ecorex.Application.Admin
@using Ecorex.Application.Common
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Agents
@inject IScrapeFlowService FlowSvc
@inject IOtpMailboxConfigService OtpSvc
@inject IDataImportConfigService ConfigSvc
@inject IBrowserRunService RunSvc
@inject IAiServerConfigService AiSvc
@inject IAgentRegistry Agents
@inject ITenantContext Tenant
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Extraccion de datos - ECOREX.tareas</PageTitle>

<div class="xd-page">

    @* ===== Topbar (proto: breadcrumb + MOD 000730 + acciones) ===== *@
    <div class="xd-topbar">
        <nav class="xd-crumb" aria-label="Ruta de navegacion">
            <span>Home</span><span class="sep">/</span>
            <span>Utilidades</span><span class="sep">/</span>
            <span class="last">Extraccion de datos</span>
            <span class="xd-mod-code">MOD 000730</span>
        </nav>
        <div class="xd-top-actions">
            <button class="xd-btn xd-new-btn primary" @onclick="NewFlow">+ Nueva configuracion</button>
        </div>
    </div>

    @if (_flash is not null)
    {
        <div class="xd-flash @(_flashError ? "err" : "ok")" role="status">
            <span>@_flash</span>
            <button class="xd-flash-x" @onclick="() => _flash = null" title="Cerrar">x</button>
        </div>
    }

    <div class="xd-layout">

        @* ---- Sidebar: lista de flujos ---- *@
        <aside class="xd-side">
            <div class="xd-side-head">
                <div class="xd-side-title">Configuraciones <span class="xd-side-count">@_flows.Count</span></div>
            </div>
            <div class="xd-side-search">
                <input placeholder="Buscar..." @bind="_search" @bind:event="oninput" />
            </div>
            <div class="xd-side-list">
                @if (FilteredFlows.Count == 0)
                {
                    <div class="xd-empty">@(_flows.Count == 0 ? "Aun no hay flujos. Crea el primero con + Nueva configuracion." : "Sin resultados.")</div>
                }
                @foreach (var f in FilteredFlows)
                {
                    <div class="xd-item @(_selected?.Id == f.Id && !_isNew ? "active" : "")" @onclick="() => PickFlowAsync(f.Id)">
                        <div class="xd-item-icon">@Initial(f.Name)</div>
                        <div class="xd-item-body">
                            <div class="xd-item-name" title="@f.Name">@f.Name</div>
                            <div class="xd-item-meta">
                                <span class="xd-dot @DotClass(f.Status)"></span>
                                @StatusLabel(f.Status) &middot; @f.StepCount paso@(f.StepCount == 1 ? "" : "s")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <div class="xd-main">

            @if (_isNew)
            {
                @* ---- Alta de un flujo nuevo (cabecera minima) ---- *@
                <div class="xd-card">
                    <div class="xd-card-head"><div class="xd-card-title">Nueva configuracion</div></div>
                    <div class="xd-props-body">
                        <div class="xd-prop">
                            <label>Nombre</label>
                            <input class="xd-input" placeholder="Ej. Precios competencia Homecenter" @bind="_hName" />
                        </div>
                        <div class="xd-prop">
                            <label>URL de arranque</label>
                            <input class="xd-input" placeholder="https://..." @bind="_hUrl" />
                        </div>
                        @if (_headError is not null) { <div class="xd-error-box">@_headError</div> }
                        <div class="xd-props-actions">
                            <button class="xd-btn primary" @onclick="CreateFlowAsync" disabled="@_busy">Crear</button>
                            <button class="xd-btn" @onclick="CancelNew">Cancelar</button>
                        </div>
                    </div>
                </div>
            }
            else if (_selected is null)
            {
                <div class="xd-card"><div class="xd-card-empty">Elige un flujo de la izquierda, o crea uno nuevo.</div></div>
            }
            else
            {
                var flow = _selected;

                @* ---- Hero ---- *@
                <div class="xd-hero">
                    <div class="xd-hero-head">
                        <div>
                            <h1 class="xd-hero-title">
                                <span>@flow.Name</span>
                                <span class="xd-hero-badge">@StatusLabel(flow.Status)</span>
                            </h1>
                            <div class="xd-hero-url">@flow.StartUrl</div>
                        </div>
                        <div class="xd-hero-actions">
                            <button class="xd-hero-btn" @onclick="RunFlowAsync" disabled="@(_busy || flow.Steps.Count == 0)">
                                @(_busy ? "Ejecutando..." : "Ejecutar ahora")
                            </button>
                            <button class="xd-hero-btn ghost" @onclick="ToggleHeaderEdit">@(_editHeader ? "Cerrar" : "Editar")</button>
                            <button class="xd-hero-btn ghost" @onclick="DeleteFlowAsync" disabled="@_busy">Eliminar</button>
                        </div>
                    </div>
                    <div class="xd-kpis">
                        <div class="xd-kpi"><div class="lbl">Corridas</div><div class="val">@_runs.Count</div></div>
                        <div class="xd-kpi"><div class="lbl">Exitosas</div><div class="val">@_runs.Count(r => r.Result == ImportRunResult.Ok)</div></div>
                        <div class="xd-kpi"><div class="lbl">Filas (ult.)</div><div class="val">@(_runs.FirstOrDefault(r => r.Result == ImportRunResult.Ok)?.Inserted.ToString() ?? "-")</div></div>
                        <div class="xd-kpi"><div class="lbl">Ultima corrida</div><div class="val">@(flow.LastRunAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "nunca")</div></div>
                    </div>
                </div>

                @* ---- Banda: el runtime es la colmena, no esta pantalla ---- *@
                <div class="xd-strip">
                    <strong>Runtime:</strong>&nbsp; "Ejecutar ahora" ejecuta el flujo paso a paso en el
                    <strong>sub-agente Navegador</strong> del agente asignado (WebView2 + acciones tipadas + JS firmado).
                    Los pasos de <strong>IA</strong> los maneja un agente con las tools del navegador (acotado por su
                    allow-list y sus topes), y requieren un proveedor de IA habilitado en el Super Admin.
                    Si el agente no esta en linea, la corrida queda <strong>esperando</strong> y se reintenta cuando vuelva.
                </div>

                @if (_editHeader)
                {
                    @* ---- Edicion de cabecera ---- *@
                    <div class="xd-card">
                        <div class="xd-card-head"><div class="xd-card-title">Cabecera del flujo</div></div>
                        <div class="xd-props-body">
                            <div class="xd-prop"><label>Nombre</label><input class="xd-input" @bind="_hName" /></div>
                            <div class="xd-prop"><label>Descripcion</label><input class="xd-input" @bind="_hDesc" /></div>
                            <div class="xd-prop"><label>URL de arranque</label><input class="xd-input" @bind="_hUrl" /></div>
                            <div class="xd-prop">
                                <label>Estado</label>
                                <select class="xd-input" @bind="_hStatus">
                                    @foreach (var st in Enum.GetValues<ScrapeSourceStatus>())
                                    { <option value="@st">@StatusLabel(st)</option> }
                                </select>
                            </div>
                            <div class="xd-prop">
                                <label>Paginacion (opcional): variable de pagina</label>
                                <input class="xd-input mono" placeholder="PAGINA" @bind="_hPageVar" />
                            </div>
                            <div class="xd-two">
                                <div class="xd-prop"><label>Desde</label><input class="xd-input" type="number" @bind="_hPageFrom" /></div>
                                <div class="xd-prop"><label>Hasta</label><input class="xd-input" type="number" @bind="_hPageTo" /></div>
                            </div>
                            <div class="xd-help">Si defines una variable de pagina y un rango, el flujo se repite por cada
                                pagina, sustituyendo {{ese nombre}} en las URLs/scripts.</div>
                            @if (_headError is not null) { <div class="xd-error-box">@_headError</div> }
                            <div class="xd-props-actions">
                                <button class="xd-btn primary" @onclick="SaveHeaderAsync" disabled="@_busy">Guardar</button>
                                <button class="xd-btn" @onclick="() => _editHeader = false">Cancelar</button>
                            </div>
                        </div>
                    </div>
                }

                <div class="xd-cols">

                    @* ===== Pasos ===== *@
                    <div class="xd-card">
                        <div class="xd-card-head">
                            <div class="xd-card-title">Pasos de ejecucion <span class="xd-num-badge">@flow.Steps.Count</span></div>
                            <button class="xd-btn sm primary" @onclick="() => OpenStepEditor(null)">+ Agregar paso</button>
                        </div>

                        @* ---- Paso a paso (sesion viva): inyecta un paso a la vez sobre la MISMA ventana del agente ---- *@
                        @if (flow.Steps.Count > 0)
                        {
                            <div class="xd-stepper">
                                <div class="xd-stepper-info">
                                    <span class="xd-stepper-label">Paso a paso</span>
                                    <span class="xd-stepper-next">
                                        @if (_stepCursor < flow.Steps.Count)
                                        { <text>Proximo: @(_stepCursor + 1). @flow.Steps.ElementAt(_stepCursor).Name</text> }
                                        else
                                        { <text>Fin del flujo</text> }
                                    </span>
                                </div>
                                <div class="xd-stepper-actions">
                                    <button class="xd-btn sm primary" @onclick="RunNextStepAsync"
                                            disabled="@(_busy || _stepCursor >= flow.Steps.Count)">
                                        @(_busy ? "Ejecutando..." : "Ejecutar siguiente ▶")
                                    </button>
                                    <button class="xd-btn sm" @onclick="ResetCursor" disabled="@(_busy || _stepCursor == 0)">Reiniciar</button>
                                    <button class="xd-btn sm" @onclick="CloseLiveSessionAsync" disabled="@_busy" title="Cierra la ventana que el agente mantiene abierta">Cerrar navegador</button>
                                </div>
                            </div>
                            <div class="xd-stepper-help">Cada paso se inyecta en el navegador del agente y la ventana <strong>queda abierta</strong>
                                para el siguiente (login &rarr; OTP &rarr; continuar). Pulsa &#9654; en un paso para correr ese, o "Ejecutar siguiente"
                                para avanzar en orden. Al terminar, "Cerrar navegador".</div>
                        }

                        <div class="xd-steps">
                            @if (flow.Steps.Count == 0)
                            {
                                <div class="xd-empty">Sin pasos. Agrega el primero (navegar, inyectar script, extraer, o un paso de IA).</div>
                            }
                            @{ var idx = 0; }
                            @foreach (var s in flow.Steps)
                            {
                                var i = idx++;
                                <div class="xd-step @(i == _stepCursor ? "cursor" : "")">
                                    <div class="xd-step-num">@(i + 1)</div>
                                    <div class="xd-step-body">
                                        <h4>@s.Name <span class="xd-tag @TagClass(s.Kind)">@KindLabel(s.Kind)</span></h4>
                                        <div class="xd-step-desc">@StepSummary(s)</div>
                                        @if (!string.IsNullOrWhiteSpace(s.Url)) { <span class="xd-step-url">@s.Url</span> }
                                        @if (!string.IsNullOrWhiteSpace(s.Script))
                                        { <pre class="xd-code-editor">@Shorten(s.Script, 240)</pre> }
                                        @if (s.Kind == ScrapeStepKind.Ai && !string.IsNullOrWhiteSpace(s.Instruction))
                                        { <div class="xd-step-ai">"@s.Instruction"</div> }
                                    </div>
                                    <div class="xd-step-actions">
                                        <button class="xd-icon-btn play" title="Ejecutar este paso (sesion viva)" disabled="@_busy" @onclick="() => RunStepAsync(s, i)">&#9654;</button>
                                        @if (!string.IsNullOrWhiteSpace(s.LoopOverVar))
                                        {
                                            <button class="xd-icon-btn loop" title="Ejecutar bucle (consumir todas las filas)" disabled="@_busy" @onclick="() => RunLoopAsync(s)">&#8635;</button>
                                        }
                                        <button class="xd-icon-btn" title="Subir" disabled="@(i == 0)" @onclick="() => MoveStepAsync(i, -1)">&uarr;</button>
                                        <button class="xd-icon-btn" title="Bajar" disabled="@(i == flow.Steps.Count - 1)" @onclick="() => MoveStepAsync(i, 1)">&darr;</button>
                                        <button class="xd-icon-btn" title="Editar" @onclick="() => OpenStepEditor(s)">&#9998;</button>
                                        <button class="xd-icon-btn" title="Eliminar" @onclick="() => DeleteStepAsync(s.Id)">&times;</button>
                                    </div>
                                </div>
                            }
                        </div>

                        @* ---- Resultado del ultimo paso ejecutado (paso a paso) ---- *@
                        @if (_stepResult is not null)
                        {
                            <div class="xd-step-result @(_stepResult.Ok ? "ok" : "err")">
                                <div class="xd-step-result-head">
                                    <strong>@(_stepResult.Ok ? "✓ Paso OK" : "✕ Paso con error")</strong>
                                    @if (!string.IsNullOrWhiteSpace(_stepResult.Detail)) { <span class="xd-step-result-detail">@_stepResult.Detail</span> }
                                    <button class="xd-flash-x" @onclick="() => _stepResult = null" title="Cerrar">x</button>
                                </div>
                                @if (!_stepResult.Ok && !string.IsNullOrWhiteSpace(_stepResult.Error))
                                { <div class="xd-step-result-err">@_stepResult.Error</div> }
                                @if (!string.IsNullOrWhiteSpace(_stepResult.Value))
                                { <pre class="xd-step-result-val">@_stepResult.Value</pre> }
                                @if (!string.IsNullOrEmpty(_stepResult.ScreenshotBase64))
                                { <img class="xd-step-shot" src="data:image/png;base64,@_stepResult.ScreenshotBase64" alt="Captura del paso" /> }
                            </div>
                        }

                        @if (_showStepEditor)
                        {
                            <div class="xd-modal-backdrop" @onclick="() => _showStepEditor = false">
                              <div class="xd-modal" @onclick:stopPropagation="true">
                                <div class="xd-modal-head">
                                    <div class="xd-card-title" style="font-size:14px;">@(_editingStepId is null ? "Nuevo paso" : "Editar paso")</div>
                                    <button class="xd-icon-btn" title="Cerrar" @onclick="() => _showStepEditor = false">&times;</button>
                                </div>
                                <div class="xd-modal-body">
                                <div class="xd-prop">
                                    <label>Tipo de paso</label>
                                    <select class="xd-input" @bind="_sKind">
                                        @foreach (var k in Enum.GetValues<ScrapeStepKind>())
                                        { <option value="@k">@KindLabel(k)</option> }
                                    </select>
                                </div>
                                <div class="xd-prop"><label>Nombre</label><input class="xd-input" placeholder="Ej. Login con credenciales" @bind="_sName" /></div>

                                @if (_sKind == ScrapeStepKind.Navigate)
                                {
                                    <div class="xd-prop"><label>URL (admite {{VAR}})</label><input class="xd-input" @bind="_sUrl" /></div>
                                }
                                else if (IsScriptKind(_sKind))
                                {
                                    <div class="xd-prop"><label>Script JS (cuerpo de funcion: usa <code>return</code>; el servidor lo firma al ejecutar)</label>
                                        <textarea class="xd-input xd-code-input" rows="6"
                                            placeholder="return Array.from(document.querySelectorAll('.fila')).map(r => ({ CODIGO: r.dataset.id, NOMBRE: r.querySelector('.nombre').innerText }));"
                                            @bind="_sScript"></textarea></div>
                                    @if (IsExtractKind(_sKind))
                                    {
                                        <div class="xd-prop"><label>Mapeo campo -> columna (JSON, opcional)</label>
                                            <textarea class="xd-input xd-code-input" rows="3" placeholder='{"sku":"CODIGO","nombre":"NOMBRE"}' @bind="_sMappingJson"></textarea></div>
                                        <div class="xd-prop"><label>Tabla destino (si difiere de la del flujo)</label>
                                            <select class="xd-input" @bind="_sTargetContainer">
                                                <option value="">(la del flujo)</option>
                                                @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                            </select></div>
                                    }
                                }
                                else if (_sKind == ScrapeStepKind.Wait)
                                {
                                    <div class="xd-prop"><label>Selector a esperar (opcional)</label><input class="xd-input" @bind="_sSelector" /></div>
                                    <div class="xd-prop"><label>Espera (ms)</label><input class="xd-input" type="number" @bind="_sWaitMs" /></div>
                                }
                                else if (IsClickKind(_sKind))
                                {
                                    <div class="xd-prop"><label>Selector a clicar</label><input class="xd-input" @bind="_sSelector" /></div>
                                }
                                else if (_sKind == ScrapeStepKind.Ai)
                                {
                                    <div class="xd-prop"><label>Instruccion (lenguaje natural)</label>
                                        <textarea class="xd-input" rows="3" placeholder="Ej. saca la tabla de precios y ponla en Productos" @bind="_sInstruction"></textarea></div>
                                    <div class="xd-prop"><label>Tabla destino</label>
                                        <select class="xd-input" @bind="_sTargetContainer">
                                            <option value="">(la del flujo)</option>
                                            @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                        </select></div>
                                    <div class="xd-prop"><label>Tools permitidas (browser.*, separadas por coma)</label>
                                        <input class="xd-input" placeholder="navigate, eval, screenshot" @bind="_sToolAllow" /></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Tope de pasos</label><input class="xd-input" type="number" @bind="_sMaxSteps" /></div>
                                        <div class="xd-prop"><label>Tope de segundos</label><input class="xd-input" type="number" @bind="_sMaxSeconds" /></div>
                                    </div>
                                    <div class="xd-prop"><label>IA (entre las habilitadas por el Super Admin)</label>
                                        @if (_aiProviders.Count == 0)
                                        {
                                            <div class="xd-hint">No hay IAs habilitadas. Habilita un proveedor en Super Admin -&gt; Servidores de IA.</div>
                                        }
                                        else
                                        {
                                            <select class="xd-input" @bind="_sAiProviderId">
                                                <option value="">(elige una IA)</option>
                                                @foreach (var p in _aiProviders) { <option value="@p.ConfigId">@p.DisplayName</option> }
                                            </select>
                                        }
                                    </div>
                                    <div class="xd-prop"><label>Modelo (lo fija el Super Admin)</label>
                                        <input class="xd-input" value="@SelectedAiModel()" disabled /></div>
                                }
                                else if (_sKind == ScrapeStepKind.LeerCorreoOtp)
                                {
                                    <div class="xd-prop"><label>Buzon OTP</label>
                                        @if (_buzones.Count == 0)
                                        {
                                            <div class="xd-hint">No hay buzones. Configura uno en Automatizaciones -&gt; Buzones OTP.</div>
                                        }
                                        else
                                        {
                                            <select class="xd-input" @bind="_sOtpMailbox">
                                                <option value="">(elige un buzon)</option>
                                                @foreach (var m in _buzones) { <option value="@m.Id">@m.Nombre (@m.Usuario)</option> }
                                            </select>
                                        }
                                    </div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Remitente contiene (opcional)</label><input class="xd-input" placeholder="no-reply@@..." @bind="_sOtpFrom" /></div>
                                        <div class="xd-prop"><label>Asunto contiene (opcional)</label><input class="xd-input" placeholder="codigo, verificacion" @bind="_sOtpSubject" /></div>
                                    </div>
                                    <div class="xd-prop"><label>Regex del token (grupo 1 si existe)</label><input class="xd-input" @bind="_sOtpRegex" /></div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Variable destino (se inserta como &#123;&#123;NOMBRE&#125;&#125; en pasos siguientes)</label><input class="xd-input" placeholder="TOKEN" @bind="_sOtpVar" /></div>
                                        <div class="xd-prop"><label>Timeout de espera (seg)</label><input class="xd-input" type="number" @bind="_sOtpTimeout" /></div>
                                    </div>
                                    <div class="xd-props-actions">
                                        <button class="xd-btn" @onclick="ProbarOtpAsync" disabled="@(_busy || string.IsNullOrEmpty(_sOtpMailbox))">@(_busy ? "Leyendo..." : "Probar lectura")</button>
                                    </div>
                                    @if (_otpTest is not null)
                                    {
                                        <div class="xd-hint" style="margin-top:6px">
                                            @if (_otpTest.Ok) { <span>Token leido: <strong>@_otpTest.Token</strong> (@_otpTest.MatchedSubject)</span> }
                                            else { <span style="color:var(--danger,#b91c1c)">@_otpTest.Error</span> }
                                        </div>
                                    }
                                }
                                else if (_sKind == ScrapeStepKind.IngestaNewton)
                                {
                                    <div class="xd-help">Baja los documentos recibidos en NEWTON (API) como <code>{CUFE}.xml</code> y <code>{CUFE}_newton.pdf</code> a una carpeta propia. Las credenciales salen de variables del flujo (la del token debe ser <b>secreta</b>).</div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Variable con la URL base</label><input class="xd-input mono" placeholder="NEWTON_URL" @bind="_nwUrlVar" /></div>
                                        <div class="xd-prop"><label>Variable con el Auth-Token (secreta)</label><input class="xd-input mono" placeholder="NEWTON_TOKEN" @bind="_nwTokenVar" /></div>
                                    </div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Variable con la carpeta destino</label><input class="xd-input mono" placeholder="RutaDescargaNewton" @bind="_nwCarpetaVar" /><div class="xd-help">Si esa variable no existe, usa una subcarpeta <code>Newton</code> de <code>RutaDescargaBot</code>.</div></div>
                                        <div class="xd-prop"><label>Dias hacia atras</label><input class="xd-input" type="number" @bind="_nwDiasAtras" /></div>
                                    </div>
                                    <div class="xd-two">
                                        <label class="xd-check"><input type="checkbox" @bind="_nwBajarXml" /> Bajar XML (&#123;CUFE&#125;.xml)</label>
                                        <label class="xd-check"><input type="checkbox" @bind="_nwBajarPdf" /> Bajar PDF (&#123;CUFE&#125;_newton.pdf)</label>
                                    </div>
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Tope de documentos (0 = todos)</label><input class="xd-input" type="number" @bind="_nwMax" /></div>
                                        <label class="xd-check"><input type="checkbox" @bind="_nwSoloNuevos" /> Solo nuevos (no re-baja PDF si ya existe)</label>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_nwMarcarPlataforma" /> Marcar Plataforma (puebla la fuente NEWTON por CUFE; el "Cruzar" enciende la columna Plataforma)</label>
                                }

                                @if (_sKind != ScrapeStepKind.LeerCorreoOtp && _sKind != ScrapeStepKind.IngestaNewton)
                                {
                                    <div class="xd-prop">
                                        <label>Guardar salida como (motor: variable del flujo)</label>
                                        <input class="xd-input mono" placeholder="LISTADO" @bind="_sOutputVar" />
                                        <div class="xd-help">Opcional. Si lo pones, lo que devuelve este paso queda disponible para los
                                            siguientes como <code>&#123;&#123;NOMBRE.ruta&#125;&#125;</code> o <code>@("@@")NOMBRE.ruta@("@@")</code>
                                            (ej. <code>&#123;&#123;LISTADO.compras[0].btnDiligenciarId&#125;&#125;</code>).</div>
                                    </div>

                                    @* ---- Bucle (ForEach) + ingesta: motor del dron, Ola 2 ---- *@
                                    <div class="xd-prop">
                                        <label>Recorrer (ForEach) la variable (inicia bucle)</label>
                                        <input class="xd-input mono" placeholder="LISTADO.compras" @bind="_sLoopOverVar" />
                                        <div class="xd-help">Si lo pones, "Ejecutar bucle" recorre ese array; en cada vuelta la fila actual
                                            queda como <code>&#123;&#123;ROW.campo&#125;&#125;</code> / <code>@("@@")ROW.campo@("@@")</code>. El cuerpo va de este paso al marcado "fin del bucle".</div>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_sIsLoopEnd" /> Este paso es el FIN del cuerpo del bucle</label>
                                    <div class="xd-prop">
                                        <label>Paginacion: ruta al total de paginas (en el paso que inicia el bucle)</label>
                                        <input class="xd-input mono" placeholder="LISTADO.totalPaginas" @bind="_sPageCountVar" />
                                        <div class="xd-help">Si lo pones, tras consumir las filas de una pagina el motor avanza a la siguiente
                                            (corriendo los pasos marcados abajo) hasta ese total. La pagina actual queda como <code>@("@@")PAG@("@@")</code>.</div>
                                    </div>
                                    <label class="xd-check"><input type="checkbox" @bind="_sIsPageNext" /> Este paso AVANZA de pagina / recarga el listado (se corre entre paginas)</label>
                                    <div class="xd-prop">
                                        <label>Ingerir al Contenedor la ruta (opcional)</label>
                                        <input class="xd-input mono" placeholder="DETALLE.cabecera" @bind="_sIngestPath" />
                                        <div class="xd-help">Tras el paso, ingiere lo que haya en esa ruta (objeto = 1 fila; array = varias) a la
                                            tabla destino de abajo (o la del flujo). Usa el mapeo campo-&gt;columna.</div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_sIngestPath))
                                    {
                                        <div class="xd-prop"><label>Tabla destino de la ingesta</label>
                                            <select class="xd-input" @bind="_sTargetContainer">
                                                <option value="">(la del flujo)</option>
                                                @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                            </select></div>
                                        <div class="xd-prop"><label>Mapeo campo -&gt; columna (JSON, opcional)</label>
                                            <textarea class="xd-input xd-code-input" rows="3" placeholder='{"petof":"PETICION","solicitud":"SOLICITUD"}' @bind="_sMappingJson"></textarea></div>
                                        <div class="xd-prop"><label>Clave de idempotencia (columna, opcional)</label>
                                            <input class="xd-input mono" placeholder="PETOF" @bind="_sIngestKeyColumn" />
                                            <div class="xd-help">Si la pones, la ingesta hace <b>Upsert</b> por esa columna destino (debe estar mapeada):
                                                re-correr el flujo NO duplica (inserta si no existe, actualiza si coincide). Para 1 fila por entidad
                                                usa su id (p.ej. <code>PETOF</code>); para varias filas por entidad usa una clave por fila
                                                (p.ej. una columna <code>CLAVE</code>). Vacio = Append (agrega siempre).</div>
                                        </div>
                                    }

                                    @* ---- ENSAMBLADO -> Regla: motor del dron, Ola 4 ---- *@
                                    @if (_sKind == ScrapeStepKind.Ensamblado)
                                    {
                                        <div class="xd-prop">
                                            <label>Regla a invocar (ENSAMBLADO)</label>
                                            @if (_rules.Count == 0)
                                            {
                                                <div class="xd-hint">No hay reglas en este tenant. Crea una en el modulo Reglas.</div>
                                            }
                                            else
                                            {
                                                <select class="xd-input" @bind="_sRuleId">
                                                    <option value="">(ninguna)</option>
                                                    @foreach (var r in _rules) { <option value="@r.Id">@r.Label</option> }
                                                </select>
                                            }
                                        </div>
                                        <div class="xd-prop">
                                            <label>Entrada de la regla (ruta del contexto, objeto)</label>
                                            <input class="xd-input mono" placeholder="DETALLE.cabecera" @bind="_sRuleInputVar" />
                                            <div class="xd-help">El JSON de esa ruta se aplana y se entrega a la regla como datos (FormData). Vacio = <code>DETALLE</code>.</div>
                                        </div>
                                    }
                                }

                                @if (_sKind != ScrapeStepKind.Ai && _sKind != ScrapeStepKind.LeerCorreoOtp && _sKind != ScrapeStepKind.IngestaNewton)
                                {
                                    <div class="xd-two">
                                        <div class="xd-prop"><label>Advertencia: etiqueta a vigilar (opcional)</label>
                                            <input class="xd-input" placeholder="captcha" @bind="_sWarnLabel" /></div>
                                        <div class="xd-prop"><label>Si aparece</label>
                                            <select class="xd-input" @bind="_sWarnAction">
                                                <option value="@ScrapeWarningAction.None">Nada</option>
                                                <option value="@ScrapeWarningAction.Notify">Notificar (seguir)</option>
                                                <option value="@ScrapeWarningAction.Stop">Detener la corrida</option>
                                            </select></div>
                                    </div>
                                }

                                @if (_stepError is not null) { <div class="xd-error-box">@_stepError</div> }
                                <div class="xd-props-actions">
                                    <button class="xd-btn primary" @onclick="SaveStepAsync" disabled="@_busy">Guardar paso</button>
                                    <button class="xd-btn" @onclick="() => _showStepEditor = false">Cancelar</button>
                                </div>
                                </div>
                              </div>
                            </div>
                        }
                    </div>

                    @* ===== Cliente y variables ===== *@
                    <div class="xd-card">
                        <div class="xd-card-head"><div class="xd-card-title">Cliente y variables</div></div>
                        <div class="xd-props-body">
                            <div class="xd-prop">
                                <label>Agente (bot asignado)</label>
                                <select class="xd-input" @bind="_hClient" @bind:after="OnAgentChanged">
                                    <option value="">(sin agente)</option>
                                    @foreach (var c in _clients) { <option value="@c.Id">@c.Name</option> }
                                </select>
                                <div class="xd-agent-actions">
                                    <button class="xd-btn sm" @onclick="TestConnectionAsync" disabled="@(_busy || string.IsNullOrEmpty(_hClient))">Test de conexion</button>
                                    @* El alta/rotacion de agentes vive en su modulo propio (ADR-0045). Aqui solo se ELIGE. *@
                                    <a class="xd-btn sm" href="/agentes-colmena" target="_blank">Gestionar agentes</a>
                                </div>
                                @if (_probe is { } pr)
                                {
                                    <div class="xd-probe @(pr.Online ? "ok" : "off")">@pr.Text</div>
                                }
                            </div>
                            <div class="xd-prop">
                                <label>Tabla destino</label>
                                <select class="xd-input" @bind="_hContainer" @bind:after="SaveAssignmentsAsync">
                                    <option value="">(sin tabla)</option>
                                    @foreach (var c in _containers) { <option value="@c.Id">@c.Label</option> }
                                </select>
                            </div>

                            <div class="xd-prop">
                                <label>Variables (se usan como {{Nombre}} en los scripts)</label>
                                <div class="xd-var-list">
                                    @foreach (var v in flow.Variables)
                                    {
                                        <div class="xd-var-row">
                                            <span class="xd-var-name">@v.Name</span>
                                            <span class="xd-var-value">@(v.IsSecret ? "********" : (v.HasValue ? "(con valor)" : "(vacia)"))</span>
                                            @if (v.IsSecret) { <span class="xd-lock" title="Secreta (cifrada)">&#128274;</span> }
                                            <button class="xd-icon-btn" title="Editar" @onclick="() => OpenVarEditorFor(v)">&#9998;</button>
                                            <button class="xd-icon-btn" title="Eliminar" @onclick="() => DeleteVariableAsync(v.Id)">&times;</button>
                                        </div>
                                    }
                                    @if (!_showVarEditor)
                                    {
                                        <div class="xd-var-add" @onclick="OpenVarEditor">+ Nueva variable</div>
                                    }
                                </div>
                            </div>

                            @if (_showVarEditor)
                            {
                                <div class="xd-modal-backdrop" @onclick="() => _showVarEditor = false">
                                  <div class="xd-modal" @onclick:stopPropagation="true">
                                    <div class="xd-modal-head">
                                        <div class="xd-card-title" style="font-size:14px;">@(_vEditId is null ? "Nueva variable" : "Editar variable")</div>
                                        <button class="xd-icon-btn" title="Cerrar" @onclick="() => _showVarEditor = false">&times;</button>
                                    </div>
                                    <div class="xd-modal-body">
                                        <div class="xd-prop"><label>Nombre</label><input class="xd-input" placeholder="USER" @bind="_vName" /></div>
                                        <div class="xd-prop">
                                            <label>Valor</label>
                                            <input class="xd-input" type="@(_vSecret ? "password" : "text")" placeholder="@(_vEditId is null ? "" : "Dejar vacio para conservar el valor actual")" @bind="_vValue" />
                                        </div>
                                        <label class="xd-check"><input type="checkbox" @bind="_vSecret" /> Secreta (se cifra y no se puede consultar)</label>
                                        @if (_vEditId is not null)
                                        {
                                            <div style="font-size:11.5px;color:var(--ink-3);margin:2px 0 0;">Si cambias el tipo (secreta/no), reingresa el valor.</div>
                                        }
                                        @if (_varError is not null) { <div class="xd-error-box">@_varError</div> }
                                        <div class="xd-props-actions">
                                            <button class="xd-btn primary" @onclick="SaveVariableAsync" disabled="@_busy">Guardar</button>
                                            <button class="xd-btn" @onclick="() => _showVarEditor = false">Cancelar</button>
                                        </div>
                                    </div>
                                  </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>

                @* ===== Programacion (Ola 5: reusa ImportProcess/recurrencia) ===== *@
                <div class="xd-card">
                    <div class="xd-card-head">
                        <div class="xd-card-title">Programacion</div>
                        @if (_schedule?.NextRunAt is DateTimeOffset nr && (_schedule?.IsActive ?? false))
                        {
                            <span class="xd-pill ok"><span class="d"></span>Proxima: @nr.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        }
                        else
                        {
                            <span class="xd-pill wait"><span class="d"></span>@(_schedule is null ? "Sin programar" : "Manual/inactiva")</span>
                        }
                    </div>
                    <div class="xd-props-body">
                        <div class="xd-prop">
                            <label>Recurrencia</label>
                            <select class="xd-input" @bind="_schKind">
                                <option value="@ImportScheduleKind.Manual">Manual (solo con el boton)</option>
                                <option value="@ImportScheduleKind.Interval">Cada N minutos</option>
                                <option value="@ImportScheduleKind.Cron">Cron</option>
                            </select>
                        </div>
                        @if (_schKind == ImportScheduleKind.Interval)
                        {
                            <div class="xd-prop"><label>Minutos entre corridas</label>
                                <input class="xd-input" type="number" min="1" @bind="_schInterval" /></div>
                        }
                        else if (_schKind == ImportScheduleKind.Cron)
                        {
                            <div class="xd-prop"><label>Expresion cron (zona del tenant)</label>
                                <input class="xd-input mono" placeholder="0 */6 * * *" @bind="_schCron" /></div>
                        }
                        <label class="xd-check"><input type="checkbox" @bind="_schActive" /> Activa (el horario dispara sola)</label>
                        @if (_schedule?.DisabledReason is { } dr) { <div class="xd-error-box">Desactivada: @dr</div> }
                        @if (_schError is not null) { <div class="xd-error-box">@_schError</div> }
                        <div class="xd-props-actions">
                            <button class="xd-btn primary" @onclick="SaveScheduleAsync" disabled="@_busy">Guardar programacion</button>
                        </div>
                        <div class="xd-help">La corrida programada la ejecuta el mismo agente asignado; si esta
                            offline queda esperando y se reintenta al reconectar. Requiere un agente asignado.</div>
                    </div>
                </div>

                @* ===== Historial de corridas (bitacora, Ola 3) ===== *@
                <div class="xd-card">
                    <div class="xd-card-head">
                        <div class="xd-card-title">Historial de corridas <span class="xd-num-badge">@_runs.Count</span></div>
                    </div>
                    @if (_runs.Count == 0)
                    {
                        <div class="xd-card-empty">Aun no se ha ejecutado. Pulsa "Ejecutar ahora" para lanzar el flujo.</div>
                    }
                    else
                    {
                        <div class="xd-table-wrap">
                            <table class="xd-exec-table">
                                <thead>
                                    <tr><th>Disparo</th><th>Estado</th><th>Cuando</th><th>Duracion</th><th class="num">Filas</th><th>Detalle</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in _runs)
                                    {
                                        <tr>
                                            <td>@(r.Trigger == ImportRunTrigger.Manual ? "Manual" : "Horario")</td>
                                            <td><span class="xd-pill @RunPillClass(r.Result)"><span class="d"></span>@RunLabel(r.Result)</span></td>
                                            <td>@r.FiredAt.ToLocalTime().ToString("dd MMM HH:mm:ss")</td>
                                            <td>@RunDuration(r)</td>
                                            <td class="num">@(r.Result == ImportRunResult.Ok ? r.Inserted.ToString() : "-")</td>
                                            <td title="@r.Detail">@Shorten(r.Detail, 80)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

@code {
    private IReadOnlyList<ScrapeFlowSummaryDto> _flows = Array.Empty<ScrapeFlowSummaryDto>();
    private IReadOnlyList<DataClientDto> _clients = Array.Empty<DataClientDto>();
    private IReadOnlyList<ScrapeTargetDto> _containers = Array.Empty<ScrapeTargetDto>();
    private IReadOnlyList<AiProviderOptionDto> _aiProviders = Array.Empty<AiProviderOptionDto>();
    private IReadOnlyList<ScrapeFlowRunDto> _runs = Array.Empty<ScrapeFlowRunDto>();
    private ScrapeScheduleDto? _schedule;
    private ImportScheduleKind _schKind = ImportScheduleKind.Manual;
    private int _schInterval = 60;
    private string _schCron = "";
    private bool _schActive = true;
    private string? _schError;
    private ScrapeFlowDto? _selected;
    private bool _isNew;
    private bool _busy;
    private string _search = "";
    private string? _flash;
    private bool _flashError;
    private Guid _actor;

    // Cabecera
    private bool _editHeader;
    private string? _headError;
    private string _hName = "";
    private string _hDesc = "";
    private string _hUrl = "";
    private ScrapeSourceStatus _hStatus = ScrapeSourceStatus.Active;
    private string _hClient = "";
    private string _hContainer = "";
    private string _hPageVar = "";
    private int? _hPageFrom;
    private int? _hPageTo;

    // Agente colmena: aqui solo se ELIGE y se prueba la conexion. El alta/rotacion vive en el modulo
    // propio "Agentes Colmena" (ADR-0045, Ola 4).
    private (bool Online, string Text)? _probe;

    // Editor de paso
    private bool _showStepEditor;
    private Guid? _editingStepId;
    private string? _stepError;
    private ScrapeStepKind _sKind = ScrapeStepKind.Navigate;
    private string _sName = "";
    private string _sUrl = "";
    private string _sScript = "";
    private string _sSelector = "";
    private string _sWaitMs = "";
    private string _sMappingJson = "";
    private string _sInstruction = "";
    private string _sTargetContainer = "";
    private string _sToolAllow = "";
    private string _sMaxSteps = "";
    private string _sMaxSeconds = "";
    private string _sAiProviderId = "";
    private string _sWarnLabel = "";
    private ScrapeWarningAction _sWarnAction = ScrapeWarningAction.None;
    private string _sOutputVar = "";
    private string _sLoopOverVar = "";
    private bool _sIsLoopEnd;
    private string _sIngestPath = "";
    private string _sIngestKeyColumn = "";
    private string _sPageCountVar = "";
    private bool _sIsPageNext;
    private string _sRuleId = "";
    private string _sRuleInputVar = "";
    private IReadOnlyList<ScrapeRuleOptionDto> _rules = Array.Empty<ScrapeRuleOptionDto>();

    // Paso "Leer token de correo" (LeerCorreoOtp): su config va serializada en MappingJson.
    private List<OtpMailboxDto> _buzones = new();
    private string _sOtpMailbox = "";
    private string _sOtpFrom = "";
    private string _sOtpSubject = "";
    private string _sOtpRegex = @"\b(\d{4,8})\b";
    private string _sOtpVar = "TOKEN";
    private string _sOtpTimeout = "120";
    private OtpReadResult? _otpTest;

    // Paso "Ingesta NEWTON" (IngestaNewton): su config va serializada en MappingJson.
    private string _nwUrlVar = "NEWTON_URL";
    private string _nwTokenVar = "NEWTON_TOKEN";
    private string _nwCarpetaVar = "RutaDescargaNewton";
    private int _nwDiasAtras = 45;
    private bool _nwBajarXml = true;
    private bool _nwBajarPdf = true;
    private int _nwMax = 0;
    private bool _nwSoloNuevos = true;
    private bool _nwMarcarPlataforma = true;

    // Editor de variable
    private bool _showVarEditor;
    private Guid? _vEditId;
    private string? _varError;
    private string _vName = "";
    private string _vValue = "";
    private bool _vSecret = true;

    private List<ScrapeFlowSummaryDto> FilteredFlows =>
        string.IsNullOrWhiteSpace(_search)
            ? _flows.ToList()
            : _flows.Where(f => f.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actor = Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
        _clients = await ConfigSvc.ListClientsAsync();
        _containers = await FlowSvc.ListContainersAsync();
        _rules = await FlowSvc.ListRulesAsync();
        _aiProviders = await AiSvc.ListEnabledAsync();
        _buzones = (await OtpSvc.ListAsync()).ToList();
        await ReloadFlowsAsync();
    }

    private async Task ReloadFlowsAsync() => _flows = await FlowSvc.ListAsync();

    // Elegir un flujo distinto desde el sidebar: reinicia el paso a paso (cursor + resultado) antes de cargar.
    private async Task PickFlowAsync(Guid id)
    {
        if (_selected?.Id != id) { _stepCursor = 0; _stepResult = null; }
        await SelectFlowAsync(id);
    }

    private async Task SelectFlowAsync(Guid id)
    {
        _isNew = false;
        _editHeader = false;
        _showStepEditor = false;
        _showVarEditor = false;
        _selected = await FlowSvc.GetAsync(id);
        if (_selected is not null)
        {
            _hClient = _selected.ClientId?.ToString() ?? "";
            _hContainer = _selected.ContainerId?.ToString() ?? "";
            _runs = await FlowSvc.ListRunsAsync(id);
            _schedule = await FlowSvc.GetScheduleAsync(id);
            _schError = null;
            if (_schedule is not null)
            {
                _schKind = _schedule.Kind;
                _schInterval = _schedule.IntervalMinutes ?? 60;
                _schCron = _schedule.CronExpression ?? "";
                _schActive = _schedule.IsActive;
            }
            else { _schKind = ImportScheduleKind.Manual; _schInterval = 60; _schCron = ""; _schActive = true; }
        }
        else { _runs = Array.Empty<ScrapeFlowRunDto>(); _schedule = null; }
    }

    private async Task SaveScheduleAsync()
    {
        if (_selected is null) { return; }
        _schError = null;
        _busy = true;
        try
        {
            _schedule = await FlowSvc.SaveScheduleAsync(new SaveScrapeScheduleRequest(
                _selected.Id, _schKind,
                _schKind == ImportScheduleKind.Interval ? _schInterval : null,
                _schKind == ImportScheduleKind.Cron ? NullIfBlank(_schCron) : null,
                _schActive), _actor);
            Flash("Programacion guardada.");
        }
        catch (Exception ex) { _schError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RunFlowAsync()
    {
        if (_selected is null) { return; }
        if (Tenant.TenantId is not Guid tenantId) { Flash("No se pudo resolver el tenant.", true); return; }
        _busy = true;
        try
        {
            var result = await RunSvc.RunFlowNowAsync(_selected.Id, tenantId, ImportRunTrigger.Manual);
            if (result.Offline)
            {
                Flash("El agente asignado no esta en linea. La corrida quedo esperando a que vuelva.");
            }
            else if (!result.Dispatched)
            {
                Flash(result.Error ?? "No se pudo ejecutar el flujo.", true);
            }
            else
            {
                Flash("Flujo despachado al agente. El resultado aparecera en el historial al completarse.");
            }
            // Recarga la bitacora y el flujo (LastRunAt/estado pudieron cambiar).
            await SelectFlowAsync(_selected.Id);
            await ReloadFlowsAsync();
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { _busy = false; }
    }

    // ---- Paso a paso (sesion viva) ----

    private int _stepCursor;
    private StepRunResult? _stepResult;

    private async Task RunStepAsync(ScrapeStepDto s, int index)
    {
        await ExecStepCore(s);
        // El cursor avanza al siguiente del paso que se corrio (asi "Ejecutar siguiente" continua desde aqui).
        _stepCursor = Math.Min(index + 1, _selected?.Steps.Count ?? index + 1);
    }

    private async Task RunNextStepAsync()
    {
        if (_selected is null || _stepCursor < 0 || _stepCursor >= _selected.Steps.Count) { return; }
        var s = _selected.Steps.ElementAt(_stepCursor);
        await ExecStepCore(s);
        _stepCursor = Math.Min(_stepCursor + 1, _selected.Steps.Count);
    }

    private void ResetCursor() { _stepCursor = 0; _stepResult = null; }

    private async Task RunLoopAsync(ScrapeStepDto s)
    {
        if (_selected is null) { return; }
        if (Tenant.TenantId is not Guid tenantId) { Flash("No se pudo resolver el tenant.", true); return; }
        _busy = true; _stepResult = null;
        var flowId = _selected.Id;
        try
        {
            _stepResult = await RunSvc.RunLoopNowAsync(flowId, s.Id, tenantId);
            if (_stepResult.Offline) { Flash("El agente no esta en linea. Conectalo contra este servidor y reintenta.", true); }
            else if (!_stepResult.Ok) { Flash(_stepResult.Error ?? "El bucle fallo.", true); }
            else { Flash($"Bucle \"{s.Name}\": {_stepResult.Detail}"); }
            await SelectFlowAsync(flowId);
            await ReloadFlowsAsync();
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task ExecStepCore(ScrapeStepDto s)
    {
        if (_selected is null) { return; }
        if (Tenant.TenantId is not Guid tenantId) { Flash("No se pudo resolver el tenant.", true); return; }
        _busy = true; _stepResult = null;
        var flowId = _selected.Id;
        try
        {
            _stepResult = await RunSvc.RunStepNowAsync(flowId, s.Id, tenantId);
            if (_stepResult.Offline) { Flash("El agente no esta en linea. Conectalo contra este servidor y reintenta.", true); }
            else if (!_stepResult.Ok) { Flash(_stepResult.Error ?? "El paso fallo.", true); }
            else { Flash($"Paso \"{s.Name}\": {_stepResult.Detail}"); }
            // Refresca la bitacora/flujo (cada paso queda registrado), preservando el resultado y el cursor.
            await SelectFlowAsync(flowId);
            await ReloadFlowsAsync();
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task CloseLiveSessionAsync()
    {
        if (_selected is null) { return; }
        if (Tenant.TenantId is not Guid tenantId) { return; }
        _busy = true;
        try
        {
            var r = await RunSvc.CloseStepSessionAsync(_selected.Id, tenantId);
            Flash(r.Detail ?? "Navegador cerrado.");
            _stepResult = null; _stepCursor = 0;
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { _busy = false; }
    }

    private void NewFlow()
    {
        _isNew = true;
        _selected = null;
        _headError = null;
        _hName = ""; _hUrl = "";
    }

    private void CancelNew() => _isNew = false;

    private async Task CreateFlowAsync()
    {
        _headError = null;
        _busy = true;
        try
        {
            var saved = await FlowSvc.SaveFlowAsync(new SaveScrapeFlowRequest(
                null, _hName, null, _hUrl, ScrapeSourceStatus.Active, null, null), _actor);
            if (saved is null) { _headError = "No se pudo crear."; return; }
            await ReloadFlowsAsync();
            _isNew = false;
            await SelectFlowAsync(saved.Id);
            Flash("Flujo creado.");
        }
        catch (Exception ex) { _headError = ex.Message; }
        finally { _busy = false; }
    }

    private void ToggleHeaderEdit()
    {
        _editHeader = !_editHeader;
        if (_editHeader && _selected is not null)
        {
            _hName = _selected.Name; _hDesc = _selected.Description ?? "";
            _hUrl = _selected.StartUrl; _hStatus = _selected.Status;
            _hPageVar = _selected.PageVar ?? ""; _hPageFrom = _selected.PageFrom; _hPageTo = _selected.PageTo;
        }
    }

    private async Task SaveHeaderAsync()
    {
