        _busy = true;
        try
        {
            var res = await FlowSvc.ExportStepsAsync(_selected.Id);
            if (res is null) { Flash("No se encontro el flujo.", true); return; }
            var text = System.Text.Encoding.UTF8.GetString(res.Bytes);
            await JS.InvokeVoidAsync("ecorexMenuConfig.downloadText", res.FileName, text, "application/json;charset=utf-8");
            Flash($"Exportados {_selected.Steps.Count} paso(s).");
        }
        catch (Exception ex) { Flash("No se pudo exportar: " + ex.Message, true); }
        finally { _busy = false; }
    }

    // El operador elige el archivo: se lee y queda en espera de confirmacion (la importacion REEMPLAZA los pasos).
    private async Task OnImportStepsSelected(InputFileChangeEventArgs e)
    {
        _importWarnings = Array.Empty<string>();
        var file = e.File;
        if (file is null) { return; }
        if (file.Size > 8 * 1024 * 1024) { Flash("El archivo es demasiado grande (max 8 MB).", true); return; }
        try
        {
            using var stream = file.OpenReadStream(8 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _importJson = await reader.ReadToEndAsync();
            _importFileName = file.Name;
        }
        catch (Exception ex) { _importJson = null; _importFileName = null; Flash("No se pudo leer el archivo: " + ex.Message, true); }
    }

    private void CancelImportSteps() { _importJson = null; _importFileName = null; }

    private async Task ConfirmImportStepsAsync()
    {
        if (_selected is null || _importJson is null) { return; }
        _busy = true;
        try
        {
            var res = await FlowSvc.ImportStepsAsync(_selected.Id, _importJson, _actor);
            if (!res.Ok) { Flash(res.Error ?? "No se pudo importar.", true); return; }
            _importWarnings = res.Warnings;
            var msg = $"Importados {res.Imported} paso(s); se reemplazaron {res.Replaced}.";
            if (res.Warnings.Count > 0) { msg += $" {res.Warnings.Count} aviso(s) de referencias no resueltas (ver abajo)."; }
            Flash(msg, res.Warnings.Count > 0);
            _importJson = null; _importFileName = null;
            _stepCursor = 0; _stepResult = null;
            await SelectFlowAsync(_selected.Id); // recarga los pasos ya importados
        }
        catch (Exception ex) { Flash("No se pudo importar: " + ex.Message, true); }
        finally { _busy = false; }
    }

