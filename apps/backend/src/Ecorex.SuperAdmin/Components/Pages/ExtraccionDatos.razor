    // Muestra los codigos de campo del formulario del concepto elegido (ayuda para el mapeo).
    private async Task LoadCaFormFieldsAsync()
    {
        _caFormFields = "";
        if (!Guid.TryParse(_caSub, out var sid)) { return; }
        var fid = _caConceptos.FirstOrDefault(c => c.Id == sid)?.FormDefinitionId;
        if (fid is not Guid f) { _caFormFields = "(el concepto no tiene formulario)"; return; }
        try
        {
            var def = await FormDefs.GetAsync(f);
            if (def is null) { return; }
            _caFormFields = string.Join(", ", def.Questions.OrderBy(q => q.SortOrder)
                .Select(q => q.ControlType == FormControlType.GridDetail ? $"{q.FieldCode} [grilla: {GridColumnIds(q.OptionsJson)}]" : q.FieldCode));
        }
        catch { /* solo ayuda */ }
    }

    private static string GridColumnIds(string? optionsJson)
    {
        if (string.IsNullOrWhiteSpace(optionsJson)) { return ""; }
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(optionsJson);
            return string.Join(", ", doc.RootElement.EnumerateArray()
                .Select(e => e.TryGetProperty("id", out var id) ? id.GetString() : null).Where(x => !string.IsNullOrEmpty(x)));
        }
        catch { return ""; }
    }

    private void LoadCaConfig(ScrapeStepDto? s)
    {
        _caSub = _caTitulo = _caDesc = _caClave = _caCont = _caColClave = _caColTarea = "";
        _caResp = _caSolic = _caDoc = _caCampos = _caGrilla = _caItems = _caCols = "";
        _caSaltarRuta = _caSaltarValor = _caFormFields = "";
        _caVence = _caFijos = _caPrellenado = "";
        if (s?.Kind != ScrapeStepKind.CrearActividad) { return; }
        var cfg = ScrapeCrearActividad.Parse(s.MappingJson);
        if (cfg is null) { return; }
        var pretty = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
        _caSub = cfg.SubcategoriaId?.ToString() ?? "";
        _caTitulo = cfg.Titulo ?? ""; _caDesc = cfg.Descripcion ?? ""; _caClave = cfg.Clave ?? "";
        _caCont = cfg.ContenedorId?.ToString() ?? ""; _caColClave = cfg.ColumnaClave ?? ""; _caColTarea = cfg.ColumnaTarea ?? "";
        _caResp = cfg.ResponsableId?.ToString() ?? ""; _caSolic = cfg.Solicitante ?? ""; _caDoc = cfg.DocumentoSolicitante ?? "";
        _caCampos = cfg.Campos is { Count: > 0 } ? System.Text.Json.JsonSerializer.Serialize(cfg.Campos, pretty) : "";
        _caGrilla = cfg.GrillaCampo ?? ""; _caItems = cfg.ItemsRuta ?? "";
        _caCols = cfg.GrillaColumnas is { Count: > 0 } ? System.Text.Json.JsonSerializer.Serialize(cfg.GrillaColumnas, pretty) : "";
        _caSaltarRuta = cfg.SaltarSiRuta ?? ""; _caSaltarValor = cfg.SaltarSiValor ?? "";
        _caVence = cfg.Vencimiento ?? "";
        _caFijos = cfg.CamposFijos is { Count: > 0 } ? System.Text.Json.JsonSerializer.Serialize(cfg.CamposFijos, pretty) : "";
        _caPrellenado = cfg.Prellenado is not null
            ? System.Text.Json.JsonSerializer.Serialize(cfg.Prellenado, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web) { WriteIndented = true, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull })
            : "";
    }

    // Arma la config del paso "Crear actividad" desde el editor. Devuelve null y fija _stepError si algo no cuadra.
    private string? BuildCaMappingJson()
    {
        if (!Guid.TryParse(_caSub, out var sub)) { _stepError = "Elige el concepto de la actividad."; return null; }
        if (string.IsNullOrWhiteSpace(_caClave)) { _stepError = "Indica la clave del registro (ej. DETALLE.cabecera.petof)."; return null; }
        Dictionary<string, string>? campos = null, cols = null, fijos = null;
        ScrapeCrearActividad.PrellenadoConfig? prellenado = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(_caCampos)) { campos = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(_caCampos); }
            if (!string.IsNullOrWhiteSpace(_caCols)) { cols = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(_caCols); }
            if (!string.IsNullOrWhiteSpace(_caFijos)) { fijos = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(_caFijos); }
            if (!string.IsNullOrWhiteSpace(_caPrellenado))
            {
                prellenado = System.Text.Json.JsonSerializer.Deserialize<ScrapeCrearActividad.PrellenadoConfig>(_caPrellenado,
                    new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            }
        }
        catch (System.Text.Json.JsonException ex) { _stepError = "JSON invalido en el mapeo: " + ex.Message; return null; }
        return ScrapeCrearActividad.Serialize(new ScrapeCrearActividad.Config
        {
            SubcategoriaId = sub,
            Titulo = NullIfBlank(_caTitulo), Descripcion = NullIfBlank(_caDesc), Clave = NullIfBlank(_caClave),
            ContenedorId = ParseGuid(_caCont), ColumnaClave = NullIfBlank(_caColClave), ColumnaTarea = NullIfBlank(_caColTarea),
            ResponsableId = ParseGuid(_caResp), Solicitante = NullIfBlank(_caSolic), DocumentoSolicitante = NullIfBlank(_caDoc),
            Campos = campos, GrillaCampo = NullIfBlank(_caGrilla), ItemsRuta = NullIfBlank(_caItems), GrillaColumnas = cols,
            SaltarSiRuta = NullIfBlank(_caSaltarRuta), SaltarSiValor = NullIfBlank(_caSaltarValor),
            Vencimiento = NullIfBlank(_caVence), CamposFijos = fijos, Prellenado = prellenado,
        });
    }

    private void LoadStepIntoEditor(ScrapeStepDto? s)
    {
        _stepError = null;
        _showStepEditor = true;
        _editingStepId = s?.Id;
        _sKind = s?.Kind ?? ScrapeStepKind.Navigate;
        _sName = s?.Name ?? "";
        _sUrl = s?.Url ?? "";
        _sScript = s?.Script ?? "";
        _sSelector = s?.Selector ?? "";
        _sWaitMs = s?.WaitMs?.ToString() ?? "";
        _sMappingJson = s?.MappingJson ?? "";
        _sInstruction = s?.Instruction ?? "";
        _sTargetContainer = s?.TargetContainerId?.ToString() ?? "";
        _sToolAllow = "";
        _sMaxSteps = s?.MaxSteps?.ToString() ?? "";
        _sMaxSeconds = s?.MaxSeconds?.ToString() ?? "";
        _sAiProviderId = s?.AiProviderId?.ToString() ?? "";
        _sWarnLabel = s?.WarningLabel ?? "";
        _sWarnAction = s?.WarningAction ?? ScrapeWarningAction.None;
        _sOutputVar = s?.OutputVar ?? "";
        _sLoopOverVar = s?.LoopOverVar ?? "";
        _sIsLoopEnd = s?.IsLoopEnd ?? false;
        _sIngestPath = s?.IngestPath ?? "";
        _sIngestKeyColumn = s?.IngestKeyColumn ?? "";
        _sPageCountVar = s?.PageCountVar ?? "";
        _sIsPageNext = s?.IsPageNext ?? false;
        _sRuleId = s?.RuleId?.ToString() ?? "";
        _sRuleInputVar = s?.RuleInputVar ?? "";

        // Paso "Leer token de correo": su config vive en MappingJson.
        _otpTest = null;
        _sOtpMailbox = ""; _sOtpFrom = ""; _sOtpSubject = ""; _sOtpRegex = @"\b(\d{4,8})\b"; _sOtpVar = "TOKEN"; _sOtpTimeout = "120"; _sOtpUrlDecode = false;
        if (s?.Kind == ScrapeStepKind.LeerCorreoOtp && !string.IsNullOrWhiteSpace(s.MappingJson))
        {
            try
            {
                var cfg = System.Text.Json.JsonSerializer.Deserialize<OtpStepConfig>(s.MappingJson!);
                if (cfg is not null)
                {
                    _sOtpMailbox = cfg.MailboxId?.ToString() ?? "";
                    _sOtpFrom = cfg.From ?? "";
                    _sOtpSubject = cfg.Subject ?? "";
                    _sOtpRegex = string.IsNullOrWhiteSpace(cfg.Regex) ? _sOtpRegex : cfg.Regex!;
                    _sOtpVar = string.IsNullOrWhiteSpace(cfg.Variable) ? "TOKEN" : cfg.Variable!;
                    _sOtpTimeout = (cfg.TimeoutSeconds > 0 ? cfg.TimeoutSeconds : 120).ToString();
                    _sOtpUrlDecode = cfg.UrlDecode;
                }
            }
            catch { /* json viejo/otra cosa: se deja el default */ }
        }

        // Paso "Ingesta NEWTON": su config vive en MappingJson.
        _nwUrlVar = "NEWTON_URL"; _nwTokenVar = "NEWTON_TOKEN"; _nwCarpetaVar = "RutaDescargaNewton";
        _nwDiasAtras = 45; _nwBajarXml = true; _nwBajarPdf = true; _nwMax = 0; _nwSoloNuevos = true; _nwMarcarPlataforma = true; _nwReflejarEventos = true; _nwSubirBlob = true;
        if (s?.Kind == ScrapeStepKind.IngestaNewton && !string.IsNullOrWhiteSpace(s.MappingJson))
        {
            try
            {
                var cfg = System.Text.Json.JsonSerializer.Deserialize<NewtonStepConfig>(s.MappingJson!,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (cfg is not null)
                {
                    _nwUrlVar = string.IsNullOrWhiteSpace(cfg.UrlVar) ? "NEWTON_URL" : cfg.UrlVar!;
                    _nwTokenVar = string.IsNullOrWhiteSpace(cfg.TokenVar) ? "NEWTON_TOKEN" : cfg.TokenVar!;
                    _nwCarpetaVar = string.IsNullOrWhiteSpace(cfg.CarpetaVar) ? "RutaDescargaNewton" : cfg.CarpetaVar!;
                    _nwDiasAtras = cfg.DiasAtras > 0 ? cfg.DiasAtras : 45;
                    _nwBajarXml = cfg.BajarXml; _nwBajarPdf = cfg.BajarPdf; _nwMax = cfg.Max; _nwSoloNuevos = cfg.SoloNuevos;
                    _nwMarcarPlataforma = cfg.MarcarPlataforma;
                    _nwReflejarEventos = cfg.ReflejarEventos;
                    _nwSubirBlob = cfg.SubirABlob;
                }
            }
            catch { /* json viejo/otra cosa: se deja el default */ }
        }

        // Paso "Procesar archivos descargados": su config vive en MappingJson.
        _paCfg = new();
        _paCarpeta = ""; _paMoverProcesados = true; _paSubirBlob = true; _paAutoImportar = true; _paForzarViaAgente = false;
        if (s?.Kind == ScrapeStepKind.ProcesarArchivos && !string.IsNullOrWhiteSpace(s.MappingJson))
        {
            try
            {
                var cfg = System.Text.Json.JsonSerializer.Deserialize<ProcArchStepConfig>(s.MappingJson!,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (cfg is not null)
                {
                    _paCfg = cfg;
                    _paCarpeta = cfg.Carpeta ?? "";
                    _paMoverProcesados = cfg.MoverProcesados;
                    _paSubirBlob = cfg.SubirABlob;
                    _paAutoImportar = cfg.AutoImportar;
                    _paForzarViaAgente = cfg.ForzarViaAgente;
                }
            }
            catch { /* json viejo/otra cosa: se deja el default */ }
        }
    }

    private sealed record OtpStepConfig(Guid? MailboxId, string? From, string? Subject, string? Regex, string? Variable, int TimeoutSeconds, bool UrlDecode = false);

    private sealed record NewtonStepConfig(
        string? UrlVar = "NEWTON_URL", string? TokenVar = "NEWTON_TOKEN", string? CarpetaVar = "RutaDescargaNewton",
        string? Carpeta = null, int DiasAtras = 45, bool BajarXml = true, bool BajarPdf = true, int Max = 0,
        bool SoloNuevos = true, bool MarcarPlataforma = true, bool ReflejarEventos = true, bool SubirABlob = true);

