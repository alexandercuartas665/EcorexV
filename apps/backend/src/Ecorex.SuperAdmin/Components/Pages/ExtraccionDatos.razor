    private void LoadNtConfig(ScrapeStepDto? s)
    {
        _ntTarea = _ntLinea = _ntPlantillaSel = _ntVars = _ntGrupo = _ntChat = _ntAsunto = _ntMensaje = _ntTelefonos = "";
        _ntSoloNueva = true; _ntEnlace = true;
        _ntCanal = ScrapeNotificar.Canal.Campana; _ntDestino = ScrapeNotificar.Destino.Responsable;
        _ntUsuarios = new();
        if (s?.Kind != ScrapeStepKind.Notificar) { return; }
        var cfg = ScrapeNotificar.Parse(s.MappingJson);
        if (cfg is null) { return; }
        _ntTarea = cfg.Tarea ?? ""; _ntSoloNueva = cfg.SoloSiNueva; _ntCanal = cfg.Canal; _ntDestino = cfg.Destino;
        _ntUsuarios = cfg.UsuarioIds?.ToHashSet() ?? new();
        _ntLinea = cfg.LineaId?.ToString() ?? "";
        _ntPlantillaSel = string.IsNullOrWhiteSpace(cfg.Plantilla) ? "" : $"{cfg.Plantilla}|{cfg.Idioma}";
        _ntVars = cfg.Variables is { Count: > 0 } ? System.Text.Json.JsonSerializer.Serialize(cfg.Variables, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }) : "";
        _ntGrupo = cfg.GrupoJid ?? ""; _ntChat = cfg.ChatId ?? ""; _ntAsunto = cfg.Asunto ?? ""; _ntMensaje = cfg.Mensaje ?? "";
        _ntEnlace = cfg.IncluirEnlace;
        _ntTelefonos = cfg.Telefonos is { Count: > 0 } ? string.Join("\n", cfg.Telefonos) : "";
    }

    // Arma la config del paso "Notificar". Devuelve null y fija _stepError si algo no cuadra.
    private string? BuildNtMappingJson()
    {
        Dictionary<string, string>? vars = null;
        try { if (!string.IsNullOrWhiteSpace(_ntVars)) { vars = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(_ntVars); } }
        catch (System.Text.Json.JsonException ex) { _stepError = "JSON invalido en las variables: " + ex.Message; return null; }
        var parts = (_ntPlantillaSel ?? "").Split('|');
        var cfg = new ScrapeNotificar.Config
        {
            Tarea = NullIfBlank(_ntTarea), SoloSiNueva = _ntSoloNueva, Canal = _ntCanal, Destino = _ntDestino,
            UsuarioIds = _ntDestino == ScrapeNotificar.Destino.Usuarios ? _ntUsuarios.ToList() : null,
            LineaId = ParseGuid(_ntLinea),
            Plantilla = parts.Length == 2 ? parts[0] : null, Idioma = parts.Length == 2 ? parts[1] : null,
            Variables = vars, GrupoJid = NullIfBlank(_ntGrupo), ChatId = NullIfBlank(_ntChat),
            Asunto = NullIfBlank(_ntAsunto), Mensaje = NullIfBlank(_ntMensaje), IncluirEnlace = _ntEnlace,
            Telefonos = _ntCanal == ScrapeNotificar.Canal.WhatsApp && ScrapeNotificar.SplitPhones(_ntTelefonos) is { Count: > 0 } tels ? tels : null,
        };
        if (cfg.Destino == ScrapeNotificar.Destino.Numeros && cfg.Canal != ScrapeNotificar.Canal.WhatsApp) { _stepError = "Solo numeros: aplica al canal WhatsApp."; return null; }
        var invalidos = (cfg.Telefonos ?? []).Where(t => ScrapeNotificar.NormalizePhone(t) is null).ToList();
        if (invalidos.Count > 0) { _stepError = "Numero(s) de WhatsApp invalido(s): " + string.Join(", ", invalidos); return null; }
        if (cfg.Destino == ScrapeNotificar.Destino.Numeros && cfg.Telefonos is not { Count: > 0 }) { _stepError = "Indica al menos un numero de WhatsApp."; return null; }
        if (cfg.Canal == ScrapeNotificar.Canal.WhatsApp && (cfg.LineaId is null || cfg.Plantilla is null)) { _stepError = "WhatsApp: elige la linea y la plantilla."; return null; }
        if (cfg.Canal == ScrapeNotificar.Canal.WhatsAppGrupo && (cfg.LineaId is null || cfg.GrupoJid is null)) { _stepError = "Grupo de WhatsApp: elige la linea y el grupo."; return null; }
        if (cfg.Canal == ScrapeNotificar.Canal.Telegram && cfg.ChatId is null) { _stepError = "Telegram: indica el chat."; return null; }
        if (cfg.Destino == ScrapeNotificar.Destino.Usuarios && cfg.UsuarioIds is not { Count: > 0 }
            && cfg.Canal is ScrapeNotificar.Canal.Campana or ScrapeNotificar.Canal.Correo or ScrapeNotificar.Canal.WhatsApp)
        { _stepError = "Elige al menos un usuario a notificar."; return null; }
        return ScrapeNotificar.Serialize(cfg);
    }

