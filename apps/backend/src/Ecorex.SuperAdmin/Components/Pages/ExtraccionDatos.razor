    // ---- Pasos ----

    private void OpenStepEditor(ScrapeStepDto? s)
    {
        _stepError = null;
        _showStepEditor = true;
        _editingStepId = s?.Id;
        _sKind = s?.Kind ?? ScrapeStepKind.Navigate;
        _sName = s?.Name ?? "";
        _sUrl = s?.Url ?? "";
        _sScript = s?.Script ?? "";
        _sSelector = s?.Selector ?? "";
        _sWaitMs = s?.WaitMs?.ToString() ?? "";
        _sMappingJson = s?.MappingJson ?? "";
        _sInstruction = s?.Instruction ?? "";
        _sTargetContainer = s?.TargetContainerId?.ToString() ?? "";
        _sToolAllow = "";
        _sMaxSteps = s?.MaxSteps?.ToString() ?? "";
        _sMaxSeconds = s?.MaxSeconds?.ToString() ?? "";
        _sAiProviderId = s?.AiProviderId?.ToString() ?? "";
        _sWarnLabel = s?.WarningLabel ?? "";
        _sWarnAction = s?.WarningAction ?? ScrapeWarningAction.None;
        _sOutputVar = s?.OutputVar ?? "";
        _sLoopOverVar = s?.LoopOverVar ?? "";
        _sIsLoopEnd = s?.IsLoopEnd ?? false;
        _sIngestPath = s?.IngestPath ?? "";
        _sIngestKeyColumn = s?.IngestKeyColumn ?? "";
        _sPageCountVar = s?.PageCountVar ?? "";
        _sIsPageNext = s?.IsPageNext ?? false;
        _sRuleId = s?.RuleId?.ToString() ?? "";
        _sRuleInputVar = s?.RuleInputVar ?? "";

        // Paso "Leer token de correo": su config vive en MappingJson.
        _otpTest = null;
        _sOtpMailbox = ""; _sOtpFrom = ""; _sOtpSubject = ""; _sOtpRegex = @"\b(\d{4,8})\b"; _sOtpVar = "TOKEN"; _sOtpTimeout = "120";
        if (s?.Kind == ScrapeStepKind.LeerCorreoOtp && !string.IsNullOrWhiteSpace(s.MappingJson))
        {
            try
            {
                var cfg = System.Text.Json.JsonSerializer.Deserialize<OtpStepConfig>(s.MappingJson!);
                if (cfg is not null)
                {
                    _sOtpMailbox = cfg.MailboxId?.ToString() ?? "";
                    _sOtpFrom = cfg.From ?? "";
                    _sOtpSubject = cfg.Subject ?? "";
                    _sOtpRegex = string.IsNullOrWhiteSpace(cfg.Regex) ? _sOtpRegex : cfg.Regex!;
                    _sOtpVar = string.IsNullOrWhiteSpace(cfg.Variable) ? "TOKEN" : cfg.Variable!;
                    _sOtpTimeout = (cfg.TimeoutSeconds > 0 ? cfg.TimeoutSeconds : 120).ToString();
                }
            }
            catch { /* json viejo/otra cosa: se deja el default */ }
        }

        // Paso "Ingesta NEWTON": su config vive en MappingJson.
        _nwUrlVar = "NEWTON_URL"; _nwTokenVar = "NEWTON_TOKEN"; _nwCarpetaVar = "RutaDescargaNewton";
        _nwDiasAtras = 45; _nwBajarXml = true; _nwBajarPdf = true; _nwMax = 0; _nwSoloNuevos = true; _nwMarcarPlataforma = true;
        if (s?.Kind == ScrapeStepKind.IngestaNewton && !string.IsNullOrWhiteSpace(s.MappingJson))
        {
            try
            {
                var cfg = System.Text.Json.JsonSerializer.Deserialize<NewtonStepConfig>(s.MappingJson!,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (cfg is not null)
                {
                    _nwUrlVar = string.IsNullOrWhiteSpace(cfg.UrlVar) ? "NEWTON_URL" : cfg.UrlVar!;
                    _nwTokenVar = string.IsNullOrWhiteSpace(cfg.TokenVar) ? "NEWTON_TOKEN" : cfg.TokenVar!;
                    _nwCarpetaVar = string.IsNullOrWhiteSpace(cfg.CarpetaVar) ? "RutaDescargaNewton" : cfg.CarpetaVar!;
                    _nwDiasAtras = cfg.DiasAtras > 0 ? cfg.DiasAtras : 45;
                    _nwBajarXml = cfg.BajarXml; _nwBajarPdf = cfg.BajarPdf; _nwMax = cfg.Max; _nwSoloNuevos = cfg.SoloNuevos;
                    _nwMarcarPlataforma = cfg.MarcarPlataforma;
                }
            }
            catch { /* json viejo/otra cosa: se deja el default */ }
        }
    }

    private sealed record OtpStepConfig(Guid? MailboxId, string? From, string? Subject, string? Regex, string? Variable, int TimeoutSeconds);

    private sealed record NewtonStepConfig(
        string? UrlVar = "NEWTON_URL", string? TokenVar = "NEWTON_TOKEN", string? CarpetaVar = "RutaDescargaNewton",
        string? Carpeta = null, int DiasAtras = 45, bool BajarXml = true, bool BajarPdf = true, int Max = 0,
        bool SoloNuevos = true, bool MarcarPlataforma = true);

    private async Task ProbarOtpAsync()
    {
        if (!Guid.TryParse(_sOtpMailbox, out var mbId)) { return; }
        _busy = true; _otpTest = null;
        try { _otpTest = await OtpSvc.ProbarAsync(mbId, _sOtpFrom, _sOtpSubject, _sOtpRegex, ParseInt(_sOtpTimeout) ?? 60, 15); }
        catch (Exception ex) { _otpTest = new OtpReadResult(false, null, ex.Message); }
        finally { _busy = false; }
    }

    private async Task SaveStepAsync()
    {
        if (_selected is null) { return; }
        _stepError = null;
        _busy = true;
        try
        {
            var order = _editingStepId is null ? _selected.Steps.Count : _selected.Steps.First(x => x.Id == _editingStepId).Order;
            var toolJson = string.IsNullOrWhiteSpace(_sToolAllow) ? null
                : System.Text.Json.JsonSerializer.Serialize(_sToolAllow.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
            // Los pasos "Leer token de correo" y "Ingesta NEWTON" guardan su config en MappingJson.
            var mappingJson = _sKind == ScrapeStepKind.LeerCorreoOtp
                ? System.Text.Json.JsonSerializer.Serialize(new OtpStepConfig(
                    ParseGuid(_sOtpMailbox), NullIfBlank(_sOtpFrom), NullIfBlank(_sOtpSubject),
                    string.IsNullOrWhiteSpace(_sOtpRegex) ? @"\b(\d{4,8})\b" : _sOtpRegex.Trim(),
                    string.IsNullOrWhiteSpace(_sOtpVar) ? "TOKEN" : _sOtpVar.Trim(), ParseInt(_sOtpTimeout) ?? 120))
                : _sKind == ScrapeStepKind.IngestaNewton
                ? System.Text.Json.JsonSerializer.Serialize(new NewtonStepConfig(
                    NullIfBlank(_nwUrlVar), NullIfBlank(_nwTokenVar), NullIfBlank(_nwCarpetaVar), null,
                    _nwDiasAtras, _nwBajarXml, _nwBajarPdf, _nwMax, _nwSoloNuevos, _nwMarcarPlataforma))
                : NullIfBlank(_sMappingJson);
            var req = new SaveScrapeStepRequest(
                _editingStepId, _selected.Id, order, _sKind, _sName,
                WaitMs: ParseInt(_sWaitMs), Url: NullIfBlank(_sUrl), Script: NullIfBlank(_sScript),
                Selector: NullIfBlank(_sSelector), MappingJson: mappingJson,
                Instruction: NullIfBlank(_sInstruction), TargetContainerId: ParseGuid(_sTargetContainer),
                ToolAllowListJson: toolJson, MaxSteps: ParseInt(_sMaxSteps), MaxSeconds: ParseInt(_sMaxSeconds),
                AiProviderId: ParseGuid(_sAiProviderId), AiModel: null,
                WarningLabel: NullIfBlank(_sWarnLabel), WarningAction: _sWarnAction,
                OutputVar: NullIfBlank(_sOutputVar), LoopOverVar: NullIfBlank(_sLoopOverVar),
                IsLoopEnd: _sIsLoopEnd, IngestPath: NullIfBlank(_sIngestPath),
                IngestKeyColumn: NullIfBlank(_sIngestKeyColumn),
                PageCountVar: NullIfBlank(_sPageCountVar), IsPageNext: _sIsPageNext,
                RuleId: ParseGuid(_sRuleId), RuleInputVar: NullIfBlank(_sRuleInputVar));
            var saved = await FlowSvc.SaveStepAsync(req, _actor);
            if (saved is null) { _stepError = "No se pudo guardar el paso."; return; }
            _showStepEditor = false;
            await SelectFlowAsync(_selected.Id);
            await ReloadFlowsAsync();
        }
        catch (Exception ex) { _stepError = ex.Message; }
        finally { _busy = false; }
    }

