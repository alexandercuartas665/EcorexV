@page "/flujos"
@attribute [Authorize(Policy = "Flujos.Ver")]
@* Policy por modulo (paso 1: mismo requisito que TenantMember, nombre estable). TODO: derivar del Module Registry. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Ecorex.Application.Workflows
@using Ecorex.Application.Cards
@using Ecorex.Application.Marketplace
@using Ecorex.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IWorkflowDesignService DesignSvc
@inject ICardTagService TagSvc
@inject IMarketplaceService MarketSvc

@* ============================================================
   INDICE DE FLUJOS del prototipo (ECOREX.dc.html, pantalla
   'flujos'): rotulo de modulo, 4 KPIs, busqueda + tabs de filtro
   por cargo/categoria y tarjetas con metricas REALES (ADR-0022).
   Abrir una tarjeta abre el EDITOR canvas (modal grande).
   ============================================================ *@

<PageTitle>Flujos del proceso - ECOREX.tareas</PageTitle>

<div class="fl-page">
    <div class="fl-head">
        <div>
            <div class="fl-eyebrow">MODULO 000291 - AUTOMATIZACION</div>
            <h1 class="fl-title">Flujos del proceso</h1>
            <p class="fl-subtitle">Todos los flujos BPMN del sistema con sus indicadores de ejecucion. Abre uno para editarlo.</p>
        </div>
        <div class="fl-head-actions">
            <button class="fl-btn-ghost" @onclick="() => _showGallery = true" disabled="@_busy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/></svg>
                Galeria
            </button>
            <button class="fl-btn-new" @onclick="OpenNewFlow" disabled="@_busy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                Nuevo flujo
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="fl-error">@_error</div>
    }

    <div class="fl-kpis">
        <div class="fl-kpi">
            <div class="fl-kpi-ic" style="background:var(--t-violet-bg);color:var(--t-violet)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="6" height="6" rx="1.4"/><rect x="16" y="15" width="6" height="6" rx="1.4"/><path d="M5 9v3a4 4 0 0 0 4 4h7"/></svg>
            </div>
            <div class="fl-kpi-tx"><div class="fl-kpi-v">@(_index?.Kpis.Flows ?? 0)</div><div class="fl-kpi-l">Flujos</div></div>
        </div>
        <div class="fl-kpi">
            <div class="fl-kpi-ic" style="background:var(--t-green-bg);color:var(--t-green)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8 12 3 3 5-6"/></svg>
            </div>
            <div class="fl-kpi-tx"><div class="fl-kpi-v">@(_index?.Kpis.RunningFlows ?? 0)</div><div class="fl-kpi-l">En marcha</div></div>
        </div>
        <div class="fl-kpi">
            <div class="fl-kpi-ic" style="background:var(--t-blue-bg);color:var(--t-blue)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
            </div>
            <div class="fl-kpi-tx"><div class="fl-kpi-v">@(_index?.Kpis.ActiveInstances ?? 0)</div><div class="fl-kpi-l">Instancias activas</div></div>
        </div>
        <div class="fl-kpi">
            <div class="fl-kpi-ic" style="background:var(--t-amber-bg);color:var(--t-amber)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v16h16"/><rect x="7.5" y="11" width="3" height="6" rx="1"/><rect x="13.5" y="7" width="3" height="10" rx="1"/></svg>
            </div>
            <div class="fl-kpi-tx"><div class="fl-kpi-v">@N(_index?.Kpis.MonthExecutions ?? 0)</div><div class="fl-kpi-l">Ejecuciones (mes)</div></div>
        </div>
    </div>

    <div class="fl-toolbar">
        <div class="fl-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input value="@_query" @oninput="@(e => _query = e.Value?.ToString() ?? "")" placeholder="Buscar flujo..." />
        </div>
        <span class="fl-filter-label">Categorias:</span>
        <div class="fl-tabs">
            <button class="fl-tab @(_filterTags.Count == 0 ? "on" : "")" @onclick="() => _filterTags.Clear()">
                Todas <span class="fl-tab-count">@(_index?.Cards.Count ?? 0)</span>
            </button>
            @foreach (var t in _tags)
            {
                <button class="fl-tab @(_filterTags.Contains(t.Id) ? "on" : "")" @onclick="() => ToggleFilter(t.Id)">
                    @t.Name <span class="fl-tab-count">@TagCount(t.Id)</span>
                </button>
            }
            <button class="fl-tab fl-tab-manage" @onclick="OpenManage" title="Crear y gestionar categorias">+ Categorias</button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="fl-loading"><em>Cargando flujos...</em></p>
    }
    else
    {
        var groups = GroupedCards();
        @foreach (var grp in groups)
        {
            <div class="fl-group">
                <div class="fl-group-head">
                    <span class="fl-group-dot" style="background:@(grp.Color ?? "var(--ink-3,#94a3b8)")"></span>
                    <span class="fl-group-title">@grp.Title</span>
                    <span class="fl-group-count">@grp.Cards.Count</span>
                </div>
                <div class="fl-cards">
                    @foreach (var card in grp.Cards)
                    {
                        @* Clic en el cuerpo abre el editor; los botones (etiquetas / papelera) tienen stopPropagation. *@
                        <div class="fl-card" @onclick="@(() => OpenEditor(card.DefinitionId))" style="cursor:pointer;">
                            <div class="fl-card-top">
                                <span class="fl-card-id">@card.ProcessCode</span>
                                <div style="display:flex;align-items:center;gap:6px;">
                                    <span class="fl-badge" style="background:@ToneSoft(card.Estado);color:@Tone(card.Estado)">
                                        @if (card.RunningInstances > 0)
                                        {
                                            <span class="fl-dot" style="background:@Tone(card.Estado)"></span>
                                        }
                                        @card.Estado
                                    </span>
                                    <AuthorizeView Policy="SuperAdminOnly">
                                        <button title="Publicar al marketplace" @onclick:stopPropagation="true" @onclick="@(() => OpenPublish(card.DefinitionId, card.Name))" disabled="@_busy"
                                                style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;border:0;background:transparent;color:var(--ink-3,#94a3b8);border-radius:6px;cursor:pointer;">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3m0 0L8 7m4-4 4 4M5 21h14"/></svg>
                                        </button>
                                    </AuthorizeView>
                                    <button title="Etiquetas" @onclick:stopPropagation="true" @onclick="@(() => OpenAssign(card.ProcessCode, card.Name))" disabled="@_busy"
                                            style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;border:0;background:transparent;color:var(--ink-3,#94a3b8);border-radius:6px;cursor:pointer;">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 12 22l-9-9V3h10l7.59 7.59a2 2 0 0 1 0 2.82z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                                    </button>
                                    <button title="Eliminar flujo" @onclick:stopPropagation="true" @onclick="@(() => AskDelete(card.DefinitionId, card.Name, card.RunningInstances))" disabled="@_busy"
                                            style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;border:0;background:transparent;color:var(--ink-3,#94a3b8);border-radius:6px;cursor:pointer;">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="fl-card-name">@card.Name</div>
                            <div class="fl-card-tags">
                                @foreach (var tid in TagsOf(card.ProcessCode))
                                {
                                    @if (_tagById.TryGetValue(tid, out var tg))
                                    {
                                        <span class="fl-chip" style="@ChipStyle(tg.Color)">@tg.Name</span>
                                    }
                                }
                                <span class="fl-nodes">@card.NodeCount nodos</span>
                            </div>
                            <div class="fl-card-stats">
                                <div><div class="fl-stat-v blue">@card.RunningInstances</div><div class="fl-stat-l">en marcha</div></div>
                                <div><div class="fl-stat-v">@N(card.MonthExecutions)</div><div class="fl-stat-l">ejecuciones</div></div>
                                <div><div class="fl-stat-v green">@card.SuccessRate%</div><div class="fl-stat-l">exito</div></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @if (groups.Count == 0)
        {
            <p class="fl-loading"><em>No hay flujos que coincidan.</em></p>
        }
    }
</div>

@* ---- Modal "Nuevo flujo" del prototipo (nombre + categoria + estado) ---- *@
@if (_newFlowOpen)
{
    <div class="fl-overlay" @onclick="CloseNewFlow">
        <div class="fl-modal" style="width:min(460px,94vw)" @onclick:stopPropagation>
            <div class="fl-modal-head">
                <div>
                    <div class="fl-modal-title">Nuevo flujo</div>
                    <div class="fl-modal-sub">Define nombre y categoria antes de disenar</div>
                </div>
                <button class="fl-modal-x" @onclick="CloseNewFlow">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="fl-modal-body">
                <div>
                    <label class="fl-label">NOMBRE DEL FLUJO</label>
                    <input class="fl-input" @bind="_newFlowName" @bind:event="oninput" placeholder="Ej. Aprobacion de ordenes de compra" />
                </div>
                <div class="fl-grid-2">
                    <div>
                        <label class="fl-label">CATEGORIA / CARGO</label>
                        <select class="fl-input" @bind="_newFlowCategory">
                            @foreach (var option in KnownCategories)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="fl-label">ESTADO</label>
                        @* Los flujos nuevos SIEMPRE nacen en Borrador (regla del motor: se publica desde el editor). *@
                        <select class="fl-input" disabled title="Los flujos nuevos nacen en Borrador; se publican desde el editor">
                            <option selected>Borrador</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="fl-modal-foot no-border">
                <button class="fl-btn-ghost" @onclick="CloseNewFlow">Cancelar</button>
                <button class="fl-btn-brand" @onclick="CreateAndOpenAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newFlowName))">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Crear y disenar
                </button>
            </div>
        </div>
    </div>
}

@* ---- Editor canvas (modal grande del prototipo) ---- *@
@if (_editorId is Guid editorId)
{
    <FlowEditor DefinitionId="@editorId"
                Categories="@KnownCategories"
                OnClose="CloseEditorAsync"
                OnDefinitionSwitched="SwitchEditorAsync" />
}

@* ---- Confirmacion de eliminar flujo ---- *@
@if (_deleteId is not null)
{
    <div class="fl-overlay" @onclick="@(() => _deleteId = null)">
        <div class="fl-modal" style="width:min(520px,94vw)" @onclick:stopPropagation>
            <div class="fl-modal-head">
                <h3 style="margin:0;">Eliminar flujo</h3>
                <button class="fl-modal-x" @onclick="@(() => _deleteId = null)">&times;</button>
            </div>
            <div style="padding:8px 2px 12px;font-size:14px;color:var(--ink-2,#475569);">
                @if (_deleteRunning > 0)
                {
                    <p>El flujo <strong>@_deleteName</strong> tiene <strong>@_deleteRunning</strong> tarea(s) con una instancia del proceso <strong>en marcha</strong>. Cancela la instancia de cada tarea para poder eliminar el flujo.</p>
                    <div style="border:1px solid var(--border,#e2e8f0);border-radius:10px;overflow:hidden;margin-top:8px;">
                        @foreach (var inst in _deleteInstances)
                        {
                            <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid var(--surface-3,#f1f5f9);">
                                <div style="flex:1;min-width:0;">
                                    <div style="font-weight:600;color:var(--ink-1,#0f172a);">
                                        @(inst.TaskNumber ?? "(sin tarea)")@(inst.FlowVersion > 0 ? $"  ·  v{inst.FlowVersion}" : "")
                                    </div>
                                    <div style="font-size:12px;color:var(--ink-3,#94a3b8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        @(string.IsNullOrWhiteSpace(inst.TaskTitle) ? "Instancia sin tarea vinculada" : inst.TaskTitle)
                                    </div>
                                </div>
                                <button class="fl-btn-ghost" style="border-color:var(--t-red,#dc2626);color:var(--t-red,#dc2626);"
                                        @onclick="@(() => CancelInstanceAsync(inst.InstanceId))" disabled="@_busy">Cancelar instancia</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>Se archivara el flujo <strong>@_deleteName</strong> (todas sus versiones) y saldra del listado. Las instancias ya finalizadas se conservan.</p>
                }
                @if (_deleteError is not null)
                {
                    <div style="color:var(--t-red,#dc2626);font-size:13px;margin-top:6px;">@_deleteError</div>
                }
            </div>
            <div style="display:flex;justify-content:flex-end;gap:8px;">
                <button class="fl-btn-ghost" @onclick="@(() => _deleteId = null)" disabled="@_busy">Cerrar</button>
                @if (_deleteRunning == 0)
                {
                    <button class="fl-btn-brand" style="background:var(--t-red,#dc2626);border-color:var(--t-red,#dc2626);" @onclick="ConfirmDeleteAsync" disabled="@_busy">Eliminar</button>
                }
            </div>
        </div>
    </div>
}

@* ---- Modal: publicar al marketplace ---- *@
@if (_publishOpen)
{
    <div class="fl-overlay" @onclick="() => _publishOpen = false">
        <div class="fl-modal" style="width:min(480px,94vw)" @onclick:stopPropagation>
            <h3 class="fl-modal-title">Publicar al marketplace</h3>
            <p class="fl-muted">Se publica una PLANTILLA de este flujo (con sus formularios, y cargos/agentes por nombre) para que otros tenants la puedan traer.</p>
            <label class="fl-plabel">Titulo</label>
            <input class="fl-input" value="@_pubTitle" @oninput="@(e => _pubTitle = e.Value?.ToString() ?? "")" />
            <label class="fl-plabel">Descripcion (para que sirve)</label>
            <textarea class="fl-input" rows="3" @oninput="@(e => _pubDesc = e.Value?.ToString() ?? "")">@_pubDesc</textarea>
            <label class="fl-plabel">Categoria</label>
            <input class="fl-input" value="@_pubCat" @oninput="@(e => _pubCat = e.Value?.ToString() ?? "")" placeholder="Ej. Comercial" />
            <label class="fl-plabel">Imagen (opcional, max ~480 KB)</label>
            <InputFile OnChange="OnPublishImagePicked" accept="image/*" />
            @if (!string.IsNullOrEmpty(_pubImage))
            {
                <img src="@_pubImage" alt="vista previa" style="max-height:120px;border-radius:8px;margin-top:6px;display:block;" />
            }
            @if (_pubError is not null) { <div class="tk-field-error">@_pubError</div> }
            <div class="fl-modal-foot">
                <button class="fl-btn-ghost" @onclick="() => _publishOpen = false" disabled="@_busy">Cancelar</button>
                <button class="fl-btn-sm" @onclick="PublishAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_pubTitle))">Publicar</button>
            </div>
        </div>
    </div>
}

@* ---- Modal: gestionar categorias (crear / renombrar / eliminar) ---- *@
@if (_manageOpen)
{
    <div class="fl-overlay" @onclick="() => _manageOpen = false">
        <div class="fl-modal" style="width:min(460px,94vw)" @onclick:stopPropagation>
            <h3 class="fl-modal-title">Categorias de flujos</h3>
            <div class="fl-manage-list">
                @foreach (var t in _tags)
                {
                    <div class="fl-manage-row">
                        <input class="fl-input" value="@t.Name" @onchange="@(e => RenameTagAsync(t.Id, e.Value?.ToString()))" />
                        <button class="fl-mini-del" title="Eliminar categoria" @onclick="() => DeleteTagAsync(t.Id)">&times;</button>
                    </div>
                }
                @if (_tags.Count == 0)
                {
                    <p class="fl-muted">Aun no hay categorias. Crea la primera abajo.</p>
                }
            </div>
            <div class="fl-manage-new">
                <input class="fl-input" placeholder="Nueva categoria..." value="@_newTagName" @oninput="@(e => _newTagName = e.Value?.ToString() ?? "")"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await CreateTagAsync(); } })" />
                <button class="fl-btn-sm" @onclick="CreateTagAsync" disabled="@string.IsNullOrWhiteSpace(_newTagName)">+ Crear</button>
            </div>
            <div class="fl-modal-foot">
                <button class="fl-btn-sm" @onclick="() => _manageOpen = false">Listo</button>
            </div>
        </div>
    </div>
}

@* ---- Modal: asignar etiquetas a un flujo ---- *@
@if (_assignOpen)
{
    <div class="fl-overlay" @onclick="() => _assignOpen = false">
        <div class="fl-modal" style="width:min(420px,94vw)" @onclick:stopPropagation>
            <h3 class="fl-modal-title">Etiquetas de "@_assignName"</h3>
            <div class="fl-assign-chips">
                @foreach (var t in _tags)
                {
                    <button class="fl-chip-toggle @(_assignSel.Contains(t.Id) ? "on" : "")" @onclick="() => ToggleAssign(t.Id)">@t.Name</button>
                }
                @if (_tags.Count == 0)
                {
                    <p class="fl-muted">No hay categorias. Crea alguna en "+ Categorias".</p>
                }
            </div>
            <div class="fl-modal-foot">
                <button class="fl-btn-ghost" @onclick="() => _assignOpen = false">Cancelar</button>
                <button class="fl-btn-sm" @onclick="SaveAssignAsync" disabled="@_busy">Guardar</button>
            </div>
        </div>
    </div>
}

@* Galeria del marketplace (modal): traer un flujo publicado a este tenant. *@
@if (_showGallery)
{
    <MarketplaceGalleryModal Kind="MarketplaceItemKind.Flow"
                             OnClose="() => _showGallery = false"
                             OnImported="OnGalleryImportedAsync" />
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _showGallery;
    private string? _error;
    private string _query = "";
    private string _category = "Todos";
    private FlowIndexDto? _index;
    private Guid? _editorId;

    private bool _newFlowOpen;
    private string _newFlowName = "";
    private string _newFlowCategory = "Comercial";

    // ---- Etiquetas de tarjetas (ADR-0097 Fase A) ----
    private List<CardTagDto> _tags = new();
    private Dictionary<Guid, CardTagDto> _tagById = new();
    private IReadOnlyDictionary<string, IReadOnlyList<Guid>> _assignments = new Dictionary<string, IReadOnlyList<Guid>>();
    private readonly HashSet<Guid> _filterTags = new();
    private bool _backfilled;
    private bool _manageOpen;
    private string _newTagName = "";
    private bool _assignOpen;
    private string _assignCode = "";
    private string _assignName = "";
    private readonly HashSet<Guid> _assignSel = new();

    // Publicar al marketplace (ADR-0097 Ola B2).
    private bool _publishOpen;
    private Guid _pubDefId;
    private string _pubTitle = "";
    private string _pubDesc = "";
    private string _pubCat = "";
    private string? _pubImage;
    private string? _pubError;

    private sealed record CardGroup(string Title, string? Color, List<FlowCardDto> Cards);

    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");

    /// <summary>Categorias del prototipo + las reales del tenant (sin duplicar).</summary>
    private IReadOnlyList<string> KnownCategories
        => new[] { "Comercial", "Operaciones", "Cartera", "Tecnologia" }
            .Concat((_index?.Cards ?? []).Select(c => c.Category ?? "General"))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();

    // Confirmacion de eliminar flujo.
    private Guid? _deleteId;
    private string? _deleteName;
    private int _deleteRunning;
    private string? _deleteError;
    private IReadOnlyList<FlowRunningInstanceDto> _deleteInstances = [];

    private async Task AskDelete(Guid id, string name, int running)
    {
        _deleteId = id; _deleteName = name; _deleteRunning = running; _deleteError = null;
        _deleteInstances = [];
        if (running > 0) { await LoadDeleteInstancesAsync(); }
    }

    // Carga (o recarga) las instancias en marcha del flujo y sincroniza el contador con lo real.
    private async Task LoadDeleteInstancesAsync()
    {
        if (_deleteId is not Guid id) { return; }
        await _gate.WaitAsync();
        try
        {
            var res = await DesignSvc.ListRunningInstancesAsync(id);
            if (res.IsOk) { _deleteInstances = res.Value ?? []; _deleteRunning = _deleteInstances.Count; }
        }
        finally { _gate.Release(); }
    }

    private async Task CancelInstanceAsync(Guid instanceId)
    {
        _busy = true;
        _deleteError = null;
        await _gate.WaitAsync();
        bool ok; string? err = null;
        try { var res = await DesignSvc.CancelInstanceAsync(instanceId); ok = res.IsOk; err = res.Error; }
        finally { _gate.Release(); }
        _busy = false;
        if (!ok) { _deleteError = err ?? "No se pudo cancelar la instancia."; return; }
        await LoadDeleteInstancesAsync();   // refresca la lista + contador (si llega a 0, aparece "Eliminar")
        await ReloadAsync();                // actualiza las tarjetas del indice (RunningInstances)
    }

    // Serializa el acceso a la BD desde esta pagina: el DbContext del circuito lo comparten el indice y
    // el editor de flujos; sin esto, dos operaciones a la vez lanzan "A second operation was started on
    // this context".
    private readonly SemaphoreSlim _gate = new(1, 1);

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteId is not Guid id) { return; }
        _busy = true;
        _deleteError = null;
        await _gate.WaitAsync();
        bool ok;
        string? err = null;
        try { var res = await DesignSvc.DeleteDefinitionAsync(id); ok = res.IsOk; err = res.Error; }
        finally { _gate.Release(); }
        _busy = false;
        if (!ok) { _deleteError = err ?? "No se pudo eliminar el flujo."; return; }
        _deleteId = null;
        await ReloadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await _gate.WaitAsync();
        try { await LoadTagsCoreAsync(); } catch { /* etiquetas no debe tumbar la pagina */ } finally { _gate.Release(); }
    }

    // ---- Etiquetas: carga + operaciones (serializadas por _gate como el resto de la pagina) ----

    private async Task LoadTagsCoreAsync()
    {
        if (!_backfilled) { await TagSvc.BackfillFlowCategoriesAsync(); _backfilled = true; }
        _tags = (await TagSvc.ListTagsAsync(CardTagScope.Flow)).ToList();
        _tagById = _tags.ToDictionary(t => t.Id);
        _assignments = await TagSvc.GetAssignmentsAsync(CardTagScope.Flow);
    }

    private async Task RunTagOpAsync(Func<Task> op)
    {
        await _gate.WaitAsync();
        try { await op(); await LoadTagsCoreAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _gate.Release(); }
    }

    private void ToggleFilter(Guid id) { if (!_filterTags.Remove(id)) { _filterTags.Add(id); } }

    private IReadOnlyList<Guid> TagsOf(string code)
        => _assignments.TryGetValue(code, out var ids) ? ids : Array.Empty<Guid>();

    private int TagCount(Guid tagId)
        => (_index?.Cards ?? []).Count(c => TagsOf(c.ProcessCode).Contains(tagId));

    /// <summary>Estilo del chip a partir del color de la etiqueta (o neutro si no tiene).</summary>
    private static string ChipStyle(string? color)
        => string.IsNullOrWhiteSpace(color) ? "" : $"background:{color}1f;color:{color};border-color:{color}55;";

    /// <summary>Agrupa las tarjetas por etiqueta (una tarjeta aparece bajo CADA una de sus etiquetas);
    /// "Sin categoria" para las que no tienen (solo si no hay filtro de etiqueta activo). Aplica la busqueda.</summary>
    private List<CardGroup> GroupedCards()
    {
        var query = _query.Trim();
        bool MatchesQuery(FlowCardDto c) => query.Length == 0
            || c.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || c.ProcessCode.Contains(query, StringComparison.OrdinalIgnoreCase);
        var cards = (_index?.Cards ?? []).Where(MatchesQuery).ToList();

        var result = new List<CardGroup>();
        foreach (var t in _tags)
        {
            if (_filterTags.Count > 0 && !_filterTags.Contains(t.Id)) { continue; }
            var inTag = cards.Where(c => TagsOf(c.ProcessCode).Contains(t.Id)).ToList();
            if (inTag.Count > 0) { result.Add(new CardGroup(t.Name, t.Color, inTag)); }
        }
        if (_filterTags.Count == 0)
        {
            var untagged = cards.Where(c => TagsOf(c.ProcessCode).Count == 0).ToList();
            if (untagged.Count > 0) { result.Add(new CardGroup("Sin categoria", null, untagged)); }
        }
        return result;
    }

    private void OpenManage() { _newTagName = ""; _manageOpen = true; }

    private async Task CreateTagAsync()
    {
        var name = _newTagName.Trim();
        if (name.Length == 0) { return; }
        _newTagName = "";
        await RunTagOpAsync(() => TagSvc.CreateTagAsync(CardTagScope.Flow, name, null));
    }

    private async Task RenameTagAsync(Guid id, string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) { return; }
        await RunTagOpAsync(() => TagSvc.UpdateTagAsync(id, name!.Trim(), null));
    }

    private async Task DeleteTagAsync(Guid id)
    {
        _filterTags.Remove(id);
        await RunTagOpAsync(() => TagSvc.DeleteTagAsync(id));
    }

    private void OpenAssign(string code, string name)
    {
        _assignCode = code; _assignName = name;
        _assignSel.Clear();
        foreach (var id in TagsOf(code)) { _assignSel.Add(id); }
        _assignOpen = true;
    }

    private void ToggleAssign(Guid id) { if (!_assignSel.Remove(id)) { _assignSel.Add(id); } }

    private async Task SaveAssignAsync()
    {
        _busy = true;
        var code = _assignCode;
        var sel = _assignSel.ToList();
        await RunTagOpAsync(() => TagSvc.SetCardTagsAsync(CardTagScope.Flow, code, sel));
        _busy = false;
        _assignOpen = false;
    }

    // ---- Publicar al marketplace ----
    private void OpenPublish(Guid defId, string name)
    {
        _pubDefId = defId; _pubTitle = name; _pubDesc = ""; _pubCat = ""; _pubImage = null; _pubError = null;
        _publishOpen = true;
    }

    private async Task OnPublishImagePicked(InputFileChangeEventArgs e)
    {
        _pubError = null;
        var file = e.File;
        if (file is null) { return; }
        if (file.Size > 480 * 1024) { _pubError = "La imagen supera ~480 KB."; return; }
        try
        {
            using var stream = file.OpenReadStream(600 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            _pubImage = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch (Exception ex) { _pubError = "No se pudo leer la imagen: " + ex.Message; }
    }

    private async Task PublishAsync()
    {
        _busy = true; _pubError = null;
        await _gate.WaitAsync();
        try
        {
            var res = await MarketSvc.PublishFlowAsync(_pubDefId,
                new MarketplacePublishInput(_pubTitle.Trim(), _pubDesc, _pubCat, _pubImage), null);
            if (!res.Ok) { _pubError = res.Error ?? "No se pudo publicar."; return; }
            _publishOpen = false;
        }
        catch (Exception ex) { _pubError = ex.Message; }
        finally { _gate.Release(); _busy = false; }
    }

    // Se trajo un flujo desde la galeria del marketplace: recargar el indice para que aparezca.
    private async Task OnGalleryImportedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await _gate.WaitAsync();
        try
        {
            for (var attempt = 0; ; attempt++)
            {
                try { _index = await DesignSvc.ListForIndexAsync(); _error = null; break; }
                catch (InvalidOperationException ex) when (attempt < 2 && ex.Message.Contains("second operation", StringComparison.OrdinalIgnoreCase))
                {
                    await Task.Delay(150); // el DbContext del circuito estaba ocupado (editor); reintenta
                }
                catch (Exception ex) { _error = $"No se pudo cargar el indice de flujos: {ex.Message}"; break; }
            }
        }
        finally { _gate.Release(); _loading = false; }
    }

    private IEnumerable<(string Name, int Count)> CategoryTabs
    {
        get
        {
            var cards = _index?.Cards ?? [];
            yield return ("Todos", cards.Count);
            foreach (var group in cards
                .GroupBy(c => c.Category ?? "General", StringComparer.OrdinalIgnoreCase)
                .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase))
            {
                yield return (group.Key, group.Count());
            }
        }
    }

    private IEnumerable<FlowCardDto> Filtered
    {
        get
        {
            var cards = (_index?.Cards ?? []).AsEnumerable();
            if (_category != "Todos")
            {
                cards = cards.Where(c => string.Equals(c.Category ?? "General", _category, StringComparison.OrdinalIgnoreCase));
            }
            var query = _query.Trim();
            if (query.Length > 0)
            {
                cards = cards.Where(c =>
                    c.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || c.ProcessCode.Contains(query, StringComparison.OrdinalIgnoreCase));
            }
            return cards;
        }
    }

    /// <summary>Separador de miles del prototipo (toLocaleString('es') -> "1.204").</summary>
    private static string N(int value) => value.ToString("N0", Es);

    // Tonos del prototipo: En marcha=verde, Pausado=ambar, Borrador=gris.
    private static string Tone(string estado) => estado switch
    {
        WorkflowDesignService.EstadoEnMarcha => "var(--t-green)",
        WorkflowDesignService.EstadoPausado => "var(--t-amber)",
        _ => "var(--ink-3)"
    };

    private static string ToneSoft(string estado) => estado switch
    {
        WorkflowDesignService.EstadoEnMarcha => "var(--t-green-bg)",
        WorkflowDesignService.EstadoPausado => "var(--t-amber-bg)",
        _ => "var(--surface-3)"
    };

    private void OpenNewFlow()
    {
        _newFlowName = "";
        _newFlowCategory = "Comercial";
        _newFlowOpen = true;
    }

    private void CloseNewFlow() => _newFlowOpen = false;

    /// <summary>"Crear y disenar": borrador minimo (start -> end) y abre el editor.</summary>
    private async Task CreateAndOpenAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            await _gate.WaitAsync();
            bool ok; string? err; Guid newId = Guid.Empty;
            try
            {
                var result = await DesignSvc.CreateDraftAsync(_newFlowName, _newFlowCategory);
                ok = result.IsOk && result.Value is not null; err = result.Error;
                if (ok) { newId = result.Value!.DefinitionId; }
            }
            finally { _gate.Release(); }
            if (!ok)
            {
                _error = err ?? "No se pudo crear el flujo.";
                return;
            }
            _newFlowOpen = false;
            await ReloadAsync();
            _editorId = newId;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenEditor(Guid definitionId) => _editorId = definitionId;

    private async Task CloseEditorAsync()
    {
        _editorId = null;
        await ReloadAsync();
    }

    /// <summary>El editor cambio de definicion (EnsureDraft o importacion JSON).</summary>
    private async Task SwitchEditorAsync(Guid definitionId)
    {
        _editorId = definitionId;
        await ReloadAsync();
    }
