@page "/formacion/curso/{Id:guid}"
@attribute [Authorize(Policy = Ecorex.SuperAdmin.Endpoints.FormacionEndpoints.ViewPolicy)]
@* Reproductor de un curso de FORMACION (ADR-0202, ola 1): temario a la izquierda (modulos -> lecciones con check de
   vista) y la leccion a la derecha segun su tipo: video (streaming con rangos), enlace YouTube/Vimeo, PDF, imagen,
   texto (iframe sandbox sin scripts), wizard HTML (iframe sandbox con scripts y SIN same-origin, token firmado) o
   archivo descargable. "Marcar vista y continuar" guarda el avance en BD. Un curso no publicado solo lo ve quien
   puede editar (vista previa). Solo ASCII. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Formacion
@using Ecorex.Domain.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.DataProtection
@inject IServiceScopeFactory ScopeFactory
@inject IAuthorizationService Authz
@inject IDataProtectionProvider DataProtection

<PageTitle>@(_vista?.Curso.Titulo ?? "Curso") - Formacion</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <a href="/formacion">Formacion</a>
    <span class="sep">/</span>
    <span class="cur">@(_vista?.Curso.Titulo ?? "Curso")</span>
</nav>

@if (_loading)
{
    <div class="fm-muted">Cargando...</div>
}
else if (_vista is null)
{
    <div class="fm-empty">Este curso no existe o aun no esta publicado. <a href="/formacion">Volver al catalogo</a></div>
}
else
{
    var curso = _vista.Curso;
    <div class="fm-bar">
        <div class="fm-title">
            <h1 class="page-title" style="margin:0;">@curso.Titulo</h1>
            @if (!curso.Publicado)
            {
                <span class="fm-badge draft">Borrador (vista previa)</span>
            }
            @if (_vista.Obligatorio && !_completado)
            {
                <span class="fm-badge req">Obligatorio@(_vista.FechaLimite is DateOnly f ? $" - hasta {f:dd/MM/yyyy}" : "")</span>
            }
        </div>
        <div class="fm-actions">
            @if (_terminado)
            {
                <a class="btn btn-sm btn-success" href="@($"/formacion/certificado/{curso.Id}")" target="_blank" rel="noopener"><i class="fa-solid fa-award"></i> Descargar certificado</a>
            }
            @if (_canEdit)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@($"/formacion/admin/{curso.Id}")"><i class="fa-regular fa-pen-to-square"></i> Editar curso</a>
            }
        </div>
    </div>

    @if (curso.TotalLecciones == 0)
    {
        <div class="fm-empty">Este curso aun no tiene lecciones.</div>
    }
    else
    {
        <div class="fm-player">
            <aside class="fm-side">
                <div class="fm-side-head">
                    <strong>Contenido del curso</strong>
                    <div class="fm-progress @(_completado ? "done" : null)"><i style="width:@(_porcentaje)%"></i></div>
                    <span class="fm-muted-sm">@_vistas.Count de @curso.TotalLecciones lecciones - @_porcentaje%</span>
                </div>
                <div class="fm-side-list">
                    @foreach (var m in curso.Modulos)
                    {
                        <div class="fm-mod">@m.Titulo</div>
                        @foreach (var l in m.Lecciones)
                        {
                            var leccion = l;
                            <button class="fm-les @(!_enEvaluacion && _actual?.Id == l.Id ? "on" : null)" @onclick="() => AbrirAsync(leccion)">
                                <span class="fm-check @(_vistas.Contains(l.Id) ? "ok" : null)"><i class="fa-solid fa-check"></i></span>
                                <span>@l.Titulo</span>
                                <span class="fm-type" title="@TipoNombre(l.Tipo)"><i class="@TipoIcono(l.Tipo)"></i></span>
                            </button>
                        }
                    }
                    @if (_vista.TieneEvaluacion)
                    {
                        <div class="fm-mod">Evaluacion</div>
                        <button class="fm-les @(_enEvaluacion ? "on" : null)" @onclick="AbrirEvaluacionAsync">
                            <span class="fm-check @(_aprobado ? "ok" : null)"><i class="fa-solid fa-check"></i></span>
                            <span>Evaluacion final</span>
                            <span class="fm-type" title="Evaluacion"><i class="fa-solid fa-clipboard-question"></i></span>
                        </button>
                    }
                </div>
            </aside>

            <section class="fm-stage">
                @if (_terminado && _mostrarFelicitacion)
                {
                    <div class="fm-done-banner"><i class="fa-solid fa-trophy"></i> Terminaste el curso. Ya puedes descargar tu certificado (boton arriba) y repasar cualquier leccion.</div>
                }
                @if (_enEvaluacion)
                {
                    @Evaluacion()
                }
                else if (_actual is not null)
                {
                    <div class="fm-stage-head">
                        <h2>@_actual.Titulo</h2>
                        @if (!string.IsNullOrWhiteSpace(_actual.Descripcion))
                        {
                            <p>@_actual.Descripcion</p>
                        }
                    </div>
                    @Contenido(_actual)
                    <div class="fm-stage-foot">
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(Anterior is null)" @onclick="() => AbrirAsync(Anterior!)"><i class="fa-solid fa-chevron-left"></i> Anterior</button>
                        @if (_error is not null)
                        {
                            <span class="text-danger small">@_error</span>
                        }
                        @if (_vistas.Contains(_actual.Id))
                        {
                            @if (Siguiente is null && _vista!.TieneEvaluacion)
                            {
                                <button class="btn btn-sm btn-primary" @onclick="AbrirEvaluacionAsync">Ir a la evaluacion <i class="fa-solid fa-chevron-right"></i></button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary" disabled="@(Siguiente is null)" @onclick="() => AbrirAsync(Siguiente!)">Siguiente <i class="fa-solid fa-chevron-right"></i></button>
                            }
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="MarcarAsync"><i class="fa-solid fa-check"></i> @(Siguiente is null ? "Marcar vista y terminar" : "Marcar vista y continuar")</button>
                        }
                    </div>
                }
            </section>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private CursoVistaDto? _vista;
    private HashSet<Guid> _vistas = new();
    private int _porcentaje;
    private bool _completado;
    private bool _terminado;
    private bool _aprobado;
    private bool _mostrarFelicitacion;
    private bool _enEvaluacion;
    private EvaluacionAlumnoDto? _eval;
    private readonly Dictionary<Guid, int> _respuestas = new();
    private ResultadoEvaluacionDto? _resultado;
    private LeccionDto? _actual;
    private string? _wizardUrl;
    private bool _loading = true;
    private bool _busy;
    private bool _canEdit;
    private string? _error;
    private Guid _tenantId;
    private Guid _userId;

    private List<LeccionDto> Orden => _vista?.Curso.Modulos.SelectMany(m => m.Lecciones).ToList() ?? new();

    private LeccionDto? Anterior
    {
        get
        {
            var orden = Orden;
            var i = _actual is null ? -1 : orden.FindIndex(l => l.Id == _actual.Id);
            return i > 0 ? orden[i - 1] : null;
        }
    }

    private LeccionDto? Siguiente
    {
        get
        {
            var orden = Orden;
            var i = _actual is null ? -1 : orden.FindIndex(l => l.Id == _actual.Id);
            return i >= 0 && i < orden.Count - 1 ? orden[i + 1] : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            Guid.TryParse(user.FindFirst("tenant_id")?.Value, out _tenantId);
            Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);
            _canEdit = (await Authz.AuthorizeAsync(user, Ecorex.SuperAdmin.Endpoints.FormacionEndpoints.EditPolicy)).Succeeded;
        }
        try
        {
            _vista = await RunAsync(s => s.VerCursoAsync(Id, _canEdit));
        }
        catch (Exception)
        {
            _vista = null;
        }
        if (_vista is not null)
        {
            _vistas = _vista.Vistas.ToHashSet();
            _porcentaje = _vista.Porcentaje;
            _completado = _vista.Completado;
            _terminado = _vista.Terminado;
            _aprobado = _vista.Aprobado;
            var orden = Orden;
            var inicial = orden.FirstOrDefault(l => l.Id == _vista.UltimaLeccionId)
                ?? orden.FirstOrDefault(l => !_vistas.Contains(l.Id))
                ?? orden.FirstOrDefault();
            if (inicial is not null) { await AbrirAsync(inicial); }
        }
        _loading = false;
    }

    private async Task AbrirAsync(LeccionDto leccion)
    {
        _enEvaluacion = false;
        _actual = leccion;
        _error = null;
        _wizardUrl = null;
        if (leccion.Tipo == CursoLeccionTipo.WizardHtml && leccion.ArchivoId is not null)
        {
            var target = await RunAsync(s => s.ResolverWizardAsync(leccion.Id, _canEdit));
            _wizardUrl = target is null ? null : Ecorex.SuperAdmin.Endpoints.FormacionEndpoints.WizardUrl(DataProtection, target);
        }
        try { await RunAsync(async s => { await s.RegistrarAperturaAsync(Id, leccion.Id, _canEdit); return true; }); }
        catch (Exception) { /* registrar la apertura no debe impedir ver la leccion */ }
    }

    private async Task MarcarAsync()
    {
        if (_actual is null || _busy) { return; }
        _busy = true;
        try
        {
            var avance = await RunAsync(s => s.MarcarVistaAsync(_actual.Id, _canEdit));
            if (avance is null)
            {
                _error = "No se pudo guardar el avance.";
                return;
            }
            _vistas.Add(_actual.Id);
            _porcentaje = avance.Porcentaje;
            _completado = avance.Completado;
            if (_completado && !_vista!.TieneEvaluacion && !_terminado)
            {
                _terminado = true;
                _mostrarFelicitacion = true;
            }
            if (Siguiente is { } sig) { await AbrirAsync(sig); }
            else if (_completado && _vista!.TieneEvaluacion && !_aprobado) { await AbrirEvaluacionAsync(); }
        }
        catch (Exception)
        {
            _error = "No se pudo guardar el avance. Intenta de nuevo.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AbrirEvaluacionAsync()
    {
        _enEvaluacion = true;
        _resultado = null;
        _respuestas.Clear();
        _error = null;
        try { _eval = await RunEvalAsync(s => s.EvaluacionAsync(Id, _canEdit)); }
        catch (Exception) { _eval = null; _error = "No se pudo cargar la evaluacion."; }
    }

    private async Task EnviarEvaluacionAsync()
    {
        if (_eval is null || _busy) { return; }
        if (_eval.Preguntas.Any(p => !_respuestas.ContainsKey(p.Id)))
        {
            _error = "Responde todas las preguntas antes de enviar.";
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            var r = await RunEvalAsync(s => s.ResponderAsync(Id, new Dictionary<Guid, int>(_respuestas), _canEdit));
            if (!r.Ok) { _error = r.Error; return; }
            _resultado = r;
            if (r.Aprobado)
            {
                _aprobado = true;
                if (_completado && !_terminado) { _terminado = true; _mostrarFelicitacion = true; }
            }
            _eval = await RunEvalAsync(s => s.EvaluacionAsync(Id, _canEdit));
        }
        catch (Exception)
        {
            _error = "No se pudo enviar la evaluacion. Intenta de nuevo.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void Reintentar()
    {
        _resultado = null;
        _respuestas.Clear();
    }

    private RenderFragment Evaluacion() => __builder =>
    {
        <div class="fm-stage-head">
            <h2>Evaluacion final</h2>
            @if (_eval is not null)
            {
                <p>Aprueba con @_eval.PuntajeMinimo/100. Intentos: @_eval.IntentosUsados de @_eval.IntentosMax@(_eval.MejorNota is int mn ? $" - mejor nota {mn}/100" : "").</p>
            }
        </div>
        <div style="padding:16px;">
            @if (_eval is null)
            {
                <div class="fm-muted">@(_error ?? "Este curso no tiene evaluacion.")</div>
            }
            else if (_resultado is not null)
            {
                <div class="alert @(_resultado.Aprobado ? "alert-success" : "alert-warning")">
                    <strong>@(_resultado.Aprobado ? "Aprobaste" : "No alcanzaste el puntaje minimo")</strong> - @_resultado.Puntaje/100 (@_resultado.Correctas de @_resultado.Total correctas).
                    @if (!_resultado.Aprobado)
                    {
                        <span>@(_resultado.Bloqueado ? " Agotaste los intentos: pide al administrador que te desbloquee." : $" Te quedan {_resultado.IntentosRestantes} intento(s).")</span>
                    }
                </div>
                @if (_resultado.Falladas is { Count: > 0 } falladas)
                {
                    <div class="fm-section-title">Repasa estas preguntas</div>
                    @foreach (var f in falladas)
                    {
                        <div class="fm-panel" style="margin-bottom:8px;">
                            <div><strong>@f.Enunciado</strong></div>
                            @if (!string.IsNullOrWhiteSpace(f.Retroalimentacion)) { <div class="fm-muted" style="margin-top:4px;">@f.Retroalimentacion</div> }
                        </div>
                    }
                }
                @if (_resultado.Aprobado)
                {
                    <a class="btn btn-sm btn-success" href="@($"/formacion/certificado/{Id}")" target="_blank" rel="noopener"><i class="fa-solid fa-award"></i> Descargar certificado</a>
                }
                else if (!_resultado.Bloqueado)
                {
                    <button class="btn btn-sm btn-primary" @onclick="Reintentar">Intentar de nuevo</button>
                }
            }
            else if (_eval.Aprobado)
            {
                <div class="alert alert-success">Ya aprobaste esta evaluacion@(_eval.MejorNota is int n ? $" con {n}/100" : "").</div>
            }
            else if (!_eval.LeccionesCompletas)
            {
                <div class="fm-muted">Primero termina todas las lecciones del curso; luego se habilita la evaluacion.</div>
            }
            else if (_eval.Bloqueado || _eval.IntentosRestantes == 0)
            {
                <div class="alert alert-danger">Agotaste los intentos. Pide al administrador del curso que te desbloquee.</div>
            }
            else
            {
                @for (var i = 0; i < _eval.Preguntas.Count; i++)
                {
                    var p = _eval.Preguntas[i];
                    var num = i + 1;
                    <div class="fm-panel" style="margin-bottom:10px;">
                        <div style="font-weight:600;margin-bottom:8px;">@num. @p.Enunciado</div>
                        @for (var j = 0; j < p.Opciones.Count; j++)
                        {
                            var idx = j;
                            var nombre = $"q-{p.Id:N}";
                            <label class="d-flex align-items-start gap-2" style="font-size:14px;margin:4px 0;cursor:pointer;">
                                <input type="radio" class="form-check-input" name="@nombre" checked="@(_respuestas.TryGetValue(p.Id, out var sel) && sel == idx)"
                                       @onchange="() => _respuestas[p.Id] = idx" />
                                <span>@p.Opciones[j]</span>
                            </label>
                        }
                    </div>
                }
                @if (_error is not null) { <div class="text-danger small" style="margin-bottom:8px;">@_error</div> }
                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="EnviarEvaluacionAsync"><i class="fa-solid fa-paper-plane"></i> Enviar respuestas</button>
                <span class="fm-muted-sm" style="margin-left:8px;">@_respuestas.Count de @_eval.Preguntas.Count respondidas</span>
            }
        </div>
    };

    private async Task<T> RunEvalAsync<T>(Func<IFormacionEvaluacionService, Task<T>> action)
    {
        using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(_tenantId, _userId);
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await action(scope.ServiceProvider.GetRequiredService<IFormacionEvaluacionService>());
    }

    private RenderFragment Contenido(LeccionDto l) => __builder =>
    {
        if (!l.TieneContenido)
        {
            <div class="fm-file fm-muted">Esta leccion aun no tiene contenido.</div>
            return;
        }
        switch (l.Tipo)
        {
            case CursoLeccionTipo.Video:
                <div class="fm-media">
                    <video controls preload="metadata" controlslist="nodownload" src="@l.RecursoUrl" @key="l.Id"></video>
                </div>
                break;
            case CursoLeccionTipo.VideoEnlace:
                <div class="fm-media">
                    <iframe class="fm-embed" src="@l.EmbedUrl" title="@l.Titulo" @key="l.Id"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
                break;
            case CursoLeccionTipo.Pdf:
                <iframe class="fm-doc" src="@l.RecursoUrl" title="@l.Titulo" @key="l.Id"></iframe>
                break;
            case CursoLeccionTipo.Imagen:
                <div style="padding:12px;"><img class="fm-img" src="@l.RecursoUrl" alt="@l.Titulo" /></div>
                break;
            case CursoLeccionTipo.Texto:
                <iframe class="fm-text" sandbox="allow-popups allow-popups-to-escape-sandbox" srcdoc="@HtmlTexto(l.Contenido)" title="@l.Titulo" @key="l.Id"></iframe>
                break;
            case CursoLeccionTipo.WizardHtml:
                if (_wizardUrl is null)
                {
                    <div class="fm-file fm-muted">No se pudo abrir el wizard.</div>
                }
                else
                {
                    <iframe class="fm-wizard" src="@_wizardUrl" title="@l.Titulo" @key="l.Id"
                            sandbox="allow-scripts allow-forms allow-popups allow-modals allow-downloads"></iframe>
                }
                break;
            default:
                <div class="fm-file">
                    <p><i class="fa-regular fa-file fa-2x"></i></p>
                    <p>@l.ArchivoNombre @(l.ArchivoBytes is long b ? $"({Tamano(b)})" : "")</p>
                    <a class="btn btn-sm btn-outline-primary" href="@($"{l.RecursoUrl}?dl=1")" target="_blank" rel="noopener"><i class="fa-solid fa-download"></i> Descargar</a>
                </div>
                break;
        }
    };

    /// <summary>Documento del iframe de texto: estilos base + el HTML saneado; los enlaces abren en otra pestana.</summary>
    private static string HtmlTexto(string? contenido)
        => "<!doctype html><html><head><meta charset=\"utf-8\"><base target=\"_blank\"><style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;font-size:15px;line-height:1.6;color:#1b1b1e;padding:18px 22px;margin:0}img{max-width:100%}table{border-collapse:collapse}td,th{border:1px solid #e5e7eb;padding:6px}</style></head><body>"
           + (contenido ?? string.Empty) + "</body></html>";

    public static string TipoNombre(CursoLeccionTipo t) => t switch
    {
        CursoLeccionTipo.Video => "Video",
        CursoLeccionTipo.VideoEnlace => "Video (YouTube/Vimeo)",
        CursoLeccionTipo.Pdf => "Manual PDF",
        CursoLeccionTipo.Imagen => "Imagen",
        CursoLeccionTipo.Texto => "Texto",
        CursoLeccionTipo.WizardHtml => "Wizard HTML",
        _ => "Archivo"
    };

    public static string TipoIcono(CursoLeccionTipo t) => t switch
    {
        CursoLeccionTipo.Video => "fa-solid fa-film",
        CursoLeccionTipo.VideoEnlace => "fa-brands fa-youtube",
        CursoLeccionTipo.Pdf => "fa-regular fa-file-pdf",
        CursoLeccionTipo.Imagen => "fa-regular fa-image",
        CursoLeccionTipo.Texto => "fa-solid fa-align-left",
        CursoLeccionTipo.WizardHtml => "fa-solid fa-wand-magic-sparkles",
        _ => "fa-regular fa-file"
    };

    public static string Tamano(long bytes) => bytes switch
    {
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.##} GB"
    };

    private async Task<T> RunAsync<T>(Func<IFormacionService, Task<T>> action)
    {
        using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(_tenantId, _userId);
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await action(scope.ServiceProvider.GetRequiredService<IFormacionService>());
    }
}
