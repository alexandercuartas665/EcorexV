@page "/formacion"
@attribute [Authorize(Policy = Ecorex.SuperAdmin.Endpoints.FormacionEndpoints.ViewPolicy)]
@* Modulo de FORMACION (ADR-0202, ola 1): catalogo de cursos publicados del tenant. Arriba "Obligatorios para ti"
   (asignados al usuario, a su cargo/dependencia o a todos, con fecha limite) y debajo el catalogo completo con
   filtro por categoria y busqueda. Quien puede editar ve el boton "Administrar cursos". Solo ASCII. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Formacion
@using Microsoft.AspNetCore.Components.Authorization
@inject IServiceScopeFactory ScopeFactory
@inject IAuthorizationService Authz

<PageTitle>Formacion - ECOREX.tareas</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <span class="cur">Formacion</span>
</nav>

<div class="fm-bar">
    <div class="fm-title">
        <h1 class="page-title" style="margin:0;">Formacion</h1>
        <span class="page-sub" style="margin:0;">Cursos, manuales, videos y wizards de tu empresa. Tu avance se guarda solo.</span>
    </div>
    @if (_canEdit)
    {
        <div class="fm-actions">
            <a class="btn btn-sm btn-primary" href="/formacion/admin"><i class="fa-solid fa-pen-ruler"></i> Administrar cursos</a>
        </div>
    }
</div>

@if (_error is not null)
{
    <div class="alert alert-danger py-2 fm-alert">@_error</div>
}

@if (_loading)
{
    <div class="fm-muted">Cargando...</div>
}
else if (_cursos.Count == 0)
{
    <div class="fm-empty">
        @(_canEdit ? "Aun no hay cursos publicados. Crea el primero en Administrar cursos." : "Aun no hay cursos publicados en tu empresa.")
    </div>
}
else
{
    var pendientes = _cursos.Where(c => c.Obligatorio && !c.Completado).ToList();
    @if (pendientes.Count > 0)
    {
        <div class="fm-section-title"><i class="fa-solid fa-flag" style="color:#d97706"></i> Obligatorios para ti <span class="fm-muted-sm">(@pendientes.Count)</span></div>
        <div class="fm-gallery">
            @foreach (var c in pendientes)
            {
                @Tarjeta(c)
            }
        </div>
    }

    <div class="fm-section-title"><i class="fa-solid fa-book-open"></i> Catalogo</div>
    <div class="fm-filters">
        <div class="fm-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input placeholder="Buscar curso" @bind="_search" @bind:event="oninput" />
        </div>
        <div class="fm-chips" role="tablist">
            <button class="fm-chip @(_cat is null ? "on" : null)" @onclick="() => _cat = null">Todos <span>@_cursos.Count</span></button>
            @foreach (var g in _cursos.GroupBy(c => c.Categoria ?? "Sin categoria").OrderBy(g => g.Key))
            {
                var key = g.Key;
                <button class="fm-chip @(_cat == key ? "on" : null)" @onclick="() => _cat = key">@key <span>@g.Count()</span></button>
            }
        </div>
    </div>
    @if (Visibles.Count == 0)
    {
        <div class="fm-empty">Ningun curso coincide con el filtro.</div>
    }
    else
    {
        <div class="fm-gallery">
            @foreach (var c in Visibles)
            {
                @Tarjeta(c)
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<CatalogoCursoDto> _cursos = new();
    private bool _loading = true;
    private bool _canEdit;
    private string? _error;
    private string _search = string.Empty;
    private string? _cat;
    private Guid _tenantId;
    private Guid _userId;

    private List<CatalogoCursoDto> Visibles
    {
        get
        {
            IEnumerable<CatalogoCursoDto> q = _cursos;
            if (_cat is not null) { q = q.Where(c => (c.Categoria ?? "Sin categoria") == _cat); }
            var term = _search.Trim();
            if (term.Length > 0)
            {
                q = q.Where(c => c.Titulo.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (c.Descripcion?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            Guid.TryParse(user.FindFirst("tenant_id")?.Value, out _tenantId);
            Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);
            _canEdit = (await Authz.AuthorizeAsync(user, Ecorex.SuperAdmin.Endpoints.FormacionEndpoints.EditPolicy)).Succeeded;
        }
        try
        {
            using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(_tenantId, _userId);
            await using var scope = ScopeFactory.CreateAsyncScope();
            _cursos = (await scope.ServiceProvider.GetRequiredService<IFormacionService>().CatalogoAsync()).ToList();
        }
        catch (Exception)
        {
            _error = "No se pudo cargar el catalogo. Intenta de nuevo.";
        }
        _loading = false;
    }

    private RenderFragment Tarjeta(CatalogoCursoDto c) => __builder =>
    {
        <a class="fm-card" href="@($"/formacion/curso/{c.Id}")">
            <div class="fm-cover">
                @if (c.PortadaUrl is not null)
                {
                    <img src="@c.PortadaUrl" alt="" loading="lazy" />
                }
                else
                {
                    <i class="fa-solid fa-graduation-cap"></i>
                }
                <div class="fm-badges">
                    @if (c.Completado)
                    {
                        <span class="fm-badge done"><i class="fa-solid fa-check"></i> Completado</span>
                    }
                    else if (c.Vencido)
                    {
                        <span class="fm-badge late">Vencido @c.FechaLimite?.ToString("dd/MM/yyyy")</span>
                    }
                    else if (c.Obligatorio)
                    {
                        <span class="fm-badge req">Obligatorio@(c.FechaLimite is DateOnly f ? $" - hasta {f:dd/MM/yyyy}" : "")</span>
                    }
                </div>
            </div>
            <div class="fm-card-body">
                <span class="fm-card-cat">@(c.Categoria ?? "Sin categoria")</span>
                <span class="fm-card-title">@c.Titulo</span>
                @if (!string.IsNullOrWhiteSpace(c.Descripcion))
                {
                    <span class="fm-card-desc">@c.Descripcion</span>
                }
                @if (c.Iniciado)
                {
                    <div class="fm-progress @(c.Completado ? "done" : null)" title="@c.Porcentaje% completado"><i style="width:@(c.Porcentaje)%"></i></div>
                }
                <div class="fm-card-meta">
                    <span><i class="fa-regular fa-file-lines"></i> @c.Lecciones lecciones</span>
                    @if (c.DuracionMinutos is int m)
                    {
                        <span><i class="fa-regular fa-clock"></i> @Duracion(m)</span>
                    }
                    @if (c.Iniciado && !c.Completado)
                    {
                        <span>@c.Porcentaje%</span>
                    }
                </div>
            </div>
        </a>
    };

    private static string Duracion(int minutos) => minutos < 60 ? $"{minutos} min" : $"{minutos / 60} h {minutos % 60:00} min";
}
