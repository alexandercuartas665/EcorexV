@page "/formularios"
@attribute [Authorize(Policy = "Formularios.Disenar")]
@* Policy por modulo (paso 1: mismo requisito que TenantMember, nombre estable). TODO: derivar del Module Registry. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Ecorex.Application.Forms
@using Ecorex.Application.Cards
@using Ecorex.Application.Marketplace
@using Ecorex.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IFormDefinitionService FormsSvc
@inject ICardTagService TagSvc
@inject IMarketplaceService MarketSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

@* ============================================================
   INDICE DE FORMULARIOS del prototipo (ECOREX.dc.html, pantalla
   'forms'): rotulo de modulo, KPIs, busqueda, vista tarjetas /
   lista. Fiel al pixel del fuente (ADR-0021). Abrir una tarjeta
   navega al CONSTRUCTOR (/formularios/{id}/disenar).
   ============================================================ *@

<PageTitle>Formularios - ECOREX.tareas</PageTitle>

<div class="fx-page">
    <div class="fx-head">
        <div>
            <div class="fx-eyebrow">MODULO 000131 - AUTOMATIZACION</div>
            <h1 class="fx-title">Formularios</h1>
            <p class="fx-subtitle">Todos los formularios del motor EAV. Abre uno para editarlo en el constructor.</p>
        </div>
        <div style="display:flex;gap:10px;align-items:center;">
            <a class="fx-btn-ghost" href="plantillas?kind=form" style="text-decoration:none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/></svg>
                Galeria
            </a>
            <button class="fx-btn-ghost" @onclick="OpenImport" disabled="@_busy" title="Crear un formulario a partir de un JSON exportado">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/></svg>
                Importar JSON
            </button>
            <button class="fx-btn-new" @onclick="CreateAndOpenAsync" disabled="@_busy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                Nuevo formulario
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="fx-error">@_error</div>
    }

    <div class="fx-kpis">
        <div class="fx-kpi">
            <div class="fx-kpi-ic" style="background:var(--t-violet-bg);color:var(--t-violet)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2.5"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
            </div>
            <div class="fx-kpi-tx"><div class="fx-kpi-v">@_definitions.Count</div><div class="fx-kpi-l">Formularios</div></div>
        </div>
        <div class="fx-kpi">
            <div class="fx-kpi-ic" style="background:var(--t-green-bg);color:var(--t-green)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8 12 3 3 5-6"/></svg>
            </div>
            <div class="fx-kpi-tx"><div class="fx-kpi-v">@_definitions.Count(d => d.Status == FormStatus.Active && !d.IsArchived)</div><div class="fx-kpi-l">Publicados</div></div>
        </div>
        <div class="fx-kpi">
            <div class="fx-kpi-ic" style="background:var(--t-blue-bg);color:var(--t-blue)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v16h16"/><rect x="7.5" y="11" width="3" height="6" rx="1"/><rect x="13.5" y="7" width="3" height="10" rx="1"/></svg>
            </div>
            <div class="fx-kpi-tx"><div class="fx-kpi-v">@N(_definitions.Sum(d => d.ResponseCount))</div><div class="fx-kpi-l">Respuestas</div></div>
        </div>
        <div class="fx-kpi">
            <div class="fx-kpi-ic" style="background:var(--t-amber-bg);color:var(--t-amber)">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
            </div>
            <div class="fx-kpi-tx"><div class="fx-kpi-v">@_definitions.Count(d => d.RuleCount > 0)</div><div class="fx-kpi-l">Con reglas</div></div>
        </div>
    </div>

    <div class="fx-toolbar">
        <div class="fx-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input value="@_query" @oninput="@(e => _query = e.Value?.ToString() ?? "")" placeholder="Buscar formulario..." />
        </div>
        <div class="fx-tagfilter">
            <button class="fx-viewtab @(_filterTags.Count == 0 ? "on" : "")" @onclick="() => _filterTags.Clear()">Todas</button>
            @foreach (var t in _tags)
            {
                <button class="fx-viewtab @(_filterTags.Contains(t.Id) ? "on" : "")" @onclick="() => ToggleFilter(t.Id)">
                    @t.Name <span class="fx-tabn">@TagCount(t.Id)</span>
                </button>
            }
            <button class="fx-viewtab fx-tab-manage" @onclick="OpenManage" title="Crear y gestionar categorias">+ Categorias</button>
        </div>
        @* Activos / Archivados: el indice mostraba todo mezclado y lo archivado solo se distinguia
           por el badge, asi que archivar no despejaba nada. Ahora el principal son los activos y lo
           archivado se consulta aparte. El contador solo aparece si hay algo que ver. *@
        <div class="fx-viewtabs fx-statetabs">
            <button class="fx-viewtab @(!_showArchived ? "on" : "")" @onclick="@(() => _showArchived = false)">
                Activos
                <span class="fx-tabn">@ActiveCount</span>
            </button>
            <button class="fx-viewtab @(_showArchived ? "on" : "")" @onclick="@(() => _showArchived = true)"
                    disabled="@(ArchivedCount == 0 && !_showArchived)">
                Archivados
                @if (ArchivedCount > 0)
                {
                    <span class="fx-tabn">@ArchivedCount</span>
                }
            </button>
        </div>
        <div class="fx-viewtabs">
            <button class="fx-viewtab @(!_listView ? "on" : "")" @onclick="@(() => _listView = false)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                Tarjetas
            </button>
            <button class="fx-viewtab @(_listView ? "on" : "")" @onclick="@(() => _listView = true)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                Lista
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="fx-loading"><em>Cargando formularios...</em></p>
    }
    else if (!Filtered.Any())
    {
        <div class="fx-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2.5"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
            <p>
                @if (!string.IsNullOrWhiteSpace(_query))
                {
                    @($"Ningun formulario coincide con \"{_query.Trim()}\".")
                }
                else if (_showArchived)
                {
                    @("No hay formularios archivados.")
                }
                else
                {
                    @("Aun no hay formularios. Crea el primero.")
                }
            </p>
        </div>
    }
    else if (!_listView)
    {
        @foreach (var grp in GroupedForms())
        {
            <div class="fx-group">
                <div class="fx-group-head">
                    <span class="fx-group-dot" style="background:@(grp.Color ?? "var(--ink-3,#94a3b8)")"></span>
                    <span class="fx-group-title">@grp.Title</span>
                    <span class="fx-group-count">@grp.Cards.Count</span>
                </div>
                <div class="fx-cards">
                    @foreach (var d in grp.Cards)
                    {
                        <div class="fx-card" role="button" tabindex="0"
                             @onclick="@(() => OpenDesigner(d.Id))"
                             @onkeydown="@(e => OnCardKeyAsync(e, d.Id))">
                            <div class="fx-card-top">
                                <span class="fx-card-ic">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2.5"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
                                </span>
                                <span class="fx-badge" style="background:@ToneSoft(d);color:@Tone(d)">@EstadoLabel(d)</span>
                                <AuthorizeView Policy="SuperAdminOnly">
                                    <button class="fx-card-del" title="Publicar al marketplace" aria-label="Publicar @d.Title"
                                            disabled="@_busy" @onclick:stopPropagation="true"
                                            @onclick="@(() => OpenPublish(d.Id, d.Title))">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3m0 0L8 7m4-4 4 4M5 21h14"/></svg>
                                    </button>
                                </AuthorizeView>
                                <button class="fx-card-del" title="Etiquetas" aria-label="Etiquetas @d.Title"
                                        disabled="@_busy" @onclick:stopPropagation="true"
                                        @onclick="@(() => OpenAssign(d.Code, d.Title))">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 12 22l-9-9V3h10l7.59 7.59a2 2 0 0 1 0 2.82z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                                </button>
                                @* stopPropagation: sin esto el clic tambien abriria el disenador detras. *@
                                <button class="fx-card-del" title="Exportar a JSON" aria-label="Exportar @d.Title"
                                        disabled="@_busy" @onclick:stopPropagation="true"
                                        @onclick="@(() => ExportAsync(d))">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3m0 0L8 7m4-4 4 4M5 21h14"/></svg>
                                </button>
                                <button class="fx-card-del @(d.IsArchived ? "on" : "")"
                                        title="@(d.IsArchived ? "Restaurar formulario" : "Archivar formulario")"
                                        aria-label="@(d.IsArchived ? "Restaurar" : "Archivar") @d.Title"
                                        disabled="@_busy" @onclick:stopPropagation="true"
                                        @onclick="@(() => AskArchiveAsync(d))">
                                    @if (d.IsArchived)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>
                                    }
                                </button>
                            </div>
                            <div class="fx-card-name">@d.Title</div>
                            <div class="fx-card-meta fx-card-tags">
                                <span class="fx-code">FORX-@d.Code</span>
                                @foreach (var tid in TagsOf(d.Code))
                                {
                                    @if (_tagById.TryGetValue(tid, out var tg))
                                    {
                                        <span class="fx-chip" style="@ChipStyle(tg.Color)">@tg.Name</span>
                                    }
                                }
                            </div>
                            <div class="fx-card-stats">
                                <div><div class="fx-stat-v">@d.QuestionCount</div><div class="fx-stat-l">campos</div></div>
                                <div><div class="fx-stat-v">@N(d.ResponseCount)</div><div class="fx-stat-l">respuestas</div></div>
                                <div><div class="fx-stat-v amber">@d.RuleCount</div><div class="fx-stat-l">reglas</div></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="fx-list">
            <div class="fx-list-head">
                <div class="fx-list-th pad-l">FORMULARIO</div>
                <div class="fx-list-th">CATEGORIA</div>
                <div class="fx-list-th">CAMPOS</div>
                <div class="fx-list-th">RESPUESTAS</div>
                <div class="fx-list-th pad-l2">ESTADO</div>
            </div>
            @foreach (var d in Filtered)
            {
                <button class="fx-list-row" @onclick="@(() => OpenDesigner(d.Id))">
                    <div class="fx-list-name">
                        <div class="fx-list-title">@d.Title</div>
                        <div class="fx-code">FORX-@d.Code</div>
                    </div>
                    <div class="fx-list-cell fx-card-tags">
                        @foreach (var tid in TagsOf(d.Code))
                        {
                            @if (_tagById.TryGetValue(tid, out var tg))
                            {
                                <span class="fx-chip" style="@ChipStyle(tg.Color)">@tg.Name</span>
                            }
                        }
                    </div>
                    <div class="fx-list-cell">@d.QuestionCount</div>
                    <div class="fx-list-cell">@N(d.ResponseCount)</div>
                    <div class="fx-list-estado"><span class="fx-badge" style="background:@ToneSoft(d);color:@Tone(d)">@EstadoLabel(d)</span></div>
                </button>
            }
        </div>
    }
</div>

@if (_confirming is not null)
{
    <div class="fx-overlay" @onclick="CloseConfirm">
        <div class="fx-modal" @onclick:stopPropagation="true">
            <div class="fx-m-body">
                <div class="fx-m-title">Archivar formulario</div>
                <p class="fx-m-text">
                    <b>@_confirming.Title</b> se marcara como archivado y dejara de ofrecerse.
                    Su definicion y sus respuestas se conservan, y puedes restaurarlo desde esta
                    misma tarjeta.
                </p>
                @if (_confirming.ResponseCount > 0)
                {
                    @* Se nombra el formulario y su codigo: sin eso, el aviso queda junto a otras
                       tarjetas que muestran 0 respuestas y parece que el numero viene de otro
                       lado (llego a leerse como una fuga entre tenants, que no lo es). *@
                    <div class="fx-m-warn">
                        <b>@_confirming.Code &#183; @_confirming.Title</b> tiene
                        @N(_confirming.ResponseCount) respuesta(s) guardada(s). No se borran.
                    </div>
                }
                @if (_confirmError is not null)
                {
                    <div class="fx-m-err">@_confirmError</div>
                }
            </div>
            <div class="fx-m-foot">
                <button class="fx-mbtn" @onclick="CloseConfirm" disabled="@_busy">Cancelar</button>
                <button class="fx-mbtn fx-mbtn-go" @onclick="ConfirmArchiveAsync" disabled="@_busy">Archivar</button>
            </div>
        </div>
    </div>
}

@if (_importOpen)
{
    <div class="fx-overlay" @onclick="CloseImport">
        <div class="fx-modal" @onclick:stopPropagation="true" style="max-width:660px;width:94vw;">
            <div class="fx-m-body">
                <div class="fx-m-title">Importar formulario (JSON)</div>
                <p class="fx-m-text">Pega el JSON exportado de un formulario. Se creara uno <b>nuevo</b>
                   con codigo unico: nunca sobrescribe uno existente.</p>
                <textarea class="fx-import-ta" rows="12" spellcheck="false"
                          placeholder='{ &quot;formatVersion&quot;: 1, &quot;definition&quot;: { ... } }'
                          @bind="_importJson" @bind:event="oninput"></textarea>
                @if (_importError is not null)
                {
                    <div class="fx-m-err">@_importError</div>
                }
            </div>
            <div class="fx-m-foot">
                <button class="fx-mbtn" @onclick="CloseImport" disabled="@_busy">Cancelar</button>
                <button class="fx-mbtn fx-mbtn-go" @onclick="DoImportAsync"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_importJson))">Importar y abrir</button>
            </div>
        </div>
    </div>
}

@* ---- Modal: publicar al marketplace ---- *@
@if (_publishOpen)
{
    <div class="fx-overlay" @onclick="() => _publishOpen = false">
        <div class="fx-modal" @onclick:stopPropagation="true">
            <div class="fx-m-body">
                <div class="fx-m-title">Publicar al marketplace</div>
                <p class="fx-muted">Se publica una PLANTILLA de este formulario para que otros tenants lo puedan traer.</p>
                <input class="fx-tag-input" placeholder="Titulo" value="@_pubTitle" @oninput="@(e => _pubTitle = e.Value?.ToString() ?? "")" />
                <textarea class="fx-tag-input" rows="3" placeholder="Descripcion (para que sirve)" @oninput="@(e => _pubDesc = e.Value?.ToString() ?? "")">@_pubDesc</textarea>
                <input class="fx-tag-input" placeholder="Categoria (ej. Comercial)" value="@_pubCat" @oninput="@(e => _pubCat = e.Value?.ToString() ?? "")" />
                <div class="fx-muted" style="margin-top:6px;">Imagen (opcional, max ~480 KB)</div>
                <InputFile OnChange="OnPublishImagePicked" accept="image/*" />
                @if (!string.IsNullOrEmpty(_pubImage))
                {
                    <img src="@_pubImage" alt="vista previa" style="max-height:120px;border-radius:8px;margin-top:6px;display:block;" />
                }
                @if (_pubError is not null) { <div class="tk-field-error">@_pubError</div> }
                <div class="fx-m-foot">
                    <button class="fx-btn-ghost" @onclick="() => _publishOpen = false" disabled="@_busy">Cancelar</button>
                    <button class="fx-btn-new" @onclick="PublishAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_pubTitle))">Publicar</button>
                </div>
            </div>
        </div>
    </div>
}

@* ---- Modal: gestionar categorias de formularios ---- *@
@if (_manageOpen)
{
    <div class="fx-overlay" @onclick="() => _manageOpen = false">
        <div class="fx-modal" @onclick:stopPropagation="true">
            <div class="fx-m-body">
                <div class="fx-m-title">Categorias de formularios</div>
                <div class="fx-manage-list">
                    @foreach (var t in _tags)
                    {
                        <div class="fx-manage-row">
                            <input class="fx-tag-input" value="@t.Name" @onchange="@(e => RenameTagAsync(t.Id, e.Value?.ToString()))" />
                            <button class="fx-mini-del" title="Eliminar categoria" @onclick="() => DeleteTagAsync(t.Id)">&times;</button>
                        </div>
                    }
                    @if (_tags.Count == 0)
                    {
                        <p class="fx-muted">Aun no hay categorias. Crea la primera abajo.</p>
                    }
                </div>
                <div class="fx-manage-new">
                    <input class="fx-tag-input" placeholder="Nueva categoria..." value="@_newTagName" @oninput="@(e => _newTagName = e.Value?.ToString() ?? "")"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await CreateTagAsync(); } })" />
                    <button class="fx-btn-new" @onclick="CreateTagAsync" disabled="@string.IsNullOrWhiteSpace(_newTagName)">+ Crear</button>
                </div>
                <div class="fx-m-foot">
                    <button class="fx-btn-new" @onclick="() => _manageOpen = false">Listo</button>
                </div>
            </div>
        </div>
    </div>
}

@* ---- Modal: asignar etiquetas a un formulario ---- *@
@if (_assignOpen)
{
    <div class="fx-overlay" @onclick="() => _assignOpen = false">
        <div class="fx-modal" @onclick:stopPropagation="true">
            <div class="fx-m-body">
                <div class="fx-m-title">Etiquetas de "@_assignName"</div>
                <div class="fx-assign-chips">
                    @foreach (var t in _tags)
                    {
                        <button class="fx-chip-toggle @(_assignSel.Contains(t.Id) ? "on" : "")" @onclick="() => ToggleAssign(t.Id)">@t.Name</button>
                    }
                    @if (_tags.Count == 0)
                    {
                        <p class="fx-muted">No hay categorias. Crea alguna en "+ Categorias".</p>
                    }
                </div>
                <div class="fx-m-foot">
                    <button class="fx-btn-ghost" @onclick="() => _assignOpen = false">Cancelar</button>
                    <button class="fx-btn-new" @onclick="SaveAssignAsync" disabled="@_busy">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _listView;
    private bool _importOpen;
    private string _importJson = "";
    private string? _importError;

    /// <summary>Pestana activa: false = activos (lo normal), true = el archivo.</summary>
    private bool _showArchived;
    private string _query = "";
    private string? _error;
    private List<FormDefinitionListItemDto> _definitions = new();

    // ---- Etiquetas de tarjetas (ADR-0097 Fase A) ----
    private List<CardTagDto> _tags = new();
    private Dictionary<Guid, CardTagDto> _tagById = new();
    private IReadOnlyDictionary<string, IReadOnlyList<Guid>> _assignments = new Dictionary<string, IReadOnlyList<Guid>>();
    private readonly HashSet<Guid> _filterTags = new();
    private bool _manageOpen;
    private string _newTagName = "";
    private bool _assignOpen;
    private string _assignCode = "";
    private string _assignName = "";
    private readonly HashSet<Guid> _assignSel = new();

    // Publicar al marketplace (ADR-0097 Ola B2).
    private bool _publishOpen;
    private Guid _pubDefId;
    private string _pubTitle = "";
    private string _pubDesc = "";
    private string _pubCat = "";
    private string? _pubImage;
    private string? _pubError;

    private sealed record FormGroup(string Title, string? Color, List<FormDefinitionListItemDto> Cards);

    private void OpenPublish(Guid defId, string title)
    {
        _pubDefId = defId; _pubTitle = title; _pubDesc = ""; _pubCat = ""; _pubImage = null; _pubError = null;
        _publishOpen = true;
    }

    private async Task OnPublishImagePicked(InputFileChangeEventArgs e)
    {
        _pubError = null;
        var file = e.File;
        if (file is null) { return; }
        if (file.Size > 480 * 1024) { _pubError = "La imagen supera ~480 KB."; return; }
        try
        {
            using var stream = file.OpenReadStream(600 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            _pubImage = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch (Exception ex) { _pubError = "No se pudo leer la imagen: " + ex.Message; }
    }

    private async Task PublishAsync()
    {
        _busy = true; _pubError = null;
        try
        {
            var res = await MarketSvc.PublishFormAsync(_pubDefId,
                new MarketplacePublishInput(_pubTitle.Trim(), _pubDesc, _pubCat, _pubImage), null);
            if (!res.Ok) { _pubError = res.Error ?? "No se pudo publicar."; return; }
            _publishOpen = false;
        }
        catch (Exception ex) { _pubError = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>Formulario cuyo archivado se esta confirmando (null = sin dialogo abierto).</summary>
    private FormDefinitionListItemDto? _confirming;
    private string? _confirmError;

    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");

    protected override async Task OnInitializedAsync()
    {
        // Igual que el prototipo: los archivados aparecen con badge "Archivado".
        _definitions = (await FormsSvc.ListAsync(includeArchived: true)).ToList();
        try { await LoadTagsAsync(); } catch { /* etiquetas no debe tumbar la pagina */ }
        _loading = false;
    }

    // ---- Etiquetas ----
    private async Task LoadTagsAsync()
    {
        _tags = (await TagSvc.ListTagsAsync(CardTagScope.Form)).ToList();
        _tagById = _tags.ToDictionary(t => t.Id);
        _assignments = await TagSvc.GetAssignmentsAsync(CardTagScope.Form);
    }

    private void ToggleFilter(Guid id) { if (!_filterTags.Remove(id)) { _filterTags.Add(id); } }

    private IReadOnlyList<Guid> TagsOf(string code)
        => _assignments.TryGetValue(code, out var ids) ? ids : Array.Empty<Guid>();

    private int TagCount(Guid tagId)
        => _definitions.Count(d => d.IsArchived == _showArchived && TagsOf(d.Code).Contains(tagId));

    private static string ChipStyle(string? color)
        => string.IsNullOrWhiteSpace(color) ? "" : $"background:{color}1f;color:{color};border-color:{color}55;";

    /// <summary>Agrupa las tarjetas por etiqueta (una tarjeta bajo CADA una de sus etiquetas); "Sin
    /// categoria" para las que no tienen (solo si no hay filtro). Respeta la pestana Activos/Archivados
    /// y la busqueda.</summary>
    private List<FormGroup> GroupedForms()
    {
        var q = _query.Trim();
        bool MatchesQuery(FormDefinitionListItemDto d) => q.Length == 0
            || d.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
            || d.Code.Contains(q, StringComparison.OrdinalIgnoreCase);
        var cards = _definitions.Where(d => d.IsArchived == _showArchived && MatchesQuery(d)).ToList();

        var result = new List<FormGroup>();
        foreach (var t in _tags)
        {
            if (_filterTags.Count > 0 && !_filterTags.Contains(t.Id)) { continue; }
            var inTag = cards.Where(d => TagsOf(d.Code).Contains(t.Id)).ToList();
            if (inTag.Count > 0) { result.Add(new FormGroup(t.Name, t.Color, inTag)); }
        }
        if (_filterTags.Count == 0)
        {
            var untagged = cards.Where(d => TagsOf(d.Code).Count == 0).ToList();
            if (untagged.Count > 0) { result.Add(new FormGroup("Sin categoria", null, untagged)); }
        }
        return result;
    }

    private void OpenManage() { _newTagName = ""; _manageOpen = true; }

    private async Task CreateTagAsync()
    {
        var name = _newTagName.Trim();
        if (name.Length == 0) { return; }
        _newTagName = "";
        await TagSvc.CreateTagAsync(CardTagScope.Form, name, null);
        await LoadTagsAsync();
    }

    private async Task RenameTagAsync(Guid id, string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) { return; }
        await TagSvc.UpdateTagAsync(id, name!.Trim(), null);
        await LoadTagsAsync();
    }

    private async Task DeleteTagAsync(Guid id)
    {
        _filterTags.Remove(id);
        await TagSvc.DeleteTagAsync(id);
        await LoadTagsAsync();
    }

    private void OpenAssign(string code, string name)
    {
        _assignCode = code; _assignName = name;
        _assignSel.Clear();
        foreach (var id in TagsOf(code)) { _assignSel.Add(id); }
        _assignOpen = true;
    }

    private void ToggleAssign(Guid id) { if (!_assignSel.Remove(id)) { _assignSel.Add(id); } }

    private async Task SaveAssignAsync()
    {
        _busy = true;
        try
        {
            await TagSvc.SetCardTagsAsync(CardTagScope.Form, _assignCode, _assignSel.ToList());
            await LoadTagsAsync();
        }
        finally { _busy = false; _assignOpen = false; }
    }

    private int ActiveCount => _definitions.Count(d => !d.IsArchived);
    private int ArchivedCount => _definitions.Count(d => d.IsArchived);

    /// <summary>
    /// La pestana manda: o activos o archivados, nunca mezclados. La busqueda se aplica dentro de
    /// la pestana elegida.
    /// </summary>
    private IEnumerable<FormDefinitionListItemDto> Filtered
    {
        get
        {
            var scope = _definitions.Where(d => d.IsArchived == _showArchived);
            var q = _query.Trim();
            if (q.Length > 0)
            {
                scope = scope.Where(d =>
                    d.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || d.Code.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            if (_filterTags.Count > 0)
            {
                scope = scope.Where(d => TagsOf(d.Code).Any(id => _filterTags.Contains(id)));
            }
            return scope;
        }
    }

    /// <summary>Separador de miles del prototipo (toLocaleString('es') -> "1.204").</summary>
    private static string N(int value) => value.ToString("N0", Es);

    /// <summary>La tarjeta es un div con rol de boton: el teclado tiene que abrirla igual.</summary>
    private Task OnCardKeyAsync(KeyboardEventArgs e, Guid id)
    {
        if (e.Key is "Enter" or " ") { OpenDesigner(id); }
        return Task.CompletedTask;
    }

    /// <summary>
    /// Restaurar es inocuo, asi que va directo. Archivar pide confirmacion: retira el formulario
    /// de circulacion y conviene ver antes cuantas respuestas tiene.
    /// </summary>
    private async Task AskArchiveAsync(FormDefinitionListItemDto d)
    {
        if (d.IsArchived) { await SetArchivedAsync(d, false); return; }
        _confirmError = null;
        _confirming = d;
    }

    private void CloseConfirm()
    {
        _confirming = null;
        _confirmError = null;
    }

    private async Task ConfirmArchiveAsync()
    {
        if (_confirming is null) { return; }
        if (await SetArchivedAsync(_confirming, true)) { CloseConfirm(); }
    }

    /// <summary>
    /// Devuelve false si el servicio lo rechazo (p.ej. el formulario esta en uso): el error se
    /// muestra DENTRO del dialogo, que es donde esta mirando el usuario.
    /// </summary>
    private async Task<bool> SetArchivedAsync(FormDefinitionListItemDto d, bool archived)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await FormsSvc.SetArchivedAsync(d.Id, archived);
            if (!result.IsOk)
            {
                var msg = result.Error ?? "No se pudo archivar el formulario.";
                if (_confirming is not null) { _confirmError = msg; } else { _error = msg; }
                return false;
            }
            _definitions = (await FormsSvc.ListAsync(includeArchived: true)).ToList();
            // Si se restauro el ultimo archivado, esta pestana quedo vacia: no dejar al usuario
            // mirando una lista sin nada y con el tab deshabilitado.
            if (_showArchived && ArchivedCount == 0) { _showArchived = false; }
            return true;
        }
        finally
        {
            _busy = false;
        }
    }

    // Estados del prototipo: Active=Publicado, Draft=Borrador, IsArchived=Archivado.
    // Inactive (retirado) usa el tono gris de Archivado con su propio rotulo.
    internal static string StatusLabel(FormStatus status) => status switch
    {
        FormStatus.Draft => "Borrador",
        FormStatus.Active => "Publicado",
        FormStatus.Inactive => "Inactivo",
        _ => status.ToString()
    };

    private static string EstadoLabel(FormDefinitionListItemDto d)
        => d.IsArchived ? "Archivado" : StatusLabel(d.Status);

    private static string Tone(FormDefinitionListItemDto d) => d.IsArchived
        ? "var(--ink-3)"
        : d.Status switch
        {
            FormStatus.Active => "var(--t-green)",
            FormStatus.Draft => "var(--t-amber)",
            _ => "var(--ink-3)"
        };

    private static string ToneSoft(FormDefinitionListItemDto d) => d.IsArchived
        ? "var(--surface-3)"
        : d.Status switch
        {
            FormStatus.Active => "var(--t-green-bg)",
            FormStatus.Draft => "var(--t-amber-bg)",
            _ => "var(--surface-3)"
        };

    /// <summary>
    /// El modelo no tiene campo Categoria (deuda ADR-0021): el badge muestra la categoria
    /// del modulo del prototipo como valor fijo.
    /// </summary>
    private static string Category(FormDefinitionListItemDto d) => "General";

    private void OpenDesigner(Guid id) => Nav.NavigateTo($"/formularios/{id}/disenar");

    private void OpenImport() { _importError = null; _importJson = ""; _importOpen = true; }
    private void CloseImport() { _importOpen = false; _importError = null; }

    /// <summary>Importa un formulario desde JSON (crea uno NUEVO con codigo unico) y abre el constructor.</summary>
    private async Task DoImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_importJson)) { return; }
        _busy = true;
        _importError = null;
        try
        {
            var result = await FormsSvc.ImportAsync(_importJson);
            if (!result.IsOk || result.Value is null)
            {
                _importError = result.Error ?? "No se pudo importar el formulario.";
                return;
            }
            _importOpen = false;
            Nav.NavigateTo($"/formularios/{result.Value.Id}/disenar");
        }
        finally { _busy = false; }
    }

    /// <summary>Exporta la definicion completa a JSON y la descarga como archivo.</summary>
    private async Task ExportAsync(FormDefinitionListItemDto d)
    {
        _error = null;
        var result = await FormsSvc.ExportAsync(d.Id);
        if (!result.IsOk || result.Value is null)
        {
            _error = result.Error ?? "No se pudo exportar el formulario.";
            return;
        }
        var safe = new string((d.Code ?? "form").Where(char.IsLetterOrDigit).ToArray());
        if (safe.Length == 0) { safe = "form"; }
        await JS.InvokeVoidAsync("ecorexDownloadText", $"form-{safe}.json", result.Value);
    }

    /// <summary>"Nuevo formulario" del prototipo: crea (codigo FRM-### siguiente) y abre el constructor.</summary>
    private async Task CreateAndOpenAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var next = 1;
            foreach (var d in _definitions)
            {
                var tail = d.Code.Split('-')[^1];
                if (int.TryParse(tail, out var n) && n >= next)
                {
                    next = n + 1;
                }
            }
            var result = await FormsSvc.CreateAsync(new CreateFormDefinitionRequest(
                $"FRM-{next:000}", "Formulario nuevo"));
            if (!result.IsOk || result.Value is null)
            {
                _error = result.Error ?? "No se pudo crear el formulario.";
                return;
            }
            Nav.NavigateTo($"/formularios/{result.Value.Id}/disenar");
        }
        finally
        {
            _busy = false;
        }
    }
