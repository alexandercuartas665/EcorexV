    private static string? BuscarCarpetaNombre(IReadOnlyList<CarpetaDto> nodos, Guid id)
    {
        foreach (var n in nodos)
        {
            if (n.Id == id) { return n.Nombre; }
            var hit = BuscarCarpetaNombre(n.Subcarpetas, id);
            if (hit is not null) { return hit; }
        }
        return null;
    }

