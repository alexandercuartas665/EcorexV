@page "/gestor-documental"
@attribute [Authorize(Policy = "Perm:gestor-documental:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Ecorex.Application.Documentos
@using Ecorex.Application.Roles
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Auth
@using Ecorex.SuperAdmin.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IDocumentoService DocSvc
@inject IExpedienteService ExpSvc
@inject ICurrentPermissions Perms
@inject IJSRuntime JS

@* Gestor Documental (portado del modulo 2.15 del hermano PROPIA).
   Dos vistas independientes en una pantalla, igual que en el origen:
     - Archivo central: categoria -> carpetas -> documentos con versionado.
     - Expedientes: Tabla de Retencion Documental y su checklist.
   Estructura y tokens del workspace ECOREX (--brand/--ink/--surface/--line), NO los de PROPIA. *@

<PageTitle>Gestor Documental - ECOREX.tareas</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <span>Gestor Documental</span>
    <span class="sep">/</span>
    <span class="cur">@(_vista == Vista.Archivo ? "Archivo central" : "Expedientes")</span>
</nav>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
            </div>
            <span>Gestor Documental</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Documentos</h1>
        <p class="page-sub" style="margin-bottom:0;">
            Archivo digital del tenant: expedientes por serie documental y archivo central con versionado.
        </p>
    </div>
    <div class="gd-head-actions">
        @if (_vista == Vista.Archivo && _canCreate)
        {
            <button class="gd-btn" @onclick="AbrirConfiguracion">Configuracion</button>
            <button class="gd-btn primary" @onclick="AbrirSubir">Subir documento</button>
        }
        else if (_vista == Vista.Expedientes && _canCreate)
        {
            <button class="gd-btn" @onclick="AbrirTrd">Configuracion documental</button>
            <button class="gd-btn primary" @onclick="AbrirNuevoExpediente">Nuevo expediente</button>
        }
    </div>
</div>

<div class="gd-tabs" role="tablist">
    <button class="gd-tab @(_vista == Vista.Archivo ? "on" : "")" role="tab"
            @onclick="() => CambiarVistaAsync(Vista.Archivo)">Archivo central</button>
    <button class="gd-tab @(_vista == Vista.Expedientes ? "on" : "")" role="tab"
            @onclick="() => CambiarVistaAsync(Vista.Expedientes)">Expedientes</button>
</div>

@if (_mensaje is not null)
{
    <div class="gd-banner @(_mensajeEsError ? "err" : "ok")">@_mensaje</div>
}

@if (_cargando)
{
    <p><em>Cargando...</em></p>
}
else if (_vista == Vista.Archivo)
{
    @* ================= ARCHIVO CENTRAL ================= *@
    <div class="gd-resumen">
        <div class="gd-kpi"><span class="lbl">Documentos</span><span class="val">@_resumen?.TotalDocumentos</span></div>
        <div class="gd-kpi"><span class="lbl">Categorias</span><span class="val">@_resumen?.TotalCategorias</span></div>
        <div class="gd-kpi"><span class="lbl">Carpetas</span><span class="val">@_resumen?.TotalCarpetas</span></div>
        <div class="gd-kpi"><span class="lbl">Espacio</span><span class="val">@FormatoTamano(_resumen?.TamanoTotalBytes ?? 0)</span></div>
        <div class="gd-kpi"><span class="lbl">Ultimos 30 dias</span><span class="val">@_resumen?.DocumentosUltimos30Dias</span></div>
    </div>

    <div class="gd-split">
        @* ---- Panel izquierdo: categorias y arbol de carpetas ---- *@
        <aside class="gd-side">
            <div class="gd-side-head">Categorias</div>
            <button class="gd-cat @(_categoriaSel is null ? "on" : "")" @onclick="() => SeleccionarCategoriaAsync(null)">
                <span class="gd-cat-name">Todas</span>
                <span class="gd-cat-count">@(_resumen?.TotalDocumentos ?? 0)</span>
            </button>
            @foreach (var c in _categorias)
            {
                var cat = c;
                <button class="gd-cat @(_categoriaSel == cat.Id ? "on" : "")" @onclick="() => SeleccionarCategoriaAsync(cat.Id)">
                    <span class="gd-cat-dot" style="background:@(cat.Color ?? "var(--brand)");"></span>
                    <span class="gd-cat-name">@cat.Nombre</span>
                    <span class="gd-cat-count">@cat.NumeroDocumentos</span>
                </button>
            }

            @if (_categoriaSel is not null)
            {
                <div class="gd-side-head" style="margin-top:16px;">
                    Carpetas
                    @if (_canCreate)
                    {
                        <button class="gd-link" @onclick="() => AbrirNuevaCarpeta(null)">+ nueva</button>
                    }
                </div>
                @if (_carpetas.Count == 0)
                {
                    <div class="gd-side-empty">Sin carpetas en esta categoria.</div>
                }
                else
                {
                    <button class="gd-carp @(_carpetaSel is null ? "on" : "")" @onclick="() => SeleccionarCarpetaAsync(null)">
                        (raiz de la categoria)
                    </button>
                    @foreach (var nodo in _carpetas)
                    {
                        @RenderCarpeta(nodo, 0)
                    }
                }
            }
        </aside>

        @* ---- Panel derecho: filtros + tabla de documentos ---- *@
        <section class="gd-main">
            @if (_categoriaSel is not null)
            {
                <div class="gd-ubic">
                    <span class="gd-ubic-cat">@(_categorias.FirstOrDefault(c => c.Id == _categoriaSel)?.Nombre)</span>
                    @foreach (var seg in RutaCarpeta())
                    {
                        <span class="gd-ubic-sep">/</span>
                        <span>@seg</span>
                    }
                </div>
            }
            <div class="gd-filtros">
                <input class="gd-input" placeholder="Buscar por titulo o archivo..." value="@_busqueda"
                       @onchange="OnBuscarAsync" />
                <select class="gd-input" value="@(_estadoFiltro?.ToString() ?? "")" @onchange="OnEstadoFiltroAsync">
                    <option value="">Todos los estados</option>
                    <option value="@EstadoDocumento.Borrador">Borrador</option>
                    <option value="@EstadoDocumento.Vigente">Vigente</option>
                    <option value="@EstadoDocumento.Archivado">Archivado</option>
                </select>
                <select class="gd-input" value="@(_etiquetaFiltro?.ToString() ?? "")" @onchange="OnEtiquetaFiltroAsync">
                    <option value="">Todas las etiquetas</option>
                    @foreach (var e in _etiquetas)
                    {
                        <option value="@e.Id">@e.Nombre</option>
                    }
                </select>
                <label class="gd-check">
                    <input type="checkbox" checked="@_soloDestacados" @onchange="OnDestacadosFiltroAsync" />
                    <span>Solo destacados</span>
                </label>
            </div>

            @if (_pagina is null || _pagina.Items.Count == 0)
            {
                <div class="gd-empty">
                    <h3>Sin documentos</h3>
                    <p>No hay documentos que coincidan. Sube el primero con "Subir documento".</p>
                </div>
            }
            else
            {
                <table class="gd-tabla">
                    <thead>
                        <tr>
                            <th style="width:32px;"></th>
                            <th>Documento</th>
                            <th>Ubicacion</th>
                            <th>Estado</th>
                            <th>Ver.</th>
                            <th>Tamano</th>
                            <th>Fecha</th>
                            <th style="width:150px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _pagina.Items)
                        {
                            var doc = d;
                            <tr>
                                <td>
                                    <button class="gd-pin @(doc.DestacadoPersonal ? "on" : "")" title="Destacar para mi"
                                            @onclick="() => AlternarPinAsync(doc.Id)">&#9733;</button>
                                </td>
                                <td>
                                    <div class="gd-doc-tit">@doc.Titulo</div>
                                    <div class="gd-doc-sub">@doc.NombreArchivoOriginal</div>
                                    @if (doc.Etiquetas.Count > 0)
                                    {
                                        <div class="gd-chips">
                                            @foreach (var et in doc.Etiquetas)
                                            {
                                                <span class="gd-chip" style="border-color:@(et.Color ?? "var(--line-2)");">@et.Nombre</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="gd-td-min">@doc.CategoriaNombre@(doc.CarpetaNombre is null ? "" : " / " + doc.CarpetaNombre)</td>
                                <td><span class="gd-estado @doc.Estado.ToString().ToLowerInvariant()">@doc.Estado</span></td>
                                <td class="gd-td-min">v@doc.NumeroVersiones</td>
                                <td class="gd-td-min">@FormatoTamano(doc.TamanoBytes)</td>
                                <td class="gd-td-min">@doc.CreadoAt.LocalDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                <td class="gd-acciones">
                                    <button class="gd-btn sm" @onclick="() => AbrirDetalleAsync(doc.Id)">Ver</button>
                                    <button class="gd-btn sm" @onclick="() => DescargarAsync(doc.Id)" disabled="@_ocupado">Descargar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_pagina.Total > _pagina.PageSize)
                {
                    <div class="gd-paginador">
                        <button class="gd-btn sm" disabled="@(_pagina.Page <= 1)" @onclick="() => IrPaginaAsync(_pagina.Page - 1)">Anterior</button>
                        <span>Pagina @_pagina.Page de @((_pagina.Total + _pagina.PageSize - 1) / _pagina.PageSize) &#183; @_pagina.Total documentos</span>
                        <button class="gd-btn sm" disabled="@(_pagina.Page * _pagina.PageSize >= _pagina.Total)" @onclick="() => IrPaginaAsync(_pagina.Page + 1)">Siguiente</button>
                    </div>
                }
            }
        </section>
    </div>
}
else
{
    @* ================= EXPEDIENTES (TRD) ================= *@
    @if (_expedientes.Count == 0)
    {
        <div class="gd-empty">
            <h3>Sin expedientes</h3>
            <p>Configura la tabla de retencion documental y abre el primer expediente.</p>
        </div>
    }
    else
    {
        <div class="gd-exp-grid">
            @foreach (var e in _expedientes)
            {
                var exp = e;
                <div class="gd-exp-card">
                    <div class="gd-exp-head">
                        <span class="gd-exp-cod">@exp.Codigo</span>
                        @if (exp.PendientesObligatorias > 0)
                        {
                            <span class="gd-exp-badge pend">@exp.PendientesObligatorias pendientes</span>
                        }
                        else
                        {
                            <span class="gd-exp-badge ok">Completo</span>
                        }
                    </div>
                    <div class="gd-exp-nombre">@exp.Nombre</div>
                    <div class="gd-exp-trd">@exp.Serie &#183; @exp.Subserie</div>
                    <div class="gd-exp-prog">
                        <div class="gd-exp-bar"><span style="width:@(exp.Total == 0 ? 0 : exp.Cargadas * 100 / exp.Total)%;"></span></div>
                        <span class="gd-exp-num">@exp.Cargadas/@exp.Total</span>
                    </div>
                    <div class="gd-exp-actions">
                        <button class="gd-btn sm primary" @onclick="() => AbrirExpedienteAsync(exp.Id)">Abrir</button>
                    </div>
                </div>
            }
        </div>
    }
}

@* ===================== MODAL: subir documento ===================== *@
@if (_subirOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:640px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Subir documento</h3>
                <button class="modal-close" @onclick="() => _subirOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Titulo *</label>
                    <input class="gd-input w100" @bind="_fTitulo" />
                </div>
                <div class="field">
                    <label class="form-label">Descripcion</label>
                    <textarea class="gd-input w100" rows="2" @bind="_fDescripcion"></textarea>
                </div>
                <div class="gd-row2">
                    <div class="field">
                        <label class="form-label">Categoria *</label>
                        <select class="gd-input w100" value="@(_fCategoriaId?.ToString() ?? "")" @onchange="OnCategoriaFormChangedAsync">
                            <option value="">-- Elige --</option>
                            @foreach (var c in _categorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="form-label">Carpeta</label>
                        <select class="gd-input w100" value="@(_fCarpetaId?.ToString() ?? "")"
                                @onchange="e => _fCarpetaId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null"
                                disabled="@(_carpetasForm.Count == 0)">
                            <option value="">(raiz de la categoria)</option>
                            @foreach (var c in _carpetasForm)
                            {
                                <option value="@c.Id">@c.Ruta</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="gd-row2">
                    <div class="field">
                        <label class="form-label">Visibilidad</label>
                        <select class="gd-input w100" value="@_fVisibilidad"
                                @onchange="e => _fVisibilidad = Enum.TryParse<VisibilidadDocumento>(e.Value?.ToString(), out var v) ? v : VisibilidadDocumento.Equipo">
                            <option value="@VisibilidadDocumento.Privado">Privado</option>
                            <option value="@VisibilidadDocumento.Equipo">Equipo</option>
                            <option value="@VisibilidadDocumento.Publico">Publico</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="form-label">Archivo *</label>
                        <InputFile class="gd-input w100" accept="@DocumentUploadGuard.Accept" OnChange="OnArchivoElegidoAsync" />
                        @if (_fArchivoNombre is not null)
                        {
                            <small class="gd-help">@_fArchivoNombre &#183; @FormatoTamano(_fArchivoBytes?.LongLength ?? 0)</small>
                        }
                    </div>
                </div>
                @if (_etiquetas.Count > 0)
                {
                    <div class="field">
                        <label class="form-label">Etiquetas</label>
                        <div class="gd-chips">
                            @foreach (var e in _etiquetas)
                            {
                                var et = e;
                                <button type="button" class="gd-chip sel @(_fEtiquetas.Contains(et.Id) ? "on" : "")"
                                        @onclick="() => AlternarEtiquetaForm(et.Id)">@et.Nombre</button>
                            }
                        </div>
                    </div>
                }
                @if (_modalError is not null)
                {
                    <div class="tk-field-error">@_modalError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="gd-btn" @onclick="() => _subirOpen = false">Cancelar</button>
                <button class="gd-btn primary" @onclick="GuardarDocumentoAsync" disabled="@_ocupado">Subir</button>
            </div>
        </div>
    </div>
}

@* ===================== MODAL: detalle del documento ===================== *@
@if (_detalle is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:820px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@_detalle.Titulo</h3>
                <button class="modal-close" @onclick="() => _detalle = null">&times;</button>
            </div>
            <div class="modal-body">
                <div class="gd-det-meta">
                    <div><span class="lbl">Ubicacion</span><span>@_detalle.CategoriaNombre@(_detalle.CarpetaNombre is null ? "" : " / " + _detalle.CarpetaNombre)</span></div>
                    <div><span class="lbl">Estado</span><span class="gd-estado @_detalle.Estado.ToString().ToLowerInvariant()">@_detalle.Estado</span></div>
                    <div><span class="lbl">Visibilidad</span><span>@_detalle.Visibilidad</span></div>
                    <div><span class="lbl">Origen</span><span>@_detalle.Origen</span></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_detalle.Descripcion))
                {
                    <p class="gd-det-desc">@_detalle.Descripcion</p>
                }

                <div class="gd-det-tabs">
                    <button class="gd-tab sm @(_detTab == "visor" ? "on" : "")" @onclick='() => _detTab = "visor"'>Vista previa</button>
                    <button class="gd-tab sm @(_detTab == "versiones" ? "on" : "")" @onclick='() => _detTab = "versiones"'>Versiones (@_detalle.NumeroVersiones)</button>
                    <button class="gd-tab sm @(_detTab == "bitacora" ? "on" : "")" @onclick="MostrarBitacoraAsync">Bitacora</button>
                    <button class="gd-tab sm @(_detTab == "uso" ? "on" : "")" @onclick="MostrarUsoAsync">Uso</button>
                </div>

                @if (_detTab == "visor")
                {
                    @if (_detalle.VersionActual is { } va)
                    {
                        <div class="gd-visor">
                            @if (EsImagen(va.TipoMime))
                            {
                                <img src="@va.UrlStorage" alt="@va.NombreArchivo" />
                            }
                            else if (EsPdf(va.TipoMime))
                            {
                                <iframe src="@va.UrlStorage" title="@va.NombreArchivo"></iframe>
                            }
                            else
                            {
                                <div class="gd-visor-none">
                                    <p>Sin vista previa para este formato (@va.NombreArchivo).</p>
                                    <button class="gd-btn sm primary" @onclick="() => DescargarAsync(_detalle!.Id)" disabled="@_ocupado">Descargar</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="gd-visor-none"><p>Este documento no tiene archivo.</p></div>
                    }
                }
                else if (_detTab == "versiones")
                {
                    <table class="gd-tabla compact">
                        <thead><tr><th>Ver.</th><th>Archivo</th><th>Tamano</th><th>SHA-256</th><th>Fecha</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var v in _detalle.Historial)
                            {
                                var ver = v;
                                <tr>
                                    <td>v@ver.Numero @(ver.Id == _detalle.VersionActual?.Id ? "(actual)" : "")</td>
                                    <td>@ver.NombreArchivo</td>
                                    <td>@FormatoTamano(ver.TamanoBytes)</td>
                                    <td class="gd-hash" title="@ver.HashSha256">@ver.HashSha256[..12]</td>
                                    <td>@ver.CreadoAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                                    <td><button class="gd-btn sm" @onclick="() => DescargarAsync(_detalle!.Id, ver.Id)" disabled="@_ocupado">Descargar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_canEdit)
                    {
                        <div class="gd-nueva-ver">
                            <label class="form-label">Subir nueva version</label>
                            <InputFile class="gd-input" accept="@DocumentUploadGuard.Accept" OnChange="OnNuevaVersionElegidaAsync" />
                            <input class="gd-input" placeholder="Que cambio (opcional)" @bind="_fNotasCambio" />
                            <button class="gd-btn primary sm" @onclick="GuardarNuevaVersionAsync" disabled="@(_ocupado || _fVerBytes is null)">Guardar version</button>
                        </div>
                    }
                }
                else if (_detTab == "bitacora")
                {
                    <table class="gd-tabla compact">
                        <thead><tr><th>Evento</th><th>Detalle</th><th>Fecha</th></tr></thead>
                        <tbody>
                            @foreach (var a in _auditoria)
                            {
                                <tr>
                                    <td>@a.TipoEvento</td>
                                    <td class="gd-hash">@a.DetalleJson</td>
                                    <td>@a.OcurridoAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_estadisticas is not null)
                {
                    <div class="gd-resumen">
                        <div class="gd-kpi"><span class="lbl">Vistas</span><span class="val">@_estadisticas.TotalVistas</span></div>
                        <div class="gd-kpi"><span class="lbl">Descargas</span><span class="val">@_estadisticas.TotalDescargas</span></div>
                        <div class="gd-kpi"><span class="lbl">Usuarios</span><span class="val">@_estadisticas.UsuariosUnicos</span></div>
                        <div class="gd-kpi">
                            <span class="lbl">Ultimo acceso</span>
                            <span class="val">@(_estadisticas.UltimoAcceso?.LocalDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-")</span>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-foot">
                @if (_canEdit)
                {
                    @if (_detalle.Estado == EstadoDocumento.Vigente)
                    {
                        <button class="gd-btn" @onclick="() => CambiarEstadoAsync(EstadoDocumento.Archivado)" disabled="@_ocupado">Archivar</button>
                    }
                    else if (_detalle.Estado == EstadoDocumento.Archivado)
                    {
                        <button class="gd-btn" @onclick="() => CambiarEstadoAsync(EstadoDocumento.Vigente)" disabled="@_ocupado">Reactivar</button>
                    }
                }
                @if (_canDelete)
                {
                    <button class="gd-btn danger" @onclick="EliminarDocumentoAsync" disabled="@_ocupado">Eliminar</button>
                }
                <button class="gd-btn" @onclick="() => _detalle = null">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ===================== MODAL: expediente ===================== *@
@if (_expDetalle is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:1060px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@_expDetalle.Codigo &#183; @_expDetalle.Nombre</h3>
                <button class="modal-close" @onclick="() => _expDetalle = null">&times;</button>
            </div>
            <div class="modal-body">
                <div class="gd-exp3">
                    @* ---- Col izquierda: datos del expediente ---- *@
                    <div class="gd-exp3-side">
                        <div class="gd-det-meta col">
                            <div><span class="lbl">Serie</span><span>@_expDetalle.Serie</span></div>
                            <div><span class="lbl">Subserie</span><span>@_expDetalle.Subserie</span></div>
                            <div><span class="lbl">Avance</span><span>@_expDetalle.Cargadas de @_expDetalle.Total</span></div>
                        </div>
                        @if (_expDetalle.Campos.Count > 0)
                        {
                            <div class="gd-exp3-h">Metadatos del expediente</div>
                            @foreach (var c in _expDetalle.Campos)
                            {
                                <div class="gd-exp3-campo">@c.Label</div>
                            }
                        }
                    </div>

                    @* ---- Col centro: visor del documento seleccionado ---- *@
                    <div class="gd-exp3-visor">
                        @if (ExpTipSel is { Cargado: true } sel)
                        {
                            <div class="gd-visor">
                                @if (EsImagen(sel.ArchivoMime))
                                {
                                    <img src="@sel.ArchivoUrl" alt="@sel.ArchivoNombre" />
                                }
                                else if (EsPdf(sel.ArchivoMime))
                                {
                                    <iframe src="@sel.ArchivoUrl" title="@sel.ArchivoNombre"></iframe>
                                }
                                else
                                {
                                    <div class="gd-visor-none">
                                        <p>@sel.ArchivoNombre</p>
                                        <button class="gd-btn sm primary" @onclick="() => DescargarTipologiaAsync(sel.Id)" disabled="@_ocupado">Descargar</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="gd-visor-none"><p>Elige un documento cargado del checklist para verlo aqui.</p></div>
                        }
                    </div>

                    @* ---- Col derecha: checklist de tipologias ---- *@
                    <div class="gd-exp3-check">
                        @foreach (var t in _expDetalle.Tipologias)
                        {
                            var tip = t;
                            <div class="gd-chk @(tip.Cargado ? "ok" : "") @(_expTipSel == tip.Id ? "sel" : "")"
                                 @onclick="() => SeleccionarTipologia(tip)">
                                <div class="gd-chk-top">
                                    <span class="gd-chk-dot @(tip.Cargado ? "on" : "")"></span>
                                    <span class="gd-chk-name">@tip.Nombre</span>
                                    @if (tip.Obligatoria) { <span class="gd-oblig">oblig</span> }
                                </div>
                                @if (tip.Cargado)
                                {
                                    <div class="gd-chk-file">@tip.ArchivoNombre &#183; @FormatoTamano(tip.ArchivoTamano)</div>
                                    <div class="gd-chk-actions">
                                        <button class="gd-btn sm" @onclick:stopPropagation="true" @onclick="() => DescargarTipologiaAsync(tip.Id)" disabled="@_ocupado">Descargar</button>
                                        @if (_canEdit)
                                        {
                                            <button class="gd-btn sm danger" @onclick:stopPropagation="true" @onclick="() => QuitarArchivoAsync(tip.Id)" disabled="@_ocupado">Quitar</button>
                                        }
                                    </div>
                                }
                                else if (_canEdit)
                                {
                                    <div class="gd-chk-actions" @onclick:stopPropagation="true">
                                        <InputFile class="gd-file-min" accept="@DocumentUploadGuard.Accept"
                                                   OnChange="e => CargarTipologiaAsync(tip.Id, e)" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="gd-btn" @onclick="() => _expDetalle = null">Cerrar</button>
            </div>
        </div>
    </div>
}

