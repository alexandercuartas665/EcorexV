    // =======================================================================

    /// <summary>
    /// Lee el archivo elegido aplicando el guard: extension de lista blanca, tamano y BYTES
    /// MAGICOS. Solo la ultima comprobacion es infalsificable renombrando el archivo, que es
    /// justo el motivo de leer el contenido antes de aceptarlo.
    /// </summary>
    private async Task<(byte[] Bytes, string Nombre, string Mime)?> LeerArchivoAsync(IBrowserFile file)
    {
        var ext = DocumentUploadGuard.ResolveExtension(file.Name);
        if (ext is null)
        {
            Avisar($"{file.Name}: formato no permitido. Solo {DocumentUploadGuard.FormatosTexto}.", true);
            return null;
        }
        if (file.Size <= 0)
        {
            Avisar($"{file.Name}: el archivo esta vacio.", true);
            return null;
        }
        if (file.Size > DocumentUploadGuard.MaxBytes)
        {
            Avisar($"{file.Name}: supera el limite de {DocumentUploadGuard.MaxBytes / (1024 * 1024)} MB.", true);
            return null;
        }

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(DocumentUploadGuard.MaxBytes).CopyToAsync(ms);
            var bytes = ms.ToArray();

            if (!DocumentUploadGuard.MatchesSignature(bytes, ext))
            {
                Avisar($"{file.Name}: el contenido no corresponde a un archivo {ext.TrimStart('.').ToUpperInvariant()}.", true);
                return null;
            }
            return (bytes, file.Name, DocumentUploadGuard.MimeFor(ext));
        }
        catch
        {
            Avisar($"{file.Name}: no se pudo leer.", true);
            return null;
        }
    }

    /// <summary>Entrega los bytes al navegador como descarga, sin exponer la ruta fisica.</summary>
    private async Task EnviarAlNavegadorAsync(string nombre, string mime, byte[] contenido)
        => await JS.InvokeVoidAsync("ecorexDescargarArchivo", nombre, mime, Convert.ToBase64String(contenido));

    /// <summary>Aplana el arbol de carpetas a "padre / hijo / nieto" para un desplegable.</summary>
    private static List<CarpetaPlana> Aplanar(IReadOnlyList<CarpetaDto> nodos, string prefijo)
    {
        var salida = new List<CarpetaPlana>();
        foreach (var n in nodos)
        {
            var ruta = prefijo.Length == 0 ? n.Nombre : $"{prefijo} / {n.Nombre}";
            salida.Add(new CarpetaPlana(n.Id, ruta));
            salida.AddRange(Aplanar(n.Subcarpetas, ruta));
        }
        return salida;
    }

    private void Avisar(string texto, bool esError)
    {
        _mensaje = texto;
        _mensajeEsError = esError;
    }

    /// <summary>El visor embebido solo previsualiza imagenes y PDF; el resto ofrece descarga.</summary>
    private static bool EsImagen(string? mime) => mime is not null && mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    private static bool EsPdf(string? mime) => mime is not null && mime.Contains("pdf", StringComparison.OrdinalIgnoreCase);

    private static string FormatoTamano(long bytes)
    {
        if (bytes <= 0) { return "-"; }
        string[] unidades = ["B", "KB", "MB", "GB"];
        double valor = bytes;
        var i = 0;
        while (valor >= 1024 && i < unidades.Length - 1) { valor /= 1024; i++; }
        return $"{valor.ToString(i == 0 ? "0" : "0.#", CultureInfo.InvariantCulture)} {unidades[i]}";
    }

    private RenderFragment RenderCarpeta(CarpetaDto nodo, int nivel) => __builder =>
    {
        <div class="gd-carp-row" style="padding-left:@(nivel * 14)px;">
            <button class="gd-carp @(_carpetaSel == nodo.Id ? "on" : "")"
                    @onclick="() => SeleccionarCarpetaAsync(nodo.Id)">
                <span class="gd-carp-name">@nodo.Nombre</span>
                <span class="gd-cat-count">@nodo.NumeroDocumentos</span>
            </button>
            @if (_canCreate)
            {
                <button class="gd-carp-add" title="Crear subcarpeta" @onclick="() => AbrirNuevaCarpeta(nodo.Id)">+</button>
            }
        </div>
        @foreach (var hijo in nodo.Subcarpetas)
        {
            @RenderCarpeta(hijo, nivel + 1)
        }
    };

    /// <summary>Nombres de carpeta desde la raiz hasta la carpeta seleccionada, para el breadcrumb.</summary>
    private IReadOnlyList<string> RutaCarpeta()
    {
        if (_carpetaSel is not Guid id) { return Array.Empty<string>(); }
        var path = new List<string>();
        return BuscarRuta(_carpetas, id, path) ? path : Array.Empty<string>();
    }

    private static bool BuscarRuta(IReadOnlyList<CarpetaDto> nodos, Guid id, List<string> acc)
    {
        foreach (var n in nodos)
        {
            acc.Add(n.Nombre);
            if (n.Id == id) { return true; }
            if (BuscarRuta(n.Subcarpetas, id, acc)) { return true; }
            acc.RemoveAt(acc.Count - 1);
        }
        return false;
    }
