@code {
    /// <summary>Clave del modulo en la matriz de roles. Es la RUTA, igual que en el resto (ADR-0033).</summary>
    private const string ModuleKey = "gestor-documental";

    private enum Vista { Archivo, Expedientes }

    /// <summary>Carpeta aplanada con su ruta legible, para el selector del formulario.</summary>
    private sealed record CarpetaPlana(Guid Id, string Ruta);

    private Vista _vista = Vista.Archivo;
    private bool _cargando = true;
    private bool _ocupado;
    private string? _mensaje;
    private bool _mensajeEsError;
    private string? _modalError;

    private bool _canCreate, _canEdit, _canDelete;

    // ---- Archivo central ----
    private ResumenDocumentosDto? _resumen;
    private List<CategoriaDto> _categorias = new();
    private List<EtiquetaDto> _etiquetas = new();
    private List<CarpetaDto> _carpetas = new();
    private Guid? _categoriaSel;
    private Guid? _carpetaSel;
    private DocumentosPageDto? _pagina;
    private string _busqueda = "";
    private EstadoDocumento? _estadoFiltro;
    private Guid? _etiquetaFiltro;
    private bool _soloDestacados;
    private int _paginaActual = 1;

    // ---- Modal subir ----
    private bool _subirOpen;
    private string _fTitulo = "";
    private string _fDescripcion = "";
    private Guid? _fCategoriaId;
    private Guid? _fCarpetaId;
    private VisibilidadDocumento _fVisibilidad = VisibilidadDocumento.Equipo;
    private readonly HashSet<Guid> _fEtiquetas = new();
    private byte[]? _fArchivoBytes;
    private string? _fArchivoNombre;
    private string? _fArchivoMime;
    private List<CarpetaPlana> _carpetasForm = new();

    // ---- Modal detalle ----
    private DocumentoDetalleDto? _detalle;
    private string _detTab = "versiones";
    private List<AuditoriaEventoDto> _auditoria = new();
    private EstadisticasDocumentoDto? _estadisticas;
    private byte[]? _fVerBytes;
    private string? _fVerNombre;
    private string? _fVerMime;
    private string _fNotasCambio = "";

    // ---- Expedientes ----
    private List<ExpedienteListaDto> _expedientes = new();
    private List<TrdSerieDto> _trd = new();
    private ExpedienteDetalleDto? _expDetalle;
    private bool _nuevoExpOpen;
    private Guid? _fSubserieId;
    private string _fExpNombre = "";
    private Guid? _expTipSel;   // tipologia seleccionada en el visor del expediente

    // ---- Modal configuracion (categorias + etiquetas) ----
    private bool _cfgOpen;
    private string _cfgTab = "categorias";
    private string? _cfgError;
    private Guid? _catEditId;
    private string _catNombre = "";
    private string _catDescripcion = "";
    private string _catColor = "#2563eb";
    private Guid? _etqEditId;
    private string _etqNombre = "";
    private string _etqColor = "#2563eb";

    // ---- Modal editor de la TRD ----
    private bool _trdOpen;
    private string? _trdError;
    private Guid? _trdSerieSel;
    private Guid? _trdSubserieSel;
    private string _serieNombre = "";
    private string _subserieNombre = "";
    private string _tipoNombre = "";
    private bool _tipoOblig;
    private string _campoLabel = "";

    // ---- Modal nueva carpeta ----
    private bool _carpOpen;
    private Guid? _carpPadreId;
    private string? _carpPadreNombre;
    private string _carpNombre = "";
    private string _carpDescripcion = "";
    private string? _carpError;

    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        _canCreate = eff.Can(ModuleKey, PermissionAction.Create);
        _canEdit = eff.Can(ModuleKey, PermissionAction.Edit);
        _canDelete = eff.Can(ModuleKey, PermissionAction.Delete);
        await RecargarArchivoAsync();
        _cargando = false;
    }

    // =======================================================================
    // Archivo central
    // =======================================================================

    private async Task RecargarArchivoAsync()
    {
        _resumen = await DocSvc.GetResumenAsync();
        _categorias = (await DocSvc.ListarCategoriasAsync()).ToList();
        _etiquetas = (await DocSvc.ListarEtiquetasAsync()).ToList();
        await RecargarDocumentosAsync();
    }

    private async Task RecargarDocumentosAsync()
        => _pagina = await DocSvc.ListarDocumentosAsync(new DocumentosFiltro(
            CategoriaId: _categoriaSel,
            CarpetaId: _carpetaSel,
            Estado: _estadoFiltro,
            TextoBusqueda: string.IsNullOrWhiteSpace(_busqueda) ? null : _busqueda,
            EtiquetaId: _etiquetaFiltro,
            SoloDestacados: _soloDestacados,
            Page: _paginaActual));

    private async Task CambiarVistaAsync(Vista v)
    {
        _vista = v;
        _mensaje = null;
        _cargando = true;
        if (v == Vista.Expedientes)
        {
            _trd = (await ExpSvc.ListarTrdAsync()).ToList();
            _expedientes = (await ExpSvc.ListarExpedientesAsync()).ToList();
        }
        else
        {
            await RecargarArchivoAsync();
        }
        _cargando = false;
    }

    private async Task SeleccionarCategoriaAsync(Guid? id)
    {
        _categoriaSel = id;
        _carpetaSel = null;
        _paginaActual = 1;
        _carpetas = id is Guid cid ? (await DocSvc.ListarCarpetasAsync(cid)).ToList() : new();
        await RecargarDocumentosAsync();
    }

    private async Task SeleccionarCarpetaAsync(Guid? id)
    {
        _carpetaSel = id;
        _paginaActual = 1;
        await RecargarDocumentosAsync();
    }

    private async Task OnBuscarAsync(ChangeEventArgs e)
    {
        _busqueda = e.Value?.ToString() ?? "";
        _paginaActual = 1;
        await RecargarDocumentosAsync();
    }

    private async Task OnEstadoFiltroAsync(ChangeEventArgs e)
    {
        _estadoFiltro = Enum.TryParse<EstadoDocumento>(e.Value?.ToString(), out var v) ? v : null;
        _paginaActual = 1;
        await RecargarDocumentosAsync();
    }

    private async Task OnEtiquetaFiltroAsync(ChangeEventArgs e)
    {
        _etiquetaFiltro = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _paginaActual = 1;
        await RecargarDocumentosAsync();
    }

    private async Task OnDestacadosFiltroAsync(ChangeEventArgs e)
    {
        _soloDestacados = (bool)(e.Value ?? false);
        _paginaActual = 1;
        await RecargarDocumentosAsync();
    }

    private async Task IrPaginaAsync(int p)
    {
        _paginaActual = p < 1 ? 1 : p;
        await RecargarDocumentosAsync();
    }

    private async Task AlternarPinAsync(Guid id)
    {
        await DocSvc.AlternarDestacadoPersonalAsync(id);
        await RecargarDocumentosAsync();
    }

    // ---- Subida ----

    private void AbrirSubir()
    {
        _fTitulo = "";
        _fDescripcion = "";
        _fCategoriaId = _categoriaSel ?? _categorias.FirstOrDefault()?.Id;
        _fCarpetaId = _carpetaSel;
        _fVisibilidad = VisibilidadDocumento.Equipo;
        _fEtiquetas.Clear();
        _fArchivoBytes = null;
        _fArchivoNombre = null;
        _fArchivoMime = null;
        _carpetasForm = _fCategoriaId is null ? new() : Aplanar(_carpetas, "");
        _modalError = null;
        _subirOpen = true;
    }

    private async Task OnCategoriaFormChangedAsync(ChangeEventArgs e)
    {
        _fCategoriaId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _fCarpetaId = null;
        _carpetasForm = _fCategoriaId is Guid cid
            ? Aplanar((await DocSvc.ListarCarpetasAsync(cid)).ToList(), "")
            : new();
    }

    private void AlternarEtiquetaForm(Guid id)
    {
        if (!_fEtiquetas.Add(id)) { _fEtiquetas.Remove(id); }
    }

    private async Task OnArchivoElegidoAsync(InputFileChangeEventArgs e)
    {
        _modalError = null;
        var leido = await LeerArchivoAsync(e.File);
        if (leido is null) { return; }
        (_fArchivoBytes, _fArchivoNombre, _fArchivoMime) = leido.Value;
        if (string.IsNullOrWhiteSpace(_fTitulo))
        {
            _fTitulo = System.IO.Path.GetFileNameWithoutExtension(_fArchivoNombre ?? "");
        }
    }

    private async Task GuardarDocumentoAsync()
    {
        _modalError = null;
        if (_fCategoriaId is not Guid catId) { _modalError = "Elige una categoria."; return; }
        if (_fArchivoBytes is null) { _modalError = "Elige un archivo."; return; }

        _ocupado = true;
        try
        {
            var res = await DocSvc.SubirDocumentoAsync(new SubirDocumentoRequest(
                catId, _fCarpetaId, _fTitulo, _fDescripcion,
                _fArchivoNombre ?? "archivo", _fArchivoMime ?? "application/octet-stream",
                _fArchivoBytes, _fVisibilidad, _fEtiquetas.ToList()));
            if (!res.IsOk) { _modalError = res.Error; return; }
            _subirOpen = false;
            Avisar("Documento subido.", false);
            await RecargarArchivoAsync();
        }
        finally { _ocupado = false; }
    }

    // ---- Detalle ----

    private async Task AbrirDetalleAsync(Guid id)
    {
        _detTab = "visor";
        _auditoria = new();
        _estadisticas = null;
