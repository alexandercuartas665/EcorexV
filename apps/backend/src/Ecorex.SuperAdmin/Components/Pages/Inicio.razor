                <div class="dash-mod-foot">
                    <span class="dash-mod-go">Ir al modulo
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </span>
                    <span class="dash-mod-code">000802</span>
                </div>
            </a>
        </div>
    </div>
</div>

<TaskWizard @ref="_wizard" OnCreated="OnTaskCreatedAsync" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly CultureInfo Es = new("es-CO");

    private static readonly TaskItemStatus[] ActiveStatuses =
    [
        TaskItemStatus.Pending,
        TaskItemStatus.Active,
        TaskItemStatus.InProgress
    ];

    private TaskWizard? _wizard;

    private string _greeting = "Hola";
    private string? _firstName;
    private string? _tenantName;

    private int _activeTasks;
    private int _projectsInProgress;
    private int _runningFlows;
    private int _alerts;
    // Badges de los KPI (prototipo: "+3", "+1", "2 en pausa"); ocultos cuando valen 0.
    private int _tasksCreatedToday;
    private int _projectsCreatedThisMonth;
    private int _stuckFlows;
    private List<TaskItemSummaryDto> _myToday = [];
    private List<TaskItemSummaryDto> _overdue = [];

    // Indicadores con graficas (IInicioStatsService). Por defecto "Mis tareas" si hay usuario de tenant.
    private InicioStatsDto? _stats;
    private bool _scopeMine = true;
    private InicioScopeStatsDto? Scope => _stats is null ? null : (_scopeMine && _stats.Mio is not null ? _stats.Mio : _stats.Equipo);

    // Colores medios (legibles en claro y oscuro): violeta = activas/nuevas, verde = cerradas.
    private const string ColorActivas = "#7C3AED";
    private const string ColorCerradas = "#16A34A";
    private const string AxisColor = "#8A8A94";
    private const string GridLine = "rgba(128,128,140,0.18)";
    private const string ChartFont = "'Plus Jakarta Sans', system-ui, sans-serif";

    // Ahora en la zona horaria del tenant (no la del servidor, que corre en UTC dentro del contenedor).
    // Se fija en OnInitializedAsync tras resolver Tenant.TimeZoneId; default sensato mientras tanto.
    private DateTime _localNow = DateTime.UtcNow;

    private string TodayLabel
    {
        get
        {
            var s = _localNow.ToString("dddd d 'de' MMMM, yyyy", Es);
            s = char.ToUpper(s[0], Es) + s[1..];
            return s + " · " + _localNow.ToString("h:mm tt", Es);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Guid? platformUserId = null;
        Guid? tenantId = null;
        if (AuthState is not null)
        {
            var state = await AuthState;
            _firstName = state.User.Identity?.Name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            if (Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid)) { platformUserId = uid; }
            if (Guid.TryParse(state.User.FindFirst("tenant_id")?.Value, out var tid)) { tenantId = tid; }
            _tenantRole = state.User.FindFirst("tenant_role")?.Value;
        }

        // Scope propio para NO compartir el DbContext del request con NavMenu/MainLayout
        // durante el prerender ("second operation started on this context"). El tenant se
        // fija explicitamente: en el circuito interactivo (SignalR) no hay HttpContext y
        // sin esto el filtro global queda fail-closed y los KPIs muestran cero.
        using var ambient = tenantId is Guid ambientTenant
            ? Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(ambientTenant, platformUserId)
            : null;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var tenants = scope.ServiceProvider.GetRequiredService<ITenantAdminService>();
        var tasksSvc = scope.ServiceProvider.GetRequiredService<ITaskItemService>();
        var projectsSvc = scope.ServiceProvider.GetRequiredService<IProjectService>();
        var tenantUsersSvc = scope.ServiceProvider.GetRequiredService<ITenantUserService>();
        var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();

        if (tenantId is Guid tenId)
        {
            _tenantName = (await tenants.GetAsync(tenId))?.Name;
        }

        // Npgsql solo acepta DateTimeOffset con offset 0 en "timestamp with time zone".
        var now = DateTimeOffset.UtcNow;

        // Saludo y fecha en la ZONA HORARIA DEL TENANT (el servidor corre en UTC): a las 3pm de Bogota
        // (UTC-5) DateTime.Now del contenedor daria las 20:00 y saludaria "Buenas noches". Se resuelve
        // Tenant.TimeZoneId (IANA; default America/Bogota) y se convierte el UtcNow.
        var tzId = tenantId is Guid tzTid
            ? await db.Tenants.Where(t => t.Id == tzTid).Select(t => t.TimeZoneId).FirstOrDefaultAsync()
            : null;
        var tz = Ecorex.Application.Scheduling.ScheduledJobRecurrence.ResolveTimeZone(tzId);
        _localNow = TimeZoneInfo.ConvertTime(now, tz).DateTime;
        var hour = _localNow.Hour;
        _greeting = hour < 12 ? "Buenos dias" : hour < 18 ? "Buenas tardes" : "Buenas noches";

        // KPI 1: tareas en estados activos (solo cuenta: PageSize 1 y se usa TotalCount).
        _activeTasks = (await tasksSvc.ListAsync(new TaskItemListFilter(Statuses: ActiveStatuses, PageSize: 1))).TotalCount;

        // KPI 2: proyectos en curso (no archivados, no cerrados ni cancelados).
        var projects = await projectsSvc.ListAsync();
        _projectsInProgress = projects.Count(p => p.Status is ProjectStatus.Planning or ProjectStatus.Active or ProjectStatus.InExecution);

        // KPI 3: instancias de flujo Running (el query filter de EF aisla el tenant activo).
        _runningFlows = await db.WorkflowInstances.CountAsync(i => i.Status == WorkflowInstanceStatus.Running);

        // Badges de los KPI (deltas del prototipo, calculados con datos reales; 0 => oculto).
        var todayStart = new DateTimeOffset(DateTime.Today).ToUniversalTime();
        var monthStart = new DateTimeOffset(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)).ToUniversalTime();
        _tasksCreatedToday = await db.TaskItems.CountAsync(t => t.CreatedAt >= todayStart);
        _projectsCreatedThisMonth = await db.Projects.CountAsync(p => p.CreatedAt >= monthStart);
        _stuckFlows = await db.WorkflowInstances.CountAsync(i => i.Status == WorkflowInstanceStatus.Stuck);

        // KPI 4 + panel de alertas: tareas vencidas (DueDate <= ahora) en estado activo.
        var overdue = await tasksSvc.ListAsync(new TaskItemListFilter(Statuses: ActiveStatuses, DueTo: now, PageSize: 10));
        _alerts = overdue.TotalCount;
        _overdue = overdue.Items.OrderBy(t => t.DueDate).Take(4).ToList();

        // Mis tareas de hoy: asignadas a mi (TenantUser del PlatformUser actual) con
        // vencimiento hoy o ya vencidas; max 5 ordenadas por fecha de entrega.
        Guid? myTenantUserId = null;
        if (platformUserId is Guid pid)
        {
            var me = (await tenantUsersSvc.ListAsync()).FirstOrDefault(u => u.PlatformUserId == pid);
            if (me is not null)
            {
                myTenantUserId = me.Id;
                var endOfToday = new DateTimeOffset(DateTime.Today.AddDays(1).AddTicks(-1)).ToUniversalTime();
                var mine = await tasksSvc.ListAsync(new TaskItemListFilter(
                    Statuses: ActiveStatuses, AssigneeTenantUserId: me.Id, DueTo: endOfToday, PageSize: 50));
                _myToday = mine.Items.OrderBy(t => t.DueDate).Take(5).ToList();
            }
        }

        // Indicadores con graficas: mis tareas + equipo, en la zona horaria del tenant. Owner/Admin ven el
        // nombre de tableros restringidos; al resto se le agrupan como "Otros tableros" en el alcance equipo.
        var statsSvc = scope.ServiceProvider.GetRequiredService<IInicioStatsService>();
        _stats = await statsSvc.GetAsync(myTenantUserId, _tenantRole is "Owner" or "Admin", tz, now);
        if (_stats.Mio is null) { _scopeMine = false; }
    }

    private string? _tenantRole;

    private void SetScope(bool mine) => _scopeMine = mine && _stats?.Mio is not null;

    /// <summary>Variacion de cierres frente al mes anterior ("+25%"); null si no hay base para comparar.</summary>
    private static (bool Up, string Text)? Trend(InicioScopeStatsDto s)
    {
        if (s.CerradasMesAnterior == 0) { return null; }
        var pct = (int)Math.Round((s.CerradasMes - s.CerradasMesAnterior) * 100.0 / s.CerradasMesAnterior);
        return (pct >= 0, (pct >= 0 ? "+" : "") + pct + "%");
    }

    private static string BoardHeight(IReadOnlyList<InicioBoardCountDto> items) => Math.Max(170, 34 * items.Count + 40) + "px";

    private static Dictionary<string, object?> Axis(object? data, bool category, bool showLine) => new()
    {
        ["type"] = category ? "category" : "value",
        ["data"] = data,
        ["minInterval"] = category ? null : 1,
        ["axisLabel"] = new Dictionary<string, object?> { ["color"] = AxisColor, ["fontFamily"] = ChartFont, ["fontSize"] = 11 },
        ["axisLine"] = new Dictionary<string, object?> { ["show"] = showLine, ["lineStyle"] = new Dictionary<string, object?> { ["color"] = GridLine } },
        ["axisTick"] = new Dictionary<string, object?> { ["show"] = false },
        ["splitLine"] = new Dictionary<string, object?> { ["show"] = !category, ["lineStyle"] = new Dictionary<string, object?> { ["color"] = GridLine } },
    };

    /// <summary>Barras horizontales por tablero (el mayor arriba), con el valor al final de cada barra.</summary>
    private static object BoardBar(IReadOnlyList<InicioBoardCountDto> items, string color)
    {
        var ordered = items.Reverse().ToList(); // ECharts pinta la categoria 0 abajo
        var yAxis = Axis(ordered.Select(i => i.Board).ToList(), category: true, showLine: false);
        ((Dictionary<string, object?>)yAxis["axisLabel"]!)["width"] = 140;
        ((Dictionary<string, object?>)yAxis["axisLabel"]!)["overflow"] = "truncate";
        return Clean(new Dictionary<string, object?>
        {
            ["textStyle"] = new Dictionary<string, object?> { ["fontFamily"] = ChartFont },
            ["grid"] = new Dictionary<string, object?> { ["left"] = 8, ["right"] = 36, ["top"] = 8, ["bottom"] = 8, ["containLabel"] = true },
            ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "axis", ["axisPointer"] = new Dictionary<string, object?> { ["type"] = "shadow" } },
            ["xAxis"] = Axis(null, category: false, showLine: false),
            ["yAxis"] = yAxis,
            ["series"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["type"] = "bar", ["name"] = "Tareas", ["barMaxWidth"] = 18,
                    ["data"] = ordered.Select(i => i.Count).ToList(),
                    ["itemStyle"] = new Dictionary<string, object?> { ["color"] = color, ["borderRadius"] = new[] { 0, 6, 6, 0 } },
                    ["label"] = new Dictionary<string, object?> { ["show"] = true, ["position"] = "right", ["color"] = AxisColor, ["fontWeight"] = 600 },
                }
            }
        });
    }

    /// <summary>Nuevas vs cerradas por periodo: columnas (mensual) o lineas suaves con area (7 dias).</summary>
    private static object SerieChart(InicioSerieDto s, bool line)
    {
        Dictionary<string, object?> Serie(string name, IReadOnlyList<int> data, string color) => new()
        {
            ["type"] = line ? "line" : "bar",
            ["name"] = name,
            ["data"] = data,
            ["smooth"] = line ? true : null,
            ["symbolSize"] = line ? 7 : null,
            ["barMaxWidth"] = line ? null : 22,
            ["barGap"] = line ? null : "20%",
            ["itemStyle"] = new Dictionary<string, object?> { ["color"] = color, ["borderRadius"] = line ? null : new[] { 6, 6, 0, 0 } },
            ["lineStyle"] = line ? new Dictionary<string, object?> { ["width"] = 2.5 } : null,
            ["areaStyle"] = line ? new Dictionary<string, object?> { ["opacity"] = 0.08 } : null,
        };
        return Clean(new Dictionary<string, object?>
        {
            ["textStyle"] = new Dictionary<string, object?> { ["fontFamily"] = ChartFont },
            ["grid"] = new Dictionary<string, object?> { ["left"] = 8, ["right"] = 12, ["top"] = 34, ["bottom"] = 4, ["containLabel"] = true },
            ["legend"] = new Dictionary<string, object?>
            {
                ["top"] = 0, ["right"] = 4, ["icon"] = "roundRect", ["itemWidth"] = 10, ["itemHeight"] = 10,
                ["textStyle"] = new Dictionary<string, object?> { ["color"] = AxisColor, ["fontSize"] = 12 },
            },
            ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "axis" },
            ["xAxis"] = Axis(s.Labels, category: true, showLine: true),
            ["yAxis"] = Axis(null, category: false, showLine: false),
            ["series"] = new object[] { Serie("Nuevas", s.Nuevas, ColorActivas), Serie("Cerradas", s.Cerradas, ColorCerradas) }
        });
    }

    /// <summary>Quita las claves nulas (recursivo): ECharts toma un null como valor y pisa sus defaults.</summary>
    private static object Clean(object node)
    {
        switch (node)
        {
            case Dictionary<string, object?> d:
                foreach (var k in d.Where(kv => kv.Value is null).Select(kv => kv.Key).ToList()) { d.Remove(k); }
                foreach (var v in d.Values) { Clean(v!); }
                break;
            case object[] arr:
                foreach (var v in arr) { if (v is not null) { Clean(v); } }
                break;
        }
        return node;
    }

    private async Task OpenWizardAsync()
    {
        if (_wizard is not null) { await _wizard.OpenAsync(); }
    }

    private async Task OnTaskCreatedAsync(TaskItemDetailDto _)
    {
        // Refresca KPIs y paneles tras crear una actividad desde el wizard.
        await OnInitializedAsync();
        StateHasChanged();
    }

    /// <summary>Tono del prototipo por prioridad: Alta rose / Media amber / Baja green.</summary>
    private static string PrioTone(TaskPriority p) => p switch
    {
        TaskPriority.High => "tr",
        TaskPriority.Medium => "ta",
        _ => "tg"
    };

    private static bool IsOverdue(TaskItemSummaryDto t) => t.DueDate is { } d && d.LocalDateTime.Date < DateTime.Today;

    private static string DueLabel(TaskItemSummaryDto t)
    {
        if (t.DueDate is not { } d) { return ""; }
        var date = d.LocalDateTime.Date;
        if (date < DateTime.Today) { return "Vencida"; }
        if (date == DateTime.Today) { return "Hoy"; }
        return date.ToString("dd MMM", Es);
    }
