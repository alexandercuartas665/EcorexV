    /// <summary>Inserta el adjunto en la nota abierta (pasa a modo edicion).</summary>
    private void InsertAsset(MockupBrainAssetDto asset)
    {
        if (!_hasNote) { return; }
        _showAssets = false;
        _pendingInsert = $"![[{asset.Name}]]";
        _editing = true;
        _editorPending = true;
        _previewPending = false;
    }

    private async Task DeleteAssetAsync(MockupBrainAssetDto asset)
    {
        var used = asset.UsedIn ?? Array.Empty<string>();
        var message = $"Borrar definitivamente el adjunto '{asset.Name}'? No se puede deshacer."
            + (used.Count > 0 ? $" Lo usan {used.Count} nota(s): {string.Join(", ", used.Take(5))}{(used.Count > 5 ? "..." : "")}; ahi quedara como 'no encontrado'." : "");
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("ecxMaquetaCerebro.confirm", message); }
        catch (JSException) { ok = false; }
        if (!ok) { return; }
        var id = asset.Id;
        var res = await RunAsync(async sp =>
        {
            var actor = await ResolveActorAsync(sp);
            if (actor is null) { return TaskCoreResult<bool>.Forbidden("Tu usuario no puede escribir en esta empresa."); }
            return await sp.GetRequiredService<IMockupBrainService>().DeleteAssetAsync(Slug, id, actor);
        });
        if (!res.IsOk)
        {
            await OnToast.InvokeAsync(res.Error ?? "No se pudo borrar el adjunto.");
            return;
        }
        await ReloadAssetsAsync();
        await LoadPanelAssetsAsync();
        await OnToast.InvokeAsync($"Adjunto '{asset.Name}' borrado.");
    }

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / (1024d * 1024):0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private async Task OnSearchChanged()
    {
        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try { await Task.Delay(250, cts.Token); } catch (TaskCanceledException) { return; }
        var term = _search;
        var list = string.IsNullOrWhiteSpace(term)
            ? await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().ListNotesAsync(Slug))
            : await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().ListNotesAsync(Slug, term));
        if (cts.IsCancellationRequested) { return; }
        _notes = list.ToList();
        StateHasChanged();
    }

    private async Task OpenNoteAsync(Guid id)
    {
        if (_current?.Id == id && !_isNew) { return; }
        if (!await ConfirmDiscardAsync()) { return; }
        var note = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().GetNoteAsync(Slug, id));
        if (note is null)
        {
            await OnToast.InvokeAsync("La nota ya no existe (fue archivada).");
            await ReloadListAsync();
            return;
        }
        ShowNote(note);
    }

    private void ShowNote(MockupNoteDto note)
    {
        _current = note;
        _isNew = false;
        _draftTitle = note.Title;
        _draftBody = note.Body;
        _error = null;
        _conflict = false;
        _editing = string.IsNullOrWhiteSpace(note.Body);
        _editorPending = _editing;
        _previewPending = !_editing;
        _localGraphPending = true;
    }

    private void StartNew(string title, string body)
    {
        _current = null;
        _isNew = true;
        _draftTitle = title;
        _draftBody = body;
        _error = null;
        _conflict = false;
        _editing = true;
        _editorPending = true;
        _localGraphPending = true;
    }

    private async Task NewNoteAsync()
    {
        if (!await ConfirmDiscardAsync()) { return; }
        StartNew(string.Empty, string.Empty);
    }

    private Task SetEditingAsync(bool editing)
    {
        if (_editing == editing) { return Task.CompletedTask; }
        _editing = editing;
        _editorPending = editing;
        _previewPending = !editing;
        return Task.CompletedTask;
    }

    private Task InsertCurrentPageAsync()
    {
        if (string.IsNullOrEmpty(CurrentFile)) { return Task.CompletedTask; }
        _pendingInsert = $"[[{CurrentFile}]]";
        _editorPending = true;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_saving || !Dirty) { return; }
        _saving = true;
        _error = null;
        _conflict = false;
        try
        {
            var id = _isNew ? (Guid?)null : _current?.Id;
            var version = _isNew ? (long?)null : _current?.Version;
            var title = _draftTitle;
            var body = _draftBody;
            var res = await RunAsync(async sp =>
            {
                var actor = await ResolveActorAsync(sp);
                if (actor is null) { return TaskCoreResult<MockupNoteDto>.Forbidden("Tu usuario no puede escribir en esta empresa."); }
                return await sp.GetRequiredService<IMockupBrainService>().SaveNoteAsync(Slug, id, title, body, version, actor);
            });
            if (!res.IsOk || res.Value is null)
            {
                _error = res.Error ?? "No se pudo guardar la nota.";
                _conflict = res.Status == TaskCoreStatus.Conflict && id is not null && (res.Error ?? string.Empty).Contains("Recargala", StringComparison.Ordinal);
                return;
            }
            var renamed = !_isNew && _current is not null && _current.Title != res.Value.Title;
            ShowNote(res.Value);
            _editing = false;
            _editorPending = false;
            _previewPending = true;
            await ReloadListAsync();
            await LoadGraphAsync();
            await OnToast.InvokeAsync(renamed ? "Nota renombrada: se actualizaron los enlaces que la mencionaban." : "Nota guardada.");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadCurrentAsync()
    {
        if (_current is null) { return; }
        var note = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().GetNoteAsync(Slug, _current.Id));
        if (note is not null) { ShowNote(note); }
    }

    private async Task ArchiveAsync()
    {
        if (_current is null) { return; }
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("ecxMaquetaCerebro.confirm", $"Archivar la nota '{_current.Title}'? Las notas que la enlazan la mostraran como pendiente. Podras restaurarla desde la papelera."); }
        catch (JSException) { ok = false; }
        if (!ok) { return; }
        var id = _current.Id;
        var res = await RunAsync(async sp =>
        {
            var actor = await ResolveActorAsync(sp);
            if (actor is null) { return TaskCoreResult<bool>.Forbidden("Tu usuario no puede escribir en esta empresa."); }
            return await sp.GetRequiredService<IMockupBrainService>().ArchiveNoteAsync(Slug, id, actor);
        });
        if (!res.IsOk)
        {
            _error = res.Error;
            return;
        }
        _current = null;
        _isNew = false;
        _draftTitle = string.Empty;
        _draftBody = string.Empty;
        await ReloadListAsync();
        await LoadGraphAsync();
        _localGraphPending = true;
        await OnToast.InvokeAsync("Nota archivada. Puedes restaurarla desde la papelera.");
    }

