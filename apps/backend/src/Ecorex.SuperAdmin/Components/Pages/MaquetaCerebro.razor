    protected override async Task OnParametersSetAsync()
    {
        if (Active && !_loaded)
        {
            _loaded = true;
            _self ??= DotNetObjectReference.Create(this);
            await RunAsync(ResolveActorAsync);
            await ReloadListAsync();
            await LoadGraphAsync();
            if (!string.IsNullOrWhiteSpace(InitialNote)) { await OpenNoteByTitleAsync(InitialNote); }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Active || _self is null) { return; }
        if (_editing && _editorPending)
        {
            _editorPending = false;
            try
            {
                await JS.InvokeVoidAsync("ecxMaquetaCerebro.bindEditor", _editorRef, _self);
                await JS.InvokeVoidAsync("ecxMaquetaCerebro.setCandidates", _editorRef, Candidates());
                if (_pendingInsert is { } text)
                {
                    _pendingInsert = null;
                    // Los adjuntos embebidos (![[...]]) van en su propia linea; los enlaces, en linea.
                    await JS.InvokeVoidAsync("ecxMaquetaCerebro.insert", _editorRef, text, text.StartsWith("![[", StringComparison.Ordinal));
                }
                else
                {
                    await JS.InvokeVoidAsync("ecxMaquetaCerebro.focusEnd", _editorRef);
                }
            }
            catch (JSException) { }
        }
        if (!_editing && _previewPending)
        {
            _previewPending = false;
            try { await JS.InvokeVoidAsync("ecxMaquetaCerebro.bindPreview", _previewRef, _self); } catch (JSException) { }
        }
        if (_localGraphPending)
        {
            _localGraphPending = false;
            await RenderLocalGraphAsync();
        }
        if (_showGraph && _fullGraphPending)
        {
            _fullGraphPending = false;
            await RenderFullGraphAsync();
        }
    }

