    private async Task OpenTrashAsync()
    {
        _showTrash = true;
        _trashLoading = true;
        try
        {
            _trash = (await RunAsync(async sp =>
            {
                var actor = await ResolveActorAsync(sp);
                return actor is null
                    ? Array.Empty<MockupArchivedNoteDto>()
                    : await sp.GetRequiredService<IMockupBrainService>().ListArchivedNotesAsync(Slug, actor);
            })).ToList();
        }
        finally
        {
            _trashLoading = false;
        }
    }

    private async Task RestoreAsync(MockupArchivedNoteDto item)
    {
        if (_restoringId is not null) { return; }
        if (!await ConfirmDiscardAsync()) { return; }
        _restoringId = item.Id;
        try
        {
            var id = item.Id;
            var res = await RunAsync(async sp =>
            {
                var actor = await ResolveActorAsync(sp);
                if (actor is null) { return TaskCoreResult<MockupNoteDto>.Forbidden("Tu usuario no puede escribir en esta empresa."); }
                return await sp.GetRequiredService<IMockupBrainService>().RestoreNoteAsync(Slug, id, actor);
            });
            if (!res.IsOk || res.Value is null)
            {
                await OnToast.InvokeAsync(res.Error ?? "No se pudo restaurar la nota.");
                await OpenTrashAsync();
                return;
            }
            _showTrash = false;
            ShowNote(res.Value);
            await ReloadListAsync();
            await LoadGraphAsync();
            await OnToast.InvokeAsync(res.Value.Title == item.Title ? $"Nota '{item.Title}' restaurada." : $"Nota restaurada como '{res.Value.Title}'.");
        }
        finally
        {
            _restoringId = null;
        }
    }

    private async Task<bool> ConfirmDiscardAsync()
    {
        if (!Dirty) { return true; }
        try { return await JS.InvokeAsync<bool>("ecxMaquetaCerebro.confirm", "Hay cambios sin guardar en la nota. Descartarlos?"); }
        catch (JSException) { return false; }
    }

    // ------------------------------------------------------------------ importar vault

    private void OnVaultSelected(InputFileChangeEventArgs e)
    {
        _vault = e.File;
        _importError = null;
        _importResult = null;
    }

    private async Task ImportAsync()
    {
        if (_vault is null) { return; }
        if (_vault.Size > MockupBrainService.MaxVaultZipBytes)
        {
            _importError = $"El ZIP supera {MockupBrainService.MaxVaultZipBytes / (1024 * 1024)} MB.";
            return;
        }
        _importing = true;
        _importError = null;
        _importResult = null;
        try
        {
            byte[] bytes;
            await using (var stream = _vault.OpenReadStream(MockupBrainService.MaxVaultZipBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            var overwrite = _overwrite;
            var res = await RunAsync(async sp =>
            {
                var actor = await ResolveActorAsync(sp);
                if (actor is null) { return TaskCoreResult<MockupBrainImportResult>.Forbidden("Tu usuario no puede escribir en esta empresa."); }
                return await sp.GetRequiredService<IMockupBrainService>().ImportVaultAsync(Slug, bytes, overwrite, actor);
            });
            if (!res.IsOk || res.Value is null)
            {
                _importError = res.Error ?? "No se pudo importar el vault.";
                return;
            }
            _importResult = res.Value;
            _vault = null;
            await ReloadListAsync();
            await LoadGraphAsync();
            _localGraphPending = true;
        }
        catch (IOException ex)
        {
            _importError = "No se pudo leer el archivo: " + ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    // ------------------------------------------------------------------ grafo

    private async Task LoadGraphAsync()
    {
        _graph = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().GetGraphAsync(Slug));
        _localGraphPending = true;
        _fullGraphPending = _showGraph;
    }

    private async Task OpenGraphAsync()
    {
        await LoadGraphAsync();
        _showGraph = true;
        _fullGraphPending = true;
    }

    private async Task CloseGraphAsync()
    {
        _showGraph = false;
        await JsDisposeAsync(_fullGraphId);
    }

    private async Task RenderFullGraphAsync()
    {
        if (_graph is null || _self is null || !_showGraph) { return; }
        var hidden = new HashSet<string>(StringComparer.Ordinal);
        if (!_showPages) { hidden.Add(MockupBrainLinkKinds.Page); }
        if (!_showTasks) { hidden.Add(MockupBrainLinkKinds.Task); }
        if (!_showTags) { hidden.Add(MockupBrainLinkKinds.Tag); }
        if (!_showMissing) { hidden.Add("missing"); }
        var nodes = _graph.Nodes.Where(n => !hidden.Contains(n.Kind)).ToList();
        var ids = nodes.Select(n => n.Id).ToHashSet(StringComparer.Ordinal);
        var edges = _graph.Edges.Where(e => ids.Contains(e.Source) && ids.Contains(e.Target)).ToList();
        if (!_showOrphans)
        {
            var connected = edges.SelectMany(e => new[] { e.Source, e.Target }).ToHashSet(StringComparer.Ordinal);
            nodes = nodes.Where(n => connected.Contains(n.Id)).ToList();
        }
        await RenderGraphAsync(_fullGraphId, nodes, edges, false, CurrentNodeId);
    }

    private async Task RenderLocalGraphAsync()
    {
        if (_self is null) { return; }
        if (_graph is null || CurrentNodeId is not { } center)
        {
            await JsDisposeAsync(_localGraphId);
            return;
        }
        var neighbors = new HashSet<string>(StringComparer.Ordinal) { center };
        foreach (var e in _graph.Edges)
        {
            if (e.Source == center) { neighbors.Add(e.Target); }
            if (e.Target == center) { neighbors.Add(e.Source); }
        }
        var nodes = _graph.Nodes.Where(n => neighbors.Contains(n.Id)).ToList();
        var edges = _graph.Edges.Where(e => neighbors.Contains(e.Source) && neighbors.Contains(e.Target)).ToList();
        await RenderGraphAsync(_localGraphId, nodes, edges, true, center);
    }

    private string? CurrentNodeId => _current is null ? null : "note:" + _current.Id.ToString("N");

    private async Task RenderGraphAsync(string elementId, IEnumerable<MockupBrainNodeDto> nodes, IEnumerable<MockupBrainEdgeDto> edges, bool compact, string? focus)
    {
        var data = new
        {
            nodes = nodes.Select(n => new { id = n.Id, kind = n.Kind, label = n.Label, degree = n.Degree, noteId = n.NoteId?.ToString(), key = n.Key }),
            edges = edges.Select(e => new { source = e.Source, target = e.Target })
        };
        try
        {
            await JS.InvokeAsync<bool>("ecxMaquetaCerebro.renderGraphById", elementId, data, _self, new { compact, focus });
        }
        catch (JSException) { }
    }

    private async Task JsDisposeAsync(string elementId)
    {
        try { await JS.InvokeVoidAsync("ecxMaquetaCerebro.disposeGraphById", elementId); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    // ------------------------------------------------------------------ helpers

    /// <summary>Existe el destino de un enlace (para pintar los fantasmas en la vista previa).</summary>
    private bool Exists(string kind, string key) => kind switch
    {
        MockupBrainLinkKinds.Note => _allKeys.Contains(key),
        MockupBrainLinkKinds.Page => Pages.Count == 0 || Pages.Any(p => string.Equals(p.File, key, StringComparison.OrdinalIgnoreCase)),
        MockupBrainLinkKinds.Task => Solicitudes.Any(s => s.Number == key)
                                     || (_current?.Links.Any(l => l.Kind == MockupBrainLinkKinds.Task && l.Key == key && l.Exists) ?? false),
        _ => true
    };

    /// <summary>Candidatos del autocompletado "[[": notas, pantallas y solicitudes del proyecto.</summary>
    private object[] Candidates()
    {
        var list = new List<object>();
        list.AddRange(_allTitles.Select(t => (object)new { kind = "note", label = t, value = t }));
        list.AddRange(Pages.Select(p => (object)new { kind = "page", label = $"{p.Title} ({p.File})", value = p.File }));
        list.AddRange(Solicitudes.Take(300).Select(s => (object)new { kind = "task", label = $"{s.Number} {s.Title}", value = s.Number }));
        list.AddRange(_assets.Values.Take(500).Select(a => (object)new { kind = "file", label = a.Name, value = a.Name }));
        return list.ToArray();
    }

    private static string KindIcon(string kind) => kind switch
    {
        MockupBrainLinkKinds.Page => "fa-regular fa-window-maximize",
        MockupBrainLinkKinds.Task => "fa-regular fa-square-check",
        _ => "fa-regular fa-note-sticky"
    };

    private static string Ago(DateTimeOffset when)
    {
        var d = DateTimeOffset.UtcNow - when;
        if (d.TotalMinutes < 1) { return "ahora"; }
        if (d.TotalHours < 1) { return $"hace {(int)d.TotalMinutes} min"; }
        if (d.TotalDays < 1) { return $"hace {(int)d.TotalHours} h"; }
        return $"hace {(int)d.TotalDays} d";
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await OnToast.InvokeAsync("Copiado. Pegalo en Claude.");
        }
        catch (JSException)
        {
            await OnToast.InvokeAsync("No se pudo copiar; seleccionalo y copialo a mano.");
        }
    }

    private async Task<McpActor?> ResolveActorAsync(IServiceProvider sp)
    {
        _actor ??= await sp.GetRequiredService<IMaquetaSolicitudService>().ResolveSessionActorAsync(UserId);
        return _actor;
    }

    private async Task<T> RunAsync<T>(Func<IServiceProvider, Task<T>> action)
    {
        using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(TenantId, UserId);
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await action(scope.ServiceProvider);
    }

    public async ValueTask DisposeAsync()
    {
        _searchCts?.Cancel();
        await JsDisposeAsync(_localGraphId);
        await JsDisposeAsync(_fullGraphId);
        _self?.Dispose();
    }
