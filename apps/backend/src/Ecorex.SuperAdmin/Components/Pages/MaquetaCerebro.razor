    /// <summary>Abre (o prepara sin guardar) la nota de una pantalla: "Pantalla - {titulo}" con el enlace [[archivo]].</summary>
    public async Task OpenPageNoteAsync(string file)
    {
        if (string.IsNullOrEmpty(file)) { return; }
        if (!await ConfirmDiscardAsync()) { return; }
        var page = Pages.FirstOrDefault(p => string.Equals(p.File, file, StringComparison.OrdinalIgnoreCase));
        var title = MockupBrainLinks.CleanTitle(MockupBrainLinks.SafeTitle("Pantalla - " + (page?.Title ?? Path.GetFileNameWithoutExtension(file)))).Title ?? "Pantalla";
        var existing = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().GetNoteAsync(Slug, null, title));
        if (existing is not null)
        {
            ShowNote(existing);
            return;
        }
        StartNew(title, $"Pantalla: [[{file}]]\n\n");
    }

    public async Task OpenNoteByTitleAsync(string title)
    {
        var note = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().GetNoteAsync(Slug, null, title));
        if (note is not null) { ShowNote(note); }
        else if (MockupBrainLinks.CleanTitle(title).Title is { } clean) { StartNew(clean, string.Empty); }
    }

    // ------------------------------------------------------------------ JS -> .NET

    [JSInvokable]
    public async Task OnBrainLink(string kind, string key)
    {
        switch (kind)
        {
            case MockupBrainLinkKinds.Note:
                if (!await ConfirmDiscardAsync()) { return; }
                await OpenNoteByTitleAsync(key);
                break;
            case MockupBrainLinkKinds.Page:
                // Fuera de una maqueta (pagina /cerebros/{slug}, ADR-0200) no hay lista de pantallas: decide el contenedor.
                if (Pages.Count == 0 && OnOpenPage.HasDelegate)
                {
                    await OnOpenPage.InvokeAsync(key);
                }
                else if (Pages.Any(p => string.Equals(p.File, key, StringComparison.OrdinalIgnoreCase)))
                {
                    await OnOpenPage.InvokeAsync(Pages.First(p => string.Equals(p.File, key, StringComparison.OrdinalIgnoreCase)).File);
                }
                else
                {
                    await OnToast.InvokeAsync($"La pantalla '{key}' no esta en la version abierta de la maqueta.");
                }
                break;
            case MockupBrainLinkKinds.Task:
                var id = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().FindTaskIdAsync(key));
                if (id is Guid taskId) { await OnOpenTask.InvokeAsync(taskId); }
                else { await OnToast.InvokeAsync($"La tarjeta {key} no existe en esta empresa."); }
                break;
            case MockupBrainLinkKinds.Tag:
                _search = "#" + key;
                await OnSearchChanged();
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGraphNode(string kind, string key, string noteId, string label)
    {
        if (kind == "note" && Guid.TryParse(noteId, out var id))
        {
            _showGraph = false;
            await JsDisposeAsync(_fullGraphId);
            await OpenNoteAsync(id);
        }
        else if (kind == "missing")
        {
            _showGraph = false;
            await JsDisposeAsync(_fullGraphId);
            if (await ConfirmDiscardAsync()) { StartNew(label, string.Empty); }
        }
        else
        {
            if (kind is MockupBrainLinkKinds.Page or MockupBrainLinkKinds.Task)
            {
                _showGraph = false;
                await JsDisposeAsync(_fullGraphId);
            }
            await OnBrainLink(kind, key);
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSaveShortcut()
    {
        // El JS dispara "input" antes: se espera un ciclo para que el @bind aplique el texto.
        await Task.Yield();
        await InvokeAsync(SaveAsync);
    }

    // ------------------------------------------------------------------ notas

    private async Task ReloadListAsync()
    {
        _loadingList = true;
        try
        {
            var all = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().ListNotesAsync(Slug));
            _allTitles = all.Select(n => n.Title).OrderBy(t => t, StringComparer.OrdinalIgnoreCase).ToList();
            _allKeys = all.Select(n => MockupBrainLinks.NormalizeTitle(n.Title)).ToHashSet(StringComparer.Ordinal);
            _notes = string.IsNullOrWhiteSpace(_search)
                ? all.ToList()
                : (await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().ListNotesAsync(Slug, _search))).ToList();
            await ReloadAssetsAsync();
        }
        finally
        {
            _loadingList = false;
        }
    }

    // ------------------------------------------------------------------ adjuntos (ola 3b)

    private async Task ReloadAssetsAsync()
    {
        var assets = await RunAsync(sp => sp.GetRequiredService<IMockupBrainService>().ListAssetsAsync(Slug));
        _assets = assets.GroupBy(a => MockupBrainAssets.Key(a.Name)).ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);
    }

    /// <summary>URL del adjunto por la referencia escrita en la nota (nombre o ruta de Obsidian).</summary>
    private string? AssetUrl(string reference)
        => _assets.TryGetValue(MockupBrainAssets.Key(reference), out var a) ? a.Url : null;

    /// <summary>Adjuntar desde el editor: sube e inserta ![[nombre]] en el cursor.</summary>
    private Task OnAssetSelected(InputFileChangeEventArgs e) => UploadAssetAsync(e.File, insert: true);

    /// <summary>Subir desde el panel Adjuntos: solo sube (no toca la nota).</summary>
    private async Task OnPanelAssetSelected(InputFileChangeEventArgs e)
    {
        await UploadAssetAsync(e.File, insert: false);
        await LoadPanelAssetsAsync();
    }

    private async Task UploadAssetAsync(IBrowserFile file, bool insert)
    {
        if (file.Size > MockupBrainAssets.MaxAssetBytes)
        {
            await OnToast.InvokeAsync($"El adjunto supera {MockupBrainAssets.MaxAssetBytes / (1024 * 1024)} MB.");
            return;
        }
        _uploading = true;
        try
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(MockupBrainAssets.MaxAssetBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            var name = file.Name;
            var res = await RunAsync(async sp =>
            {
                var actor = await ResolveActorAsync(sp);
                if (actor is null) { return TaskCoreResult<MockupBrainAssetDto>.Forbidden("Tu usuario no puede escribir en esta empresa."); }
                return await sp.GetRequiredService<IMockupBrainService>().UploadAssetAsync(Slug, name, bytes, actor);
            });
            if (!res.IsOk || res.Value is null)
            {
                await OnToast.InvokeAsync(res.Error ?? "No se pudo subir el adjunto.");
                return;
            }
            await ReloadAssetsAsync();
            if (insert)
            {
                _pendingInsert = $"![[{res.Value.Name}]]";
                _editorPending = true;
            }
            await OnToast.InvokeAsync($"Adjunto '{res.Value.Name}' subido.");
        }
        catch (IOException ex)
        {
            await OnToast.InvokeAsync("No se pudo leer el archivo: " + ex.Message);
        }
        finally
        {
            _uploading = false;
        }
    }

