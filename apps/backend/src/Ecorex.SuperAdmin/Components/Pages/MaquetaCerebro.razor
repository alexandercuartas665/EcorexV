@* Cerebro digital (ADR-0183; modulo propio desde ADR-0200, el Slug es el del CEREBRO): notas markdown enlazadas al estilo Obsidian ([[nota]],
   [[pantalla.html]], [[T00046]], #etiqueta), backlinks, grafo (ECharts force) e importacion de un vault (.zip de .md).
   Vive como pestana del editor de maquetas (cerebro principal vinculado) y como pagina /cerebros/{slug}. Cualquier usuario del tenant escribe; archiva el autor o
   Owner/Admin. Cada operacion corre en un scope propio con el tenant de la sesion (patron del editor). Solo ASCII. *@
@implements IAsyncDisposable
@using Ecorex.Application.Integraciones.Maqueta
@using Ecorex.Application.Mcp
@using Ecorex.Application.Tenancy
@using Ecorex.SuperAdmin.Maqueta
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="mb-shell">
    <aside class="mb-list">
        <div class="mb-list-head">
            <div class="mb-list-title">
                <h2 title="@ProjectName">Cerebro</h2>
                <span class="mb-count">@_allTitles.Count notas</span>
            </div>
            @if (!string.IsNullOrEmpty(ModuleUrl))
            {
                <a class="mb-module-link" href="@ModuleUrl" title="Abrir este cerebro en el modulo Cerebros"><i class="fa-solid fa-up-right-from-square"></i> @ProjectName &middot; abrir en Cerebros</a>
            }
            <div class="mb-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input placeholder="Buscar en titulos y contenido" @bind="_search" @bind:event="oninput" @bind:after="OnSearchChanged" />
            </div>
            <div class="mb-list-actions">
                <button class="mb-btn primary" @onclick="NewNoteAsync"><i class="fa-solid fa-plus"></i> Nota</button>
                <button class="mb-btn" title="Grafo completo del cerebro" @onclick="OpenGraphAsync"><i class="fa-solid fa-diagram-project"></i> Grafo</button>
                <button class="mb-icon" title="Adjuntos del cerebro (imagenes y PDF)" @onclick="OpenAssetsPanelAsync"><i class="fa-solid fa-paperclip"></i></button>
                <button class="mb-icon" title="Importar un vault de Obsidian (.zip con notas .md)" @onclick="() => { _showImport = true; _importResult = null; _importError = null; }"><i class="fa-solid fa-file-import"></i></button>
                <a class="mb-icon" href="@ExportUrl" download data-enhance-nav="false" title="Exportar el cerebro como vault de Obsidian (.zip con las notas .md y los adjuntos)"><i class="fa-solid fa-file-export"></i></a>
                <button class="mb-icon" title="Papelera: notas archivadas (restaurarlas)" @onclick="OpenTrashAsync"><i class="fa-solid fa-trash-arrow-up"></i></button>
            </div>
            <button class="mb-claude" title="Piensa con Claude sobre este cerebro (tu plan de Claude)" @onclick="() => _showClaude = true">
                <i class="fa-regular fa-comments"></i> Chatear con Claude sobre este cerebro
            </button>
        </div>
        <div class="mb-notes">
            @if (_loadingList)
            {
                <div class="mb-muted">Cargando notas...</div>
            }
            else if (_notes.Count == 0)
            {
                <div class="mb-muted">@(string.IsNullOrWhiteSpace(_search) ? "El cerebro esta vacio. Crea la primera nota o importa tu vault de Obsidian." : "Ninguna nota coincide.")</div>
            }
            @foreach (var n in _notes)
            {
                <button class="mb-note @(_current?.Id == n.Id ? "on" : null)" @onclick="() => OpenNoteAsync(n.Id)">
                    <span class="mb-note-title">@n.Title</span>
                    @if (!string.IsNullOrEmpty(n.Snippet))
                    {
                        <span class="mb-note-snip">@n.Snippet</span>
                    }
                    <span class="mb-note-meta">
                        <span title="Enlaces salientes"><i class="fa-solid fa-arrow-right-long"></i> @n.OutLinks</span>
                        <span title="Notas que la enlazan"><i class="fa-solid fa-arrow-left-long"></i> @n.BackLinks</span>
                        <span>@Ago(n.UpdatedAt)</span>
                    </span>
                </button>
            }
        </div>
    </aside>

    <section class="mb-center">
        @if (!_hasNote)
        {
            <div class="mb-welcome">
                <div class="mb-welcome-icon"><i class="fa-solid fa-brain"></i></div>
                <h3>@ProjectName</h3>
                <p>Escribe lo que piensas y enlaza las ideas entre si. Cada enlace se vuelve una conexion en el grafo.</p>
                <ul class="mb-syntax">
                    <li><code>[[Nombre de nota]]</code> enlaza otra nota (si no existe queda pendiente y un clic la crea)</li>
                    <li><code>[[pantalla.html]]</code> enlaza una pantalla de la maqueta</li>
                    <li><code>[[T00046]]</code> enlaza una solicitud (tarjeta)</li>
                    <li><code>#etiqueta</code> agrupa notas por tema</li>
                </ul>
                <div class="mb-welcome-actions">
                    <button class="mb-btn primary" @onclick="NewNoteAsync"><i class="fa-solid fa-plus"></i> Nueva nota</button>
                    @if (!string.IsNullOrEmpty(CurrentFile))
                    {
                        <button class="mb-btn" @onclick="() => OpenPageNoteAsync(CurrentFile)"><i class="fa-regular fa-window-maximize"></i> Nota de la pantalla actual</button>
                    }
                    <button class="mb-btn" @onclick="() => { _showImport = true; _importResult = null; _importError = null; }"><i class="fa-solid fa-file-import"></i> Importar Obsidian</button>
                </div>
            </div>
        }
        else
        {
            <div class="mb-note-head">
                <input class="mb-title" @bind="_draftTitle" @bind:event="oninput" placeholder="Titulo de la nota" maxlength="200" />
                <div class="mb-note-tools">
                    <span class="mb-status @(Dirty ? "dirty" : null)">@StatusText</span>
                    <div class="mb-seg">
                        <button class="@(_editing ? "on" : null)" title="Editar (markdown)" @onclick="() => SetEditingAsync(true)"><i class="fa-solid fa-pen"></i> Editar</button>
                        <button class="@(!_editing ? "on" : null)" title="Vista" @onclick="() => SetEditingAsync(false)"><i class="fa-regular fa-eye"></i> Vista</button>
                    </div>
                    <button class="mb-btn primary" disabled="@(_saving || !Dirty)" @onclick="SaveAsync"><i class="fa-solid fa-floppy-disk"></i> @(_saving ? "Guardando..." : "Guardar")</button>
                    @if (_current is not null && CanArchive)
                    {
                        <button class="mb-icon" title="Archivar nota" @onclick="ArchiveAsync"><i class="fa-regular fa-trash-can"></i></button>
                    }
                </div>
            </div>
            @if (_error is not null)
            {
                <div class="mb-warn">@_error @if (_conflict) {<button class="mb-link" @onclick="ReloadCurrentAsync">Recargar la nota</button>}</div>
            }
            @if (_editing)
            {
                <div class="mb-editor-wrap">
                    <textarea class="mb-editor" @ref="_editorRef" @bind="_draftBody" @bind:event="oninput"
                              placeholder="Escribe en markdown. [[ para enlazar una nota, pantalla o tarjeta. Ctrl+S guarda."></textarea>
                    <div class="mb-editor-help">
                        <span><code>[[</code> enlazar</span>
                        <span><code>#</code> etiqueta</span>
                        <span><code>**negrita**</code></span>
                        <span><code>- [ ]</code> tarea</span>
                        @* Ola 3b: adjuntar imagen o PDF; se inserta ![[nombre]] en el cursor. *@
                        <label class="mb-link mb-attach @(_uploading ? "busy" : null)" title="Imagen PNG/JPG/GIF/WEBP/BMP o PDF, max 10 MB">
                            <i class="fa-solid fa-paperclip"></i> @(_uploading ? "Subiendo..." : "Adjuntar imagen")
                            <InputFile OnChange="OnAssetSelected" accept=".png,.jpg,.jpeg,.gif,.webp,.bmp,.pdf" disabled="@_uploading" />
                        </label>
                        @if (!string.IsNullOrEmpty(CurrentFile))
                        {
                            <button class="mb-link" @onclick="InsertCurrentPageAsync"><i class="fa-regular fa-window-maximize"></i> Enlazar pantalla actual</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="mb-preview" @ref="_previewRef">
                    @if (string.IsNullOrWhiteSpace(_draftBody))
                    {
                        <div class="mb-muted">Nota vacia. Pulsa <b>Editar</b> para escribir.</div>
                    }
                    else
                    {
                        @((MarkupString)MockupMarkdown.ToHtml(_draftBody, Exists, AssetUrl))
                    }
                </div>
            }
            @if (_current is not null)
            {
                <div class="mb-foot">
                    Creada por @(_current.AuthorName ?? "-") &middot; editada @Ago(_current.UpdatedAt)@(string.IsNullOrEmpty(_current.UpdatedByName) ? "" : $" por {_current.UpdatedByName}")
                    @if (!string.IsNullOrEmpty(_current.ImportedFrom))
                    {
                        <span> &middot; importada de <code>@_current.ImportedFrom</code></span>
                    }
                </div>
            }
        }
    </section>

    <aside class="mb-side">
        <div class="mb-side-block">
            <h4><i class="fa-solid fa-arrow-left-long"></i> Enlazan aqui <span class="mb-count">@(_current?.Backlinks.Count ?? 0)</span></h4>
            @if (_current is null || _current.Backlinks.Count == 0)
            {
                <div class="mb-muted sm">@(_current is null ? "Abre una nota para ver quien la enlaza." : "Ninguna nota enlaza a esta todavia.")</div>
            }
            else
            {
                @foreach (var b in _current.Backlinks)
                {
                    <button class="mb-ref" @onclick="() => OpenNoteAsync(b.Id)">
                        <span class="mb-ref-title">@b.Title</span>
                        <span class="mb-ref-snip">@b.Snippet</span>
                    </button>
                }
            }
        </div>
        <div class="mb-side-block">
            <h4><i class="fa-solid fa-arrow-right-long"></i> Enlaces <span class="mb-count">@(_current?.Links.Count(l => l.Kind != MockupBrainLinkKinds.Tag) ?? 0)</span></h4>
            @if (_current is not null)
            {
                @foreach (var l in _current.Links.Where(l => l.Kind != MockupBrainLinkKinds.Tag))
                {
                    var exists = Exists(l.Kind, l.Kind == MockupBrainLinkKinds.Note ? MockupBrainLinks.NormalizeTitle(l.Label) : l.Key);
                    <button class="mb-out k-@l.Kind @(exists ? null : "missing")" @onclick="() => OnBrainLink(l.Kind, l.Kind == MockupBrainLinkKinds.Note ? l.Label : l.Key)">
                        <i class="@KindIcon(l.Kind)"></i> @l.Label
                    </button>
                }
                var tags = _current.Links.Where(l => l.Kind == MockupBrainLinkKinds.Tag).ToList();
                @if (tags.Count > 0)
                {
                    <div class="mb-tags">
                        @foreach (var t in tags)
                        {
                            <span class="mb-chip">#@t.Label</span>
                        }
                    </div>
                }
            }
        </div>
        <div class="mb-side-block grow">
            <h4><i class="fa-solid fa-circle-nodes"></i> Grafo local</h4>
            <div class="mb-local-graph" id="@_localGraphId"></div>
            @if (_current is null)
            {
                <div class="mb-muted sm">El grafo local muestra la nota abierta y sus vecinas.</div>
            }
        </div>
    </aside>
</div>

@if (_showGraph)
{
    <div class="mb-overlay" @onclick="CloseGraphAsync">
        <div class="mb-modal graph" @onclick:stopPropagation="true">
            <div class="mb-modal-head">
                <h3><i class="fa-solid fa-diagram-project"></i> Grafo de @ProjectName</h3>
                <div class="mb-filters">
                    <label><input type="checkbox" @bind="_showPages" @bind:after="RenderFullGraphAsync" /> Pantallas</label>
                    <label><input type="checkbox" @bind="_showTasks" @bind:after="RenderFullGraphAsync" /> Tarjetas</label>
                    <label><input type="checkbox" @bind="_showTags" @bind:after="RenderFullGraphAsync" /> Etiquetas</label>
                    <label><input type="checkbox" @bind="_showMissing" @bind:after="RenderFullGraphAsync" /> Pendientes</label>
                    <label><input type="checkbox" @bind="_showOrphans" @bind:after="RenderFullGraphAsync" /> Notas sueltas</label>
                </div>
                <span class="mb-count">@(_graph?.Nodes.Count ?? 0) nodos &middot; @(_graph?.Edges.Count ?? 0) enlaces</span>
                <button class="mb-icon" title="Cerrar" @onclick="CloseGraphAsync"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="mb-full-graph" id="@_fullGraphId"></div>
            <div class="mb-modal-foot">Rueda para acercar, arrastra para mover. Clic en una nota la abre; en una pantalla la muestra en la maqueta; en una tarjeta la abre.</div>
        </div>
    </div>
}

@if (_showTrash)
{
    @* Papelera (v0.16.352): las notas archivadas son soft-delete; restaurar las devuelve con sus enlaces. *@
    <div class="mb-overlay" @onclick="() => { if (_restoringId is null) { _showTrash = false; } }">
        <div class="mb-modal trash" @onclick:stopPropagation="true">
            <div class="mb-modal-head">
                <h3><i class="fa-solid fa-trash-arrow-up"></i> Papelera de @ProjectName</h3>
                <span class="mb-count">@(_trash.Count == 1 ? "1 archivada" : $"{_trash.Count} archivadas")</span>
                <button class="mb-icon" title="Cerrar" disabled="@(_restoringId is not null)" @onclick="() => _showTrash = false"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="mb-modal-body">
                @if (_trashLoading)
                {
                    <div class="mb-muted">Cargando notas archivadas...</div>
                }
                else if (_trash.Count == 0)
                {
                    <div class="mb-muted">La papelera esta vacia. Las notas que archives quedan aqui y se pueden restaurar.</div>
                }
                else
                {
                    <div class="mb-trash">
                        @foreach (var t in _trash)
                        {
                            <div class="mb-trash-row">
                                <div class="mb-trash-main">
                                    <div class="mb-trash-title">@t.Title</div>
                                    @if (!string.IsNullOrEmpty(t.Snippet))
                                    {
                                        <div class="mb-note-snip">@t.Snippet</div>
                                    }
                                    <div class="mb-trash-meta">
                                        Archivada @(t.ArchivedAt is { } at ? Ago(at) : "")@(string.IsNullOrEmpty(t.ArchivedByName) ? "" : $" por {t.ArchivedByName}")@(string.IsNullOrEmpty(t.AuthorName) ? "" : $" - autor: {t.AuthorName}")
                                    </div>
                                    @if (t.TitleTaken)
                                    {
                                        <div class="mb-trash-warn"><i class="fa-solid fa-circle-info"></i> Ya hay otra nota con este titulo: volvera como "@t.Title (restaurada)".</div>
                                    }
                                </div>
                                @if (t.CanRestore)
                                {
                                    <button class="mb-btn" disabled="@(_restoringId is not null)" @onclick="() => RestoreAsync(t)">
                                        <i class="fa-solid fa-rotate-left"></i> @(_restoringId == t.Id ? "Restaurando..." : "Restaurar")
                                    </button>
                                }
                                else
                                {
                                    <span class="mb-trash-locked" title="Solo quien creo la nota o un Owner/Admin puede restaurarla"><i class="fa-solid fa-lock"></i></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="mb-modal-foot">Restaurar devuelve la nota con sus enlaces; las notas que la enlazaban vuelven a encontrarla. Solo restaura su autor o un Owner/Admin.</div>
        </div>
    </div>
}

@if (_showAssets)
{
    @* Ola 3b: adjuntos del cerebro. Borrar es definitivo (gestor de archivos sin papelera): solo Owner/Admin. *@
    <div class="mb-overlay" @onclick="() => _showAssets = false">
        <div class="mb-modal assets" @onclick:stopPropagation="true">
            <div class="mb-modal-head">
                <h3><i class="fa-solid fa-paperclip"></i> Adjuntos de @ProjectName</h3>
                <span class="mb-count">@_panelAssets.Count adjuntos</span>
                <label class="mb-btn mb-attach @(_uploading ? "busy" : null)" title="Imagen PNG/JPG/GIF/WEBP/BMP o PDF, max 10 MB">
                    <i class="fa-solid fa-upload"></i> @(_uploading ? "Subiendo..." : "Subir")
                    <InputFile OnChange="OnPanelAssetSelected" accept=".png,.jpg,.jpeg,.gif,.webp,.bmp,.pdf" disabled="@_uploading" />
                </label>
                <button class="mb-icon" title="Cerrar" @onclick="() => _showAssets = false"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="mb-modal-body">
                @if (_panelLoading)
                {
                    <div class="mb-muted">Cargando adjuntos...</div>
                }
                else if (_panelAssets.Count == 0)
                {
                    <div class="mb-muted">Aun no hay adjuntos. Subelos aqui, con "Adjuntar imagen" en el editor o importando un vault de Obsidian.</div>
                }
                else
                {
                    <div class="mb-assets">
                        @foreach (var a in _panelAssets)
                        {
                            var used = a.UsedIn ?? Array.Empty<string>();
                            <div class="mb-asset">
                                <a class="mb-asset-thumb" href="@a.Url" target="_blank" rel="noopener" title="Abrir @a.Name">
                                    @if (a.IsImage)
                                    {
                                        <img src="@a.Url" alt="@a.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-file-pdf"></i>
                                    }
                                </a>
                                <div class="mb-asset-name" title="@a.Name">@a.Name</div>
                                <div class="mb-asset-meta" title="@(used.Count == 0 ? "Ninguna nota lo embebe" : string.Join(", ", used))">
                                    @Size(a.SizeBytes) &middot; @(used.Count == 0 ? "sin usar" : used.Count == 1 ? "en 1 nota" : $"en {used.Count} notas")
                                </div>
                                <div class="mb-asset-actions">
                                    @if (_hasNote)
                                    {
                                        <button class="mb-link" title="Insertar en la nota abierta" @onclick="() => InsertAsset(a)"><i class="fa-solid fa-arrow-right-to-bracket"></i> Insertar</button>
                                    }
                                    @if (IsAdmin)
                                    {
                                        <button class="mb-link danger" title="Borrar definitivamente" @onclick="() => DeleteAssetAsync(a)"><i class="fa-regular fa-trash-can"></i> Borrar</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="mb-modal-foot">@(IsAdmin ? "Borrar un adjunto es definitivo: las notas que lo usan lo muestran como 'no encontrado'." : "Solo un Owner/Admin puede borrar adjuntos.")</div>
        </div>
    </div>
}

@if (_showClaude)
{
    @* Ola 4 (ADR-0183): con el plan de Claude del usuario el chat vive en Claude Desktop/Code via el MCP de maquetas. *@
    <div class="mb-overlay" @onclick="() => _showClaude = false">
        <div class="mb-modal claude" @onclick:stopPropagation="true">
            <div class="mb-modal-head">
                <h3><i class="fa-regular fa-comments"></i> Chatea con @ProjectName desde Claude</h3>
                <button class="mb-icon" title="Cerrar" @onclick="() => _showClaude = false"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="mb-modal-body">
                <p>Claude Desktop o Claude Code, conectado al MCP de maquetas, lee las pantallas, las solicitudes y este cerebro, piensa contigo y guarda las conclusiones como notas aqui. La conversacion usa tu plan de Claude; lo que escriba queda a tu nombre "(via IA)".</p>
                <ol class="mb-steps">
                    <li>Genera tu token en <a href="/conectar-ia?guia=maquetas" target="_blank" rel="noopener">Conectar IA</a> (conector <b>Maquetas</b>). Si ya lo tienes, salta este paso.</li>
                    <li>Conecta Claude. En Claude Code:
                        <div class="mb-copy">
                            <code>@MaquetaClaudeGuide.ClaudeCodeCommand(McpUrl)</code>
                            <button class="mb-link" @onclick="() => CopyAsync(MaquetaClaudeGuide.ClaudeCodeCommand(McpUrl))">Copiar</button>
                        </div>
                        En Claude Desktop usa la configuracion que te da Conectar IA al generar el token.
                    </li>
                    <li>Pidele algo como esto (ya va con el identificador <code>@Slug</code>):</li>
                </ol>
                <div class="mb-prompts">
                    @foreach (var (title, prompt) in MaquetaClaudeGuide.Prompts(Slug, _current?.Title, CurrentFile))
                    {
                        <div class="mb-prompt">
                            <div>
                                <div class="mb-prompt-title">@title</div>
                                <div class="mb-prompt-text">@prompt</div>
                            </div>
                            <button class="mb-btn" @onclick="() => CopyAsync(prompt)"><i class="fa-regular fa-copy"></i> Copiar</button>
                        </div>
                    }
                </div>
            </div>
            <div class="mb-modal-foot">Claude no cambia la maqueta publicada: los ajustes se piden como solicitudes y se aplican en la carpeta local (seccion 7 de la guia de maquetas).</div>
        </div>
    </div>
}

@if (_showImport)
{
    <div class="mb-overlay" @onclick="() => { if (!_importing) { _showImport = false; } }">
        <div class="mb-modal import" @onclick:stopPropagation="true">
            <div class="mb-modal-head">
                <h3><i class="fa-solid fa-file-import"></i> Importar vault de Obsidian</h3>
                <button class="mb-icon" title="Cerrar" disabled="@_importing" @onclick="() => _showImport = false"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="mb-modal-body">
                <p>Comprime la carpeta del vault en un <b>.zip</b> y subelo. Cada archivo <code>.md</code> se vuelve una nota (el titulo es el nombre del archivo, como en Obsidian) y sus <code>[[enlaces]]</code> y <code>#etiquetas</code> se conectan en el grafo. Las imagenes (PNG, JPG, GIF, WEBP, BMP) y los PDF se suben como adjuntos y se ven donde la nota los embebe (<code>![[foto.png]]</code>); se ignoran <code>.obsidian/</code> y otros formatos. Maximo @(MockupBrainService.MaxVaultZipBytes / (1024 * 1024)) MB y @MockupBrainService.MaxVaultNotes.ToString("N0") notas.</p>
                <InputFile OnChange="OnVaultSelected" accept=".zip,application/zip" class="form-control form-control-sm" disabled="@_importing" />
                <label class="mb-check"><input type="checkbox" @bind="_overwrite" disabled="@_importing" /> Sobrescribir las notas que ya existen con el mismo titulo</label>
                @if (_importError is not null)
                {
                    <div class="mb-warn">@_importError</div>
                }
                @if (_importResult is { } r)
                {
                    <div class="mb-result">
                        <div><b>@r.Created</b> notas nuevas &middot; <b>@r.Updated</b> actualizadas &middot; <b>@r.Skipped</b> omitidas (ya existian) &middot; <b>@r.Links</b> enlaces &middot; <b>@r.AssetsCreated</b> adjuntos@(r.AssetsSkipped > 0 ? $" ({r.AssetsSkipped} ya existian)" : "")</div>
                        @if (r.Warnings.Count > 0)
                        {
                            <ul>
                                @foreach (var w in r.Warnings.Take(30))
                                {
                                    <li>@w</li>
                                }
                                @if (r.Warnings.Count > 30)
                                {
                                    <li>... y @(r.Warnings.Count - 30) avisos mas.</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
            <div class="mb-modal-foot right">
                <button class="mb-btn" disabled="@_importing" @onclick="() => _showImport = false">Cerrar</button>
                <button class="mb-btn primary" disabled="@(_importing || _vault is null)" @onclick="ImportAsync">
                    <i class="fa-solid fa-upload"></i> @(_importing ? "Importando..." : "Importar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;
    /// <summary>Nombre visible del cerebro (ADR-0200).</summary>
    [Parameter] public string ProjectName { get; set; } = "Cerebro";
    /// <summary>Enlace a la pagina del cerebro en el modulo Cerebros (solo cuando se muestra dentro de una maqueta).</summary>
