@page "/maqueta"
@attribute [Authorize(Policy = Ecorex.SuperAdmin.Maqueta.MaquetaHub.Policy)]
@* Maquetas (ADR-0178 hub local + ADR-0179 nube). Lista las maquetas del tenant (subidas por ZIP, con versiones) y,
   en Development, las de disco local del registro MaquetaHub. Abre la pagina de entrada (el anotador si viene el kit)
   en un iframe del MISMO origen; el anotador envia las tarjetas a POST /api/maqueta/solicitudes con la sesion.
   Owner/Admin: crear proyecto, subir version (ZIP), cambiar la version actual y archivar. Solo ASCII. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Integraciones.Maqueta
@using Ecorex.Application.Tenancy
@using Ecorex.SuperAdmin.Maqueta
@using Microsoft.AspNetCore.Components.Authorization
@inject MaquetaHubRegistry Hub
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Maquetas - ECOREX.tareas</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <span class="cur">Maquetas</span>
</nav>

<div class="mh-bar">
    <div class="mh-title">
        <h1 class="page-title" style="margin:0;">Maquetas</h1>
        <span class="page-sub" style="margin:0;">Anota la maqueta: las solicitudes llegan como tarjetas a tu empresa.</span>
    </div>
    <div class="mh-actions">
        @if (_items.Count > 0)
        {
            <label class="mh-label" for="mh-proyecto">Proyecto</label>
            <select id="mh-proyecto" class="form-select form-select-sm mh-select" value="@_current?.Key" @onchange="OnProjectChanged">
                @foreach (var it in _items)
                {
                    <option value="@it.Key">@it.Label</option>
                }
            </select>
            @if (_current?.Url is { } openUrl)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@openUrl" target="_blank" rel="noopener">Pantalla completa</a>
            }
        }
        @if (_isAdmin)
        {
            @if (_current?.Project is not null)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleVersions">@(_showVersions ? "Ocultar versiones" : "Versiones")</button>
            }
            <button class="btn btn-sm btn-primary" @onclick="() => _showNew = !_showNew">+ Nuevo proyecto</button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") py-2 mh-alert">@_message</div>
}

@if (_showNew && _isAdmin)
{
    <div class="mh-panel">
        <div class="mh-panel-title">Nuevo proyecto de maqueta</div>
        <div class="mh-grid">
            <label>Nombre<input class="form-control form-control-sm" @bind="_newName" @bind:event="oninput" @bind:after="SuggestSlug" placeholder="TRONOX SGDEA" /></label>
            <label>Identificador (URL)<input class="form-control form-control-sm" @bind="_newSlug" placeholder="tronox" /></label>
            <label class="mh-wide">Descripcion<input class="form-control form-control-sm" @bind="_newDesc" placeholder="Opcional" /></label>
        </div>
        <div class="mh-panel-actions">
            <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="CreateProjectAsync">Crear</button>
            <button class="btn btn-sm btn-link" @onclick="() => _showNew = false">Cancelar</button>
        </div>
    </div>
}

@if (_showVersions && _isAdmin && _current?.Project is { } proj)
{
    <div class="mh-panel">
        <div class="mh-panel-title">Versiones de @proj.Name <span class="mh-muted">(/maqueta/@proj.Slug/)</span></div>
        <div class="mh-upload">
            <InputFile OnChange="OnZipSelected" accept=".zip,application/zip" class="form-control form-control-sm mh-file" />
            <input class="form-control form-control-sm" @bind="_uploadNotes" placeholder="Notas de la version (opcional)" />
            <button class="btn btn-sm btn-primary" disabled="@(_busy || _zip is null)" @onclick="UploadAsync">@(_busy ? "Subiendo..." : "Subir version")</button>
        </div>
        <div class="mh-hint">ZIP de la carpeta de la maqueta (con <code>anotador/</code> si quieres anotar). Max @(MockupService.MaxZipBytes / (1024 * 1024)) MB. Queda como version actual.</div>
        @if (_versions.Count == 0)
        {
            <div class="mh-muted">Aun no hay versiones.</div>
        }
        else
        {
            <table class="table table-sm mh-table">
                <thead><tr><th>#</th><th>Fecha</th><th>Subida por</th><th>Archivos</th><th>Entrada</th><th>Notas</th><th></th></tr></thead>
                <tbody>
                    @foreach (var v in _versions)
                    {
                        <tr>
                            <td>v@(v.Number) @if (v.IsCurrent) { <span class="badge bg-success ms-1">actual</span> }</td>
                            <td>@v.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@v.UploadedByName</td>
                            <td>@v.FileCount</td>
                            <td><code>@v.EntryPath</code></td>
                            <td>@v.Notes</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-link" href="@($"/maqueta/{proj.Slug}~{v.Number}/{v.EntryPath}")" target="_blank" rel="noopener">Ver</a>
                                @if (!v.IsCurrent)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => SetCurrentAsync(v)">Usar esta</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div class="mh-panel-actions">
            <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="ArchiveAsync">Archivar proyecto</button>
        </div>
    </div>
}

@if (_loading)
{
    <div class="mh-muted">Cargando...</div>
}
else if (_items.Count == 0)
{
    <div class="mh-empty">
        @if (_isAdmin)
        {
            <span>No hay maquetas todavia. Crea un proyecto y sube el ZIP de la carpeta de la maqueta.</span>
        }
        else
        {
            <span>No hay maquetas publicadas en tu empresa.</span>
        }
    </div>
}
else if (_current is not null)
{
    @if (_current.Url is { } frameUrl)
    {
        <iframe class="mh-frame" src="@frameUrl" title="Maqueta @_current.Label"></iframe>
    }
    else
    {
        <div class="mh-empty">Este proyecto aun no tiene versiones. @(_isAdmin ? "Abre Versiones y sube el ZIP." : "")</div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "p")] public string? ProjectKey { get; set; }

    /// <summary>Entrada del selector: maqueta en la nube (Project) o de disco local (solo dev).</summary>
    private sealed record HubItem(string Key, string Label, string? Url, MockupProjectDto? Project);

    private List<HubItem> _items = new();
    private HubItem? _current;
    private List<MockupVersionDto> _versions = new();
    private bool _loading = true;
    private bool _isAdmin;
    private bool _busy;
    private bool _showNew;
    private bool _showVersions;
    private string? _message;
    private bool _messageIsError;
    private Guid _tenantId;
    private Guid _userId;
    private string _userName = "Usuario";

    private string _newName = string.Empty;
    private string _newSlug = string.Empty;
    private string? _newDesc;
    private IBrowserFile? _zip;
    private string? _uploadNotes;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            Guid.TryParse(user.FindFirst("tenant_id")?.Value, out _tenantId);
            Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);
            _userName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
            var role = user.FindFirst("tenant_role")?.Value;
            _isAdmin = role is "Owner" or "Admin";
        }
        await ReloadAsync();
        _loading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loading) { return; }
        SelectCurrent();
        await LoadVersionsAsync();
    }

    private async Task ReloadAsync()
    {
        var cloud = await RunAsync(svc => svc.ListProjectsAsync());
        _items = cloud
            .Select(p => new HubItem(p.Slug, p.Name + (p.CurrentVersionNumber is int n ? $" (v{n})" : " (sin version)"),
                p.CurrentVersionNumber is null ? null : $"{MaquetaHub.PathPrefix}/{p.Slug}/{p.EntryPath}", p))
            .ToList();
        // Maquetas de disco local (solo Development/bandera): no chocan con un slug de la nube.
        foreach (var local in Hub.Projects.Where(l => _items.All(i => i.Key != l.Id)))
        {
            _items.Add(new HubItem(local.Id, local.Nombre + " (local)", local.AnotadorUrl, null));
        }
        SelectCurrent();
        await LoadVersionsAsync();
    }

    private void SelectCurrent()
        => _current = _items.FirstOrDefault(i => string.Equals(i.Key, ProjectKey, StringComparison.OrdinalIgnoreCase)) ?? _items.FirstOrDefault();

    private async Task LoadVersionsAsync()
    {
        _versions = _isAdmin && _showVersions && _current?.Project is { } p
            ? (await RunAsync(svc => svc.ListVersionsAsync(p.Id))).ToList()
            : new List<MockupVersionDto>();
    }

    private void OnProjectChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (_items.Any(i => i.Key == key)) { Nav.NavigateTo("maqueta?p=" + Uri.EscapeDataString(key!)); }
    }

    private async Task ToggleVersions()
    {
        _showVersions = !_showVersions;
        await LoadVersionsAsync();
    }

    private void SuggestSlug() => _newSlug = MockupService.SlugFrom(_newName);

    private async Task CreateProjectAsync()
    {
        _busy = true;
        var res = await RunAsync(svc => svc.CreateProjectAsync(_newName, _newSlug, _newDesc, _isAdmin));
        _busy = false;
        if (!res.IsOk || res.Value is null) { Show(res.Error ?? "No se pudo crear el proyecto.", true); return; }
        Show($"Proyecto '{res.Value.Name}' creado. Sube ahora el ZIP de la maqueta.", false);
        _showNew = false;
        _newName = _newSlug = string.Empty;
        _newDesc = null;
        _showVersions = true;
        Nav.NavigateTo("maqueta?p=" + Uri.EscapeDataString(res.Value.Slug));
        await ReloadAsync();
    }

    private void OnZipSelected(InputFileChangeEventArgs e) => _zip = e.File;

    private async Task UploadAsync()
    {
        if (_zip is null || _current?.Project is not { } p) { return; }
        if (_zip.Size > MockupService.MaxZipBytes) { Show($"El ZIP supera {MockupService.MaxZipBytes / (1024 * 1024)} MB.", true); return; }
        _busy = true;
        StateHasChanged();
        byte[] bytes;
        await using (var stream = _zip.OpenReadStream(MockupService.MaxZipBytes))
        {
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            bytes = ms.ToArray();
        }
        var res = await RunAsync(svc => svc.UploadVersionAsync(p.Slug, bytes, _uploadNotes, _userName, _isAdmin));
        _busy = false;
        if (!res.IsOk || res.Value is null) { Show(res.Error ?? "No se pudo subir la version.", true); return; }
        Show($"Version v{res.Value.Number} publicada ({res.Value.FileCount} archivos). Entrada: {res.Value.EntryPath}" +
             (res.Value.HasAnotador ? "" : " (sin anotador/: no se podra anotar)"), !res.Value.HasAnotador);
        _zip = null;
        _uploadNotes = null;
        await ReloadAsync();
    }

    private async Task SetCurrentAsync(MockupVersionDto v)
    {
        if (_current?.Project is not { } p) { return; }
        _busy = true;
        var res = await RunAsync(svc => svc.SetCurrentVersionAsync(p.Id, v.Id, _isAdmin));
        _busy = false;
        if (!res.IsOk) { Show(res.Error ?? "No se pudo cambiar la version.", true); return; }
        Show($"Ahora se sirve la v{v.Number}.", false);
        await ReloadAsync();
    }

    private async Task ArchiveAsync()
    {
        if (_current?.Project is not { } p) { return; }
        _busy = true;
        var res = await RunAsync(svc => svc.ArchiveProjectAsync(p.Id, _isAdmin));
        _busy = false;
        if (!res.IsOk) { Show(res.Error ?? "No se pudo archivar.", true); return; }
        Show($"Proyecto '{p.Name}' archivado.", false);
        _showVersions = false;
        Nav.NavigateTo("maqueta");
        await ReloadAsync();
    }

    private void Show(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }

    /// <summary>Cada operacion corre en un scope propio con el tenant de la sesion (el circuito no tiene HttpContext).</summary>
    private async Task<T> RunAsync<T>(Func<IMockupService, Task<T>> action)
    {
        using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(_tenantId, _userId);
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await action(scope.ServiceProvider.GetRequiredService<IMockupService>());
    }
}
