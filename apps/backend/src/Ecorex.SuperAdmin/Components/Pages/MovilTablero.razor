@page "/movil/tablero"
@attribute [Authorize(Policy = "TenantMember")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Ecorex.Application.Tenancy
@using Ecorex.Application.Forms
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Components.Shared.Forms
@inject IActivityBoardService BoardsSvc
@inject ITenantUserService TenantUsersSvc
@inject IFormResponseService FormsSvc
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Modulo MOVIL (primera vista): consultar un tablero, cambiar el estado con toques grandes, y un lector
   de codigo de barras que hace SALTAR la actividad al siguiente estado. Vista pensada para celular
   (una columna, targets grandes, barra inferior con el boton de escaneo). *@

<PageTitle>Tablero movil - ECOREX.tareas</PageTitle>

<div class="mv-wrap">

    @* ---- Encabezado + selector de tablero ---- *@
    <div class="mv-head">
        <div class="mv-head-title">
            <span class="mv-head-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
            </span>
            <h1>Tablero movil</h1>
        </div>
        <select class="mv-select" @onchange="OnBoardChanged">
            <option value="">-- Elige un tablero --</option>
            @foreach (var b in _boards)
            {
                <option value="@b.Id" selected="@(b.Id == _boardId)">@b.Name (@b.TaskCount)</option>
            }
        </select>
    </div>

    @if (_loading)
    {
        <p class="mv-hint">Cargando...</p>
    }
    else if (_detail is null)
    {
        <p class="mv-hint">Elige un tablero para ver sus actividades por estado.</p>
    }
    else
    {
        @* ---- Actividades agrupadas por ESTADO (columna) ---- *@
        @foreach (var col in _detail.Columns.OrderBy(c => c.SortOrder))
        {
            var color = string.IsNullOrWhiteSpace(col.Color) ? "#64748b" : col.Color!;
            <div class="mv-col-head" style="--dot:@color">
                <span class="mv-dot"></span>
                <span class="mv-col-name">@col.Name</span>
                <span class="mv-col-count">@col.Cards.Count</span>
            </div>
            @if (col.Cards.Count == 0)
            {
                <div class="mv-empty">Sin actividades.</div>
            }
            @foreach (var card in col.Cards)
            {
                <div class="mv-card" style="--dot:@color" @onclick="@(() => OpenMove(card))">
                    <div class="mv-card-top">
                        <span class="mv-num">@card.Number</span>
                        <span class="mv-prio" style="--prio-fg:@PriorityColor(card.Priority);--prio-bg:@PriorityBg(card.Priority)">@PriorityLabel(card.Priority)</span>
                    </div>
                    <div class="mv-title">@card.Title</div>
                    <div class="mv-meta">
                        <span class="mv-assignee">@(card.Assignee?.DisplayName ?? "Sin asignar")</span>
                        <span class="mv-change">
                            Cambiar estado
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </span>
                    </div>
                </div>
            }
        }
        <div style="height:8px;"></div>
    }

    @if (_toast is not null)
    {
        <div class="mv-toast @(_toastOk ? "ok" : "err")">@_toast</div>
    }
</div>

@* ---- Barra inferior: ESCANEAR ---- *@
<div class="mv-scanbar">
    <button class="mv-scan-btn" @onclick="OpenScanAsync" disabled="@(_busy || _detail is null)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M20 17v2a1 1 0 0 1-1 1h-2M7 20H5a1 1 0 0 1-1-1v-2"/><path d="M8 8v8M12 8v8M16 8v8"/></svg>
        Escanear codigo
    </button>
</div>

@* ---- Tarjeta de confirmacion de avance (tras escanear) ---- *@
@if (_pendingCard is { } pc)
{
    var fromC = string.IsNullOrWhiteSpace(_pendingFrom?.Color) ? "#64748b" : _pendingFrom!.Color!;
    var toC = string.IsNullOrWhiteSpace(_pendingTo?.Color) ? "#64748b" : _pendingTo!.Color!;
    <div class="mv-overlay center" @onclick="ClearPending">
        <div class="mv-confirm" style="--to:@toC" @onclick:stopPropagation="true">
            <div class="mv-confirm-kicker">CONFIRMAR AVANCE</div>
            <div class="mv-confirm-top">
                <span class="mv-num">@pc.Number</span>
                <span class="mv-prio" style="--prio-fg:@PriorityColor(pc.Priority);--prio-bg:@PriorityBg(pc.Priority)">@PriorityLabel(pc.Priority)</span>
            </div>
            <div class="mv-confirm-title">@pc.Title</div>
            <div class="mv-confirm-assignee">@(pc.Assignee?.DisplayName ?? "Sin asignar")</div>

            <div class="mv-transition">
                <span class="mv-chip" style="--chip:@fromC">@_pendingFrom?.Name</span>
                <span class="mv-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
                <span class="mv-chip to" style="--chip:@toC">@_pendingTo?.Name</span>
            </div>

            @* Aqui, en la siguiente iteracion, se pintaran/ejecutaran las reglas del avance. *@

            <div class="mv-confirm-actions">
                <button class="mv-btn mv-btn-ghost" @onclick="ClearPending" disabled="@_busy">Cancelar</button>
                <button class="mv-btn mv-btn-primary" @onclick="ConfirmAdvanceAsync" disabled="@_busy">Avanzar</button>
            </div>
        </div>
    </div>
}

@* ---- Modal del PASO ACTUAL del flujo (cuando la actividad escaneada esta gobernada por un flujo) ----
   Abre SOLO el punto donde esta el proceso (formulario del paso pendiente) para que el operario CONCRETE
   la accion; si el paso lleva a una compuerta exclusiva, el propio formulario ofrece las rutas (ApprovalOptions)
   y al enviar avanza el flujo (que mueve la tarjeta a la columna del siguiente nodo). Pensado para celular. *@
@if (_stepCard is { } sc && _stepForm is { } sf)
{
    <div class="mv-overlay bottom" style="z-index:88" @onclick="CloseStepAsync">
        <div class="mv-step" @onclick:stopPropagation="true">
            <div class="mv-grip"></div>
            <div class="mv-step-head">
                <div class="mv-step-head-row">
                    <div style="min-width:0;">
                        <div class="mv-step-kicker">PASO DEL PROCESO</div>
                        <div class="mv-step-title">@sc.Number · @(sf.NodeName ?? sf.FormTitle)</div>
                    </div>
                    <button class="mv-close" @onclick="CloseStepAsync" aria-label="Cerrar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </div>
                @if (sf.IsGatewayAhead && sf.ApprovalOptions is { Count: > 0 })
                {
                    <div class="mv-step-note">Al enviar elegiras la ruta del proceso.</div>
                }
            </div>
            <div class="mv-step-body">
                <DynamicFormRenderer DefinitionId="@sf.DefinitionId"
                                     ResponseId="@sf.ResponseId"
                                     Reference="@sf.Reference"
                                     Mode="FormRenderMode.Fill"
                                     SubmittedByTenantUserId="@_actorTenantUserId"
                                     EmbeddedInTask="true"
                                     ApprovalOptions="@(sf.IsGatewayAhead ? sf.ApprovalOptions : null)"
                                     OnSubmitted="@OnStepSubmittedAsync" />
            </div>
        </div>
    </div>
}

@* ---- Hoja para cambiar estado ---- *@
@if (_moveCard is { } mcard)
{
    <div class="mv-overlay bottom" @onclick="CloseMove">
        <div class="mv-sheet" @onclick:stopPropagation="true">
            <div class="mv-grip"></div>
            <div class="mv-sheet-title">@mcard.Number</div>
            <div class="mv-sheet-sub">@mcard.Title</div>
            <div class="mv-sheet-lbl">Mover a estado:</div>
            @foreach (var col in _detail!.Columns.OrderBy(c => c.SortOrder))
            {
                var c = string.IsNullOrWhiteSpace(col.Color) ? "#64748b" : col.Color!;
                var current = col.Id == mcard.ColumnId;
                <button class="mv-state-btn @(current ? "current" : "")" style="--dot:@c"
                        disabled="@(_busy || current)" @onclick="@(() => MoveToAsync(mcard, col))">
                    <span class="mv-dot"></span>
                    @col.Name
                    @if (current) { <span class="mv-state-cur">actual</span> }
                </button>
            }
            <button class="mv-sheet-close" @onclick="CloseMove">Cerrar</button>
        </div>
    </div>
}

@* ---- Hoja de escaneo ---- *@
@if (_scanOpen)
{
    <div class="mv-overlay dark">
        <div class="mv-scan-head">
            <div class="mv-scan-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M20 17v2a1 1 0 0 1-1 1h-2M7 20H5a1 1 0 0 1-1-1v-2"/><path d="M8 8v8M12 8v8M16 8v8"/></svg>
                Escanear codigo
            </div>
            <button class="mv-scan-x" @onclick="CloseScanAsync">Cerrar</button>
        </div>
        @if (_scanSupported)
        {
            <div class="mv-video-wrap">
                <video @ref="_videoEl" muted playsinline></video>
                <div class="mv-reticle"></div>
            </div>
            <div class="mv-scan-help">Apunta al codigo de barras de la actividad.</div>
        }
        else
        {
            <div class="mv-scan-unsupported">Este dispositivo no tiene lector de camara; escribe el numero de la actividad.</div>
        }
        <div class="mv-scan-manual">
            <input class="mv-scan-input" placeholder="Numero (ej. T00058)"
                   @bind="_scanManual" @bind:event="oninput" @onkeydown="OnManualKey" />
            <button class="mv-scan-go" @onclick="@(() => HandleCodeAsync(_scanManual))" disabled="@_busy">Buscar</button>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ActivityBoardSummaryDto> _boards = Array.Empty<ActivityBoardSummaryDto>();
    private Guid? _boardId;
    private ActivityBoardDetailDto? _detail;
    private bool _loading, _busy;

    private ActivityCardDto? _moveCard;

    // Avance pendiente de confirmar (tras escanear): la actividad y la transicion propuesta.
    private ActivityCardDto? _pendingCard;
    private ActivityBoardColumnDto? _pendingFrom;
    private ActivityBoardColumnDto? _pendingTo;

    private bool _scanOpen, _scanSupported;
    private string? _scanManual;
    private ElementReference _videoEl;
    private DotNetObjectReference<MovilTablero>? _selfRef;

    private string? _toast;
    private bool _toastOk;

    private Guid _actorId;
    private Guid? _actorTenantUserId;
    private string _actorName = "Movil";

    // Paso ACTUAL del flujo de la actividad escaneada (si la gobierna un flujo): se abre en un modal
    // para concretar la accion (formulario del paso + eventual compuerta exclusiva).
    private ActivityCardDto? _stepCard;
    private TaskStepFormDto? _stepForm;

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _actorId);
        _actorName = st.User.Identity?.Name ?? st.User.FindFirst("name")?.Value ?? "Movil";

        // TenantUserId del operario (para firmar el envio del formulario del paso).
        _actorTenantUserId = (await TenantUsersSvc.ListAsync())
            .FirstOrDefault(u => u.PlatformUserId == _actorId)?.Id;

        var index = await BoardsSvc.ListBoardsAsync(new ActivityBoardIndexFilter());
        _boards = index.Boards;
    }

    private async Task OnBoardChanged(ChangeEventArgs e)
    {
        _detail = null;
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _boardId = id;
            await ReloadAsync();
        }
        else { _boardId = null; }
    }

    private async Task ReloadAsync()
    {
        if (_boardId is not Guid id) { return; }
        _loading = true;
        try
        {
            var res = await BoardsSvc.GetBoardDetailAsync(id, new ActivityBoardDetailFilter(Scope: ActivityBoardScope.Team));
            _detail = res.IsOk ? res.Value : null;
        }
        finally { _loading = false; }
    }

    private void OpenMove(ActivityCardDto card) => _moveCard = card;
    private void CloseMove() => _moveCard = null;

    private async Task MoveToAsync(ActivityCardDto card, ActivityBoardColumnDto target)
    {
        if (card.ColumnId == target.Id) { return; }
        _busy = true;
        try
        {
            var res = await BoardsSvc.MoveTaskAsync(card.Id, target.Id, 0, _actorId, _actorName);
            if (res.IsOk) { ShowToast($"{card.Number} -> {target.Name}", true); await ReloadAsync(); }
            else { ShowToast(res.Error ?? "No se pudo mover.", false); }
        }
        finally { _busy = false; _moveCard = null; }
    }

    // ---- Escaneo ----

    private async Task OpenScanAsync()
    {
        _scanManual = null;
        _scanOpen = true;
        _selfRef ??= DotNetObjectReference.Create(this);
        try { _scanSupported = await JS.InvokeAsync<bool>("ecorexScan.supported"); }
        catch { _scanSupported = false; }
        StateHasChanged();                 // pinta el area de video si hay soporte; la entrada manual siempre
        if (_scanSupported)
        {
            await Task.Delay(60);          // deja montar el <video> antes de arrancar la camara
            // start() arranca la camara en 2do plano y devuelve de inmediato (no bloquea el circuito).
            try { await JS.InvokeAsync<ScanStartResult>("ecorexScan.start", _videoEl, _selfRef); }
            catch { _scanSupported = false; StateHasChanged(); }
        }
    }

    // La camara no esta disponible (permiso negado / sin camara): caer a la entrada manual.
    [JSInvokable]
    public Task OnScanUnavailable() => InvokeAsync(() => { _scanSupported = false; StateHasChanged(); });

    private async Task CloseScanAsync()
    {
        _scanOpen = false;
        try { await JS.InvokeVoidAsync("ecorexScan.stop"); } catch { }
    }

    [JSInvokable]
    public async Task OnScanned(string value)
    {
        await HandleCodeAsync(value);
    }

    private async Task OnManualKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { await HandleCodeAsync(_scanManual); }
    }

    // Localiza la actividad por su NUMERO en el tablero y la HACE SALTAR al siguiente estado.
    private async Task HandleCodeAsync(string? code)
    {
        var raw = (code ?? "").Trim();
        if (raw.Length == 0 || _detail is null) { return; }
        await CloseScanAsync();

        var cols = _detail.Columns.OrderBy(c => c.SortOrder).ToList();
        ActivityCardDto? found = null;
        int colIdx = -1;
        for (var i = 0; i < cols.Count; i++)
        {
            var m = cols[i].Cards.FirstOrDefault(c => string.Equals(c.Number, raw, StringComparison.OrdinalIgnoreCase));
            if (m is not null) { found = m; colIdx = i; break; }
        }
        if (found is null) { ShowToast($"No se encontro '{raw}' en este tablero.", false); return; }

        // Si la actividad esta gobernada por un FLUJO, el escaneo abre EL PUNTO donde esta el proceso
        // (el formulario del paso pendiente), no un simple avance de columna: el operario concreta la
        // accion ahi (incluida una compuerta exclusiva). Al enviar, el flujo avanza y mueve la tarjeta.
        try
        {
            var steps = await FormsSvc.GetTaskStepFormsAsync(found.Id);
            var pending = steps.FirstOrDefault(s => s.LinkStatus == FormFlowLinkStatus.Pending);
            if (pending is not null)
            {
                _stepCard = found;
                _stepForm = pending;
                return;
            }
        }
        catch { /* si falla la lectura del paso, se cae al avance por columna */ }

        // Sin flujo (o sin paso con formulario pendiente): avance lineal por tablero con confirmacion.
        if (colIdx >= cols.Count - 1) { ShowToast($"{found.Number} ya esta en el ultimo estado ({cols[colIdx].Name}).", false); return; }
        _pendingCard = found;
        _pendingFrom = cols[colIdx];
        _pendingTo = cols[colIdx + 1];
    }

    // El formulario del paso se envio: el flujo ya avanzo (movio la tarjeta a la columna del siguiente
    // nodo). Cerramos el modal, refrescamos el tablero y avisamos.
    private async Task OnStepSubmittedAsync(FormResponseDto _)
    {
        var num = _stepCard?.Number ?? "";
        _stepCard = null; _stepForm = null;
        await ReloadAsync();
        ShowToast($"{num}: paso completado.", true);
    }

    private void CloseStepAsync() { _stepCard = null; _stepForm = null; }

    // Confirmar el avance desde la tarjeta de escaneo. Aqui, mas adelante, se ejecutan las reglas.
    private async Task ConfirmAdvanceAsync()
    {
        if (_pendingCard is not { } card || _pendingTo is not { } to) { return; }
        _busy = true;
        try
        {
            // TODO (siguiente iteracion): ejecutar aqui las reglas de negocio ANTES/DESPUES de avanzar.
            var res = await BoardsSvc.MoveTaskAsync(card.Id, to.Id, 0, _actorId, _actorName);
            if (res.IsOk) { ShowToast($"{card.Number}: {_pendingFrom?.Name} -> {to.Name}", true); await ReloadAsync(); }
            else { ShowToast(res.Error ?? "No se pudo avanzar.", false); }
        }
        finally { _busy = false; ClearPending(); }
    }

    private void ClearPending() { _pendingCard = null; _pendingFrom = null; _pendingTo = null; }

    private void ShowToast(string msg, bool ok) { _toast = msg; _toastOk = ok; }

    // ---- Etiquetas de prioridad ----
    private static string PriorityLabel(TaskPriority p) => p switch
    {
        TaskPriority.High => "Alta", TaskPriority.Low => "Baja", _ => "Media"
    };
    private static string PriorityColor(TaskPriority p) => p switch
    {
        TaskPriority.High => "#c2410c", TaskPriority.Low => "#0369a1", _ => "#475569"
    };
    private static string PriorityBg(TaskPriority p) => p switch
    {
        TaskPriority.High => "#ffedd5", TaskPriority.Low => "#e0f2fe", _ => "#f1f5f9"
    };

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ecorexScan.stop"); } catch { }
        _selfRef?.Dispose();
    }

    private sealed record ScanStartResult(bool Ok, string? Reason);
}
