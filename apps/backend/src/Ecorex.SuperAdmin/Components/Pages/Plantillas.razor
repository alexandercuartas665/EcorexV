@page "/plantillas"
@attribute [Authorize(Policy = "TenantMember")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Marketplace
@using Ecorex.Domain.Enums
@inject IMarketplaceService MarketSvc
@inject NavigationManager Nav

@* Galeria del MARKETPLACE para el TENANT (ADR-0097 Ola B3): el usuario busca un flujo o formulario
   publicado y lo TRAE (import) a su tenant. Para un flujo con formularios en los nodos, el asistente
   pregunta si migrarlos. Al terminar muestra el reporte (codigo nuevo + lo que quedo sin mapear). *@

<PageTitle>Galeria de plantillas - ECOREX.tareas</PageTitle>

<div class="pl-page">
    <div class="pl-head">
        <div class="pl-eyebrow">ADR-0097 - PLANTILLAS</div>
        <h1 class="pl-title">Galeria de plantillas</h1>
        <p class="pl-sub">Flujos y formularios listos para traer a tu tenant. Al traer uno se crea una copia en BORRADOR que puedes ajustar y publicar.</p>
    </div>

    <div class="pl-toolbar">
        <input class="pl-search" placeholder="Buscar plantilla..." value="@_query" @oninput="@(e => _query = e.Value?.ToString() ?? "")" />
        <div class="pl-tabs">
            <button class="pl-tab @(_kind is null ? "on" : "")" @onclick="() => _kind = null">Todos <span class="pl-n">@_items.Count</span></button>
            <button class="pl-tab @(_kind == MarketplaceItemKind.Flow ? "on" : "")" @onclick="() => _kind = MarketplaceItemKind.Flow">Flujos <span class="pl-n">@_items.Count(i => i.Kind == MarketplaceItemKind.Flow)</span></button>
            <button class="pl-tab @(_kind == MarketplaceItemKind.Form ? "on" : "")" @onclick="() => _kind = MarketplaceItemKind.Form">Formularios <span class="pl-n">@_items.Count(i => i.Kind == MarketplaceItemKind.Form)</span></button>
        </div>
    </div>

    @if (_error is not null) { <div class="pl-error">@_error</div> }

    @if (_loading)
    {
        <p class="pl-loading"><em>Cargando plantillas...</em></p>
    }
    else if (Filtered.Count == 0)
    {
        <div class="pl-empty">Aun no hay plantillas publicadas para traer.</div>
    }
    else
    {
        <div class="pl-grid">
            @foreach (var it in Filtered)
            {
                <div class="pl-card">
                    <div class="pl-img">
                        @if (!string.IsNullOrEmpty(it.ImageRef))
                        {
                            <img src="@it.ImageRef" alt="@it.Title" />
                        }
                        else
                        {
                            <div class="pl-noimg">@(it.Kind == MarketplaceItemKind.Flow ? "Flujo" : "Formulario")</div>
                        }
                    </div>
                    <div class="pl-body">
                        <div class="pl-kind">
                            <span class="pl-badge @(it.Kind == MarketplaceItemKind.Flow ? "flow" : "form")">@(it.Kind == MarketplaceItemKind.Flow ? "FLUJO" : "FORMULARIO")</span>
                            @if (!string.IsNullOrWhiteSpace(it.Category)) { <span class="pl-cat">@it.Category</span> }
                        </div>
                        <div class="pl-ctitle">@it.Title</div>
                        <div class="pl-desc">@(it.Description ?? "")</div>
                        <div class="pl-foot">
                            <span class="pl-meta">@it.ImportCount traidas</span>
                            <button class="pl-bring" @onclick="() => StartTraerAsync(it)" disabled="@_busy">Traer</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ---- Asistente: migrar formularios de los nodos (solo flujo con node-forms) ---- *@
@if (_wizard is not null)
{
    <div class="pl-modal-back" @onclick="CloseWizard">
        <div class="pl-modal" @onclick:stopPropagation="true">
            <div class="pl-modal-h">Traer flujo: @_wizard.Title</div>
            <p class="pl-modal-p">
                Este flujo trae <b>@_wizard.NodeFormsCount formulario(s)</b> vinculado(s) a sus nodos.
                Deseas migrarlos junto con el flujo?
            </p>
            <label class="pl-check">
                <input type="checkbox" checked="@_wizardIncludeForms" @onchange="@(e => _wizardIncludeForms = (bool)(e.Value ?? false))" />
                Migrar los formularios de los nodos
            </label>
            <p class="pl-hint">Si no los migras, el flujo llega sin sus formularios de paso (podras enlazarlos luego a mano).</p>
            <div class="pl-modal-actions">
                <button class="pl-mbtn ghost" @onclick="CloseWizard" disabled="@_busy">Cancelar</button>
                <button class="pl-mbtn go" @onclick="ConfirmWizardAsync" disabled="@_busy">@(_busy ? "Trayendo..." : "Traer")</button>
            </div>
        </div>
    </div>
}

@* ---- Reporte de la importacion ---- *@
@if (_report is not null)
{
    <div class="pl-modal-back" @onclick="CloseReport">
        <div class="pl-modal" @onclick:stopPropagation="true">
            <div class="pl-modal-h">Plantilla traida</div>
            <p class="pl-modal-p">
                Se creo @(_report.Kind == MarketplaceItemKind.Flow ? "el flujo" : "el formulario")
                <b>@_report.NewTitle</b> (<code>@_report.NewCode</code>) en tu tenant, en estado BORRADOR.
            </p>
            @if (_report.Kind == MarketplaceItemKind.Flow)
            {
                <ul class="pl-rep">
                    <li>Formularios de nodo importados: <b>@_report.FormsImported</b></li>
                    @if (_report.UnmappedCargos.Count > 0) { <li class="warn">Cargos sin mapear: @string.Join(", ", _report.UnmappedCargos)</li> }
                    @if (_report.UnmappedAgents.Count > 0) { <li class="warn">Agentes sin mapear: @string.Join(", ", _report.UnmappedAgents)</li> }
                    @if (_report.UnmappedRules.Count > 0) { <li class="warn">Reglas sin mapear: @string.Join(", ", _report.UnmappedRules)</li> }
                    @foreach (var w in _report.Warnings) { <li class="warn">@w</li> }
                    @if (_report.UnmappedCargos.Count == 0 && _report.UnmappedAgents.Count == 0 && _report.UnmappedRules.Count == 0 && _report.Warnings.Count == 0)
                    {
                        <li>Todo se mapeo sin pendientes.</li>
                    }
                </ul>
                <p class="pl-hint">Revisa lo que quedo sin asignar antes de publicar el flujo.</p>
            }
            <div class="pl-modal-actions">
                <button class="pl-mbtn ghost" @onclick="CloseReport">Cerrar</button>
                <button class="pl-mbtn go" @onclick="GoToImported">
                    @(_report.Kind == MarketplaceItemKind.Flow ? "Ir a Flujos" : "Ir a Formularios")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "kind")] public string? KindQuery { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _query = "";
    private MarketplaceItemKind? _kind;
    private List<MarketplaceItemDto> _items = new();

    private MarketplaceImportPreviewDto? _wizard;
    private bool _wizardIncludeForms = true;
    private MarketplaceImportResult? _report;

    protected override async Task OnInitializedAsync()
    {
        _kind = KindQuery?.ToLowerInvariant() switch
        {
            "flow" => MarketplaceItemKind.Flow,
            "form" => MarketplaceItemKind.Form,
            _ => null
        };
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try { _items = (await MarketSvc.ListAsync(null, null, null, includeInactive: false)).ToList(); _error = null; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private List<MarketplaceItemDto> Filtered
    {
        get
        {
            var q = _items.AsEnumerable();
            if (_kind is MarketplaceItemKind k) { q = q.Where(i => i.Kind == k); }
            var t = _query.Trim();
            if (t.Length > 0)
            {
                q = q.Where(i => i.Title.Contains(t, StringComparison.OrdinalIgnoreCase)
                    || (i.Description ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            return q.ToList();
        }
    }

    private async Task StartTraerAsync(MarketplaceItemDto it)
    {
        _error = null;
        // Solo el flujo con formularios de nodo abre el asistente; el resto se trae directo.
        if (it.Kind == MarketplaceItemKind.Flow)
        {
            _busy = true;
            MarketplaceImportPreviewDto? prev;
            try { prev = await MarketSvc.GetImportPreviewAsync(it.Id); }
            catch (Exception ex) { _error = ex.Message; _busy = false; return; }
            _busy = false;
            if (prev is { HasNodeForms: true })
            {
                _wizard = prev;
                _wizardIncludeForms = true;
                return;
            }
        }
        await DoImportAsync(it.Id, includeNodeForms: true);
    }

    private async Task ConfirmWizardAsync()
    {
        if (_wizard is null) { return; }
        var id = _wizard.Id;
        var inc = _wizardIncludeForms;
        _wizard = null;
        await DoImportAsync(id, inc);
    }

    private async Task DoImportAsync(Guid id, bool includeNodeForms)
    {
        _busy = true;
        try
        {
            var res = await MarketSvc.ImportAsync(id, includeNodeForms);
            if (res.Ok && res.Value is not null) { _report = res.Value; await ReloadAsync(); }
            else { _error = res.Error ?? "No se pudo traer la plantilla."; }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void CloseWizard() { _wizard = null; }
    private void CloseReport() { _report = null; }

    private void GoToImported()
    {
        var flow = _report?.Kind == MarketplaceItemKind.Flow;
        _report = null;
        Nav.NavigateTo(flow ? "flujos" : "formularios");
    }
}
