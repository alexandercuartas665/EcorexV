@page "/plantillas-correo"
@attribute [Authorize]
@* Administrador de PLANTILLAS DE CORREO del motor de acciones por filtro (ADR-0056, paso E-mail) con el
   AGENTE EDITOR DE PLANTILLAS (ADR-0175): editor en 3 columnas (campos | vista previa en iframe sandbox |
   chat del agente), verificacion en vivo, versiones con Restaurar y lista de bajas de correo.
   ADR-0176: MARCA DE CORREO (logo, colores, estilo por defecto, datos del pie), GALERIA de imagenes con URL
   publica y SELECTOR DE ESTILOS de diseno que afina al agente. Solo ASCII. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Gestor
@using Ecorex.Application.Gestor.TemplateAgent
@using Ecorex.Application.Tenancy
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Components.Shared.Templates
@using Microsoft.AspNetCore.Components.Authorization
@inject IEmailTemplateService Svc
@inject ITemplateSnapshotService Snapshots
@inject IEmailUnsubscribeService Bajas
@inject ITemplateAgentChatService AgentChat
@inject IEmailBrandService BrandSvc
@inject ITemplateAssetService Assets
@inject ITemplateGalleryService Gallery
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Plantillas de correo - ECOREX.tareas</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <span>Negocio</span>
    <span class="sep">/</span>
    <span class="cur">Plantillas de correo</span>
</nav>

@if (!_editOpen)
{
    <div class="page-header">
        <div>
            <div class="pc-eyebrow">MOTOR DE ACCIONES &#183; E-MAIL</div>
            <h1 class="page-title" style="margin-top:6px;">Plantillas de correo</h1>
            <p class="page-sub" style="margin-bottom:0;">Asunto y cuerpo con variables que se reemplazan con los datos del contacto al enviar. Crea o edita una plantilla a mano o con el <b>agente de plantillas</b> (describe el correo o adjunta una captura para replicarlo). Las activas aparecen en el disenador de acciones (paso E-mail).</p>
        </div>
        <div class="pc-head-actions">
            <button class="btn btn-outline-secondary" @onclick="() => OpenGalleryAsync(false)">Galeria</button>
            <button class="btn btn-primary" @onclick="OpenNew">+ Nueva plantilla</button>
        </div>
    </div>

    @* Tarjeta de la MARCA DE CORREO: lo que el agente aplica a todos los correos (ADR-0176). *@
    <button class="pc-brandbar" @onclick="OpenBrand" title="Editar la marca de correo">
        <span class="pc-brand-logo">
            @if (!string.IsNullOrWhiteSpace(_brand?.LogoEfectivo))
            {
                <img src="@_brand!.LogoEfectivo" alt="Logo" />
            }
            else
            {
                <span>@Initials(_brand?.Empresa)</span>
            }
        </span>
        <span class="pc-brand-main">
            <span class="pc-brand-t">Marca de correo</span>
            <span class="pc-brand-s">
                <span class="pc-sw" style="background:@(_brand?.ColorPrimario ?? "#d9dce3")" title="Color principal"></span>
                <span class="pc-sw" style="background:@(_brand?.ColorAcento ?? "#eceef2")" title="Color de acento"></span>
                Estilo por defecto: <b>@StyleName(_brand?.EstiloPorDefecto)</b>
                @if (string.IsNullOrWhiteSpace(_brand?.ColorPrimario))
                {
                    <span class="pc-brand-hint">&#183; configura tus colores para que todos los correos salgan con tu marca</span>
                }
            </span>
        </span>
        <span class="pc-brand-edit">Editar</span>
    </button>

    @if (_loading)
    {
        <p class="text-muted">Cargando plantillas...</p>
    }
    else
    {
        <div class="pc-list">
            @if (_items.Count == 0)
            {
                <p class="text-muted">Aun no hay plantillas. Usa "+ Nueva plantilla" para crear la primera (a mano o con el agente).</p>
            }
            @foreach (var t in _items)
            {
                var tt = t;
                <div class="pc-row">
                    <div class="pc-main">
                        <div class="pc-name">
                            @tt.Nombre
                            @if (!tt.Activa)
                            {
                                <span class="pc-badge pc-off">Inactiva</span>
                            }
                            else
                            {
                                <span class="pc-badge pc-on">Activa</span>
                            }
                            @if (EmailDesignStyles.Find(tt.Estilo) is { } st)
                            {
                                <span class="pc-badge pc-style">@st.Nombre</span>
                            }
                        </div>
                        <div class="pc-subj">@(string.IsNullOrWhiteSpace(tt.Asunto) ? "(sin asunto)" : tt.Asunto)</div>
                    </div>
                    <div class="pc-actions">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(tt)">Editar</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => DeleteAsync(tt)" disabled="@_busy">Eliminar</button>
                    </div>
                </div>
            }
        </div>

        <div class="pc-bajas">
            <button class="pc-bajas-toggle" @onclick="ToggleBajasAsync">
                @(_bajasOpen ? "v" : ">") Bajas de correo
                @if (_bajas is not null) { <span class="pc-badge pc-off">@_bajas.Count</span> }
            </button>
            @if (_bajasOpen)
            {
                <p class="text-muted small" style="margin:6px 0 8px;">Contactos que abrieron el enlace {enlace_baja} de un correo. El motor de acciones ya no les envia correos. Quitar una baja solo si el contacto pidio volver a recibirlos.</p>
                @if (_bajas is null || _bajas.Count == 0)
                {
                    <p class="text-muted small">Nadie se ha dado de baja.</p>
                }
                else
                {
                    @foreach (var b in _bajas)
                    {
                        var bb = b;
                        <div class="pc-baja-row">
                            <span class="pc-baja-mail">@bb.Email</span>
                            <span class="text-muted small">@bb.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") &#183; @bb.Origen@(string.IsNullOrWhiteSpace(bb.Motivo) ? "" : " - " + bb.Motivo)</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveBajaAsync(bb)" disabled="@_busy">Quitar</button>
                        </div>
                    }
                }
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="text-danger small" style="margin-top:10px">@_error</div>
    }
}
else
{
    @* ===== Editor: campos | vista previa | agente ===== *@
    <div class="pe-top">
        <button class="btn btn-sm btn-outline-secondary" @onclick="CloseEditorAsync">&larr; Plantillas</button>
        <div class="pe-title">@(_editingId is null ? "Nueva plantilla" : _fNombre)</div>
        @if (_dirty) { <span class="pe-dirty">Cambios sin guardar</span> }
        <div class="pe-top-actions">
            <button class="btn btn-sm btn-outline-secondary" @onclick="OpenBrand" title="Logo, colores y datos del pie">Marca</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenGalleryAsync(false)" title="Imagenes para tus correos">Galeria</button>
            @if (_editingId is not null)
            {
                <select class="form-select form-select-sm pe-versions" @onchange="OnVersionPicked" disabled="@_busy">
                    <option value="">Versiones (@_versions.Count)</option>
                    @foreach (var v in _versions)
                    {
                        <option value="@v.Id">@v.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm") &#183; @v.Label</option>
                    }
                </select>
            }
            <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@_busy">Guardar</button>
        </div>
    </div>

    <div class="pe-grid">
        <div class="pe-col pe-fields">
            <div class="field">
                <label class="form-label">Nombre *</label>
                <input class="form-control" value="@_fNombre" @oninput="e => { _fNombre = e.Value?.ToString() ?? string.Empty; _dirty = true; }" maxlength="200" placeholder="Ej. Bienvenida prospectos" />
            </div>
            <div class="field">
                <label class="form-label">Asunto *</label>
                <input class="form-control" value="@_fAsunto" @oninput="e => { _fAsunto = e.Value?.ToString() ?? string.Empty; _dirty = true; }" maxlength="300" placeholder="Hola {nombre}, una propuesta para {empresa}" />
            </div>
            <div class="field pe-html">
                <label class="form-label">Cuerpo (HTML)</label>
                <textarea class="form-control pe-code" value="@_fCuerpo" @oninput="e => { _fCuerpo = e.Value?.ToString() ?? string.Empty; _dirty = true; }" spellcheck="false" placeholder="&lt;table role=&quot;presentation&quot; width=&quot;600&quot;&gt;...&lt;/table&gt;"></textarea>
            </div>
            <label class="pc-check">
                <input type="checkbox" checked="@_fActiva" @onchange="e => { _fActiva = (bool)(e.Value ?? false); _dirty = true; }" />
                <span>Activa (disponible en el disenador de acciones)</span>
            </label>
            <div class="pe-vars">
                <div class="pc-prev-lbl">VARIABLES</div>
                @foreach (var v in EmailTemplateService.Variables)
                {
                    <span class="pe-var" title="@v.Descripcion">{@v.Token}</span>
                }
            </div>
            @if (_modalError is not null)
            {
                <div class="text-danger small">@_modalError</div>
            }
        </div>

        <div class="pe-col pe-preview">
            <div class="pc-prev-lbl">VISTA PREVIA &#183; datos de ejemplo (Juan Perez / ACME S.A.S)</div>
            <div class="pc-prev-subj"><b>Asunto:</b> @EmailTemplateService.RenderTemplate(_fAsunto, EmailTemplateService.SampleFields, htmlEscapeValues: false)</div>
            @* iframe SANDBOX (sin scripts, sin mismo origen): el HTML -de la IA o pegado- no corre en el origen de la app. *@
            <iframe class="pe-frame" sandbox="" title="Vista previa del correo" srcdoc="@PreviewDoc()"></iframe>
            @{ var vr = EmailTemplateVerifier.Verify(_fAsunto, _fCuerpo); }
            <div class="pe-verify @(vr.Errors > 0 ? "bad" : vr.Warnings > 0 ? "warn" : "ok")">
                <div class="pe-verify-h">
                    @if (vr.Errors == 0 && vr.Warnings == 0) { <span>Verificacion: todo en orden.</span> }
                    else { <span>Verificacion: @vr.Errors error(es), @vr.Warnings aviso(s)</span> }
                </div>
                @foreach (var i in vr.Issues)
                {
                    <div class="pe-issue @i.Severity"><b>@(i.Severity == "error" ? "Error" : "Aviso")</b> (@i.Where): @i.Problem <span class="text-muted">@i.Fix</span></div>
                }
            </div>
        </div>

        <div class="pe-col pe-chat">
            @* SELECTOR DE ESTILO (ADR-0176): el estilo viaja al agente al inicio de cada mensaje. *@
            @{ var cur = EmailDesignStyles.Find(_styleKey) ?? EmailDesignStyles.All[0]; }
            <div class="pe-style">
                <button class="pe-style-cur" @onclick="() => _stylePickerOpen = !_stylePickerOpen" title="Elegir el estilo de diseno del correo">
                    <span class="pe-style-bar">
                        @foreach (var c in cur.Muestra) { <i style="background:@c"></i> }
                    </span>
                    <span class="pe-style-txt">
                        <span class="pe-style-lbl">ESTILO DE DISENO</span>
                        <b>@cur.Nombre</b>
                    </span>
                    <span class="pe-style-caret">@(_stylePickerOpen ? "Cerrar" : "Cambiar")</span>
                </button>
                @if (_stylePickerOpen)
                {
                    <div class="pe-style-grid">
                        @foreach (var s in EmailDesignStyles.All)
                        {
                            var ss = s;
                            <button class="pe-style-card @(ss.Key == _styleKey ? "on" : "")" @onclick="() => PickStyle(ss.Key)">
                                <span class="pe-style-bar">
                                    @foreach (var c in ss.Muestra) { <i style="background:@c"></i> }
                                </span>
                                <b>@ss.Nombre</b>
                                <span>@ss.Descripcion</span>
                            </button>
                        }
                    </div>
                }
                @if (_editingId is not null && !string.IsNullOrWhiteSpace(_fCuerpo) && _styleKey != _savedStyle)
                {
                    <div class="pe-style-apply">
                        <span>La plantilla esta en <b>@StyleName(_savedStyle)</b>.</span>
                        <button class="btn btn-sm btn-primary" @onclick="ApplyStyleAsync">Redisenar en @cur.Nombre</button>
                    </div>
                }
            </div>
            <TemplateAgentChatPanel @ref="_panel" @key="_panelKey" Kind="TemplateAgentKind.Email" TemplateId="_editingId"
                                    OnTemplateChanged="OnAgentChangedAsync" MessagePrefix="StylePrefix" />
        </div>
    </div>
}

@* ===== Modal: MARCA DE CORREO (ADR-0176) ===== *@
@if (_brandOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:620px;">
            <div class="modal-head">
                <h3>Marca de correo</h3>
                <button class="modal-close" @onclick="() => _brandOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-muted small" style="margin-top:0;">El agente aplica esta marca a <b>todos</b> los correos: logo, colores, estilo por defecto y datos reales del pie.</p>

                @* Muestra en vivo de la banda y el boton con los colores elegidos. *@
                <div class="pb-preview">
                    <div class="pb-band" style="background:@(_bPrim ?? "#0d2c4b")">
                        @if (!string.IsNullOrWhiteSpace(BrandLogoPreview))
                        {
                            <img src="@BrandLogoPreview" alt="Logo" />
                        }
                        else
                        {
                            <span class="pb-word">@(_brand?.Empresa ?? "Tu empresa")</span>
                        }
                    </div>
                    <div class="pb-body">
                        <div class="pb-hero">Asi se vera tu correo</div>
                        <span class="pb-cta" style="background:@(_bAcc ?? "#e8833a")">Boton de accion</span>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Logo para correos</label>
                    <div class="pb-logo-row">
                        <span class="text-muted small">
                            @if (!string.IsNullOrWhiteSpace(_bLogo)) { <span>Logo de la galeria.</span> }
                            else { <span>Se usa el logo de la empresa (Mi cuenta).</span> }
                        </span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenGalleryAsync(true)">Elegir de la galeria</button>
                        @if (!string.IsNullOrWhiteSpace(_bLogo))
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _bLogo = null">Usar el de la empresa</button>
                        }
                    </div>
                    <div class="text-muted" style="font-size:11px;margin-top:4px;">Tip: si tu banda es oscura, sube a la galeria una version clara (blanca) del logo en PNG.</div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label class="form-label">Color principal</label>
                        <div class="pb-color">
                            <input type="color" value="@(_bPrim ?? "#0d2c4b")" @oninput="e => _bPrim = e.Value?.ToString()" />
                            <input class="form-control" value="@_bPrim" @onchange="e => _bPrim = e.Value?.ToString()" placeholder="#0d2c4b" maxlength="7" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="form-label">Color de acento (botones)</label>
                        <div class="pb-color">
                            <input type="color" value="@(_bAcc ?? "#e8833a")" @oninput="e => _bAcc = e.Value?.ToString()" />
                            <input class="form-control" value="@_bAcc" @onchange="e => _bAcc = e.Value?.ToString()" placeholder="#e8833a" maxlength="7" />
                        </div>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Estilo de diseno por defecto</label>
                    <select class="form-select" value="@_bEstilo" @onchange="e => _bEstilo = e.Value?.ToString()">
                        @foreach (var s in EmailDesignStyles.All)
                        {
                            <option value="@s.Key">@s.Nombre - @s.Descripcion</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="form-label">Sitio web</label>
                    <input class="form-control" value="@_bSitio" @onchange="e => _bSitio = e.Value?.ToString()" placeholder="https://miempresa.com" maxlength="300" />
                    <div class="text-muted" style="font-size:11px;margin-top:4px;">Va en el pie y es el destino por defecto de los botones.</div>
                </div>

                <div class="field">
                    <label class="form-label">Texto adicional del pie (opcional)</label>
                    <textarea class="form-control" rows="2" value="@_bPie" @onchange="e => _bPie = e.Value?.ToString()" placeholder="Ej. Lunes a viernes 8am-6pm - Instagram @@miempresa" maxlength="1000"></textarea>
                </div>

                <div class="pb-contact">
                    <div class="pc-prev-lbl">DATOS DE CONTACTO DEL PIE (de Mi cuenta &gt; Datos de la empresa)</div>
                    <div>@(_brand?.Empresa) &#183; @(Or(_brand?.Direccion, "sin direccion")) &#183; @(Or(_brand?.Ciudad, "sin ciudad")) &#183; @(Or(_brand?.Telefono, "sin telefono")) &#183; @(Or(_brand?.Correo, "sin correo"))</div>
                </div>

                @if (_brandError is not null)
                {
                    <div class="text-danger small" style="margin-top:8px;">@_brandError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _brandOpen = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveBrandAsync" disabled="@_brandBusy">Guardar marca</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: GALERIA DE IMAGENES (ADR-0176) ===== *@
@if (_galleryOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:900px;">
            <div class="modal-head">
                <h3>@(_galleryForLogo ? "Elige el logo para tus correos" : "Galeria de imagenes")</h3>
                <button class="modal-close" @onclick="CloseGallery">&times;</button>
            </div>
            <div class="modal-body">
                <div class="pg-upload">
                    <label class="btn btn-primary btn-sm pg-upload-btn">
                        <InputFile OnChange="OnGalleryFilesAsync" multiple accept="image/png,image/jpeg,image/gif" style="display:none;" />
                        @(_galleryBusy ? "Subiendo..." : "Subir imagenes")
                    </label>
                    <span class="text-muted small">PNG, JPG o GIF hasta 3 MB (ideal &lt; 300 KB). Las imagenes quedan con un enlace publico para que se vean dentro de los correos.</span>
                </div>
                @if (_galleryError is not null)
                {
                    <div class="text-danger small" style="margin:8px 0;">@_galleryError</div>
                }
                @{ var imgs = _assets.Where(a => IsEmailImage(a.MimeType)).ToList(); }
                @if (imgs.Count == 0)
                {
                    <p class="text-muted small" style="margin-top:14px;">Aun no hay imagenes. Sube tu logo, fotos de producto o banners; luego pidele al agente que las use.</p>
                }
                else
                {
                    <div class="pg-grid">
                        @foreach (var a in imgs)
                        {
                            var aa = a;
                            <div class="pg-card">
                                <div class="pg-thumb"><img src="@aa.Url" alt="@aa.Alt" loading="lazy" /></div>
                                <div class="pg-name" title="@aa.FileName">@aa.FileName</div>
                                <div class="pg-meta">@(aa.Width is int w && aa.Height is int h ? $"{w} x {h} px" : "") &#183; @Kb(aa.SizeBytes)</div>
                                <input class="form-control form-control-sm pg-alt" value="@aa.Alt" placeholder="Descripcion (alt)" maxlength="200"
                                       @onchange="e => SaveAltAsync(aa, e.Value?.ToString())" title="Descripcion de la imagen: la usa el agente como texto alternativo" />
                                <div class="pg-actions">
                                    @if (_galleryForLogo)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="() => PickLogo(aa)">Usar como logo</button>
                                    }
                                    else
                                    {
                                        @if (_editOpen)
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => UseInChat(aa)" title="Pide al agente que use esta imagen">Al chat</button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyUrlAsync(aa)" title="Copiar el enlace publico">Copiar URL</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => DeleteAssetAsync(aa)" title="Quitar de la galeria">Quitar</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (_copied is not null)
                {
                    <div class="pg-copied">Enlace copiado: @_copied</div>
                }
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<EmailTemplateDto> _items = new();

    private bool _editOpen;
    private Guid? _editingId;
    private Guid _panelKey = Guid.NewGuid();
    private TemplateAgentChatPanel? _panel;
    private string? _modalError;
    private string _fNombre = "";
    private string _fAsunto = "";
    private string _fCuerpo = "";
    private bool _fActiva = true;
    private bool _dirty;
    private List<TemplateSnapshotDto> _versions = new();

    private bool _bajasOpen;
    private List<EmailUnsubscribeDto>? _bajas;

    // --- Estilo de diseno (ADR-0176) ---
    private string _styleKey = EmailDesignStyles.DefaultKey;
    private string _savedStyle = EmailDesignStyles.DefaultKey;
    private bool _stylePickerOpen;

    // --- Marca de correo ---
    private EmailBrandDto? _brand;
    private bool _brandOpen;
    private bool _brandBusy;
    private string? _brandError;
    private string? _bLogo;
    private string? _bPrim;
    private string? _bAcc;
    private string? _bEstilo;
    private string? _bSitio;
    private string? _bPie;

    // --- Galeria ---
    private bool _galleryOpen;
    private bool _galleryForLogo;
    private bool _galleryBusy;
    private string? _galleryError;
    private string? _copied;
    private List<TemplateAssetDto> _assets = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _bajas = (await Bajas.ListAsync()).ToList();
        _brand = await BrandSvc.GetAsync();
        _loading = false;
    }

    private async Task ReloadAsync() => _items = (await Svc.ListAsync()).ToList();

    private string BrandDefaultStyle => EmailDesignStyles.Normalize(_brand?.EstiloPorDefecto) ?? EmailDesignStyles.DefaultKey;

    private void OpenNew()
    {
        _modalError = null;
        _editingId = null;
        _fNombre = ""; _fAsunto = ""; _fCuerpo = ""; _fActiva = true;
        _dirty = false;
        _versions = new();
        _styleKey = _savedStyle = BrandDefaultStyle;
        _stylePickerOpen = false;
        _panelKey = Guid.NewGuid();
        _editOpen = true;
    }

    private async Task OpenEdit(EmailTemplateDto t)
    {
        _modalError = null;
        _editingId = t.Id;
        _fNombre = t.Nombre; _fAsunto = t.Asunto; _fCuerpo = t.CuerpoHtml; _fActiva = t.Activa;
        _dirty = false;
        _styleKey = _savedStyle = EmailDesignStyles.Normalize(t.Estilo) ?? BrandDefaultStyle;
        _stylePickerOpen = false;
        _panelKey = Guid.NewGuid();
        _editOpen = true;
        await LoadVersionsAsync();
    }

    private async Task CloseEditorAsync()
    {
        if (_dirty && !await JS.InvokeAsync<bool>("confirm", "Hay cambios sin guardar. Salir de todas formas?")) { return; }
        _editOpen = false;
        await ReloadAsync();
    }

    private async Task LoadVersionsAsync()
        => _versions = _editingId is Guid id ? (await Snapshots.ListAsync(TemplateAgentKind.Email, id)).ToList() : new();

    // El agente aplico un cambio (o creo la plantilla): se recarga el editor con lo guardado.
    private async Task OnAgentChangedAsync(Guid? templateId)
    {
        if (templateId is not Guid id) { return; }
        var t = await Svc.GetAsync(id);
        if (t is null) { return; }
        _editingId = id;
        _fNombre = t.Nombre; _fAsunto = t.Asunto; _fCuerpo = t.CuerpoHtml; _fActiva = t.Activa;
        if (EmailDesignStyles.Normalize(t.Estilo) is { } st) { _savedStyle = st; }
        _dirty = false;
        await LoadVersionsAsync();
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_fNombre)) { _modalError = "El nombre es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_fAsunto)) { _modalError = "El asunto es obligatorio."; return; }
        _busy = true;
        try
        {
            EmailTemplateDto? res;
            if (_editingId is Guid id)
            {
                // El guardado manual NO cambia el estilo registrado (lo fija el agente al redisenar).
                var req = new SaveEmailTemplateRequest(_fNombre, _fAsunto, _fCuerpo, _fActiva);
                // Version previa tambien en el guardado manual (se puede volver atras igual que con el agente).
                try { await Snapshots.SnapshotAsync(TemplateAgentKind.Email, id, "Antes de: guardado manual", null, await ActorAsync()); }
                catch { /* best-effort */ }
                res = await Svc.UpdateAsync(id, req);
                // Avisa al agente que la plantilla cambio fuera del chat (no reaplicar cambios viejos).
                if (res is not null) { try { await AgentChat.NoteExternalChangeAsync(TemplateAgentKind.Email, id, "El usuario edito y guardo la plantilla a mano."); } catch { } }
            }
            else
            {
                res = await Svc.CreateAsync(new SaveEmailTemplateRequest(_fNombre, _fAsunto, _fCuerpo, _fActiva, _styleKey));
                // La plantilla nueva ya existe: el chat se re-monta ligado a ella (si no, el agente crearia otra).
                if (res is not null) { _panelKey = Guid.NewGuid(); _savedStyle = _styleKey; }
            }
            if (res is null) { _modalError = "No se pudo guardar la plantilla."; return; }
            _editingId = res.Id;
            _dirty = false;
            await LoadVersionsAsync();
        }
        finally { _busy = false; }
    }

    // ---------- Estilo ----------

    private string? StylePrefix() => EmailDesignStyles.TagFor(_styleKey);

    private void PickStyle(string key)
    {
        _styleKey = EmailDesignStyles.Normalize(key) ?? EmailDesignStyles.DefaultKey;
        _stylePickerOpen = false;
    }

    private async Task ApplyStyleAsync()
    {
        if (_panel is null) { return; }
        await _panel.SendTextAsync("Redisena la plantilla completa con este estilo, conservando textos, variables, enlaces e imagenes.");
    }

    private static string StyleName(string? key) => (EmailDesignStyles.Find(key) ?? EmailDesignStyles.All[0]).Nombre;

    // ---------- Marca ----------

    private string? BrandLogoPreview => string.IsNullOrWhiteSpace(_bLogo) ? _brand?.LogoEmpresa : _bLogo;

    private void OpenBrand()
    {
        _brandError = null;
        _bLogo = _brand?.LogoUrl;
        _bPrim = _brand?.ColorPrimario;
        _bAcc = _brand?.ColorAcento;
        _bEstilo = _brand?.EstiloPorDefecto ?? EmailDesignStyles.DefaultKey;
        _bSitio = _brand?.SitioWeb;
        _bPie = _brand?.PieTexto;
        _brandOpen = true;
    }

    private async Task SaveBrandAsync()
    {
        _brandError = null;
        _brandBusy = true;
        try
        {
            var r = await BrandSvc.SaveAsync(new SaveEmailBrandRequest(_bLogo, _bPrim, _bAcc, _bEstilo, _bSitio, _bPie));
            if (!r.Ok) { _brandError = r.Error; return; }
            _brand = r.Brand;
            _brandOpen = false;
            // Plantilla nueva sin mensajes aun: toma el nuevo estilo por defecto.
            if (_editOpen && _editingId is null && string.IsNullOrWhiteSpace(_fCuerpo)) { _styleKey = _savedStyle = BrandDefaultStyle; }
        }
        catch (Exception ex) { _brandError = ex.Message; }
        finally { _brandBusy = false; }
    }

    // ---------- Galeria ----------

    private async Task OpenGalleryAsync(bool forLogo)
    {
        _galleryForLogo = forLogo;
        _galleryError = null;
        _copied = null;
        _assets = (await Assets.ListAsync()).ToList();
        _galleryOpen = true;
    }

    private void CloseGallery()
    {
        _galleryOpen = false;
        _galleryForLogo = false;
    }

    private async Task OnGalleryFilesAsync(InputFileChangeEventArgs e)
    {
        _galleryError = null;
        _galleryBusy = true;
        StateHasChanged();
        var errors = new List<string>();
        try
        {
            foreach (var f in e.GetMultipleFiles(12))
            {
                if (f.Size > TemplateGalleryService.MaxBytes)
                {
                    errors.Add($"{f.Name}: pesa mas de {TemplateGalleryService.MaxBytes / 1024 / 1024} MB.");
                    continue;
                }
                using var ms = new MemoryStream();
                await f.OpenReadStream(TemplateGalleryService.MaxBytes).CopyToAsync(ms);
                var (asset, error) = await Gallery.UploadAsync(f.Name, ms.ToArray(), null);
                if (asset is null) { errors.Add($"{f.Name}: {error}"); }
            }
            _assets = (await Assets.ListAsync()).ToList();
        }
        catch (Exception ex) { errors.Add(ex.Message); }
        finally
        {
            _galleryBusy = false;
            _galleryError = errors.Count > 0 ? string.Join(" ", errors) : null;
        }
    }

    private async Task SaveAltAsync(TemplateAssetDto a, string? alt)
    {
        await Assets.UpdateAltAsync(a.Id, alt);
        _assets = (await Assets.ListAsync()).ToList();
    }

    private async Task DeleteAssetAsync(TemplateAssetDto a)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Quitar \"{a.FileName}\" de la galeria? Los correos ya enviados que la usan la seguiran mostrando.")) { return; }
        await Assets.DeleteAsync(a.Id);
        _assets = (await Assets.ListAsync()).ToList();
    }

    private void PickLogo(TemplateAssetDto a)
    {
        _bLogo = a.Url;
        CloseGallery();
    }

    private void UseInChat(TemplateAssetDto a)
    {
        _panel?.AppendToInput($"Usa la imagen \"{a.Alt ?? a.FileName}\" de la galeria ({a.FileName}).");
        CloseGallery();
    }

    private async Task CopyUrlAsync(TemplateAssetDto a)
    {
        var abs = Nav.ToAbsoluteUri(a.Url).ToString();
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", abs); _copied = abs; }
        catch { _copied = abs; }
    }

    private static bool IsEmailImage(string? mime) => mime is "image/png" or "image/jpeg" or "image/gif";

    private static string Kb(long bytes) => bytes >= 1024 * 1024 ? (bytes / 1024d / 1024d).ToString("0.0") + " MB" : Math.Max(1, bytes / 1024) + " KB";

    private static string Or(string? v, string fallback) => string.IsNullOrWhiteSpace(v) ? fallback : v;

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) { return "?"; }
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    // ---------- Versiones / borrado / bajas ----------

    private async Task OnVersionPicked(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var snapId)) { return; }
        var v = _versions.FirstOrDefault(x => x.Id == snapId);
        if (v is null) { return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"Restaurar la version \"{v.Label}\" del {v.CreatedAt.ToLocalTime():yyyy-MM-dd HH:mm}? (la version actual queda guardada y se puede volver a ella)"))
        {
            StateHasChanged();
            return;
        }
        _busy = true;
        try
        {
            if (await Snapshots.RestoreAsync(snapId, await ActorAsync()) && _editingId is Guid id)
            {
                try { await AgentChat.NoteExternalChangeAsync(TemplateAgentKind.Email, id, $"El usuario restauro la version \"{v.Label}\"."); } catch { }
                await OnAgentChangedAsync(id);
            }
            else { _modalError = "No se pudo restaurar la version."; }
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(EmailTemplateDto t)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Eliminar la plantilla \"{t.Nombre}\"?")) { return; }
        _error = null;
        _busy = true;
        try
        {
            await Svc.DeleteAsync(t.Id);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task ToggleBajasAsync()
    {
        _bajasOpen = !_bajasOpen;
        if (_bajasOpen) { _bajas = (await Bajas.ListAsync()).ToList(); }
    }

    private async Task RemoveBajaAsync(EmailUnsubscribeDto b)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Quitar la baja de {b.Email}? Volvera a recibir correos del motor de acciones.")) { return; }
        _busy = true;
        try
        {
            await Bajas.RemoveAsync(b.Id);
            _bajas = (await Bajas.ListAsync()).ToList();
        }
        finally { _busy = false; }
    }

    // Documento completo para el iframe: si el cuerpo ya trae <html>, va tal cual; si es un fragmento, se envuelve.
    private string PreviewDoc()
    {
        var body = EmailTemplateService.RenderTemplate(_fCuerpo, EmailTemplateService.SampleFields, htmlEscapeValues: true);
        if (body.Contains("<html", StringComparison.OrdinalIgnoreCase)) { return body; }
        return "<!doctype html><html><head><meta charset=\"utf-8\"></head><body style=\"margin:0;padding:12px;font-family:Arial,Helvetica,sans-serif;\">" + body + "</body></html>";
    }

    private async Task<Guid?> ActorAsync()
    {
        if (AuthState is null) { return null; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
    }
}
