@page "/plantillas-correo"
@attribute [Authorize]
@* Administrador de PLANTILLAS DE CORREO del motor de acciones por filtro (ADR-0056, paso E-mail) con el
   AGENTE EDITOR DE PLANTILLAS (ADR-0175): editor en 3 columnas (campos | vista previa en iframe sandbox |
   chat del agente), verificacion en vivo, versiones con Restaurar y lista de bajas de correo. Solo ASCII. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Gestor
@using Ecorex.Application.Gestor.TemplateAgent
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Components.Shared.Templates
@using Microsoft.AspNetCore.Components.Authorization
@inject IEmailTemplateService Svc
@inject ITemplateSnapshotService Snapshots
@inject IEmailUnsubscribeService Bajas
@inject ITemplateAgentChatService AgentChat
@inject IJSRuntime JS

<PageTitle>Plantillas de correo - ECOREX.tareas</PageTitle>

<nav class="ecorex-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a>
    <span class="sep">/</span>
    <span>Negocio</span>
    <span class="sep">/</span>
    <span class="cur">Plantillas de correo</span>
</nav>

@if (!_editOpen)
{
    <div class="page-header">
        <div>
            <div class="pc-eyebrow">MOTOR DE ACCIONES &#183; E-MAIL</div>
            <h1 class="page-title" style="margin-top:6px;">Plantillas de correo</h1>
            <p class="page-sub" style="margin-bottom:0;">Asunto y cuerpo con variables que se reemplazan con los datos del contacto al enviar. Crea o edita una plantilla a mano o con el <b>agente de plantillas</b> (describe el correo o adjunta una captura para replicarlo). Las activas aparecen en el disenador de acciones (paso E-mail).</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenNew">+ Nueva plantilla</button>
    </div>

    @if (_loading)
    {
        <p class="text-muted">Cargando plantillas...</p>
    }
    else
    {
        <div class="pc-list">
            @if (_items.Count == 0)
            {
                <p class="text-muted">Aun no hay plantillas. Usa "+ Nueva plantilla" para crear la primera (a mano o con el agente).</p>
            }
            @foreach (var t in _items)
            {
                var tt = t;
                <div class="pc-row">
                    <div class="pc-main">
                        <div class="pc-name">
                            @tt.Nombre
                            @if (!tt.Activa)
                            {
                                <span class="pc-badge pc-off">Inactiva</span>
                            }
                            else
                            {
                                <span class="pc-badge pc-on">Activa</span>
                            }
                        </div>
                        <div class="pc-subj">@(string.IsNullOrWhiteSpace(tt.Asunto) ? "(sin asunto)" : tt.Asunto)</div>
                    </div>
                    <div class="pc-actions">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(tt)">Editar</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => DeleteAsync(tt)" disabled="@_busy">Eliminar</button>
                    </div>
                </div>
            }
        </div>

        <div class="pc-bajas">
            <button class="pc-bajas-toggle" @onclick="ToggleBajasAsync">
                @(_bajasOpen ? "v" : ">") Bajas de correo
                @if (_bajas is not null) { <span class="pc-badge pc-off">@_bajas.Count</span> }
            </button>
            @if (_bajasOpen)
            {
                <p class="text-muted small" style="margin:6px 0 8px;">Contactos que abrieron el enlace {enlace_baja} de un correo. El motor de acciones ya no les envia correos. Quitar una baja solo si el contacto pidio volver a recibirlos.</p>
                @if (_bajas is null || _bajas.Count == 0)
                {
                    <p class="text-muted small">Nadie se ha dado de baja.</p>
                }
                else
                {
                    @foreach (var b in _bajas)
                    {
                        var bb = b;
                        <div class="pc-baja-row">
                            <span class="pc-baja-mail">@bb.Email</span>
                            <span class="text-muted small">@bb.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") &#183; @bb.Origen@(string.IsNullOrWhiteSpace(bb.Motivo) ? "" : " - " + bb.Motivo)</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveBajaAsync(bb)" disabled="@_busy">Quitar</button>
                        </div>
                    }
                }
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="text-danger small" style="margin-top:10px">@_error</div>
    }
}
else
{
    @* ===== Editor: campos | vista previa | agente ===== *@
    <div class="pe-top">
        <button class="btn btn-sm btn-outline-secondary" @onclick="CloseEditorAsync">&larr; Plantillas</button>
        <div class="pe-title">@(_editingId is null ? "Nueva plantilla" : _fNombre)</div>
        @if (_dirty) { <span class="pe-dirty">Cambios sin guardar</span> }
        <div class="pe-top-actions">
            @if (_editingId is not null)
            {
                <select class="form-select form-select-sm pe-versions" @onchange="OnVersionPicked" disabled="@_busy">
                    <option value="">Versiones (@_versions.Count)</option>
                    @foreach (var v in _versions)
                    {
                        <option value="@v.Id">@v.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm") &#183; @v.Label</option>
                    }
                </select>
            }
            <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@_busy">Guardar</button>
        </div>
    </div>

    <div class="pe-grid">
        <div class="pe-col pe-fields">
            <div class="field">
                <label class="form-label">Nombre *</label>
                <input class="form-control" value="@_fNombre" @oninput="e => { _fNombre = e.Value?.ToString() ?? string.Empty; _dirty = true; }" maxlength="200" placeholder="Ej. Bienvenida prospectos" />
            </div>
            <div class="field">
                <label class="form-label">Asunto *</label>
                <input class="form-control" value="@_fAsunto" @oninput="e => { _fAsunto = e.Value?.ToString() ?? string.Empty; _dirty = true; }" maxlength="300" placeholder="Hola {nombre}, una propuesta para {empresa}" />
            </div>
            <div class="field pe-html">
                <label class="form-label">Cuerpo (HTML)</label>
                <textarea class="form-control pe-code" value="@_fCuerpo" @oninput="e => { _fCuerpo = e.Value?.ToString() ?? string.Empty; _dirty = true; }" spellcheck="false" placeholder="&lt;table role=&quot;presentation&quot; width=&quot;600&quot;&gt;...&lt;/table&gt;"></textarea>
            </div>
            <label class="pc-check">
                <input type="checkbox" checked="@_fActiva" @onchange="e => { _fActiva = (bool)(e.Value ?? false); _dirty = true; }" />
                <span>Activa (disponible en el disenador de acciones)</span>
            </label>
            <div class="pe-vars">
                <div class="pc-prev-lbl">VARIABLES</div>
                @foreach (var v in EmailTemplateService.Variables)
                {
                    <span class="pe-var" title="@v.Descripcion">{@v.Token}</span>
                }
            </div>
            @if (_modalError is not null)
            {
                <div class="text-danger small">@_modalError</div>
            }
        </div>

        <div class="pe-col pe-preview">
            <div class="pc-prev-lbl">VISTA PREVIA &#183; datos de ejemplo (Juan Perez / ACME S.A.S)</div>
            <div class="pc-prev-subj"><b>Asunto:</b> @EmailTemplateService.RenderTemplate(_fAsunto, EmailTemplateService.SampleFields, htmlEscapeValues: false)</div>
            @* iframe SANDBOX (sin scripts, sin mismo origen): el HTML -de la IA o pegado- no corre en el origen de la app. *@
            <iframe class="pe-frame" sandbox="" title="Vista previa del correo" srcdoc="@PreviewDoc()"></iframe>
            @{ var vr = EmailTemplateVerifier.Verify(_fAsunto, _fCuerpo); }
            <div class="pe-verify @(vr.Errors > 0 ? "bad" : vr.Warnings > 0 ? "warn" : "ok")">
                <div class="pe-verify-h">
                    @if (vr.Errors == 0 && vr.Warnings == 0) { <span>Verificacion: todo en orden.</span> }
                    else { <span>Verificacion: @vr.Errors error(es), @vr.Warnings aviso(s)</span> }
                </div>
                @foreach (var i in vr.Issues)
                {
                    <div class="pe-issue @i.Severity"><b>@(i.Severity == "error" ? "Error" : "Aviso")</b> (@i.Where): @i.Problem <span class="text-muted">@i.Fix</span></div>
                }
            </div>
        </div>

        <div class="pe-col pe-chat">
            <TemplateAgentChatPanel @key="_panelKey" Kind="TemplateAgentKind.Email" TemplateId="_editingId" OnTemplateChanged="OnAgentChangedAsync" />
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<EmailTemplateDto> _items = new();

    private bool _editOpen;
    private Guid? _editingId;
    private Guid _panelKey = Guid.NewGuid();
    private string? _modalError;
    private string _fNombre = "";
    private string _fAsunto = "";
    private string _fCuerpo = "";
    private bool _fActiva = true;
    private bool _dirty;
    private List<TemplateSnapshotDto> _versions = new();

    private bool _bajasOpen;
    private List<EmailUnsubscribeDto>? _bajas;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _bajas = (await Bajas.ListAsync()).ToList();
        _loading = false;
    }

    private async Task ReloadAsync() => _items = (await Svc.ListAsync()).ToList();

    private void OpenNew()
    {
        _modalError = null;
        _editingId = null;
        _fNombre = ""; _fAsunto = ""; _fCuerpo = ""; _fActiva = true;
        _dirty = false;
        _versions = new();
        _panelKey = Guid.NewGuid();
        _editOpen = true;
    }

    private async Task OpenEdit(EmailTemplateDto t)
    {
        _modalError = null;
        _editingId = t.Id;
        _fNombre = t.Nombre; _fAsunto = t.Asunto; _fCuerpo = t.CuerpoHtml; _fActiva = t.Activa;
        _dirty = false;
        _panelKey = Guid.NewGuid();
        _editOpen = true;
        await LoadVersionsAsync();
    }

    private async Task CloseEditorAsync()
    {
        if (_dirty && !await JS.InvokeAsync<bool>("confirm", "Hay cambios sin guardar. Salir de todas formas?")) { return; }
        _editOpen = false;
        await ReloadAsync();
    }

    private async Task LoadVersionsAsync()
        => _versions = _editingId is Guid id ? (await Snapshots.ListAsync(TemplateAgentKind.Email, id)).ToList() : new();

    // El agente aplico un cambio (o creo la plantilla): se recarga el editor con lo guardado.
    private async Task OnAgentChangedAsync(Guid? templateId)
    {
        if (templateId is not Guid id) { return; }
        var t = await Svc.GetAsync(id);
        if (t is null) { return; }
        _editingId = id;
        _fNombre = t.Nombre; _fAsunto = t.Asunto; _fCuerpo = t.CuerpoHtml; _fActiva = t.Activa;
        _dirty = false;
        await LoadVersionsAsync();
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_fNombre)) { _modalError = "El nombre es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_fAsunto)) { _modalError = "El asunto es obligatorio."; return; }
        _busy = true;
        try
        {
            var req = new SaveEmailTemplateRequest(_fNombre, _fAsunto, _fCuerpo, _fActiva);
            EmailTemplateDto? res;
            if (_editingId is Guid id)
            {
                // Version previa tambien en el guardado manual (se puede volver atras igual que con el agente).
                try { await Snapshots.SnapshotAsync(TemplateAgentKind.Email, id, "Antes de: guardado manual", null, await ActorAsync()); }
                catch { /* best-effort */ }
                res = await Svc.UpdateAsync(id, req);
                // Avisa al agente que la plantilla cambio fuera del chat (no reaplicar cambios viejos).
                if (res is not null) { try { await AgentChat.NoteExternalChangeAsync(TemplateAgentKind.Email, id, "El usuario edito y guardo la plantilla a mano."); } catch { } }
            }
            else
            {
                res = await Svc.CreateAsync(req);
                // La plantilla nueva ya existe: el chat se re-monta ligado a ella (si no, el agente crearia otra).
                if (res is not null) { _panelKey = Guid.NewGuid(); }
            }
            if (res is null) { _modalError = "No se pudo guardar la plantilla."; return; }
            _editingId = res.Id;
            _dirty = false;
            await LoadVersionsAsync();
        }
        finally { _busy = false; }
    }

    private async Task OnVersionPicked(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var snapId)) { return; }
        var v = _versions.FirstOrDefault(x => x.Id == snapId);
        if (v is null) { return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"Restaurar la version \"{v.Label}\" del {v.CreatedAt.ToLocalTime():yyyy-MM-dd HH:mm}? (la version actual queda guardada y se puede volver a ella)"))
        {
            StateHasChanged();
            return;
        }
        _busy = true;
        try
        {
            if (await Snapshots.RestoreAsync(snapId, await ActorAsync()) && _editingId is Guid id)
            {
                try { await AgentChat.NoteExternalChangeAsync(TemplateAgentKind.Email, id, $"El usuario restauro la version \"{v.Label}\"."); } catch { }
                await OnAgentChangedAsync(id);
            }
            else { _modalError = "No se pudo restaurar la version."; }
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(EmailTemplateDto t)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Eliminar la plantilla \"{t.Nombre}\"?")) { return; }
        _error = null;
        _busy = true;
        try
        {
            await Svc.DeleteAsync(t.Id);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task ToggleBajasAsync()
    {
        _bajasOpen = !_bajasOpen;
        if (_bajasOpen) { _bajas = (await Bajas.ListAsync()).ToList(); }
    }

    private async Task RemoveBajaAsync(EmailUnsubscribeDto b)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Quitar la baja de {b.Email}? Volvera a recibir correos del motor de acciones.")) { return; }
        _busy = true;
        try
        {
            await Bajas.RemoveAsync(b.Id);
            _bajas = (await Bajas.ListAsync()).ToList();
        }
        finally { _busy = false; }
    }

    // Documento completo para el iframe: si el cuerpo ya trae <html>, va tal cual; si es un fragmento, se envuelve.
    private string PreviewDoc()
    {
        var body = EmailTemplateService.RenderTemplate(_fCuerpo, EmailTemplateService.SampleFields, htmlEscapeValues: true);
        if (body.Contains("<html", StringComparison.OrdinalIgnoreCase)) { return body; }
        return "<!doctype html><html><head><meta charset=\"utf-8\"></head><body style=\"margin:0;padding:12px;font-family:Arial,Helvetica,sans-serif;\">" + body + "</body></html>";
    }

    private async Task<Guid?> ActorAsync()
    {
        if (AuthState is null) { return null; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
    }
}
