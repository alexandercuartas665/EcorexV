@page "/plantillas-reportes"
@attribute [Authorize(Policy = "PlatformOperator")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Reporting.Templates
@inject IReportTemplateService Templates

@* Catalogo maestro de plantillas de reportes (ADR-0062): PLATAFORMA cura los moldes reutilizables
   entre tenants. Crear/editar/publicar/despublicar. Cada mutacion queda AUDITADA (AdminAuditLog).
   La plantilla NO lleva datos: al activarse en un tenant corre con el filtro global (aislamiento). *@

<PageTitle>Plantillas de reportes - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <span>Super Admin SaaS</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Plantillas de reportes</h1>
        <p class="page-sub" style="margin-bottom:0;">Moldes reutilizables entre tenants. Una fuente NATIVA aplica a cualquier tenant; una de CONTENEDOR solo donde exista el contenedor requerido. El dato nunca viaja con la plantilla.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nueva plantilla</button>
</div>

@if (_items is null)
{
    <p><em>Cargando...</em></p>
}
else if (_items.Count == 0)
{
    <p class="text-muted">Aun no hay plantillas. Crea la primera con "Nueva plantilla".</p>
}
else
{
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead>
            <tr>
                <th style="text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">Nombre</th>
                <th style="text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">Tipo</th>
                <th style="text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">Fuente</th>
                <th style="text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">SourceKey</th>
                <th style="text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">Estado</th>
                <th style="text-align:right;padding:8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in _items)
            {
                var item = t;
                <tr>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;">
                        <strong>@item.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Category))
                        {
                            <span style="color:#9ca3af;"> - @item.Category</span>
                        }
                    </td>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;">@item.Kind</td>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;">
                        @if (item.RequiredSourceKind == ReportTemplateSourceKind.Container)
                        {
                            <span>Contenedor: @item.RequiredContainerName</span>
                        }
                        else
                        {
                            <span>Nativa</span>
                        }
                    </td>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;color:#6b7280;">@item.SourceKey</td>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;">
                        @if (item.IsPublished)
                        {
                            <span class="badge bg-success">Publicada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Borrador</span>
                        }
                    </td>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;text-align:right;white-space:nowrap;">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(item.Id)">Editar</button>
                        @if (item.IsPublished)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetPublishedAsync(item.Id, false)">Despublicar</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary" @onclick="() => SetPublishedAsync(item.Id, true)">Publicar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_modalOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-head">
                <h3>@(_editingId is null ? "Nueva plantilla" : "Editar plantilla")</h3>
                <button class="modal-close" @onclick="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="_form.Name" />
                </div>
                <div class="field">
                    <label class="form-label">Descripcion</label>
                    <input class="form-control" @bind="_form.Description" />
                </div>
                <div class="field-row">
                    <div class="field">
                        <label class="form-label">Tipo</label>
                        <select class="form-control" @bind="_form.Kind">
                            <option value="@ReportTemplateKind.Dashboard">Dashboard</option>
                            <option value="@ReportTemplateKind.Printable">Imprimible</option>
                            <option value="@ReportTemplateKind.Panel">Panel</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="form-label">SourceKey</label>
                        <input class="form-control" @bind="_form.SourceKey" placeholder="panel:ocs / native:taskitem" />
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label class="form-label">Fuente requerida</label>
                        <select class="form-control" @bind="_form.RequiredSourceKind">
                            <option value="@ReportTemplateSourceKind.Native">Nativa (cualquier tenant)</option>
                            <option value="@ReportTemplateSourceKind.Container">Contenedor</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="form-label">Nombre del contenedor</label>
                        <input class="form-control" @bind="_form.RequiredContainerName"
                               disabled="@(_form.RequiredSourceKind != ReportTemplateSourceKind.Container)"
                               placeholder="Software OCS" />
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label class="form-label">Categoria</label>
                        <input class="form-control" @bind="_form.Category" />
                    </div>
                    <div class="field">
                        <label class="form-label">Icono</label>
                        <input class="form-control" @bind="_form.Icon" />
                    </div>
                </div>
                <div class="field">
                    <label class="form-label">SpecJson (opcional)</label>
                    <textarea class="form-control" rows="3" @bind="_form.SpecJson"></textarea>
                </div>
                <div class="field">
                    <label class="form-label">RDL (opcional, imprimibles)</label>
                    <textarea class="form-control" rows="3" @bind="_form.Rdl"></textarea>
                </div>
                <div class="field">
                    <label class="form-label">
                        <input type="checkbox" @bind="_form.IsPublished" /> Publicada (visible/activable por los tenants)
                    </label>
                </div>
                @if (_error is not null)
                {
                    <div class="text-danger small">@_error</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="Close">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.SourceKey))">
                    @(_editingId is null ? "Crear plantilla" : "Guardar cambios")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<ReportTemplateSummary>? _items;
    private bool _modalOpen;
    private Guid? _editingId;
    private bool _busy;
    private string? _error;
    private readonly TemplateForm _form = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => _items = (await Templates.ListAllAsync()).ToList();

    private void OpenCreate()
    {
        _editingId = null;
        _error = null;
        _form.Reset();
        _modalOpen = true;
    }

    private async Task OpenEdit(Guid id)
    {
        _error = null;
        var t = await Templates.GetAsync(id);
        if (t is null) { return; }
        _editingId = t.Id;
        _form.Name = t.Name;
        _form.Description = t.Description;
        _form.Kind = t.Kind;
        _form.SourceKey = t.SourceKey;
        _form.SpecJson = t.SpecJson;
        _form.Rdl = t.Rdl;
        _form.RequiredSourceKind = t.RequiredSourceKind;
        _form.RequiredContainerName = t.RequiredContainerName;
        _form.Category = t.Category;
        _form.Icon = t.Icon;
        _form.IsPublished = t.IsPublished;
        _modalOpen = true;
    }

    private void Close() => _modalOpen = false;

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var input = new ReportTemplateInput(
                _form.Name, _form.Description, _form.Kind, _form.SourceKey, _form.SpecJson, _form.Rdl,
                _form.RequiredSourceKind, _form.RequiredContainerName, _form.Category, _form.Icon);

            if (_editingId is Guid id)
            {
                await Templates.UpdateAsync(id, input, actor);
                // El flag "Publicada" del formulario tambien se aplica (auditado por separado si cambia).
                await Templates.SetPublishedAsync(id, _form.IsPublished, actor);
            }
            else
            {
                var newId = await Templates.CreateAsync(input, actor);
                if (_form.IsPublished)
                {
                    await Templates.SetPublishedAsync(newId, true, actor);
                }
            }

            _modalOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetPublishedAsync(Guid id, bool published)
    {
        var actor = await ActorAsync();
        await Templates.SetPublishedAsync(id, published, actor);
        await ReloadAsync();
    }

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var state = await AuthState;
        return Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private sealed class TemplateForm
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public ReportTemplateKind Kind { get; set; } = ReportTemplateKind.Panel;
        public string SourceKey { get; set; } = string.Empty;
        public string? SpecJson { get; set; }
        public string? Rdl { get; set; }
        public ReportTemplateSourceKind RequiredSourceKind { get; set; } = ReportTemplateSourceKind.Native;
        public string? RequiredContainerName { get; set; }
        public string? Category { get; set; }
        public string? Icon { get; set; }
        public bool IsPublished { get; set; }

        public void Reset()
        {
            Name = string.Empty;
            Description = null;
            Kind = ReportTemplateKind.Panel;
            SourceKey = string.Empty;
            SpecJson = null;
            Rdl = null;
            RequiredSourceKind = ReportTemplateSourceKind.Native;
            RequiredContainerName = null;
            Category = null;
            Icon = null;
            IsPublished = false;
        }
    }
}
