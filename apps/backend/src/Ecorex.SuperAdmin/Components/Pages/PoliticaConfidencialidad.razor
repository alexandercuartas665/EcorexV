@page "/pc/{Token}"
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Confidentiality
@using Ecorex.SuperAdmin.Auth
@inject IConfidentialityPolicyService PolicySvc

@* Visor publico de la politica de confidencialidad por token (ADR-0160). SIN policy: el acceso lo
   gobierna el token opaco. La resolucion del token es el UNICO punto cross-tenant
   (ConfidentialityPolicyService.ResolveByTokenAsync); resuelto, la aceptacion corre con el tenant
   del token fijado como ambient (AmbientTenantContext.Begin). Token invalido/inexistente/deshabilitado
   muestran SIEMPRE el mismo mensaje neutro. El contenido se re-sanea antes de pintarse. *@

<PageTitle>Politica de confidencialidad</PageTitle>

<div class="pc-shell">
    <div class="pc-card">
        @if (_loading)
        {
            <p><em>Validando enlace...</em></p>
        }
        else if (_policy is null)
        {
            <div class="pc-neutral">
                <h2>Enlace no disponible</h2>
                <p>Este enlace no esta disponible. Verifica con quien te lo compartio.</p>
            </div>
        }
        else if (_accepted)
        {
            <div class="pc-thanks">
                <h2>Gracias, tu aceptacion quedo registrada.</h2>
                <p>Ya puedes cerrar esta ventana.</p>
            </div>
        }
        else
        {
            <h1 class="pc-title">@_policy.Titulo</h1>
            <article class="pc-content">@((MarkupString)ConfidentialityHtmlSanitizer.Sanitize(_policy.Contenido))</article>

            <div class="pc-form">
                <h3>Aceptacion</h3>
                <p class="pc-form-sub">Declara tu nombre e identificacion y acepta la politica anterior.</p>
                <label class="pc-field">
                    <span>Nombre completo <em>*</em></span>
                    <input class="form-control" @bind="_nombre" maxlength="200" />
                </label>
                <label class="pc-field">
                    <span>Identificacion <em>*</em></span>
                    <input class="form-control" @bind="_identificacion" maxlength="80" />
                </label>
                <label class="pc-field">
                    <span>Correo (opcional)</span>
                    <input class="form-control" type="email" @bind="_correo" maxlength="200" />
                </label>
                @if (_error is not null)
                {
                    <p class="pc-error">@_error</p>
                }
                <button class="btn btn-primary" @onclick="AcceptAsync" disabled="@_busy">
                    @(_busy ? "Registrando..." : "Acepto la politica")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _busy;
    private bool _accepted;
    private string? _error;

    private ConfidentialityPolicyPublicDto? _policy;

    private string _nombre = string.Empty;
    private string _identificacion = string.Empty;
    private string _correo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _policy = await PolicySvc.ResolveByTokenAsync(Token);
        _loading = false;
    }

    private async Task AcceptAsync()
    {
        if (_policy is null) { return; }
        _error = null;

        if (string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_identificacion))
        {
            _error = "El nombre y la identificacion son obligatorios.";
            return;
        }

        _busy = true;
        try
        {
            // El token fija el tenant como ambient: la constancia se inserta en ese tenant.
            ConfidentialityAcceptStatus status;
            using (AmbientTenantContext.Begin(_policy.TenantId))
            {
                status = await PolicySvc.AcceptAsync(
                    Token,
                    new ConfidentialityAcceptRequest(_nombre, _identificacion, _correo, null, null));
            }

            switch (status)
            {
                case ConfidentialityAcceptStatus.Ok:
                    _accepted = true;
                    break;
                case ConfidentialityAcceptStatus.MissingData:
                    _error = "El nombre y la identificacion son obligatorios.";
                    break;
                default:
                    _error = "Este enlace ya no esta disponible.";
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
