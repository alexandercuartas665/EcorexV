@page "/reportes/imprimibles/editor/{Id:guid}"
@layout EmptyLayout
@attribute [Authorize(Policy = "Perm:reportes/imprimibles:Edit")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JS

@* Diseniador drag-drop de Bold Reports (Ola 2, ADR-0051). El RDL se carga client-side con
   openReportDefinition (traido del endpoint GET /api/reporting/rdl/{id}) porque openReport(path) asume
   Report Server. El controller /api/BoldReportsDesigner sigue montado para recursos/preview (GetData/
   SetData = almacen temporal de sesion). "Guardar" serializa el RDL editado y lo POSTea al endpoint,
   que persiste en ReportDefinition.Rdl. Sin clave corre en modo evaluacion (marca de agua).
   Usa EmptyLayout (sin menu ni breadcrumb): el diseniador Bold necesita TODO el ancho; embebido en el
   chrome de la app se espachurraba y cortaba columnas. *@

<PageTitle>Editor de reporte - ECOREX.tareas</PageTitle>

<div style="display:flex;flex-direction:column;height:100vh;overflow:hidden;">
    <div style="display:flex;gap:12px;align-items:center;padding:8px 14px;border-bottom:1px solid #e5e7eb;background:#fff;flex-wrap:wrap;flex:0 0 auto;">
        <a href="/reportes/imprimibles" style="font-size:13px;color:#4338ca;text-decoration:none;font-weight:600;">&larr; Reportes</a>
        <a href="@($"/reportes/imprimibles/{Id}")" style="font-size:13px;color:#4338ca;text-decoration:none;">Ver &rarr;</a>
        <button @onclick="SaveAsync" disabled="@_saving"
                style="background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:6px 16px;font-size:13px;font-weight:600;cursor:pointer;">
            @(_saving ? "Guardando..." : "Guardar")
        </button>
        @if (_status is not null)
        {
            <span style="font-size:13px;color:@(_ok ? "#059669" : "#b91c1c");">@_status</span>
        }
        <span style="font-size:12px;color:#9ca3af;">Arrastra campos y columnas; luego pulsa "Guardar".</span>
    </div>
    @if (!_ready)
    {
        <div style="padding:24px;color:#6b7280;font-size:14px;flex:0 0 auto;">Cargando el diseniador (Bold)&hellip;</div>
    }
    <div id="@_designerId" style="width:100%;flex:1 1 auto;min-height:0;"></div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly string _designerId = "bold-designer-" + Guid.NewGuid().ToString("N");
    private bool _saving;
    private bool _ok;
    private bool _ready;
    private string? _status;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // serviceUrl = controller del diseniador (recursos); rdlUrl = endpoint que sirve el RDL.
            await JS.InvokeVoidAsync("ecorexBold.renderDesigner", _designerId, "/api/BoldReportsDesigner", $"/api/reporting/rdl/{Id}");
            _ready = true;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _status = null;
        try
        {
            var result = await JS.InvokeAsync<SaveResult>("ecorexBold.saveDesigner", $"/api/reporting/rdl/{Id}");
            _ok = result.Ok;
            _status = result.Ok ? "Guardado." : ("No se pudo guardar: " + (result.Error ?? "error"));
        }
        catch (Exception ex)
        {
            _ok = false;
            _status = "Error: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class SaveResult
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
    }
}
