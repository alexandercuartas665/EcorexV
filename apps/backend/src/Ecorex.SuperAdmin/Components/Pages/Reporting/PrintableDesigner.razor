@page "/reportes/imprimibles/editor/{Id:guid}"
@attribute [Authorize(Policy = "TenantMember")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JS

@* Diseniador drag-drop de Bold Reports (Ola 2, ADR-0051): abre el RDL de una ReportDefinition, permite
   editarlo visualmente (arrastrar campos/columnas/tablas) y guardarlo de vuelta (controller
   /api/BoldReportsDesigner -> IReportDefinitionService.UpdateRdlAsync). Sin clave corre en modo
   evaluacion (marca de agua). *@

<PageTitle>Editor de reporte - ECOREX.tareas</PageTitle>

<div style="padding:8px 12px;">
    <div style="display:flex;gap:12px;align-items:center;margin-bottom:6px;">
        <a href="/reportes/imprimibles" style="font-size:13px;color:#4338ca;text-decoration:none;">&larr; Imprimibles</a>
        <a href="@($"/reportes/imprimibles/{Id}")" style="font-size:13px;color:#4338ca;text-decoration:none;">Ver &rarr;</a>
        <span style="font-size:12px;color:#9ca3af;">Arrastra campos y columnas; usa "Guardar" en la barra del editor.</span>
    </div>
    <div id="@_designerId" style="width:100%;height:82vh;"></div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly string _designerId = "bold-designer-" + Guid.NewGuid().ToString("N");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // serviceUrl = controller del diseniador; reportPath = Id de la ReportDefinition (se abre solo).
            await JS.InvokeVoidAsync("ecorexBold.renderDesigner", _designerId, "/api/BoldReportsDesigner", Id.ToString());
        }
    }
}
