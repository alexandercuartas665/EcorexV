@page "/reportes/imprimibles/{Id:guid}"
@attribute [Authorize(Policy = "Perm:reportes/imprimibles:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JS

@* Visor Bold Reports (Ola 2, ADR-0051): renderiza el RDL de una ReportDefinition (Kind=Printable) y
   exporta PDF/Excel. Los datos los sirve el controller /api/BoldReportsApi ya filtrados por tenant
   (OnInitReportOptions), nunca una cadena de conexion. Sin clave de licencia corre en modo evaluacion
   (marca de agua); al poner Bold:LicenseKey desaparece, sin tocar codigo. *@

<PageTitle>Visor de reporte - ECOREX.tareas</PageTitle>

<div style="padding:12px 16px;">
    <a href="/reportes/imprimibles" style="font-size:13px;color:#4338ca;text-decoration:none;">&larr; Imprimibles</a>
    <div id="@_viewerId" style="width:100%;height:80vh;"></div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly string _viewerId = "bold-viewer-" + Guid.NewGuid().ToString("N");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // reportPath = Id de la ReportDefinition; serviceUrl = ruta del controller Web API de Bold.
            await JS.InvokeVoidAsync("ecorexBold.renderViewer", _viewerId, Id.ToString(), "/api/BoldReportsApi");
        }
    }
}
