@page "/reportes/imprimibles/{Id:guid}"
@layout EmptyLayout
@attribute [Authorize(Policy = "Perm:reportes/galeria:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JS

@* Visor Bold Reports (Ola 2, ADR-0051): renderiza el RDL de una ReportDefinition y exporta PDF/Excel.
   Los datos los sirve el controller /api/BoldReportsApi ya filtrados por tenant (nunca una cadena de
   conexion). Sin clave de licencia corre en modo evaluacion (marca de agua). Usa EmptyLayout (sin menu
   ni breadcrumb) porque se EMBEBE en el modal de la galeria (vista Imprimible). *@

<PageTitle>Visor de reporte - ECOREX.tareas</PageTitle>

<div id="@_viewerId" style="width:100%;height:100vh;"></div>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly string _viewerId = "bold-viewer-" + Guid.NewGuid().ToString("N");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // reportPath = Id de la ReportDefinition; serviceUrl = ruta del controller Web API de Bold.
            await JS.InvokeVoidAsync("ecorexBold.renderViewer", _viewerId, Id.ToString(), "/api/BoldReportsApi");
        }
    }
}
