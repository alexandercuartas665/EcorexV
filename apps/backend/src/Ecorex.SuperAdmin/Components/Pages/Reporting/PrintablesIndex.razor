@page "/reportes/imprimibles"
@attribute [Authorize(Policy = "TenantMember")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Reporting
@using Ecorex.Domain.Enums
@inject IReportDefinitionService Defs
@inject NavigationManager Nav

@* Indice de reportes imprimibles (RDL) del tenant. Se crean desde /reportes/ia ("Guardar como
   imprimible") y se abren en el visor Bold. Ola 2, ADR-0051. *@

<PageTitle>Imprimibles - ECOREX.tareas</PageTitle>

<div style="padding:24px 28px;max-width:900px;">
    <h1 style="font-size:22px;font-weight:700;margin:0;color:#111827;">Reportes imprimibles</h1>
    <p style="font-size:13px;color:#6b7280;margin:4px 0 16px;">
        Documentos RDL que se ven y exportan (PDF/Excel) con el visor Bold. Crea uno desde
        <a href="/reportes/ia" style="color:#4338ca;">Reportes con IA</a> (boton "Guardar como imprimible").
    </p>

    @if (_items.Count == 0)
    {
        <p style="text-align:center;color:#9ca3af;padding:24px 0;">Aun no hay imprimibles. Crea uno desde Reportes con IA.</p>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr>
                    <th style="text-align:left;color:#6b7280;padding:8px 6px;border-bottom:1px solid #e5e7eb;">Nombre</th>
                    <th style="text-align:left;color:#6b7280;padding:8px 6px;border-bottom:1px solid #e5e7eb;">Fuente</th>
                    <th style="border-bottom:1px solid #e5e7eb;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _items)
                {
                    <tr>
                        <td style="padding:8px 6px;border-bottom:1px solid #f3f4f6;">@s.Name</td>
                        <td style="padding:8px 6px;border-bottom:1px solid #f3f4f6;font-family:monospace;color:#6b7280;">@s.SourceKey</td>
                        <td style="padding:8px 6px;border-bottom:1px solid #f3f4f6;text-align:right;white-space:nowrap;">
                            <button @onclick="() => Edit(s.Id)" style="background:#eef2ff;color:#4338ca;border:none;border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer;margin-right:6px;">Editar</button>
                            <button @onclick="() => Open(s.Id)" style="background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer;">Ver</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<ReportDefinitionSummary> _items = Array.Empty<ReportDefinitionSummary>();

    protected override async Task OnInitializedAsync()
    {
        var all = await Defs.ListAsync();
        _items = all.Where(x => x.Kind == ReportDefinitionKind.Printable).ToList();
    }

    private void Open(Guid id) => Nav.NavigateTo($"/reportes/imprimibles/{id}");

    private void Edit(Guid id) => Nav.NavigateTo($"/reportes/imprimibles/editor/{id}");
}
