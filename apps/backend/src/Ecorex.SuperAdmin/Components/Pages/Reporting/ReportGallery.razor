@page "/reportes/galeria"
@attribute [Authorize(Policy = "Perm:reportes/galeria:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Reporting
@using Ecorex.Application.Reporting.Templates
@using Ecorex.Application.Roles
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Auth
@using Ecorex.SuperAdmin.Components.Shared.Reporting
@inject IReportDefinitionService Defs
@inject IReportActivationService Activation
@inject ICurrentPermissions Perms

@* Galeria de reportes (ADR-0051): TODOS los reportes que el usuario puede usar como tarjetas
   (gobernados por rol). Clic en una tarjeta -> modal gigante con DOBLE VISTA: Tablero (ECharts
   interactivo, via RunAsync) e Imprimible (visor Bold del RDL, generado desde el spec si falta). *@

<PageTitle>Galeria de reportes - ECOREX.tareas</PageTitle>

<div style="padding:24px 28px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
        <div>
            <h1 style="font-size:22px;font-weight:700;margin:0;color:#111827;">Galeria de reportes</h1>
            <p style="font-size:13px;color:#6b7280;margin:4px 0 0;">
                Todos los reportes que puedes usar. Haz clic en una tarjeta para abrirlo; el visor tiene
                doble vista: <strong>Tablero</strong> (interactivo) e <strong>Imprimible</strong> (PDF).
            </p>
        </div>
        @if (_canCreate)
        {
            <button style="background:#eef2ff;color:#4338ca;border:none;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;cursor:pointer;"
                    @onclick="CreateExamplesAsync" disabled="@_busy">@(_busy ? "Generando..." : "Generar reportes de ejemplo")</button>
        }
    </div>

    @if (_cards.Count == 0)
    {
        <div style="text-align:center;color:#9ca3af;padding:48px 0;">
            <p style="font-size:14px;">Aun no hay reportes visibles para ti.</p>
            @if (_canCreate)
            {
                <button style="background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:9px 18px;font-size:13px;font-weight:600;cursor:pointer;margin-top:8px;"
                        @onclick="CreateExamplesAsync" disabled="@_busy">Generar reportes de ejemplo</button>
            }
        </div>
    }
    else
    {
        <div class="rg-grid">
            @foreach (var c in _cards)
            {
                var card = c;
                var printable = card.Kind == ReportDefinitionKind.Printable;
                <button class="rg-card" @onclick="() => OpenAsync(card)">
                    <span class="rg-accent @(printable ? "print" : "dash")"></span>
                    <div class="rg-card-top">
                        <span class="rg-icon @(printable ? "print" : "dash")">
                            @if (printable)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                            }
                        </span>
                        <span class="rg-badge @(printable ? "print" : "dash")">@(printable ? "Imprimible" : "Tablero")</span>
                    </div>
                    <div class="rg-name">@card.Name</div>
                    <div class="rg-src">@card.SourceKey</div>
                    <div class="rg-foot">
                        <span>@(card.UpdatedAt?.LocalDateTime.ToString("yyyy-MM-dd") ?? "")</span>
                        <span class="rg-open">Abrir &rarr;</span>
                    </div>
                </button>
            }
        </div>
    }
</div>

@* ===================== MODAL GIGANTE: doble vista ===================== *@
@if (_open is not null)
{
    <div class="modal-overlay" @ref="_overlayRef" tabindex="-1" @onkeydown="OnKeyDown" @onclick="Close">
        <div class="modal-dialog" style="width:98vw;max-width:98vw;height:96vh;max-height:96vh;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@_open.Name</h3>
                <div style="display:flex;gap:6px;align-items:center;">
                    @if (_tableroAvail)
                    {
                        <button style="@ToggleStyle(_view == "tablero")" @onclick="ShowTablero">Tablero</button>
                    }
                    @if (_imprimibleAvail)
                    {
                        <button style="@ToggleStyle(_view == "imprimible")" @onclick="ShowImprimibleAsync">Imprimible</button>
                    }
                    <button class="modal-close" @onclick="Close">&times;</button>
                </div>
            </div>
            <div class="modal-body" style="height:calc(96vh - 64px);overflow:auto;">
                @if (_error is not null)
                {
                    <div class="tk-field-error">@_error</div>
                }

                @if (_view == "tablero")
                {
                    @if (_isPanel)
                    {
                        @* Reporte tipo PANEL: dashboard completo (KPIs + varios graficos + tabla). El
                           componente concreto se resuelve por SourceKey (panel:ocs, panel:system-activities...). *@
                        <DynamicComponent Type="ResolvePanelType(_open.SourceKey)" />
                    }
                    else if (_run is not null)
                    {
                        @if (_run.Option is not null)
                        {
                            <EChart Option="_run.Option" Height="58vh" />
                        }
                        <table style="width:100%;border-collapse:collapse;font-size:12px;margin-top:14px;">
                            <thead>
                                <tr>
                                    @foreach (var col in _run.DataSet.Columns)
                                    {
                                        <th style="text-align:left;padding:6px 8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">@col.DisplayName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _run.DataSet.Rows.Take(50))
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td style="padding:6px 8px;border-bottom:1px solid #f3f4f6;">@(cell?.ToString())</td>
                                        }
                                    </tr>
                                }
                                @if (_run.DataSet.RowCount == 0)
                                {
                                    <tr><td style="padding:14px;color:#9ca3af;">Sin datos en el rango.</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="color:#9ca3af;padding:24px;">Cargando el tablero...</p>
                    }
                }
                else if (_view == "imprimible")
                {
                    @if (_rdlReady)
                    {
                        <iframe src="/reportes/imprimibles/@_open.Id" style="width:100%;height:82vh;border:none;background:#fff;"></iframe>
                    }
                    else
                    {
                        <p style="color:#9ca3af;padding:24px;">Preparando la version imprimible...</p>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ReportDefinitionSummary> _cards = Array.Empty<ReportDefinitionSummary>();
    private bool _canCreate;
    private bool _busy;

    private ReportDefinitionSummary? _open;
    private string _view = "tablero";
    private bool _tableroAvail;
    private bool _imprimibleAvail;
    private bool _rdlReady;
    private bool _isPanel;   // reporte tipo panel (dashboard multi-grafico): SourceKey "panel:..."
    private ReportRunResult? _run;
    private string? _error;
    private ElementReference _overlayRef;
    private bool _focusModal;   // enfocar el overlay al abrir, para que Escape lo cierre

    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        _canCreate = eff.Unrestricted
            || eff.Can("reportes/ia", PermissionAction.Create)
            || eff.Can("reportes/admin", PermissionAction.View);

        // Auto-activacion por condicion (ADR-0062): al entrar a la galeria, activa en este tenant las
        // plantillas publicadas de fuente CONTENEDOR cuyo contenedor requerido ya existe (p.ej. el Panel
        // OCS aparece solo, y solo, donde hay contenedor OCS). Idempotente; nunca cruza tenants.
        try { await Activation.ActivateCompatibleAsync(includeNative: false); }
        catch { /* la galeria no debe romperse si la auto-activacion falla */ }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var eff = await Perms.GetAsync();
        var seeAll = eff.Unrestricted || eff.Can("reportes/admin", PermissionAction.View);
        _cards = await Defs.ListAsync(seeAll, eff.RolId);
    }

    private async Task CreateExamplesAsync()
    {
        _busy = true;
        try
        {
            await Defs.CreateExampleReportsAsync();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModal)
        {
            _focusModal = false;
            try { await _overlayRef.FocusAsync(); } catch { /* el overlay puede no estar aun */ }
        }
    }

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { Close(); }
    }

    private async Task OpenAsync(ReportDefinitionSummary card)
    {
        _open = card;
        _focusModal = true;
        _error = null;
        _run = null;
        _rdlReady = false;

        // Reporte tipo PANEL (dashboard multi-grafico): se renderiza el componente completo, no un
        // solo grafico; no aplica la vista imprimible.
        _isPanel = card.SourceKey is not null && card.SourceKey.StartsWith("panel:", StringComparison.OrdinalIgnoreCase);
        if (_isPanel)
        {
            _tableroAvail = true;
            _imprimibleAvail = false;
            _view = "tablero";
            return;
        }

        // Tablero disponible si el reporte tiene spec (RunAsync no-null). Imprimible disponible si ya
        // tiene RDL (Kind=Printable) o si se puede generar desde el spec (o sea, si el tablero corre).
        _run = await SafeRunAsync(card.Id);
        _tableroAvail = _run is not null;
        _imprimibleAvail = card.Kind == ReportDefinitionKind.Printable || _tableroAvail;
        _view = _tableroAvail ? "tablero" : "imprimible";
        if (_view == "imprimible")
        {
            await ShowImprimibleAsync();
        }
    }

    private async Task<ReportRunResult?> SafeRunAsync(Guid id)
    {
        try { return await Defs.RunAsync(id); }
        catch (Exception ex) { _error = ex.Message; return null; }
    }

    private async Task ShowTablero()
    {
        _view = "tablero";
        if (!_isPanel && _run is null && _open is not null)
        {
            _run = await SafeRunAsync(_open.Id);
        }
    }

    private async Task ShowImprimibleAsync()
    {
        _view = "imprimible";
        _rdlReady = false;
        if (_open is null) { return; }
        try { _rdlReady = await Defs.EnsurePrintableRdlAsync(_open.Id); }
        catch (Exception ex) { _error = ex.Message; _rdlReady = false; }
    }

    private void Close()
    {
        _open = null;
        _run = null;
    }

    // Resolver SourceKey -> componente de panel. Agregar un panel nuevo es una entrada aqui, no tocar
    // el markup. Un SourceKey de panel desconocido cae al dashboard de actividades por defecto.
    private static readonly Dictionary<string, Type> PanelComponents = new(StringComparer.OrdinalIgnoreCase)
    {
        ["panel:system-activities"] = typeof(ActivitiesDashboardPanel),
        ["panel:ocs"] = typeof(OcsDashboardPanel),
    };

    private static Type ResolvePanelType(string? sourceKey) =>
        sourceKey is not null && PanelComponents.TryGetValue(sourceKey, out var t) ? t : typeof(ActivitiesDashboardPanel);

    private static string ToggleStyle(bool on) =>
        $"border:1px solid {(on ? "#4f46e5" : "#e5e7eb")};background:{(on ? "#4f46e5" : "#fff")};color:{(on ? "#fff" : "#374151")};border-radius:8px;padding:5px 14px;font-size:12.5px;font-weight:600;cursor:pointer;";
}
