@page "/reportes/galeria"
@attribute [Authorize(Policy = "Perm:reportes/galeria:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Reporting
@using Ecorex.Application.Reporting.External
@using Ecorex.Application.Reporting.Panels
@using Ecorex.Application.Reporting.Templates
@using Ecorex.Application.Roles
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Auth
@using Ecorex.SuperAdmin.Components.Shared.Reporting
@using Microsoft.AspNetCore.Components.Forms
@inject IReportDefinitionService Defs
@inject IReportActivationService Activation
@inject ICurrentPermissions Perms
@inject IExternalReportBindingService ExternalReports
@inject NavigationManager Nav

@* Galeria de reportes (ADR-0051): TODOS los reportes que el usuario puede usar como tarjetas
   (gobernados por rol). Clic en una tarjeta -> modal gigante con DOBLE VISTA: Tablero (ECharts
   interactivo, via RunAsync) e Imprimible (visor Bold del RDL, generado desde el spec si falta). *@

<PageTitle>Galeria de reportes - ECOREX.tareas</PageTitle>

<div style="padding:24px 28px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
        <div>
            <h1 style="font-size:22px;font-weight:700;margin:0;color:#111827;">Galeria de reportes</h1>
            <p style="font-size:13px;color:#6b7280;margin:4px 0 0;">
                Todos los reportes que puedes usar. Haz clic en una tarjeta para abrirlo; el visor tiene
                doble vista: <strong>Tablero</strong> (interactivo) e <strong>Imprimible</strong> (PDF).
            </p>
        </div>
        @if (_canCreate)
        {
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button style="background:#eef2ff;color:#4338ca;border:none;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;cursor:pointer;"
                        @onclick="OpenNewPanel" disabled="@_busy" title="Crear un panel GENERICO pegando un PanelSpec (ADR-0066): sin codigo ni deploy">Nuevo panel</button>
                <button style="background:#f0fdf4;color:#166534;border:none;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;cursor:pointer;"
                        @onclick="OpenImportAsync" disabled="@_busy" title="Importar un RDL alimentado por una fuente de datos externa concedida">Importar RDL externo</button>
                <button style="background:#eef2ff;color:#4338ca;border:none;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;cursor:pointer;"
                        @onclick="CreateExamplesAsync" disabled="@_busy">@(_busy ? "Generando..." : "Generar reportes de ejemplo")</button>
            </div>
        }
    </div>

    @if (_cards.Count == 0)
    {
        <div style="text-align:center;color:#9ca3af;padding:48px 0;">
            <p style="font-size:14px;">Aun no hay reportes visibles para ti.</p>
            @if (_canCreate)
            {
                <button style="background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:9px 18px;font-size:13px;font-weight:600;cursor:pointer;margin-top:8px;"
                        @onclick="CreateExamplesAsync" disabled="@_busy">Generar reportes de ejemplo</button>
            }
        </div>
    }
    else
    {
        <div class="rg-grid">
            @foreach (var c in _cards)
            {
                var card = c;
                var printable = card.Kind == ReportDefinitionKind.Printable;
                <button class="rg-card" @onclick="() => OpenAsync(card)">
                    <span class="rg-accent @(printable ? "print" : "dash")"></span>
                    <div class="rg-card-top">
                        <span class="rg-icon @(printable ? "print" : "dash")">
                            @if (printable)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                            }
                        </span>
                        <span class="rg-badge @(printable ? "print" : "dash")">@(printable ? "Imprimible" : "Tablero")</span>
                    </div>
                    <div class="rg-name">@card.Name</div>
                    <div class="rg-src">@card.SourceKey</div>
                    <div class="rg-foot">
                        <span>@(card.UpdatedAt?.LocalDateTime.ToString("yyyy-MM-dd") ?? "")</span>
                        <span class="rg-open">Abrir &rarr;</span>
                    </div>
                </button>
            }
        </div>
    }
</div>

@* ===================== MODAL GIGANTE: doble vista ===================== *@
@if (_open is not null)
{
    <div class="modal-overlay" @ref="_overlayRef" tabindex="-1" @onkeydown="OnKeyDown" @onclick="Close">
        <div class="modal-dialog" style="width:98vw;max-width:98vw;height:96vh;max-height:96vh;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@_open.Name</h3>
                <div style="display:flex;gap:6px;align-items:center;">
                    @if (_tableroAvail)
                    {
                        <button style="@ToggleStyle(_view == "tablero")" @onclick="ShowTablero">Tablero</button>
                    }
                    @if (_imprimibleAvail)
                    {
                        <button style="@ToggleStyle(_view == "imprimible")" @onclick="ShowImprimibleAsync">Imprimible</button>
                    }
                    @if (_isSpecPanel && _canCreate)
                    {
                        <button style="border:1px solid #e5e7eb;background:#fff;color:#374151;border-radius:8px;padding:5px 12px;font-size:12.5px;font-weight:600;cursor:pointer;" @onclick="EditOpenPanel">Editar</button>
                        <button style="border:1px solid #e5e7eb;background:#fff;color:#374151;border-radius:8px;padding:5px 12px;font-size:12.5px;font-weight:600;cursor:pointer;" @onclick="DuplicateOpenPanel">Duplicar</button>
                        <button style="border:1px solid #fecaca;background:#fff;color:#b91c1c;border-radius:8px;padding:5px 12px;font-size:12.5px;font-weight:600;cursor:pointer;" @onclick="ArchiveOpenPanel">Archivar</button>
                    }
                    <button class="modal-close" @onclick="Close">&times;</button>
                </div>
            </div>
            <div class="modal-body" style="height:calc(96vh - 64px);overflow:auto;">
                @if (_error is not null)
                {
                    <div class="tk-field-error">@_error</div>
                }

                @if (_view == "tablero")
                {
                    @if (_isPanel)
                    {
                        @if (_isSpecPanel)
                        {
                            @* Panel GENERICO por spec (ADR-0066): UN solo renderizador interpreta el PanelSpec. *@
                            <SpecPanelRenderer ReportId="_open.Id" />
                        }
                        else
                        {
                            @* Reporte tipo PANEL a medida: el componente concreto se resuelve por SourceKey
                               (panel:ocs, panel:system-activities...) como FALLBACK vivo. *@
                            <DynamicComponent Type="ResolvePanelType(_open.SourceKey)" />
                        }
                    }
                    else if (_run is not null)
                    {
                        @if (_run.Option is not null)
                        {
                            <EChart Option="_run.Option" Height="58vh" />
                        }
                        <table style="width:100%;border-collapse:collapse;font-size:12px;margin-top:14px;">
                            <thead>
                                <tr>
                                    @foreach (var col in _run.DataSet.Columns)
                                    {
                                        <th style="text-align:left;padding:6px 8px;border-bottom:1px solid #e5e7eb;color:#6b7280;">@col.DisplayName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _run.DataSet.Rows.Take(50))
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td style="padding:6px 8px;border-bottom:1px solid #f3f4f6;">@(cell?.ToString())</td>
                                        }
                                    </tr>
                                }
                                @if (_run.DataSet.RowCount == 0)
                                {
                                    <tr><td style="padding:14px;color:#9ca3af;">Sin datos en el rango.</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="color:#9ca3af;padding:24px;">Cargando el tablero...</p>
                    }
                }
                else if (_view == "imprimible")
                {
                    @if (_rdlReady)
                    {
                        <iframe src="/reportes/imprimibles/@_open.Id" style="width:100%;height:82vh;border:none;background:#fff;"></iframe>
                    }
                    else
                    {
                        <p style="color:#9ca3af;padding:24px;">Preparando la version imprimible...</p>
                    }
                }
            </div>
        </div>
    </div>
}

@* ===================== MODAL: Importar RDL externo (ADR-0064) ===================== *@
@if (_importOpen)
{
    <div class="modal-overlay" @onclick="CloseImport">
        <div class="modal-dialog" style="max-width:760px;width:96vw;max-height:92vh;display:flex;flex-direction:column;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Importar RDL externo</h3>
                <button class="modal-close" @onclick="CloseImport">&times;</button>
            </div>
            <div class="modal-body" style="flex:1;overflow:auto;padding:18px 22px;">
                @if (_impError is not null)
                {
                    <div class="tk-field-error" style="margin-bottom:12px;">@_impError</div>
                }
                @if (_impGranted.Count == 0)
                {
                    <p style="font-size:13px;color:#6b7280;">
                        No hay fuentes de datos externas concedidas a este tenant. Pide al administrador de plataforma
                        que conceda una fuente (Fuentes externas &rarr; Conceder) antes de importar un RDL que la use.
                    </p>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
                        <label style="font-size:12px;font-weight:600;color:#374151;">Nombre del reporte
                            <input class="form-control" @bind="_impName" maxlength="200" placeholder="Reporte de Sistema de Tareas Personal" />
                        </label>
                        <label style="font-size:12px;font-weight:600;color:#374151;">Descripcion (opcional)
                            <input class="form-control" @bind="_impDesc" maxlength="400" />
                        </label>
                    </div>
                    <label style="font-size:12px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Archivo .rdl</label>
                    <InputFile OnChange="OnRdlSelected" accept=".rdl,.xml" />

                    @if (_impDsNames.Count > 0)
                    {
                        <div style="margin-top:16px;font-size:12px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.03em;">
                            Mapea cada dataset del RDL a un dataset externo concedido
                        </div>
                        @foreach (var name in _impDsNames)
                        {
                            var rdlName = name;
                            var picked = PickedDs(rdlName);
                            <div style="border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;margin-top:10px;">
                                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                    <span style="font-weight:700;font-size:13px;color:#111827;min-width:120px;">@rdlName</span>
                                    <span style="color:#9ca3af;">&rarr;</span>
                                    <select class="form-control" style="max-width:320px;" @onchange="e => OnPickDs(rdlName, e.Value?.ToString())">
                                        <option value="">-- Elegir dataset externo --</option>
                                        @foreach (var ds in _impGranted)
                                        {
                                            <option value="@ds.Id" selected="@(_impMap.GetValueOrDefault(rdlName) == ds.Id)">@ds.Name</option>
                                        }
                                    </select>
                                </div>
                                @if (picked is not null && picked.Inputs.Count > 0)
                                {
                                    <div style="margin-top:10px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;">
                                        @foreach (var inp in picked.Inputs)
                                        {
                                            var input = inp;
                                            <label style="font-size:11.5px;font-weight:600;color:#6b7280;">
                                                @input.Name <span style="font-weight:400;">(@input.Type)</span>
                                                <input class="form-control" value="@GetInput(rdlName, input.Name)"
                                                       @onchange="e => SetInput(rdlName, input.Name, e.Value?.ToString())" />
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_impRdl is not null)
                    {
                        <p style="font-size:12.5px;color:#b45309;margin-top:12px;">El RDL no declara datasets (o no se pudo parsear).</p>
                    }
                }
            </div>
            <div class="modal-head" style="border-top:1px solid #eef0f3;border-bottom:none;justify-content:flex-end;gap:8px;">
                <button class="modal-close" style="width:auto;padding:8px 14px;font-size:13px;" @onclick="CloseImport" disabled="@_impBusy">Cancelar</button>
                @if (_impGranted.Count > 0)
                {
                    <button style="background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;"
                            @onclick="DoImportAsync" disabled="@(_impBusy || _impRdl is null)">@(_impBusy ? "Importando..." : "Importar")</button>
                }
            </div>
        </div>
    </div>
}

@* ===================== MODAL: Nuevo / Editar panel por spec (ADR-0066) ===================== *@
@if (_panelOpen)
{
    <div class="modal-overlay" @onclick="ClosePanel">
        <div class="modal-dialog" style="max-width:900px;width:96vw;max-height:94vh;display:flex;flex-direction:column;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@(_panelEditId is null ? "Nuevo panel (spec)" : "Editar panel")</h3>
                <button class="modal-close" @onclick="ClosePanel">&times;</button>
            </div>
            <div class="modal-body" style="flex:1;overflow:auto;padding:18px 22px;">
                <p style="font-size:12.5px;color:#6b7280;margin:0 0 12px;">
                    Un panel es DATO: pega un <strong>PanelSpec</strong> (JSON). El spec referencia SOLO fuentes y
                    campos del catalogo de este tenant. <strong>Valida</strong> antes de guardar; al guardar aparece en
                    la galeria y abre por el renderizador generico, sin recompilar ni desplegar.
                </p>
                <label style="font-size:12px;font-weight:600;color:#374151;display:block;margin-bottom:10px;">Nombre del panel
                    <input class="form-control" @bind="_panelName" maxlength="200" placeholder="Ventas y Facturacion (SIIGO)" style="margin-top:4px;" />
                </label>
                <label style="font-size:12px;font-weight:600;color:#374151;display:block;">PanelSpec (JSON)</label>
                <textarea @bind="_panelJson" spellcheck="false"
                          style="width:100%;height:46vh;margin-top:4px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;border:1px solid #d1d5db;border-radius:8px;padding:10px;resize:vertical;"></textarea>

                @if (_panelErrors.Count > 0)
                {
                    <div class="tk-field-error" style="margin-top:12px;">
                        <strong>El spec tiene @_panelErrors.Count problema(s):</strong>
                        <ul style="margin:6px 0 0 18px;padding:0;">
                            @foreach (var e in _panelErrors) { <li>@e</li> }
                        </ul>
                    </div>
                }
                else if (_panelValidated)
                {
                    <div style="margin-top:12px;background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;border-radius:8px;padding:10px 14px;font-size:13px;">
                        Spec valido contra el catalogo de este tenant.
                    </div>
                }
                @if (_panelSaveError is not null)
                {
                    <div class="tk-field-error" style="margin-top:12px;">@_panelSaveError</div>
                }
            </div>
            <div class="modal-head" style="border-top:1px solid #eef0f3;border-bottom:none;justify-content:space-between;gap:8px;">
                <button style="border:1px solid #e5e7eb;background:#fff;color:#374151;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;"
                        @onclick="ValidatePanel" disabled="@_panelBusy">Validar</button>
                <div style="display:flex;gap:8px;">
                    <button class="modal-close" style="width:auto;padding:8px 14px;font-size:13px;" @onclick="ClosePanel" disabled="@_panelBusy">Cancelar</button>
                    <button style="background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;"
                            @onclick="SavePanelAsync" disabled="@_panelBusy">@(_panelBusy ? "Guardando..." : "Guardar")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ReportDefinitionSummary> _cards = Array.Empty<ReportDefinitionSummary>();
    private bool _canCreate;
    private bool _busy;

    private ReportDefinitionSummary? _open;
    private string _view = "tablero";
    private bool _tableroAvail;
    private bool _imprimibleAvail;
    private bool _rdlReady;
    private bool _isPanel;   // reporte tipo panel (dashboard multi-grafico): SourceKey "panel:..."
    private bool _isSpecPanel;   // panel GENERICO por spec (ADR-0066): SourceKey "panel:spec"
    private ReportRunResult? _run;
    private string? _error;
    private ElementReference _overlayRef;
    private bool _focusModal;   // enfocar el overlay al abrir, para que Escape lo cierre

    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        _canCreate = eff.Unrestricted
            || eff.Can("reportes/ia", PermissionAction.Create)
            || eff.Can("reportes/admin", PermissionAction.View);

        // Auto-activacion por condicion (ADR-0062): al entrar a la galeria, activa en este tenant las
        // plantillas publicadas de fuente CONTENEDOR cuyo contenedor requerido ya existe (p.ej. el Panel
        // OCS aparece solo, y solo, donde hay contenedor OCS). Idempotente; nunca cruza tenants.
        try { await Activation.ActivateCompatibleAsync(includeNative: false); }
        catch { /* la galeria no debe romperse si la auto-activacion falla */ }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var eff = await Perms.GetAsync();
        var seeAll = eff.Unrestricted || eff.Can("reportes/admin", PermissionAction.View);
        _cards = await Defs.ListAsync(seeAll, eff.RolId);
    }

    private async Task CreateExamplesAsync()
    {
        _busy = true;
        try
        {
            await Defs.CreateExampleReportsAsync();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    // ---- Importar RDL externo (ADR-0064) ----
    private bool _importOpen;
    private bool _impBusy;
    private string? _impError;
    private string _impName = "";
    private string _impDesc = "";
    private string? _impRdl;
    private IReadOnlyList<string> _impDsNames = Array.Empty<string>();
    private IReadOnlyList<GrantedExternalDataSetDto> _impGranted = Array.Empty<GrantedExternalDataSetDto>();
    private readonly Dictionary<string, Guid?> _impMap = new(StringComparer.Ordinal);                     // dataset del RDL -> ExternalDataSetId
    private readonly Dictionary<string, Dictionary<string, string?>> _impInputs = new(StringComparer.Ordinal); // dataset del RDL -> input -> valor

    private async Task OpenImportAsync()
    {
        _impError = null; _impName = ""; _impDesc = ""; _impRdl = null;
        _impDsNames = Array.Empty<string>();
        _impMap.Clear(); _impInputs.Clear();
        _impGranted = await ExternalReports.ListGrantedDataSetsAsync();
        _importOpen = true;
    }

    private void CloseImport() => _importOpen = false;

    private async Task OnRdlSelected(InputFileChangeEventArgs e)
    {
        _impError = null;
        var file = e.File;
        if (file is null) { return; }
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _impRdl = await reader.ReadToEndAsync();
        }
        catch (Exception ex) { _impError = $"No se pudo leer el archivo: {ex.Message}"; _impRdl = null; return; }

        if (string.IsNullOrWhiteSpace(_impName))
        {
            var dot = file.Name.LastIndexOf('.');
            _impName = dot > 0 ? file.Name[..dot] : file.Name;
        }
        _impDsNames = ExternalReports.ReadRdlDataSetNames(_impRdl);
        _impMap.Clear(); _impInputs.Clear();
        foreach (var n in _impDsNames)
        {
            _impMap[n] = null;
            _impInputs[n] = new Dictionary<string, string?>(StringComparer.Ordinal);
        }
    }

    private void OnPickDs(string rdlName, string? value)
    {
        _impMap[rdlName] = Guid.TryParse(value, out var g) ? g : (Guid?)null;
        if (!_impInputs.TryGetValue(rdlName, out var inputs))
        {
            inputs = _impInputs[rdlName] = new Dictionary<string, string?>(StringComparer.Ordinal);
        }
        inputs.Clear();
        // Al elegir dataset, precarga los valores por defecto de sus parametros de entrada.
        var ds = _impMap[rdlName] is Guid gid ? _impGranted.FirstOrDefault(x => x.Id == gid) : null;
        if (ds is not null)
        {
            foreach (var inp in ds.Inputs) { inputs[inp.Name] = inp.DefaultValue; }
        }
    }

    private GrantedExternalDataSetDto? PickedDs(string rdlName)
        => _impMap.TryGetValue(rdlName, out var id) && id is Guid g ? _impGranted.FirstOrDefault(x => x.Id == g) : null;

    private string? GetInput(string rdlName, string inp)
        => _impInputs.TryGetValue(rdlName, out var d) && d.TryGetValue(inp, out var v) ? v : null;

    private void SetInput(string rdlName, string inp, string? val)
    {
        if (!_impInputs.TryGetValue(rdlName, out var d)) { d = _impInputs[rdlName] = new Dictionary<string, string?>(StringComparer.Ordinal); }
        d[inp] = val;
    }

    private async Task DoImportAsync()
    {
        _impError = null;
        if (string.IsNullOrWhiteSpace(_impRdl)) { _impError = "Sube un archivo .rdl primero."; return; }
        if (string.IsNullOrWhiteSpace(_impName)) { _impError = "Ponle un nombre al reporte."; return; }

        var maps = new List<ExternalReportDataSetMapping>();
        foreach (var rdlName in _impDsNames)
        {
            if (_impMap.TryGetValue(rdlName, out var id) && id is Guid gid)
            {
                var inputs = _impInputs.TryGetValue(rdlName, out var d)
                    ? new Dictionary<string, string?>(d, StringComparer.Ordinal)
                    : new Dictionary<string, string?>(StringComparer.Ordinal);
                maps.Add(new ExternalReportDataSetMapping(rdlName, gid, inputs));
            }
        }
        if (maps.Count == 0) { _impError = "Mapea al menos un dataset del RDL a un dataset externo concedido."; return; }

        _impBusy = true;
        try
        {
            var id = await ExternalReports.ImportRdlAsync(
                _impName.Trim(), _impRdl!, new ExternalReportBinding(maps),
                string.IsNullOrWhiteSpace(_impDesc) ? null : _impDesc.Trim());
            _importOpen = false;
            await ReloadAsync();
            Nav.NavigateTo($"/reportes/imprimibles/{id}");
        }
        catch (Exception ex) { _impError = ex.Message; }
        finally { _impBusy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModal)
        {
            _focusModal = false;
            try { await _overlayRef.FocusAsync(); } catch { /* el overlay puede no estar aun */ }
        }
    }

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { Close(); }
    }

    private async Task OpenAsync(ReportDefinitionSummary card)
    {
        _open = card;
        _focusModal = true;
        _error = null;
        _run = null;
        _rdlReady = false;

        // Reporte tipo PANEL (dashboard multi-grafico): se renderiza el componente completo, no un
        // solo grafico; no aplica la vista imprimible.
        _isPanel = card.SourceKey is not null && card.SourceKey.StartsWith("panel:", StringComparison.OrdinalIgnoreCase);
        _isSpecPanel = PanelSpecSource.Is(card.SourceKey);
        if (_isPanel)
        {
            _tableroAvail = true;
            _imprimibleAvail = false;
            _view = "tablero";
            return;
        }

        // Tablero disponible si el reporte tiene spec (RunAsync no-null). Imprimible disponible si ya
        // tiene RDL (Kind=Printable) o si se puede generar desde el spec (o sea, si el tablero corre).
        _run = await SafeRunAsync(card.Id);
        _tableroAvail = _run is not null;
        _imprimibleAvail = card.Kind == ReportDefinitionKind.Printable || _tableroAvail;
        _view = _tableroAvail ? "tablero" : "imprimible";
        if (_view == "imprimible")
        {
            await ShowImprimibleAsync();
        }
    }

    private async Task<ReportRunResult?> SafeRunAsync(Guid id)
    {
        try { return await Defs.RunAsync(id); }
        catch (Exception ex) { _error = ex.Message; return null; }
    }

    private async Task ShowTablero()
    {
        _view = "tablero";
        if (!_isPanel && _run is null && _open is not null)
        {
            _run = await SafeRunAsync(_open.Id);
        }
    }

    private async Task ShowImprimibleAsync()
    {
        _view = "imprimible";
        _rdlReady = false;
        if (_open is null) { return; }
        try { _rdlReady = await Defs.EnsurePrintableRdlAsync(_open.Id); }
        catch (Exception ex) { _error = ex.Message; _rdlReady = false; }
    }

    private void Close()
    {
        _open = null;
        _run = null;
    }

    // Resolver SourceKey -> componente de panel. Agregar un panel nuevo es una entrada aqui, no tocar
    // el markup. Un SourceKey de panel desconocido cae al dashboard de actividades por defecto.
    private static readonly Dictionary<string, Type> PanelComponents = new(StringComparer.OrdinalIgnoreCase)
    {
        ["panel:system-activities"] = typeof(ActivitiesDashboardPanel),
        ["panel:ocs"] = typeof(OcsDashboardPanel),
        // panel:tareas retirado (ADR-0064): el reporte de tareas ahora va por el conector de datos
        // externos gobernado (datos EN VIVO), no por contenedor/panel.
    };

    private static Type ResolvePanelType(string? sourceKey) =>
        sourceKey is not null && PanelComponents.TryGetValue(sourceKey, out var t) ? t : typeof(ActivitiesDashboardPanel);

    private static string ToggleStyle(bool on) =>
        $"border:1px solid {(on ? "#4f46e5" : "#e5e7eb")};background:{(on ? "#4f46e5" : "#fff")};color:{(on ? "#fff" : "#374151")};border-radius:8px;padding:5px 14px;font-size:12.5px;font-weight:600;cursor:pointer;";

    // ---- Autoria de paneles GENERICOS por spec (ADR-0066): panel como DATO, sin codigo ni deploy ----
    private bool _panelOpen;
    private bool _panelBusy;
    private bool _panelValidated;
    private Guid? _panelEditId;
    private string _panelName = "";
    private string _panelJson = "";
    private string? _panelSaveError;
    private IReadOnlyList<string> _panelErrors = Array.Empty<string>();

    private void OpenNewPanel()
    {
        _panelEditId = null;
        _panelName = "";
        _panelJson = PanelSpecTemplate;
        _panelErrors = Array.Empty<string>();
        _panelValidated = false;
        _panelSaveError = null;
        _panelOpen = true;
    }

    private async Task EditOpenPanel()
    {
        if (_open is null) { return; }
        _panelEditId = _open.Id;
        _panelName = _open.Name;
        _panelJson = await Defs.GetSpecJsonAsync(_open.Id) ?? PanelSpecTemplate;
        _panelErrors = Array.Empty<string>();
        _panelValidated = false;
        _panelSaveError = null;
        Close();
        _panelOpen = true;
    }

    private async Task DuplicateOpenPanel()
    {
        if (_open is null) { return; }
        try
        {
            await Defs.DuplicatePanelSpecAsync(_open.Id, _open.Name + " (copia)");
            Close();
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ArchiveOpenPanel()
    {
        if (_open is null) { return; }
        try
        {
            await Defs.ArchiveAsync(_open.Id);
            Close();
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void ClosePanel() => _panelOpen = false;

    private async Task ValidatePanel()
    {
        _panelSaveError = null;
        _panelBusy = true;
        try
        {
            _panelErrors = await Defs.ValidatePanelSpecAsync(_panelJson);
            _panelValidated = _panelErrors.Count == 0;
        }
        catch (Exception ex) { _panelSaveError = ex.Message; }
        finally { _panelBusy = false; }
    }

    private async Task SavePanelAsync()
    {
        _panelSaveError = null;
        if (string.IsNullOrWhiteSpace(_panelName)) { _panelSaveError = "Ponle un nombre al panel."; return; }

        _panelBusy = true;
        try
        {
            _panelErrors = await Defs.ValidatePanelSpecAsync(_panelJson);
            if (_panelErrors.Count > 0)
            {
                _panelValidated = false;
                return;
            }

            if (_panelEditId is Guid id)
            {
                await Defs.UpdatePanelSpecAsync(id, _panelName.Trim(), _panelJson);
            }
            else
            {
                await Defs.SavePanelSpecAsync(_panelName.Trim(), _panelJson);
            }

            _panelOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex) { _panelSaveError = ex.Message; }
        finally { _panelBusy = false; }
    }

    // Plantilla de arranque para "Nuevo panel": un esqueleto minimo valido de PanelSpec.
    private const string PanelSpecTemplate = @"{
  ""title"": ""Mi panel"",
  ""sources"": { ""main"": { ""container"": ""NOMBRE_DEL_CONTENEDOR"" }, ""lookups"": [] },
  ""derived"": [],
  ""filters"": [],
  ""kpis"": [
    { ""label"": ""Registros"", ""agg"": ""count"", ""format"": ""int"" }
  ],
  ""widgets"": [
    { ""type"": ""donut"", ""title"": ""Por categoria"", ""dim"": ""CAMPO"", ""agg"": ""count"" }
  ]
}";
}
