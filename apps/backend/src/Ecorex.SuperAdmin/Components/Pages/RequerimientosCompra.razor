    // ======================= Alta / planificacion / acciones =======================
    // Valores de los campos dinamicos (Padre) capturados en el alta: defId -> valor.
    private Dictionary<Guid, string?> _altaDynValues = new();
    private void SetAltaDyn(Guid defId, string? value) => _altaDynValues[defId] = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private void SetAltaDynBool(Guid defId, ChangeEventArgs e) => _altaDynValues[defId] = (e.Value is bool b && b) ? "true" : null;

    private void OpenAlta()
    {
        _altaError = null;
        _aOrigen = ""; _aItem = ""; _aDescripcion = ""; _aCantidad = 1; _aUnidad = ""; _aArea = ""; _aFecha = null;
        _altaDynValues = new();
        _showAlta = true;
    }

    private async Task CrearAsync()
    {
        _altaError = null;
        _busy = true;
        try
        {
            // Alta manual: el solicitante es quien la registra (snapshot del nombre visible). No tenemos a mano
            // el TenantUserId en la consola (el claim es el PlatformUserId), asi que guardamos solo el nombre.
            var req = new CrearRequerimientoRequest(
                Guid.TryParse(_aOrigen, out var o) ? o : null,
                _aArea,
                Guid.TryParse(_aItem, out var i) ? i : null,
                _aDescripcion,
                _aCantidad,
                _aUnidad,
                _aFecha is { } d ? new DateTimeOffset(d, TimeSpan.Zero) : null,
                SolicitanteNombre: string.IsNullOrWhiteSpace(_userName) ? null : _userName);
            var saved = await Svc.CrearAsync(req);
            if (saved is null) { _altaError = "No se pudo crear."; return; }
            // Persiste los campos dinamicos (Padre) capturados, ligados a la nueva necesidad.
            foreach (var kv in _altaDynValues.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
            {
                try { await FieldSvc.SetValueAsync(saved.Id, kv.Key, kv.Value); } catch { }
            }
            _showAlta = false;
            _msg = $"Necesidad '{saved.Descripcion}' creada.";
            await ReloadAsync();
        }
        catch (Exception ex) { _altaError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        _busy = true;
        try { await Svc.DeleteAsync(id); await ReloadAsync(); }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OpenPlanificarAsync(RequerimientoDto r)
    {
        _planError = null;
        _planReqId = r.Id;
        _planItemId = r.ItemId;
        _planDescripcion = r.Descripcion;
        var plan = await Svc.GetPlanificacionAsync(r.Id);
        _planProducto = plan?.Producto ?? r.Descripcion;
        _planCantidadPadre = plan?.CantidadPadre ?? r.Cantidad;
        _pHijos = (plan?.Hijos ?? new List<RequerimientoHijoDto>()).Select(MapHijo).ToList();
        _showPlan = true;
        // Trae el contacto (nombre/correo/telefono) de los proveedores ya asignados.
        foreach (var h in _pHijos) { await FillContactoAsync(h); }
        // Valores de los campos dinamicos de las lineas (hijas) ya guardadas.
        await LoadHijoDynValuesAsync();
    }

    private async Task LoadHijoDynValuesAsync()
    {
        if (_dynDefsHija.Count == 0) { _dynHijoValues = new(); return; }
        var ids = _pHijos.Where(h => h.Id is not null).Select(h => h.Id!.Value).ToList();
        try { _dynHijoValues = (await FieldSvc.GetValuesAsync(ids)).ToDictionary(kv => kv.Key, kv => kv.Value); }
        catch { _dynHijoValues = new(); }
    }

    private async Task SetHijoDynValueAsync(Guid hijoId, Guid defId, string? value)
    {
        var v = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        try { await FieldSvc.SetValueAsync(hijoId, defId, v); }
        catch (Exception ex) { _planError = ex.Message; return; }
        if (!_dynHijoValues.TryGetValue(hijoId, out var d)) { d = new(); _dynHijoValues[hijoId] = d; }
        d[defId] = v;
    }

    private Task SetHijoDynBoolAsync(Guid hijoId, Guid defId, ChangeEventArgs e)
        => SetHijoDynValueAsync(hijoId, defId, (e.Value is bool b && b) ? "true" : null);

    private async Task FillContactoAsync(HijoEdit h)
    {
        if (Guid.TryParse(h.Prov, out var pid))
        {
            try
            {
                h.ContactosDisponibles = (await Svc.ListContactosAsync(pid)).ToList();
                // Si el contacto elegido ya no existe para este proveedor, se cae al primero.
                if (h.ContactoId is { } cid && h.ContactosDisponibles.All(c => c.Id != cid)) { h.ContactoId = null; }
            }
            catch { h.ContactosDisponibles = new(); }
            try
            {
                var c = await Svc.GetProveedorContactoAsync(pid, h.ContactoId);
                h.Contacto = c?.Contacto; h.Email = c?.Email; h.Telefono = c?.Telefono;
                if (c is not null && string.IsNullOrWhiteSpace(h.ProvNombre)) { h.ProvNombre = c.Nombre; }
            }
            catch { h.Contacto = null; h.Email = null; h.Telefono = null; }
            try
            {
                var up = await Svc.GetUltimoPrecioAsync(_planItemId, _planDescripcion, pid, _planReqId);
                h.UltimoPrecio = up?.Precio; h.UltimoPrecioFecha = up?.Fecha;
            }
            catch { h.UltimoPrecio = null; h.UltimoPrecioFecha = null; }
        }
        else { h.Contacto = null; h.Email = null; h.Telefono = null; h.UltimoPrecio = null; h.UltimoPrecioFecha = null; h.ContactosDisponibles = new(); h.ContactoId = null; }
    }

    // El usuario eligio otro contacto del proveedor para esta linea.
    private async Task OnContactoPicked(HijoEdit h, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        h.ContactoId = Guid.TryParse(v, out var cid) ? cid : null;
        await FillContactoAsync(h);
    }

    private async Task OnProvChanged(HijoEdit h, ChangeEventArgs e)
    {
        var txt = (e.Value?.ToString() ?? "").Trim();
        h.ProvNombre = txt;
        var match = _proveedores.FirstOrDefault(p => string.Equals(p.Nombre, txt, StringComparison.OrdinalIgnoreCase));
        if (match is not null)
        {
            h.Prov = match.Id.ToString();
            h.ContactoId = null; // proveedor nuevo -> contacto por defecto
            await FillContactoAsync(h);
        }
        else
        {
            // Texto que no corresponde a un proveedor del Directorio: se deja sin proveedor.
            h.Prov = ""; h.Contacto = null; h.Email = null; h.Telefono = null; h.ContactoId = null; h.ContactosDisponibles = new();
        }
    }

