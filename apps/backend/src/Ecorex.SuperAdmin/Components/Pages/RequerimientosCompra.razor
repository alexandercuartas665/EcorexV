    private async Task ExportCsvAsync()
    {
        var vis = VisibleCols().ToList();
        if (vis.Count == 0) { _msg = "No hay columnas visibles para exportar."; return; }
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(';', vis.Select(c => Csv(c.Label))));
        foreach (var it in BuildExportItems())
        {
            if (it.Kind == GKind.Group)
            {
                sb.AppendLine(Csv(it.Label ?? "") + string.Concat(Enumerable.Repeat(";", vis.Count - 1)));
            }
            else if (it.Kind == GKind.Data && it.R is { } r)
            {
                sb.AppendLine(string.Join(';', vis.Select(c => Csv(CellStr(c.Key, r)))));
            }
            else if (it.Kind == GKind.Child && it.R is { } pr && it.H is { } h)
            {
                sb.AppendLine(string.Join(';', vis.Select(c => Csv(ChildStr(c.Key, pr, h)))));
            }
            else if (it.Kind == GKind.Subtotal)
            {
                var labelPut = false;
                var cells = vis.Select(c =>
                {
                    if (c.Num && it.Sums!.TryGetValue(c.Key, out var sv)) { return Fmt(sv); }
                    if (!c.Num && !labelPut) { labelPut = true; return Csv((it.Grand ? "TOTAL GENERAL" : "Subtotal") + " · " + it.Count + " reg."); }
                    return "";
                });
                sb.AppendLine(string.Join(';', cells));
            }
        }
        var nombre = $"requerimientos-compra-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        await JS.InvokeVoidAsync("ecorexMenuConfig.downloadText", nombre, "﻿" + sb.ToString(), "text/csv;charset=utf-8");
    }

    private async Task ExportExcelAsync()
    {
        if (_busy) { return; }
        _busy = true; _msg = null;
        try
        {
            var vis = VisibleCols().ToList();
            if (vis.Count == 0) { _msg = "No hay columnas visibles para exportar."; return; }
            var lblCol = vis.FindIndex(c => !c.Num); if (lblCol < 0) { lblCol = 0; }

            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("Requerimientos");
            var rowN = 1;

            for (var i = 0; i < vis.Count; i++)
            {
                var cell = ws.Cell(rowN, i + 1);
                cell.Value = vis[i].Label;
                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#1F2937");
                cell.Style.Font.FontColor = XLColor.White;
                cell.Style.Alignment.Horizontal = vis[i].Num ? XLAlignmentHorizontalValues.Right : XLAlignmentHorizontalValues.Left;
            }
            ws.SheetView.FreezeRows(1);
            rowN++;

            foreach (var it in BuildExportItems())
            {
                if (it.Kind == GKind.Group)
                {
                    var cell = ws.Cell(rowN, 1);
                    cell.Value = it.Label ?? "";
                    ws.Range(rowN, 1, rowN, vis.Count).Merge();
                    cell.Style.Font.Bold = true;
                    cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#EEF2FF");
                    if (it.Level > 0) { cell.Style.Alignment.Indent = it.Level; }
                    rowN++;
                }
                else if (it.Kind == GKind.Data && it.R is { } r)
                {
                    for (var i = 0; i < vis.Count; i++)
                    {
                        var c = vis[i];
                        var cell = ws.Cell(rowN, i + 1);
                        if (c.Key == "cantidad") { cell.Value = r.Cantidad; cell.Style.NumberFormat.Format = "#,##0.##"; }
                        else if (c.Key == "monto") { cell.Value = r.MontoTotal; cell.Style.NumberFormat.Format = "#,##0.00"; }
                        else if (c.Key == "fecha" && r.FechaNecesidad is { } f) { cell.Value = f.DateTime; cell.Style.DateFormat.Format = "dd/MM/yyyy"; }
                        else { cell.Value = CellStr(c.Key, r); }
                    }
                    rowN++;
                }
                else if (it.Kind == GKind.Child && it.R is { } pr && it.H is { } h)
                {
                    for (var i = 0; i < vis.Count; i++)
                    {
                        var c = vis[i];
                        var cell = ws.Cell(rowN, i + 1);
                        if (c.Key == "cantidad") { cell.Value = h.Cantidad; cell.Style.NumberFormat.Format = "#,##0.##"; }
                        else if (c.Key == "precio") { cell.Value = h.PrecioUnitario; cell.Style.NumberFormat.Format = "#,##0.00"; }
                        else if (c.Key == "monto") { cell.Value = h.Total; cell.Style.NumberFormat.Format = "#,##0.00"; }
                        else if (c.Key == "fecha" && h.FechaProgramadaCompra is { } f) { cell.Value = f.DateTime; cell.Style.DateFormat.Format = "dd/MM/yyyy"; }
                        else { cell.Value = ChildStr(c.Key, pr, h); }
                        cell.Style.Font.Italic = true;
                        cell.Style.Font.FontColor = XLColor.FromHtml("#6B7280");
                    }
                    rowN++;
                }
                else if (it.Kind == GKind.Subtotal)
                {
                    for (var i = 0; i < vis.Count; i++)
                    {
                        var c = vis[i];
                        var cell = ws.Cell(rowN, i + 1);
                        if (c.Num && it.Sums is { } s && s.TryGetValue(c.Key, out var sv)) { cell.Value = sv; cell.Style.NumberFormat.Format = c.Key == "monto" ? "#,##0.00" : "#,##0.##"; }
                        cell.Style.Font.Bold = true;
                        cell.Style.Fill.BackgroundColor = it.Grand ? XLColor.FromHtml("#D1D5DB") : XLColor.FromHtml("#F3F4F6");
                    }
                    ws.Cell(rowN, lblCol + 1).Value = (it.Grand ? "TOTAL GENERAL" : "Subtotal") + " · " + it.Count + " reg.";
                    rowN++;
                }
            }

            ws.Columns().AdjustToContents();
            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var fname = $"Requerimientos_Compra_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("ecorexDcCanvas.downloadBase64", fname, Convert.ToBase64String(ms.ToArray()),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex) { _msg = "Error al exportar a Excel: " + ex.Message; }
        finally { _busy = false; }
    }

    private static string Csv(string? s)
    {
        s ??= "";
        if (s.Contains(';') || s.Contains('"') || s.Contains('\n')) { return "\"" + s.Replace("\"", "\"\"") + "\""; }
        return s;
    }

