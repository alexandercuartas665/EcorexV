@page "/requerimientos-compra"
@attribute [Authorize(Policy = "Compras.Ver")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Ecorex.Application.Requerimientos
@using Ecorex.Application.Preferences
@using Ecorex.Domain.Enums
@using Ecorex.SuperAdmin.Components.Pages.Requerimientos
@using ClosedXML.Excel
@inject IRequerimientoService Svc
@inject IRequerimientoFieldService FieldSvc
@inject IUserTablePrefsService Prefs
@inject ISavedFilterService SavedFilters
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Requerimientos de Compra - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            </div>
            <span>Compras</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Requerimientos de Compra</h1>
        <p class="page-sub" style="margin-bottom:0;">Necesidades de compra de varias areas. Filtra, ordena, agrupa y exporta; expande cada compra para ver sus distribuciones.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <button class="btn btn-primary" @onclick="() => OpenAlta()" disabled="@_busy">+ Nueva necesidad</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="cd-msg">@_msg</div>
}

@if (_rows.Count > 0)
{
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 4px;">
        @foreach (var e in Enum.GetValues<RequerimientoEstado>())
        {
            var n = _rows.Count(r => r.Estado == e);
            <div style="display:flex;flex-direction:column;min-width:96px;padding:8px 12px;border:1px solid var(--line-2,#e5e7eb);border-radius:10px;background:var(--surface,#fff);@(n == 0 ? "opacity:.5;" : "")">
                <span style="font-size:11px;color:var(--ink-3,#6b7280);">@RequerimientoFilter.EstadoLabel(e)</span>
                <span style="font-size:18px;font-weight:800;color:var(--ink,#1f2937);">@n</span>
            </div>
        }
        <div style="display:flex;flex-direction:column;min-width:120px;padding:8px 12px;border:1px solid var(--brand,#4f46e5);border-radius:10px;background:var(--brand-soft,#eef2ff);">
            <span style="font-size:11px;color:var(--brand,#4f46e5);">Monto total</span>
            <span style="font-size:18px;font-weight:800;color:var(--brand,#4f46e5);">@Fmt(_rows.Sum(r => r.MontoTotal))</span>
        </div>
    </div>
}

@* ---- Constructor de filtros + guardados ---- *@
<div class="cd-filtros">
    <button class="cd-tbtn @(FilterCount > 0 ? "on" : "")" @onclick="OpenFilterBuilder" title="Construye un filtro con condiciones Y/O anidadas">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
        <span>Filtros@(FilterCount > 0 ? $" ({FilterCount})" : "")</span>
    </button>

    <div class="cd-dd">
        <button class="cd-tbtn" @onclick="@(() => ToggleMenu("saved"))" title="Filtros guardados del equipo">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            <span>Guardados@(_savedFilters.Count > 0 ? $" ({_savedFilters.Count})" : "")</span>
        </button>
        @if (_openMenu == "saved")
        {
            <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
            <div class="cd-dd-panel" style="min-width:280px;">
                <div class="cd-dd-title">Filtros del equipo</div>
                @if (_savedFilters.Count == 0)
                {
                    <div class="cd-dd-empty">No hay filtros guardados. Arma uno en "Filtros" y usa "Guardar".</div>
                }
                else
                {
                    @foreach (var sf in _savedFilters)
                    {
                        var sfx = sf;
                        <div class="cd-dd-row">
                            <button class="cd-saved-apply" @onclick="() => ApplySavedAsync(sfx)" title="@($"Aplicar · Autor: {sfx.CreatedByName ?? "-"}")">@sfx.Name</button>
                            <button class="cd-saved-ico" @onclick="() => EditSaved(sfx)" title="Editar">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                            </button>
                            <button class="cd-saved-ico cd-saved-del" @onclick="() => DeleteSavedAsync(sfx)" title="Eliminar">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                            </button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    @if (FilterCount > 0)
    {
        <span class="cd-filter-active">@FilterCount condici@(FilterCount == 1 ? "ón" : "ones") activa@(FilterCount == 1 ? "" : "s")@(_activeFilterName is { } nm ? $" · {nm}" : "")</span>
        <button class="btn btn-link btn-sm" @onclick="ClearFilter" disabled="@_busy">Limpiar</button>
    }
</div>

@* ---- Barra de herramientas de la grilla ---- *@
<div class="cd-toolbar">
    @* Ordenar (multi-criterio) *@
    <div class="cd-dd">
        <button class="cd-tbtn @(_sorts.Count > 0 ? "on" : "")" @onclick="@(() => ToggleMenu("sort"))" title="Ordenar por una o varias columnas">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h11M3 12h7M3 18h4M18 5v14M18 19l3-3M18 19l-3-3"/></svg>
            <span>Ordenar@(_sorts.Count > 0 ? $" ({_sorts.Count})" : "")</span>
        </button>
        @if (_openMenu == "sort")
        {
            <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
            <div class="cd-dd-panel">
                <div class="cd-dd-title">Ordenar por</div>
                @if (_sorts.Count == 0) { <div class="cd-dd-empty">Sin orden aplicado.</div> }
                @foreach (var s in _sorts.ToList())
                {
                    var sc = s;
                    <div class="cd-dd-row">
                        <select class="cd-in" style="flex:1" @onchange="e => ChangeSortField(sc, e)">
                            @foreach (var col in AllCols)
                            {
                                <option value="@col.Key" selected="@(col.Key == sc.K)">@col.Label</option>
                            }
                        </select>
                        <button class="cd-dd-dir" @onclick="() => ToggleSortDir(sc)" title="Cambiar direccion">@(sc.Dir >= 0 ? "A→Z" : "Z→A")</button>
                        <button class="cd-dd-del" @onclick="() => RemoveSort(sc)" title="Quitar">&times;</button>
                    </div>
                }
                <button class="cd-dd-add" @onclick="AddSort">+ Agregar orden</button>
            </div>
        }
    </div>

    @* Agrupar (apilable) *@
    <div class="cd-dd">
        <button class="cd-tbtn @(_groups.Count > 0 ? "on" : "")" @onclick="@(() => ToggleMenu("group"))" title="Agrupar (genera subtotales y cantidad de registros)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>Agrupar@(_groups.Count > 0 ? $" ({_groups.Count})" : "")</span>
        </button>
        @if (_openMenu == "group")
        {
            <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
            <div class="cd-dd-panel">
                <div class="cd-dd-title">Agrupar por</div>
                @if (_groups.Count == 0) { <div class="cd-dd-empty">Sin agrupacion. Al agrupar se muestran subtotales de cantidad y monto por grupo.</div> }
                @for (int gi = 0; gi < _groups.Count; gi++)
                {
                    var idx = gi;
                    <div class="cd-dd-row">
                        <select class="cd-in" style="flex:1" @onchange="e => ChangeGroupField(idx, e)">
                            @foreach (var col in AllCols.Where(x => x.Groupable))
                            {
                                <option value="@col.Key" selected="@(col.Key == _groups[idx])">@col.Label</option>
                            }
                        </select>
                        <button class="cd-dd-del" @onclick="() => RemoveGroup(idx)" title="Quitar">&times;</button>
                    </div>
                }
                @if (_groups.Count < AllCols.Count(x => x.Groupable))
                {
                    <button class="cd-dd-add" @onclick="AddGroup">+ Agregar agrupacion</button>
                }
            </div>
        }
    </div>

    @* Columnas *@
    <div class="cd-dd">
        <button class="cd-tbtn" @onclick="@(() => ToggleMenu("cols"))" title="Mover, mostrar u ocultar columnas">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
            <span>Columnas@(_hidden.Count > 0 ? $" ({_order.Count - _hidden.Count}/{_order.Count})" : "")</span>
        </button>
        @if (_openMenu == "cols")
        {
            <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
            <div class="cd-dd-panel cd-dd-cols">
                <div class="cd-dd-title">Columnas (arrastra el encabezado para reordenar)</div>
                <div class="cd-collist">
                    @for (int ci = 0; ci < _order.Count; ci++)
                    {
                        var idx = ci;
                        var col = ColByKey(_order[idx]);
                        if (col is null) { continue; }
                        <div class="cd-colit">
                            <button class="cd-col-mv" disabled="@(idx == 0)" @onclick="() => MoveCol(idx, -1)">▲</button>
                            <button class="cd-col-mv" disabled="@(idx == _order.Count - 1)" @onclick="() => MoveCol(idx, 1)">▼</button>
                            <span class="cd-col-name">@col.Label</span>
                            <button class="cd-col-eye @(_hidden.Contains(col.Key) ? "" : "on")" @onclick="() => ToggleHidden(col.Key)" title="@(_hidden.Contains(col.Key) ? "Mostrar" : "Ocultar")">
                                @(_hidden.Contains(col.Key) ? "oculta" : "visible")
                            </button>
                        </div>
                    }
                </div>
                <div class="cd-col-acts">
                    <button class="cd-col-mass" @onclick="ShowAllCols">Mostrar todas</button>
                    <button class="cd-col-reset" @onclick="ResetCols">Restablecer</button>
                </div>
            </div>
        }
    </div>

    @* Columnas fijas *@
    <div class="cd-dd">
        <button class="cd-tbtn @(_frozen > 0 ? "on" : "")" @onclick="@(() => ToggleMenu("freeze"))" title="Fijar columnas a la izquierda al desplazar en horizontal">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v6H4zM4 10v10M9 10v10"/></svg>
            <span>Columnas fijas@(_frozen > 0 ? $" ({_frozen})" : "")</span>
        </button>
        @if (_openMenu == "freeze")
        {
            <div class="cd-dd-overlay" @onclick="CloseMenu"></div>
            <div class="cd-dd-panel">
                <div class="cd-dd-title">Fijar desde la 1.a hasta...</div>
                <button class="cd-dd-item @(_frozen == 0 ? "on" : "")" @onclick="() => SetFrozenAsync(0)">Ninguna (quitar fijas)</button>
                <button class="cd-dd-item @(_frozen == 1 ? "on" : "")" @onclick="() => SetFrozenAsync(1)">Columna de expandir</button>
                @{ var visf = VisibleCols().ToList(); }
                @for (int fi = 0; fi < visf.Count; fi++)
                {
                    var n = fi + 2;
                    <button class="cd-dd-item @(_frozen == n ? "on" : "")" @onclick="() => SetFrozenAsync(n)">@visf[fi].Label</button>
                }
            </div>
        }
    </div>

    @* Campos propios (dinamicos) *@
    @if (_canConfig)
    {
        <button class="cd-tbtn @(_dynDefsPadre.Count + _dynDefsHija.Count > 0 ? "on" : "")" @onclick="OpenCamposAsync" title="Crear campos propios (a medida) para las necesidades y las lineas de planificacion">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            <span>Campos</span>
        </button>
    }

    @* Consolidar: una sola linea por producto (suma cantidades/montos); expande para ver las necesidades reales *@
    <button class="cd-tbtn @(_consolidate && !ByProvider ? "on" : "")" @onclick="ToggleConsolidate" disabled="@ByProvider"
            title="Consolidar: junta las necesidades del mismo producto en una sola linea sumada. Expande cada linea para ver las necesidades reales (con su origen y su Planificar).">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        <span>Consolidar</span>
    </button>

    @* Expandir / colapsar distribuciones *@
    <button class="cd-tbtn" @onclick="ExpandAll" disabled="@ByProvider" title="Mostrar las distribuciones (hijos) de todas las compras">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
        <span>Expandir todo</span>
    </button>
    <button class="cd-tbtn" @onclick="CollapseAll" disabled="@ByProvider" title="Ocultar las distribuciones (hijos)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 11l-5-5-5 5M17 18l-5-5-5 5"/></svg>
        <span>Colapsar todo</span>
    </button>

    @* Exportar *@
    <button class="cd-tbtn" @onclick="ExportCsvAsync" disabled="@(_busy || _rows.Count == 0)" title="Exporta a CSV (lo abre Excel) respetando filtro, columnas y agrupacion actuales; incluye las distribuciones">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        <span>CSV</span>
    </button>
    <button class="cd-tbtn" @onclick="ExportExcelAsync" disabled="@(_busy || _rows.Count == 0)" title="Exporta a Excel (.xlsx) respetando filtro, columnas, orden y agrupacion actuales; incluye subtotales y las distribuciones">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
        <span>Exportar Excel</span>
    </button>

    <div class="cd-toolbar-spacer"></div>
    @if (ByProvider)
    {
        <span class="cd-toolbar-hint">Agrupado por Proveedor (lineas de planificacion)</span>
    }
    else
    {
        @if (_consolidate)
        {
            <span class="cd-toolbar-hint">Consolidado por producto (una linea por producto)</span>
        }
        @if (EffectiveGroups().Count > 0)
        {
            <span class="cd-toolbar-hint">Agrupado por @string.Join(" > ", EffectiveGroups().Select(g => ColByKey(g)?.Label ?? g))</span>
        }
    }
</div>

@if (_rows.Count == 0)
{
    <div class="cd-empty">Sin necesidades todavia. Crea una con "+ Nueva necesidad".</div>
}
else
{
    <div class="cd-grid-wrap">
        <table class="cd-grid">
            <thead>
                <tr>
                    <th class="cd-th-exp"></th>
                    @foreach (var col in VisibleCols())
                    {
                        var c = col;
                        var sort = _sorts.FirstOrDefault(s => s.K == c.Key);
                        var arrow = sort is null ? "" : (sort.Dir >= 0 ? " ▲" : " ▼");
                        <th class="cd-th @(c.Num ? "num" : "")" draggable="true" data-col="@c.Key"
                            style="@(_widths.TryGetValue(c.Key, out var w) ? $"width:{w}px" : "")"
                            @ondragstart="() => _dragCol = c.Key"
                            @ondragover:preventDefault="true"
                            @ondrop="() => OnDropCol(c.Key)">
                            <span class="cd-th-lbl" @onclick="() => QuickSort(c.Key)">@c.Label@arrow</span>
                            <button class="cd-th-caret" @onclick="e => OpenColMenu(c, e)" @onclick:stopPropagation="true" title="Opciones de la columna">▾</button>
                            <span class="cd-rz" title="Arrastra para ajustar el ancho (doble clic: auto)"></span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var it in _gridItems)
                {
                    @if (it.Kind == GKind.Group)
                    {
                        <tr class="cd-grp @(it.Level > 0 ? "cd-grp2" : "")">
                            <td colspan="@ColSpanAll">
                                <span class="cd-grp-lbl" style="padding-left:@(it.Level * 18)px">@it.Label</span>
                                <span class="cd-grp-n">@it.Count reg.</span>
                            </td>
                        </tr>
                    }
                    else if (it.Kind == GKind.Consol && it.Group is { } grp)
                    {
                        <tr class="req-consol">
                            <td class="cd-exp-cell">
                                <button class="req-exp-btn" @onclick="() => ToggleConsol(it.Key!)" title="@(_consolExpanded.Contains(it.Key!) ? "Ocultar las necesidades" : "Ver las necesidades reales")">
                                    @(_consolExpanded.Contains(it.Key!) ? "▾" : "▸")
                                </button>
                            </td>
                            @foreach (var col in VisibleCols())
                            {
                                var c = col;
                                <td class="@(c.Num ? "num" : null) @(c.Key == "acciones" ? "req-acts" : null)">
                                    @switch (c.Key)
                                    {
                                        case "producto":
                                            <strong>@(grp[0].ItemNombre ?? grp[0].Descripcion)@(string.IsNullOrWhiteSpace(grp[0].ItemSku) ? "" : $" ({grp[0].ItemSku})")</strong>
                                            <span class="req-consol-n" title="@it.Count necesidades consolidadas en esta linea">×@it.Count</span>
                                            break;
                                        case "cantidad": <strong>@Fmt(it.Sums!["cantidad"])</strong> break;
                                        case "monto": <text>@(it.Sums!["monto"] > 0 ? Fmt(it.Sums!["monto"]) : "-")</text> break;
                                        case "hijos":
                                            {
                                                var th = grp.Sum(x => x.CantidadHijos);
                                                var resta = grp.Sum(x => x.Cantidad - x.CantidadPlanificada);
                                                if (th > 0)
                                                {
                                                    <span title="Distribuciones (hijos) sumadas">@th</span>
                                                    if (resta > 0) { <span class="req-resta" title="Cantidad sin planificar (sumada)">(resta @Fmt(resta))</span> }
                                                }
                                                else { <span class="cd-muted">-</span> }
                                            }
                                            break;
                                        case "proveedor": <span class="cd-muted">-</span> break;
                                        case "precio": <span class="cd-muted">-</span> break;
                                        case "acciones": <span class="cd-muted" title="Expande la linea para planificar cada necesidad">—</span> break;
                                        default:
                                            {
                                                var cf = ConsolCell(c.Key, grp);
                                                if (cf.Tip is not null) { <span title="@cf.Tip">@cf.Text</span> }
                                                else { <text>@cf.Text</text> }
                                            }
                                            break;
                                    }
                                </td>
                            }
                        </tr>
                    }
                    else if (it.Kind == GKind.Subtotal)
                    {
                        <tr class="cd-sub @(it.Grand ? "cd-sub-grand" : "")">
                            <td class="cd-mark-cell"></td>
                            @{ var labelPut = false; }
                            @foreach (var c in VisibleCols())
                            {
                                <td class="@(c.Num ? "num" : null)">
                                    @if (c.Num && it.Sums!.TryGetValue(c.Key, out var sv))
                                    {
                                        <strong>@Fmt(sv)</strong>
                                    }
                                    else if (!c.Num && !labelPut)
                                    {
                                        labelPut = true;
                                        <span class="cd-sub-lbl">@(it.Grand ? "TOTAL GENERAL" : "Subtotal") · @it.Count reg.</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    else if (it.Kind == GKind.Child && it.R is { } pr && it.H is { } h)
                    {
                        <tr class="req-child">
                            <td class="cd-exp-cell"></td>
                            @foreach (var col in VisibleCols())
                            {
                                var c = col;
                                <td class="@(c.Num ? "num" : null) req-child-cell">
                                    @switch (c.Key)
                                    {
                                        case "producto":
                                            <span class="req-child-mark">↳</span>
                                            <span>@(string.IsNullOrWhiteSpace(h.CaracteristicasDespacho) ? "Distribucion" : h.CaracteristicasDespacho)</span>
                                            break;
                                        case "unidad": <text>@pr.UnidadMedida</text> break;
                                        case "proveedor": <text>@(string.IsNullOrWhiteSpace(h.ProveedorNombre) ? "(sin proveedor)" : h.ProveedorNombre)</text> break;
                                        case "cantidad": <text>@Fmt(h.Cantidad)</text> break;
                                        case "precio": <text>@(h.PrecioUnitario > 0 ? Fmt(h.PrecioUnitario) : "-")</text> break;
                                        case "monto": <text>@(h.Total > 0 ? Fmt(h.Total) : "-")</text> break;
                                        case "fecha": <text>@(h.FechaProgramadaCompra?.ToString("dd/MM/yyyy") ?? "-")</text> break;
                                        case "estado":
                                            <span>@RequerimientoFilter.EstadoLabel(h.Estado)</span>
                                            @if (h.TaskItemId is not null)
                                            {
                                                <span class="req-badge-done" title="Compra ejecutada (actividad creada)">Ejecutada</span>
                                            }
                                            break;
                                        default: <text></text> break;
                                    }
                                </td>
                            }
                        </tr>
                    }
                    else if (it.Kind == GKind.ProvRow && it.R is { } ppr && it.H is { } ph)
                    {
                        <tr class="req-provrow">
                            <td class="cd-exp-cell"></td>
                            @foreach (var col in VisibleCols())
                            {
                                var c = col;
                                <td class="@(c.Num ? "num" : null) @(c.Key == "acciones" ? "req-acts" : null)">
                                    @switch (c.Key)
                                    {
                                        case "producto": <text>@(ppr.ItemNombre ?? ppr.Descripcion)@(string.IsNullOrWhiteSpace(ppr.ItemSku) ? "" : $" ({ppr.ItemSku})")</text> break;
                                        case "area": <text>@ppr.Area</text> break;
                                        case "origen": <text>@ppr.OrigenNombre</text> break;
                                        case "unidad": <text>@ppr.UnidadMedida</text> break;
                                        case "proveedor": <text>@(string.IsNullOrWhiteSpace(ph.ProveedorNombre) ? "(sin proveedor)" : ph.ProveedorNombre)</text> break;
                                        case "cantidad": <text>@Fmt(ph.Cantidad)</text> break;
                                        case "precio": <text>@(ph.PrecioUnitario > 0 ? Fmt(ph.PrecioUnitario) : "-")</text> break;
                                        case "monto": <text>@(ph.Total > 0 ? Fmt(ph.Total) : "-")</text> break;
                                        case "fecha": <text>@(ph.FechaProgramadaCompra?.ToString("dd/MM/yyyy") ?? "-")</text> break;
                                        case "estado":
                                            <span>@RequerimientoFilter.EstadoLabel(ph.Estado)</span>
                                            @if (ph.TaskItemId is not null)
                                            {
                                                <span class="req-badge-done" title="Compra ejecutada (actividad creada)">Ejecutada</span>
                                            }
                                            break;
                                        case "hijos": <text>-</text> break;
                                        case "acciones":
                                            <button class="btn btn-sm btn-light" @onclick="() => OpenPlanificarAsync(ppr)" title="Abrir la planificacion de esta necesidad">Planificar</button>
                                            break;
                                        default: <text></text> break;
                                    }
                                </td>
                            }
                        </tr>
                    }
                    else if (it.R is { } r)
                    {
                        <tr>
                            <td class="cd-exp-cell">
                                @if (r.CantidadHijos > 0)
                                {
                                    <button class="req-exp-btn" @onclick="() => ToggleExpand(r.Id)" title="@(_expanded.Contains(r.Id) ? "Ocultar distribuciones" : "Ver distribuciones")">
                                        @(_expanded.Contains(r.Id) ? "▾" : "▸")
                                    </button>
                                }
                            </td>
                            @foreach (var col in VisibleCols())
                            {
                                var c = col;
                                <td class="@(c.Num ? "num" : null) @(c.Key == "acciones" ? "req-acts" : null)">
                                    @switch (c.Key)
                                    {
                                        case "producto":
                                            <text>@(r.ItemNombre ?? r.Descripcion)@(string.IsNullOrWhiteSpace(r.ItemSku) ? "" : $" ({r.ItemSku})")</text>
                                            break;
                                        case "area": <text>@(string.IsNullOrWhiteSpace(r.Area) ? "-" : r.Area)</text> break;
                                        case "origen": <text>@(r.OrigenNombre ?? "-")</text> break;
                                        case "solicitante": <text>@(string.IsNullOrWhiteSpace(r.SolicitanteNombre) ? "-" : r.SolicitanteNombre)</text> break;
                                        case "actividad":
                                            @if (!string.IsNullOrWhiteSpace(r.SourceTaskNumber))
                                            {
                                                <span class="req-actnum" title="Actividad donde se origino la solicitud">@r.SourceTaskNumber</span>
                                            }
                                            else { <span class="cd-muted">-</span> }
                                            break;
                                        case "unidad": <text>@(string.IsNullOrWhiteSpace(r.UnidadMedida) ? "-" : r.UnidadMedida)</text> break;
                                        case "proveedor": <span class="cd-muted">-</span> break;
                                        case "cantidad": <text>@Fmt(r.Cantidad)</text> break;
                                        case "precio": <span class="cd-muted">-</span> break;
                                        case "monto": <text>@(r.MontoTotal > 0 ? Fmt(r.MontoTotal) : "-")</text> break;
                                        case "fecha": <text>@(r.FechaNecesidad?.ToString("dd/MM/yyyy") ?? "-")</text> break;
                                        case "estado": <text>@RequerimientoFilter.EstadoLabel(r.Estado)</text> break;
                                        case "hijos":
                                            @if (r.CantidadHijos > 0)
                                            {
                                                <span title="Distribuciones (hijos)">@r.CantidadHijos</span>
                                                @if (r.Cantidad - r.CantidadPlanificada > 0)
                                                {
                                                    <span class="req-resta" title="Cantidad sin planificar">(resta @Fmt(r.Cantidad - r.CantidadPlanificada))</span>
                                                }
                                            }
                                            else { <span class="cd-muted">-</span> }
                                            break;
                                        case "acciones":
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenPlanificarAsync(r)" disabled="@_busy">Planificar</button>
                                            @if (_canConfig && r.Estado == RequerimientoEstado.Ejecutado)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm" title="Marcar la compra como terminada" @onclick="() => CerrarAsync(r.Id)" disabled="@_busy">Cerrar</button>
                                            }
                                            @if (_canConfig && r.Estado == RequerimientoEstado.Cerrado)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm" title="Reabrir la necesidad cerrada" @onclick="() => ReabrirAsync(r.Id)" disabled="@_busy">Reabrir</button>
                                            }
                                            <button class="btn btn-link btn-sm" style="color:#b91c1c;" @onclick="() => DeleteAsync(r.Id)" disabled="@_busy">Eliminar</button>
                                            break;
                                        default:
                                            @if (DynDefByKey(c.Key) is { } ddef)
                                            {
                                                var dv = DynVal(r.Id, ddef.Id);
                                                if (ddef.Type == "Bool")
                                                {
                                                    <input type="checkbox" checked="@(dv == "true")" disabled="@(!_canConfig)" @onchange="e => SetDynBoolAsync(r.Id, ddef.Id, e)" />
                                                }
                                                else if (ddef.Type == "Select")
                                                {
                                                    <select class="req-dyn-in" disabled="@(!_canConfig)" @onchange="e => SetDynValueAsync(r.Id, ddef.Id, e.Value?.ToString())">
                                                        <option value="" selected="@string.IsNullOrEmpty(dv)">-</option>
                                                        @foreach (var op in ddef.Options)
                                                        {
                                                            <option value="@op" selected="@(dv == op)">@op</option>
                                                        }
                                                    </select>
                                                }
                                                else if (ddef.Type == "Url")
                                                {
                                                    <input type="text" class="req-dyn-in" value="@dv" placeholder="https://..." disabled="@(!_canConfig)" @onchange="e => SetDynValueAsync(r.Id, ddef.Id, e.Value?.ToString())" />
                                                }
                                                else
                                                {
                                                    <input type="@(ddef.Type == "Number" ? "number" : ddef.Type == "Date" ? "date" : "text")" step="any" class="req-dyn-in" value="@dv" disabled="@(!_canConfig)" @onchange="e => SetDynValueAsync(r.Id, ddef.Id, e.Value?.ToString())" />
                                                }
                                            }
                                            break;
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (_colMenuOpen && _colMenuCol is not null)
{
    <div class="cd-ctx-overlay" @onclick="CloseColMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="cd-ctx-menu" style="left:@(Px(_colMenuX)); top:@(Px(_colMenuY));">
        <div class="cd-ctx-title">@_colMenuCol.Label</div>
        <button class="cd-ctx-item" @onclick="() => SetSingleSort(_colMenuCol.Key, 1)">Ordenar A → Z</button>
        <button class="cd-ctx-item" @onclick="() => SetSingleSort(_colMenuCol.Key, -1)">Ordenar Z → A</button>
        @if (_colMenuCol.Groupable)
        {
            @if (_groups.Contains(_colMenuCol.Key))
            {
                <button class="cd-ctx-item" @onclick="() => RemoveGroupKey(_colMenuCol.Key)">Quitar agrupacion</button>
            }
            else
            {
                <button class="cd-ctx-item" @onclick="() => AddGroupKey(_colMenuCol.Key)">Agrupar por este campo</button>
            }
        }
        <button class="cd-ctx-item" @onclick="() => FijarHastaAsync(_colMenuCol.Key)">Fijar hasta esta columna</button>
        <div class="cd-ctx-sep"></div>
        <button class="cd-ctx-item" @onclick="() => HideColFromMenu(_colMenuCol.Key)">Ocultar columna</button>
    </div>
}

@if (_filterOpen)
{
    <div class="cd-doc-backdrop" @onclick="CloseFilterBuilder"></div>
    <div class="cd-fb-modal" @onclick:stopPropagation="true">
        <div class="cd-doc-head">
            <div class="cd-doc-title">
                <div class="cd-doc-title-main">Constructor de filtros</div>
                <div class="cd-doc-title-sub">Combina condiciones con Y / O. Puedes anidar grupos. Se aplica en vivo.</div>
            </div>
            <button class="cd-doc-close" title="Cerrar" @onclick="CloseFilterBuilder">&times;</button>
        </div>
        <div class="cd-fb-body">
            <RequerimientoFilterGroup Group="_filterRoot" Depth="0" ExtraFields="FilterExtraFields()" OnChanged="OnFilterChanged" />
        </div>
        <div class="cd-fb-foot">
            <button class="btn btn-link btn-sm" @onclick="ClearFilterTree" title="Quita todas las condiciones">Vaciar</button>
            <div class="cd-fb-foot-spacer"></div>
            <input class="cd-in" style="width:200px;" placeholder="Nombre para guardar" @bind="_saveName" @bind:event="oninput" />
            <button class="btn btn-outline-secondary btn-sm" @onclick="SaveFilterAsync" disabled="@(string.IsNullOrWhiteSpace(_saveName) || FilterCount == 0)" title="Guarda este filtro para todo el equipo">Guardar</button>
            <button class="btn btn-primary btn-sm" @onclick="CloseFilterBuilder">Aplicar y cerrar</button>
        </div>
    </div>
}

@if (_showAlta)
{
    <div style="position:fixed;inset:0;z-index:4000;background:rgba(15,23,42,.45);display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;" @onclick="() => _showAlta = false">
        <div style="background:var(--surface,#fff);border-radius:12px;max-width:520px;width:100%;box-shadow:0 20px 50px rgba(0,0,0,.25);" @onclick:stopPropagation="true">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line-2,#e5e7eb);">
                <strong style="font-size:14px;">Nueva necesidad de compra</strong>
                <button class="btn btn-link btn-sm" @onclick="() => _showAlta = false">&times;</button>
            </div>
            <div style="padding:16px 18px;display:flex;flex-direction:column;gap:12px;">
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Origen
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_aOrigen">
                        <option value="">(sin origen / manual)</option>
                        @foreach (var o in _origenes) { <option value="@o.Id">@o.Nombre</option> }
                    </select>
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Item (del modulo de Inventarios)
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_aItem">
                        <option value="">(producto libre - escribe la descripcion)</option>
                        @foreach (var it in _items) { <option value="@it.Id">@(string.IsNullOrWhiteSpace(it.Sku) ? it.Nombre : $"{it.Sku} - {it.Nombre}")</option> }
                    </select>
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Descripcion (si no eliges item)
                    <input class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" placeholder="Producto a comprar" @bind="_aDescripcion" />
                </label>
                <div style="display:flex;gap:12px;">
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);flex:1;">Cantidad
                        <input type="number" step="any" min="0" class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_aCantidad" />
                    </label>
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);flex:1;">Unidad
                        <input class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" placeholder="unid / caja / kg" @bind="_aUnidad" />
                    </label>
                </div>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Area solicitante
                    <input class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" placeholder="Proyectos / Oficina / Inventario" @bind="_aArea" />
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Fecha de necesidad
                    <input type="date" class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_aFecha" />
                </label>
                @foreach (var d in _dynDefsPadre)
                {
                    var dd = d; var av = _altaDynValues.TryGetValue(dd.Id, out var v) ? v : null;
                    @if (dd.Type == "Bool")
                    {
                        <label style="display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--ink-2,#4b5563);" title="@dd.Description">
                            <input type="checkbox" checked="@(av == "true")" @onchange="e => SetAltaDynBool(dd.Id, e)" />
                            @dd.Label
                        </label>
                    }
                    else
                    {
                        <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);" title="@dd.Description">@dd.Label
                            @if (dd.Type == "Select")
                            {
                                <select class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @onchange="e => SetAltaDyn(dd.Id, e.Value?.ToString())">
                                    <option value="" selected="@string.IsNullOrEmpty(av)">-</option>
                                    @foreach (var op in dd.Options)
                                    {
                                        <option value="@op" selected="@(av == op)">@op</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="@(dd.Type == "Number" ? "number" : dd.Type == "Date" ? "date" : "text")" step="any" class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" placeholder="@(dd.Type == "Url" ? "https://..." : "")" value="@av" @onchange="e => SetAltaDyn(dd.Id, e.Value?.ToString())" />
                            }
                        </label>
                    }
                }
                @if (_altaError is not null) { <div style="color:#b91c1c;font-size:12.5px;">@_altaError</div> }
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 18px;border-top:1px solid var(--line-2,#e5e7eb);">
                <button class="btn btn-primary btn-sm" @onclick="CrearAsync" disabled="@_busy">Crear</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showAlta = false" disabled="@_busy">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (_showPlan)
{
    <div style="position:fixed;inset:0;z-index:4000;background:rgba(15,23,42,.45);display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;" @onclick="() => _showPlan = false">
        <datalist id="req-prov-list">
            @foreach (var p in _proveedores) { <option value="@p.Nombre"></option> }
        </datalist>
        <div style="background:var(--surface,#fff);border-radius:12px;width:80vw;max-width:80vw;box-shadow:0 20px 50px rgba(0,0,0,.25);" @onclick:stopPropagation="true">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line-2,#e5e7eb);">
                <strong style="font-size:14px;">Planificar: @_planProducto</strong>
                <button class="btn btn-link btn-sm" @onclick="() => _showPlan = false">&times;</button>
            </div>
            <div style="padding:14px 18px;">
                <div style="display:flex;gap:18px;flex-wrap:wrap;font-size:12.5px;margin-bottom:12px;">
                    <span>Cantidad total: <strong>@Fmt(_planCantidadPadre)</strong></span>
                    <span>Planificada: <strong>@Fmt(PlanificadaActual)</strong></span>
                    <span style="color:@(RestanteActual < 0 ? "#b91c1c" : "#b45309")">Sin planificar: <strong>@Fmt(RestanteActual)</strong></span>
                    <span style="color:var(--brand,#4f46e5);">Monto planificado: <strong>@Fmt(_pHijos.Sum(h => h.Cantidad * h.Precio))</strong></span>
                </div>

                <div style="overflow:auto;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;">
                    <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
                        <thead>
                            <tr style="background:var(--surface-2,#f8fafc);text-align:left;">
                                <th style="padding:7px 10px;">Cantidad</th>
                                <th style="padding:7px 10px;">Fecha de compra</th>
                                <th style="padding:7px 10px;">Despacho</th>
                                <th style="padding:7px 10px;">Tiempo de entrega</th>
                                <th style="padding:7px 10px;">Proveedor</th>
                                <th style="padding:7px 10px;text-align:right;">Precio unit.</th>
                                <th style="padding:7px 10px;text-align:right;">Total</th>
                                <th style="padding:7px 10px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_pHijos.Count == 0)
                            {
                                <tr><td colspan="8" style="padding:14px;text-align:center;color:var(--ink-3,#6b7280);">Sin divisiones. Agrega la primera compra programada.</td></tr>
                            }
                            @foreach (var h in _pHijos)
                            {
                                var hi = h;
                                <tr style="border-top:1px solid var(--line,#f1f5f9);">
                                    <td style="padding:5px 8px;"><input type="number" step="any" min="0" style="width:90px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" @bind="hi.Cantidad" @bind:after="StateHasChanged" /></td>
                                    <td style="padding:5px 8px;"><input type="date" style="height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" @bind="hi.Fecha" /></td>
                                    <td style="padding:5px 8px;"><input style="width:150px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" placeholder="transportadora, lugar..." @bind="hi.Despacho" /></td>
                                    <td style="padding:5px 8px;"><input style="width:130px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" placeholder="15 dias, inmediato" @bind="hi.Entrega" /></td>
                                    <td style="padding:5px 8px;min-width:240px;">
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <input list="req-prov-list" style="width:200px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" placeholder="Escribe el proveedor..." value="@hi.ProvNombre" @onchange="e => OnProvChanged(hi, e)" />
                                            @if (_planItemId is not null)
                                            {
                                                <button class="btn btn-link btn-sm" title="Sugerir proveedor por la matriz" @onclick="() => SugerirAsync(hi)" disabled="@_busy">Sugerir</button>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(hi.Prov))
                                        {
                                            <div style="display:flex;align-items:center;gap:6px;margin-top:4px;">
                                                @if (hi.ContactosDisponibles.Count > 0)
                                                {
                                                    <select class="cd-in" style="height:28px;max-width:200px;font-size:12px;" @onchange="e => OnContactoPicked(hi, e)">
                                                        <option value="" selected="@(hi.ContactoId is null)">(primer contacto / datos del proveedor)</option>
                                                        @foreach (var ct in hi.ContactosDisponibles)
                                                        {
                                                            <option value="@ct.Id" selected="@(hi.ContactoId == ct.Id)">@ct.Nombre@(string.IsNullOrWhiteSpace(ct.Cargo) ? "" : $" ({ct.Cargo})")</option>
                                                        }
                                                    </select>
                                                }
                                                @if (_canConfig)
                                                {
                                                    <button class="btn btn-link btn-sm" style="padding:0;" title="Agregar o editar los contactos (telefonos/correos) de este proveedor" @onclick="() => OpenContactosAsync(hi.Prov)" disabled="@_busy">Editar contactos</button>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(hi.ProvNombre) && (!string.IsNullOrWhiteSpace(hi.Contacto) || !string.IsNullOrWhiteSpace(hi.Email) || !string.IsNullOrWhiteSpace(hi.Telefono)))
                                        {
                                            <div style="font-size:11px;color:var(--ink-3,#6b7280);margin-top:3px;line-height:1.5;">
                                                @if (!string.IsNullOrWhiteSpace(hi.Contacto)) { <span>Contacto: <strong>@hi.Contacto</strong></span> }
                                                @if (!string.IsNullOrWhiteSpace(hi.Email)) { <span style="margin-left:8px;">Correo: @hi.Email</span> }
                                                @if (!string.IsNullOrWhiteSpace(hi.Telefono)) { <span style="margin-left:8px;">Tel: @hi.Telefono</span> }
                                            </div>
                                        }
                                    </td>
                                    <td style="padding:5px 8px;text-align:right;">
                                        <input type="number" step="any" min="0" style="width:100px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;text-align:right;" @bind="hi.Precio" @bind:after="StateHasChanged" />
                                        @if (hi.UltimoPrecio is { } up && up > 0)
                                        {
                                            <div style="font-size:11px;color:var(--ink-3,#6b7280);margin-top:3px;white-space:nowrap;">
                                                ult.: <strong>@Fmt(up)</strong>@(hi.UltimoPrecioFecha is { } f ? $" ({f:dd/MM/yy})" : "")
                                                <button class="btn btn-link btn-sm" style="padding:0 0 0 4px;" title="Usar este precio" @onclick="() => UsarUltimoPrecio(hi)">usar</button>
                                            </div>
                                        }
                                    </td>
                                    <td style="padding:5px 8px;text-align:right;font-variant-numeric:tabular-nums;">@Fmt(hi.Cantidad * hi.Precio)</td>
                                    <td style="padding:5px 8px;text-align:right;white-space:nowrap;">
                                        <div style="display:inline-flex;gap:4px;flex-wrap:wrap;justify-content:flex-end;align-items:center;">
                                            @if (hi.CotizacionTaskItemId is not null)
                                            {
                                                <span style="display:inline-flex;align-items:center;font-size:11.5px;font-weight:700;color:#1d4ed8;background:rgba(29,78,216,.12);padding:3px 8px;border-radius:999px;">Cotizada</span>
                                            }
                                            else if (hi.Id is not null && _canConfig)
                                            {
                                                <label style="display:inline-flex;align-items:center;gap:4px;font-size:11.5px;color:var(--ink-2,#374151);cursor:pointer;" title="Marca esta linea para cotizarla en lote con 'Cotizar seleccionadas'">
                                                    <input type="checkbox" @bind="hi.Sel" />
                                                    Cotizar
                                                </label>
                                            }
                                            @if (hi.TaskItemId is not null)
                                            {
                                                <span style="display:inline-flex;align-items:center;font-size:11.5px;font-weight:700;color:#0f7a58;background:rgba(15,122,88,.12);padding:3px 8px;border-radius:999px;">Ejecutada</span>
                                            }
                                            else if (hi.Id is not null && _canConfig)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm" title="Crear la actividad de compra con el proceso del origen" @onclick="() => EjecutarAsync(hi)" disabled="@_busy">Ejecutar</button>
                                            }
                                            @if (hi.TaskItemId is null)
                                            {
                                                <button class="btn btn-link btn-sm" style="color:#b91c1c;" @onclick="() => _pHijos.Remove(hi)">Quitar</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                @if (_dynDefsHija.Count > 0)
                                {
                                    <tr style="border-top:0;">
                                        <td colspan="8" style="padding:2px 10px 8px 10px;">
                                            @if (hi.Id is null)
                                            {
                                                <span style="font-size:11px;color:var(--ink-3,#6b7280);">Guarda la planificacion para capturar los campos propios de esta linea.</span>
                                            }
                                            else
                                            {
                                                <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;">
                                                    @foreach (var hd in _dynDefsHija)
                                                    {
                                                        var hdef = hd; var hid = hi.Id!.Value; var hv = DynHijoVal(hid, hdef.Id);
                                                        <div style="display:flex;align-items:center;gap:5px;">
                                                            <span style="font-size:11.5px;color:var(--ink-2,#374151);">@hdef.Label:</span>
                                                            @if (hdef.Type == "Bool")
                                                            {
                                                                <input type="checkbox" checked="@(hv == "true")" @onchange="e => SetHijoDynBoolAsync(hid, hdef.Id, e)" />
                                                            }
                                                            else if (hdef.Type == "Select")
                                                            {
                                                                <select class="req-dyn-in" @onchange="e => SetHijoDynValueAsync(hid, hdef.Id, e.Value?.ToString())">
                                                                    <option value="" selected="@string.IsNullOrEmpty(hv)">-</option>
                                                                    @foreach (var op in hdef.Options)
                                                                    {
                                                                        <option value="@op" selected="@(hv == op)">@op</option>
                                                                    }
                                                                </select>
                                                            }
                                                            else
                                                            {
                                                                <input type="@(hdef.Type == "Number" ? "number" : hdef.Type == "Date" ? "date" : "text")" step="any" class="req-dyn-in" value="@hv" @onchange="e => SetHijoDynValueAsync(hid, hdef.Id, e.Value?.ToString())" />
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <button class="btn btn-outline-secondary btn-sm" style="margin-top:10px;" @onclick="AddHijoRow">+ Agregar compra programada</button>
                @if (_planError is not null) { <div style="color:#b91c1c;font-size:12.5px;margin-top:8px;">@_planError</div> }
            </div>
            <div style="display:flex;gap:8px;align-items:center;justify-content:flex-end;padding:12px 18px;border-top:1px solid var(--line-2,#e5e7eb);">
                @if (_canConfig)
                {
                    <button class="btn btn-outline-primary btn-sm" style="margin-right:auto;" title="Crea la actividad de cotizacion de todas las lineas marcadas" @onclick="CotizarSeleccionadasAsync" disabled="@(_busy || SelCount == 0)">Cotizar seleccionadas@(SelCount > 0 ? $" ({SelCount})" : "")</button>
                }
                <button class="btn btn-primary btn-sm" @onclick="GuardarPlanAsync" disabled="@_busy">Guardar planificacion</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showPlan = false" disabled="@_busy">Cancelar</button>
            </div>
        </div>
    </div>
}

@* ---- Editor de contactos del proveedor (Ola 11) ---- *@
@if (_showContactos)
{
    <div style="position:fixed;inset:0;z-index:4200;background:rgba(15,23,42,.45);display:flex;align-items:flex-start;justify-content:center;padding:60px 16px;overflow:auto;" @onclick="CerrarContactosAsync">
        <div style="background:var(--surface,#fff);border-radius:12px;width:640px;max-width:95vw;box-shadow:0 20px 50px rgba(0,0,0,.25);" @onclick:stopPropagation="true">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line-2,#e5e7eb);">
                <strong style="font-size:14px;">Contactos de @_contactosProvNombre</strong>
                <button class="btn btn-link btn-sm" @onclick="CerrarContactosAsync">&times;</button>
            </div>
            <div style="padding:14px 18px;">
                <div style="overflow:auto;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;margin-bottom:12px;">
                    <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
                        <thead>
                            <tr style="background:var(--surface-2,#f8fafc);text-align:left;">
                                <th style="padding:7px 10px;">Nombre</th>
                                <th style="padding:7px 10px;">Cargo</th>
                                <th style="padding:7px 10px;">Correo</th>
                                <th style="padding:7px 10px;">Telefono</th>
                                <th style="padding:7px 10px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_contactosList.Count == 0)
                            {
                                <tr><td colspan="5" style="padding:12px;text-align:center;color:var(--ink-3,#6b7280);">Sin contactos. Agrega el primero abajo.</td></tr>
                            }
                            @foreach (var c in _contactosList)
                            {
                                var cc = c;
                                <tr style="border-top:1px solid var(--line,#f1f5f9);">
                                    <td style="padding:5px 10px;">@cc.Nombre</td>
                                    <td style="padding:5px 10px;">@cc.Cargo</td>
                                    <td style="padding:5px 10px;">@cc.Email</td>
                                    <td style="padding:5px 10px;">@cc.Telefono</td>
                                    <td style="padding:5px 10px;text-align:right;white-space:nowrap;">
                                        <button class="btn btn-link btn-sm" @onclick="() => EditarContacto(cc)" disabled="@_busy">Editar</button>
                                        <button class="btn btn-link btn-sm" style="color:#b91c1c;" @onclick="() => EliminarContactoUiAsync(cc.Id)" disabled="@_busy">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="font-size:12px;font-weight:600;margin-bottom:6px;">@(_cEditId is null ? "Nuevo contacto" : "Editar contacto")</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <input style="flex:1;min-width:150px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" placeholder="Nombre *" @bind="_cNombre" />
                    <input style="flex:1;min-width:120px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" placeholder="Cargo" @bind="_cCargo" />
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
                    <input style="flex:1;min-width:150px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" placeholder="Correo" @bind="_cEmail" />
                    <input style="flex:1;min-width:120px;height:30px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:6px;" placeholder="Telefono" @bind="_cTel" />
                </div>
                @if (_contactosError is not null) { <div style="color:#b91c1c;font-size:12.5px;margin-top:8px;">@_contactosError</div> }
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 18px;border-top:1px solid var(--line-2,#e5e7eb);">
                @if (_cEditId is not null)
                {
                    <button class="btn btn-link btn-sm" style="margin-right:auto;" @onclick="ClearContactoForm" disabled="@_busy">Cancelar edicion</button>
                }
                <button class="btn btn-primary btn-sm" @onclick="GuardarContactoUiAsync" disabled="@_busy">@(_cEditId is null ? "Agregar contacto" : "Guardar cambios")</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarContactosAsync" disabled="@_busy">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ---- Configuracion de campos propios (dinamicos) (Ola 12) ---- *@
@if (_showCampos)
{
    <div class="cd-doc-backdrop" @onclick="CerrarCamposAsync"></div>
    <div class="cd-rules-modal" style="width:min(820px,96vw);height:min(640px,86vh);" @onclick:stopPropagation="true">
        <div class="cd-doc-head">
            <div class="cd-doc-title">
                <div class="cd-doc-title-main">Campos de la tabla</div>
                <div class="cd-doc-title-sub">Campos a medida: en la NECESIDAD (columnas de la grilla) y en la LINEA de planificacion.</div>
            </div>
            <button class="cd-doc-close" title="Cerrar" @onclick="CerrarCamposAsync">&times;</button>
        </div>
        <div class="cd-fields-body">
            @* ---- Izquierda: lista de campos por ambito ---- *@
            <div class="cd-fields-list">
                <div class="cd-fields-sec">Necesidad (columnas de la grilla)</div>
                <button class="cd-fb-add" style="width:100%;margin-bottom:8px;" @onclick="@(() => AddCampoAsync("Padre"))">+ Campo</button>
                @{ var padres = _fieldEditList.Where(f => f.Scope == "Padre").ToList(); }
                @if (padres.Count == 0) { <div class="cd-muted" style="padding:2px 2px 8px;">Sin campos.</div> }
                @foreach (var fe in padres)
                {
                    var f = fe; var pos = padres.IndexOf(fe);
                    <div class="cd-field-item @(fe.Id == _selFieldId ? "sel" : "")" @onclick="() => SelectCampo(f)">
                        <span class="cd-field-ord">@(pos + 1)</span>
                        <div class="cd-field-meta">
                            <div class="cd-field-name">@(string.IsNullOrWhiteSpace(fe.Label) ? "(sin nombre)" : fe.Label)@if (fe.Dirty) { <span class="cd-field-dot" title="Cambios sin guardar">&#9679;</span> }</div>
                            <div class="cd-field-type">@TipoLabel(fe.Type)</div>
                        </div>
                        <div class="cd-field-acts" @onclick:stopPropagation="true">
                            <button class="cd-ic" @onclick="() => MoveCampoAsync(f, -1)" disabled="@(pos == 0)" title="Subir">&#8593;</button>
                            <button class="cd-ic" @onclick="() => MoveCampoAsync(f, 1)" disabled="@(pos == padres.Count - 1)" title="Bajar">&#8595;</button>
                            <button class="cd-ic cd-ic-del" @onclick="() => BorrarCampoAsync(f)" title="Eliminar">&times;</button>
                        </div>
                    </div>
                }

                <div class="cd-fields-sec">Linea de planificacion (en Planificar)</div>
                <button class="cd-fb-add" style="width:100%;margin-bottom:8px;" @onclick="@(() => AddCampoAsync("Hija"))">+ Campo</button>
                @{ var hijas = _fieldEditList.Where(f => f.Scope == "Hija").ToList(); }
                @if (hijas.Count == 0) { <div class="cd-muted" style="padding:2px 2px 8px;">Sin campos.</div> }
                @foreach (var fe in hijas)
                {
                    var f = fe; var pos = hijas.IndexOf(fe);
                    <div class="cd-field-item @(fe.Id == _selFieldId ? "sel" : "")" @onclick="() => SelectCampo(f)">
                        <span class="cd-field-ord">@(pos + 1)</span>
                        <div class="cd-field-meta">
                            <div class="cd-field-name">@(string.IsNullOrWhiteSpace(fe.Label) ? "(sin nombre)" : fe.Label)@if (fe.Dirty) { <span class="cd-field-dot" title="Cambios sin guardar">&#9679;</span> }</div>
                            <div class="cd-field-type">@TipoLabel(fe.Type)</div>
                        </div>
                        <div class="cd-field-acts" @onclick:stopPropagation="true">
                            <button class="cd-ic" @onclick="() => MoveCampoAsync(f, -1)" disabled="@(pos == 0)" title="Subir">&#8593;</button>
                            <button class="cd-ic" @onclick="() => MoveCampoAsync(f, 1)" disabled="@(pos == hijas.Count - 1)" title="Bajar">&#8595;</button>
                            <button class="cd-ic cd-ic-del" @onclick="() => BorrarCampoAsync(f)" title="Eliminar">&times;</button>
                        </div>
                    </div>
                }
            </div>
            @* ---- Derecha: panel de configuracion del campo seleccionado ---- *@
            <div class="cd-field-cfg">
                @if (SelField is { } sf)
                {
                    <div class="cd-cfg-title">@(string.IsNullOrWhiteSpace(sf.Label) ? "Nuevo campo" : "Editar campo") <span class="cd-sys-badge">@(sf.Scope == "Hija" ? "LINEA" : "NECESIDAD")</span></div>
                    <div class="cd-cfg-row">
                        <label class="cd-cfg-lbl">Etiqueta</label>
                        <input class="cd-in" value="@sf.Label" @onchange="e => SetCampoLabel(sf, e)" placeholder="Nombre de la columna" />
                    </div>
                    <div class="cd-cfg-row">
                        <label class="cd-cfg-lbl">Tipo</label>
                        <select class="cd-in" @onchange="e => SetCampoType(sf, e)">
                            @foreach (var t in _tiposCampo)
                            {
                                <option value="@t.Key" selected="@(t.Key == sf.Type)">@t.Label</option>
                            }
                        </select>
                    </div>
                    @if (sf.Type == "Select")
                    {
                        <div class="cd-cfg-row">
                            <label class="cd-cfg-lbl">Opciones (separadas por coma)</label>
                            <input class="cd-in" value="@sf.OptionsText" @onchange="e => SetCampoOptions(sf, e)" placeholder="Ej: Alta, Media, Baja" />
                        </div>
                    }
                    <div class="cd-cfg-row">
                        <label class="cd-cfg-lbl">Descripcion (opcional)</label>
                        <input class="cd-in" value="@sf.Description" @onchange="e => SetCampoDescription(sf, e)" placeholder="Se muestra como tooltip en el encabezado" />
                    </div>
                    @if (sf.Scope == "Padre")
                    {
                        <label class="cd-cfg-check">
                            <input type="checkbox" checked="@sf.ShowInFilter" @onchange="e => SetCampoShowInFilter(sf, e)" />
                            Ofrecer como filtro en el listado
                        </label>
                    }
                    @if (_camposError is not null) { <div class="cd-cfg-hint" style="color:#b91c1c;">@_camposError</div> }
                    <div class="cd-cfg-actions">
                        <button class="cd-ic-save @(sf.Dirty ? "on" : "")" @onclick="() => GuardarCampoAsync(sf)" disabled="@(!sf.Dirty || _busy)">Guardar</button>
                    </div>
                }
                else
                {
                    <div class="cd-cfg-empty">Elige un campo de la lista para editarlo, o crea uno con &ldquo;+ Campo&rdquo;.</div>
                }
            </div>
        </div>
        <div class="cd-rules-foot">
            <span class="cd-muted">Los campos de la necesidad aparecen como columnas al final de la tabla.</span>
            <div style="flex:1"></div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarCamposAsync">Cerrar</button>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _busy;
    private string? _msg;
    private List<RequerimientoDto> _rows = new();
    private List<RequerimientoOpcionDto> _origenes = new();
    private List<ItemOpcionDto> _items = new();
    private bool _canConfig;
    private string? _userName;

    // Alta manual
    private bool _showAlta;
    private string? _altaError;
    private string _aOrigen = "";
    private string _aItem = "";
    private string _aDescripcion = "";
    private decimal _aCantidad = 1;
    private string _aUnidad = "";
    private string _aArea = "";
    private DateTime? _aFecha;

    // Expansion de distribuciones (hijos) por fila (transitorio, no se persiste).
    private HashSet<Guid> _expanded = new();

    // ---- Planificacion (division en hijos) ----
    private bool _showPlan;
    private string? _planError;
    private Guid _planReqId;
    private string _planProducto = "";
    private string _planDescripcion = "";   // descripcion cruda del padre (para emparejar historico de precio)
    private decimal _planCantidadPadre;
    private Guid? _planItemId;
    private List<RequerimientoOpcionDto> _proveedores = new();
    private sealed class HijoEdit
    {
        public Guid? Id;
        public decimal Cantidad = 1;
        public DateTime? Fecha;
        public string Despacho = "";
        public string Entrega = "";
        public string Prov = "";           // id del proveedor (Tercero)
        public string ProvNombre = "";      // nombre visible en el autocompletado
        public string? Contacto;            // nombre del contacto del proveedor
        public string? Email;
        public string? Telefono;
        public decimal Precio;
        public Guid? TaskItemId;
        public Guid? CotizacionTaskItemId;
        public RequerimientoEstado Estado = RequerimientoEstado.Planificado;
        public bool Sel;                       // marcada para "Cotizar seleccionadas" (Ola 10)
        public decimal? UltimoPrecio;          // ultimo precio del historico para este producto+proveedor
        public DateTimeOffset? UltimoPrecioFecha;
        public Guid? ContactoId;               // contacto especifico elegido (Ola 11); null = el primero
        public List<ProveedorContactoItemDto> ContactosDisponibles = new();
    }
    private static HijoEdit MapHijo(RequerimientoHijoDto h) => new()
    {
        Id = h.Id,
        Cantidad = h.Cantidad,
        Fecha = h.FechaProgramadaCompra?.DateTime,
        Despacho = h.CaracteristicasDespacho,
        Entrega = h.TiempoEntrega,
        Prov = h.ProveedorId?.ToString() ?? "",
        ProvNombre = h.ProveedorNombre ?? "",
        Precio = h.PrecioUnitario,
        TaskItemId = h.TaskItemId,
        CotizacionTaskItemId = h.CotizacionTaskItemId,
        Estado = h.Estado,
        ContactoId = h.ProveedorContactoId,
    };
    private List<HijoEdit> _pHijos = new();

    // ---- Editor de contactos del proveedor (Ola 11) ----
    private bool _showContactos;
    private string _contactosProvId = "";
    private string _contactosProvNombre = "";
    private List<ProveedorContactoItemDto> _contactosList = new();
    private string? _contactosError;
    private Guid? _cEditId;
    private string _cNombre = "", _cCargo = "", _cEmail = "", _cTel = "";

    private decimal PlanificadaActual => _pHijos.Sum(h => h.Cantidad);
    private decimal RestanteActual => _planCantidadPadre - PlanificadaActual;

    // ---- Constructor de filtros (arbol AND/OR anidado; se evalua en cliente) ----
    private const string FilterModule = "RequerimientosCompra";
    private FilterNode _filterRoot = FilterNode.NewGroup("and");
    private bool _filterOpen;
    private string? _saveName;
    private string? _activeFilterName;
    private List<SavedFilterDto> _savedFilters = new();
    private int FilterCount => RequerimientoFilter.CountConditions(_filterRoot, FilterExtraFields());

    // Campos dinamicos (ambito Padre) ofrecidos como filtro -> FilterField con clave "dyn:{defId}".
    private List<FilterField> FilterExtraFields()
        => _dynDefsPadre.Where(d => d.ShowInFilter)
            .Select(d => new FilterField("dyn:" + d.Id, d.Label, RequerimientoFilter.MapDynFilterType(d.Type))).ToList();

    // Resolver del valor de un campo dinamico para una fila (clave "dyn:{defId}").
    private string? DynFilterValue(RequerimientoDto r, string key)
        => DynDefByKey(key) is { } d ? DynVal(r.Id, d.Id) : "";

    // ======================= MOTOR DE TABLA =======================
    private const string TableKey = "requerimientos-compra";

    private sealed record GridCol(string Key, string Label, bool Num, bool Groupable);

    private static readonly GridCol[] _allCols =
    {
        new("producto", "Producto", false, true),
        new("area", "Area", false, true),
        new("origen", "Origen", false, true),
        new("solicitante", "Solicitante", false, true),
        new("actividad", "Actividad", false, true),
        new("estado", "Estado", false, true),
        new("proveedor", "Proveedor", false, true),
        new("cantidad", "Cantidad", true, false),
        new("unidad", "Unidad", false, true),
        new("precio", "Precio unit.", true, false),
        new("monto", "Monto", true, false),
        new("fecha", "Fecha necesidad", false, true),
        new("hijos", "Distrib.", false, false),
        new("acciones", "Acciones", false, false),
    };

    private sealed class SortSpec { public string K { get; set; } = ""; public int Dir { get; set; } = 1; }

    private List<string> _order = _allCols.Select(c => c.Key).ToList();
    private HashSet<string> _hidden = new();
    private Dictionary<string, int> _widths = new();
    private List<SortSpec> _sorts = new();
    // Agrupar es ortogonal y por defecto va vacio: la vista CONSOLIDADA (ver _consolidate) ya entrega
    // una sola linea por producto sumada. Si el usuario guardo una preferencia, esa gana (LoadPrefsAsync).
    private List<string> _groups = new();
    private int _frozen;
    // Vista CONSOLIDADA (solo presentacion): junta las necesidades del MISMO producto en una sola linea
    // que suma cantidad/monto; al expandir se ven las necesidades reales intactas (cada una con su
    // origen/tarea y su propio Planificar). Default ON; es preferencia por usuario (toggle "Consolidar").
    private bool _consolidate = true;
    private readonly HashSet<string> _consolExpanded = new();
    // Vista "por proveedor": cuando se agrupa por "proveedor" (que vive en la linea hija), la grilla se
    // aplana a las lineas de planificacion y se agrupa por proveedor con subtotales.
    private bool ByProvider => _groups.Contains("proveedor");

    private string? _dragCol;
    private string? _openMenu;

    // ---- Campos dinamicos (Ola 12): definiciones por ambito + columnas de la grilla (Padre) + valores (EAV) ----
    private List<RequerimientoFieldDefDto> _dynDefsPadre = new();
    private List<RequerimientoFieldDefDto> _dynDefsHija = new();
    private List<GridCol> _dynCols = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _dynValues = new();   // reqId -> defId -> valor

    // Valores de campos dinamicos de las lineas (hijas) abiertas en el modal: hijoId -> defId -> valor.
    private Dictionary<Guid, Dictionary<Guid, string?>> _dynHijoValues = new();
    private string? DynHijoVal(Guid hijoId, Guid defId)
        => _dynHijoValues.TryGetValue(hijoId, out var d) && d.TryGetValue(defId, out var v) ? v : null;

    // Config de campos propios (modal, estilo Conciliacion DIAN)
    private bool _showCampos;
    private string? _camposError;
    private sealed class FieldEdit
    {
        public Guid Id;
        public string FieldKey = "";
        public string Label = "";
        public string Scope = "Padre";
        public string Type = "Text";
        public int SortOrder;
        public string OptionsText = "";   // Select: opciones separadas por coma
        public string Description = "";
        public bool ShowInFilter = true;
        public bool Dirty;
    }
    private List<FieldEdit> _fieldEditList = new();
    private Guid _selFieldId;
    private FieldEdit? SelField => _fieldEditList.FirstOrDefault(f => f.Id == _selFieldId);
    private void SelectCampo(FieldEdit fe) => _selFieldId = fe.Id;
    private static readonly (string Key, string Label)[] _tiposCampo =
    {
        ("Text", "Texto"), ("Number", "Numero"), ("Date", "Fecha"),
        ("Bool", "Si/No"), ("Select", "Lista"), ("Url", "Enlace (URL)"),
    };

    private IEnumerable<GridCol> AllCols => _allCols.Concat(_dynCols);
    private void BuildDynCols() => _dynCols = _dynDefsPadre
        .Select(d => new GridCol("dyn:" + d.Id, d.Label, d.Type == "Number", true)).ToList();
    private static bool IsDynKey(string k) => k.StartsWith("dyn:", StringComparison.Ordinal);
    private RequerimientoFieldDefDto? DynDefByKey(string k)
        => IsDynKey(k) && Guid.TryParse(k.AsSpan(4), out var id) ? _dynDefsPadre.FirstOrDefault(d => d.Id == id) : null;
    private string? DynVal(Guid reqId, Guid defId)
        => _dynValues.TryGetValue(reqId, out var d) && d.TryGetValue(defId, out var v) ? v : null;

    private GridCol? ColByKey(string k) => AllCols.FirstOrDefault(c => c.Key == k);
    private IEnumerable<GridCol> VisibleCols() => _order.Select(ColByKey).Where(c => c is not null && !_hidden.Contains(c!.Key)).Select(c => c!);
    private int ColSpanAll => 1 + VisibleCols().Count();

    private static readonly string[] _sumKeys = { "cantidad", "monto" };

    private enum GKind { Group, Data, Child, Subtotal, ProvRow, Consol }
    private sealed class GridItem
    {
        public GKind Kind;
        public int Level;
        public string? Label;
        public int Count;
        public RequerimientoDto? R;
        public RequerimientoHijoDto? H;
        public Dictionary<string, decimal>? Sums;
        public bool Grand;
        // Solo para GKind.Consol: la clave de consolidacion (producto) y las necesidades reales que agrupa.
        public string? Key;
        public List<RequerimientoDto>? Group;
    }
    private List<GridItem> _gridItems = new();

    private static decimal SumVal(string key, RequerimientoDto r) => key switch
    {
        "cantidad" => r.Cantidad,
        "monto" => r.MontoTotal,
        _ => 0m,
    };

    private string GroupText(string key, RequerimientoDto r)
    {
        if (IsDynKey(key)) { var dv = DynDefByKey(key) is { } dd ? DynVal(r.Id, dd.Id) : null; return string.IsNullOrWhiteSpace(dv) ? "(sin dato)" : dv!; }
        var v = key switch
        {
            "producto" => r.ItemNombre ?? r.Descripcion,
            "area" => r.Area,
            "origen" => r.OrigenNombre ?? "",
            "solicitante" => r.SolicitanteNombre ?? "",
            "actividad" => r.SourceTaskNumber ?? "",
            "unidad" => r.UnidadMedida,
            "estado" => RequerimientoFilter.EstadoLabel(r.Estado),
            "fecha" => r.FechaNecesidad?.ToString("dd/MM/yyyy") ?? "",
            _ => "",
        };
        return string.IsNullOrWhiteSpace(v) ? "(sin dato)" : v;
    }

    // Texto crudo por columna para una FILA PADRE (export): como GroupText pero sin "(sin dato)".
    private string CellStr(string key, RequerimientoDto r)
    {
        if (IsDynKey(key)) { return (DynDefByKey(key) is { } dd ? DynVal(r.Id, dd.Id) : null) ?? ""; }
        return key switch
        {
            "producto" => (r.ItemNombre ?? r.Descripcion) + (string.IsNullOrWhiteSpace(r.ItemSku) ? "" : $" ({r.ItemSku})"),
            "area" => r.Area,
            "origen" => r.OrigenNombre ?? "",
            "solicitante" => r.SolicitanteNombre ?? "",
            "actividad" => r.SourceTaskNumber ?? "",
            "unidad" => r.UnidadMedida,
            "estado" => RequerimientoFilter.EstadoLabel(r.Estado),
            "proveedor" => "",
            "fecha" => r.FechaNecesidad?.ToString("dd/MM/yyyy") ?? "",
            "cantidad" => Fmt(r.Cantidad),
            "precio" => "",
            "monto" => r.MontoTotal > 0 ? Fmt(r.MontoTotal) : "",
            "hijos" => r.CantidadHijos > 0 ? r.CantidadHijos.ToString() : "",
            _ => "",
        };
    }

    // Texto crudo por columna para una FILA HIJA (export).
    private static string ChildStr(string key, RequerimientoDto parent, RequerimientoHijoDto h) => key switch
    {
        "producto" => "  ↳ " + (string.IsNullOrWhiteSpace(h.CaracteristicasDespacho) ? "Distribucion" : h.CaracteristicasDespacho),
        "unidad" => parent.UnidadMedida,
        "proveedor" => h.ProveedorNombre ?? "(sin proveedor)",
        "estado" => RequerimientoFilter.EstadoLabel(h.Estado) + (h.TaskItemId is not null ? " (Ejecutada)" : ""),
        "fecha" => h.FechaProgramadaCompra?.ToString("dd/MM/yyyy") ?? "",
        "cantidad" => Fmt(h.Cantidad),
        "precio" => h.PrecioUnitario > 0 ? Fmt(h.PrecioUnitario) : "",
        "monto" => h.Total > 0 ? Fmt(h.Total) : "",
        _ => "",
    };

    private sealed class ObjCmp : IComparer<object?>
    {
        public static readonly ObjCmp I = new();
        public int Compare(object? a, object? b)
        {
            if (a is decimal da && b is decimal db) { return da.CompareTo(db); }
            if (a is DateTimeOffset ta && b is DateTimeOffset tb) { return ta.CompareTo(tb); }
            return string.Compare(a?.ToString(), b?.ToString(), StringComparison.OrdinalIgnoreCase);
        }
    }

    private object SortKey(string key, RequerimientoDto r) => key switch
    {
        "cantidad" => r.Cantidad,
        "monto" => r.MontoTotal,
        "precio" => 0m,
        "hijos" => (decimal)r.CantidadHijos,
        "fecha" => r.FechaNecesidad ?? DateTimeOffset.MinValue,
        _ => GroupText(key, r),
    };

    private IEnumerable<RequerimientoDto> Sorted(IEnumerable<RequerimientoDto> src)
    {
        if (_sorts.Count == 0) { return src; }
        IOrderedEnumerable<RequerimientoDto>? o = null;
        foreach (var s in _sorts)
        {
            var sc = s;
            Func<RequerimientoDto, object> ks = r => SortKey(sc.K, r);
            o = o is null
                ? (sc.Dir >= 0 ? src.OrderBy(ks, ObjCmp.I) : src.OrderByDescending(ks, ObjCmp.I))
                : (sc.Dir >= 0 ? o.ThenBy(ks, ObjCmp.I) : o.ThenByDescending(ks, ObjCmp.I));
        }
        return o!;
    }

    private static Dictionary<string, decimal> SumsOf(IEnumerable<RequerimientoDto> rows)
    {
        var d = new Dictionary<string, decimal>();
        var list = rows as IList<RequerimientoDto> ?? rows.ToList();
        foreach (var k in _sumKeys) { d[k] = list.Sum(r => SumVal(k, r)); }
        return d;
    }

    // Clave de consolidacion: por ItemId cuando existe; si no, por la descripcion normalizada del padre.
    private static string ConsolKey(RequerimientoDto r)
        => r.ItemId is { } id
            ? "i:" + id
            : "d:" + string.Join(' ', (r.Descripcion ?? "").Trim().ToLowerInvariant().Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    // Grupos efectivos para la recursion: al consolidar quitamos "producto" (la consolidacion ya agrupa
    // por producto), para no pintar una cabecera de grupo redundante encima de cada linea consolidada.
    private List<string> EffectiveGroups() => _consolidate ? _groups.Where(g => g != "producto").ToList() : _groups;

    // Emite la fila padre (Data) y, si corresponde, sus distribuciones (hijos).
    private void EmitData(RequerimientoDto r, List<GridItem> outl, bool expandChildren)
    {
        outl.Add(new GridItem { Kind = GKind.Data, R = r });
        if ((expandChildren || _expanded.Contains(r.Id)) && r.Hijos.Count > 0)
        {
            foreach (var h in r.Hijos) { outl.Add(new GridItem { Kind = GKind.Child, R = r, H = h }); }
        }
    }

    // Construye los items renderizables. expandChildren=true mete SIEMPRE las filas hijas (export);
    // si es false, solo mete las hijas de las compras expandidas en la vista. consolidate=true junta
    // las necesidades del mismo producto en una linea resumen (GKind.Consol) expandible.
    private void BuildItems(List<RequerimientoDto> rows, int level, List<GridItem> outl, bool expandChildren, List<string> groups, bool consolidate)
    {
        if (level >= groups.Count)
        {
            if (consolidate)
            {
                var prodGroups = rows.GroupBy(ConsolKey)
                    .OrderBy(g => g.First().ItemNombre ?? g.First().Descripcion, StringComparer.OrdinalIgnoreCase);
                foreach (var pg in prodGroups)
                {
                    var glist = Sorted(pg).ToList();
                    if (glist.Count == 1)
                    {
                        // Un solo pedido del producto: no tiene sentido una linea resumen, va como fila normal.
                        EmitData(glist[0], outl, expandChildren);
                    }
                    else
                    {
                        outl.Add(new GridItem { Kind = GKind.Consol, Key = pg.Key, Group = glist, Count = glist.Count, Sums = SumsOf(glist) });
                        if (expandChildren || _consolExpanded.Contains(pg.Key))
                        {
                            foreach (var r in glist) { EmitData(r, outl, expandChildren); }
                        }
                    }
                }
            }
            else
            {
                foreach (var r in Sorted(rows)) { EmitData(r, outl, expandChildren); }
            }
            return;
        }
        var key = groups[level];
        var label = ColByKey(key)?.Label ?? key;
        var grps = rows.GroupBy(r => GroupText(key, r)).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
        foreach (var g in grps)
        {
            var glist = g.ToList();
            outl.Add(new GridItem { Kind = GKind.Group, Level = level, Label = $"{label}: {g.Key}", Count = glist.Count });
            BuildItems(glist, level + 1, outl, expandChildren, groups, consolidate);
            outl.Add(new GridItem { Kind = GKind.Subtotal, Level = level, Count = glist.Count, Sums = SumsOf(glist), Grand = false });
        }
    }

    // Valor a mostrar en una celda de la linea consolidada para columnas que pueden diferir entre
    // necesidades: si todas coinciden muestra el valor; si no, "Varias (N)" con el detalle en el tooltip.
    private (string Text, string? Tip) ConsolCell(string key, List<RequerimientoDto> glist)
    {
        var vals = glist.Select(r => CellStr(key, r)?.Trim() ?? "")
            .Where(s => s.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (vals.Count == 0) { return ("-", null); }
        if (vals.Count == 1) { return (vals[0], null); }
        var tip = string.Join(", ", vals.Take(8)) + (vals.Count > 8 ? "..." : "");
        return ($"Varias ({vals.Count})", tip);
    }

    private List<RequerimientoDto> FilteredRows() => FilterCount > 0
        ? _rows.Where(r => RequerimientoFilter.Evaluate(_filterRoot, r, FilterExtraFields(), DynFilterValue)).ToList()
        : _rows.ToList();

    private void RebuildItems()
    {
        var items = new List<GridItem>();
        if (ByProvider)
        {
            BuildProviderItems(items);
        }
        else
        {
            var src = FilteredRows();
            BuildItems(src, 0, items, expandChildren: false, groups: EffectiveGroups(), consolidate: _consolidate);
            if (src.Count > 0)
            {
                items.Add(new GridItem { Kind = GKind.Subtotal, Count = src.Count, Sums = SumsOf(src), Grand = true });
            }
        }
        _gridItems = items;
    }

    // Vista por proveedor: una fila por linea hija (planificacion), agrupada por proveedor,
    // con subtotales de cantidad y monto por proveedor. Respeta el filtro actual.
    private void BuildProviderItems(List<GridItem> outl)
    {
        var flat = new List<(RequerimientoDto Parent, RequerimientoHijoDto H)>();
        foreach (var r in FilteredRows())
        {
            foreach (var h in r.Hijos) { flat.Add((r, h)); }
        }
        if (flat.Count == 0) { return; }
        var groups = flat
            .GroupBy(x => string.IsNullOrWhiteSpace(x.H.ProveedorNombre) ? "(sin proveedor)" : x.H.ProveedorNombre!)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
        decimal gc = 0m, gm = 0m;
        foreach (var g in groups)
        {
            var glist = g.ToList();
            outl.Add(new GridItem { Kind = GKind.Group, Level = 0, Label = $"Proveedor: {g.Key}", Count = glist.Count });
            foreach (var x in glist.OrderBy(x => x.Parent.ItemNombre ?? x.Parent.Descripcion, StringComparer.OrdinalIgnoreCase))
            {
                outl.Add(new GridItem { Kind = GKind.ProvRow, R = x.Parent, H = x.H });
            }
            var cant = glist.Sum(x => x.H.Cantidad);
            var monto = glist.Sum(x => x.H.Total);
            outl.Add(new GridItem
            {
                Kind = GKind.Subtotal, Level = 0, Count = glist.Count,
                Sums = new Dictionary<string, decimal> { ["cantidad"] = cant, ["monto"] = monto },
            });
            gc += cant; gm += monto;
        }
        outl.Add(new GridItem
        {
            Kind = GKind.Subtotal, Count = flat.Count,
            Sums = new Dictionary<string, decimal> { ["cantidad"] = gc, ["monto"] = gm }, Grand = true,
        });
    }

    // ---- Consolidacion (vista) ----
    private void ToggleConsolidate()
    {
        _consolidate = !_consolidate;
        if (!_consolidate) { _consolExpanded.Clear(); }
        _ = SavePrefsAsync();
        RebuildItems();
    }
    private void ToggleConsol(string key)
    {
        if (!_consolExpanded.Remove(key)) { _consolExpanded.Add(key); }
        RebuildItems();
    }

    // ---- Expansion ----
    private void ToggleExpand(Guid id)
    {
        if (!_expanded.Remove(id)) { _expanded.Add(id); }
        RebuildItems();
    }
    private void ExpandAll()
    {
        _expanded = _rows.Where(r => r.CantidadHijos > 0).Select(r => r.Id).ToHashSet();
        // Al consolidar, "Expandir todo" tambien abre las lineas resumen para ver las necesidades reales.
        if (_consolidate)
        {
            _consolExpanded.Clear();
            foreach (var k in FilteredRows().GroupBy(ConsolKey).Where(g => g.Count() > 1).Select(g => g.Key))
            {
                _consolExpanded.Add(k);
            }
        }
        RebuildItems();
    }
    private void CollapseAll()
    {
        _expanded.Clear();
        _consolExpanded.Clear();
        RebuildItems();
    }

    protected override async Task OnInitializedAsync()
    {
        _canConfig = await IsOwnerOrAdminAsync();
        if (AuthState is not null)
        {
            try { var st = await AuthState; _userName = st.User.Identity?.Name; } catch { }
        }
        await LoadDynDefsAsync();   // antes de las prefs: las columnas dinamicas deben existir para el orden
        await LoadPrefsAsync();
        // Asegura que las columnas dinamicas esten en el orden aunque no hubiera prefs guardadas.
        foreach (var c in _dynCols) { if (!_order.Contains(c.Key)) { _order.Add(c.Key); } }
        await LoadSavedFiltersAsync();
        _origenes = (await Svc.ListOrigenesActivosAsync()).ToList();
        _items = (await Svc.ListItemsAsync()).ToList();
        _proveedores = (await Svc.ListProveedoresAsync()).ToList();
        await ReloadAsync();
    }

    private async Task LoadDynDefsAsync()
    {
        try
        {
            var all = (await FieldSvc.ListDefsAsync()).ToList();
            _dynDefsPadre = all.Where(d => d.Scope == "Padre").ToList();
            _dynDefsHija = all.Where(d => d.Scope == "Hija").ToList();
            BuildDynCols();
        }
        catch { _dynDefsPadre = new(); _dynDefsHija = new(); _dynCols = new(); }
    }

    // Guarda el valor de un campo dinamico de una necesidad (padre) y actualiza el cache en memoria.
    private async Task SetDynValueAsync(Guid ownerId, Guid defId, string? value)
    {
        var v = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        try { await FieldSvc.SetValueAsync(ownerId, defId, v); }
        catch (Exception ex) { _msg = ex.Message; return; }
        if (!_dynValues.TryGetValue(ownerId, out var d)) { d = new(); _dynValues[ownerId] = d; }
        d[defId] = v;
    }

    private Task SetDynBoolAsync(Guid ownerId, Guid defId, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        return SetDynValueAsync(ownerId, defId, on ? "true" : null);
    }

    // ---- Config de campos propios (Ola 12, estilo Conciliacion DIAN) ----
    private static string TipoLabel(string type) => _tiposCampo.FirstOrDefault(t => t.Key == type).Label ?? type;

    private static List<string> ParseOptions(string text)
        => (text ?? "").Split(',').Select(o => o.Trim()).Where(o => o.Length > 0).ToList();

    private RequerimientoFieldDefDto ToDefDto(FieldEdit fe)
        => new(fe.Id, fe.FieldKey, fe.Label, fe.Scope, fe.Type, fe.SortOrder,
            ParseOptions(fe.OptionsText), string.IsNullOrWhiteSpace(fe.Description) ? null : fe.Description.Trim(), fe.ShowInFilter);

    private async Task OpenCamposAsync()
    {
        _camposError = null;
        var defs = (await FieldSvc.ListDefsAsync()).ToList();
        _fieldEditList = defs.Select(d => new FieldEdit
        {
            Id = d.Id, FieldKey = d.FieldKey, Label = d.Label, Scope = d.Scope, Type = d.Type, SortOrder = d.SortOrder,
            OptionsText = string.Join(", ", d.Options), Description = d.Description ?? "", ShowInFilter = d.ShowInFilter,
        }).ToList();
        _selFieldId = _fieldEditList.FirstOrDefault()?.Id ?? Guid.Empty;
        _showCampos = true;
    }

    private void SetCampoLabel(FieldEdit fe, ChangeEventArgs e) { fe.Label = e.Value?.ToString() ?? ""; fe.Dirty = true; }
    private void SetCampoType(FieldEdit fe, ChangeEventArgs e) { fe.Type = e.Value?.ToString() ?? "Text"; fe.Dirty = true; }
    private void SetCampoOptions(FieldEdit fe, ChangeEventArgs e) { fe.OptionsText = e.Value?.ToString() ?? ""; fe.Dirty = true; }
    private void SetCampoDescription(FieldEdit fe, ChangeEventArgs e) { fe.Description = e.Value?.ToString() ?? ""; fe.Dirty = true; }
    private void SetCampoShowInFilter(FieldEdit fe, ChangeEventArgs e) { fe.ShowInFilter = e.Value is bool b && b; fe.Dirty = true; }

    private async Task AddCampoAsync(string scope)
    {
        _camposError = null; _busy = true;
        try
        {
            var fe = new FieldEdit { Label = "Nuevo campo", Scope = scope, Type = "Text", SortOrder = _fieldEditList.Count(x => x.Scope == scope) };
            var saved = await FieldSvc.SaveDefAsync(ToDefDto(fe));
            if (saved is not null)
            {
                fe.Id = saved.Id; fe.FieldKey = saved.FieldKey;
                _fieldEditList.Add(fe); _selFieldId = fe.Id;
                await RefreshDynAsync();
            }
        }
        catch (Exception ex) { _camposError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task GuardarCampoAsync(FieldEdit fe)
    {
        if (string.IsNullOrWhiteSpace(fe.Label)) { _camposError = "La etiqueta es obligatoria."; return; }
        _camposError = null; _busy = true;
        try
        {
            var saved = await FieldSvc.SaveDefAsync(ToDefDto(fe));
            if (saved is not null) { fe.Id = saved.Id; fe.FieldKey = saved.FieldKey; fe.Dirty = false; await RefreshDynAsync(); }
        }
        catch (Exception ex) { _camposError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task BorrarCampoAsync(FieldEdit fe)
    {
        _camposError = null; _busy = true;
        try
        {
            await FieldSvc.DeleteDefAsync(fe.Id);
            _fieldEditList.Remove(fe);
            if (_selFieldId == fe.Id) { _selFieldId = _fieldEditList.FirstOrDefault()?.Id ?? Guid.Empty; }
            await PersistOrderAsync();
            await RefreshDynAsync();
        }
        catch (Exception ex) { _camposError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task MoveCampoAsync(FieldEdit fe, int dir)
    {
        var sameScope = _fieldEditList.Where(x => x.Scope == fe.Scope).ToList();
        var pos = sameScope.IndexOf(fe);
        var tgt = pos + dir;
        if (tgt < 0 || tgt >= sameScope.Count) { return; }
        var other = sameScope[tgt];
        var i1 = _fieldEditList.IndexOf(fe); var i2 = _fieldEditList.IndexOf(other);
        (_fieldEditList[i1], _fieldEditList[i2]) = (_fieldEditList[i2], _fieldEditList[i1]);
        await PersistOrderAsync();
        await RefreshDynAsync();
    }

    private async Task PersistOrderAsync()
        => await FieldSvc.ReorderDefsAsync(_fieldEditList.Select(x => x.Id).ToList());

    // Reconstruye columnas dinamicas + orden + valores para reflejar los cambios en la grilla (sin cerrar el modal).
    private async Task RefreshDynAsync()
    {
        await LoadDynDefsAsync();
        foreach (var c in _dynCols) { if (!_order.Contains(c.Key)) { _order.Add(c.Key); } }
        _order = _order.Where(k => !IsDynKey(k) || _dynCols.Any(c => c.Key == k)).ToList();
        if (_dynDefsPadre.Count > 0)
        {
            try { _dynValues = (await FieldSvc.GetValuesAsync(_rows.Select(r => r.Id).ToList())).ToDictionary(kv => kv.Key, kv => kv.Value); }
            catch { _dynValues = new(); }
        }
        else { _dynValues = new(); }
        await SavePrefsAsync();
        RebuildItems();
    }

    private void CerrarCamposAsync() { _showCampos = false; }

    private async Task ReloadAsync()
    {
        // Carga TODO (el filtrado fino lo hace el constructor en cliente).
        _rows = (await Svc.ListAsync(new RequerimientoFiltro())).ToList();
        // Valores de los campos dinamicos de las necesidades (padre) para la grilla.
        if (_dynDefsPadre.Count > 0)
        {
            try { _dynValues = (await FieldSvc.GetValuesAsync(_rows.Select(r => r.Id).ToList())).ToDictionary(kv => kv.Key, kv => kv.Value); }
            catch { _dynValues = new(); }
        }
        else { _dynValues = new(); }
        // Mantiene expandidas solo las que siguen existiendo.
        _expanded.IntersectWith(_rows.Select(r => r.Id).ToHashSet());
        RebuildItems();
        StateHasChanged();
    }

    // ---------- Exportaciones ----------
    private List<GridItem> BuildExportItems()
    {
        var src = FilteredRows();
        var items = new List<GridItem>();
        // Export: detalle completo (sin consolidar) y con los grupos reales, para que el Excel/CSV liste cada necesidad.
        BuildItems(src, 0, items, expandChildren: true, groups: _groups, consolidate: false); // SIEMPRE todos los hijos
        if (src.Count > 0)
        {
            items.Add(new GridItem { Kind = GKind.Subtotal, Count = src.Count, Sums = SumsOf(src), Grand = true });
        }
        return items;
    }

    private async Task ExportCsvAsync()
    {
        var vis = VisibleCols().Where(c => c.Key != "acciones").ToList();
        if (vis.Count == 0) { _msg = "No hay columnas visibles para exportar."; return; }
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(';', vis.Select(c => Csv(c.Label))));
        foreach (var it in BuildExportItems())
        {
            if (it.Kind == GKind.Group)
            {
                sb.AppendLine(Csv(it.Label ?? "") + string.Concat(Enumerable.Repeat(";", vis.Count - 1)));
            }
            else if (it.Kind == GKind.Data && it.R is { } r)
            {
                sb.AppendLine(string.Join(';', vis.Select(c => Csv(CellStr(c.Key, r)))));
            }
            else if (it.Kind == GKind.Child && it.R is { } pr && it.H is { } h)
            {
                sb.AppendLine(string.Join(';', vis.Select(c => Csv(ChildStr(c.Key, pr, h)))));
            }
            else if (it.Kind == GKind.Subtotal)
            {
                var labelPut = false;
                var cells = vis.Select(c =>
                {
                    if (c.Num && it.Sums!.TryGetValue(c.Key, out var sv)) { return Fmt(sv); }
                    if (!c.Num && !labelPut) { labelPut = true; return Csv((it.Grand ? "TOTAL GENERAL" : "Subtotal") + " · " + it.Count + " reg."); }
                    return "";
                });
                sb.AppendLine(string.Join(';', cells));
            }
        }
        var nombre = $"requerimientos-compra-{DateTime.Now:yyyyMMdd-HHmm}.csv";
