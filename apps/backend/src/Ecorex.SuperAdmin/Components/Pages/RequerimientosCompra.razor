    private async Task FijarHastaAsync(string key)
    {
        var vis = VisibleCols().ToList();
        var pos = vis.FindIndex(c => c.Key == key);
        CloseColMenu();
        if (pos < 0) { return; }
        _frozen = pos + 2;
        await SavePrefsAsync();
        await ApplyFreezeAsync();
    }
    private async Task ApplyFreezeAsync()
    {
        try { await JS.InvokeVoidAsync("ecorexCdCols.apply", _frozen); } catch { }
    }

    // ---- Redimensionar columnas (desde JS) ----
    private DotNetObjectReference<RequerimientosCompra>? _selfRef;

    [JSInvokable]
    public async Task OnColumnResized(string key, int width)
    {
        if (width <= 0) { _widths.Remove(key); } else { _widths[key] = width; }
        await SavePrefsAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { _selfRef = DotNetObjectReference.Create(this); }
        try
        {
            await JS.InvokeVoidAsync("ecorexCdCols.apply", _frozen);
            if (_selfRef is not null) { await JS.InvokeVoidAsync("ecorexCdCols.wireResize", _selfRef); }
        }
        catch { }
    }

    public ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static string Px(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture) + "px";

    // ======================= Alta / planificacion / acciones =======================
    private void OpenAlta()
    {
        _altaError = null;
        _aOrigen = ""; _aItem = ""; _aDescripcion = ""; _aCantidad = 1; _aUnidad = ""; _aArea = ""; _aFecha = null;
        _showAlta = true;
    }

    private async Task CrearAsync()
    {
        _altaError = null;
        _busy = true;
        try
        {
            var req = new CrearRequerimientoRequest(
                Guid.TryParse(_aOrigen, out var o) ? o : null,
                _aArea,
                Guid.TryParse(_aItem, out var i) ? i : null,
                _aDescripcion,
                _aCantidad,
                _aUnidad,
                _aFecha is { } d ? new DateTimeOffset(d, TimeSpan.Zero) : null);
            var saved = await Svc.CrearAsync(req);
            if (saved is null) { _altaError = "No se pudo crear."; return; }
            _showAlta = false;
            _msg = $"Necesidad '{saved.Descripcion}' creada.";
            await ReloadAsync();
        }
        catch (Exception ex) { _altaError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        _busy = true;
        try { await Svc.DeleteAsync(id); await ReloadAsync(); }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OpenPlanificarAsync(RequerimientoDto r)
    {
        _planError = null;
        _planReqId = r.Id;
        _planItemId = r.ItemId;
        _planDescripcion = r.Descripcion;
        var plan = await Svc.GetPlanificacionAsync(r.Id);
        _planProducto = plan?.Producto ?? r.Descripcion;
        _planCantidadPadre = plan?.CantidadPadre ?? r.Cantidad;
        _pHijos = (plan?.Hijos ?? new List<RequerimientoHijoDto>()).Select(MapHijo).ToList();
        _showPlan = true;
        // Trae el contacto (nombre/correo/telefono) de los proveedores ya asignados.
        foreach (var h in _pHijos) { await FillContactoAsync(h); }
    }

    private async Task FillContactoAsync(HijoEdit h)
    {
        if (Guid.TryParse(h.Prov, out var pid))
        {
            try
            {
                var c = await Svc.GetProveedorContactoAsync(pid);
                h.Contacto = c?.Contacto; h.Email = c?.Email; h.Telefono = c?.Telefono;
                if (c is not null && string.IsNullOrWhiteSpace(h.ProvNombre)) { h.ProvNombre = c.Nombre; }
            }
            catch { h.Contacto = null; h.Email = null; h.Telefono = null; }
            try
            {
                var up = await Svc.GetUltimoPrecioAsync(_planItemId, _planDescripcion, pid, _planReqId);
                h.UltimoPrecio = up?.Precio; h.UltimoPrecioFecha = up?.Fecha;
            }
            catch { h.UltimoPrecio = null; h.UltimoPrecioFecha = null; }
        }
        else { h.Contacto = null; h.Email = null; h.Telefono = null; h.UltimoPrecio = null; h.UltimoPrecioFecha = null; }
    }

    private async Task OnProvChanged(HijoEdit h, ChangeEventArgs e)
    {
        var txt = (e.Value?.ToString() ?? "").Trim();
        h.ProvNombre = txt;
        var match = _proveedores.FirstOrDefault(p => string.Equals(p.Nombre, txt, StringComparison.OrdinalIgnoreCase));
        if (match is not null)
        {
            h.Prov = match.Id.ToString();
            await FillContactoAsync(h);
        }
        else
        {
            // Texto que no corresponde a un proveedor del Directorio: se deja sin proveedor.
            h.Prov = ""; h.Contacto = null; h.Email = null; h.Telefono = null;
        }
    }

    private void AddHijoRow()
    {
        var resta = RestanteActual;
        _pHijos.Add(new HijoEdit { Cantidad = resta > 0 ? resta : 1 });
    }

    private async Task GuardarPlanAsync()
    {
        _planError = null;
        _busy = true;
        try
        {
            var req = new GuardarHijosRequest(_planReqId, _pHijos.Select(h => new HijoInput(
                h.Id, h.Cantidad,
                h.Fecha is { } d ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null,
                h.Despacho, h.Entrega,
                Guid.TryParse(h.Prov, out var pv) ? pv : null,
                h.Precio)).ToList());
            var plan = await Svc.GuardarHijosAsync(req);
            if (plan is null) { _planError = "No se pudo guardar."; return; }
            _showPlan = false;
            _msg = $"Planificacion guardada: {plan.Hijos.Count} division(es), sin planificar {Fmt(plan.CantidadSinPlanificar)}.";
            await ReloadAsync();
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SugerirAsync(HijoEdit h)
    {
        if (_planItemId is not Guid itemId) { return; }
        _busy = true;
        try
        {
            var sug = await Svc.SugerirProveedorAsync(itemId);
            if (sug is null) { _planError = "La matriz no tiene un proveedor para este producto."; }
            else { h.Prov = sug.Id.ToString(); h.ProvNombre = sug.Nombre; await FillContactoAsync(h); _planError = null; }
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EjecutarAsync(HijoEdit h)
    {
        if (h.Id is not Guid hid) { return; }
        _planError = null;
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var actorName = await ActorNameAsync();
            var res = await Svc.EjecutarHijoAsync(hid, actor, actorName);
            if (!res.Ok) { _planError = res.Error ?? "No se pudo ejecutar la compra."; }
            else
            {
                _msg = res.TaskNumber is { } num
                    ? $"Compra ejecutada: actividad {num} creada."
                    : "Compra ejecutada: actividad creada.";
            }
            if (res.Plan is { } plan)
            {
                _planProducto = plan.Producto;
                _planCantidadPadre = plan.CantidadPadre;
                _pHijos = plan.Hijos.Select(MapHijo).ToList();
                foreach (var hh in _pHijos) { await FillContactoAsync(hh); }
            }
            await ReloadAsync();
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

    // Cantidad de lineas marcadas que todavia se pueden cotizar.
    private int SelCount => _pHijos.Count(h => h.Sel && h.Id is not null && h.CotizacionTaskItemId is null);

    private void UsarUltimoPrecio(HijoEdit h)
    {
        if (h.UltimoPrecio is { } up && up > 0) { h.Precio = up; StateHasChanged(); }
    }

    private async Task CotizarSeleccionadasAsync()
    {
        var ids = _pHijos.Where(h => h.Sel && h.Id is Guid && h.CotizacionTaskItemId is null).Select(h => h.Id!.Value).ToList();
        if (ids.Count == 0) { _planError = "Marca al menos una linea para cotizar."; return; }
        _planError = null; _busy = true;
        var nums = new List<string>();
        try
        {
            var actor = await ActorAsync();
            var actorName = await ActorNameAsync();
            foreach (var id in ids)
            {
                var res = await Svc.CotizarHijoAsync(id, actor, actorName);
                if (!res.Ok) { _planError = res.Error ?? "No se pudo crear una cotizacion."; break; }
                if (res.TaskNumber is { } n) { nums.Add(n); }
            }
            var plan = await Svc.GetPlanificacionAsync(_planReqId);
            if (plan is not null)
            {
                _planProducto = plan.Producto;
                _planCantidadPadre = plan.CantidadPadre;
                _pHijos = plan.Hijos.Select(MapHijo).ToList();
                foreach (var hh in _pHijos) { await FillContactoAsync(hh); }
            }
            if (_planError is null)
            {
                _msg = $"Cotizacion creada para {ids.Count} linea(s){(nums.Count > 0 ? ": " + string.Join(", ", nums) : "")}.";
            }
            await ReloadAsync();
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

