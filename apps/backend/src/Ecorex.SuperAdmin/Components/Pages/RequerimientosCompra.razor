    private async Task GuardarPlanAsync()
    {
        _planError = null;
        _busy = true;
        try
        {
            var req = new GuardarHijosRequest(_planReqId, _pHijos.Select(h => new HijoInput(
                h.Id, h.Cantidad,
                h.Fecha is { } d ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null,
                h.Despacho, h.Entrega,
                Guid.TryParse(h.Prov, out var pv) ? pv : null,
                h.Precio,
                h.ContactoId)).ToList());
            var plan = await Svc.GuardarHijosAsync(req);
            if (plan is null) { _planError = "No se pudo guardar."; return; }
            _showPlan = false;
            _msg = $"Planificacion guardada: {plan.Hijos.Count} division(es), sin planificar {Fmt(plan.CantidadSinPlanificar)}.";
            await ReloadAsync();
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SugerirAsync(HijoEdit h)
    {
        if (_planItemId is not Guid itemId) { return; }
        _busy = true;
        try
        {
            var sug = await Svc.SugerirProveedorAsync(itemId);
            if (sug is null) { _planError = "La matriz no tiene un proveedor para este producto."; }
            else { h.Prov = sug.Id.ToString(); h.ProvNombre = sug.Nombre; await FillContactoAsync(h); _planError = null; }
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EjecutarAsync(HijoEdit h)
    {
        if (h.Id is not Guid hid) { return; }
        _planError = null;
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var actorName = await ActorNameAsync();
            var res = await Svc.EjecutarHijoAsync(hid, actor, actorName);
            if (!res.Ok) { _planError = res.Error ?? "No se pudo ejecutar la compra."; }
            else
            {
                _msg = res.TaskNumber is { } num
                    ? $"Compra ejecutada: actividad {num} creada."
                    : "Compra ejecutada: actividad creada.";
            }
            if (res.Plan is { } plan)
            {
                _planProducto = plan.Producto;
                _planCantidadPadre = plan.CantidadPadre;
                _pHijos = plan.Hijos.Select(MapHijo).ToList();
                foreach (var hh in _pHijos) { await FillContactoAsync(hh); }
                await LoadHijoDynValuesAsync();
            }
            await ReloadAsync();
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

    // Cantidad de lineas marcadas que todavia se pueden cotizar.
    private int SelCount => _pHijos.Count(h => h.Sel && h.Id is not null && h.CotizacionTaskItemId is null);

    private void UsarUltimoPrecio(HijoEdit h)
    {
        if (h.UltimoPrecio is { } up && up > 0) { h.Precio = up; StateHasChanged(); }
    }

    private async Task CotizarSeleccionadasAsync()
    {
        var ids = _pHijos.Where(h => h.Sel && h.Id is Guid && h.CotizacionTaskItemId is null).Select(h => h.Id!.Value).ToList();
        if (ids.Count == 0) { _planError = "Marca al menos una linea para cotizar."; return; }
        _planError = null; _busy = true;
        var nums = new List<string>();
        try
        {
            var actor = await ActorAsync();
            var actorName = await ActorNameAsync();
            foreach (var id in ids)
            {
                var res = await Svc.CotizarHijoAsync(id, actor, actorName);
                if (!res.Ok) { _planError = res.Error ?? "No se pudo crear una cotizacion."; break; }
                if (res.TaskNumber is { } n) { nums.Add(n); }
            }
            var plan = await Svc.GetPlanificacionAsync(_planReqId);
            if (plan is not null)
            {
                _planProducto = plan.Producto;
                _planCantidadPadre = plan.CantidadPadre;
                _pHijos = plan.Hijos.Select(MapHijo).ToList();
                foreach (var hh in _pHijos) { await FillContactoAsync(hh); }
                await LoadHijoDynValuesAsync();
            }
            if (_planError is null)
            {
                _msg = $"Cotizacion creada para {ids.Count} linea(s){(nums.Count > 0 ? ": " + string.Join(", ", nums) : "")}.";
            }
            await ReloadAsync();
        }
        catch (Exception ex) { _planError = ex.Message; }
        finally { _busy = false; }
    }

    // ---- Editor de contactos del proveedor (Ola 11) ----
    private async Task OpenContactosAsync(string provId)
    {
        if (!Guid.TryParse(provId, out var pid)) { return; }
        _contactosError = null;
        _contactosProvId = provId;
        _contactosProvNombre = _proveedores.FirstOrDefault(p => p.Id == pid)?.Nombre ?? "Proveedor";
        _contactosList = (await Svc.ListContactosAsync(pid)).ToList();
        ClearContactoForm();
        _showContactos = true;
    }

    private void ClearContactoForm() { _cEditId = null; _cNombre = ""; _cCargo = ""; _cEmail = ""; _cTel = ""; }

    private void EditarContacto(ProveedorContactoItemDto c)
    {
        _cEditId = c.Id; _cNombre = c.Nombre; _cCargo = c.Cargo ?? ""; _cEmail = c.Email ?? ""; _cTel = c.Telefono ?? "";
    }

    private async Task GuardarContactoUiAsync()
    {
        if (!Guid.TryParse(_contactosProvId, out var pid)) { return; }
        if (string.IsNullOrWhiteSpace(_cNombre)) { _contactosError = "El contacto debe tener nombre."; return; }
        _contactosError = null; _busy = true;
        try
        {
            await Svc.GuardarContactoAsync(pid, new ContactoInput(_cEditId, _cNombre, _cCargo, _cEmail, _cTel));
            _contactosList = (await Svc.ListContactosAsync(pid)).ToList();
            ClearContactoForm();
        }
        catch (Exception ex) { _contactosError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarContactoUiAsync(Guid id)
    {
        _contactosError = null; _busy = true;
        try
        {
            await Svc.EliminarContactoAsync(id);
            if (Guid.TryParse(_contactosProvId, out var pid)) { _contactosList = (await Svc.ListContactosAsync(pid)).ToList(); }
            if (_cEditId == id) { ClearContactoForm(); }
        }
        catch (Exception ex) { _contactosError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CerrarContactosAsync()
    {
        _showContactos = false;
        // Refresca el contacto mostrado / el selector de las lineas que usan este proveedor.
        foreach (var h in _pHijos.Where(h => h.Prov == _contactosProvId).ToList())
        {
            try { await FillContactoAsync(h); } catch { }
        }
        StateHasChanged();
    }

    private async Task CerrarAsync(Guid id)
    {
        _msg = null; _busy = true;
        try { await Svc.CerrarAsync(id); await ReloadAsync(); _msg = "Necesidad cerrada."; }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ReabrirAsync(Guid id)
    {
        _msg = null; _busy = true;
        try { await Svc.ReabrirAsync(id); await ReloadAsync(); _msg = "Necesidad reabierta."; }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task<string> ActorNameAsync()
    {
        if (AuthState is null) { return "Usuario"; }
        var st = await AuthState;
        return st.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
    }

    private async Task<bool> IsOwnerOrAdminAsync()
    {
        if (AuthState is null) { return false; }
        var st = await AuthState;
        return st.User.FindAll("tenant_role").Any(c => c.Value is "Owner" or "Admin");
    }

    private static string Fmt(decimal d) => d.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture);
}
