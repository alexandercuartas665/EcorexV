@page "/requerimientos-config"
@attribute [Authorize(Policy = "Compras.Configurar")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ecorex.Application.Requerimientos
@using Ecorex.Application.Rules
@using Ecorex.Domain.Enums
@inject IRequerimientoConfigService Svc
@inject IRuleDocumentService RuleDocs

<PageTitle>Configuracion de Requerimientos - ECOREX.tareas</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </div>
            <span>Compras</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Configuracion de Requerimientos</h1>
        <p class="page-sub" style="margin-bottom:0;">Define los origenes: de donde llega cada necesidad y que subcategoria/proceso del modulo de Actividades ejecuta la compra de ese genero.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <button class="btn btn-primary" @onclick="() => OpenEditor(null)" disabled="@_busy">+ Nuevo origen</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div style="margin:10px 0 14px;padding:10px 14px;border-radius:10px;background:var(--brand-soft,#eef2ff);color:var(--ink,#1f2937);font-size:13px;">@_msg</div>
}

<h2 style="font-size:14px;font-weight:700;margin:16px 0 8px;color:var(--ink-2,#4b5563);">Origenes</h2>

@if (_origenes.Count == 0)
{
    <div style="padding:24px;text-align:center;color:var(--ink-3,#6b7280);font-size:13px;border:1px dashed var(--line-2,#e5e7eb);border-radius:10px;">
        Sin origenes todavia. Crea el primero (p.ej. "Insumos de Oficina") con "+ Nuevo origen".
    </div>
}
else
{
    <div style="overflow:auto;border:1px solid var(--line-2,#e5e7eb);border-radius:10px;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr style="background:var(--surface-2,#f8fafc);text-align:left;">
                    <th style="padding:9px 12px;">Nombre</th>
                    <th style="padding:9px 12px;">Area</th>
                    <th style="padding:9px 12px;">Fuente</th>
                    <th style="padding:9px 12px;">Proceso de compra</th>
                    <th style="padding:9px 12px;">Activo</th>
                    <th style="padding:9px 12px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in _origenes)
                {
                    <tr style="border-top:1px solid var(--line,#f1f5f9);">
                        <td style="padding:9px 12px;font-weight:600;">@o.Nombre</td>
                        <td style="padding:9px 12px;">@(string.IsNullOrWhiteSpace(o.Area) ? "-" : o.Area)</td>
                        <td style="padding:9px 12px;">@FuenteLabel(o)</td>
                        <td style="padding:9px 12px;">@(o.SubcategoriaNombre ?? "(sin proceso)")</td>
                        <td style="padding:9px 12px;">@(o.Activo ? "Si" : "No")</td>
                        <td style="padding:9px 12px;text-align:right;white-space:nowrap;">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEditor(o)" disabled="@_busy">Editar</button>
                            <button class="btn btn-link btn-sm" style="color:#b91c1c;" @onclick="() => DeleteAsync(o.Id)" disabled="@_busy">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ---- Ola 4: Matriz de proveedores ---- *@
<div style="display:flex;align-items:center;justify-content:space-between;margin:26px 0 8px;">
    <div>
        <h2 style="font-size:14px;font-weight:700;margin:0;color:var(--ink-2,#4b5563);">Matriz de proveedores</h2>
        <p class="page-sub" style="margin:2px 0 0;font-size:12px;">Asocia un proveedor del Directorio a una dimension del producto (referencia, marca, subgrupo, grupo o categoria). Al planificar, la regla MAS especifica que aplique sugiere el proveedor.</p>
    </div>
    <button class="btn btn-primary btn-sm" @onclick="() => OpenRegla(null)" disabled="@_busy">+ Nueva regla</button>
</div>

@if (_reglas.Count == 0)
{
    <div style="padding:24px;text-align:center;color:var(--ink-3,#6b7280);font-size:13px;border:1px dashed var(--line-2,#e5e7eb);border-radius:10px;">
        Sin reglas todavia. Agrega la primera (p.ej. marca "ACME" -> proveedor "Distribuidora X").
    </div>
}
else
{
    <div style="overflow:auto;border:1px solid var(--line-2,#e5e7eb);border-radius:10px;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr style="background:var(--surface-2,#f8fafc);text-align:left;">
                    <th style="padding:9px 12px;">Dimension</th>
                    <th style="padding:9px 12px;">Valor</th>
                    <th style="padding:9px 12px;">Proveedor</th>
                    <th style="padding:9px 12px;text-align:right;">Prioridad</th>
                    <th style="padding:9px 12px;">Origen</th>
                    <th style="padding:9px 12px;">Activo</th>
                    <th style="padding:9px 12px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _reglas)
                {
                    <tr style="border-top:1px solid var(--line,#f1f5f9);">
                        <td style="padding:9px 12px;font-weight:600;">@DimensionLabel(r.Dimension)</td>
                        <td style="padding:9px 12px;">@(r.ValorNombre ?? r.ValorDimension)</td>
                        <td style="padding:9px 12px;">@(r.ProveedorNombre ?? "(proveedor)")</td>
                        <td style="padding:9px 12px;text-align:right;">@r.Prioridad</td>
                        <td style="padding:9px 12px;">@(r.Aprendida ? "Aprendida" : "Manual")</td>
                        <td style="padding:9px 12px;">@(r.Activo ? "Si" : "No")</td>
                        <td style="padding:9px 12px;text-align:right;white-space:nowrap;">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenRegla(r)" disabled="@_busy">Editar</button>
                            <button class="btn btn-link btn-sm" style="color:#b91c1c;" @onclick="() => DeleteReglaAsync(r.Id)" disabled="@_busy">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin:28px 0 8px;">
    <div>
        <h2 style="font-size:14px;font-weight:700;margin:0;color:var(--ink-2,#4b5563);">Formulario de cotizacion (RFQ)</h2>
        <p class="page-sub" style="margin:2px 0 0;font-size:12px;">Al "Cotizar por proveedor", el flujo de la subcategoria de cotizacion presenta ESTE formulario ya cargado con las lineas que se piden (una fila por linea). Elige el formulario, su grilla y que columna recibe cada dato. La columna CLAVE debe ser OCULTA en el disenador: lleva la clave de producto para empatar la respuesta del proveedor. Sin configurar, la RFQ se crea igual pero sin inyectar las lineas.</p>
    </div>
</div>
<div style="border:1px solid var(--line-2,#e5e7eb);border-radius:10px;padding:16px 18px;display:flex;flex-direction:column;gap:12px;max-width:640px;">
    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Formulario RFQ
        <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqFormId" @bind:after="OnRfqFormChanged">
            <option value="">(ninguno - no se inyectan lineas)</option>
            @foreach (var f in _formularios)
            {
                <option value="@f.Id">@f.Nombre</option>
            }
        </select>
    </label>
    @if (!string.IsNullOrEmpty(_rfqFormId) && _rfqGridFields.Count == 0)
    {
        <div style="font-size:12.5px;color:#b45309;">El formulario elegido no tiene campos de tipo grilla (GridDetail). Agrega una grilla en el disenador para poder inyectar las lineas.</div>
    }
    @if (_rfqGridFields.Count > 0)
    {
        <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Grilla que recibe las lineas
            <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqGrid" @bind:after="OnRfqGridChanged">
                <option value="">(elige una grilla)</option>
                @foreach (var g in _rfqGridFields)
                {
                    <option value="@g.FieldCode">@g.Label</option>
                }
            </select>
        </label>
    }
    @if (_rfqCols.Count > 0)
    {
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna CLAVE (debe ser oculta)
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColClave">
                    <option value="">(elige)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label@(c.Hidden ? " (oculta)" : "")</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Descripcion
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColDesc">
                    <option value="">(no inyectar)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Cantidad
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColCant">
                    <option value="">(no inyectar)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Unidad
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColUni">
                    <option value="">(no inyectar)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Fecha requerida
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColFecha">
                    <option value="">(no inyectar)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
        </div>
        <div style="margin-top:6px;font-size:12px;font-weight:600;color:var(--ink-2,#4b5563);">Columnas de RESPUESTA del proveedor</div>
        <div style="font-size:11.5px;color:var(--ink-3,#6b7280);margin-bottom:-4px;">Las llena el proveedor; al enviar, se empatan por clave y pasan a la linea del RFQ y al comparador. El precio es imprescindible.</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Precio unitario (obligatoria)
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColPrecio">
                    <option value="">(elige)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Vigencia (dias)
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColVig">
                    <option value="">(no leer)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Lead time / entrega
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColLead">
                    <option value="">(no leer)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Marca
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColMarca">
                    <option value="">(no leer)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
            <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Columna Nota / observaciones
                <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rfqColNota">
                    <option value="">(no leer)</option>
                    @foreach (var c in _rfqCols)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </label>
        </div>
    }
    @if (_rfqError is not null) { <div style="color:#b91c1c;font-size:12.5px;">@_rfqError</div> }
    <div style="display:flex;justify-content:flex-end;">
        <button class="btn btn-primary btn-sm" @onclick="SaveRfqFormMap" disabled="@_busy">Guardar mapeo RFQ</button>
    </div>
</div>

@if (_showRegla)
{
    <div style="position:fixed;inset:0;z-index:4000;background:rgba(15,23,42,.45);display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;" @onclick="() => _showRegla = false">
        <div style="background:var(--surface,#fff);border-radius:12px;max-width:520px;width:100%;box-shadow:0 20px 50px rgba(0,0,0,.25);" @onclick:stopPropagation="true">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line-2,#e5e7eb);">
                <strong style="font-size:14px;">@(_reglaId is null ? "Nueva regla" : "Editar regla")</strong>
                <button class="btn btn-link btn-sm" @onclick="() => _showRegla = false">&times;</button>
            </div>
            <div style="padding:16px 18px;display:flex;flex-direction:column;gap:12px;">
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Dimension
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rDimension" @bind:after="OnDimensionChanged">
                        @foreach (var d in Enum.GetValues<RequerimientoDimension>())
                        {
                            <option value="@d">@DimensionLabel(d)</option>
                        }
                    </select>
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Valor de la dimension
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rValor">
                        <option value="">(elige un valor)</option>
                        @foreach (var v in _valores)
                        {
                            <option value="@v.Id">@v.Nombre</option>
                        }
                    </select>
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Proveedor
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rProveedor">
                        <option value="">(elige un proveedor)</option>
                        @foreach (var p in _proveedores)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Prioridad (menor gana primero)
                    <input type="number" min="0" step="1" class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_rPrioridad" />
                </label>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;"><input type="checkbox" @bind="_rActivo" /> Activo</label>
                @if (_reglaError is not null) { <div style="color:#b91c1c;font-size:12.5px;">@_reglaError</div> }
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 18px;border-top:1px solid var(--line-2,#e5e7eb);">
                <button class="btn btn-primary btn-sm" @onclick="SaveReglaAsync" disabled="@_busy">Guardar</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showRegla = false" disabled="@_busy">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (_showEditor)
{
    <div style="position:fixed;inset:0;z-index:4000;background:rgba(15,23,42,.45);display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;" @onclick="() => _showEditor = false">
        <div style="background:var(--surface,#fff);border-radius:12px;max-width:520px;width:100%;box-shadow:0 20px 50px rgba(0,0,0,.25);" @onclick:stopPropagation="true">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line-2,#e5e7eb);">
                <strong style="font-size:14px;">@(_editId is null ? "Nuevo origen" : "Editar origen")</strong>
                <button class="btn btn-link btn-sm" @onclick="() => _showEditor = false">&times;</button>
            </div>
            <div style="padding:16px 18px;display:flex;flex-direction:column;gap:12px;">
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Nombre
                    <input class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" placeholder="Insumos de Oficina" @bind="_eNombre" />
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Area solicitante
                    <input class="cd-in" style="height:34px;padding:0 10px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" placeholder="Proyectos / Oficina / Inventario" @bind="_eArea" />
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Tipo de fuente
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_eTipoFuente">
                        @foreach (var t in Enum.GetValues<RequerimientoFuenteTipo>())
                        {
                            <option value="@t">@TipoFuenteLabel(t)</option>
                        }
                    </select>
                </label>
                @if (_eTipoFuente == RequerimientoFuenteTipo.Formulario)
                {
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Formulario que alimenta
                        <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_eFuenteRefId">
                            <option value="">(elige un formulario)</option>
                            @foreach (var f in _formularios)
                            {
                                <option value="@f.Id">@f.Nombre</option>
                            }
                        </select>
                    </label>
                }
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Proceso de compra (subcategoria que ejecuta)
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_eSubcategoriaId">
                        <option value="">(sin proceso)</option>
                        @foreach (var s in _subcategorias)
                        {
                            <option value="@s.Id">@s.Nombre</option>
                        }
                    </select>
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2,#4b5563);">Proceso de cotizacion (subcategoria que pide precio)
                    <select style="height:34px;padding:0 8px;border:1px solid var(--line-2,#e5e7eb);border-radius:8px;font-size:13px;" @bind="_eSubcategoriaCotizacionId">
                        <option value="">(sin proceso de cotizacion)</option>
                        @foreach (var s in _subcategorias)
                        {
                            <option value="@s.Id">@s.Nombre</option>
                        }
                    </select>
                </label>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;"><input type="checkbox" @bind="_eActivo" /> Activo</label>
                @if (_editError is not null) { <div style="color:#b91c1c;font-size:12.5px;">@_editError</div> }
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 18px;border-top:1px solid var(--line-2,#e5e7eb);">
                <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_busy">Guardar</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showEditor = false" disabled="@_busy">Cancelar</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _msg;
    private List<RequerimientoOrigenDto> _origenes = new();
    private List<RequerimientoOpcionDto> _subcategorias = new();
    private List<RequerimientoOpcionDto> _formularios = new();

    private bool _showEditor;
    private string? _editError;
    private Guid? _editId;
    private string _eNombre = "";
    private string _eArea = "";
    private RequerimientoFuenteTipo _eTipoFuente = RequerimientoFuenteTipo.Manual;
    private string _eFuenteRefId = "";
    private string _eSubcategoriaId = "";
    private string _eSubcategoriaCotizacionId = "";
    private bool _eActivo = true;

    // ---- Ola 4: matriz de proveedores ----
    private List<RequerimientoReglaDto> _reglas = new();
    private List<RequerimientoOpcionDto> _proveedores = new();
    private List<RequerimientoOpcionDto> _valores = new();
    private bool _showRegla;
    private string? _reglaError;
    private Guid? _reglaId;
    private RequerimientoDimension _rDimension = RequerimientoDimension.Marca;
    private string _rValor = "";
    private string _rProveedor = "";
    private int _rPrioridad = 100;
    private bool _rActivo = true;

    // ---- Ola B: formulario de cotizacion (RFQ) ----
    private string _rfqFormId = "";
    private string _rfqGrid = "";
    private string _rfqColClave = "";
    private string _rfqColDesc = "";
    private string _rfqColCant = "";
    private string _rfqColUni = "";
    private string _rfqColFecha = "";
    private string _rfqColPrecio = "";
    private string _rfqColVig = "";
    private string _rfqColLead = "";
    private string _rfqColMarca = "";
    private string _rfqColNota = "";
    private List<RfqGridFieldDto> _rfqGridFields = new();
    private IReadOnlyList<RfqGridColDto> _rfqCols = new List<RfqGridColDto>();
    private string? _rfqError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _origenes = (await Svc.ListOrigenesAsync()).ToList();
        _subcategorias = (await Svc.ListSubcategoriasAsync()).ToList();
        _formularios = (await Svc.ListFormulariosAsync()).ToList();
        _reglas = (await Svc.ListReglasAsync()).ToList();
        _proveedores = (await Svc.ListProveedoresAsync()).ToList();
        await LoadRfqMapAsync();
    }

    private async Task LoadRfqMapAsync()
    {
        var map = await Svc.GetRfqFormMapAsync();
        _rfqFormId = map.FormDefinitionId?.ToString() ?? "";
        _rfqGrid = map.GridFieldCode ?? "";
        _rfqColClave = map.ColClave ?? "";
        _rfqColDesc = map.ColDescripcion ?? "";
        _rfqColCant = map.ColCantidad ?? "";
        _rfqColUni = map.ColUnidad ?? "";
        _rfqColFecha = map.ColFecha ?? "";
        _rfqColPrecio = map.ColPrecio ?? "";
        _rfqColVig = map.ColVigencia ?? "";
        _rfqColLead = map.ColLeadTime ?? "";
        _rfqColMarca = map.ColMarca ?? "";
        _rfqColNota = map.ColNota ?? "";
        _rfqGridFields = Guid.TryParse(_rfqFormId, out var fid)
            ? (await Svc.ListGridFieldsAsync(fid)).ToList()
            : new List<RfqGridFieldDto>();
        _rfqCols = _rfqGridFields.FirstOrDefault(g => g.FieldCode == _rfqGrid)?.Columns ?? new List<RfqGridColDto>();
    }

    private async Task OnRfqFormChanged()
    {
        _rfqGrid = ""; _rfqColClave = ""; _rfqColDesc = ""; _rfqColCant = ""; _rfqColUni = ""; _rfqColFecha = "";
        _rfqCols = new List<RfqGridColDto>();
        _rfqGridFields = Guid.TryParse(_rfqFormId, out var fid)
            ? (await Svc.ListGridFieldsAsync(fid)).ToList()
            : new List<RfqGridFieldDto>();
    }

    private void OnRfqGridChanged()
    {
        _rfqCols = _rfqGridFields.FirstOrDefault(g => g.FieldCode == _rfqGrid)?.Columns ?? new List<RfqGridColDto>();
        _rfqColClave = ""; _rfqColDesc = ""; _rfqColCant = ""; _rfqColUni = ""; _rfqColFecha = "";
        _rfqColPrecio = ""; _rfqColVig = ""; _rfqColLead = ""; _rfqColMarca = ""; _rfqColNota = "";
    }

    private async Task SaveRfqFormMap()
    {
        _rfqError = null;
        _busy = true;
        try
        {
            Guid? defId = Guid.TryParse(_rfqFormId, out var fid) ? fid : null;
            if (defId is not null && string.IsNullOrWhiteSpace(_rfqGrid))
            {
                _rfqError = "Elige la grilla que recibe las lineas (o quita el formulario).";
                return;
            }
            if (defId is not null && string.IsNullOrWhiteSpace(_rfqColClave))
            {
                _rfqError = "Elige la columna CLAVE (oculta): es la que empata la respuesta del proveedor.";
                return;
            }
            if (defId is not null && string.IsNullOrWhiteSpace(_rfqColPrecio))
            {
                _rfqError = "Elige la columna de Precio unitario: es la que recibe la oferta del proveedor.";
                return;
            }
            string? S(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
            await Svc.SetRfqFormMapAsync(new RfqFormMapDto(
                defId, S(_rfqGrid), S(_rfqColClave), S(_rfqColDesc), S(_rfqColCant), S(_rfqColUni), S(_rfqColFecha),
                S(_rfqColPrecio), S(_rfqColVig), S(_rfqColLead), S(_rfqColMarca), S(_rfqColNota)));
            // Auto-cablea la regla ON-SUBMIT que empata la respuesta y la lleva al comparador (Ola C). Idempotente:
            // no duplica. Un fallo aqui no debe tumbar el guardado del mapeo (se avisa pero el mapeo ya quedo).
            if (defId is Guid wiredDef)
            {
                var wire = await RuleDocs.EnsureFormSubmitVerbRuleAsync(
                    wiredDef, "REGISTRAR_RESPUESTA_RFQ", "Registrar respuesta de cotizacion (RFQ)");
                if (!wire.IsOk) { _rfqError = "Mapeo guardado, pero no se pudo cablear la regla de respuesta: " + wire.Error; }
            }
            _msg = defId is null ? "Formulario RFQ desconfigurado (no se inyectaran lineas)." : "Mapeo del formulario RFQ guardado.";
            await LoadRfqMapAsync();
        }
        catch (Exception ex) { _rfqError = ex.Message; }
        finally { _busy = false; }
    }

    private void OpenEditor(RequerimientoOrigenDto? o)
    {
        _editError = null;
        _editId = o?.Id;
        _eNombre = o?.Nombre ?? "";
        _eArea = o?.Area ?? "";
        _eTipoFuente = o?.TipoFuente ?? RequerimientoFuenteTipo.Manual;
        _eFuenteRefId = o?.FuenteRefId?.ToString() ?? "";
        _eSubcategoriaId = o?.SubcategoriaCompraId?.ToString() ?? "";
        _eSubcategoriaCotizacionId = o?.SubcategoriaCotizacionId?.ToString() ?? "";
        _eActivo = o?.Activo ?? true;
        _showEditor = true;
    }

    private async Task SaveAsync()
    {
        _editError = null;
        _busy = true;
        try
        {
            var req = new SaveRequerimientoOrigenRequest(
                _editId, _eNombre, _eArea, _eTipoFuente,
                Guid.TryParse(_eFuenteRefId, out var f) ? f : null,
                Guid.TryParse(_eSubcategoriaId, out var s) ? s : null,
                Guid.TryParse(_eSubcategoriaCotizacionId, out var sc) ? sc : null,
                _eActivo);
            var saved = await Svc.SaveOrigenAsync(req);
            if (saved is null) { _editError = "No se pudo guardar."; return; }
            _showEditor = false;
            _msg = $"Origen '{saved.Nombre}' guardado.";
            await LoadAsync();
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        _busy = true;
        try { await Svc.DeleteOrigenAsync(id); await LoadAsync(); }
        finally { _busy = false; }
    }

    // ---- Ola 4: matriz de proveedores ----
    private async Task OpenRegla(RequerimientoReglaDto? r)
    {
        _reglaError = null;
        _reglaId = r?.Id;
        _rDimension = r?.Dimension ?? RequerimientoDimension.Marca;
        _rPrioridad = r?.Prioridad ?? 100;
        _rActivo = r?.Activo ?? true;
        _rProveedor = r?.ProveedorId.ToString() ?? "";
        _valores = (await Svc.ListValoresDimensionAsync(_rDimension)).ToList();
        _rValor = r?.ValorDimension ?? "";
        _showRegla = true;
    }

    private async Task OnDimensionChanged()
    {
        _valores = (await Svc.ListValoresDimensionAsync(_rDimension)).ToList();
        _rValor = "";
    }

    private async Task SaveReglaAsync()
    {
        _reglaError = null;
        _busy = true;
        try
        {
            var req = new SaveReglaRequest(
                _reglaId,
                new List<ReglaCondicion> { new(_rDimension, _rValor) },
                Guid.TryParse(_rProveedor, out var p) ? p : Guid.Empty,
                _rPrioridad, _rActivo, null);
            var saved = await Svc.SaveReglaAsync(req);
            if (saved is null) { _reglaError = "No se pudo guardar."; return; }
            _showRegla = false;
            _msg = $"Regla guardada: {DimensionLabel(saved.Dimension)} -> {saved.ProveedorNombre}.";
            await LoadAsync();
        }
        catch (Exception ex) { _reglaError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteReglaAsync(Guid id)
    {
        _busy = true;
        try { await Svc.DeleteReglaAsync(id); await LoadAsync(); }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private static string DimensionLabel(RequerimientoDimension d) => d switch
    {
        RequerimientoDimension.Referencia => "Referencia (item)",
        RequerimientoDimension.Marca => "Marca",
        RequerimientoDimension.Subgrupo => "Subgrupo",
        RequerimientoDimension.Grupo => "Grupo",
        RequerimientoDimension.Categoria => "Categoria (tipo)",
        _ => d.ToString()
    };

    private static string TipoFuenteLabel(RequerimientoFuenteTipo t) => t switch
    {
        RequerimientoFuenteTipo.Manual => "Manual",
        RequerimientoFuenteTipo.Formulario => "Formulario",
        RequerimientoFuenteTipo.Contenedor => "Contenedor de datos",
        _ => t.ToString()
    };

    private string FuenteLabel(RequerimientoOrigenDto o) => o.TipoFuente switch
    {
        RequerimientoFuenteTipo.Manual => "Manual",
        RequerimientoFuenteTipo.Formulario => o.FuenteNombre is { } n ? $"Formulario: {n}" : "Formulario (sin elegir)",
        RequerimientoFuenteTipo.Contenedor => "Contenedor",
        _ => "-"
    };
}
