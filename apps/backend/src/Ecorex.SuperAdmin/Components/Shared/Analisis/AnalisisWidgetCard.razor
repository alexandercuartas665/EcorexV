@using System.Globalization
@using Ecorex.Application.Analisis
@using Ecorex.Application.Reporting

@* Tarjeta de un widget del modulo de Analisis (ADR-0158 D3/D9). Componente REUTILIZABLE. Desde la Ola 7a
   los graficos (barras, dona, linea/area, mapa de calor, embudo, apiladas, barras + linea, mapa de arbol,
   calendario, velocimetro) se pintan con Apache ECharts via AnalisisGrafico (la option la arma
   AnalisisGraficos en Application); KPI, semaforo y tabla siguen en HTML con el estilo de "Indicadores del
   sistema" del prototipo ECOREX.dc.html. Las acciones de organizar (arrastrar, redimensionar, editar,
   duplicar, fijar, quitar) solo existen en modo edicion (PuedeEditar). Todo numero que va a un
   atributo/estilo pasa por Inv() (InvariantCulture). *@

<div class="aw-card @(Arrastrable ? "drag" : "") @(_sobre ? "over" : "") @(Elegido ? "picked" : "")" style="grid-column: span @Inv(Math.Clamp(Widget.ColSpan, 1, 4))"
     draggable="@(Arrastrable ? "true" : "false")"
     @ondragstart="() => OnArrastrar.InvokeAsync()"
     @ondragenter="() => _sobre = Arrastrable"
     @ondragleave="() => _sobre = false"
     @ondragover:preventDefault="Arrastrable"
     @ondrop="Soltar">
    @if (ModoSoltar && Arrastrable)
    {
        <button type="button" class="aw-drop" @onclick="Soltar">Soltar aqui</button>
    }
    <div class="aw-head">
        <div class="aw-title" title="@Widget.Titulo">
            @if (Arrastrable)
            {
                @if (OnElegir.HasDelegate)
                {
                    @* Tactil: el raton arrastra; en celular/tablet se toca el asa y luego "Soltar aqui" en el destino. *@
                    <button type="button" class="aw-grip btn" title="@(Elegido ? "Cancelar mover" : "Mover: toca y luego elige donde soltar")"
                            aria-pressed="@(Elegido ? "true" : "false")" @onclick="() => OnElegir.InvokeAsync()">&#8942;&#8942;</button>
                }
                else
                {
                    <span class="aw-grip" aria-hidden="true">&#8942;&#8942;</span>
                }
            }
            @Widget.Titulo
        </div>
        @if (PuedeEditar)
        {
            <div class="aw-actions">
                @if (OnEditar.HasDelegate)
                {
                    <button class="aw-ico" title="Editar widget" @onclick="() => OnEditar.InvokeAsync()">&#9998;</button>
                }
                @if (OnDuplicar.HasDelegate)
                {
                    <button class="aw-ico" title="Duplicar widget" @onclick="() => OnDuplicar.InvokeAsync()">&#10697;</button>
                }
                @if (OnFijar.HasDelegate)
                {
                    <button class="aw-ico @(Fijado ? "on" : "")" title="@(Fijado ? "Quitar del Inicio" : "Fijar en el Inicio")" @onclick="() => OnFijar.InvokeAsync(!Fijado)">&#9733;</button>
                }
                <button class="aw-ico" title="Mover antes" @onclick="() => OnMover.InvokeAsync(-1)">&#8592;</button>
                <button class="aw-ico" title="Mover despues" @onclick="() => OnMover.InvokeAsync(1)">&#8594;</button>
                <button class="aw-ico danger" title="Quitar widget" @onclick="() => OnEliminar.InvokeAsync()">&#215;</button>
            </div>
        }
    </div>

    @if (Resultado is null)
    {
        <div class="aw-state"><span class="aw-skel"></span></div>
    }
    else if (!Resultado.Ok)
    {
        <div class="aw-state err">@Resultado.Error</div>
    }
    else
    {
        @foreach (var aviso in Resultado.Avisos)
        {
            <div class="aw-aviso">@aviso</div>
        }
        @switch (Resultado.Forma)
        {
            case EscalarShape kpi when Widget.Tipo == AnalisisTipoWidget.Velocimetro:
                <AnalisisGrafico Opcion="Opcion(kpi)" Alto="@AnalisisGraficos.Alto(kpi, Widget.Tipo)" />
                @if (kpi.Comparacion is not null)
                {
                    <div class="aw-gauge-foot">@Comparacion(kpi)</div>
                }
                break;

            case EscalarShape kpi:
                <div class="aw-kpi">
                    <div class="aw-kpi-top">
                        <div class="aw-kpi-ico" style="background:var(--t-@(kpi.Tono ?? TonoBase)-bg);color:var(--t-@(kpi.Tono ?? TonoBase))">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>
                        </div>
                        @if (kpi.Comparacion is not null)
                        {
                            @Comparacion(kpi)
                        }
                    </div>
                    <div class="aw-kpi-val" style="@(kpi.Tono is null ? "" : $"color:var(--t-{kpi.Tono})")">@Fmt(kpi.Valor)</div>
                    <div class="aw-kpi-lbl">
                        @kpi.Etiqueta
                        @if (kpi.Comparacion is not null)
                        {
                            <span class="aw-kpi-cmp">&middot; @kpi.Comparacion</span>
                        }
                    </div>
                    @if (AnalisisGraficos.Tendencia(kpi, Config) is { } tendencia)
                    {
                        <div class="aw-spark"><AnalisisGrafico Opcion="tendencia" Alto="48" /></div>
                    }
                </div>
                break;

            case CategoriasShape cat when cat.Items.Count == 0:
                <div class="aw-state">Sin datos.</div>
                break;

            case CategoriasShape cat when Widget.Tipo == AnalisisTipoWidget.Semaforo:
                <div class="aw-sem">
                    @{ var si = 0; }
                    @foreach (var it in cat.Items)
                    {
                        var tono = it.Tono ?? TonoDesde(si);
                        <div class="aw-sem-row">
                            <div class="aw-sem-top">
                                <span class="aw-sem-dot" style="background:var(--t-@tono);box-shadow:0 0 0 4px var(--t-@tono-bg)"></span>
                                <span class="aw-leg-name" title="@it.Etiqueta">@it.Etiqueta</span>
                                <span class="aw-leg-val">@Fmt(it.Valor) &middot; @Pct(it.Valor, cat.Total)</span>
                            </div>
                            <div class="aw-progress"><div style="width:@Inv(Porcentaje(it.Valor, cat.Total))%;background:var(--t-@tono)"></div></div>
                        </div>
                        si++;
                    }
                </div>
                break;

            case SerieShape serie when serie.Ejes.Count == 0:
                <div class="aw-state">Sin datos.</div>
                break;

            case HeatmapShape hm when hm.Filas.Count == 0:
                <div class="aw-state">Sin datos.</div>
                break;

            case CalendarioShape cal when cal.Dias.Count == 0:
                <div class="aw-state">Sin actividad entre @cal.Desde.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) y @cal.Hasta.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture).</div>
                break;

            case TablaShape tabla when tabla.Filas.Count == 0:
                <div class="aw-state">Sin datos.</div>
                break;

            case TablaShape tabla:
                <div class="aw-scroll">
                    <table class="aw-table">
                        <thead>
                            <tr>
                                @foreach (var c in tabla.Columnas)
                                {
                                    <th class="@(EsNumero(c) ? "num" : "")">@c.DisplayName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in tabla.Filas.Take(MaxFilasTabla))
                            {
                                <tr>
                                    @for (var c = 0; c < tabla.Columnas.Count; c++)
                                    {
                                        var col = tabla.Columnas[c];
                                        <td class="@(EsNumero(col) ? "num" : "")">@Celda(col, c < fila.Count ? fila[c] : null)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (tabla.Filas.Count > MaxFilasTabla)
                {
                    <div class="aw-foot-note">Mostrando @MaxFilasTabla de @tabla.Filas.Count filas.</div>
                }
                break;

            case WidgetShape forma when Opcion(forma) is { } opcion:
                <AnalisisGrafico Opcion="opcion" Alto="@AnalisisGraficos.Alto(forma, Widget.Tipo)" />
                @if (forma is CalendarioShape calendario)
                {
                    <div class="aw-foot-note">
                        @Fmt(calendario.Total) en total &middot;
                        @calendario.Desde.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) - @calendario.Hasta.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
                    </div>
                }
                break;

            default:
                <div class="aw-state">Este tipo de widget no se puede mostrar.</div>
                break;
        }

        @if (Resultado.FueraDeContexto)
        {
            <div class="aw-foot-note warn" title="La fuente de este widget no tiene un campo para filtrar por el registro donde esta embebido.">Datos generales: no se filtra por este registro.</div>
        }
    }

    @if (Arrastrable && OnAncho.HasDelegate)
    {
        <button class="aw-resize" title="Cambiar ancho (@Widget.ColSpan de 4 columnas)" @onclick="() => OnAncho.InvokeAsync(Widget.ColSpan % 4 + 1)">
            <span>@Widget.ColSpan/4</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public AnalisisWidgetDto Widget { get; set; } = default!;

    /// <summary>Null = cargando.</summary>
    [Parameter] public AnalisisWidgetResultado? Resultado { get; set; }

    /// <summary>Modo edicion: muestra las acciones de la cabecera.</summary>
    [Parameter] public bool PuedeEditar { get; set; }

    /// <summary>Arrastrar y soltar + asa de ancho (solo en modo edicion del anfitrion).</summary>
    [Parameter] public bool Arrastrable { get; set; }

    [Parameter] public bool Fijado { get; set; }

    [Parameter] public EventCallback<int> OnMover { get; set; }

    /// <summary>Nuevo ancho (1..4).</summary>
    [Parameter] public EventCallback<int> OnAncho { get; set; }

    [Parameter] public EventCallback OnEliminar { get; set; }

    [Parameter] public EventCallback OnEditar { get; set; }

    [Parameter] public EventCallback OnDuplicar { get; set; }

    /// <summary>true = fijar en el Inicio, false = quitar.</summary>
    [Parameter] public EventCallback<bool> OnFijar { get; set; }

    [Parameter] public EventCallback OnArrastrar { get; set; }

    /// <summary>Tocar el asa: elegir este widget para moverlo (alternativa tactil al arrastre HTML5).</summary>
    [Parameter] public EventCallback OnElegir { get; set; }

    /// <summary>Este widget esta elegido para mover.</summary>
    [Parameter] public bool Elegido { get; set; }

    /// <summary>Hay OTRO widget elegido: esta tarjeta muestra "Soltar aqui".</summary>
    [Parameter] public bool ModoSoltar { get; set; }

    /// <summary>Se solto otro widget sobre este.</summary>
    [Parameter] public EventCallback OnSoltar { get; set; }

    private const int MaxFilasTabla = 50;
    private bool _sobre;
    private string? _configJson;
    private WidgetConfig _config = new();

    private async Task Soltar()
    {
        _sobre = false;
        if (Arrastrable)
        {
            await OnSoltar.InvokeAsync();
        }
    }

    /// <summary>Presentacion del widget (se relee solo si cambia el ConfigJson).</summary>
    private WidgetConfig Config
    {
        get
        {
            if (!string.Equals(_configJson, Widget.ConfigJson, StringComparison.Ordinal))
            {
                _configJson = Widget.ConfigJson;
                _config = WidgetConfig.Leer(Widget.ConfigJson);
            }

            return _config;
        }
    }

    /// <summary>Option de ECharts de la forma (null si el tipo no es un grafico o la forma no le sirve).</summary>
    private IDictionary<string, object?>? Opcion(WidgetShape forma) =>
        AnalisisGraficos.EsGrafico(Widget.Tipo) ? AnalisisGraficos.Opcion(forma, Widget.Tipo, Config, Fmt) : null;

    /// <summary>Tono elegido en la presentacion (o azul).</summary>
    private string TonoBase => Config.Tono ?? "blue";

    /// <summary>Paleta de categorias empezando por el tono elegido.</summary>
    private string TonoDesde(int i) => AnalisisGraficos.TonoDesde(TonoBase, i);

    /// <summary>Chip de variacion del KPI: flecha + % coloreado segun si mejora (respeta "menor es mejor").</summary>
    private RenderFragment Comparacion(EscalarShape kpi) => __builder =>
    {
        var (clase, flecha, texto) = kpi.Delta switch
        {
            decimal d when d > 0 => (Config.MayorEsMejor ? "good" : "bad", "\u25B2", Variacion(d)),
            decimal d when d < 0 => (Config.MayorEsMejor ? "bad" : "good", "\u25BC", Variacion(d)),
            decimal => ("flat", "=", "0 %"),
            _ when kpi.ValorAnterior is 0m && kpi.Valor is > 0 => ("good", "\u25B2", "nuevo"),
            _ => ("na", "", "sin base")
        };
        var titulo = $"{kpi.Comparacion}: {Fmt(kpi.ValorAnterior)}";
        <span class="aw-delta @clase" title="@titulo">
            @if (flecha.Length > 0)
            {
                <span aria-hidden="true">@flecha</span>
            }
            @texto
        </span>
    };

    private static string Variacion(decimal d) =>
        Math.Abs(d * 100).ToString(Math.Abs(d) >= 1 ? "N0" : "0.#", CultureInfo.CurrentCulture) + " %";

    private string Fmt(decimal? v) => Formatear(v, Config.Formato);

    /// <summary>Formato de presentacion: numero (default), decimal, moneda, porcentaje.</summary>
    public static string Formatear(decimal? v, string? formato)
    {
        if (v is not decimal d)
        {
            return "-";
        }

        var c = CultureInfo.CurrentCulture;
        return formato switch
        {
            "decimal" => d.ToString("N2", c),
            "moneda" => "$ " + Math.Round(d).ToString("N0", c),
            "porcentaje" => Math.Round(d, 1).ToString("0.#", c) + " %",
            _ => Num(d)
        };
    }

    private static bool EsNumero(ReportColumn c) => c.Type is ReportFieldType.Number or ReportFieldType.Decimal;

    private string Celda(ReportColumn col, object? v) => v switch
    {
        null => string.Empty,
        DateTimeOffset dto => dto.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        DateTime dt => dt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        bool b => b ? "Si" : "No",
        _ when EsNumero(col) => Fmt(Ecorex.Application.Reporting.Sources.InMemoryReportEngine.ToDecimal(v)),
        _ => v.ToString() ?? string.Empty
    };

    private static string Inv(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Inv(int v) => v.ToString(CultureInfo.InvariantCulture);

    private static string Num(decimal? v)
    {
        if (v is not decimal d)
        {
            return "-";
        }

        // Una cifra decimal como maximo; si al redondear queda entero (8.9997 h -> 9) se muestra sin decimal.
        var r = Math.Round(d, 1);
        return r == Math.Round(r) ? r.ToString("N0", CultureInfo.CurrentCulture) : r.ToString("N1", CultureInfo.CurrentCulture);
    }

    private static string Pct(decimal v, decimal total) =>
        total == 0 ? "0%" : (v / total).ToString("P0", CultureInfo.CurrentCulture);

    private static double Porcentaje(decimal v, decimal total) => total <= 0 ? 0 : (double)(v / total) * 100;
}
