@using System.Text.Json
@using Ecorex.Application.Analisis
@using Ecorex.Application.Reporting
@inject IAnalisisWidgetRunner Runner
@inject IReportDataSource Datos
@implements IDisposable

@* Modal "Agregar / editar widget" (ADR-0158 Ola 3). Componente REUTILIZABLE: arma un WidgetDiseno
   (tipo -> fuente -> medida -> dimension -> filtros -> presentacion) o elige un indicador listo, muestra la
   vista previa en vivo con los filtros de la hoja y devuelve un AnalisisNuevoWidget al anfitrion. Solo
   habla con el catalogo que el anfitrion le pasa (Fuentes/Curados); el guardado lo hace el anfitrion.
   La vista previa espera la compuerta (Gate) del anfitrion para no solapar el DbContext del circuito. *@

<div class="we-backdrop" @onclick="() => OnCancelar.InvokeAsync()"></div>
<div class="we-modal" role="dialog" aria-modal="true" aria-label="Configurar widget">
    <div class="we-head">
        <h3>@(Inicial is null ? "Agregar widget" : "Editar widget")</h3>
        <button class="we-x" @onclick="() => OnCancelar.InvokeAsync()" aria-label="Cerrar">&#215;</button>
    </div>

    <div class="we-body">
        <div class="we-form">
            @Encabezado
            <div class="we-seg">
                <button class="@(_modoCurado || _modoCombinado ? "" : "on")" @onclick="() => CambiarModo(false)">Consulta</button>
                <button class="@(_modoCurado ? "on" : "")" @onclick="() => CambiarModo(true)">Indicador listo</button>
                <button class="@(_modoCombinado ? "on" : "")" @onclick="CambiarACombinado">Combinar fuentes</button>
            </div>

            <label class="we-lbl">Tipo</label>
            <div class="we-chips">
                @foreach (var t in TiposDelModo)
                {
                    <button class="we-chip @(_tipo == t.Tipo ? "on" : "")" @onclick="() => CambiarTipo(t.Tipo)">@t.Nombre</button>
                }
            </div>

            <label class="we-lbl">Titulo</label>
            <input class="we-input" value="@_titulo" @onchange="e => Cambiar(() => _titulo = e.Value?.ToString() ?? string.Empty)" maxlength="150" placeholder="Ej. Ventas por vendedor" />

            @if (_modoCombinado)
            {
                <AnalisisCombinadoEditor Fuentes="Fuentes" Diseno="_combinado" DisenoChanged="d => Cambiar(() => _combinado = d)" />
            }
            else if (_modoCurado)
            {
                <label class="we-lbl">Indicador</label>
                <select class="we-input" value="@_curadoKey" @onchange="e => Cambiar(() => _curadoKey = e.Value?.ToString())">
                    <option value="">Elige un indicador...</option>
                    @foreach (var c in Curados)
                    {
                        <option value="@c.Key">@c.Nombre</option>
                    }
                </select>
                @if (CuradoActual is { } cur)
                {
                    <p class="we-hint">@cur.Descripcion</p>
                }
            }
            else
            {
                <label class="we-lbl">Fuente de datos</label>
                <select class="we-input" value="@_sourceKey" @onchange="e => Cambiar(() => CambiarFuente(e.Value?.ToString()))">
                    <option value="">Elige una fuente...</option>
                    @foreach (var grupo in Fuentes.GroupBy(f => f.Kind))
                    {
                        <optgroup label="@NombreKind(grupo.Key)">
                            @foreach (var f in grupo.OrderBy(f => f.DisplayName))
                            {
                                <option value="@f.Key">@f.DisplayName</option>
                            }
                        </optgroup>
                    }
                </select>

                @if (Fuente is { } fuente)
                {
                    <label class="we-lbl">Medida</label>
                    <div class="we-row">
                        <select class="we-input" value="@_funcion" @onchange="e => Cambiar(() => _funcion = Enum.Parse<ReportAggregateFunction>(e.Value!.ToString()!))">
                            @foreach (var fn in Enum.GetValues<ReportAggregateFunction>())
                            {
                                <option value="@fn">@NombreFuncion(fn)</option>
                            }
                        </select>
                        @if (_funcion != ReportAggregateFunction.Count)
                        {
                            <select class="we-input" value="@_campoMedida" @onchange="e => Cambiar(() => _campoMedida = e.Value?.ToString())">
                                <option value="">Campo numerico...</option>
                                @foreach (var f in fuente.Fields.Where(f => f.CanAggregate))
                                {
                                    <option value="@f.Key">@f.DisplayName</option>
                                }
                            </select>
                        }
                    </div>

                    @if (WidgetDisenoMapper.UsaCampoFecha(_tipo))
                    {
                        <p class="we-hint">El calendario cuenta (o suma) por dia sobre el campo de fecha de la fuente; eligelo en Presentacion.</p>
                    }
                    else
                    {
                    <label class="we-lbl">Agrupar por @(WidgetDisenoMapper.PideDimension(_tipo) ? "" : "(opcional)")</label>
                    <div class="we-row">
                        <select class="we-input" value="@_dimension" @onchange="e => Cambiar(() => _dimension = e.Value?.ToString())">
                            <option value="">@(WidgetDisenoMapper.PideDimension(_tipo) ? "Elige un campo..." : "Sin agrupar (total)")</option>
                            @foreach (var f in fuente.Fields.Where(f => f.CanGroup))
                            {
                                <option value="@f.Key">@f.DisplayName</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(_dimension))
                        {
                            <select class="we-input" value="@OrdenValor" @onchange="CambiarOrden">
                                <option value="medida">Mayor a menor</option>
                                <option value="etiqueta">Por etiqueta</option>
                            </select>
                        }
                    </div>

                    @if (WidgetDisenoMapper.AdmiteDimension2(_tipo) && !string.IsNullOrEmpty(_dimension) && fuente.Kind == ReportSourceKind.Native)
                    {
                        <label class="we-lbl">@EtiquetaDimension2</label>
                        <select class="we-input" value="@_dimension2" @onchange="e => Cambiar(() => _dimension2 = e.Value?.ToString())">
                            <option value="">@(WidgetDisenoMapper.PideDimension2(_tipo) ? "Elige un campo..." : "Sin series (una sola)")</option>
                            @foreach (var f in fuente.Fields.Where(f => f.CanGroup && f.Key != _dimension))
                            {
                                <option value="@f.Key">@f.DisplayName</option>
                            }
                        </select>
                    }
                    }

                    <label class="we-lbl">Filtros</label>
                    @for (var i = 0; i < _filtros.Count; i++)
                    {
                        var idx = i;
                        var fl = _filtros[idx];
                        var campo = fuente.FindField(fl.Campo);
                        <div class="we-filter">
                            <select class="we-input" value="@fl.Campo" @onchange="e => FiltroCampo(idx, e.Value?.ToString())">
                                @foreach (var f in fuente.Fields.Where(f => f.CanFilter))
                                {
                                    <option value="@f.Key">@f.DisplayName</option>
                                }
                            </select>
                            <select class="we-input sm" value="@fl.Operador" @onchange="e => FiltroOperador(idx, e.Value?.ToString())">
                                @foreach (var op in OperadoresDe(campo))
                                {
                                    <option value="@op">@NombreOperador(op)</option>
                                }
                            </select>
                            @if (campo?.Type == ReportFieldType.Boolean)
                            {
                                <select class="we-input sm" value="@fl.Valor" @onchange="e => FiltroValor(idx, e.Value?.ToString(), false)">
                                    <option value="">...</option>
                                    <option value="true">Si</option>
                                    <option value="false">No</option>
                                </select>
                            }
                            else
                            {
                                var sug = Sugerencias(campo);
                                <input class="we-input sm" type="@TipoInput(campo)" value="@fl.Valor" placeholder="@(fl.Operador == ReportFilterOperator.In ? "a, b, c" : "valor")"
                                       list="@(sug.Count > 0 ? $"we-sug-{idx}" : null)" autocomplete="off"
                                       @onchange="e => FiltroValor(idx, e.Value?.ToString(), false)" />
                                @if (sug.Count > 0)
                                {
                                    <datalist id="we-sug-@idx">
                                        @foreach (var v in sug)
                                        {
                                            <option value="@v"></option>
                                        }
                                    </datalist>
                                }
                                @if (fl.Operador == ReportFilterOperator.Between)
                                {
                                    <input class="we-input sm" type="@TipoInput(campo)" value="@fl.Valor2" @onchange="e => FiltroValor(idx, e.Value?.ToString(), true)" />
                                }
                            }
                            <button class="we-ico" title="Quitar filtro" @onclick="() => QuitarFiltro(idx)">&#215;</button>
                        </div>
                    }
                    <button class="we-link" @onclick="AgregarFiltro">+ Agregar filtro</button>
                }
            }

            <details class="we-more" open="@(Inicial is not null)">
                <summary>Presentacion</summary>
                <div class="we-grid2">
                    <div>
                        <label class="we-lbl">Ancho</label>
                        <select class="we-input" value="@_colSpan" @onchange="e => Cambiar(() => _colSpan = int.Parse(e.Value!.ToString()!))">
                            @for (var c = 1; c <= 4; c++)
                            {
                                <option value="@c">@c columna@(c > 1 ? "s" : "")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="we-lbl">Formato</label>
                        <select class="we-input" value="@(_config.Formato ?? "numero")" @onchange="e => SetConfig(nameof(WidgetConfig.Formato), e.Value)">
                            <option value="numero">Numero</option>
                            <option value="decimal">Decimal</option>
                            <option value="moneda">Moneda</option>
                            <option value="porcentaje">Porcentaje</option>
                        </select>
                    </div>
                    <div>
                        <label class="we-lbl">Color</label>
                        <div class="we-tones">
                            @foreach (var tono in WidgetConfig.Tonos)
                            {
                                <button class="we-tone @(TonoActual == tono ? "on" : "")" style="background:var(--t-@tono)" title="@tono"
                                        @onclick="() => SetConfig(nameof(WidgetConfig.Tono), tono)"></button>
                            }
                        </div>
                    </div>
                    @if (!WidgetDisenoMapper.EsEscalar(_tipo) && !WidgetDisenoMapper.UsaCampoFecha(_tipo))
                    {
                        <div>
                            <label class="we-lbl">Categorias visibles</label>
                            <input class="we-input" type="number" min="1" max="50" value="@(_config.Top ?? AnalisisWidgetRunner.TopCategoriasPorDefecto)"
                                   @onchange="e => SetConfig(nameof(WidgetConfig.Top), e.Value)" />
                        </div>
                    }
                    @if (_tipo == AnalisisTipoWidget.Velocimetro)
                    {
                        <div>
                            <label class="we-lbl">Meta (tope del velocimetro)</label>
                            <input class="we-input" type="number" step="any" min="0" placeholder="Automatica" value="@_config.Meta"
                                   @onchange="e => SetConfig(nameof(WidgetConfig.Meta), e.Value)" />
                        </div>
                    }
                    @if (WidgetDisenoMapper.EsEscalar(_tipo) && !_modoCurado && !_modoCombinado)
                    {
                        <div>
                            <label class="we-lbl">Comparar con el periodo anterior</label>
                            <select class="we-input" value="@(_config.Periodo ?? "")" @onchange="e => SetConfig(nameof(WidgetConfig.Periodo), e.Value)">
                                <option value="">No comparar (total)</option>
                                @foreach (var p in KpiPeriodos.Opciones)
                                {
                                    <option value="@p.Clave">@p.Nombre</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                @if (WidgetDisenoMapper.EsEscalar(_tipo) && KpiPeriodos.EsValido(_config.Periodo) && !_modoCurado && !_modoCombinado)
                {
                    <p class="we-hint">El KPI mide solo ese periodo y muestra la variacion (al mismo corte) y su tendencia. Si la hoja tiene un rango de fechas completo, se compara ese rango con el anterior de igual largo.</p>
                }
                @if (WidgetDisenoMapper.EsEscalar(_tipo))
                {
                    <label class="we-lbl">Umbrales (semaforo del KPI, opcional)</label>
                    <div class="we-row">
                        <input class="we-input" type="number" step="any" placeholder="Alerta por debajo de" value="@_config.UmbralBajo"
                               @onchange="e => SetConfig(nameof(WidgetConfig.UmbralBajo), e.Value)" />
                        <input class="we-input" type="number" step="any" placeholder="Bien desde" value="@_config.UmbralAlto"
                               @onchange="e => SetConfig(nameof(WidgetConfig.UmbralAlto), e.Value)" />
                    </div>
                    <label class="we-check"><input type="checkbox" checked="@(!_config.MayorEsMejor)" @onchange="e => SetConfig(nameof(WidgetConfig.MayorEsMejor), e.Value)" /> Menor es mejor</label>
                }
                @if (!_modoCurado && !_modoCombinado && Fuente is { } fte)
                {
                    <label class="we-lbl">Campo de fecha (filtros de la hoja, periodos y calendario)</label>
                    <select class="we-input" value="@_campoFecha" @onchange="e => Cambiar(() => _campoFecha = e.Value?.ToString() ?? AutoFecha)">
                        <option value="@AutoFecha">Automatico (@(HojaFiltroBinder.Resolver(HojaFiltroBinder.Fecha, fte, null) is string auto ? fte.FindField(auto)?.DisplayName : "ninguno"))</option>
                        @foreach (var f in fte.Fields.Where(f => f.Type == ReportFieldType.Date && f.CanFilter))
                        {
                            <option value="@f.Key">@f.DisplayName</option>
                        }
                        <option value="@SinFecha">No aplicar el rango de fechas</option>
                    </select>
                }
            </details>
        </div>

        <div class="we-preview">
            <div class="we-preview-cap">Vista previa @(HojaFiltros is { Vacio: false } ? "(con los filtros de la hoja)" : "")</div>
            @if (_errores.Count > 0)
            {
                <ul class="we-errs">
                    @foreach (var err in _errores)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
            else
            {
                <div class="we-preview-grid">
                    <AnalisisWidgetCard Widget="PreviewDto" Resultado="_preview" />
                </div>
            }
        </div>
    </div>

    <div class="we-foot">
        <button class="we-btn" @onclick="() => OnCancelar.InvokeAsync()">Cancelar</button>
        <button class="we-btn primary" disabled="@(_errores.Count > 0 || _guardando)" @onclick="GuardarAsync">@(TextoGuardar ?? (Inicial is null ? "Agregar" : "Guardar cambios"))</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReportSourceDescriptor> Fuentes { get; set; } = Array.Empty<ReportSourceDescriptor>();

    [Parameter, EditorRequired] public IReadOnlyList<IIndicadorCurado> Curados { get; set; } = Array.Empty<IIndicadorCurado>();

    /// <summary>Widget a editar (null = nuevo).</summary>
    [Parameter] public AnalisisWidgetDto? Inicial { get; set; }

    /// <summary>Filtros de la hoja, para que la vista previa muestre lo mismo que la grilla.</summary>
    [Parameter] public HojaFiltros? HojaFiltros { get; set; }

    /// <summary>Compuerta del anfitrion: una consulta a la vez por circuito.</summary>
    [Parameter] public SemaphoreSlim? Gate { get; set; }

    /// <summary>Fuente preseleccionada para un widget nuevo (crear un indicador desde otro modulo).</summary>
    [Parameter] public string? FuenteInicial { get; set; }

    /// <summary>Filtros con los que arranca un widget nuevo (p. ej. el tablero desde el que se abre).</summary>
    [Parameter] public IReadOnlyList<WidgetFiltroDiseno>? FiltrosIniciales { get; set; }

    /// <summary>Texto del boton principal; por defecto "Agregar" / "Guardar cambios".</summary>
    [Parameter] public string? TextoGuardar { get; set; }

    /// <summary>Contenido del anfitrion al inicio del formulario (p. ej. el libro / hoja destino).</summary>
    [Parameter] public RenderFragment? Encabezado { get; set; }

    [Parameter] public EventCallback<AnalisisNuevoWidget> OnGuardar { get; set; }

    [Parameter] public EventCallback OnCancelar { get; set; }

    private const string AutoFecha = "__auto";
    private const string SinFecha = "__none";

    private bool _modoCurado;
    private bool _modoCombinado;
    private CombinadoDiseno _combinado = new();
    private AnalisisTipoWidget _tipo = AnalisisTipoWidget.Kpi;
    private string _titulo = string.Empty;
    private string? _curadoKey;
    private string? _sourceKey;
    private ReportAggregateFunction _funcion = ReportAggregateFunction.Count;
    private string? _campoMedida;
    private string? _dimension;
    private string? _dimension2;
    private bool _ordenarPorMedida = true;
    private List<WidgetFiltroDiseno> _filtros = new();
    private int _colSpan = 1;
    private WidgetConfig _config = new();
    private string _campoFecha = AutoFecha;
    private IReadOnlyList<string> _errores = Array.Empty<string>();
    private AnalisisWidgetResultado? _preview;
    private bool _guardando;
    private int _previewVersion;
    private CancellationTokenSource? _cts;
    private readonly Guid _previewId = Guid.NewGuid();

    private ReportSourceDescriptor? Fuente => Fuentes.FirstOrDefault(f => f.Key == _sourceKey);

    private IIndicadorCurado? CuradoActual => Curados.FirstOrDefault(c => c.Key == _curadoKey);

    private string TonoActual => _config.Tono ?? "blue";

    /// <summary>
    /// Tipos que ofrece el modo actual: el calendario solo en Consulta (necesita el campo de fecha de una
    /// fuente) y el combinado no pinta mapa de calor.
    /// </summary>
    private IEnumerable<(AnalisisTipoWidget Tipo, string Nombre, bool PideDimension)> TiposDelModo =>
        WidgetDisenoMapper.Tipos.Where(t =>
            !((_modoCurado || _modoCombinado) && WidgetDisenoMapper.UsaCampoFecha(t.Tipo))
            && !(_modoCombinado && t.Tipo == AnalisisTipoWidget.Heatmap));

    private AnalisisWidgetDto PreviewDto { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (Inicial is { } w)
        {
            _colSpan = w.ColSpan;
            _config = WidgetConfig.Leer(w.ConfigJson);
            _tipo = w.Tipo;
            _titulo = w.Titulo;
            var bindings = HojaFiltroBinder.LeerBindings(w.ContextBindingsJson);
            if (bindings.TryGetValue(HojaFiltroBinder.Fecha, out var bf))
            {
                _campoFecha = string.IsNullOrEmpty(bf) ? SinFecha : bf;
            }

            if (w.IndicadorKey == CombinadoDiseno.IndicadorKey)
            {
                _modoCombinado = true;
                _combinado = _config.Combinado ?? NuevoCombinado();
            }
            else if (!string.IsNullOrWhiteSpace(w.IndicadorKey))
            {
                _modoCurado = true;
                _curadoKey = w.IndicadorKey;
            }
            else
            {
                var d = WidgetDisenoMapper.FromWidget(w);
                _sourceKey = d.SourceKey;
                _funcion = d.Funcion;
                _campoMedida = d.CampoMedida;
                _dimension = d.Dimension;
                _dimension2 = d.Dimension2;
                _ordenarPorMedida = d.OrdenarPorMedida;
                _filtros = d.Filtros.ToList();
            }
        }
        else if (!string.IsNullOrWhiteSpace(FuenteInicial) && Fuentes.Any(f => f.Key == FuenteInicial))
        {
            CambiarFuente(FuenteInicial);
            var campos = Fuente!.Fields.Where(f => f.CanFilter).Select(f => f.Key).ToHashSet();
            _filtros = (FiltrosIniciales ?? Array.Empty<WidgetFiltroDiseno>()).Where(f => campos.Contains(f.Campo)).ToList();
        }

        await RefrescarAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _disposed = true;
    }

    // ---- Sugerencias de valores para los filtros de texto (valores reales de la fuente, mas frecuentes primero) ----

    private const int MaxSugerencias = 50;
    private readonly Dictionary<string, IReadOnlyList<string>> _sugerencias = new();
    private readonly HashSet<string> _sugCargando = new();
    private bool _disposed;

    private static bool AdmiteSugerencias(ReportField? campo) =>
        campo is { Type: ReportFieldType.Text, CanGroup: true };

    private string ClaveSug(string campo) => $"{_sourceKey}|{campo}";

    private IReadOnlyList<string> Sugerencias(ReportField? campo) =>
        AdmiteSugerencias(campo) && _sugerencias.TryGetValue(ClaveSug(campo!.Key), out var l) ? l : Array.Empty<string>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Fuente is not { } fuente || _sourceKey is null)
        {
            return;
        }

        var pendientes = _filtros
            .Select(f => fuente.FindField(f.Campo))
            .Where(c => AdmiteSugerencias(c) && !_sugerencias.ContainsKey(ClaveSug(c!.Key)) && !_sugCargando.Contains(ClaveSug(c.Key)))
            .Select(c => c!.Key)
            .Distinct()
            .ToList();
        if (pendientes.Count == 0)
        {
            return;
        }

        foreach (var campo in pendientes)
        {
            _sugCargando.Add(ClaveSug(campo));
        }

        foreach (var campo in pendientes)
        {
            var clave = ClaveSug(campo);
            _sugerencias[clave] = await CargarSugerenciasAsync(_sourceKey, campo);
            if (_disposed)
            {
                return;
            }
        }

        StateHasChanged();
    }

    /// <summary>Valores distintos del campo (conteo agrupado, top 50) por la misma compuerta que la vista previa.</summary>
    private async Task<IReadOnlyList<string>> CargarSugerenciasAsync(string sourceKey, string campo)
    {
        var spec = new ReportQuerySpec
        {
            SourceKey = sourceKey,
            GroupBy = new[] { campo },
            Aggregates = new[] { new ReportAggregate(string.Empty, ReportAggregateFunction.Count) }
        };

        try
        {
            if (Gate is not null)
            {
                await Gate.WaitAsync();
            }

            ReportDataSet ds;
            try
            {
                ds = await Datos.QueryAsync(spec, new ReportContext(Guid.Empty));
            }
            finally
            {
                Gate?.Release();
            }

            return ds.Rows
                .Where(r => r.Count > 1 && r[0] is not null && !string.IsNullOrWhiteSpace(r[0]!.ToString()))
                .OrderByDescending(r => Convert.ToDecimal(r[1] ?? 0, System.Globalization.CultureInfo.InvariantCulture))
                .Select(r => r[0]!.ToString()!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(MaxSugerencias)
                .ToList();
        }
        catch (Exception ex) when (ex is ReportValidationException or InvalidOperationException or ObjectDisposedException)
        {
            return Array.Empty<string>(); // sin sugerencias: el campo se sigue escribiendo a mano
        }
    }

    private Task Cambiar(Action cambio)
    {
        cambio();
        return RefrescarAsync();
    }

    private Task CambiarModo(bool curado) => Cambiar(() =>
    {
        _modoCurado = curado;
        _modoCombinado = false;
        if (curado && WidgetDisenoMapper.UsaCampoFecha(_tipo))
        {
            _tipo = AnalisisTipoWidget.Barras; // un indicador listo no tiene campo de fecha propio
        }
    });

    private Task CambiarACombinado() => Cambiar(() =>
    {
        _modoCombinado = true;
        _modoCurado = false;
        if (_combinado.Series.Count == 0)
        {
            _combinado = NuevoCombinado();
        }

        if (_tipo is AnalisisTipoWidget.Heatmap or AnalisisTipoWidget.Calendario)
        {
            _tipo = AnalisisTipoWidget.Barras; // el combinado no pinta mapa de calor ni calendario
        }
    });

    /// <summary>Arranca con la fuente que ya estaba elegida como serie A (y una serie B vacia).</summary>
    private CombinadoDiseno NuevoCombinado() => new()
    {
        Series = new[]
        {
            new SerieCombinada { Nombre = Fuente?.DisplayName ?? "Serie A", SourceKey = _sourceKey ?? string.Empty, Dimension = _dimension ?? string.Empty, Funcion = _funcion, CampoMedida = _campoMedida },
            new SerieCombinada { Nombre = "Serie B" }
        }
    };

    /// <summary>Linea/area/mapa de calor se leen en el orden del eje; el resto, de mayor a menor.</summary>
    private Task CambiarTipo(AnalisisTipoWidget tipo) => Cambiar(() =>
    {
        _tipo = tipo;
        _ordenarPorMedida = !WidgetDisenoMapper.OrdenPorEjePorDefecto(tipo);
        // Series, mapas, pilas y tabla necesitan espacio (2 columnas); el calendario, el ancho completo.
        _colSpan = Math.Max(_colSpan, WidgetDisenoMapper.AnchoSugerido(tipo));
    });

    private string EtiquetaDimension2 => _tipo switch
    {
        AnalisisTipoWidget.Heatmap => "Columnas",
        AnalisisTipoWidget.BarrasApiladas => "Apilar por (opcional)",
        AnalisisTipoWidget.Treemap => "Segundo nivel (opcional)",
        _ => "Series (opcional)"
    };

    private void CambiarFuente(string? key)
    {
        _sourceKey = string.IsNullOrEmpty(key) ? null : key;
        _campoMedida = null;
        _dimension = null;
        _dimension2 = null;
        _filtros = new();
        _campoFecha = AutoFecha;
        if (Fuente is { } f && string.IsNullOrWhiteSpace(_titulo))
        {
            _titulo = f.DisplayName;
        }
    }

    private Task AgregarFiltro()
    {
        var primero = Fuente?.Fields.FirstOrDefault(f => f.CanFilter);
        if (primero is null)
        {
            return Task.CompletedTask;
        }

        return Cambiar(() => _filtros.Add(new WidgetFiltroDiseno(primero.Key, OperadoresDe(primero)[0], null)));
    }

    private Task QuitarFiltro(int i) => Cambiar(() => _filtros.RemoveAt(i));

    private Task CambiarFiltro(int i, WidgetFiltroDiseno f) => Cambiar(() => _filtros[i] = f);

    /// <summary>Cambia una propiedad de la presentacion (los with-expressions no caben en atributos Razor).</summary>
    private Task SetConfig(string prop, object? valor) => Cambiar(() =>
    {
        var texto = valor?.ToString();
        _config = prop switch
        {
            nameof(WidgetConfig.Formato) => _config with { Formato = texto },
            nameof(WidgetConfig.Tono) => _config with { Tono = texto },
            nameof(WidgetConfig.Top) => _config with { Top = int.TryParse(texto, out var n) ? n : null },
            nameof(WidgetConfig.UmbralBajo) => _config with { UmbralBajo = Dec(texto) },
            nameof(WidgetConfig.UmbralAlto) => _config with { UmbralAlto = Dec(texto) },
            nameof(WidgetConfig.MayorEsMejor) => _config with { MayorEsMejor = valor is not true },
            nameof(WidgetConfig.Meta) => _config with { Meta = Dec(texto) },
            nameof(WidgetConfig.Periodo) => _config with { Periodo = string.IsNullOrWhiteSpace(texto) ? null : texto },
            _ => _config
        };
    });

    private string OrdenValor => _ordenarPorMedida ? "medida" : "etiqueta";

    private Task CambiarOrden(ChangeEventArgs e) => Cambiar(() => _ordenarPorMedida = e.Value?.ToString() == "medida");

    private Task FiltroCampo(int i, string? campo)
    {
        var key = campo ?? string.Empty;
        return CambiarFiltro(i, new WidgetFiltroDiseno(key, OperadoresDe(Fuente?.FindField(key))[0], null));
    }

    private Task FiltroOperador(int i, string? op) =>
        Enum.TryParse<ReportFilterOperator>(op, out var o) ? CambiarFiltro(i, _filtros[i] with { Operador = o }) : Task.CompletedTask;

    private Task FiltroValor(int i, string? valor, bool segundo) =>
        CambiarFiltro(i, segundo ? _filtros[i] with { Valor2 = valor } : _filtros[i] with { Valor = valor });

    private string? Bindings() => _campoFecha switch
    {
        AutoFecha => null,
        SinFecha => JsonSerializer.Serialize(new Dictionary<string, string> { [HojaFiltroBinder.Fecha] = string.Empty }),
        var campo => JsonSerializer.Serialize(new Dictionary<string, string> { [HojaFiltroBinder.Fecha] = campo })
    };

    private WidgetDiseno Diseno() => new()
    {
        Tipo = _tipo,
        Titulo = _titulo.Trim(),
        SourceKey = _sourceKey ?? string.Empty,
        Funcion = _funcion,
        CampoMedida = _campoMedida,
        // El calendario agrega sobre la fecha: no lleva dimension aunque quedara una de otro tipo.
        Dimension = WidgetDisenoMapper.UsaCampoFecha(_tipo) ? null : _dimension,
        Dimension2 = WidgetDisenoMapper.UsaCampoFecha(_tipo) ? null : _dimension2,
        Filtros = _filtros.ToList(),
        OrdenarPorMedida = _ordenarPorMedida,
        ColSpan = _colSpan,
        Config = _config with { Combinado = null }
    };

    /// <summary>Lo que se guardaria ahora mismo (o null si hay errores).</summary>
    private AnalisisNuevoWidget? Construir(out IReadOnlyList<string> errores)
    {
        if (_modoCombinado)
        {
            var lista = _combinado.Validar(Fuentes).ToList();
            if (string.IsNullOrWhiteSpace(_titulo))
            {
                lista.Insert(0, "Ponle un titulo al widget.");
            }

            if (_tipo is AnalisisTipoWidget.Heatmap or AnalisisTipoWidget.Calendario)
            {
                lista.Add("El widget combinado no admite mapa de calor ni calendario.");
            }

            errores = lista;
            var cfgCombinado = WidgetDisenoMapper.LimpiarConfig(_tipo, _config) with { Combinado = _combinado, Periodo = null };
            return lista.Count > 0
                ? null
                : new AnalisisNuevoWidget(_tipo, _titulo.Trim(), null, CombinadoDiseno.IndicadorKey, _colSpan, cfgCombinado.ToJson());
        }

        if (_modoCurado)
        {
            var lista = new List<string>();
            if (string.IsNullOrWhiteSpace(_titulo))
            {
                lista.Add("Ponle un titulo al widget.");
            }

            if (CuradoActual is null)
            {
                lista.Add("Elige un indicador.");
            }

            if (WidgetDisenoMapper.UsaCampoFecha(_tipo))
            {
                lista.Add("Los indicadores listos no admiten calendario.");
            }

            errores = lista;
            var cfgCurado = WidgetDisenoMapper.LimpiarConfig(_tipo, _config) with { Combinado = null, Periodo = null };
            return lista.Count > 0 ? null : new AnalisisNuevoWidget(_tipo, _titulo.Trim(), null, _curadoKey, _colSpan, cfgCurado.ToJson());
        }

        var d = Diseno();
        errores = WidgetDisenoMapper.Validar(d, Fuente, Bindings());
        return errores.Count > 0 ? null : WidgetDisenoMapper.ToNuevoWidget(d, Bindings());
    }

    private async Task RefrescarAsync()
    {
        var nuevo = Construir(out var errores);
        _errores = errores;
        if (nuevo is null)
        {
            _preview = null;
            return;
        }

        PreviewDto = new AnalisisWidgetDto(_previewId, Guid.Empty, nuevo.Tipo, nuevo.Titulo,
            nuevo.Spec is null ? null : AnalisisJson.Serialize(nuevo.Spec), nuevo.IndicadorKey, nuevo.ConfigJson, 0, 1, 1, nuevo.ContextBindingsJson);
        _preview = null;
        var version = ++_previewVersion;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        StateHasChanged();

        try
        {
            // Pequena espera: si el usuario sigue cambiando campos, solo corre la ultima consulta.
            await Task.Delay(250, ct);
            if (Gate is not null)
            {
                await Gate.WaitAsync(ct);
            }

            try
            {
                var r = await Runner.RunAsync(PreviewDto, new ReportContext(Guid.Empty), ct, HojaFiltros);
                if (version == _previewVersion)
                {
                    _preview = r;
                }
            }
            finally
            {
                Gate?.Release();
            }
        }
        catch (OperationCanceledException)
        {
            // Llego un cambio mas nuevo.
        }
    }

    private async Task GuardarAsync()
    {
        var nuevo = Construir(out var errores);
        if (nuevo is null)
        {
            _errores = errores;
            return;
        }

        _guardando = true;
        try
        {
            await OnGuardar.InvokeAsync(nuevo);
        }
        finally
        {
            _guardando = false;
        }
    }

    private static decimal? Dec(object? v) =>
        decimal.TryParse(v?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    private static string TipoInput(ReportField? f) => f?.Type switch
    {
        ReportFieldType.Date => "date",
        ReportFieldType.Number or ReportFieldType.Decimal => "number",
        _ => "text"
    };

    private static ReportFilterOperator[] OperadoresDe(ReportField? f) => f?.Type switch
    {
        ReportFieldType.Boolean => new[] { ReportFilterOperator.Equals },
        ReportFieldType.Date => new[] { ReportFilterOperator.Between, ReportFilterOperator.GreaterThanOrEqual, ReportFilterOperator.LessThanOrEqual },
        ReportFieldType.Number or ReportFieldType.Decimal => new[]
        {
            ReportFilterOperator.Equals, ReportFilterOperator.GreaterThan, ReportFilterOperator.GreaterThanOrEqual,
            ReportFilterOperator.LessThan, ReportFilterOperator.LessThanOrEqual, ReportFilterOperator.Between
        },
        _ => new[] { ReportFilterOperator.Equals, ReportFilterOperator.NotEquals, ReportFilterOperator.Contains, ReportFilterOperator.In }
    };

    private static string NombreOperador(ReportFilterOperator op) => op switch
    {
        ReportFilterOperator.Equals => "es",
        ReportFilterOperator.NotEquals => "no es",
        ReportFilterOperator.Contains => "contiene",
        ReportFilterOperator.In => "es uno de",
        ReportFilterOperator.GreaterThan => "mayor que",
        ReportFilterOperator.GreaterThanOrEqual => "desde",
        ReportFilterOperator.LessThan => "menor que",
        ReportFilterOperator.LessThanOrEqual => "hasta",
        ReportFilterOperator.Between => "entre",
        _ => op.ToString()
    };

    private static string NombreFuncion(ReportAggregateFunction fn) => fn switch
    {
        ReportAggregateFunction.Count => "Conteo de registros",
        ReportAggregateFunction.Sum => "Suma",
        ReportAggregateFunction.Avg => "Promedio",
        ReportAggregateFunction.Min => "Minimo",
        ReportAggregateFunction.Max => "Maximo",
        _ => fn.ToString()
    };

    private static string NombreKind(ReportSourceKind k) => k switch
    {
        ReportSourceKind.Native => "Sistema",
        ReportSourceKind.Container => "Contenedores de datos",
        ReportSourceKind.External => "Fuentes externas",
        _ => k.ToString()
    };
}
