@* Politica de confidencialidad del tenant (ADR-0160). Un BOTON abre un MODAL con pestanas
   (Configurar / HTML / Vista previa). Editor HTML + vista previa saneada, link PERMANENTE
   /pc/{token} con copiar/regenerar, toggle de captura de datos y listado de constancias.
   Tenant-scoped por el servicio. *@
@using Ecorex.Application.Confidentiality
@using Microsoft.AspNetCore.Components
@inject IConfidentialityPolicyService PolicySvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="cp-trigger">
    <div class="cp-trigger-txt">
        <strong>Politica de confidencialidad</strong>
        <span>Publicala por un enlace permanente; quien lo abre la lee y deja constancia de aceptacion.</span>
    </div>
    <button class="btn btn-outline-primary" @onclick="OpenAsync">Configurar politica</button>
</div>

@if (_open)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-dialog cp-dialog" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2 style="margin:0;font-size:1.05rem;">Politica de confidencialidad</h2>
                <button class="modal-close" @onclick="Close">&times;</button>
            </div>
            <div class="modal-body">
                @if (_loading)
                {
                    <p><em>Cargando...</em></p>
                }
                else
                {
                    <nav class="cp-tabs" role="tablist">
                        <button class="cp-tab @(_tab == Tab.Config ? "is-active" : "")" @onclick="@(() => _tab = Tab.Config)">Configurar</button>
                        <button class="cp-tab @(_tab == Tab.Html ? "is-active" : "")" @onclick="@(() => _tab = Tab.Html)">HTML</button>
                        <button class="cp-tab @(_tab == Tab.Preview ? "is-active" : "")" @onclick="@(() => _tab = Tab.Preview)">Vista previa</button>
                    </nav>

                    @if (_tab == Tab.Config)
                    {
                        <div class="cp-pane">
                            <label class="cp-field">
                                <span>Titulo</span>
                                <input class="form-control" @bind="_titulo" maxlength="200" placeholder="Politica de confidencialidad" />
                            </label>

                            <label class="cp-toggle">
                                <input type="checkbox" @bind="_activa" />
                                <span>Enlace activo (si lo desactivas, el link muestra un mensaje neutro)</span>
                            </label>

                            <label class="cp-toggle">
                                <input type="checkbox" @bind="_capturaDatos" />
                                <span>Capturar datos del cliente (nombre e identificacion). Si lo dejas apagado, la aceptacion es solo un checkbox.</span>
                            </label>

                            @if (_saved is not null && !string.IsNullOrEmpty(_saved.PublicToken))
                            {
                                <div class="cp-link">
                                    <span class="cp-link-label">Enlace permanente (no vence)</span>
                                    <div class="cp-link-row">
                                        <input class="form-control" readonly value="@PublicUrl" />
                                        <button class="btn btn-outline-primary" @onclick="CopyLinkAsync">Copiar</button>
                                        <a class="btn btn-outline-primary" href="@PublicUrl" target="_blank" rel="noopener">Abrir</a>
                                        <button class="btn btn-outline-danger" @onclick="RegenerateAsync" disabled="@_busy"
                                                title="Genera un enlace nuevo; el anterior deja de funcionar">Regenerar</button>
                                    </div>
                                    @if (_copied)
                                    {
                                        <small class="cp-ok">Copiado al portapapeles.</small>
                                    }
                                </div>

                                <div class="cp-accept">
                                    <div class="cp-accept-head">
                                        <h3>Constancias de aceptacion</h3>
                                        <span class="cp-count">@_acceptances.Count</span>
                                    </div>
                                    @if (_acceptances.Count == 0)
                                    {
                                        <p class="cp-empty">Aun no hay aceptaciones.</p>
                                    }
                                    else
                                    {
                                        <div class="cp-table-wrap">
                                            <table class="table cp-table">
                                                <thead>
                                                    <tr><th>Nombre</th><th>Identificacion</th><th>Correo</th><th>Fecha</th><th>Version</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var a in _acceptances)
                                                    {
                                                        <tr>
                                                            <td>@(string.IsNullOrWhiteSpace(a.Nombre) ? "(sin datos)" : a.Nombre)</td>
                                                            <td>@(string.IsNullOrWhiteSpace(a.Identificacion) ? "-" : a.Identificacion)</td>
                                                            <td>@(string.IsNullOrWhiteSpace(a.Correo) ? "-" : a.Correo)</td>
                                                            <td>@a.AceptadoAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                                            <td>v@(a.PolicyVersionSnapshot)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="cp-help">Guarda la politica para generar el enlace permanente.</p>
                            }
                        </div>
                    }
                    else if (_tab == Tab.Html)
                    {
                        <div class="cp-pane">
                            <label class="cp-field">
                                <span>Contenido (HTML)</span>
                                <textarea class="form-control cp-editor" rows="16" @bind="_contenido" @bind:event="oninput"
                                          placeholder="&lt;h2&gt;Politica de confidencialidad&lt;/h2&gt;&lt;p&gt;...&lt;/p&gt;"></textarea>
                                <small class="cp-help">Se permite formato basico (titulos, parrafos, listas, negrita, enlaces, tablas, imagenes incluidas las de tipo data:image base64). El contenido se depura al guardar por seguridad.</small>
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="cp-pane">
                            <span class="cp-preview-label">Vista previa (tal como la vera el cliente)</span>
                            <div class="cp-preview">@((MarkupString)ConfidentialityHtmlSanitizer.Sanitize(_contenido))</div>
                        </div>
                    }
                }
            </div>
            <div class="modal-foot" style="display:flex;justify-content:flex-end;gap:10px;align-items:center;">
                @if (_saved is not null)
                {
                    <span class="cp-ok">Guardado (v@(_saved.Version)).</span>
                }
                <button class="btn btn-outline-secondary" @onclick="Close">Cerrar</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar politica")</button>
            </div>
        </div>
    </div>
}

@code {
    private enum Tab { Config, Html, Preview }

    private bool _open;
    private bool _loaded;
    private bool _loading;
    private bool _busy;
    private bool _copied;
    private Tab _tab = Tab.Config;

    private string _titulo = "Politica de confidencialidad";
    private string _contenido = string.Empty;
    private bool _activa = true;
    private bool _capturaDatos;

    private ConfidentialityPolicyDto? _saved;
    private IReadOnlyList<ConfidentialityAcceptanceDto> _acceptances = [];

    private string PublicUrl => _saved is null ? string.Empty : $"{Nav.BaseUri}pc/{_saved.PublicToken}";

    private async Task OpenAsync()
    {
        _open = true;
        _tab = Tab.Config;
        if (_loaded) { return; }

        _loading = true;
        try
        {
            _saved = await PolicySvc.GetForTenantAsync();
            if (_saved is not null)
            {
                _titulo = _saved.Titulo;
                _contenido = _saved.Contenido;
                _activa = _saved.Activa;
                _capturaDatos = _saved.CapturaDatos;
                _acceptances = await PolicySvc.ListAcceptancesAsync();
            }
            _loaded = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Close() => _open = false;

    private async Task SaveAsync()
    {
        _busy = true;
        _copied = false;
        try
        {
            _saved = await PolicySvc.SaveAsync(new ConfidentialityPolicySaveRequest(_titulo, _contenido, _activa, _capturaDatos));
            _titulo = _saved.Titulo;
            _contenido = _saved.Contenido;
            _activa = _saved.Activa;
            _capturaDatos = _saved.CapturaDatos;
            _acceptances = await PolicySvc.ListAcceptancesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateAsync()
    {
        _busy = true;
        _copied = false;
        try
        {
            var updated = await PolicySvc.RegenerateLinkAsync();
            if (updated is not null) { _saved = updated; }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", PublicUrl);
            _copied = true;
        }
        catch
        {
            _copied = false;
        }
    }
}
