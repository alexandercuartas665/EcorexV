    private async Task LoadRunsAsync()
    {
        _runsBusy = true;
        try { _runs = (await WorkflowSvc.ListRecentRunsAsync(_filtroId, 30)).ToList(); }
        catch { _runs = new(); }
        finally { _runsBusy = false; }
    }

    private static string RunLabel(ContactWorkflowRunStatus st) => st switch
    {
        ContactWorkflowRunStatus.Sent => "Enviado",
        ContactWorkflowRunStatus.Failed => "Fallo",
        ContactWorkflowRunStatus.Skipped => "Omitido",
        _ => "Pendiente"
    };

    private static string RunCss(ContactWorkflowRunStatus st) => st switch
    {
        ContactWorkflowRunStatus.Sent => "ok",
        ContactWorkflowRunStatus.Failed => "err",
        _ => "warn"
    };

    private static void SetModo(StepVM s, object? val) => s.Modo = val?.ToString() == "ia" ? "ia" : "crm";

    private static string ObjetivoLabel(ContactCallObjetivo o) => o switch
    {
        ContactCallObjetivo.OfrecerProducto => "Ofrecer producto",
        ContactCallObjetivo.LlenarFormulario => "Llenar formulario",
        ContactCallObjetivo.Personalizado => "Personalizado",
        _ => o.ToString()
    };

    private static void ToggleForm(StepVM s, Guid formId, bool on)
    {
        if (on)
        {
            if (!s.FormulariosPermitidos.Contains(formId)) { s.FormulariosPermitidos.Add(formId); }
        }
        else
        {
            s.FormulariosPermitidos.Remove(formId);
        }
    }

    private sealed class StepVM
    {
        // Id del paso guardado (null = nuevo). Conservarlo evita recrear el paso y perder su historial.
        public Guid? Id { get; set; }
        public ContactWorkflowStepType StepType { get; set; }
        public string Label { get; set; } = "";
        public string? Comercial { get; set; }
        public string? Prioridad { get; set; }
        public string? Categoria { get; set; }
        public string? Subcategoria { get; set; }
        // Paso Llamada, modo IA (ADR-0056): "crm" (null/default) | "ia".
        public string? Modo { get; set; }
        public Guid? AgenteId { get; set; }
        public string? PromptExtra { get; set; }
        public string? Objetivo { get; set; }
        public List<Guid> FormulariosPermitidos { get; } = new();
        // Paso E-mail: plantilla seleccionada (Id como texto). Se replica a todas sus ventanas al guardar.
        public string? EmailTemplateId { get; set; }
        // Paso WhatsApp: linea, texto libre (Evolution/Emulator) o plantilla aprobada + mapeo (YCloud/Cloud).
        public Guid? WaLineaId { get; set; }
        public string? WaTexto { get; set; }
        public Guid? WaPlantillaId { get; set; }
        public Dictionary<string, string> WaVars { get; } = new();
        public List<ScheduleVM> Schedules { get; } = new();
    }

    private sealed class ScheduleVM
    {
        public Guid? Id { get; set; }
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
        public string StartTime { get; set; } = "09:00";
        public string EndTime { get; set; } = "18:00";
        public HashSet<int> ActiveDays { get; set; } = new();
        public int? RepeatEvery { get; set; }
        public int? PackageSize { get; set; }
        public string? TemplateId { get; set; }
        public Guid? AccountId { get; set; }
    }
