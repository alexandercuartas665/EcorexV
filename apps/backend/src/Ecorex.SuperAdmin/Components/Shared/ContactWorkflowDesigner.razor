@* ContactWorkflowDesigner: disenador de acciones por filtro de contactos (ADR-0056, Fase 1).
   Port del ucWorkflowDesigner legacy como LISTA SECUENCIAL de pasos (no grafo BPMN). Paleta de 5
   acciones (Conectar / Mensaje Red / WhatsApp / E-mail / Llamada CRM), pasos reordenables, campos
   CRM del paso Llamada y N ventanas de horario por paso. Guarda via IContactWorkflowService.
   El host lo abre por @@ref: OpenAsync(filtroId, nombre). La EJECUCION (Fase 2) la hace el
   ContactWorkflowDispatcher/ContactWorkflowWorker; aqui SOLO se guarda la configuracion.
   Estilos scoped en ContactWorkflowDesigner.razor.css.
   Solo ASCII. *@
@using Ecorex.Application.Tenancy
@using Ecorex.Application.Gestor
@using Ecorex.Application.Forms
@using Ecorex.Domain.Enums
@inject IContactWorkflowService WorkflowSvc
@inject IEmailTemplateService EmailTemplateSvc
@inject IAiAgentService AiAgentSvc
@inject IFormDefinitionService FormDefSvc
@inject IWhatsAppLineService WaLineSvc
@inject IWhatsAppTemplateService WaTemplateSvc

@if (_open)
{
    <div class="cw-overlay" @onclick="Close">
        <div class="cw-modal" @onclick:stopPropagation="true">
            <div class="cw-head">
                <div>
                    <div class="cw-kicker">DISENADOR DE ACCIONES &#183; FILTRO</div>
                    <div class="cw-title">@_filtroNombre</div>
                    <div class="cw-sub">Secuencia de acciones que se ejecutara sobre los contactos de este filtro.</div>
                </div>
                <div class="cw-head-right">
                    <label class="cw-switch" title="Activar / desactivar el workflow">
                        <input type="checkbox" checked="@_activo" @onchange="e => _activo = (bool)(e.Value ?? false)" />
                        <span>@(_activo ? "Activo" : "Inactivo")</span>
                    </label>
                    <button class="cw-close" @onclick="Close">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>

            <div class="cw-fase2-note">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg>
                Motor <b>programado</b>: mientras el workflow este Activo, cada paso se dispara sobre los contactos del filtro dentro de su ventana de horario (una vez por contacto y dia, respetando tamano de paquete).
            </div>

            <div class="cw-body">
                @* ---- Paleta de acciones ---- *@
                <div class="cw-palette">
                    <div class="cw-palette-lbl">ACCIONES</div>
                    @foreach (var p in Palette)
                    {
                        var pp = p;
                        <button class="cw-pal-card" style="--pal:@pp.Color" @onclick="() => AddStep(pp.Type)" title="Agregar paso @pp.Label">
                            <span class="cw-pal-ic" style="background:@pp.Color">@((MarkupString)pp.Icon)</span>
                            <span class="cw-pal-txt">
                                <span class="cw-pal-name">@pp.Label</span>
                                <span class="cw-pal-sub">@pp.Sub</span>
                            </span>
                            <span class="cw-pal-add">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                            </span>
                        </button>
                    }
                </div>

                @* ---- Lista secuencial de pasos ---- *@
                <div class="cw-steps">
                    <div class="cw-steps-lbl">SECUENCIA (@_steps.Count paso@(_steps.Count == 1 ? "" : "s"))</div>
                    @if (_steps.Count == 0)
                    {
                        <div class="cw-empty">
                            Agrega acciones desde la paleta de la izquierda para armar la secuencia.
                        </div>
                    }
                    @for (var i = 0; i < _steps.Count; i++)
                    {
                        var idx = i;
                        var st = _steps[idx];
                        var meta = MetaFor(st.StepType);
                        <div class="cw-step" style="--pal:@meta.Color">
                            <div class="cw-step-head">
                                <span class="cw-step-order">@(idx + 1)</span>
                                <span class="cw-step-ic" style="background:@meta.Color">@((MarkupString)meta.Icon)</span>
                                <div class="cw-step-titles">
                                    <input class="cw-step-label" @bind="st.Label" />
                                    <span class="cw-step-type">@meta.Label &#183; @meta.Sub</span>
                                </div>
                                <div class="cw-step-tools">
                                    <button class="cw-icon" title="Subir" disabled="@(idx == 0)" @onclick="() => MoveStep(idx, -1)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6" /></svg>
                                    </button>
                                    <button class="cw-icon" title="Bajar" disabled="@(idx == _steps.Count - 1)" @onclick="() => MoveStep(idx, 1)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                                    </button>
                                    <button class="cw-icon del" title="Quitar paso" @onclick="() => _steps.RemoveAt(idx)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                                    </button>
                                </div>
                            </div>

                            @* Config del paso Llamada: modo CRM (gestion, comportamiento actual) o IA (llamada con agente). *@
                            @if (st.StepType == ContactWorkflowStepType.Llamada)
                            {
                                <div class="cw-call">
                                    <div class="cw-field" style="grid-column:1/-1;">
                                        <label>Tipo de llamada</label>
                                        <select value="@(st.Modo == "ia" ? "ia" : "crm")"
                                                @onchange="e => SetModo(st, e.Value)">
                                            <option value="crm">Gestion CRM</option>
                                            <option value="ia">Llamada IA</option>
                                        </select>
                                    </div>

                                    @if (st.Modo == "ia")
                                    {
                                        <div class="cw-field">
                                            <label>Agente</label>
                                            <select value="@(st.AgenteId?.ToString() ?? "")"
                                                    @onchange="e => st.AgenteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null">
                                                <option value="">-- Elige un agente --</option>
                                                @foreach (var a in _agents)
                                                {
                                                    <option value="@a.Id">@a.Name@(a.IsActive ? "" : " (inactivo)")</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="cw-field">
                                            <label>Objetivo</label>
                                            <select @bind="st.Objetivo">
                                                <option value="">-- Elige objetivo --</option>
                                                @foreach (var o in Enum.GetValues<ContactCallObjetivo>())
                                                {
                                                    <option value="@o">@ObjetivoLabel(o)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="cw-field" style="grid-column:1/-1;">
                                            <label>Instruccion adicional al prompt</label>
                                            <textarea @bind="st.PromptExtra" rows="3"
                                                      placeholder="Se anexa al prompt del agente para esta llamada: producto, tono, oferta..."></textarea>
                                        </div>
                                        <div class="cw-field" style="grid-column:1/-1;">
                                            <label>Formularios que puede llenar</label>
                                            @if (_forms.Count == 0)
                                            {
                                                <span class="cw-hint">No hay formularios disponibles.</span>
                                            }
                                            else
                                            {
                                                <div class="cw-checklist">
                                                    @foreach (var f in _forms)
                                                    {
                                                        var on = st.FormulariosPermitidos.Contains(f.Id);
                                                        <label class="cw-check">
                                                            <input type="checkbox" checked="@on"
                                                                   @onchange="e => ToggleForm(st, f.Id, (bool)(e.Value ?? false))" />
                                                            <span>@f.Title</span>
                                                        </label>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cw-field">
                                            <label>Comercial</label>
                                            <input @bind="st.Comercial" placeholder="Responsable" />
                                        </div>
                                        <div class="cw-field">
                                            <label>Prioridad</label>
                                            <input @bind="st.Prioridad" placeholder="Alta / Media / Baja" />
                                        </div>
                                        <div class="cw-field">
                                            <label>Categoria</label>
                                            <input @bind="st.Categoria" placeholder="Categoria de la gestion" />
                                        </div>
                                        <div class="cw-field">
                                            <label>Subcategoria</label>
                                            <input @bind="st.Subcategoria" placeholder="Subcategoria / concepto" />
                                        </div>
                                    }
                                </div>
                            }

                            @* Paso WhatsApp: linea + contenido segun proveedor. Evolution/Emulator = texto libre con
                               variables; YCloud/Cloud = plantilla APROBADA + mapeo de variables (Meta rechaza texto
                               libre fuera de la ventana de 24 h). Se guarda en ParamsJson del paso. *@
                            @if (st.StepType == ContactWorkflowStepType.WhatsApp)
                            {
                                var waLine = _lines.FirstOrDefault(l => l.Id == st.WaLineaId);
                                var needsTpl = waLine is not null && RequiresTemplate(waLine.Provider);
                                <div class="cw-email">
                                    <div class="cw-field">
                                        <label>Linea de WhatsApp</label>
                                        <select value="@(st.WaLineaId?.ToString() ?? "")"
                                                @onchange="e => st.WaLineaId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null">
                                            <option value="">-- elige una linea --</option>
                                            @foreach (var l in _lines)
                                            {
                                                <option value="@l.Id">@LineLabel(l)</option>
                                            }
                                        </select>
                                        @if (_lines.Count == 0)
                                        {
                                            <span class="cw-email-hint">No hay lineas de WhatsApp. Crealas en "Lineas de WhatsApp".</span>
                                        }
                                        else if (waLine is not null && waLine.Status != WhatsAppLineStatus.Connected)
                                        {
                                            <span class="cw-email-hint">Esta linea no esta conectada: el paso no enviara hasta conectarla.</span>
                                        }
                                    </div>

                                    @if (needsTpl)
                                    {
                                        var tpls = TemplatesFor(waLine!.Id);
                                        var tpl = tpls.FirstOrDefault(t => t.Id == st.WaPlantillaId);
                                        <div class="cw-field" style="margin-top:10px;">
                                            <label>Plantilla aprobada</label>
                                            <select value="@(st.WaPlantillaId?.ToString() ?? "")"
                                                    @onchange="e => SetWaTemplate(st, e.Value)">
                                                <option value="">-- elige una plantilla --</option>
                                                @foreach (var t in tpls)
                                                {
                                                    <option value="@t.Id">@t.Name (@t.Language)</option>
                                                }
                                            </select>
                                            @if (tpls.Count == 0)
                                            {
                                                <span class="cw-email-hint">Esta linea no tiene plantillas aprobadas por Meta. Importalas o crealas en "Plantillas de WhatsApp".</span>
                                            }
                                        </div>
                                        @if (tpl is not null)
                                        {
                                            <div class="cw-email-prev">
                                                <div class="cw-email-prev-lbl">PLANTILLA &#183; @tpl.Name</div>
                                                <div class="cw-email-body" style="white-space:pre-wrap;">@tpl.BodyText</div>
                                                @if (tpl.Variables.Count > 0)
                                                {
                                                    <div class="cw-wa-vars">
                                                        <div class="cw-email-prev-lbl" style="margin-top:9px;">VARIABLES &#183; dato del contacto que llena cada una</div>
                                                        @foreach (var v in tpl.Variables)
                                                        {
                                                            var token = v.Token;
                                                            var src = WaSource(st, token);
                                                            var isFixed = src.StartsWith(ContactWorkflowWhatsAppFields.FixedPrefix, StringComparison.Ordinal);
                                                            <div class="cw-wa-var">
                                                                <span class="cw-wa-token">{{@token}}</span>
                                                                <select value="@(isFixed ? FixedOption : src)" @onchange="e => SetWaSource(st, token, e.Value)">
                                                                    <option value="">-- sin asignar --</option>
                                                                    @foreach (var f in ContactWorkflowWhatsAppFields.All)
                                                                    {
                                                                        <option value="@f.Key">@f.Label</option>
                                                                    }
                                                                    <option value="@FixedOption">Texto fijo...</option>
                                                                </select>
                                                                @if (isFixed)
                                                                {
                                                                    <input value="@src[ContactWorkflowWhatsAppFields.FixedPrefix.Length..]"
                                                                           @onchange="e => st.WaVars[token] = ContactWorkflowWhatsAppFields.FixedPrefix + (e.Value?.ToString() ?? string.Empty)"
                                                                           placeholder="Valor fijo para todos" />
                                                                }
                                                            </div>
                                                        }
                                                        <div class="cw-email-vars">Si el dato queda vacio para un contacto, ese envio se omite (Meta rechaza variables vacias).</div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (waLine is not null)
                                    {
                                        <div class="cw-field cw-wa-text" style="margin-top:10px;">
                                            <label>Mensaje</label>
                                            <textarea rows="4" @bind="st.WaTexto"
                                                      placeholder="Hola {nombre}, te escribimos de ..."></textarea>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(st.WaTexto))
                                        {
                                            <div class="cw-email-prev">
                                                <div class="cw-email-prev-lbl">VISTA PREVIA &#183; datos de ejemplo</div>
                                                <div class="cw-email-body" style="white-space:pre-wrap;">@EmailTemplateService.RenderTemplate(st.WaTexto, SampleFields, htmlEscapeValues: false)</div>
                                            </div>
                                        }
                                        <div class="cw-email-vars">Variables: {nombre} {empresa} {cargo} {ciudad} {correo}</div>
                                    }
                                </div>
                            }

                            @* Campos del paso E-mail: plantilla + vista previa (SMTP, cascada tenant->global) *@
                            @if (st.StepType == ContactWorkflowStepType.Email)
                            {
                                <div class="cw-email">
                                    <div class="cw-field">
                                        <label>Plantilla de correo</label>
                                        <select @bind="st.EmailTemplateId">
                                            <option value="">-- elige una plantilla --</option>
                                            @foreach (var t in _templates)
                                            {
                                                <option value="@t.Id">@t.Nombre</option>
                                            }
                                        </select>
                                        @if (_templates.Count == 0)
                                        {
                                            <span class="cw-email-hint">No hay plantillas activas. Crealas en "Plantillas de correo".</span>
                                        }
                                    </div>
                                    @{
                                        var sel = _templates.FirstOrDefault(t => t.Id.ToString() == st.EmailTemplateId);
                                    }
                                    @if (sel is not null)
                                    {
                                        <div class="cw-email-prev">
                                            <div class="cw-email-prev-lbl">VISTA PREVIA &#183; datos de ejemplo</div>
                                            <div class="cw-email-subj"><b>Asunto:</b> @PreviewSubject(sel)</div>
                                            @* iframe sandbox (ADR-0175): el HTML de la plantilla no corre en el origen de la app. *@
                                            <iframe class="cw-email-body" sandbox="" title="Vista previa del correo" srcdoc="@PreviewBody(sel)" style="width:100%;min-height:280px;border:0;background:#fff;display:block;"></iframe>
                                            <div class="cw-email-vars">Variables: {nombre} {empresa} {cargo} {ciudad} {correo}</div>
                                        </div>
                                    }
                                </div>
                            }

                            @* Ventanas de horario del paso *@
                            <div class="cw-sched-wrap">
                                <div class="cw-sched-lbl">
                                    <span>VENTANAS DE HORARIO</span>
                                    <button class="cw-add-win" @onclick="() => st.Schedules.Add(NewSchedule())">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                                        Ventana
                                    </button>
                                </div>
                                @if (st.Schedules.Count == 0)
                                {
                                    <div class="cw-sched-empty">Sin ventanas: agrega al menos una franja de horario.</div>
                                }
                                @for (var j = 0; j < st.Schedules.Count; j++)
                                {
                                    var jdx = j;
                                    var sc = st.Schedules[jdx];
                                    <div class="cw-sched">
                                        <div class="cw-days">
                                            @foreach (var d in DaysOfWeek)
                                            {
                                                var dd = d;
                                                <button class="cw-day @(sc.ActiveDays.Contains(dd.Iso) ? "on" : "")"
                                                        @onclick="() => ToggleDay(sc, dd.Iso)" title="@dd.Full">@dd.Label</button>
                                            }
                                        </div>
                                        <div class="cw-sched-grid">
                                            <div class="cw-field">
                                                <label>Desde hora</label>
                                                <input type="time" value="@sc.StartTime" @onchange="e => sc.StartTime = e.Value?.ToString() ?? sc.StartTime" />
                                            </div>
                                            <div class="cw-field">
                                                <label>Hasta hora</label>
                                                <input type="time" value="@sc.EndTime" @onchange="e => sc.EndTime = e.Value?.ToString() ?? sc.EndTime" />
                                            </div>
                                            <div class="cw-field">
                                                <label>Vigencia desde</label>
                                                <input type="date" value="@sc.StartDate" @onchange="e => sc.StartDate = e.Value?.ToString()" />
                                            </div>
                                            <div class="cw-field">
                                                <label>Vigencia hasta</label>
                                                <input type="date" value="@sc.EndDate" @onchange="e => sc.EndDate = e.Value?.ToString()" />
                                            </div>
                                            <div class="cw-field">
                                                <label>Repetir cada (min)</label>
                                                <input type="number" min="0" value="@sc.RepeatEvery" @onchange="e => sc.RepeatEvery = ParseInt(e.Value)" placeholder="-" />
                                            </div>
                                            <div class="cw-field">
                                                <label>Tam. paquete</label>
                                                <input type="number" min="0" value="@sc.PackageSize" @onchange="e => sc.PackageSize = ParseInt(e.Value)" placeholder="-" />
                                            </div>
                                        </div>
                                        <button class="cw-win-del" title="Quitar ventana" @onclick="() => st.Schedules.RemoveAt(jdx)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /></svg>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Ultimas ejecuciones del motor (antes solo se veian en BD). *@
                    <div class="cw-runs">
                        <div class="cw-sched-lbl">
                            <span>ULTIMAS EJECUCIONES</span>
                            <button class="cw-add-win" @onclick="LoadRunsAsync" disabled="@_runsBusy">@(_runsBusy ? "Cargando..." : "Actualizar")</button>
                        </div>
                        @if (_runs.Count == 0)
                        {
                            <div class="cw-sched-empty">Aun no hay ejecuciones de este workflow.</div>
                        }
                        else
                        {
                            <div class="cw-runs-wrap">
                                <table class="cw-runs-table">
                                    <thead>
                                        <tr><th>Fecha</th><th>Contacto</th><th>Paso</th><th>Estado</th><th>Detalle</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _runs)
                                        {
                                            <tr>
                                                <td class="nowrap">@r.FechaLocal.ToString("dd/MM HH:mm")</td>
                                                <td>@r.Contacto</td>
                                                <td>@r.Paso <span class="cw-runs-ch">@r.Canal</span></td>
                                                <td><span class="cw-run-st @RunCss(r.Estado)">@RunLabel(r.Estado)</span>@if (r.Intentos > 1) { <span class="cw-runs-ch">x@(r.Intentos)</span> }</td>
                                                <td class="cw-runs-err">@r.Error</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="cw-foot">
                @if (_error is not null)
                {
                    <div class="cw-err">@_error</div>
                }
                else if (_saved)
                {
                    <div class="cw-ok">Workflow guardado.</div>
                }
                else
                {
                    <span></span>
                }
                <div class="cw-foot-actions">
                    <button class="cw-btn-ghost" @onclick="Close" disabled="@_busy">Cerrar</button>
                    <button class="cw-btn-brand" @onclick="SaveAsync" disabled="@_busy">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8M7 3v5h8" /></svg>
                        Guardar Workflow
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private bool _busy;
    private bool _saved;
    private string? _error;
    private Guid _filtroId;
    private string _filtroNombre = "";
    private bool _activo = true;
    private readonly List<StepVM> _steps = new();
    private List<EmailTemplateDto> _templates = new();
    // Llamada IA (ADR-0056): agentes REUTILIZADOS y formularios que el agente puede llenar.
    private List<AiAgentDto> _agents = new();
    private List<FormDefinitionListItemDto> _forms = new();
    // Paso WhatsApp: lineas del tenant y plantillas APROBADAS (para lineas YCloud/Cloud).
    private List<WhatsAppLineDto> _lines = new();
    private List<WhatsAppTemplateDto> _waTemplates = new();
    // Panel "Ultimas ejecuciones".
    private List<ContactWorkflowRunDto> _runs = new();
    private bool _runsBusy;
    private const string FixedOption = "__fijo";

    // Datos de ejemplo para la vista previa del correo (no se envian; solo ilustran el merge).
    private static readonly EmailMergeFields SampleFields = EmailTemplateService.SampleFields;

    private static string PreviewSubject(EmailTemplateDto t)
        => EmailTemplateService.RenderTemplate(t.Asunto, SampleFields, htmlEscapeValues: false);

    private static string PreviewBody(EmailTemplateDto t)
        => EmailTemplateService.RenderTemplate(t.CuerpoHtml, SampleFields, htmlEscapeValues: true);

    /// <summary>Abre el disenador para un filtro y carga su workflow (si existe).</summary>
    public async Task OpenAsync(Guid filtroId, string filtroNombre)
    {
        _filtroId = filtroId;
        _filtroNombre = string.IsNullOrWhiteSpace(filtroNombre) ? "Filtro" : filtroNombre;
        _error = null;
        _saved = false;
        _activo = true;
        _steps.Clear();
        _templates = (await EmailTemplateSvc.ListAsync(soloActivas: true)).ToList();
        // Para el modo IA del paso Llamada: agentes existentes (se reutilizan) y formularios disponibles.
        _agents = (await AiAgentSvc.ListAsync()).ToList();
        _forms = (await FormDefSvc.ListAsync()).ToList();
        _lines = (await WaLineSvc.ListAsync()).ToList();
        _waTemplates = (await WaTemplateSvc.ListAsync())
            .Where(t => t.IsActive && t.Status == WhatsAppTemplateStatus.Approved)
            .OrderBy(t => t.Name)
            .ToList();

        var wf = await WorkflowSvc.GetByFiltroAsync(filtroId);
        if (wf is not null)
        {
            _activo = wf.Activo;
            foreach (var s in wf.Steps)
            {
                var vm = new StepVM
                {
                    Id = s.Id,
                    StepType = s.StepType,
                    Label = s.Label,
                    Comercial = s.Call?.Comercial,
                    Prioridad = s.Call?.Prioridad,
                    Categoria = s.Call?.Categoria,
                    Subcategoria = s.Call?.Subcategoria,
                    Modo = s.Call?.Modo,
                    AgenteId = s.Call?.AgenteId,
                    PromptExtra = s.Call?.PromptExtra,
                    Objetivo = s.Call?.Objetivo
                };
                if (s.Call?.FormulariosPermitidos is { Count: > 0 } forms)
                {
                    vm.FormulariosPermitidos.AddRange(forms);
                }
                foreach (var h in s.Schedules)
                {
                    vm.Schedules.Add(new ScheduleVM
                    {
                        Id = h.Id,
                        StartDate = h.StartDate?.ToString("yyyy-MM-dd"),
                        EndDate = h.EndDate?.ToString("yyyy-MM-dd"),
                        StartTime = h.StartTime.ToString("HH:mm"),
                        EndTime = h.EndTime.ToString("HH:mm"),
                        ActiveDays = ParseDays(h.ActiveDays),
                        RepeatEvery = h.RepeatEvery,
                        PackageSize = h.PackageSize,
                        TemplateId = h.TemplateId,
                        AccountId = h.AccountId
                    });
                }
                // La plantilla del paso E-mail es la de sus ventanas (todas comparten la misma).
                vm.EmailTemplateId = vm.Schedules.FirstOrDefault()?.TemplateId;
                if (s.StepType == ContactWorkflowStepType.WhatsApp)
                {
                    // Config nueva en ParamsJson; compatibilidad con pasos viejos (texto en TemplateId de la
                    // ventana, linea en AccountId): se sube al paso y se guarda en ParamsJson al guardar.
                    var first = vm.Schedules.FirstOrDefault();
                    vm.WaLineaId = s.WhatsApp?.LineaId ?? first?.AccountId;
                    vm.WaTexto = s.WhatsApp?.Texto ?? first?.TemplateId;
                    vm.WaPlantillaId = s.WhatsApp?.PlantillaId;
                    if (s.WhatsApp?.Variables is { } vars)
                    {
                        foreach (var kv in vars) { vm.WaVars[kv.Key] = kv.Value; }
                    }
                }
                _steps.Add(vm);
            }
        }
        await LoadRunsAsync();
        _open = true;
        StateHasChanged();
    }

    private void Close() => _open = false;

    private void AddStep(ContactWorkflowStepType type)
    {
        var meta = MetaFor(type);
        _steps.Add(new StepVM
        {
            StepType = type,
            Label = meta.Label,
            Schedules = { NewSchedule() }
        });
        _saved = false;
    }

    private void MoveStep(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _steps.Count) { return; }
        (_steps[index], _steps[target]) = (_steps[target], _steps[index]);
    }

    private static ScheduleVM NewSchedule() => new()
    {
        StartTime = "09:00",
        EndTime = "18:00",
        ActiveDays = new HashSet<int> { 1, 2, 3, 4, 5 }
    };

    private static void ToggleDay(ScheduleVM sc, int iso)
    {
        if (!sc.ActiveDays.Remove(iso)) { sc.ActiveDays.Add(iso); }
    }

    private static int? ParseInt(object? value)
        => int.TryParse(value?.ToString(), out var n) && n > 0 ? n : null;

    private async Task SaveAsync()
    {
        _error = null;
        _saved = false;
        // Validacion minima del modo IA (ADR-0056): agente obligatorio; si el objetivo es "Llenar
        // formulario", exige al menos un formulario permitido. El modo CRM no cambia.
        var invalido = _steps.FirstOrDefault(s => s.StepType == ContactWorkflowStepType.Llamada && s.Modo == "ia"
            && (s.AgenteId is null
                || (s.Objetivo == nameof(ContactCallObjetivo.LlenarFormulario) && s.FormulariosPermitidos.Count == 0)));
        if (invalido is not null)
        {
            _error = invalido.AgenteId is null
                ? "En una llamada IA debes elegir un agente."
                : "El objetivo 'Llenar formulario' requiere al menos un formulario permitido.";
            return;
        }
        var waError = _steps.Where(s => s.StepType == ContactWorkflowStepType.WhatsApp)
            .Select(ValidateWhatsApp).FirstOrDefault(e => e is not null);
        if (waError is not null)
        {
            _error = waError;
            return;
        }
        _busy = true;
        try
        {
            var steps = _steps.Select(s => new SaveContactWorkflowStepRequest(
                s.StepType,
                s.Label,
                s.StepType == ContactWorkflowStepType.Llamada ? BuildCall(s) : null,
                s.Schedules.Select(h => new SaveContactWorkflowScheduleRequest(
                    ParseDate(h.StartDate),
                    ParseDate(h.EndDate),
                    ParseTime(h.StartTime, new TimeOnly(9, 0)),
                    ParseTime(h.EndTime, new TimeOnly(18, 0)),
                    string.Join(",", h.ActiveDays.OrderBy(d => d)),
                    // E-mail: la plantilla del paso se guarda en cada ventana. WhatsApp: el contenido vive en
                    // ParamsJson (se limpia el texto/linea viejos de la ventana). Otros pasos conservan su valor.
                    s.StepType switch
                    {
                        ContactWorkflowStepType.Email => string.IsNullOrWhiteSpace(s.EmailTemplateId) ? null : s.EmailTemplateId,
                        ContactWorkflowStepType.WhatsApp => null,
                        _ => h.TemplateId
                    },
                    s.StepType == ContactWorkflowStepType.WhatsApp ? null : h.AccountId,
                    h.RepeatEvery,
                    h.PackageSize,
                    h.Id)).ToList(),
                s.StepType == ContactWorkflowStepType.WhatsApp ? BuildWhatsApp(s) : null,
                s.Id)).ToList();

            var req = new SaveContactWorkflowRequest(null, _activo, steps);
            var res = await WorkflowSvc.SaveAsync(_filtroId, req);
            if (res.IsOk && res.Value is not null)
            {
                _saved = true;
                // Los pasos/ventanas nuevos reciben su Id: se toma para que un segundo guardado los actualice
                // (y no los cree otra vez, lo que reiniciaria su historial).
                for (var i = 0; i < _steps.Count && i < res.Value.Steps.Count; i++)
                {
                    _steps[i].Id = res.Value.Steps[i].Id;
                    for (var j = 0; j < _steps[i].Schedules.Count && j < res.Value.Steps[i].Schedules.Count; j++)
                    {
                        _steps[i].Schedules[j].Id = res.Value.Steps[i].Schedules[j].Id;
                    }
                }
            }
            else { _error = res.Error ?? "No se pudo guardar el workflow."; }
        }
        finally { _busy = false; }
    }

    private static DateOnly? ParseDate(string? value)
        => DateOnly.TryParse(value, out var d) ? d : null;

    private static TimeOnly ParseTime(string? value, TimeOnly fallback)
        => TimeOnly.TryParse(value, out var t) ? t : fallback;

    private static HashSet<int> ParseDays(string? csv)
    {
        var set = new HashSet<int>();
        if (string.IsNullOrWhiteSpace(csv)) { return set; }
        foreach (var part in csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(part, out var d) && d is >= 1 and <= 7) { set.Add(d); }
        }
        return set;
    }

