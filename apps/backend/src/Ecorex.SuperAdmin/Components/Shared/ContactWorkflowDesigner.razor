    // Construye los parametros del paso Llamada segun el modo. IA: referencia el agente REUTILIZADO +
    // prompt extra + objetivo + formularios; CRM: los 4 campos historicos (comportamiento actual).
    private static ContactWorkflowCallParams BuildCall(StepVM s)
        => s.Modo == "ia"
            ? new ContactWorkflowCallParams(
                Modo: "ia",
                AgenteId: s.AgenteId,
                PromptExtra: string.IsNullOrWhiteSpace(s.PromptExtra) ? null : s.PromptExtra.Trim(),
                Objetivo: string.IsNullOrWhiteSpace(s.Objetivo) ? null : s.Objetivo,
                FormulariosPermitidos: s.FormulariosPermitidos.Count > 0 ? s.FormulariosPermitidos.ToList() : null)
            : new ContactWorkflowCallParams(s.Comercial, s.Prioridad, s.Categoria, s.Subcategoria);

    // ---- Paso WhatsApp ----

    private static bool RequiresTemplate(WhatsAppProvider provider)
        => provider is WhatsAppProvider.YCloud or WhatsAppProvider.Cloud;

    private static string LineLabel(WhatsAppLineDto l)
    {
        var estado = l.Status == WhatsAppLineStatus.Connected ? "" : " - desconectada";
        var numero = string.IsNullOrWhiteSpace(l.PhoneNumber) ? "" : $" ({l.PhoneNumber})";
        return $"{l.InstanceName}{numero} - {l.Provider}{estado}";
    }

    // Plantillas aprobadas de la linea; si la linea no tiene propias, todas las aprobadas del tenant.
    private List<WhatsAppTemplateDto> TemplatesFor(Guid lineId)
    {
        var own = _waTemplates.Where(t => t.WhatsAppLineId == lineId).ToList();
        return own.Count > 0 ? own : _waTemplates;
    }

    private void SetWaTemplate(StepVM s, object? value)
    {
        s.WaPlantillaId = Guid.TryParse(value?.ToString(), out var g) ? g : null;
        s.WaVars.Clear();
        var tpl = _waTemplates.FirstOrDefault(t => t.Id == s.WaPlantillaId);
        if (tpl is null) { return; }
        // Sugerencia inicial por nombre del token ({{cliente}} -> nombre del contacto, etc.).
        foreach (var v in tpl.Variables)
        {
            var def = ContactWorkflowWhatsAppFields.DefaultFor(v.Token);
            if (def.Length > 0) { s.WaVars[v.Token] = def; }
        }
    }

    private static string WaSource(StepVM s, string token)
        => s.WaVars.TryGetValue(token, out var v) ? v : string.Empty;

    private static void SetWaSource(StepVM s, string token, object? value)
    {
        var v = value?.ToString() ?? string.Empty;
        if (v.Length == 0) { s.WaVars.Remove(token); }
        else if (v == FixedOption) { s.WaVars[token] = ContactWorkflowWhatsAppFields.FixedPrefix; }
        else { s.WaVars[token] = v; }
    }

    private string? ValidateWhatsApp(StepVM s)
    {
        var line = _lines.FirstOrDefault(l => l.Id == s.WaLineaId);
        if (line is null) { return $"En el paso \"{s.Label}\" elige la linea de WhatsApp."; }
        if (RequiresTemplate(line.Provider))
        {
            var tpl = _waTemplates.FirstOrDefault(t => t.Id == s.WaPlantillaId);
            if (tpl is null) { return $"En el paso \"{s.Label}\" elige una plantilla aprobada (la linea es {line.Provider})."; }
            var sinAsignar = tpl.Variables.FirstOrDefault(v => ContactWorkflowWhatsAppFields.Resolve(
                WaSource(s, v.Token), "x", "x", "x", "x", "x", "x") is null);
            if (sinAsignar is not null) { return $"En el paso \"{s.Label}\" asigna un dato a la variable {{{{{sinAsignar.Token}}}}}."; }
            return null;
        }
        return string.IsNullOrWhiteSpace(s.WaTexto) ? $"En el paso \"{s.Label}\" escribe el mensaje." : null;
    }

    private ContactWorkflowWhatsAppParams BuildWhatsApp(StepVM s)
    {
        var line = _lines.FirstOrDefault(l => l.Id == s.WaLineaId);
        var tplMode = line is not null && RequiresTemplate(line.Provider);
        return new ContactWorkflowWhatsAppParams(
            LineaId: s.WaLineaId,
            Texto: tplMode || string.IsNullOrWhiteSpace(s.WaTexto) ? null : s.WaTexto.Trim(),
            PlantillaId: tplMode ? s.WaPlantillaId : null,
            Variables: tplMode && s.WaVars.Count > 0 ? new Dictionary<string, string>(s.WaVars) : null);
    }

