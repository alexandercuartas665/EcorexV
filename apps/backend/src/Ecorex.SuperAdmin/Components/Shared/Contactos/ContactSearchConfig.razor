@* ============================================================
   Configurar busquedas de contactos (agente Colmena -> agente IA -> ProspectoScrapeado).
   Modal reutilizable: se abre por @ref -> OpenAsync(). Vive en el Gestor de contactos
   (000740), donde aterrizan los prospectos. Config-driven por tenant.
   Modo TABLA con edicion en linea: cada fila es una busqueda; los campos largos (terminos,
   sub-busqueda, geografia, prompt) se editan al expandir la fila.
   ============================================================ *@
@using Ecorex.Application.Contactos
@using Ecorex.Application.Tenancy
@using Ecorex.Application.Agents
@using Ecorex.Domain.Enums
@inject IContactSearchService SearchSvc
@inject IAiAgentService AiAgentSvc
@inject IAgentClientService ClientSvc
@inject Ecorex.SuperAdmin.Agents.IContactSearchRunner Runner

@if (_open)
{
    <div class="modal-overlay" @onclick="() => _open = false">
        <div class="modal-dialog" style="max-width:1100px;width:97vw;max-height:92vh;display:flex;flex-direction:column;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Configurar busquedas de contactos</h3>
                <button class="modal-close" @onclick="() => _open = false">&times;</button>
            </div>
            <div class="modal-body" style="flex:1;overflow:auto;padding:16px 20px;">
                @if (_error is not null)
                {
                    <div class="cl-flash err" style="margin-bottom:12px;">@_error</div>
                }
                @if (_runMsg is not null)
                {
                    <div class="cl-flash @(_runError ? "err" : "ok")" style="margin-bottom:10px;">@_runMsg</div>
                }
                <div class="cs-note" style="margin-bottom:10px;">
                    Cada fila es una busqueda reutilizable. La ejecuta el agente Colmena guiado por el agente IA;
                    los resultados entran a "Prospectos scrapeados" (Bolsa). Edita en linea y pulsa Guardar; expande la
                    fila (&#9656;) para terminos, geografia y el prompt de extraccion.
                </div>

                <table class="cs-grid">
                    <thead>
                        <tr>
                            <th style="width:26px;"></th>
                            <th>Nombre</th>
                            <th style="width:150px;">Fuente</th>
                            <th style="width:120px;">Programador</th>
                            <th style="width:78px;">Limite</th>
                            <th style="width:150px;">Agente IA</th>
                            <th style="width:150px;">Colmena</th>
                            <th style="width:56px;">Activa</th>
                            <th style="width:210px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _rows)
                        {
                            var row = r;
                            var isDraft = row.Id is null;
                            <tr class="@(isDraft ? "cs-draft" : (row.Active ? "" : "cs-off"))">
                                <td class="cs-c-exp">
                                    <button class="cs-exp" @onclick="() => row.Expanded = !row.Expanded"
                                            title="@(row.Expanded ? "Contraer" : "Terminos, geografia y prompt")">@(row.Expanded ? "▾" : "▸")</button>
                                </td>
                                <td><input class="cs-in" @bind="row.Name" maxlength="200" placeholder="@(isDraft ? "+ Nueva busqueda..." : "")" /></td>
                                <td>
                                    <select class="cs-in" @bind="row.Source">
                                        <option value="@ContactSearchSource.Maps">Google Maps</option>
                                        <option value="@ContactSearchSource.LinkedIn">LinkedIn</option>
                                        <option value="@ContactSearchSource.Web">Web / directorios</option>
                                        <option value="@ContactSearchSource.Instagram">Instagram</option>
                                        <option value="@ContactSearchSource.Facebook">Facebook</option>
                                        <option value="@ContactSearchSource.X">X (Twitter)</option>
                                    </select>
                                </td>
                                <td>
                                    <button class="cs-in cs-sched-btn" @onclick="() => row.Expanded = true" title="Editar programaciones (se editan al expandir la fila)">
                                        @SchedSummary(row)
                                    </button>
                                </td>
                                <td><input class="cs-in cs-num" type="number" min="0" max="500" step="1" @bind="row.MaxContacts" title="Tope de contactos por corrida (0 = sin tope)" /></td>
                                <td>
                                    <select class="cs-in" @bind="row.AgentId">
                                        <option value="">-- IA --</option>
                                        @foreach (var a in _aiAgents) { <option value="@a.Id">@a.Name</option> }
                                    </select>
                                </td>
                                <td>
                                    <select class="cs-in" @bind="row.ClientId">
                                        <option value="">-- Colmena --</option>
                                        @foreach (var c in _clients) { <option value="@c.ClientId">@c.Name</option> }
                                    </select>
                                </td>
                                <td class="cs-c-chk"><input type="checkbox" @bind="row.Active" /></td>
                                <td class="cs-actions">
                                    <button class="cl-btn primary sm" @onclick="() => SaveAsync(row)" disabled="@(_busy || string.IsNullOrWhiteSpace(row.Name))" title="Guardar la busqueda">@(isDraft ? "Agregar" : "Guardar")</button>
                                    @if (!isDraft)
                                    {
                                        <button class="cl-btn sm" @onclick="() => RunAsync(row)" disabled="@_busy" title="Disparar con el agente Colmena">@(_runningId == row.Id ? "..." : "Ejecutar")</button>
                                        <button class="cl-btn sm danger" @onclick="() => DeleteAsync(row)" disabled="@_busy" title="Eliminar">&times;</button>
                                    }
                                </td>
                            </tr>
                            @if (row.Expanded)
                            {
                                <tr class="cs-detail">
                                    <td></td>
                                    <td colspan="8">
                                        <div class="cs-editor">
                                            @if (row.Error is not null) { <div class="cl-flash err" style="margin-bottom:8px;">@row.Error</div> }
                                            <label>Que buscar (terminos)<input class="form-control" @bind="row.Query" placeholder="rubro, cargo, palabra clave..." /></label>
                                            @if (row.Source == ContactSearchSource.Maps)
                                            {
                                                <div class="cs-row">
                                                    <label>Pais<input class="form-control" @bind="row.Country" placeholder="Colombia" /></label>
                                                    <label>Region / zona<input class="form-control" @bind="row.Region" placeholder="Norte, Sur, departamento..." /></label>
                                                    <label>Ciudad<input class="form-control" @bind="row.City" placeholder="Bogota" /></label>
                                                </div>
                                                @* Enriquecimiento Maps -> LinkedIn: por cada empresa encontrada, busca personas en
                                                   LinkedIn (sesion logueada) y las liga a la empresa. Respeta el tope 20/dia LinkedIn. *@
                                                <div class="cs-enrich">
                                                    <label class="cs-enrich-chk">
                                                        <input type="checkbox" @bind="row.EnrichLinkedIn" />
                                                        Tras Maps, buscar contactos en LinkedIn de cada empresa (sesion logueada, tope 20/dia)
                                                    </label>
                                                    @if (row.EnrichLinkedIn)
                                                    {
                                                        <label class="cs-enrich-max">Personas por empresa
                                                            <input class="cs-in cs-num" type="number" min="1" max="25" step="1" @bind="row.EnrichMax" />
                                                        </label>
                                                    }
                                                </div>
                                            }
                                            <label>Sub-busqueda (opcional)<input class="form-control" @bind="row.SubQuery" placeholder="refinamiento sobre cada resultado (ej. abrir la ficha y sacar el telefono)" /></label>
                                            <label>Prompt de extraccion (que datos debe tomar el agente) *<textarea class="form-control" rows="3" @bind="row.Prompt" placeholder="Ej: extrae de cada resultado el nombre del negocio, telefono, direccion, correo y ciudad."></textarea></label>
                                            <div class="cs-sched">
                                                <div class="cs-sched-h">Programaciones (cada una es un evento; vacio = solo manual)</div>
                                                <div class="cs-note">Las horas se interpretan en la <b>zona horaria del tenant</b> (America/Bogota), NO en UTC. Ej.: 09:00 corre a las 9 de la manana hora local.</div>
                                                @if (row.Schedules.Count == 0)
                                                {
                                                    <div class="cs-note">Manual: solo se ejecuta bajo demanda (boton Ejecutar).</div>
                                                }
                                                @foreach (var slot in row.Schedules)
                                                {
                                                    var sl = slot;
                                                    <div class="cs-slot">
                                                        <select class="form-control" @bind="sl.Frequency" title="Frecuencia">
                                                            <option value="@ContactSearchSchedule.Diaria">Diaria</option>
                                                            <option value="@ContactSearchSchedule.Semanal">Semanal</option>
                                                            <option value="@ContactSearchSchedule.Mensual">Mensual</option>
                                                        </select>
                                                        <input class="form-control" type="time" @bind="sl.RunTimeValue" title="Hora local del tenant (America/Bogota)" />
                                                        @if (sl.Frequency == ContactSearchSchedule.Semanal)
                                                        {
                                                            <select class="form-control" @bind="sl.DayOfWeek" title="Dia de la semana">
                                                                <option value="1">Lunes</option>
                                                                <option value="2">Martes</option>
                                                                <option value="3">Miercoles</option>
                                                                <option value="4">Jueves</option>
                                                                <option value="5">Viernes</option>
                                                                <option value="6">Sabado</option>
                                                                <option value="0">Domingo</option>
                                                            </select>
                                                        }
                                                        else if (sl.Frequency == ContactSearchSchedule.Mensual)
                                                        {
                                                            <input class="form-control" type="number" min="1" max="31" step="1" @bind="sl.DayOfMonth" title="Dia del mes" />
                                                        }
                                                        <span class="cs-slot-sum">@SlotSummary(sl)</span>
                                                        <button class="cl-btn sm danger" @onclick="() => row.Schedules.Remove(sl)" title="Quitar esta programacion">&times;</button>
                                                    </div>
                                                }
                                                <button class="cl-btn sm" @onclick="() => row.Schedules.Add(new SlotEdit())" style="margin-top:2px;">+ Agregar programacion</button>
                                            </div>
                                            <div class="cs-detail-foot">
                                                <span class="cs-note">@(row.LastRunAt is null ? "Sin ejecutar aun." : $"Ultima corrida: {row.LastRunAt:yyyy-MM-dd HH:mm}")</span>
                                                <button class="cl-btn primary sm" @onclick="() => SaveAsync(row)" disabled="@(_busy || string.IsNullOrWhiteSpace(row.Name))">@(isDraft ? "Agregar busqueda" : "Guardar cambios")</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private bool _busy;
    private string? _error;
    private IReadOnlyList<AiAgentDto> _aiAgents = Array.Empty<AiAgentDto>();
    private IReadOnlyList<AgentClientDto> _clients = Array.Empty<AgentClientDto>();
    private List<Row> _rows = new();
    private Guid? _runningId;
    private string? _runMsg;
    private bool _runError;

    private sealed class Row
    {
        public Guid? Id;
        public string Name = "";
        public ContactSearchSource Source = ContactSearchSource.Maps;
        public string Query = "";
        public string SubQuery = "";
        public string Country = "";
        public string Region = "";
        public string City = "";
        public string Prompt = "";
        public string ClientId = "";
        public string AgentId = "";
        public int MaxContacts = 30;
        public bool EnrichLinkedIn;      // Maps -> LinkedIn: tras las empresas, trae personas de LinkedIn.
        public int EnrichMax = 5;        // personas por empresa en el enriquecimiento.
        public List<SlotEdit> Schedules = new();  // varias programaciones; vacio = Manual
        public bool Active = true;
        public DateTimeOffset? LastRunAt;
        public bool Expanded;
        public string? Error;
    }

    // Una programacion editable en la UI (frecuencia + hora + dia).
    private sealed class SlotEdit
    {
        public ContactSearchSchedule Frequency = ContactSearchSchedule.Diaria;
        public string RunTime = "09:00";
        // Puente para <input type="time"> (Blazor liga TimeOnly, no string).
        public TimeOnly RunTimeValue
        {
            get => TimeOnly.TryParse(RunTime, out var t) ? t : new TimeOnly(9, 0);
            set => RunTime = value.ToString("HH:mm");
        }
        public int DayOfWeek = 1;   // 0=Domingo .. 6=Sabado (Semanal)
        public int DayOfMonth = 1;  // 1..31 (Mensual)
    }

    public async Task OpenAsync()
    {
        _error = null; _runMsg = null;
        _aiAgents = await AiAgentSvc.ListAsync();
        _clients = await ClientSvc.ListAsync();
        await LoadRowsAsync();
        _open = true;
        StateHasChanged();
    }

    private async Task LoadRowsAsync()
    {
        var searches = await SearchSvc.ListAsync();
        _rows = searches.Select(ToRow).ToList();
        _rows.Add(new Row()); // fila-borrador siempre al final para agregar.
    }

    private static Row ToRow(ContactSearchDto s) => new()
    {
        Id = s.Id, Name = s.Name, Source = s.SourceType,
        Query = s.Query ?? "", SubQuery = s.SubQuery ?? "",
        Country = s.Country ?? "", Region = s.Region ?? "", City = s.City ?? "",
        Prompt = s.ExtractionPrompt, ClientId = s.ClientId ?? "",
        AgentId = s.ClassifierAiAgentId?.ToString() ?? "",
        MaxContacts = s.MaxContacts,
        EnrichLinkedIn = s.EnrichLinkedIn, EnrichMax = s.EnrichMaxPorEmpresa,
        Schedules = s.Schedules.Select(sl => new SlotEdit
        {
            Frequency = sl.Frequency == ContactSearchSchedule.Manual ? ContactSearchSchedule.Diaria : sl.Frequency,
            RunTime = string.IsNullOrWhiteSpace(sl.RunTime) ? "09:00" : sl.RunTime!,
            DayOfWeek = sl.DayOfWeek ?? 1,
            DayOfMonth = sl.DayOfMonth ?? 1
        }).ToList(),
        LastRunAt = s.LastRunAt, Active = s.IsActive
    };

    private async Task SaveAsync(Row r)
    {
        r.Error = null;
        if (string.IsNullOrWhiteSpace(r.Prompt))
        {
            r.Expanded = true;
            r.Error = "Expande la fila y escribe el prompt de extraccion (es obligatorio).";
            return;
        }
        _busy = true; _error = null;
        try
        {
            Guid? agentId = Guid.TryParse(r.AgentId, out var g) ? g : null;
            var slots = r.Schedules
                .Select(sl => new ContactSearchScheduleSlot(sl.Frequency, sl.RunTime, sl.DayOfWeek, sl.DayOfMonth))
                .ToList();
            var req = new SaveContactSearchRequest(r.Id, r.Name, r.Source,
                Nz(r.Query), Nz(r.SubQuery), Nz(r.Country), Nz(r.Region), Nz(r.City),
                r.Prompt, Nz(r.ClientId), agentId, r.MaxContacts, slots, r.Active,
                r.EnrichLinkedIn, r.EnrichMax);
            var err = await SearchSvc.SaveAsync(req);
            if (err is not null) { r.Error = err; r.Expanded = true; return; }
            await LoadRowsAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Row r)
    {
        if (r.Id is not Guid id) { return; }
        _busy = true;
        try { await SearchSvc.DeleteAsync(id); await LoadRowsAsync(); }
        finally { _busy = false; }
    }

    private async Task RunAsync(Row r)
    {
        if (r.Id is not Guid id) { return; }
        _busy = true; _runningId = id; _runMsg = null;
        try
        {
            var res = await Runner.RunAsync(id);
            _runError = !res.Ok;
            _runMsg = res.Ok
                ? $"Busqueda '{r.Name}': {res.Created} prospecto(s) creado(s). Revisalos en 'Prospectos scrapeados'."
                : $"Busqueda '{r.Name}': {res.Error}";
            await LoadRowsAsync();
        }
        catch (Exception ex) { _runError = true; _runMsg = $"Error al ejecutar: {ex.Message}"; }
        finally { _busy = false; _runningId = null; }
    }

    private static string? Nz(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static readonly string[] DiasSemana = { "Domingo", "Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado" };

    // Resumen legible de UNA programacion: "Todos los dias 09:00", "Lunes 08:30", "Dia 15 09:00".
    private static string SlotSummary(SlotEdit s) => s.Frequency switch
    {
        ContactSearchSchedule.Diaria => $"Diario {s.RunTime}",
        ContactSearchSchedule.Semanal => $"{DiasSemana[Math.Clamp(s.DayOfWeek, 0, 6)]} {s.RunTime}",
        ContactSearchSchedule.Mensual => $"Dia {Math.Clamp(s.DayOfMonth, 1, 31)} {s.RunTime}",
        _ => "Manual"
    };

    // Resumen para la celda del programador: "Manual", una programacion legible, o "N programaciones".
    private static string SchedSummary(Row r) => r.Schedules.Count switch
    {
        0 => "Manual",
        1 => SlotSummary(r.Schedules[0]),
        var n => $"{n} programaciones"
    };
}
