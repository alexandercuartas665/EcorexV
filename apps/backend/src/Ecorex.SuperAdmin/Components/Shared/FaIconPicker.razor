@* ===================================================================================
   Selector VISUAL de icono FontAwesome. Antes pintaba la grilla completa inline (ocupaba
   mucho alto en el formulario); ahora es un BOTON compacto que muestra el icono actual y
   abre la grilla en un POPOVER flotante. El valor sigue siendo la clase fa (ej. "fa-globe")
   y se pinta con <i class="fa @Value">, asi NO cambia el formato de dato ni el render.

   Uso: <FaIconPicker @bind-Value="_icono" Options="Iconos" />   (Options opcional)
   Solo ASCII.
   =================================================================================== *@

<div class="faip">
    <button type="button" class="faip-trigger @(_open ? "open" : "")" @onclick="Toggle" title="Elegir icono">
        <i class="fa @(string.IsNullOrWhiteSpace(Value) ? "fa-icons" : Value) faip-cur"></i>
        <i class="fa fa-chevron-down faip-caret"></i>
    </button>
    @if (_open)
    {
        <div class="faip-backdrop" @onclick="Close"></div>
        <div class="faip-pop">
            @foreach (var ic in Effective)
            {
                var i = ic;
                <button type="button" title="@i.Replace("fa-", "")"
                        class="faip-opt @(string.Equals(Value, i, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                        @onclick="() => PickAsync(i)"><i class="fa @i"></i></button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Clase fa elegida (ej. "fa-globe"). Null/vacio = ninguno.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Catalogo de clases fa a ofrecer. Vacio/null = set por defecto.</summary>
    [Parameter] public IReadOnlyList<string>? Options { get; set; }

    private bool _open;

    private IReadOnlyList<string> Effective => Options is { Count: > 0 } ? Options : Default;

    private static readonly string[] Default =
    {
        "fa-globe", "fa-chart-line", "fa-file-invoice-dollar", "fa-user-tie", "fa-truck",
        "fa-id-badge", "fa-folder", "fa-briefcase", "fa-scale-balanced", "fa-headset",
        "fa-warehouse", "fa-star", "fa-handshake", "fa-building-columns", "fa-building",
        "fa-user", "fa-users", "fa-address-book", "fa-address-card", "fa-phone",
        "fa-envelope", "fa-location-dot", "fa-tag", "fa-box", "fa-gear", "fa-heart",
        "fa-flag", "fa-bell", "fa-calendar", "fa-clipboard", "fa-file-lines", "fa-coins"
    };

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task PickAsync(string icon)
    {
        Value = icon;
        _open = false;
        await ValueChanged.InvokeAsync(icon);
    }
}
