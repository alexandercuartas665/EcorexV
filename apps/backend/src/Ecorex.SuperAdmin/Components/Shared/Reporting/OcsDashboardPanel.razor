@using Ecorex.Application.Reporting
@using Ecorex.Application.Reporting.Sources
@inject IReportCatalog Catalog
@inject IReportDataSource ReportDs

@* Panel OCS - Inventario de software (multi-grafico) REUTILIZABLE. Igual que ActivitiesDashboardPanel
   pero sobre el CONTENEDOR "Software OCS" del tenant (EAV, tenant-safe): una consulta tabular pivotada
   en el servidor -> KPIs, top de software, top de fabricantes, equipos por SO, arquitectura, matriz
   SO x Bits y detalle. Filtros (SO, arquitectura, programa, fabricante) empujados a la BD. Se embebe en
   el modal de la galeria cuando el reporte es de tipo panel (SourceKey = panel:ocs). Encuentra el
   contenedor por su nombre: portable a cualquier tenant que tenga cargado OCS. *@

<div class="rpt-dash">
    <div class="rpt-filters">
        <label>SO
            <select @bind="_so">
                <option value="">(todos)</option>
                @foreach (var o in _soOptions) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Arquitectura
            <select @bind="_bits">
                <option value="">(todas)</option>
                @foreach (var o in _bitsOptions) { <option value="@o">@BitsLabel(o)</option> }
            </select>
        </label>
        <label>Programa <input type="text" placeholder="contiene..." @bind="_programa" /></label>
        <label>Fabricante <input type="text" placeholder="contiene..." @bind="_publisher" /></label>
        <button class="rpt-btn" @onclick="LoadAsync">Aplicar</button>
        <button class="rpt-btn ghost" @onclick="ClearFilters">Limpiar</button>
    </div>

    @if (_error is not null)
    {
        <div class="rpt-error">@_error</div>
    }

    <div class="rpt-kpis">
        <div class="rpt-kpi"><span class="k-val">@_equipos</span><span class="k-lbl">Equipos</span></div>
        <div class="rpt-kpi prog"><span class="k-val">@_programas</span><span class="k-lbl">Programas distintos</span></div>
        <div class="rpt-kpi open"><span class="k-val">@_instalaciones</span><span class="k-lbl">Instalaciones</span></div>
        <div class="rpt-kpi done"><span class="k-val">@_publishers</span><span class="k-lbl">Fabricantes</span></div>
        <div class="rpt-kpi susp"><span class="k-val">@_pct64</span><span class="k-lbl">% 64-bit</span></div>
        <div class="rpt-kpi over"><span class="k-val">@_win7</span><span class="k-lbl">Equipos Win7</span></div>
    </div>

    <div class="rpt-grid">
        <div class="rpt-card">
            <h3>Top 12 software por instalaciones</h3>
            <EChart Option="_topSoftware" Height="340px" />
        </div>
        <div class="rpt-card">
            <h3>Fabricantes (top 8)</h3>
            <EChart Option="_publishersChart" Height="340px" />
        </div>
        <div class="rpt-card">
            <h3>Equipos por sistema operativo</h3>
            <EChart Option="_soChart" Height="320px" />
        </div>
        <div class="rpt-card">
            <h3>Arquitectura</h3>
            <EChart Option="_bitsChart" Height="320px" />
        </div>
    </div>

    <div class="rpt-card rpt-full">
        <h3>Tabla matriz &mdash; Sistema operativo &times; Arquitectura</h3>
        @if (_soKeys.Count == 0)
        {
            <p class="rpt-empty">Sin datos.</p>
        }
        else
        {
            <table class="rpt-matrix">
                <thead>
                    <tr>
                        <th class="corner">SO \ Bits</th>
                        @foreach (var b in _bitsKeys) { <th>@BitsLabel(b)</th> }
                        <th class="tot">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _soKeys)
                    {
                        <tr>
                            <td class="rowhead">@s</td>
                            @foreach (var b in _bitsKeys)
                            {
                                var v = Cell(s, b);
                                <td class="num @(v == 0 ? "zero" : "")" style="@HeatStyle(v)">@(v == 0 ? "" : v.ToString())</td>
                            }
                            <td class="num tot">@RowTotal(s)</td>
                        </tr>
                    }
                    <tr class="totalrow">
                        <td class="rowhead">Total</td>
                        @foreach (var b in _bitsKeys) { <td class="num tot">@ColTotal(b)</td> }
                        <td class="num grand">@_instalaciones</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>

    <div class="rpt-card rpt-full">
        <h3>Detalle &mdash; software mas presente</h3>
        <table class="rpt-table">
            <thead><tr><th>#</th><th>Programa</th><th>Fabricante</th><th>Equipos</th><th>Instalaciones</th></tr></thead>
            <tbody>
                @{ var rank = 0; }
                @foreach (var r in _detail)
                {
                    rank++;
                    <tr>
                        <td>@rank</td>
                        <td>@r.Programa</td>
                        <td>@r.Publisher</td>
                        <td>@r.Equipos</td>
                        <td>@r.Instalaciones</td>
                    </tr>
                }
                @if (_detail.Count == 0)
                {
                    <tr><td colspan="5" class="rpt-empty">Sin software para el filtro.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string _so = "";
    private string _bits = "";
    private string _programa = "";
    private string _publisher = "";
    private string? _error;

    private string? _sourceKey;
    private string? _kEquipo, _kSo, _kPrograma, _kVersion, _kPublisher, _kBits;

    private long _equipos, _programas, _instalaciones, _publishers, _win7;
    private string _pct64 = "0%";

    private object? _topSoftware, _publishersChart, _soChart, _bitsChart;

    private readonly List<string> _soOptions = new();
    private readonly List<string> _bitsOptions = new();
    private readonly List<string> _soKeys = new();
    private readonly List<string> _bitsKeys = new();
    private readonly Dictionary<(string, string), long> _matrix = new();
    private long _matrixMax;
    private List<DetailRow> _detail = new();
    private bool _optionsLoaded;

    private static readonly string[] Palette = { "#4f46e5", "#0ea5e9", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899", "#14b8a6" };

    protected override async Task OnInitializedAsync()
    {
        await ResolveSourceAsync();
        await LoadAsync();
    }

    private async Task ResolveSourceAsync()
    {
        try
        {
            var sources = await Catalog.GetSourcesAsync();
            var ocs = sources.FirstOrDefault(s => s.Kind == ReportSourceKind.Container
                && s.DisplayName.Contains("OCS", StringComparison.OrdinalIgnoreCase));
            if (ocs is null)
            {
                _error = "No se encontro el contenedor de OCS Inventory en este tenant.";
                return;
            }

            _sourceKey = ocs.Key;
            _kEquipo = KeyOf(ocs, "Equipo");
            _kSo = KeyOf(ocs, "SO");
            _kPrograma = KeyOf(ocs, "Programa");
            _kVersion = KeyOf(ocs, "Version");
            _kPublisher = KeyOf(ocs, "Publisher");
            _kBits = KeyOf(ocs, "Bits");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string? KeyOf(ReportSourceDescriptor d, string name) =>
        d.Fields.FirstOrDefault(f => string.Equals(f.DisplayName, name, StringComparison.OrdinalIgnoreCase))?.Key;

    private async Task ClearFilters()
    {
        _so = _bits = _programa = _publisher = "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_sourceKey is null || _kEquipo is null || _kSo is null || _kPrograma is null
            || _kPublisher is null || _kBits is null)
        {
            return;
        }

        _error = null;
        try
        {
            var filters = new List<ReportFilter>();
            if (!string.IsNullOrWhiteSpace(_so)) { filters.Add(ReportFilter.Eq(_kSo, _so)); }
            if (!string.IsNullOrWhiteSpace(_bits)) { filters.Add(ReportFilter.Eq(_kBits, _bits)); }
            if (!string.IsNullOrWhiteSpace(_programa)) { filters.Add(new ReportFilter(_kPrograma, ReportFilterOperator.Contains, new string?[] { _programa.Trim() })); }
            if (!string.IsNullOrWhiteSpace(_publisher)) { filters.Add(new ReportFilter(_kPublisher, ReportFilterOperator.Contains, new string?[] { _publisher.Trim() })); }

            var ds = await ReportDs.QueryAsync(new ReportQuerySpec
            {
                SourceKey = _sourceKey,
                Fields = new string[] { _kEquipo, _kSo, _kPrograma, _kVersion ?? _kPrograma, _kPublisher, _kBits },
                Filters = filters
            }, new ReportContext(Guid.Empty));

            var idx = ds.Columns.Select((c, i) => (c.Key, i))
                .ToDictionary(x => x.Key, x => x.i, StringComparer.OrdinalIgnoreCase);
            int iEq = idx[_kEquipo], iSo = idx[_kSo], iPr = idx[_kPrograma], iPu = idx[_kPublisher], iBi = idx[_kBits];

            var equipos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var programas = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var publishers = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var soEquipos = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);
            var bitsCount = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            var progInstalls = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            var progEquipos = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);
            var progPublisher = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            var pubInstalls = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            var win7 = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            _matrix.Clear();
            var seenSo = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var seenBits = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            long total = 0, bits64 = 0;

            foreach (var row in ds.Rows)
            {
                var eq = Norm(row[iEq]);
                var so = Norm(row[iSo]);
                var pr = Norm(row[iPr]);
                var pu = Norm(row[iPu]);
                var bi = Norm(row[iBi]);

                total++;
                if (eq.Length > 0) { equipos.Add(eq); }
                if (pr.Length > 0) { programas.Add(pr); }
                if (pu.Length > 0) { publishers.Add(pu); }
                if (bi == "64") { bits64++; }

                if (!soEquipos.TryGetValue(so, out var se)) { soEquipos[so] = se = new HashSet<string>(StringComparer.OrdinalIgnoreCase); }
                if (eq.Length > 0) { se.Add(eq); }
                bitsCount[bi] = bitsCount.GetValueOrDefault(bi) + 1;

                progInstalls[pr] = progInstalls.GetValueOrDefault(pr) + 1;
                if (!progEquipos.TryGetValue(pr, out var pe)) { progEquipos[pr] = pe = new HashSet<string>(StringComparer.OrdinalIgnoreCase); }
                if (eq.Length > 0) { pe.Add(eq); }
                if (!progPublisher.ContainsKey(pr) && pu.Length > 0) { progPublisher[pr] = pu; }
                pubInstalls[pu] = pubInstalls.GetValueOrDefault(pu) + 1;

                if (so.Contains(" 7") || so.Contains("Win7") || so.Contains("Windows 7")) { if (eq.Length > 0) { win7.Add(eq); } }

                seenSo.Add(so);
                seenBits.Add(bi);
                var key = (so, bi);
                _matrix[key] = _matrix.GetValueOrDefault(key) + 1;
            }

            _equipos = equipos.Count;
            _programas = programas.Count;
            _instalaciones = total;
            _publishers = publishers.Count;
            _win7 = win7.Count;
            _pct64 = total > 0 ? ((double)bits64 / total).ToString("0.#%", System.Globalization.CultureInfo.InvariantCulture) : "0%";

            _soKeys.Clear();
            _soKeys.AddRange(soEquipos.OrderByDescending(kv => kv.Value.Count).Select(kv => kv.Key).Where(k => k.Length > 0).Take(10));
            _bitsKeys.Clear();
            _bitsKeys.AddRange(new[] { "64", "32" }.Where(seenBits.Contains)
                .Concat(seenBits.Where(b => b is not ("64" or "32")).OrderBy(b => b)));
            _matrixMax = _matrix.Count > 0 ? _matrix.Values.Max() : 0;

            if (!_optionsLoaded && filters.Count == 0)
            {
                _soOptions.Clear();
                _soOptions.AddRange(soEquipos.OrderByDescending(kv => kv.Value.Count).Select(kv => kv.Key).Where(k => k.Length > 0));
                _bitsOptions.Clear();
                _bitsOptions.AddRange(new[] { "64", "32" }.Where(seenBits.Contains)
                    .Concat(seenBits.Where(b => b is not ("64" or "32") && b.Length > 0).OrderBy(b => b)));
                _optionsLoaded = true;
            }

            var topProg = progInstalls.OrderByDescending(kv => kv.Value).Take(12).ToList();
            _topSoftware = BuildTopBar(topProg);

            var topPub = pubInstalls.Where(kv => kv.Key.Length > 0).OrderByDescending(kv => kv.Value).Take(8).ToList();
            _publishersChart = BuildDonut(topPub);

            var topSo = soEquipos.Where(kv => kv.Key.Length > 0).OrderByDescending(kv => kv.Value.Count).Take(8)
                .Select(kv => new KeyValuePair<string, long>(kv.Key, kv.Value.Count)).ToList();
            _soChart = BuildSoBar(topSo);

            _bitsChart = BuildBitsDonut(bitsCount);

            _detail = topProg.Select(kv => new DetailRow(
                kv.Key,
                progPublisher.GetValueOrDefault(kv.Key, ""),
                progEquipos.GetValueOrDefault(kv.Key)?.Count ?? 0,
                kv.Value)).ToList();
        }
        catch (ReportValidationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string Norm(object? v) => (v?.ToString() ?? "").Trim();
    private static string BitsLabel(string b) => b switch { "64" => "64-bit", "32" => "32-bit", "0" or "" => "N/D", _ => b };

    private long Cell(string s, string b) => _matrix.GetValueOrDefault((s, b));
    private long RowTotal(string s) => _bitsKeys.Sum(b => Cell(s, b));
    private long ColTotal(string b) => _soKeys.Sum(s => Cell(s, b));

    private string HeatStyle(long v)
    {
        if (v == 0 || _matrixMax == 0) { return ""; }
        var t = (double)v / _matrixMax;
        var alpha = (0.08 + t * 0.42).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        return $"background: rgba(79,70,229,{alpha});";
    }

    private object BuildTopBar(List<KeyValuePair<string, long>> data)
    {
        var cats = data.Select(kv => kv.Key).Reverse().ToArray();
        var vals = data.Select(kv => (object)kv.Value).Reverse().ToArray();
        return new Dictionary<string, object?>
        {
            ["color"] = new[] { Palette[0] },
            ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "axis", ["axisPointer"] = new Dictionary<string, object?> { ["type"] = "shadow" } },
            ["grid"] = new Dictionary<string, object?> { ["left"] = 170, ["right"] = 24, ["top"] = 10, ["bottom"] = 24 },
            ["xAxis"] = new Dictionary<string, object?> { ["type"] = "value" },
            ["yAxis"] = new Dictionary<string, object?> { ["type"] = "category", ["data"] = cats },
            ["series"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["type"] = "bar",
                    ["barMaxWidth"] = 20,
                    ["itemStyle"] = new Dictionary<string, object?> { ["borderRadius"] = new[] { 0, 4, 4, 0 } },
                    ["label"] = new Dictionary<string, object?> { ["show"] = true, ["position"] = "right" },
                    ["data"] = vals
                }
            }
        };
    }

    private object BuildDonut(List<KeyValuePair<string, long>> data) => new Dictionary<string, object?>
    {
        ["color"] = Palette,
        ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "item", ["formatter"] = "{b}: {c} ({d}%)" },
        ["legend"] = new Dictionary<string, object?> { ["bottom"] = 0, ["type"] = "scroll" },
        ["series"] = new object[]
        {
            new Dictionary<string, object?>
            {
                ["type"] = "pie",
                ["radius"] = new[] { "42%", "70%" },
                ["itemStyle"] = new Dictionary<string, object?> { ["borderRadius"] = 6, ["borderColor"] = "#fff", ["borderWidth"] = 2 },
                ["label"] = new Dictionary<string, object?> { ["show"] = false },
                ["data"] = data.Select(kv => new Dictionary<string, object?> { ["name"] = kv.Key, ["value"] = kv.Value }).ToArray()
            }
        }
    };

    private object BuildSoBar(List<KeyValuePair<string, long>> data)
    {
        var cats = data.Select(kv => kv.Key).ToArray();
        return new Dictionary<string, object?>
        {
            ["color"] = new[] { Palette[2] },
            ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "axis" },
            ["grid"] = new Dictionary<string, object?> { ["left"] = 44, ["right"] = 16, ["top"] = 16, ["bottom"] = 70 },
            ["xAxis"] = new Dictionary<string, object?> { ["type"] = "category", ["data"] = cats, ["axisLabel"] = new Dictionary<string, object?> { ["interval"] = 0, ["rotate"] = 24 } },
            ["yAxis"] = new Dictionary<string, object?> { ["type"] = "value" },
            ["series"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["type"] = "bar",
                    ["barMaxWidth"] = 48,
                    ["itemStyle"] = new Dictionary<string, object?> { ["borderRadius"] = new[] { 6, 6, 0, 0 } },
                    ["label"] = new Dictionary<string, object?> { ["show"] = true, ["position"] = "top" },
                    ["data"] = data.Select(kv => (object)kv.Value).ToArray()
                }
            }
        };
    }

    private object BuildBitsDonut(Dictionary<string, long> counts)
    {
        var data = _bitsKeys.Concat(counts.Keys.Where(k => !_bitsKeys.Contains(k)))
            .Distinct()
            .Where(k => counts.GetValueOrDefault(k) > 0)
            .Select(k => new Dictionary<string, object?> { ["name"] = BitsLabel(k), ["value"] = counts.GetValueOrDefault(k) })
            .ToArray();
        return new Dictionary<string, object?>
        {
            ["color"] = new[] { Palette[0], Palette[3], Palette[4] },
            ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "item", ["formatter"] = "{b}: {c} ({d}%)" },
            ["legend"] = new Dictionary<string, object?> { ["bottom"] = 0 },
            ["series"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["type"] = "pie",
                    ["radius"] = new[] { "42%", "70%" },
                    ["itemStyle"] = new Dictionary<string, object?> { ["borderRadius"] = 6, ["borderColor"] = "#fff", ["borderWidth"] = 2 },
                    ["label"] = new Dictionary<string, object?> { ["formatter"] = "{b}: {d}%" },
                    ["data"] = data
                }
            }
        };
    }

    private sealed record DetailRow(string Programa, string Publisher, int Equipos, long Instalaciones);
}
