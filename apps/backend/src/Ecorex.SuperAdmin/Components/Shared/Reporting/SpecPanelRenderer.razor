@using System.Globalization
@using Ecorex.Application.Reporting
@using Ecorex.Application.Reporting.Panels
@inject IReportCatalog Catalog
@inject IReportDataSource ReportDs
@inject IReportDefinitionService Defs
@implements IDisposable

@* ADR-0066 - Renderizador de panel GENERICO por spec. UN solo componente que interpreta un PanelSpec
   (dato) y pinta KPIs + graficos + matriz + tabla REUSANDO los estilos rpt-* y los MISMOS builders de
   ECharts (EChartBuilders) que usan los paneles a medida. Resuelve las fuentes por nombre en el tenant
   activo (tenant-safe via IReportCatalog/IReportDataSource), carga la principal UNA vez, hace join y
   derivados en memoria, filtra en memoria y agrega con PanelDataEngine. Sin recompilar ni desplegar:
   cada panel nuevo es un ReportDefinition.SpecJson. *@

<div class="rpt-dash">
    @if (_filters.Count > 0)
    {
        <div class="rpt-filters">
            @foreach (var f in _filters)
            {
                var filter = f;
                @if (filter.Spec.Control.Equals("daterange", StringComparison.OrdinalIgnoreCase))
                {
                    <label>@filter.Label desde <input type="date" value="@filter.From" @onchange="e => SetFrom(filter, e.Value?.ToString())" /></label>
                    <label>hasta <input type="date" value="@filter.To" @onchange="e => SetTo(filter, e.Value?.ToString())" /></label>
                }
                else if (filter.Spec.Control.Equals("text", StringComparison.OrdinalIgnoreCase))
                {
                    <label>@filter.Label <input type="text" placeholder="contiene..." value="@filter.Value" @onchange="e => SetValue(filter, e.Value?.ToString())" /></label>
                }
                else if (filter.Spec.Multi)
                {
                    @* Multi-valor (queryParam SSRS, v0.15.173): elegir varios codigos re-consulta con IN (...). *@
                    <label>@filter.Label
                        <select multiple size="4" @onchange="e => SetMulti(filter, e.Value)">
                            @if (filter.OptionPairs.Count > 0)
                            {
                                @foreach (var o in filter.OptionPairs) { <option value="@o.Value" selected="@filter.Selected.Contains(o.Value)">@o.Label</option> }
                            }
                            else
                            {
                                @foreach (var o in filter.Options) { <option value="@o" selected="@filter.Selected.Contains(o)">@o</option> }
                            }
                        </select>
                    </label>
                }
                else
                {
                    <label>@filter.Label
                        <select value="@filter.Value" @onchange="e => SetValue(filter, e.Value?.ToString())">
                            <option value="">(todos)</option>
                            @if (filter.OptionPairs.Count > 0)
                            {
                                @foreach (var o in filter.OptionPairs) { <option value="@o.Value">@o.Label</option> }
                            }
                            else
                            {
                                @foreach (var o in filter.Options) { <option value="@o">@o</option> }
                            }
                        </select>
                    </label>
                }
            }
            <button class="rpt-btn ghost" @onclick="ClearFilters">Limpiar</button>
            @if (_reloading)
            {
                <span class="rpt-sub" style="align-self:center;">Actualizando...</span>
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="rpt-error">@_error</div>
    }
    else if (_loading)
    {
        <div class="rpt-sub">Cargando datos del panel...</div>
    }
    else
    {
        @if (_kpis.Count > 0)
        {
            <div class="rpt-kpis" style="grid-template-columns:repeat(@Math.Min(_kpis.Count, 6), 1fr);">
                @{ var ki = 0; }
                @foreach (var k in _kpis)
                {
                    var accent = KpiAccent(ki++);
                    <div class="rpt-kpi @accent"><span class="k-val">@k.Value</span><span class="k-lbl">@k.Label</span></div>
                }
            </div>
        }

        <div class="rpt-grid">
            @foreach (var w in _widgets)
            {
                var widget = w;
                <div class="rpt-card @(widget.Full ? "rpt-full" : "")">
                    <h3>@widget.Title</h3>
                    @switch (widget.Kind)
                    {
                        case WKind.Chart:
                            <EChart Option="widget.Option" Height="@(widget.Height + "px")" />
                            break;
                        case WKind.Matrix:
                            @if (widget.Matrix is null || widget.Matrix.RowKeys.Count == 0)
                            {
                                <p class="rpt-empty">Sin datos.</p>
                            }
                            else
                            {
                                <table class="rpt-matrix">
                                    <thead>
                                        <tr>
                                            <th class="corner">@widget.RowDimLabel \ @widget.ColDimLabel</th>
                                            @foreach (var c in widget.Matrix.ColKeys) { <th>@c</th> }
                                            <th class="tot">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in widget.Matrix.RowKeys)
                                        {
                                            <tr>
                                                <td class="rowhead">@r</td>
                                                @foreach (var c in widget.Matrix.ColKeys)
                                                {
                                                    var v = widget.Matrix.Cell(r, c);
                                                    <td class="num @(v == 0 ? "zero" : "")" style="@HeatStyle(widget, v)">@(v == 0 ? "" : Fmt(v))</td>
                                                }
                                                <td class="num tot">@Fmt(widget.Matrix.RowTotal(r))</td>
                                            </tr>
                                        }
                                        <tr class="totalrow">
                                            <td class="rowhead">Total</td>
                                            @foreach (var c in widget.Matrix.ColKeys) { <td class="num tot">@Fmt(widget.Matrix.ColTotal(c))</td> }
                                            <td class="num grand">@Fmt(widget.Matrix.Grand)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                            break;
                        case WKind.Table:
                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        @for (var i = 0; i < widget.TableHeaders.Count; i++)
                                        {
                                            <th class="@(widget.TableNumeric[i] ? "num" : "")">@widget.TableHeaders[i]</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var rank = 0; }
                                    @foreach (var row in widget.TableRows)
                                    {
                                        rank++;
                                        <tr>
                                            <td>@rank</td>
                                            @for (var i = 0; i < row.Count; i++)
                                            {
                                                <td class="@(widget.TableNumeric[i] ? "num" : "")">@row[i]</td>
                                            }
                                        </tr>
                                    }
                                    @if (widget.TableRows.Count == 0)
                                    {
                                        <tr><td colspan="@(widget.TableHeaders.Count + 1)" class="rpt-empty">Sin datos para el filtro.</td></tr>
                                    }
                                </tbody>
                            </table>
                            break;
                        default:
                            <p class="rpt-empty">@widget.Message</p>
                            break;
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Id del ReportDefinition (Kind=Panel, SourceKey "panel:spec") cuyo SpecJson se pinta.</summary>
    [Parameter] public Guid ReportId { get; set; }

    /// <summary>Alternativa a ReportId: el PanelSpec en JSON directo (para vista previa del editor).</summary>
    [Parameter] public string? SpecJson { get; set; }

    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private PanelSpec? _spec;
    private string? _error;
    private bool _loading = true;
    private bool _loaded;

    // Fuente principal resuelta: cuando es EXTERNA (ADR-0064) los filtros queryParam RE-CONSULTAN el dataset.
    private ReportSourceDescriptor? _main;
    private IReadOnlyList<ReportSourceDescriptor> _sources = Array.Empty<ReportSourceDescriptor>();
    private bool MainIsExternal => _main?.Kind == ReportSourceKind.External;
    private bool _reloading;                            // re-consulta externa en curso (estado de carga)
    private CancellationTokenSource? _reloadCts;        // debounce de la re-consulta por queryParam

    private readonly List<PanelRow> _rows = new();     // filas enriquecidas (join + derivados)
    private List<PanelRow> _filtered = new();
    private readonly List<ActiveFilter> _filters = new();
    private readonly List<KpiValue> _kpis = new();
    private readonly List<RenderWidget> _widgets = new();

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
        {
            return;
        }

        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var json = SpecJson;
            if (string.IsNullOrWhiteSpace(json) && ReportId != Guid.Empty)
            {
                json = await Defs.GetSpecJsonAsync(ReportId);
            }

            _spec = PanelSpec.FromJson(json);
            if (_spec is null)
            {
                _error = "El panel no tiene un PanelSpec valido.";
                return;
            }

            _sources = await Catalog.GetSourcesAsync();
            var mainRefName = !string.IsNullOrWhiteSpace(_spec.Sources.Main.Source)
                ? _spec.Sources.Main.Source
                : _spec.Sources.Main.Container;
            _main = PanelSpecValidator.FindByRef(_sources, _spec.Sources.Main.Source, _spec.Sources.Main.Container);
            if (_main is null)
            {
                _error = $"Este tenant no tiene la fuente requerida '{mainRefName}'. El panel no se puede mostrar aqui.";
                return;
            }

            // Controles de filtro: se construyen UNA vez (conservan la seleccion entre re-consultas). Las
            // opciones de un dropdown con origen de lookup se cargan aqui (estables, no dependen del Main).
            await BuildFiltersAsync();

            // Carga de la fuente principal (con los parametros queryParam actuales si es externa) + join +
            // derivados + where + opciones distintas + recompute. Inicialmente sin queryParams -> defaults.
            await ReloadMainAsync();
        }
        catch (ReportValidationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>(Re)carga la fuente PRINCIPAL y reconstruye filas/lookups/derivados/where/opciones y recomputa.
    /// Si la principal es EXTERNA y hay filtros queryParam con valor, la consulta viaja con esos PARAMETROS
    /// (Inputs) en vez de los defaults; asi cambiar Grupo/Marca/rango de fechas re-consulta el SQL. Para
    /// fuentes no externas Inputs va null (identico al comportamiento clasico).</summary>
    private async Task ReloadMainAsync()
    {
        if (_spec is null || _main is null)
        {
            return;
        }

        // 1) Fuente principal: UNA consulta tabular con todos sus campos escalares (+ parametros si externa).
        var inputs = MainIsExternal ? BuildMainInputs() : null;
        var mainDs = await ReportDs.QueryAsync(new ReportQuerySpec
        {
            SourceKey = _main.Key,
            Fields = _main.Fields.Select(f => f.Key).ToArray(),
            Inputs = inputs
        }, new ReportContext(Guid.Empty));
        var mainCols = mainDs.Columns;

        _rows.Clear();
        foreach (var raw in mainDs.Rows)
        {
            var row = new PanelRow();
            for (var i = 0; i < mainCols.Count && i < raw.Count; i++)
            {
                // Indexa por DisplayName Y por Key: el spec puede referir un campo por cualquiera (ADR-0068).
                row[mainCols[i].DisplayName] = raw[i];
                row[mainCols[i].Key] = raw[i];
            }

            _rows.Add(row);
        }

        // 2) Lookups + join en memoria (codigo -> nombre; trae valores incl. numericos agregables).
        await ApplyLookupsAsync(_sources);

        // 3) Derivados (buckets de fecha).
        foreach (var d in _spec.Derived)
        {
            foreach (var row in _rows)
            {
                row[d.Name] = PanelDataEngine.Derive(row.GetValueOrDefault(d.From), d.Op);
            }
        }

        // 4) Where FIJO (ADR-0068): acota el panel SIEMPRE (no es control de UI), antes de poblar dropdowns.
        if (_spec.Where.Count > 0)
        {
            _rows.RemoveAll(row => !_spec.Where.All(w => PanelDataEngine.Matches(row, w.Field, w.Op, w.Value)));
        }

        // 5) Opciones DISTINCT de los dropdowns que NO tienen origen de lookup (queryParam o no). Los que ya
        // tienen opciones de lookup no se tocan (son estables y no dependen de este resultado).
        RefreshDistinctOptions();

        Recompute();
    }

    /// <summary>Arma el diccionario de PARAMETROS (nombre -> valor) a partir de los filtros queryParam con
    /// valor. Multi-valor: los codigos elegidos van separados por salto de linea (SplitMultiValues, v0.15.173).
    /// daterange: Param = fecha inicial, ParamTo = fecha final. Un filtro sin valor no aporta parametro (el
    /// dataset usa su DefaultValue). Diccionario vacio -> el dataset corre con sus defaults, como hoy.</summary>
    private Dictionary<string, string?> BuildMainInputs()
    {
        var inputs = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in _filters)
        {
            if (!f.Spec.QueryParam)
            {
                continue;
            }

            var param = !string.IsNullOrWhiteSpace(f.Spec.Param) ? f.Spec.Param!.Trim() : f.Spec.Field?.Trim();

            if (f.Spec.Control.Equals("daterange", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(param) && !string.IsNullOrWhiteSpace(f.From)) { inputs[param!] = f.From; }
                var paramTo = f.Spec.ParamTo?.Trim();
                if (!string.IsNullOrWhiteSpace(paramTo) && !string.IsNullOrWhiteSpace(f.To)) { inputs[paramTo!] = f.To; }
                continue;
            }

            if (string.IsNullOrWhiteSpace(param))
            {
                continue;
            }

            if (f.Spec.Multi)
            {
                if (f.Selected.Count > 0) { inputs[param!] = string.Join("\n", f.Selected); }
            }
            else if (!string.IsNullOrWhiteSpace(f.Value))
            {
                inputs[param!] = f.Value.Trim();
            }
        }

        return inputs;
    }

    private async Task ApplyLookupsAsync(IReadOnlyList<ReportSourceDescriptor> sources)
    {
        // Recorre TODOS los lookups (no solo el de _spec.Join): un panel puede cruzar la fuente principal
        // con 2+ lookups (ej. SIIGO: clientes por NIT Y vendedores por codigo). Cada lookup es
        // autocontenido via su MainKey; si no lo trae, cae al Join por compatibilidad (SIIGO actual).
        foreach (var lookupSpec in _spec!.Sources.Lookups)
        {
            if (string.IsNullOrWhiteSpace(lookupSpec.Container) && string.IsNullOrWhiteSpace(lookupSpec.Source))
            {
                continue;
            }

            var mainKey = !string.IsNullOrWhiteSpace(lookupSpec.MainKey)
                ? lookupSpec.MainKey!
                : (_spec.Join is not null
                    && string.Equals(_spec.Join.Lookup, lookupSpec.Container, StringComparison.OrdinalIgnoreCase)
                        ? _spec.Join.MainKey
                        : null);

            if (string.IsNullOrWhiteSpace(mainKey))
            {
                continue; // lookup sin forma de cruzar (ni MainKey ni Join que lo apunte): se ignora.
            }

            await ApplyOneLookupAsync(sources, lookupSpec, mainKey!);
        }
    }

    /// <summary>Aplica UN lookup: consulta la fuente (por Source/clave o Container/nombre), opcionalmente
    /// deduplica (Reduce, latest por Reference) y normaliza la clave (KeyTransform, beforeDash), mapea
    /// Key -> (Bring) y asigna los alias a cada fila principal usando <paramref name="mainKey"/>. Los valores
    /// numericos traidos quedan agregables (Sum). Sin efecto si falta la fuente/clave/Bring.</summary>
    private async Task ApplyOneLookupAsync(
        IReadOnlyList<ReportSourceDescriptor> sources, PanelLookup lookupSpec, string mainKey)
    {
        var lookupSrc = PanelSpecValidator.FindByRef(sources, lookupSpec.Source, lookupSpec.Container);
        if (lookupSrc is null)
        {
            return;
        }

        var keyField = FieldKeyByName(lookupSrc, lookupSpec.Key);
        var bringFields = lookupSpec.Bring
            .Select(b => (Alias: string.IsNullOrWhiteSpace(b.Value) ? b.Key : b.Value, Key: FieldKeyByName(lookupSrc, b.Key)))
            .Where(x => x.Key is not null)
            .ToList();
        if (keyField is null || bringFields.Count == 0)
        {
            return;
        }

        var fieldKeys = new List<string> { keyField };
        fieldKeys.AddRange(bringFields.Select(b => b.Key!));

        // Reduce (dedupe): pide el campo 'By' + marcas de tiempo conocidas para elegir la mas reciente.
        string? reduceByKey = null;
        var tsKeys = new List<string>();
        if (lookupSpec.Reduce is not null)
        {
            reduceByKey = FieldKeyByName(lookupSrc, lookupSpec.Reduce.By);
            if (reduceByKey is not null)
            {
                fieldKeys.Add(reduceByKey);
            }

            foreach (var tk in new[] { "TransactionDate", "SubmittedAt", "CreatedAt" })
            {
                var k = lookupSrc.Fields.FirstOrDefault(f => string.Equals(f.Key, tk, StringComparison.OrdinalIgnoreCase))?.Key;
                if (k is not null)
                {
                    tsKeys.Add(k);
                    fieldKeys.Add(k);
                }
            }
        }

        var ds = await ReportDs.QueryAsync(new ReportQuerySpec
        {
            SourceKey = lookupSrc.Key,
            Fields = fieldKeys.Distinct(StringComparer.OrdinalIgnoreCase).ToArray()
        }, new ReportContext(Guid.Empty));

        var idx = ds.Columns.Select((c, i) => (c.Key, i))
            .ToDictionary(x => x.Key, x => x.i, StringComparer.OrdinalIgnoreCase);

        // Materializa filas del lookup a dicts por Key de columna.
        var lkRows = ds.Rows.Select(raw =>
        {
            var d = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            foreach (var kv in idx)
            {
                d[kv.Key] = kv.Value < raw.Count ? raw[kv.Value] : null;
            }

            return d;
        }).ToList();

        // Dedupe por Reduce.By: una fila por grupo (latest por timestamp, o first).
        if (lookupSpec.Reduce is not null && reduceByKey is not null)
        {
            var keepLatest = !string.Equals(lookupSpec.Reduce.Keep, "first", StringComparison.OrdinalIgnoreCase);
            lkRows = lkRows
                .GroupBy(r => PanelDataEngine.Norm(r.GetValueOrDefault(reduceByKey)))
                .Select(g => keepLatest ? g.OrderByDescending(r => RowStamp(r, tsKeys)).First() : g.First())
                .ToList();
        }

        var transform = lookupSpec.KeyTransform;
        var map = new Dictionary<string, Dictionary<string, object?>>(StringComparer.OrdinalIgnoreCase);
        foreach (var r in lkRows)
        {
            var key = PanelDataEngine.TransformKey(PanelDataEngine.Norm(r.GetValueOrDefault(keyField)), transform);
            if (key.Length == 0 || map.ContainsKey(key))
            {
                continue;
            }

            var brought = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            foreach (var b in bringFields)
            {
                brought[b.Alias] = r.GetValueOrDefault(b.Key!);
            }

            map[key] = brought;
        }

        foreach (var row in _rows)
        {
            var mainKeyVal = PanelDataEngine.TransformKey(PanelDataEngine.Norm(row.GetValueOrDefault(mainKey)), transform);
            if (map.TryGetValue(mainKeyVal, out var brought))
            {
                foreach (var kv in brought)
                {
                    row[kv.Key] = kv.Value;
                }
            }
        }
    }

    /// <summary>Marca de tiempo de una fila de lookup para "latest": primer timestamp no nulo en orden de
    /// preferencia (TransactionDate, SubmittedAt, CreatedAt).</summary>
    private static DateTimeOffset RowStamp(Dictionary<string, object?> row, List<string> tsKeys)
    {
        foreach (var k in tsKeys)
        {
            var d = PanelDataEngine.AsDate(row.GetValueOrDefault(k));
            if (d is not null)
            {
                return d.Value;
            }
        }

        return DateTimeOffset.MinValue;
    }

    /// <summary>Construye los controles de filtro UNA vez (se conservan entre re-consultas). Un dropdown con
    /// origen de LOOKUP carga aqui sus opciones codigo->etiqueta (estables). Los demas dropdowns pueblan sus
    /// opciones por distinct en <see cref="RefreshDistinctOptions"/> tras cada carga del Main.</summary>
    private async Task BuildFiltersAsync()
    {
        _filters.Clear();
        foreach (var f in _spec!.Filters)
        {
            var af = new ActiveFilter
            {
                Spec = f,
                Label = string.IsNullOrWhiteSpace(f.Label) ? (string.IsNullOrWhiteSpace(f.Param) ? f.Field : f.Param!) : f.Label!
            };

            if (f.Control.Equals("dropdown", StringComparison.OrdinalIgnoreCase)
                && f.Options is not null
                && (!string.IsNullOrWhiteSpace(f.Options.Source) || !string.IsNullOrWhiteSpace(f.Options.Container)))
            {
                af.OptionPairs = await LoadLookupOptionsAsync(f.Options);
            }

            _filters.Add(af);
        }
    }

    /// <summary>Carga las opciones (codigo -> etiqueta) de un dropdown desde un dataset de lookup del catalogo.
    /// El VALUE es el codigo que viaja al parametro; el Label es presentacion. Deduplica por codigo.</summary>
    private async Task<List<OptionPair>> LoadLookupOptionsAsync(PanelFilterOptions opt)
    {
        var src = PanelSpecValidator.FindByRef(_sources, opt.Source, opt.Container);
        if (src is null || string.IsNullOrWhiteSpace(opt.Value))
        {
            return new List<OptionPair>();
        }

        string? KeyOf(string name) => src.Fields.FirstOrDefault(x =>
            string.Equals(x.DisplayName, name, StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.Key, name, StringComparison.OrdinalIgnoreCase))?.Key;

        var valueKey = KeyOf(opt.Value);
        if (valueKey is null)
        {
            return new List<OptionPair>();
        }

        var labelKey = string.IsNullOrWhiteSpace(opt.Label) ? null : KeyOf(opt.Label!);
        var fields = labelKey is null ? new[] { valueKey } : new[] { valueKey, labelKey };
        var ds = await ReportDs.QueryAsync(new ReportQuerySpec
        {
            SourceKey = src.Key,
            Fields = fields.Distinct(StringComparer.OrdinalIgnoreCase).ToArray()
        }, new ReportContext(Guid.Empty));

        var vi = ds.Columns.Select((c, i) => (c.Key, i))
            .Where(x => string.Equals(x.Key, valueKey, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.i).DefaultIfEmpty(0).First();
        var li = labelKey is null ? vi : ds.Columns.Select((c, i) => (c.Key, i))
            .Where(x => string.Equals(x.Key, labelKey, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.i).DefaultIfEmpty(vi).First();

        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var pairs = new List<OptionPair>();
        foreach (var raw in ds.Rows)
        {
            var code = PanelDataEngine.Norm(vi < raw.Count ? raw[vi] : null);
            if (code.Length == 0 || !seen.Add(code)) { continue; }
            var label = PanelDataEngine.Norm(li < raw.Count ? raw[li] : null);
            pairs.Add(new OptionPair(code, label.Length > 0 ? label : code));
        }

        return pairs.OrderBy(p => p.Label, StringComparer.OrdinalIgnoreCase).ToList();
    }

    /// <summary>Refresca las opciones DISTINCT de los dropdowns SIN origen de lookup (se derivan del resultado
    /// actual del Main). Los dropdowns con OptionPairs (lookup) no se tocan.</summary>
    private void RefreshDistinctOptions()
    {
        foreach (var af in _filters)
        {
            if (!af.Spec.Control.Equals("dropdown", StringComparison.OrdinalIgnoreCase) || af.OptionPairs.Count > 0)
            {
                continue;
            }

            var field = string.IsNullOrWhiteSpace(af.Spec.Field) ? af.Spec.Param ?? "" : af.Spec.Field;
            af.Options = _rows.Select(r => PanelDataEngine.Norm(r.GetValueOrDefault(field)))
                .Where(s => s.Length > 0)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    // Un filtro queryParam RE-CONSULTA la fuente externa (con debounce); un filtro normal recomputa en memoria.
    private Task SetValue(ActiveFilter f, string? value) { f.Value = value ?? ""; return OnFilterChangedAsync(f); }
    private Task SetFrom(ActiveFilter f, string? value) { f.From = value; return OnFilterChangedAsync(f); }
    private Task SetTo(ActiveFilter f, string? value) { f.To = value; return OnFilterChangedAsync(f); }

    private Task SetMulti(ActiveFilter f, object? value)
    {
        // <select multiple> entrega string[] (o un solo string). Se guarda la lista de codigos elegidos.
        f.Selected = value switch
        {
            IEnumerable<string> many => many.Where(s => !string.IsNullOrWhiteSpace(s)).ToList(),
            string one when one.Length > 0 => new List<string> { one },
            _ => new List<string>()
        };
        return OnFilterChangedAsync(f);
    }

    private async Task OnFilterChangedAsync(ActiveFilter f)
    {
        if (f.Spec.QueryParam && MainIsExternal)
        {
            await DebouncedReloadAsync();
        }
        else
        {
            Recompute();
        }
    }

    /// <summary>Re-consulta la fuente externa tras un pequeno retardo, cancelando cambios rapidos encadenados
    /// (debounce). Mantiene MaxRows/timeout/concesion (los aplica el reader); la cadena nunca se expone.</summary>
    private async Task DebouncedReloadAsync()
    {
        _reloadCts?.Cancel();
        var cts = new CancellationTokenSource();
        _reloadCts = cts;
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        _reloading = true;
        _error = null;
        StateHasChanged();
        try
        {
            await ReloadMainAsync();
        }
        catch (ReportValidationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _reloading = false;
            StateHasChanged();
        }
    }

    private Task ClearFilters()
    {
        var hadQueryParam = _filters.Any(f => f.Spec.QueryParam
            && (!string.IsNullOrWhiteSpace(f.Value) || f.Selected.Count > 0 || !string.IsNullOrWhiteSpace(f.From) || !string.IsNullOrWhiteSpace(f.To)));
        foreach (var f in _filters) { f.Value = ""; f.From = f.To = null; f.Selected = new List<string>(); }
        if (hadQueryParam && MainIsExternal)
        {
            return DebouncedReloadAsync();
        }

        Recompute();
        return Task.CompletedTask;
    }

    private void Recompute()
    {
        _filtered = ApplyFilters(_rows);
        BuildKpis();
        BuildWidgets();
    }

    private List<PanelRow> ApplyFilters(List<PanelRow> rows)
    {
        IEnumerable<PanelRow> q = rows;
        foreach (var f in _filters)
        {
            var spec = f.Spec;
            // Un queryParam ya acoto el resultado en el SQL (re-consulta); NO se vuelve a filtrar en memoria.
            if (spec.QueryParam)
            {
                continue;
            }

            if (spec.Control.Equals("daterange", StringComparison.OrdinalIgnoreCase))
            {
                var from = ParseDate(f.From);
                var to = ParseDate(f.To);
                if (from is not null)
                {
                    q = q.Where(r => PanelDataEngine.AsDate(r.GetValueOrDefault(spec.Field)) is DateTimeOffset d && d >= from);
                }

                if (to is not null)
                {
                    var toEnd = to.Value.AddDays(1);
                    q = q.Where(r => PanelDataEngine.AsDate(r.GetValueOrDefault(spec.Field)) is DateTimeOffset d && d < toEnd);
                }
            }
            else if (!string.IsNullOrWhiteSpace(f.Value))
            {
                var val = f.Value.Trim();
                if (spec.Control.Equals("text", StringComparison.OrdinalIgnoreCase))
                {
                    q = q.Where(r => PanelDataEngine.Norm(r.GetValueOrDefault(spec.Field)).Contains(val, StringComparison.OrdinalIgnoreCase));
                }
                else
                {
                    q = q.Where(r => string.Equals(PanelDataEngine.Norm(r.GetValueOrDefault(spec.Field)), val, StringComparison.OrdinalIgnoreCase));
                }
            }
        }

        return q.ToList();
    }

    private void BuildKpis()
    {
        _kpis.Clear();
        foreach (var k in _spec!.Kpis)
        {
            // KPI condicional (ADR-0068): agrega solo el subconjunto que cumple When (AND). Vacio = todo.
            var subset = k.When.Count == 0
                ? (IReadOnlyList<PanelRow>)_filtered
                : _filtered.Where(row => k.When.All(w => PanelDataEngine.Matches(row, w.Field, w.Op, w.Value))).ToList();

            // percentOfTotal (ADR-0089): razon numerador/denominador*100. El subconjunto When es el numerador
            // y el conjunto filtrado COMPLETO del panel es el denominador (ej. Cierre / total = % conversion).
            var value = string.Equals(k.Agg, "percentOfTotal", StringComparison.OrdinalIgnoreCase)
                ? PanelDataEngine.PercentOfTotal(subset, _filtered, k.Field)
                : PanelDataEngine.Aggregate(subset, k.Agg, k.Field);
            _kpis.Add(new KpiValue(k.Label, PanelDataEngine.Format(value, k.Format)));
        }
    }

    private void BuildWidgets()
    {
        _widgets.Clear();
        foreach (var w in _spec!.Widgets)
        {
            _widgets.Add(BuildWidget(w));
        }
    }

    private RenderWidget BuildWidget(PanelWidget w)
    {
        var full = string.Equals(w.Width, "full", StringComparison.OrdinalIgnoreCase);
        var rw = new RenderWidget { Title = w.Title, Full = full };
        var scale = w.Scale is double sc && sc > 0 ? sc : 1d;
        var isInteger = scale == 1d && (w.Agg is null
            || w.Agg.Equals("count", StringComparison.OrdinalIgnoreCase)
            || w.Agg.Equals("countDistinct", StringComparison.OrdinalIgnoreCase));

        try
        {
            switch ((w.Type ?? "").ToLowerInvariant())
            {
                case "line":
                {
                    var slices = PanelDataEngine.GroupAggregate(_filtered, w.Dim!, w.Agg, w.Field, scale, null, PanelSliceOrder.DimAsc);
                    rw.Kind = WKind.Chart;
                    rw.Height = w.Height ?? 320;
                    rw.Option = EChartBuilders.Line(slices.Select(s => s.Key).ToList(), slices.Select(s => s.Value).ToList());
                    break;
                }
                case "bar":
                {
                    var slices = PanelDataEngine.GroupAggregate(_filtered, w.Dim!, w.Agg, w.Field, scale, w.TopN, PanelSliceOrder.ValueDesc);
                    rw.Kind = WKind.Chart;
                    rw.Height = w.Height ?? 320;
                    if (string.Equals(w.Orientation, "horizontal", StringComparison.OrdinalIgnoreCase))
                    {
                        rw.Option = EChartBuilders.HorizontalBar(
                            slices.Select(s => Trunc(s.Key, 18)).ToList(), slices.Select(s => s.Value).ToList(),
                            color: EChartBuilders.Palette[2], integer: isInteger);
                    }
                    else
                    {
                        rw.Option = EChartBuilders.VerticalBar(
                            slices.Select(s => s.Key).ToList(), slices.Select(s => s.Value).ToList(),
                            rotate: 24, label: true, rawValues: isInteger, gridBottom: 70, gridLeft: 44);
                    }

                    break;
                }
                case "donut":
                {
                    var slices = PanelDataEngine.GroupAggregate(_filtered, w.Dim!, w.Agg, w.Field, scale, w.TopN, PanelSliceOrder.ValueDesc, includeBlank: true);
                    rw.Kind = WKind.Chart;
                    rw.Height = w.Height ?? 320;
                    rw.Option = EChartBuilders.Donut(slices.Select(s => (s.Key, s.Value)).ToList(), integerValues: isInteger);
                    break;
                }
                case "pareto":
                {
                    var (cats, bars, cum) = PanelDataEngine.Pareto(_filtered, w.Dim!, w.Agg, w.Field, scale, w.TopN ?? 20);
                    rw.Kind = WKind.Chart;
                    rw.Height = w.Height ?? 360;
                    var barName = MeasureLabel(w, scale);
                    rw.Option = EChartBuilders.Pareto(cats.Select(c => Trunc(c, 22)).ToList(), bars, cum,
                        barName: barName, cumName: "Acumulado %", leftAxisName: scale == 1_000_000d ? "M" : "");
                    break;
                }
                case "matrix":
                {
                    rw.Kind = WKind.Matrix;
                    rw.Heatmap = w.Heatmap;
                    rw.RowDimLabel = w.RowDim ?? "";
                    rw.ColDimLabel = w.ColDim ?? "";
                    rw.Matrix = PanelDataEngine.Matrix(_filtered, w.RowDim!, w.ColDim!, w.Agg, w.Field);
                    rw.Full = true;
                    break;
                }
                case "table":
                {
                    rw.Kind = WKind.Table;
                    rw.Full = true;
                    var rows = PanelDataEngine.TableRows(_filtered, w.GroupBy!, w.Columns, w.TopN);
                    foreach (var col in w.Columns)
                    {
                        rw.TableHeaders.Add(col.Label);
                        rw.TableNumeric.Add(!string.IsNullOrWhiteSpace(col.Agg));
                    }

                    foreach (var raw in rows)
                    {
                        var cells = new List<string>(w.Columns.Count);
                        for (var i = 0; i < w.Columns.Count; i++)
                        {
                            var col = w.Columns[i];
                            if (!string.IsNullOrWhiteSpace(col.Agg))
                            {
                                var dec = raw[i] is decimal d ? d : 0m;
                                cells.Add(PanelDataEngine.Format(dec, col.Format ?? "int"));
                            }
                            else
                            {
                                cells.Add(PanelDataEngine.Norm(raw[i]));
                            }
                        }

                        rw.TableRows.Add(cells);
                    }

                    break;
                }
                default:
                    rw.Kind = WKind.Unsupported;
                    rw.Message = $"Widget no soportado: '{w.Type}'.";
                    break;
            }
        }
        catch (Exception ex)
        {
            rw.Kind = WKind.Unsupported;
            rw.Message = ex.Message;
        }

        return rw;
    }

    private static string MeasureLabel(PanelWidget w, double scale)
    {
        var baseLabel = string.IsNullOrWhiteSpace(w.Field) ? "Valor" : w.Field!;
        return scale == 1_000_000d ? baseLabel + " (M)" : baseLabel;
    }

    private string Fmt(double v) => v.ToString("N0", Inv);

    private static string Trunc(string s, int n) => s.Length <= n ? s : s.Substring(0, n - 2) + "..";

    private static DateTimeOffset? ParseDate(string? s) =>
        DateTimeOffset.TryParse(s, Inv, DateTimeStyles.AssumeUniversal, out var d) ? d : null;

    private static string? FieldKeyByName(ReportSourceDescriptor d, string nameOrKey) =>
        d.Fields.FirstOrDefault(f =>
            string.Equals(f.DisplayName, nameOrKey, StringComparison.OrdinalIgnoreCase)
            || string.Equals(f.Key, nameOrKey, StringComparison.OrdinalIgnoreCase))?.Key;

    private static string KpiAccent(int i) => i switch
    {
        0 => "",
        1 => "prog",
        2 => "open",
        3 => "done",
        4 => "over",
        _ => "susp"
    };

    private string HeatStyle(RenderWidget w, double v)
    {
        if (!w.Heatmap || v == 0 || w.Matrix is null || w.Matrix.Max == 0)
        {
            return "";
        }

        var t = v / w.Matrix.Max;
        var alpha = (0.08 + t * 0.42).ToString("0.###", Inv);
        return $"background: rgba(79,70,229,{alpha});";
    }

    private enum WKind { Chart, Matrix, Table, Unsupported }

    private sealed class ActiveFilter
    {
        public PanelFilter Spec { get; set; } = new();
        public string Label { get; set; } = "";

        /// <summary>Opciones DISTINCT (codigo == etiqueta) para un dropdown sin origen de lookup.</summary>
        public List<string> Options { get; set; } = new();

        /// <summary>Opciones codigo -> etiqueta cuando el dropdown se alimenta de un dataset de lookup.</summary>
        public List<OptionPair> OptionPairs { get; set; } = new();

        /// <summary>Valor unico (dropdown simple / text).</summary>
        public string Value { get; set; } = "";

        /// <summary>Codigos elegidos en un dropdown multi-valor (queryParam multi).</summary>
        public List<string> Selected { get; set; } = new();

        public string? From { get; set; }
        public string? To { get; set; }
    }

    private sealed record OptionPair(string Value, string Label);

    public void Dispose()
    {
        // Cancela cualquier re-consulta pendiente (debounce) al desmontar el panel.
        try { _reloadCts?.Cancel(); _reloadCts?.Dispose(); } catch { }
    }

    private sealed record KpiValue(string Label, string Value);

    private sealed class RenderWidget
    {
        public WKind Kind { get; set; }
        public string Title { get; set; } = "";
        public bool Full { get; set; }
        public int Height { get; set; } = 320;
        public object? Option { get; set; }
        public PanelMatrix? Matrix { get; set; }
        public bool Heatmap { get; set; }
        public string RowDimLabel { get; set; } = "";
        public string ColDimLabel { get; set; } = "";
        public List<string> TableHeaders { get; } = new();
        public List<bool> TableNumeric { get; } = new();
        public List<List<string>> TableRows { get; } = new();
        public string? Message { get; set; }
    }
}
