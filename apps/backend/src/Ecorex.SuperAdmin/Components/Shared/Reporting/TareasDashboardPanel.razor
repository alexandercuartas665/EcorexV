@using Ecorex.Application.Reporting
@using Ecorex.Application.Reporting.Sources
@inject IReportCatalog Catalog
@inject IReportDataSource ReportDs

@* Panel de Tareas del Sistema (multi-grafico) REUTILIZABLE, sobre el contenedor "Reporte Tareas
   Personal" (datos traidos de db3dev). Una consulta tabular pivotada en memoria: KPIs, estado,
   prioridad, top encargados, top conceptos, matriz prioridad x estado y detalle. Filtros (encargado,
   estado, concepto, prioridad, texto) empujados a la BD. Encuentra el contenedor por nombre. *@

<div class="rpt-dash">
    <div class="rpt-filters">
        <label>Encargado
            <select @bind="_encargado">
                <option value="">(todos)</option>
                @foreach (var o in _encargadoOptions) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Estado
            <select @bind="_estado">
                <option value="">(todos)</option>
                @foreach (var o in _estadoOptions) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Concepto
            <select @bind="_concepto">
                <option value="">(todos)</option>
                @foreach (var o in _conceptoOptions) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Prioridad
            <select @bind="_prioridad">
                <option value="">(todas)</option>
                @foreach (var o in _prioridadOptions) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Buscar <input type="text" placeholder="detalle/codigo..." @bind="_texto" /></label>
        <button class="rpt-btn" @onclick="LoadAsync">Aplicar</button>
        <button class="rpt-btn ghost" @onclick="ClearFilters">Limpiar</button>
    </div>

    @if (_error is not null)
    {
        <div class="rpt-error">@_error</div>
    }

    <div class="rpt-kpis">
        <div class="rpt-kpi"><span class="k-val">@_total</span><span class="k-lbl">Tareas</span></div>
        <div class="rpt-kpi done"><span class="k-val">@_terminadas</span><span class="k-lbl">Terminadas</span></div>
        <div class="rpt-kpi susp"><span class="k-val">@_pendientes</span><span class="k-lbl">Pendientes</span></div>
        <div class="rpt-kpi open"><span class="k-val">@_pctTerm</span><span class="k-lbl">% Terminadas</span></div>
        <div class="rpt-kpi prog"><span class="k-val">@_encargados</span><span class="k-lbl">Encargados</span></div>
        <div class="rpt-kpi over"><span class="k-val">@_conceptos</span><span class="k-lbl">Conceptos</span></div>
    </div>

    <div class="rpt-grid">
        <div class="rpt-card">
            <h3>Por estado</h3>
            <EChart Option="_estadoDonut" Height="300px" />
        </div>
        <div class="rpt-card">
            <h3>Por prioridad</h3>
            <EChart Option="_prioridadBar" Height="300px" />
        </div>
        <div class="rpt-card">
            <h3>Top 10 encargados</h3>
            <EChart Option="_encargadoBar" Height="340px" />
        </div>
        <div class="rpt-card">
            <h3>Top 8 conceptos</h3>
            <EChart Option="_conceptoDonut" Height="340px" />
        </div>
    </div>

    <div class="rpt-card rpt-full">
        <h3>Tabla matriz &mdash; Prioridad &times; Estado</h3>
        @if (_prioKeys.Count == 0)
        {
            <p class="rpt-empty">Sin datos.</p>
        }
        else
        {
            <table class="rpt-matrix">
                <thead>
                    <tr>
                        <th class="corner">Prioridad \ Estado</th>
                        @foreach (var e in _estadoKeys) { <th>@e</th> }
                        <th class="tot">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _prioKeys)
                    {
                        <tr>
                            <td class="rowhead">@p</td>
                            @foreach (var e in _estadoKeys)
                            {
                                var v = Cell(p, e);
                                <td class="num @(v == 0 ? "zero" : "")" style="@HeatStyle(v)">@(v == 0 ? "" : v.ToString())</td>
                            }
                            <td class="num tot">@RowTotal(p)</td>
                        </tr>
                    }
                    <tr class="totalrow">
                        <td class="rowhead">Total</td>
                        @foreach (var e in _estadoKeys) { <td class="num tot">@ColTotal(e)</td> }
                        <td class="num grand">@_total</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>

    <div class="rpt-card rpt-full">
        <h3>Detalle &mdash; tareas recientes</h3>
        <table class="rpt-table">
            <thead><tr><th>Codigo</th><th>Concepto</th><th>Encargado</th><th>Prioridad</th><th>Estado</th><th>Fecha</th></tr></thead>
            <tbody>
                @foreach (var r in _detail)
                {
                    <tr>
                        <td>@r.Codigo</td>
                        <td>@r.Concepto</td>
                        <td>@r.Encargado</td>
                        <td>@r.Prioridad</td>
                        <td><span class="chip @(r.Estado == "TERMINADO" ? "ok" : "pend")">@r.Estado</span></td>
                        <td>@r.Fecha</td>
                    </tr>
                }
                @if (_detail.Count == 0)
                {
                    <tr><td colspan="6" class="rpt-empty">Sin tareas para el filtro.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string _encargado = "", _estado = "", _concepto = "", _prioridad = "", _texto = "";
    private string? _error;

    private string? _sourceKey;
    private string? _kCodigo, _kEstado, _kEncargado, _kConcepto, _kPrioridad, _kFecha, _kDetalle;

    private long _total, _terminadas, _pendientes, _encargados, _conceptos;
    private string _pctTerm = "0%";
    private object? _estadoDonut, _prioridadBar, _encargadoBar, _conceptoDonut;

    private readonly List<string> _encargadoOptions = new();
    private readonly List<string> _estadoOptions = new();
    private readonly List<string> _conceptoOptions = new();
    private readonly List<string> _prioridadOptions = new();
    private readonly List<string> _prioKeys = new();
    private readonly List<string> _estadoKeys = new();
    private readonly Dictionary<(string, string), long> _matrix = new();
    private long _matrixMax;
    private List<DetailRow> _detail = new();
    private bool _optionsLoaded;

    private static readonly string[] Palette = { "#4f46e5", "#10b981", "#f59e0b", "#ef4444", "#0ea5e9", "#8b5cf6", "#ec4899", "#14b8a6" };
    private static readonly string[] PrioOrder = { "ALTO", "MEDIO", "BAJO", "ESPERA", "INTERMEDIO" };

    protected override async Task OnInitializedAsync()
    {
        await ResolveSourceAsync();
        await LoadAsync();
    }

    private async Task ResolveSourceAsync()
    {
        try
        {
            var sources = await Catalog.GetSourcesAsync();
            var c = sources.FirstOrDefault(s => s.Kind == ReportSourceKind.Container
                && s.DisplayName.Contains("Tareas Personal", StringComparison.OrdinalIgnoreCase));
            if (c is null)
            {
                _error = "No se encontro el contenedor 'Reporte Tareas Personal' en este tenant.";
                return;
            }
            _sourceKey = c.Key;
            _kCodigo = KeyOf(c, "Codigo");
            _kEstado = KeyOf(c, "Estado");
            _kEncargado = KeyOf(c, "Encargado");
            _kConcepto = KeyOf(c, "Concepto");
            _kPrioridad = KeyOf(c, "Prioridad");
            _kFecha = KeyOf(c, "Fecha");
            _kDetalle = KeyOf(c, "Detalle");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string? KeyOf(ReportSourceDescriptor d, string name) =>
        d.Fields.FirstOrDefault(f => string.Equals(f.DisplayName, name, StringComparison.OrdinalIgnoreCase))?.Key;

    private async Task ClearFilters()
    {
        _encargado = _estado = _concepto = _prioridad = _texto = "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_sourceKey is null || _kEstado is null || _kEncargado is null || _kConcepto is null
            || _kPrioridad is null || _kCodigo is null)
        {
            return;
        }

        _error = null;
        try
        {
            var filters = new List<ReportFilter>();
            if (!string.IsNullOrWhiteSpace(_encargado)) { filters.Add(ReportFilter.Eq(_kEncargado, _encargado)); }
            if (!string.IsNullOrWhiteSpace(_estado)) { filters.Add(ReportFilter.Eq(_kEstado, _estado)); }
            if (!string.IsNullOrWhiteSpace(_concepto)) { filters.Add(ReportFilter.Eq(_kConcepto, _concepto)); }
            if (!string.IsNullOrWhiteSpace(_prioridad)) { filters.Add(ReportFilter.Eq(_kPrioridad, _prioridad)); }
            if (!string.IsNullOrWhiteSpace(_texto) && _kDetalle is not null) { filters.Add(new ReportFilter(_kDetalle, ReportFilterOperator.Contains, new string?[] { _texto.Trim() })); }

            var fieldKeys = new List<string> { _kCodigo, _kEstado, _kEncargado, _kConcepto, _kPrioridad };
            if (_kFecha is not null) { fieldKeys.Add(_kFecha); }

            var ds = await ReportDs.QueryAsync(new ReportQuerySpec
            {
                SourceKey = _sourceKey,
                Fields = fieldKeys.ToArray(),
                Filters = filters
            }, new ReportContext(Guid.Empty));

            var idx = ds.Columns.Select((c, i) => (c.Key, i)).ToDictionary(x => x.Key, x => x.i, StringComparer.OrdinalIgnoreCase);
            int iCod = idx[_kCodigo], iEst = idx[_kEstado], iEnc = idx[_kEncargado], iCon = idx[_kConcepto], iPri = idx[_kPrioridad];
            int iFec = _kFecha is not null && idx.ContainsKey(_kFecha) ? idx[_kFecha] : -1;

            var encargados = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var conceptos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var estadoCount = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            var prioCount = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            var encCount = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            var conCount = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            _matrix.Clear();
            var seenPrio = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var seenEstado = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            _total = _terminadas = _pendientes = 0;
            var detail = new List<DetailRow>();

            foreach (var row in ds.Rows)
            {
                var cod = Norm(row[iCod]); var est = Norm(row[iEst]); var enc = Norm(row[iEnc]);
                var con = Norm(row[iCon]); var pri = Norm(row[iPri]);
                var fec = iFec >= 0 ? Norm(row[iFec]) : "";

                _total++;
                if (est == "TERMINADO") { _terminadas++; }
                if (est == "PENDIENTE") { _pendientes++; }
                if (enc.Length > 0) { encargados.Add(enc); encCount[enc] = encCount.GetValueOrDefault(enc) + 1; }
                if (con.Length > 0) { conceptos.Add(con); conCount[con] = conCount.GetValueOrDefault(con) + 1; }
                if (est.Length > 0) { estadoCount[est] = estadoCount.GetValueOrDefault(est) + 1; seenEstado.Add(est); }
                if (pri.Length > 0) { prioCount[pri] = prioCount.GetValueOrDefault(pri) + 1; seenPrio.Add(pri); }
                var key = (pri.Length > 0 ? pri : "(sin)", est.Length > 0 ? est : "(sin)");
                _matrix[key] = _matrix.GetValueOrDefault(key) + 1;

                if (detail.Count < 15) { detail.Add(new DetailRow(cod, con, enc, pri, est, fec)); }
            }

            _encargados = encargados.Count;
            _conceptos = conceptos.Count;
            _pctTerm = _total > 0 ? ((double)_terminadas / _total).ToString("0.#%", System.Globalization.CultureInfo.InvariantCulture) : "0%";
            _detail = detail;

            _prioKeys.Clear();
            _prioKeys.AddRange(PrioOrder.Where(seenPrio.Contains).Concat(seenPrio.Where(p => !PrioOrder.Contains(p))));
            _estadoKeys.Clear();
            _estadoKeys.AddRange(new[] { "TERMINADO", "PENDIENTE" }.Where(seenEstado.Contains).Concat(seenEstado.Where(e => e is not ("TERMINADO" or "PENDIENTE"))));
            _matrixMax = _matrix.Count > 0 ? _matrix.Values.Max() : 0;

            if (!_optionsLoaded && filters.Count == 0)
            {
                _encargadoOptions.Clear();
                _encargadoOptions.AddRange(encCount.OrderByDescending(kv => kv.Value).Select(kv => kv.Key));
                _estadoOptions.Clear();
                _estadoOptions.AddRange(estadoCount.OrderByDescending(kv => kv.Value).Select(kv => kv.Key));
                _conceptoOptions.Clear();
                _conceptoOptions.AddRange(conCount.OrderByDescending(kv => kv.Value).Select(kv => kv.Key));
                _prioridadOptions.Clear();
                _prioridadOptions.AddRange(_prioKeys);
                _optionsLoaded = true;
            }

            _estadoDonut = BuildDonut(estadoCount, new[] { Palette[1], Palette[2], Palette[3] });
            _prioridadBar = BuildPrioBar(prioCount);
            _encargadoBar = BuildTopBar(encCount.OrderByDescending(kv => kv.Value).Take(10).ToList());
            _conceptoDonut = BuildDonut(conCount.OrderByDescending(kv => kv.Value).Take(8).ToDictionary(k => k.Key, v => v.Value), Palette);
        }
        catch (ReportValidationException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string Norm(object? v) => (v?.ToString() ?? "").Trim();
    private long Cell(string p, string e) => _matrix.GetValueOrDefault((p, e));
    private long RowTotal(string p) => _estadoKeys.Sum(e => Cell(p, e));
    private long ColTotal(string e) => _prioKeys.Sum(p => Cell(p, e));

    private string HeatStyle(long v)
    {
        if (v == 0 || _matrixMax == 0) { return ""; }
        var t = (double)v / _matrixMax;
        var alpha = (0.08 + t * 0.42).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        return $"background: rgba(79,70,229,{alpha});";
    }

    private object BuildDonut(Dictionary<string, long> counts, string[] palette) => new Dictionary<string, object?>
    {
        ["color"] = palette,
        ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "item", ["formatter"] = "{b}: {c} ({d}%)" },
        ["legend"] = new Dictionary<string, object?> { ["bottom"] = 0, ["type"] = "scroll" },
        ["series"] = new object[]
        {
            new Dictionary<string, object?>
            {
                ["type"] = "pie",
                ["radius"] = new[] { "42%", "70%" },
                ["itemStyle"] = new Dictionary<string, object?> { ["borderRadius"] = 6, ["borderColor"] = "#fff", ["borderWidth"] = 2 },
                ["label"] = new Dictionary<string, object?> { ["show"] = false },
                ["data"] = counts.OrderByDescending(kv => kv.Value).Select(kv => new Dictionary<string, object?> { ["name"] = kv.Key, ["value"] = kv.Value }).ToArray()
            }
        }
    };

    private object BuildPrioBar(Dictionary<string, long> counts)
    {
        var cats = _prioKeys.ToArray();
        return new Dictionary<string, object?>
        {
            ["color"] = new[] { Palette[0] },
            ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "axis" },
            ["grid"] = new Dictionary<string, object?> { ["left"] = 44, ["right"] = 16, ["top"] = 16, ["bottom"] = 28 },
            ["xAxis"] = new Dictionary<string, object?> { ["type"] = "category", ["data"] = cats },
            ["yAxis"] = new Dictionary<string, object?> { ["type"] = "value" },
            ["series"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["type"] = "bar",
                    ["barMaxWidth"] = 48,
                    ["itemStyle"] = new Dictionary<string, object?> { ["borderRadius"] = new[] { 6, 6, 0, 0 } },
                    ["label"] = new Dictionary<string, object?> { ["show"] = true, ["position"] = "top" },
                    ["data"] = cats.Select(c => (object)counts.GetValueOrDefault(c)).ToArray()
                }
            }
        };
    }

    private object BuildTopBar(List<KeyValuePair<string, long>> data)
    {
        var cats = data.Select(kv => kv.Key).Reverse().ToArray();
        var vals = data.Select(kv => (object)kv.Value).Reverse().ToArray();
        return new Dictionary<string, object?>
        {
            ["color"] = new[] { Palette[4] },
            ["tooltip"] = new Dictionary<string, object?> { ["trigger"] = "axis", ["axisPointer"] = new Dictionary<string, object?> { ["type"] = "shadow" } },
            ["grid"] = new Dictionary<string, object?> { ["left"] = 130, ["right"] = 24, ["top"] = 10, ["bottom"] = 24 },
            ["xAxis"] = new Dictionary<string, object?> { ["type"] = "value" },
            ["yAxis"] = new Dictionary<string, object?> { ["type"] = "category", ["data"] = cats },
            ["series"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["type"] = "bar",
                    ["barMaxWidth"] = 18,
                    ["itemStyle"] = new Dictionary<string, object?> { ["borderRadius"] = new[] { 0, 4, 4, 0 } },
                    ["label"] = new Dictionary<string, object?> { ["show"] = true, ["position"] = "right" },
                    ["data"] = vals
                }
            }
        };
    }

    private sealed record DetailRow(string Codigo, string Concepto, string Encargado, string Prioridad, string Estado, string Fecha);
}
