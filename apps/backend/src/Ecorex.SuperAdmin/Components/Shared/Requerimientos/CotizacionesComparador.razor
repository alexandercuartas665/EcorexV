    private async Task CargarContactosAsync(Guid? proveedorId)
    {
        _contactos = proveedorId is Guid pid
            ? (await Svc.ListContactosAsync(pid)).ToList()
            : new();
    }

    private async Task GuardarOfertaAsync()
    {
        _formError = null;
        if (!Guid.TryParse(_fProv, out var provId))
        {
            _formError = "Elige un proveedor del Directorio (perfil Proveedor).";
            return;
        }
        _busy = true;
        try
        {
            // Contacto: el elegido de la lista, o uno nuevo capturado al vuelo (se crea en el Directorio del proveedor).
            Guid? contactoId = Guid.TryParse(_fContactoId, out var cguid) ? cguid : null;
            if (contactoId is null && !string.IsNullOrWhiteSpace(_fNewContNombre))
            {
                var nuevo = await Svc.GuardarContactoAsync(provId,
                    new ContactoInput(null, _fNewContNombre.Trim(), null,
                        string.IsNullOrWhiteSpace(_fNewContMail) ? null : _fNewContMail.Trim(),
                        string.IsNullOrWhiteSpace(_fNewContTel) ? null : _fNewContTel.Trim()));
                contactoId = nuevo.Id;
            }
            var req = new SaveCotizacionRequest(
                _editId, ItemId, Descripcion ?? "", provId, _fPrecio,
                _fEntrega, _fDespacho, _fPago,
                _fVigencia is { } d ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null,
                _fNotas, contactoId,
                _fFechaCotiz is { } fc ? new DateTimeOffset(fc, TimeSpan.Zero) : null);
            _ofertas = (await Svc.GuardarCotizacionAsync(req, Cantidad)).ToList();
            RecalcMin();
            _evaluado = false; _ganador = null; _rank = new();
            _showForm = false;
            if (ShowBasket) { await LoadBasketAsync(); }
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarAsync(Guid id)
    {
        _busy = true; _error = null;
        try
        {
            await Svc.EliminarCotizacionAsync(id);
            _ofertas = (await Svc.ListCotizacionesAsync(ItemId, Descripcion, Cantidad)).ToList();
            RecalcMin();
            _evaluado = false; _ganador = null; _rank = new();
            if (ShowBasket) { await LoadBasketAsync(); }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

