    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s!;
    private static string Money(decimal d) => d.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
    private static string FechaHora(DateTimeOffset? d) => d is { } v ? v.LocalDateTime.ToString("dd/MM/yy HH:mm") : "-";

    // Estado de vigencia de una oferta por los dias configurados (regla/proveedor) contados desde la fecha cotizada.
    private enum VigEstado { NA, Vigente, PorVencer, Vencida }
    private static VigEstado Vig(CotizacionDto o)
    {
        if (o.VigenciaDias is not int dias || dias <= 0 || o.FechaCotizacion is not { } fc) { return VigEstado.NA; }
        var expiry = fc.LocalDateTime.AddDays(dias);
        var leftDays = (expiry - DateTime.Now).TotalDays;
        if (leftDays < 0) { return VigEstado.Vencida; }
        if (leftDays <= Math.Max(1, dias * 0.2)) { return VigEstado.PorVencer; }
        return VigEstado.Vigente;
    }

    // Texto de la celda Vigencia: si hay dias configurados muestra "N dias -> vence dd/MM/yy"; si no, la fecha manual.
    private static string VigenciaTexto(CotizacionDto o, VigEstado vig)
    {
        if (o.VigenciaDias is int dias && dias > 0 && o.FechaCotizacion is { } fc)
        {
            var expiry = fc.LocalDateTime.AddDays(dias);
            var sufijo = vig == VigEstado.Vencida ? " (vencida)" : vig == VigEstado.PorVencer ? " (por vencer)" : "";
            return $"{dias} d -> {expiry:dd/MM/yy}{sufijo}";
        }
        return o.VigenciaHasta is { } vh ? vh.ToString("dd/MM/yy") : "-";
    }
