@* =====================================================================================================
   Comparador de cotizaciones de proveedor (Ola 13). Reutilizable en el modal de Planificar registro y en
   el de Planificar grupo. Trae las ofertas del producto (tarjetas), resalta diferencias, deja capturarlas
   a mano / sembrarlas (matriz + historico) y pide a un agente del modulo de agentes que proponga la mejor.
   "Usar esta opcion" devuelve la oferta al padre (OnUsar) para volcarla a la planificacion.
   ===================================================================================================== *@
@using Ecorex.Application.Requerimientos
@using Ecorex.Application.Preferences
@using Ecorex.Domain.Enums
@inject IRequerimientoService Svc
@inject IUserTablePrefsService Prefs

<div class="rqc-wrap">
    <div class="rqc-head">
        <strong class="rqc-title">Comparador de cotizaciones</strong>
        <span class="rqc-count">@_ofertas.Count oferta(s)</span>
        <div class="rqc-head-actions">
            @if (CanEdit)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="SembrarAsync" disabled="@_busy"
                        title="Trae proveedores de la matriz y el ultimo precio del historico como ofertas iniciales">Sembrar</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="AbrirNueva" disabled="@_busy">+ Agregar oferta</button>
            }
            <button class="btn btn-primary btn-sm" @onclick="EvaluarAsync" disabled="@(_busy || _ofertas.Count == 0)"
                    title="Un agente de IA compara las ofertas y propone la mejor">
                @(_busyEval ? "Evaluando..." : "Evaluar con IA")
            </button>
        </div>
    </div>

    @if (_error is not null) { <div class="rqc-msg rqc-err">@_error</div> }
    @if (_info is not null) { <div class="rqc-msg rqc-info">@_info</div> }
    @if (_evaluado && !string.IsNullOrWhiteSpace(_resumen))
    {
        <div class="rqc-msg rqc-ai"><span class="rqc-ai-chip">IA</span> @_resumen</div>
    }

    @if (_ofertas.Count == 0)
    {
        <div class="rqc-empty">
            Sin cotizaciones para este producto.
            @if (CanEdit) { <text>Usa <strong>Sembrar</strong> para traerlas de la matriz/historico o <strong>+ Agregar oferta</strong>.</text> }
        </div>
    }
    else
    {
        <div class="rqc-cards">
            @foreach (var o in _ofertas)
            {
                var oc = o;
                var esMejorPrecio = o.PrecioUnitario > 0m && o.PrecioUnitario == _minPrecio;
                var esGanador = _evaluado && _ganador == o.ProveedorId;
                (int Pos, string Motivo)? rk = _rank.TryGetValue(o.ProveedorId, out var rv) ? rv : null;
                var vig = Vig(oc);
                var vigBorde = vig == VigEstado.Vencida ? "#dc2626" : vig == VigEstado.PorVencer ? "#d97706" : "";
                <div class="rqc-card @(esGanador ? "rqc-win" : "")" style="@(vigBorde.Length > 0 ? $"border-left:3px solid {vigBorde};" : "")">
                    <div class="rqc-card-top">
                        <span class="rqc-prov">@(string.IsNullOrWhiteSpace(o.ProveedorNombre) ? "(proveedor)" : o.ProveedorNombre)</span>
                        <div class="rqc-badges">
                            @if (esGanador) { <span class="rqc-badge rqc-badge-ai">Recomendado por IA@(rk is { } rr ? $" (#{rr.Pos})" : "")</span> }
                            else if (rk is { } rr2) { <span class="rqc-badge rqc-badge-rank">#@rr2.Pos</span> }
                            @if (esMejorPrecio) { <span class="rqc-badge rqc-badge-low">Mejor precio</span> }
                            @if (vig == VigEstado.Vencida) { <span class="rqc-badge" style="background:rgba(220,38,38,.12);color:#b91c1c;" title="Paso los dias de vigencia; puede que ya no sea valida">Vencida</span> }
                            else if (vig == VigEstado.PorVencer) { <span class="rqc-badge" style="background:rgba(217,119,6,.14);color:#b45309;" title="Cerca de vencer su vigencia">Por vencer</span> }
                            <span class="rqc-badge rqc-badge-src">@FuenteLbl(o.Fuente)</span>
                        </div>
                    </div>

                    <div class="rqc-price">
                        <span class="rqc-unit">@Money(o.PrecioUnitario)<small>/u</small></span>
                        <span class="rqc-total">Total @Money(o.PrecioUnitario * Cantidad)</span>
                        @if (o.VariacionPct is { } v && o.UltimoPrecio is { } up)
                        {
                            <span class="rqc-var @(v > 0 ? "up" : v < 0 ? "down" : "")" title="@($"Ultimo precio historico: {Money(up)}")">
                                @(v > 0 ? "▲" : v < 0 ? "▼" : "=") @Math.Abs(v)% vs ult.
                            </span>
                        }
                    </div>

                    <div class="rqc-meta">
                        <div><span class="rqc-k">Cotizado</span><span class="rqc-v">@FechaHora(o.FechaCotizacion)</span></div>
                        <div><span class="rqc-k">Entrega</span><span class="rqc-v">@Dash(o.TiempoEntrega)</span></div>
                        <div><span class="rqc-k">Despacho</span><span class="rqc-v">@Dash(o.CaracteristicasDespacho)</span></div>
                        <div><span class="rqc-k">Pago</span><span class="rqc-v">@Dash(o.CondicionesPago)</span></div>
                        <div><span class="rqc-k">Vigencia</span><span class="rqc-v" style="@(vigBorde.Length > 0 ? $"color:{vigBorde};font-weight:600;" : "")">@VigenciaTexto(oc, vig)</span></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(o.ContactoNombre) || !string.IsNullOrWhiteSpace(o.ContactoTelefono) || !string.IsNullOrWhiteSpace(o.ContactoCorreo))
                    {
                        <div class="rqc-contacto">
                            <span class="rqc-k">Contacto</span>
                            <div class="rqc-contacto-v">
                                @if (!string.IsNullOrWhiteSpace(o.ContactoNombre)) { <span class="rqc-c-nom">@o.ContactoNombre</span> }
                                @if (!string.IsNullOrWhiteSpace(o.ContactoTelefono)) { <a class="rqc-c-line" href="tel:@o.ContactoTelefono">@o.ContactoTelefono</a> }
                                @if (!string.IsNullOrWhiteSpace(o.ContactoCorreo)) { <a class="rqc-c-line" href="mailto:@o.ContactoCorreo">@o.ContactoCorreo</a> }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(o.Notas)) { <div class="rqc-notas">@o.Notas</div> }
                    @if (esGanador && rk is { Motivo: var mtv } && !string.IsNullOrWhiteSpace(mtv)) { <div class="rqc-motivo">@mtv</div> }

                    <div class="rqc-card-actions">
                        <button class="btn btn-primary btn-sm" @onclick="() => UsarAsync(oc)" disabled="@_busy">Usar esta opcion</button>
                        @if (CanEdit)
                        {
                            <button class="btn btn-link btn-sm" @onclick="() => AbrirEdicion(oc)" disabled="@_busy">Editar</button>
                            <button class="btn btn-link btn-sm rqc-del" @onclick="() => EliminarAsync(oc.Id)" disabled="@_busy">Eliminar</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (ShowBasket)
    {
        <div class="rqc-basket">
            <div class="rqc-basket-head">
                <strong class="rqc-basket-title">Comparacion total por proveedor</strong>
                <div class="rqc-basket-tools">
                <div class="rqc-basket-seg" role="group" aria-label="Vista">
                    <button type="button" class="rqc-basket-segbtn @(_view == "datos" ? "on" : "")" @onclick='() => SetViewAsync("datos")' disabled="@_basketBusy">Datos</button>
                    <button type="button" class="rqc-basket-segbtn @(_view == "graficos" ? "on" : "")" @onclick='() => SetViewAsync("graficos")' disabled="@_basketBusy">Graficos</button>
                </div>
                <div class="rqc-basket-filtro">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _basketFiltroOpen = !_basketFiltroOpen" disabled="@_basketBusy">
                        @FiltroLabel() <span class="rqc-basket-caret">&#9662;</span>
                    </button>
                    @if (_basketFiltroOpen)
                    {
                        <div class="rqc-basket-menu">
                            <label class="rqc-basket-opt">
                                <input type="checkbox" checked="@(_basketSel.Count == 0)" @onchange="SelTodasAsync" />
                                <span>Todas las tareas</span>
                            </label>
                            <div class="rqc-basket-sep"></div>
                            @foreach (var o in _basket?.Origenes ?? (IReadOnlyList<BasketOrigenOpcionDto>)Array.Empty<BasketOrigenOpcionDto>())
                            {
                                var oo = o;
                                <label class="rqc-basket-opt">
                                    <input type="checkbox" checked="@_basketSel.Contains(oo.OrigenId)" @onchange="() => ToggleOrigenAsync(oo.OrigenId)" />
                                    <span>@oo.Nombre</span>
                                    <span class="rqc-basket-cnt" title="Articulos en la tarea">@oo.Articulos</span>
                                </label>
                            }
                        </div>
                    }
                </div>
                </div>
            </div>
            <div class="rqc-basket-sub">Suma, por proveedor, el precio x cantidad de los articulos de la canasta. Un proveedor puede ganar por articulo y perder en el total.</div>

            @if (_basketBusy)
            {
                <div class="rqc-basket-empty">Calculando total por proveedor...</div>
            }
            else if (_basket is null || _basket.ArticulosEnCanasta == 0)
            {
                <div class="rqc-basket-empty">Sin articulos en la canasta seleccionada.</div>
            }
            else
            {
                <div class="rqc-basket-meta">
                    <span>Articulos en la canasta: <strong>@_basket.ArticulosEnCanasta</strong></span>
                    <span title="Sumando el articulo mas barato de cada producto, mezclando proveedores (piso teorico)">Mejor canasta posible: <strong>@Money(_basket.MejorCanastaTotal)</strong></span>
                </div>
                @if (_view == "datos")
                {
                <div class="rqc-basket-tbl-wrap">
                    <table class="rqc-basket-tbl">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th class="num" title="En cuantos articulos de la canasta tiene oferta">Cobertura</th>
                                <th class="num" title="En cuantos articulos tiene el precio mas bajo">Gana en</th>
                                <th class="num">Total canasta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _basket.Proveedores)
                            {
                                var esMejor = p.CubreTodo && MejorTotalCubreTodo is { } mt && p.Total == mt;
                                <tr class="@(esMejor ? "rqc-basket-win" : "")">
                                    <td>
                                        <span class="rqc-basket-prov">@p.ProveedorNombre</span>
                                        @if (esMejor) { <span class="rqc-badge rqc-badge-low">Mejor total</span> }
                                    </td>
                                    <td class="num @(p.CubreTodo ? "" : "rqc-basket-partial")">@p.CubreCount/@_basket.ArticulosEnCanasta</td>
                                    <td class="num">@p.GanaCount</td>
                                    <td class="num"><strong>@Money(p.Total)</strong>@if (!p.CubreTodo) { <small class="rqc-basket-partialnote"> parcial</small> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
                else
                {
                <div class="rqc-chart">
                    <div class="rqc-chart-head">
                        <div class="rqc-chart-title">@ChartTitle() <span class="rqc-chart-hint">@ChartHint()</span></div>
                        <select class="form-select form-select-sm rqc-chart-pick" value="@_chartKind" @onchange="e => SetChartAsync(e.Value?.ToString())">
                            <option value="total">Total por proveedor</option>
                            <option value="cobertura">Cobertura</option>
                            <option value="precio">Competitividad de precio</option>
                            <option value="gana">Gana en</option>
                            <option value="mapa">Mapa cobertura vs. precio</option>
                        </select>
                    </div>

                    @if (_chartKind == "mapa")
                    {
                        <div class="rqc-map">
                            <div class="rqc-map-yaxis"><span>Mas barato</span><span>Mas caro</span></div>
                            <div class="rqc-map-plot">
                                <div class="rqc-map-grid rqc-map-gy1"></div>
                                <div class="rqc-map-grid rqc-map-gy2"></div>
                                <div class="rqc-map-grid rqc-map-gy3"></div>
                                <div class="rqc-map-gx rqc-map-gx1"></div>
                                <div class="rqc-map-gx rqc-map-gx2"></div>
                                <div class="rqc-map-gx rqc-map-gx3"></div>
                                <div class="rqc-map-ideal">proveedor ideal &#8599;</div>
                                @foreach (var pt in ScatterPts())
                                {
                                    <div class="rqc-map-pt @(pt.Ideal ? "ideal" : pt.Partial ? "partial" : "full")"
                                         style="left:@FmtPct(pt.XPct)%; top:@FmtPct(pt.YPct)%;" title="@pt.Name">
                                        <span class="rqc-map-dot"></span>
                                        <span class="rqc-map-lbl">@pt.Name</span>
                                    </div>
                                }
                            </div>
                            <div class="rqc-map-xaxis"><span>Menos cobertura</span><span>Cubre todo</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="rqc-chart-bars">
                            @foreach (var row in ChartRows())
                            {
                                <div class="rqc-chart-row">
                                    <div class="rqc-chart-lbl" title="@row.Name">
                                        <span class="rqc-chart-name">@row.Name</span>
                                        @if (row.Cov is { } cov) { <span class="rqc-chart-cov @(row.CovPartial ? "partial" : "")">@cov</span> }
                                    </div>
                                    <div class="rqc-chart-track">
                                        <div class="rqc-chart-bar @row.Cls" style="width:@FmtPct(row.Pct)%;"></div>
                                        <div class="rqc-chart-val">@row.Val</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                }
                <div class="rqc-basket-note">Para hallar el proveedor ideal combina las vistas: <strong>Cobertura</strong> (cuanto puede surtir), <strong>Competitividad</strong> (que tan cerca del mejor precio, menor es mejor) y el <strong>Mapa</strong> (arriba-derecha). El total de cada proveedor suma solo lo que cotiza; "Gana en" es en cuantos articulos tiene el precio mas bajo.</div>
            }
        </div>
    }

    @if (_showForm && CanEdit)
    {
        <div class="rqc-form">
            <div class="rqc-form-title">@(_editId is null ? "Nueva oferta" : "Editar oferta")</div>
            <datalist id="rqc-prov-list">
                @foreach (var p in _provs) { <option value="@p.Nombre"></option> }
            </datalist>
            <div class="rqc-form-grid">
                <label class="rqc-f rqc-f-wide">Proveedor
                    <input list="rqc-prov-list" class="form-control form-control-sm" value="@_fProvNombre" @onchange="OnFormProvChanged" placeholder="Escribe o elige del Directorio" />
                </label>
                <label class="rqc-f">Precio unit.
                    <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="_fPrecio" />
                </label>
                <label class="rqc-f">Fecha/hora cotizado
                    <input type="datetime-local" class="form-control form-control-sm" @bind="_fFechaCotiz" />
                </label>
                <label class="rqc-f rqc-f-wide">Contacto con quien se hablo
                    <select class="form-select form-select-sm" @bind="_fContactoId" disabled="@(string.IsNullOrEmpty(_fProv))">
                        <option value="">@(_contactos.Count == 0 ? "(sin contactos; captura uno abajo)" : "Elige un contacto del proveedor")</option>
                        @foreach (var ct in _contactos)
                        {
                            <option value="@ct.Id">@ct.Nombre@(string.IsNullOrWhiteSpace(ct.Telefono) ? "" : $" · {ct.Telefono}")@(string.IsNullOrWhiteSpace(ct.Email) ? "" : $" · {ct.Email}")</option>
                        }
                    </select>
                </label>
                <label class="rqc-f">Nuevo contacto: nombre
                    <input class="form-control form-control-sm" @bind="_fNewContNombre" placeholder="si no esta en la lista" />
                </label>
                <label class="rqc-f">Nuevo: telefono
                    <input class="form-control form-control-sm" @bind="_fNewContTel" />
                </label>
                <label class="rqc-f">Nuevo: correo
                    <input type="email" class="form-control form-control-sm" @bind="_fNewContMail" />
                </label>
                <label class="rqc-f">Tiempo de entrega
                    <input class="form-control form-control-sm" @bind="_fEntrega" placeholder="15 dias, inmediato" />
                </label>
                <label class="rqc-f">Despacho
                    <input class="form-control form-control-sm" @bind="_fDespacho" placeholder="transportadora, lugar" />
                </label>
                <label class="rqc-f">Condiciones de pago
                    <input class="form-control form-control-sm" @bind="_fPago" placeholder="contado, credito 30 dias" />
                </label>
                <label class="rqc-f">Vigencia hasta
                    <input type="date" class="form-control form-control-sm" @bind="_fVigencia" />
                </label>
                <label class="rqc-f rqc-f-wide">Notas
                    <input class="form-control form-control-sm" @bind="_fNotas" />
                </label>
            </div>
            @if (_formError is not null) { <div class="rqc-msg rqc-err">@_formError</div> }
            <div class="rqc-form-actions">
                <button class="btn btn-primary btn-sm" @onclick="GuardarOfertaAsync" disabled="@_busy">Guardar oferta</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showForm = false" disabled="@_busy">Cancelar</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? ItemId { get; set; }
    [Parameter] public string Descripcion { get; set; } = "";
    [Parameter] public decimal Cantidad { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback<CotizacionDto> OnUsar { get; set; }
    // Ola 14: muestra la "Comparacion total por proveedor" debajo del comparador por articulo. La canasta por
    // defecto son los origenes/proyectos de las necesidades abiertas (DefaultOrigenIds); el filtro deja cambiarla.
    [Parameter] public bool ShowBasket { get; set; }
    [Parameter] public IReadOnlyList<Guid>? DefaultOrigenIds { get; set; }

    private List<CotizacionDto> _ofertas = new();
    private List<RequerimientoOpcionDto> _provs = new();
    private decimal _minPrecio;
    private bool _busy;
    private bool _busyEval;
    private string? _error;
    private string? _info;

    // Evaluacion por IA.
    private bool _evaluado;
    private Guid? _ganador;
    private string _resumen = "";
    private Dictionary<Guid, (int, string)> _rank = new();

    // Formulario de alta/edicion.
    private bool _showForm;
    private Guid? _editId;
    private string _fProv = "";
    private string _fProvNombre = "";
    private decimal _fPrecio;
    private string _fEntrega = "";
    private string _fDespacho = "";
    private string _fPago = "";
    private DateTime? _fVigencia;
    private string _fNotas = "";
    private DateTime? _fFechaCotiz;
    private string _fContactoId = "";
    private string _fNewContNombre = "";
    private string _fNewContTel = "";
    private string _fNewContMail = "";
    private List<ProveedorContactoItemDto> _contactos = new();
    private string? _formError;

    // Ola 14: total por proveedor sobre la canasta (proyecto/origen).
    private BasketResumenProveedorDto? _basket;
    private List<Guid> _basketSel = new();     // origenes elegidos; vacio = todas las tareas
    private bool _basketBusy;
    private bool _basketFiltroOpen;
    private bool _basketInit;

    // Preferencias de la tarjeta (persistidas por usuario en jsonb): vista + tipo de grafico + filtro recordado.
    private string _view = "datos";            // "datos" | "graficos"
    private string _chartKind = "total";       // total | cobertura | precio | gana | mapa
    private List<Guid>? _prefSel;              // filtro recordado (null = nunca se toco -> usa DefaultOrigenIds)
    private const string PrefKey = "req.cotiz.basket.view";
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private static bool IsChart(string s) => s is "total" or "cobertura" or "precio" or "gana" or "mapa";

    // El mas barato entre los proveedores que cubren TODA la canasta (la lista viene ordenada: cubre-todo
    // primero, total asc), para marcar "Mejor total". Null si ninguno cubre todos los articulos.
    private decimal? MejorTotalCubreTodo
        => _basket?.Proveedores.Where(p => p.CubreTodo).Select(p => (decimal?)p.Total).FirstOrDefault();

    private static string FmtPct(double d)
        => Math.Max(0, Math.Min(100, d)).ToString("0.##", Inv);

    // ---- Datos para las vistas de grafico (barras y mapa). Una fila lista por proveedor segun el tipo. ----
    private sealed record ChartRow(string Name, string? Cov, bool CovPartial, double Pct, string Cls, string Val);

    private IReadOnlyList<ChartRow> ChartRows()
    {
        var rows = new List<ChartRow>();
        if (_basket is null || _basket.Proveedores.Count == 0) { return rows; }
        var n = _basket.ArticulosEnCanasta;
        switch (_chartKind)
        {
            case "cobertura":
                foreach (var p in _basket.Proveedores.OrderByDescending(p => p.CubreCount).ThenBy(p => p.ProveedorNombre, StringComparer.OrdinalIgnoreCase))
                {
                    rows.Add(new(p.ProveedorNombre, null, false, n > 0 ? (double)p.CubreCount / n * 100 : 0,
                        p.CubreTodo ? "win" : "cover", $"{p.CubreCount}/{n}" + (p.CubreTodo ? " (todo)" : "")));
                }
                break;
            case "precio":
                var maxPrem = (double)_basket.Proveedores.Select(p => p.SobreprecioPct).DefaultIfEmpty(0m).Max();
                foreach (var p in _basket.Proveedores.OrderBy(p => p.SobreprecioPct).ThenByDescending(p => p.CubreCount))
                {
                    var prem = (double)p.SobreprecioPct;
                    rows.Add(new(p.ProveedorNombre, $"{p.CubreCount}/{n}", !p.CubreTodo,
                        maxPrem > 0 ? prem / maxPrem * 100 : (prem <= 0 ? 4 : 0),
                        prem <= 0 ? "win" : "premium",
                        prem <= 0 ? "0% (mas barato)" : "+" + p.SobreprecioPct.ToString("0.#", Inv) + "%"));
                }
                break;
            case "gana":
                var maxGana = _basket.Proveedores.Select(p => p.GanaCount).DefaultIfEmpty(0).Max();
                foreach (var p in _basket.Proveedores.OrderByDescending(p => p.GanaCount).ThenBy(p => p.ProveedorNombre, StringComparer.OrdinalIgnoreCase))
                {
                    rows.Add(new(p.ProveedorNombre, $"{p.CubreCount}/{n}", !p.CubreTodo,
                        maxGana > 0 ? (double)p.GanaCount / maxGana * 100 : 0, "gana", p.GanaCount.ToString(Inv)));
                }
                break;
            default: // total
                var maxTotal = _basket.Proveedores.Select(p => p.Total).DefaultIfEmpty(0m).Max();
                var mejor = MejorTotalCubreTodo;
                foreach (var p in _basket.Proveedores)
                {
                    var cls = (p.CubreTodo && mejor is { } mt && p.Total == mt) ? "win" : (p.CubreTodo ? "full" : "partial");
                    rows.Add(new(p.ProveedorNombre, $"{p.CubreCount}/{n}", !p.CubreTodo,
                        maxTotal > 0m ? (double)(p.Total / maxTotal) * 100 : 0, cls, Money(p.Total)));
                }
                break;
        }
        return rows;
    }

    // Mapa de dispersion: X = cobertura %, Y = sobreprecio % (0 arriba = mas barato). Ideal = arriba-derecha.
    private sealed record ScatterPt(string Name, double XPct, double YPct, bool Partial, bool Ideal);

    private IReadOnlyList<ScatterPt> ScatterPts()
    {
        var pts = new List<ScatterPt>();
        if (_basket is null || _basket.Proveedores.Count == 0) { return pts; }
        var n = _basket.ArticulosEnCanasta;
        var maxPrem = (double)_basket.Proveedores.Select(p => p.SobreprecioPct).DefaultIfEmpty(0m).Max();
        // Ideal = mejor compromiso cobertura vs. precio (mayor cobertura normalizada menos sobreprecio normalizado).
        var ideal = _basket.Proveedores
            .OrderByDescending(p => (n > 0 ? (double)p.CubreCount / n : 0) - (maxPrem > 0 ? (double)p.SobreprecioPct / maxPrem : 0))
            .Select(p => (Guid?)p.ProveedorId).FirstOrDefault();
        foreach (var p in _basket.Proveedores)
        {
            // Insetado (6..94 en X, 8..92 en Y) para que ningun punto quede recortado en el borde del plano.
            var x = n > 0 ? (double)p.CubreCount / n : 0;                    // 0..1 (cobertura)
            var yr = maxPrem > 0 ? (double)p.SobreprecioPct / maxPrem : 0;   // 0..1 (0 = mas barato)
            pts.Add(new(p.ProveedorNombre, 6 + x * 88, 8 + yr * 84, !p.CubreTodo, p.ProveedorId == ideal));
        }
        return pts;
    }

