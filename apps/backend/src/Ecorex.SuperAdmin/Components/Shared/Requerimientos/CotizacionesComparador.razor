    private string _loadedKey = "\0";

    protected override async Task OnInitializedAsync()
    {
        if (!ShowBasket || _basketInit) { return; }
        _basketInit = true;

        // Preferencias (jsonb): { "view": "...", "chart": "...", "sel": ["guid", ...] }. "sel" ausente = nunca
        // se toco el filtro; entonces la canasta arranca en los proyectos del producto abierto (DefaultOrigenIds).
        try
        {
            var json = await Prefs.GetAsync(PrefKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var r = doc.RootElement;
                if (r.TryGetProperty("view", out var v) && v.GetString() is { } sv && (sv == "datos" || sv == "graficos")) { _view = sv; }
                if (r.TryGetProperty("chart", out var c) && c.GetString() is { } sc && IsChart(sc)) { _chartKind = sc; }
                if (r.TryGetProperty("sel", out var s) && s.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    var lst = new List<Guid>();
                    foreach (var el in s.EnumerateArray())
                    {
                        if (el.GetString() is { } g && Guid.TryParse(g, out var gid)) { lst.Add(gid); }
                    }
                    _prefSel = lst;
                }
            }
        }
        catch { /* preferencia no critica: cae a datos/total y canasta por defecto */ }

        _basketSel = _prefSel is { } ps ? new List<Guid>(ps) : (DefaultOrigenIds ?? Array.Empty<Guid>()).Distinct().ToList();
        await LoadBasketAsync();
    }

    private async Task SavePrefsAsync()
    {
        try
        {
            var payload = new Dictionary<string, object?>
            {
                ["view"] = _view,
                ["chart"] = _chartKind,
                ["sel"] = _prefSel?.Select(g => g.ToString()).ToList(),
            };
            await Prefs.SaveAsync(PrefKey, System.Text.Json.JsonSerializer.Serialize(payload));
        }
        catch { /* persistir es best-effort; la UI ya refleja el cambio */ }
    }

    private async Task SetViewAsync(string view)
    {
        if ((view != "datos" && view != "graficos") || _view == view) { return; }
        _view = view;
        await SavePrefsAsync();
    }

    private async Task SetChartAsync(string? kind)
    {
        if (kind is null || !IsChart(kind) || _chartKind == kind) { return; }
        _chartKind = kind;
        await SavePrefsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = (ItemId?.ToString() ?? "") + "|" + (Descripcion ?? "").Trim().ToLowerInvariant();
        if (key != _loadedKey)
        {
            _loadedKey = key;
            await LoadAsync();
        }
    }

    private async Task LoadBasketAsync()
    {
        _basketBusy = true;
        try { _basket = await Svc.ResumenProveedorCanastaAsync(_basketSel); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _basketBusy = false; }
    }

    private string FiltroLabel()
    {
        if (_basketSel.Count == 0) { return "Canasta: todas las tareas"; }
        if (_basketSel.Count == 1)
        {
            var nom = _basket?.Origenes.FirstOrDefault(o => o.OrigenId == _basketSel[0])?.Nombre;
            return "Canasta: " + (string.IsNullOrWhiteSpace(nom) ? "1 tarea" : nom);
        }
        return $"Canasta: {_basketSel.Count} tareas";
    }

    private async Task SelTodasAsync()
    {
        _basketSel = new();
        _prefSel = new();              // filtro recordado = todas las tareas
        await LoadBasketAsync();
        await SavePrefsAsync();
    }

    private async Task ToggleOrigenAsync(Guid id)
    {
        if (!_basketSel.Remove(id)) { _basketSel.Add(id); }
        _prefSel = new List<Guid>(_basketSel);   // recuerda la seleccion exacta
        await LoadBasketAsync();
        await SavePrefsAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true; _error = null; _info = null;
        _evaluado = false; _ganador = null; _resumen = ""; _rank = new();
        _showForm = false;
        try
        {
            _ofertas = (await Svc.ListCotizacionesAsync(ItemId, Descripcion, Cantidad)).ToList();
            if (_provs.Count == 0) { _provs = (await Svc.ListProveedoresAsync()).ToList(); }
            RecalcMin();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void RecalcMin()
        => _minPrecio = _ofertas.Where(o => o.PrecioUnitario > 0m)
            .Select(o => o.PrecioUnitario).DefaultIfEmpty(0m).Min();

    private async Task SembrarAsync()
    {
        _busy = true; _error = null; _info = null;
        try
        {
            var antes = _ofertas.Count;
            _ofertas = (await Svc.SembrarCotizacionesAsync(ItemId, Descripcion, Cantidad)).ToList();
            RecalcMin();
            var nuevas = _ofertas.Count - antes;
            _info = nuevas > 0 ? $"Se sembraron {nuevas} oferta(s) desde la matriz/historico." : "No se encontraron proveedores nuevos para sembrar.";
            if (ShowBasket) { await LoadBasketAsync(); }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EvaluarAsync()
    {
        _busyEval = true; _error = null; _info = null;
        try
        {
            var ev = await Svc.EvaluarCotizacionesAsync(ItemId, Descripcion, Cantidad);
            if (!ev.Ok) { _error = ev.Error ?? "No se pudo evaluar."; _evaluado = false; return; }
            _ganador = ev.ProveedorGanadorId;
            _resumen = ev.Resumen;
            _rank = ev.Ranking.ToDictionary(r => r.ProveedorId, r => (r.Posicion, r.Motivo));
            _evaluado = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busyEval = false; }
    }

    private async Task UsarAsync(CotizacionDto o)
    {
        if (OnUsar.HasDelegate) { await OnUsar.InvokeAsync(o); }
    }

