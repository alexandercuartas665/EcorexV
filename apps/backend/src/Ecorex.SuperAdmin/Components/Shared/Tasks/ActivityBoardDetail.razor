        _lcOpen = false;
        await ReloadAsync();
    }

    // ---- Columnas de campo de FORMULARIO (key "form:{defId}:{fieldCode}") ----
    private static bool IsFormKey(string key) => key.StartsWith("form:", StringComparison.Ordinal);

    private static (Guid DefId, string Code)? ParseFormKey(string key)
    {
        if (!IsFormKey(key)) { return null; }
        var rest = key.Substring(5);
        var i = rest.IndexOf(':');
        if (i <= 0 || i >= rest.Length - 1) { return null; }
        return Guid.TryParse(rest[..i], out var g) ? (g, rest[(i + 1)..]) : null;
    }

    private static string FormKeyFallback(string key) => ParseFormKey(key)?.Code ?? key;

    // Cache de los valores de formulario por (tarjeta, definicion): FieldCode -> valor.
    private readonly Dictionary<(Guid, Guid), Dictionary<string, string?>> _formValues = new();

    // Detalle expandible (GridDetail, ADR-0065): filas del grid por tarea + fuentes para el configurador.
    private readonly Dictionary<Guid, List<Dictionary<string, string?>>> _detailRows = new();
    private List<BoardGridSourceDto> _detailSources = new();

    private bool HasDetail => _listCfg?.Detail is { } d && d.FormDefId != Guid.Empty && !string.IsNullOrWhiteSpace(d.GridFieldCode);

    private async Task EnsureDetailAsync()
    {
        _detailRows.Clear();
        if (_listCfg?.Detail is not { } det || det.FormDefId == Guid.Empty || string.IsNullOrWhiteSpace(det.GridFieldCode)) { return; }
        var rows = await FormResponsesSvc.GetBoardTaskGridRowsAsync(BoardId, det.FormDefId, det.GridFieldCode);
        foreach (var r in rows)
        {
            _detailRows[r.TaskItemId] = r.Rows.Select(x => new Dictionary<string, string?>(x, StringComparer.Ordinal)).ToList();
        }
    }

    private async Task EnsureFormValuesAsync()
    {
        _formValues.Clear();
        var defIds = VisibleListColumns()
            .Select(c => ParseFormKey(c.Key)?.DefId)
            .Where(g => g is not null).Select(g => g!.Value).Distinct().ToList();
        if (defIds.Count == 0) { return; }
        var rows = await FormResponsesSvc.GetBoardTaskFormValuesAsync(BoardId, defIds);
        foreach (var r in rows)
        {
            _formValues[(r.TaskItemId, r.DefinitionId)] = ParseFormData(r.Data);
        }
    }

    // Data de formulario = { fieldCode: { value, type } }. Devuelve fieldCode -> value.
    private static Dictionary<string, string?> ParseFormData(string? json)
    {
        var dict = new Dictionary<string, string?>(StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(json)) { return dict; }
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) { return dict; }
            foreach (var p in doc.RootElement.EnumerateObject())
            {
                var el = p.Value;
                if (el.ValueKind == System.Text.Json.JsonValueKind.Object && el.TryGetProperty("value", out var v))
                {
                    dict[p.Name] = v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString()
                        : v.ValueKind == System.Text.Json.JsonValueKind.Null ? null : v.ToString();
                }
                else
                {
                    dict[p.Name] = el.ValueKind == System.Text.Json.JsonValueKind.String ? el.GetString() : el.ToString();
                }
            }
        }
        catch (System.Text.Json.JsonException) { /* json invalido: sin valores */ }
        return dict;
    }

    private string FormCellText(string key, ActivityCardDto c)
    {
        var pk = ParseFormKey(key);
        if (pk is null) { return string.Empty; }
        return _formValues.TryGetValue((c.Id, pk.Value.DefId), out var d) && d.TryGetValue(pk.Value.Code, out var v)
            ? v ?? string.Empty : string.Empty;
    }

    // ---- Selector "Agregar campos de formulario" dentro del configurador ----
    private List<BoardFormDto> _bfForms = new();
    private Guid? _bfDefId;
    private List<FormQuestionDto> _bfFields = new();
    private readonly HashSet<string> _bfSel = new(StringComparer.Ordinal);

    private async Task OnPickFormAsync(ChangeEventArgs e)
    {
        _bfSel.Clear();
        _bfDefId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        if (_bfDefId is Guid defId)
        {
            var det = await FormDefSvc.GetAsync(defId);
            _bfFields = det?.Questions?.Where(q => !string.IsNullOrWhiteSpace(q.FieldCode)).ToList() ?? new();
        }
        else
        {
            _bfFields = new();
        }
    }

    private void ToggleBfField(string code, bool on)
    {
        if (on) { _bfSel.Add(code); } else { _bfSel.Remove(code); }
    }

    private void AddFormFields()
    {
        if (_bfDefId is not Guid defId || _bfSel.Count == 0) { return; }
        foreach (var q in _bfFields.Where(q => _bfSel.Contains(q.FieldCode)))
        {
            var key = $"form:{defId}:{q.FieldCode}";
            if (_lc.Any(r => r.Key == key)) { continue; }
            _lc.Add(new LcRow
            {
                Key = key,
                DefaultLabel = q.Label,
                Builtin = false,
                IsForm = true,
                Label = q.Label,
                Visible = true,
                Title = string.Empty,
                Subtitle = string.Empty,
                Color = string.Empty
            });
        }
        _bfSel.Clear();
        _bfDefId = null;
        _bfFields = new();
    }

    private async Task OnFcFieldTypeChangedAsync()
    {
        if (_fcFieldType == TerceroFieldType.Lookup && _lkModels.Count == 0)
        {
            _lkModels = (await LookupSvc.ListModelsAsync()).ToList();
        }
    }

    private async Task OnLookupModelChangedAsync(ChangeEventArgs e)
    {
        _lkModelId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _lkTableId = null;
        _lkDisplayCol = null;
        _lkColumns.Clear();
        _lkTables = _lkModelId is Guid mid ? (await LookupSvc.ListTablesAsync(mid)).ToList() : new();
    }

    private async Task OnLookupTableChangedAsync(ChangeEventArgs e)
    {
        _lkTableId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _lkDisplayCol = null;
        _lkColumns = _lkTableId is Guid tid ? (await LookupSvc.ListColumnsAsync(tid)).ToList() : new();
    }

    private void ResetLookupCfg()
    {
        _lkModelId = null;
        _lkTableId = null;
        _lkDisplayCol = null;
        _lkDisplayMode = DataLookupDisplayMode.Typeahead;
        _lkTables = new();
        _lkColumns = new();
    }

    private void LoadDirectoryCfg(string? options)
    {
        var cfg = DirectoryLookupConfig.TryParse(options);
        _dirPerfil = cfg?.Perfil ?? "";
        _dirDisplayMode = cfg?.DisplayMode ?? DataLookupDisplayMode.Typeahead;
    }

    private async Task LoadLookupCfgAsync(string? options)
    {
        ResetLookupCfg();
        var cfg = DataLookupConfig.TryParse(options);
        if (cfg is null) { return; }
        if (_lkModels.Count == 0) { _lkModels = (await LookupSvc.ListModelsAsync()).ToList(); }
        _lkModelId = cfg.ModelId;
        _lkTableId = cfg.TableId;
        _lkDisplayCol = cfg.DisplayColumnId;
        _lkDisplayMode = cfg.DisplayMode;
        if (_lkModelId is Guid mid) { _lkTables = (await LookupSvc.ListTablesAsync(mid)).ToList(); }
        _lkColumns = (await LookupSvc.ListColumnsAsync(cfg.TableId)).ToList();
    }

    /// <summary>Serializa la config del lookup al mismo campo Options (JSON), sin columnas nuevas.</summary>
    private string? BuildLookupOptions()
    {
        if (_lkTableId is not Guid tid) { return null; }
        var tabla = _lkTables.FirstOrDefault(t => t.Id == tid);
        return new DataLookupConfig(
            tid,
            ModelId: _lkModelId,
            DisplayColumnId: _lkDisplayCol,
            TableName: tabla?.Name,
            DisplayColumnName: _lkColumns.FirstOrDefault(c => c.Id == _lkDisplayCol)?.Name,
            DisplayMode: _lkDisplayMode).ToJson();
    }

    /// <summary>Campos que una formula puede usar: numericos y calculados del MISMO tablero.</summary>
    private List<TaskFieldDto> NumericFieldsForFormula()
        => _fcFields
            .Where(f => f.Id != _fcEditId)
            .Where(f => f.FieldType is TerceroFieldType.Number or TerceroFieldType.Currency or TerceroFieldType.Calculated)
            .OrderBy(f => f.SortOrder)
            .ToList();

    private async Task OnFormulaInputAsync(ChangeEventArgs e)
    {
        _fcFormula = e.Value?.ToString() ?? string.Empty;
        _fcFormulaError = string.IsNullOrWhiteSpace(_fcFormula)
            ? null
            : await FieldSvc.ValidateFormulaAsync(_fcFormula, BoardId, _fcEditId, FcEditingKey());
    }

    private string? FcEditingKey() => _fcFields.FirstOrDefault(f => f.Id == _fcEditId)?.FieldKey;

    private async Task InsertFormulaKeyAsync(string key)
    {
        _fcFormula = string.IsNullOrWhiteSpace(_fcFormula) ? $"{{{key}}}" : $"{_fcFormula} {{{key}}}";
        _fcFormulaError = await FieldSvc.ValidateFormulaAsync(_fcFormula, BoardId, _fcEditId, FcEditingKey());
    }

    private async Task EditFcField(TaskFieldDto f)
    {
        _fcEditId = f.Id;
        _fcLabel = f.Label;
        _fcFieldType = f.FieldType;
        _fcOptions = f.Options;
        if (f.FieldType == TerceroFieldType.Lookup) { await LoadLookupCfgAsync(f.Options); }
        else { ResetLookupCfg(); }
        LoadDirectoryCfg(f.FieldType == TerceroFieldType.DirectoryLookup ? f.Options : null);
        _fcDescription = f.Description;
        _fcColumn = Math.Clamp(f.Column, 1, 3);
        _fcError = null;
        _fcFormula = f.Formula ?? "";
        _fcFormulaError = null;
    }

    private void ResetFcForm()
    {
        _fcEditId = null;
        _fcLabel = "";
        _fcFieldType = TerceroFieldType.Text;
        _fcOptions = null;
        ResetLookupCfg();
        _dirPerfil = "";
        _dirDisplayMode = DataLookupDisplayMode.Typeahead;
        _fcDescription = null;
        _fcColumn = 1;
        _fcError = null;
        _fcFormula = "";
        _fcFormulaError = null;
    }

    private async Task SaveFcFieldAsync()
    {
        _fcError = null;
        if (string.IsNullOrWhiteSpace(_fcLabel)) { _fcError = "La etiqueta es obligatoria."; return; }
        _busy = true;
        try
        {
            var formula = _fcFieldType == TerceroFieldType.Calculated ? _fcFormula.Trim() : null;
            if (_fcFieldType == TerceroFieldType.Calculated)
            {
                _fcFormulaError = await FieldSvc.ValidateFormulaAsync(formula, BoardId, _fcEditId, FcEditingKey());
                if (_fcFormulaError is not null) { return; }
            }
            if (_fcFieldType == TerceroFieldType.Lookup)
            {
                _fcOptions = BuildLookupOptions();
                if (_fcOptions is null) { _fcError = "Elige el modelo y la tabla de origen."; return; }
            }
            if (_fcFieldType == TerceroFieldType.DirectoryLookup)
            {
                _fcOptions = new DirectoryLookupConfig(
                    string.IsNullOrWhiteSpace(_dirPerfil) ? null : _dirPerfil, _dirDisplayMode).ToJson();
            }

            if (_fcEditId is Guid editId)
            {
                var upd = new UpdateTaskFieldRequest(_fcLabel, _fcFieldType, _fcColumn, _fcOptions, _fcDescription, false, formula);
                var r = await FieldSvc.UpdateFieldAsync(editId, upd);
                if (r is null) { _fcError = "No se pudo guardar el campo."; return; }
            }
            else
            {
                var req = new CreateTaskFieldRequest(BoardId, _fcLabel, _fcFieldType, _fcColumn, _fcOptions, null, _fcDescription, false, formula);
                var r = await FieldSvc.CreateFieldAsync(req);
                if (r is null) { _fcError = "No se pudo crear el campo. Verifica los datos."; return; }
            }
            ResetFcForm();
            await LoadFcFieldsAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteFcFieldAsync(Guid fieldId)
    {
        _busy = true;
        try
        {
            await FieldSvc.DeleteFieldAsync(fieldId);
            if (_fcEditId == fieldId) { ResetFcForm(); }
            await LoadFcFieldsAsync();
        }
        finally { _busy = false; }
    }

    // ---- SignalR ----

    private async Task EnsureHubAsync()
    {
        if (_hub is not null || AuthState is null) { return; }
        var st = await AuthState;
        _tenantId = st.User.FindFirst("tenant_id")?.Value;
        if (_tenantId is null) { return; }
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/tasks"))
                .WithAutomaticReconnect()
                .Build();
            _hub.On<string, string>("TaskChanged", async (_, _) => await InvokeAsync(ReloadAsync));
            await _hub.StartAsync();
            await _hub.SendAsync("JoinTenant", _tenantId);
        }
        catch
        {
            _hub = null; // sin tiempo real el tablero sigue funcionando con recargas manuales
        }
    }

    private async Task BroadcastAsync(Guid taskId, TaskItemStatus status)
    {
        if (AuthState is null) { return; }
        var st = await AuthState;
        if (Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out var tenantId))
        {
            await Broadcaster.TaskChangedAsync(tenantId, taskId, status);
        }
    }

    private async Task<Guid?> MeTenantUserIdAsync()
    {
        var actor = await ActorAsync();
        return _users.FirstOrDefault(u => u.PlatformUserId == actor)?.Id;
    }

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task<string> ActorNameAsync()
    {
        if (AuthState is null) { return "Usuario"; }
        var st = await AuthState;
        return st.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            try
            {
                if (_tenantId is not null) { await _hub.SendAsync("LeaveTenant", _tenantId); }
                await _hub.DisposeAsync();
            }
            catch { /* circuito cerrado */ }
        }
    }
}
