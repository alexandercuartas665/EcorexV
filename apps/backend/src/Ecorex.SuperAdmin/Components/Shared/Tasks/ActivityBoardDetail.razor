            if (b.Key == key) { return b.Label; }
        }
        return _boardFields.FirstOrDefault(f => f.FieldKey == key)?.Label ?? key;
    }

    // Todas las columnas resueltas: en el orden guardado con overrides; las que no esten en la
    // config guardada se agregan al final ocultas (para poder activarlas en el configurador).
    private List<ListCol> AllListColumns()
    {
        var catalog = ListCatalog();
        var result = new List<ListCol>();
        if (_listCfg is { Columns.Count: > 0 })
        {
            var seen = new HashSet<string>(StringComparer.Ordinal);
            foreach (var c in _listCfg.Columns)
            {
                var inCatalog = catalog.Any(x => x.Key == c.Key);
                if (!inCatalog && !IsFormKey(c.Key)) { continue; }
                seen.Add(c.Key);
                var def = inCatalog ? ListColLabel(c.Key) : (c.Label ?? FormKeyFallback(c.Key));
                result.Add(new ListCol(
                    c.Key,
                    string.IsNullOrWhiteSpace(c.Title) ? def : c.Title!,
                    string.IsNullOrWhiteSpace(c.Subtitle) ? null : c.Subtitle,
                    c.Color, c.Visible, c.CellColor, c.Group));
            }
            foreach (var (key, label) in catalog)
            {
                if (!seen.Contains(key)) { result.Add(new ListCol(key, label, null, null, false)); }
            }
        }
        else
        {
            foreach (var (key, label) in catalog)
            {
                result.Add(new ListCol(key, label, null, null, DefaultListVisible.Contains(key)));
            }
        }
        return result;
    }

    private List<ListCol> VisibleListColumns() => AllListColumns().Where(c => c.Visible).ToList();

    // Color del ENCABEZADO: fondo teñido + borde inferior fuerte (visible de verdad, no un hilo).
    private string ColHeadStyle(ListCol c)
        => string.IsNullOrWhiteSpace(c.Color) ? string.Empty
            : $"background:color-mix(in srgb,{c.Color} 22%,var(--surface-2));border-bottom:3px solid {c.Color};color:color-mix(in srgb,{c.Color} 68%,var(--ink));";

    // Color del CUERPO de la columna: tinte opaco (sobre --surface para que la 1a columna fija tape
    // el contenido que se desplaza debajo) + un hilo lateral del color para que la columna se lea
    // COLOREADA de verdad (no un tinte casi invisible).
    private string ColCellStyle(ListCol c)
        => string.IsNullOrWhiteSpace(c.CellColor) ? string.Empty
            : $"background:color-mix(in srgb,{c.CellColor} 20%,var(--surface));box-shadow:inset 2px 0 0 color-mix(in srgb,{c.CellColor} 55%,transparent);";

    // ============================================================
    // Agrupador + arbol de subtareas de la vista Lista (ADR-0065)
    // ============================================================
    private string _groupBy = "";
    private readonly HashSet<Guid> _expandedParents = new();
    private const string GroupRequester = "@requester";

    private void OnGroupByChanged() => _listPage = 1;
    private void ToggleExpand(Guid id) { if (!_expandedParents.Remove(id)) { _expandedParents.Add(id); } }

    // Fila de render: encabezado de grupo, fila de datos (tarea, con profundidad para el arbol) o fila de
    // DETALLE (item de un GridDetail). DetailKind: 0=normal, 1=cabecera del detalle, 2=fila de item.
    private sealed record LcDisplayRow(
        bool IsGroupHeader, string? GroupValue, int GroupCount, Dictionary<string, double>? Sums,
        ActivityBoardColumnDto? Column, int ColIdx, ActivityCardDto? Card, int Depth, bool HasKids, bool Expanded,
        int DetailKind = 0, Dictionary<string, string?>? DetailCells = null);

    private sealed record LcDisplay(
        List<LcDisplayRow> Rows, int TotalUnits, int TotalPages,
        Dictionary<string, double> Grand, HashSet<string> NumCols);

    // Columnas de campo (form/custom) visibles: opciones extra de agrupacion.
    private List<ListCol> GroupableFieldColumns()
        => VisibleListColumns().Where(c => !TaskListViewConfig.IsBuiltin(c.Key)).ToList();

    private string GroupByLabel() => _groupBy switch
    {
        "" => "",
        TaskListViewConfig.KeyStage => "Etapa",
        TaskListViewConfig.KeyStatus => "Estado",
        TaskListViewConfig.KeyAssignee => "Encargado",
        TaskListViewConfig.KeyPriority => "Prioridad",
        GroupRequester => "Solicitante",
        _ => VisibleListColumns().FirstOrDefault(c => c.Key == _groupBy)?.Title ?? _groupBy
    };

    private string GroupValueOf(ActivityCardDto c)
    {
        if (_groupBy == TaskListViewConfig.KeyStage)
            return _detail?.Columns.FirstOrDefault(col => col.Id == c.ColumnId)?.Name ?? "(sin etapa)";
        if (_groupBy == TaskListViewConfig.KeyStatus) return TaskUi.StatusLabel(c.Status);
        if (_groupBy == TaskListViewConfig.KeyAssignee) return c.Assignee?.DisplayName ?? "Sin asignar";
        if (_groupBy == TaskListViewConfig.KeyPriority) return TaskUi.PriorityLabel(c.Priority);
        if (_groupBy == GroupRequester) return string.IsNullOrWhiteSpace(c.RequesterName) ? "(sin solicitante)" : c.RequesterName!;
        var txt = _groupBy.StartsWith("form:") ? FormCellText(_groupBy, c) : CustomCellText(_groupBy, c);
        return string.IsNullOrWhiteSpace(txt) ? "(vacio)" : txt;
    }

    // Valor numerico de una tarjeta en una columna (solo campos numericos). null si no aplica.
    private double? NumericValueOf(ActivityCardDto c, ListCol col)
    {
        if (TaskListViewConfig.IsBuiltin(col.Key)) { return null; }
        string raw;
        if (col.Key.StartsWith("form:"))
        {
            raw = FormCellText(col.Key, c);
        }
        else
        {
            var f = _boardFields.FirstOrDefault(x => x.FieldKey == col.Key);
            if (f is not null && f.FieldType is not (TerceroFieldType.Number or TerceroFieldType.Currency or TerceroFieldType.Calculated)) { return null; }
            raw = CardCustomRaw(c.Id, col.Key);
        }
        if (string.IsNullOrWhiteSpace(raw)) { return null; }
        return decimal.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n) ? (double)n : null;
    }

    private bool IsNumericCol(ListCol col, List<ActivityCardDto> cards)
        => !TaskListViewConfig.IsBuiltin(col.Key) && cards.Any(c => NumericValueOf(c, col) is not null);

    private double ColSum(ListCol col, IEnumerable<ActivityCardDto> cards)
        => cards.Sum(c => NumericValueOf(c, col) ?? 0);

    private string FmtColTotal(ListCol col, double v)
    {
        var f = _boardFields.FirstOrDefault(x => x.FieldKey == col.Key);
        var s = v.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture);
        return f?.FieldType == TerceroFieldType.Currency ? "$" + s : s;
    }

    // ---- Detalle expandible (GridDetail) ----
    private List<TaskListDetailColumn> VisibleDetailColumns()
        => _listCfg?.Detail?.Columns.Where(c => c.Visible).ToList() ?? new List<TaskListDetailColumn>();

    private static string DetailColLabel(TaskListDetailColumn c)
        => string.IsNullOrWhiteSpace(c.Title) ? c.Key : c.Title!;

    // Valor de una celda del detalle; numeros se formatean con miles, el resto tal cual.
    private static string DetailCellText(Dictionary<string, string?>? cells, string key)
    {
        if (cells is null || !cells.TryGetValue(key, out var v) || string.IsNullOrWhiteSpace(v)) { return string.Empty; }
        return decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)
            ? n.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture)
            : v;
    }

    private LcDisplay BuildDisplayRows(List<ListCol> lcols)
    {
        var rows = new List<LcDisplayRow>();
        var all = ListRows().ToList();
        var allCards = all.Select(r => r.Card).ToList();
        var numCols = lcols.Where(col => IsNumericCol(col, allCards)).Select(c => c.Key).ToHashSet(StringComparer.Ordinal);
        var colByKey = lcols.ToDictionary(c => c.Key, c => c, StringComparer.Ordinal);
        var grand = numCols.ToDictionary(k => k, k => ColSum(colByKey[k], allCards), StringComparer.Ordinal);

        if (!string.IsNullOrEmpty(_groupBy))
        {
            var groups = all.GroupBy(r => GroupValueOf(r.Card))
                            .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase);
            foreach (var g in groups)
            {
                var cards = g.Select(r => r.Card).ToList();
                var sums = numCols.ToDictionary(k => k, k => ColSum(colByKey[k], cards), StringComparer.Ordinal);
                rows.Add(new LcDisplayRow(true, g.Key, cards.Count, sums, null, 0, null, 0, false, false));
                foreach (var r in g)
                {
                    rows.Add(new LcDisplayRow(false, null, 0, null, r.Column, r.ColIdx, r.Card, 0, false, false));
                }
            }
            return new LcDisplay(rows, all.Count, 1, grand, numCols);
        }

        var present = all.Select(r => r.Card.Number).ToHashSet(StringComparer.Ordinal);
        bool IsNested(ActivityCardDto c) => c.IsSubtask && c.ParentNumber is not null && present.Contains(c.ParentNumber);
        var kidsByParent = all.Where(r => IsNested(r.Card)).ToLookup(r => r.Card.ParentNumber!, StringComparer.Ordinal);
        var topRows = all.Where(r => !IsNested(r.Card)).ToList();

        var totalPages = Math.Max(1, (int)Math.Ceiling(topRows.Count / (double)ListPageSize));
        var page = Math.Clamp(_listPage, 1, totalPages);
        _listPage = page;
        var detailMode = HasDetail;
        foreach (var r in topRows.Skip((page - 1) * ListPageSize).Take(ListPageSize))
        {
            var expanded = _expandedParents.Contains(r.Card.Id);
            if (detailMode)
            {
                // Detalle = filas del GridDetail del formulario (p.ej. items de la cotizacion).
                var drows = _detailRows.TryGetValue(r.Card.Id, out var dr) ? dr : null;
                var hasItems = drows is { Count: > 0 };
                rows.Add(new LcDisplayRow(false, null, 0, null, r.Column, r.ColIdx, r.Card, 0, hasItems, expanded));
                if (hasItems && expanded)
                {
                    rows.Add(new LcDisplayRow(false, null, 0, null, null, 0, null, 1, false, false, DetailKind: 1));
                    foreach (var drow in drows!)
                    {
                        rows.Add(new LcDisplayRow(false, null, 0, null, null, 0, null, 1, false, false, DetailKind: 2, DetailCells: drow));
                    }
                }
                continue;
            }
            var kids = kidsByParent[r.Card.Number].ToList();
            rows.Add(new LcDisplayRow(false, null, 0, null, r.Column, r.ColIdx, r.Card, 0, kids.Count > 0, expanded));
            if (kids.Count > 0 && expanded)
            {
                foreach (var k in kids)
                {
                    rows.Add(new LcDisplayRow(false, null, 0, null, k.Column, k.ColIdx, k.Card, 1, false, false));
                }
            }
        }
        return new LcDisplay(rows, topRows.Count, totalPages, grand, numCols);
    }

    private void BuildCardCustomCache()
    {
        _cardCustom.Clear();
        if (_detail is null) { return; }
        foreach (var card in _detail.Columns.SelectMany(col => col.Cards))
        {
            _cardCustom[card.Id] = ParseCustom(card.CustomFieldsJson);
        }
    }

    private static Dictionary<string, string?> ParseCustom(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return new(StringComparer.Ordinal); }
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string?>>(json)
                ?? new(StringComparer.Ordinal);
        }
        catch (System.Text.Json.JsonException) { return new(StringComparer.Ordinal); }
    }

    private string CardCustomRaw(Guid cardId, string key)
        => _cardCustom.TryGetValue(cardId, out var d) && d.TryGetValue(key, out var v) ? v ?? string.Empty : string.Empty;

    private string CustomCellText(string key, ActivityCardDto c)
    {
        var raw = CardCustomRaw(c.Id, key);
        if (string.IsNullOrWhiteSpace(raw)) { return string.Empty; }
        var f = _boardFields.FirstOrDefault(x => x.FieldKey == key);
        if (f is null) { return raw; }
        return f.FieldType switch
        {
            TerceroFieldType.Lookup or TerceroFieldType.DirectoryLookup =>
                _listLabels.TryGetValue(key, out var m) && m.TryGetValue(raw, out var lbl) ? lbl : raw,
            TerceroFieldType.Currency => FormatCurrencyCell(raw),
            TerceroFieldType.Date => FormatDateCell(raw),
            _ => raw
        };
    }

    private static string FormatCurrencyCell(string raw)
        => decimal.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)
            ? "$" + n.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture)
            : raw;

    private static string FormatDateCell(string raw)
        => DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : raw;

    // Resuelve las etiquetas de las columnas de lista tipo lookup/directorio (id -> texto), en lote.
    private async Task EnsureListLabelsAsync()
    {
        _listLabels.Clear();
        foreach (var col in VisibleListColumns())
        {
            if (TaskListViewConfig.IsBuiltin(col.Key)) { continue; }
            var f = _boardFields.FirstOrDefault(x => x.FieldKey == col.Key);
            if (f is null || f.FieldType is not (TerceroFieldType.Lookup or TerceroFieldType.DirectoryLookup)) { continue; }

            var ids = _cardCustom.Values
                .Select(d => d.TryGetValue(col.Key, out var v) ? v : null)
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Distinct(StringComparer.Ordinal)
                .Select(v => Guid.TryParse(v, out var g) ? (Guid?)g : null)
                .Where(g => g is not null).Select(g => g!.Value).ToList();
            if (ids.Count == 0) { continue; }

            var map = new Dictionary<string, string>(StringComparer.Ordinal);
            if (f.FieldType == TerceroFieldType.Lookup && DataLookupConfig.TryParse(f.Options) is { } cfg)
            {
                var rows = await LookupSvc.ResolveAsync(cfg.TableId, ids, cfg.DisplayColumnId);
                foreach (var r in rows) { map[r.RowId.ToString()] = r.Label; }
            }
            else if (f.FieldType == TerceroFieldType.DirectoryLookup)
            {
                foreach (var id in ids)
                {
                    var item = await FormLookupSvc.ResolveAsync(FormSourceKind.Tercero, string.Empty, id.ToString(), Array.Empty<string>());
                    if (item is not null) { map[id.ToString()] = item.Display; }
                }
            }
            if (map.Count > 0) { _listLabels[col.Key] = map; }
        }
    }

    // ---- Configurador de columnas ----
    private bool _lcOpen;
    private List<LcRow> _lc = new();

    private sealed class LcRow
    {
        public string Key = string.Empty;
        public string DefaultLabel = string.Empty;
        public bool Builtin;
        public bool IsForm;
        public string? Label;
        public bool Visible;
        public string Title = string.Empty;
        public string Subtitle = string.Empty;
        public string Color = string.Empty;
        public string CellColor = string.Empty;
        public string Group = string.Empty;
    }

    private async Task OpenListConfig()
    {
        if (_boardFields.Count == 0) { _boardFields = await FieldSvc.ListByBoardAsync(BoardId); }
        _bfForms = (await FormResponsesSvc.GetBoardFormsAsync(BoardId)).ToList();
        _bfDefId = null;
        _bfFields = new();
        _bfSel.Clear();
