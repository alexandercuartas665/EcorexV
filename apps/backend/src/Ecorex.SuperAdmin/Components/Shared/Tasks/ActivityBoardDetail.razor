    // ---- Configurador del DETALLE (GridDetail expandible) ----
    private string _dcSel = "";
    private readonly List<DcCol> _dcCols = new();
    private sealed class DcCol { public string Key = ""; public bool Visible = true; public string Title = ""; public string Label = ""; }

    private void InitDetailConfig()
    {
        _dcCols.Clear();
        _dcSel = "";
        var det = _listCfg?.Detail;
        if (det is null) { return; }
        _dcSel = $"{det.FormDefId}:{det.GridFieldCode}";
        var src = _detailSources.FirstOrDefault(s => s.FormDefId == det.FormDefId && s.GridFieldCode == det.GridFieldCode);
        if (src is null) { return; }
        var savedKeys = det.Columns.Select(c => c.Key).ToHashSet(StringComparer.Ordinal);
        foreach (var sc in det.Columns)
        {
            var label = src.Columns.FirstOrDefault(x => x.Id == sc.Key)?.Label ?? sc.Key;
            _dcCols.Add(new DcCol { Key = sc.Key, Visible = sc.Visible, Title = sc.Title ?? label, Label = label });
        }
        foreach (var sc in src.Columns.Where(x => !savedKeys.Contains(x.Id)))
        {
            _dcCols.Add(new DcCol { Key = sc.Id, Visible = false, Title = sc.Label, Label = sc.Label });
        }
    }

    private void OnDetailSourceChanged()
    {
        _dcCols.Clear();
        if (string.IsNullOrEmpty(_dcSel)) { return; }
        var parts = _dcSel.Split(':', 2);
        if (parts.Length != 2 || !Guid.TryParse(parts[0], out var defId)) { return; }
        var src = _detailSources.FirstOrDefault(s => s.FormDefId == defId && s.GridFieldCode == parts[1]);
        if (src is null) { return; }
        foreach (var sc in src.Columns)
        {
            _dcCols.Add(new DcCol { Key = sc.Id, Visible = true, Title = sc.Label, Label = sc.Label });
        }
    }

    private void DcMove(int i, int dir)
    {
        var j = i + dir;
        if (j < 0 || j >= _dcCols.Count) { return; }
        (_dcCols[i], _dcCols[j]) = (_dcCols[j], _dcCols[i]);
    }

    private TaskListDetailConfig? BuildDetailConfig()
    {
        if (string.IsNullOrEmpty(_dcSel)) { return null; }
        var parts = _dcSel.Split(':', 2);
        if (parts.Length != 2 || !Guid.TryParse(parts[0], out var defId)) { return null; }
        var cols = _dcCols.Select(c => new TaskListDetailColumn(c.Key, c.Visible,
            string.IsNullOrWhiteSpace(c.Title) ? c.Label : c.Title.Trim())).ToList();
        return new TaskListDetailConfig(defId, parts[1], cols);
    }

    // Arma las filas editables del configurador: las guardadas (en orden, incl. campos de formulario)
    // + las del catalogo aun no usadas (incorporadas y campos del tablero). Los campos de formulario
    // solo entran si ya estaban en la config (se agregan con el selector).
    private List<LcRow> BuildLcRows()
    {
        var rows = new List<LcRow>();
        var catalog = ListCatalog();
        var inCfg = new HashSet<string>(StringComparer.Ordinal);
        if (_listCfg is { Columns.Count: > 0 })
        {
            foreach (var c in _listCfg.Columns)
            {
                var inCatalog = catalog.Any(x => x.Key == c.Key);
                var isForm = IsFormKey(c.Key);
                if (!inCatalog && !isForm) { continue; }
                inCfg.Add(c.Key);
                var def = inCatalog ? ListColLabel(c.Key) : (c.Label ?? FormKeyFallback(c.Key));
                rows.Add(new LcRow
                {
                    Key = c.Key,
                    DefaultLabel = def,
                    Builtin = TaskListViewConfig.IsBuiltin(c.Key),
                    IsForm = isForm,
                    Label = isForm ? (c.Label ?? def) : null,
                    Visible = c.Visible,
                    Title = string.IsNullOrWhiteSpace(c.Title) || string.Equals(c.Title, def, StringComparison.Ordinal) ? string.Empty : c.Title!,
                    Subtitle = c.Subtitle ?? string.Empty,
                    Color = c.Color ?? string.Empty,
                    CellColor = c.CellColor ?? string.Empty,
                    Group = c.Group ?? string.Empty
                });
            }
        }
        foreach (var (key, label) in catalog)
        {
            if (inCfg.Contains(key)) { continue; }
            rows.Add(new LcRow
            {
                Key = key,
                DefaultLabel = label,
                Builtin = TaskListViewConfig.IsBuiltin(key),
                IsForm = false,
                Label = null,
                Visible = _listCfg is null && DefaultListVisible.Contains(key),
                Title = string.Empty,
                Subtitle = string.Empty,
                Color = string.Empty
            });
        }
        return rows;
    }

    private void LcMove(int i, int dir)
    {
        var j = i + dir;
        if (j < 0 || j >= _lc.Count) { return; }
        (_lc[i], _lc[j]) = (_lc[j], _lc[i]);
    }

    private async Task SaveListConfigAsync()
    {
        var cfg = new TaskListViewConfig(_lc.Select(r => new TaskListColumnConfig(
            r.Key, r.Visible,
            string.IsNullOrWhiteSpace(r.Title) ? null : r.Title.Trim(),
            string.IsNullOrWhiteSpace(r.Subtitle) ? null : r.Subtitle.Trim(),
            string.IsNullOrWhiteSpace(r.Color) ? null : r.Color.Trim(),
            r.IsForm ? (string.IsNullOrWhiteSpace(r.Label) ? r.DefaultLabel : r.Label) : null,
            string.IsNullOrWhiteSpace(r.CellColor) ? null : r.CellColor.Trim(),
            string.IsNullOrWhiteSpace(r.Group) ? null : r.Group.Trim())).ToList(),
            BuildDetailConfig());
        await BoardsSvc.SetListViewConfigAsync(BoardId, cfg.ToJson());
        _lcOpen = false;
        await ReloadAsync();
    }

