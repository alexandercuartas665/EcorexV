@* ===== Modal configurar campos personalizados del tablero (ADR-0065) ===== *@
@if (_fcOpen && _detail is not null)
{
    <div class="ab-modal-overlay" @onclick="@(() => _fcOpen = false)">
        <div class="ab-modal ab-fields-modal" @onclick:stopPropagation="true">
            <div class="ab-modal-head">
                <h3>Configurar campos &#183; @_detail.Name</h3>
                <button class="ab-modal-x" @onclick="@(() => _fcOpen = false)" aria-label="Cerrar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="ab-modal-body">
                <p class="ab-fld-help">Estos campos se capturan en el detalle de las tareas de ESTE tablero. No aparecen en otros tableros.</p>

                @if (_fcFields.Count == 0)
                {
                    <p class="ab-fld-help">Aun no hay campos. Agrega el primero abajo.</p>
                }
                else
                {
                    <ul class="ab-cfg-list">
                        @foreach (var f in _fcFields)
                        {
                            <li>
                                <div>
                                    <strong>@f.Label</strong> <span class="ab-fld-help">(@f.FieldKey)</span>
                                    <div class="ab-fld-help">@TaskFieldUi.TypeLabel(f.FieldType) &#183; @TaskFieldUi.ColumnLabel(f.Column)</div>
                                </div>
                                <div style="display:flex;gap:6px;">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => EditFcField(f))" disabled="@_busy">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteFcFieldAsync(f.Id))" disabled="@_busy">&times;</button>
                                </div>
                            </li>
                        }
                    </ul>
                }

                <div class="ab-cfg-form">
                    <div class="ab-section-title">@(_fcEditId is null ? "Nuevo campo" : "Editar campo")</div>
                    <div class="ab-field-row">
                        <div class="ab-field">
                            <label>Etiqueta *</label>
                            <input class="ab-input" @bind="_fcLabel" maxlength="150" placeholder="Ej. Monto aprobado, Referencia" />
                        </div>
                        <div class="ab-field">
                            <label>Tipo de campo</label>
                            <select class="ab-select" @bind="_fcFieldType" @bind:after="OnFcFieldTypeChangedAsync">
                                <option value="@TerceroFieldType.Text">Texto</option>
                                <option value="@TerceroFieldType.TextArea">Texto largo</option>
                                <option value="@TerceroFieldType.Number">Numero</option>
                                <option value="@TerceroFieldType.Currency">Monto ($)</option>
                                <option value="@TerceroFieldType.Select">Lista</option>
                                <option value="@TerceroFieldType.Date">Fecha</option>
                                <option value="@TerceroFieldType.Phone">Telefono</option>
                                <option value="@TerceroFieldType.Separator">Separador</option>
                                <option value="@TerceroFieldType.Calculated">Calculado</option>
                                <option value="@TerceroFieldType.Lookup">Lista del Contenedor de datos</option>
                                <option value="@TerceroFieldType.DirectoryLookup">Lista del Directorio</option>
                            </select>
                        </div>
                    </div>

                    @if (_fcFieldType == TerceroFieldType.Select)
                    {
                        <div class="ab-field">
                            <label>Opciones (una por linea)</label>
                            <textarea class="ab-textarea" rows="3" @bind="_fcOptions"></textarea>
                        </div>
                    }

                    @if (_fcFieldType == TerceroFieldType.Lookup)
                    {
                        <div class="ab-field-row">
                            <div class="ab-field">
                                <label>Modelo de datos *</label>
                                <select class="ab-select" value="@(_lkModelId?.ToString() ?? "")" @onchange="OnLookupModelChangedAsync">
                                    <option value="">-- Elige un modelo --</option>
                                    @foreach (var m in _lkModels)
                                    {
                                        <option value="@m.Id" selected="@(_lkModelId == m.Id)">@m.Name (@m.TableCount)</option>
                                    }
                                </select>
                            </div>
                            <div class="ab-field">
                                <label>Tabla *</label>
                                <select class="ab-select" value="@(_lkTableId?.ToString() ?? "")" @onchange="OnLookupTableChangedAsync" disabled="@(_lkModelId is null)">
                                    <option value="">-- Elige una tabla --</option>
                                    @foreach (var t in _lkTables)
                                    {
                                        <option value="@t.Id" selected="@(_lkTableId == t.Id)">@t.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="ab-field">
                                <label>Columna que se muestra</label>
                                <select class="ab-select" value="@(_lkDisplayCol?.ToString() ?? "")"
                                        @onchange="e => _lkDisplayCol = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null"
                                        disabled="@(_lkColumns.Count == 0)">
                                    <option value="">-- Automatica (primera de texto) --</option>
                                    @foreach (var c in _lkColumns)
                                    {
                                        <option value="@c.Id" selected="@(_lkDisplayCol == c.Id)">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="ab-field">
                                <label>Presentacion</label>
                                <select class="ab-select" value="@_lkDisplayMode"
                                        @onchange="e => _lkDisplayMode = Enum.TryParse<DataLookupDisplayMode>(e.Value?.ToString(), out var m) ? m : DataLookupDisplayMode.Typeahead">
                                    <option value="@DataLookupDisplayMode.Typeahead">Autocompletado (buscador)</option>
                                    <option value="@DataLookupDisplayMode.List">Lista desplegable</option>
                                </select>
                            </div>
                            @if (_lkModels.Count == 0)
                            {
                                <div class="ab-field ab-fld-help">
                                    No hay modelos de datos todavia. Crealos en <a href="/contenedor-datos">Contenedor de datos</a>.
                                </div>
                            }
                        </div>
                    }

                    @if (_fcFieldType == TerceroFieldType.DirectoryLookup)
                    {
                        <div class="ab-field-row">
                            <div class="ab-field">
                                <label>Perfil del directorio</label>
                                <select class="ab-select" @bind="_dirPerfil">
                                    <option value="">Todos los terceros</option>
                                    <option value="Cliente">Solo clientes</option>
                                    <option value="Proveedor">Solo proveedores</option>
                                    <option value="Empleado">Solo empleados</option>
                                </select>
                            </div>
                            <div class="ab-field">
                                <label>Presentacion</label>
                                <select class="ab-select" value="@_dirDisplayMode"
                                        @onchange="e => _dirDisplayMode = Enum.TryParse<DataLookupDisplayMode>(e.Value?.ToString(), out var m) ? m : DataLookupDisplayMode.Typeahead">
                                    <option value="@DataLookupDisplayMode.Typeahead">Autocompletado (buscador)</option>
                                    <option value="@DataLookupDisplayMode.List">Lista desplegable</option>
                                </select>
                            </div>
                            <div class="ab-field ab-fld-help">
                                Lista los terceros del Directorio General del perfil elegido. Se guarda la referencia al tercero (la etiqueta se actualiza sola si cambia en el Directorio).
                            </div>
                        </div>
                    }

                    @if (_fcFieldType == TerceroFieldType.Calculated)
                    {
                        <div class="ab-field">
                            <label>Formula *</label>
                            <input class="ab-input ab-mono @(_fcFormulaError is not null ? "is-invalid" : "")"
                                   value="@_fcFormula" placeholder="{horas} * {tarifa}" @oninput="OnFormulaInputAsync" />
                            @if (_fcFormulaError is not null)
                            {
                                <div class="ab-field-error">@_fcFormulaError</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_fcFormula))
                            {
                                <div class="ab-fld-ok">Formula valida.</div>
                            }
                            <div class="ab-fld-help">
                                Operadores + - * / y parentesis. Funciones: ROUND, MIN, MAX, ABS, SUM. Solo campos de este tablero.
                            </div>
                            @if (NumericFieldsForFormula().Count > 0)
                            {
                                <div class="ab-keys">
                                    @foreach (var nf in NumericFieldsForFormula())
                                    {
                                        var nfv = nf;
                                        <button type="button" class="ab-key" title="@nfv.Label"
                                                @onclick="() => InsertFormulaKeyAsync(nfv.FieldKey)">@($"{{{nfv.FieldKey}}}")</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="ab-field-row">
                        <div class="ab-field">
                            <label>Ayuda / descripcion</label>
                            <input class="ab-input" @bind="_fcDescription" maxlength="600" />
                        </div>
                        <div class="ab-field" style="max-width:180px;">
                            <label>Ancho</label>
                            <select class="ab-select" @bind="_fcColumn">
                                <option value="1">Pequena (1/3)</option>
                                <option value="2">Media (2/3)</option>
                                <option value="3">Grande (completo)</option>
                            </select>
                        </div>
                    </div>

                    @if (_fcError is not null)
                    {
                        <div class="ab-field-error">@_fcError</div>
                    }
                    <div style="display:flex;gap:6px;">
                        <button class="ab-btn-commit" @onclick="SaveFcFieldAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_fcLabel))">@(_fcEditId is null ? "+ Agregar campo" : "Guardar campo")</button>
                        @if (_fcEditId is not null)
                        {
                            <button class="ab-btn-secondary" @onclick="ResetFcForm">Cancelar</button>
                        }
                    </div>
                </div>
            </div>
            <div class="ab-modal-foot">
                <button class="ab-btn-secondary" @onclick="@(() => _fcOpen = false)">Cerrar</button>
            </div>
        </div>
    </div>
}

<TaskToasts @ref="_toasts" />
<TaskDetailModal @ref="_taskDetail" OnChanged="ReloadAsync" />

@* Mis Procesos (?sub=): el WIZARD grande "Crear actividad" precargado con el concepto (ADR-0038). *@
<TaskWizard @ref="_wizard" OnCreated="OnWizardCreatedAsync" />

@* Ola B1: si el concepto es FORM-FIRST (IniciaModulo), la actividad arranca por el FORMULARIO,
   no por el wizard. Si el formulario no sirve, TryOpenAsync devuelve false y se cae al wizard. *@
<FormFirstStarter @ref="_formFirst" OnCreated="OnWizardCreatedAsync" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>Concepto preseleccionado al llegar desde "Mis Procesos" (?sub=): incluye el concepto
    /// (aunque sea de proceso) en el modal rapido y lo AUTO-ABRE precargado al aterrizar (paso corto).</summary>
    [Parameter] public Guid? PresetSubcategoriaId { get; set; }

    private ActivityBoardDetailDto? _detail;
    private List<ActivityBoardMemberDto> _members = new();
    private List<TaskItemTagDto> _boardTags = new();
    private List<TenantUserDto> _users = new();
    private List<TaskItemTagDto> _tags = new();
    private List<ActivityTypeDto> _types = new();
    private List<ActividadSubcategoriaDto> _freeSubs = new();
    private Guid? _meTenantUserId;
    private Guid _loadedBoardId;

    // Filtros combinables (chips del prototipo).
    private readonly HashSet<Guid> _fColumns = new();
    private readonly HashSet<Guid> _fUsers = new();
    private string? _fDue; // "hoy" | "manana" | "fecha"
    private DateTime? _fDueOn;
    private readonly HashSet<Guid> _fTags = new();
    private ActivityBoardScope _scope = ActivityBoardScope.Team;
    private bool _filtersVisible = true;
    private string _view = "tablero";

    // Drag and drop nativo HTML5 (mismo patron del kanban por estado).
    private Guid? _dragTaskId;
    private Guid? _dragOverColumnId;

    // Menus "..." de columna y de tarjeta (popovers estilo ab-dd del fuente).
    private Guid? _colMenuId;
    private Guid? _cardMenuId;
    private bool _cardMoveOpen;
    private bool _cardArchiveConfirm;

    // Renombrar / marcar final / agregar columna (delega en ITaskBoardService existente).
    private bool _rcOpen;
    private Guid _rcColumnId;
    private string _rcName = "";
    private string? _rcColor;
    private bool _rcIsDone;
    private bool _acOpen;
    private string _acName = "";
    private bool _acIsDone;

    // Vistas Calendario (mes navegable) y Gantt (ventana de 14 dias navegable).
    private DateTime _calMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _ganttStart = DefaultGanttStart();
    private static readonly string[] CalWeekdays = ["Lun", "Mar", "Mie", "Jue", "Vie", "Sab", "Dom"];

    /// <summary>
    /// Ventana inicial del gantt: el bloque de 14 dias del mes actual que CONTIENE a hoy
    /// (dias 1-14, 15-28 o 29+), para que la linea de HOY siempre arranque visible.
    /// </summary>
    private static DateTime DefaultGanttStart()
    {
        var today = DateTime.Today;
        return new DateTime(today.Year, today.Month, 1).AddDays(14 * ((today.Day - 1) / 14));
    }

    // Creacion rapida.
    private bool _qcOpen;
    private Guid _qcColumnId;
    private string _qcTitle = "";
    private string _qcDesc = "";
    private TaskPriority _qcPriority = TaskPriority.Medium;
    private string _qcAssignee = "";
    private DateTime? _qcDue;
    private readonly HashSet<Guid> _qcTagIds = new();
    private string _qcTypeId = "";
    private string _qcSubId = "";
    private string? _qcError;

    // Editar tablero.
    private bool _ebOpen;
    private string _ebName = "";
    private string _ebDesc = "";
    private TaskBoardStatus _ebStatus = TaskBoardStatus.InProgress;
    private DateTime? _ebDue;
    private string? _ebError;

    private bool _busy;
    private TaskToasts? _toasts;
    private TaskDetailModal? _taskDetail;
    private HubConnection? _hub;
    private string? _tenantId;

    private int FilterCount =>
        _fColumns.Count + _fUsers.Count + _fTags.Count + (_fDue is null ? 0 : 1);

    // Scope EF propio + semaforo (mismo patron de TaskKanban): el reload puede
    // dispararse por el hub (TaskChanged de otra sesion o el eco propio) mientras el
    // modal de detalle tiene una consulta en vuelo sobre el DbContext del circuito;
    // sin aislamiento EF lanza "second operation on this context".
    private readonly SemaphoreSlim _reloadLock = new(1, 1);

    // Mis Procesos (?sub=): abrir el arranque precargado con el concepto.
    private TaskWizard? _wizard;
    private FormFirstStarter? _formFirst;
    private bool _openWizardPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Los @ref existen recien tras el primer render; aqui abrimos el arranque UNA vez.
        if (_openWizardPending && _wizard is not null && _formFirst is not null
            && PresetSubcategoriaId is Guid presetSub)
        {
            _openWizardPending = false;

            // Ola B1: los conceptos marcados "Inicia modulo al crear la tarea" arrancan por el
            // FORMULARIO, no por el wizard de 4 pasos. TryOpenAsync devuelve false si el concepto no
            // es form-first o si su formulario no es utilizable -> escape hatch al wizard de siempre.
            if (await _formFirst.TryOpenAsync(presetSub))
            {
                return;
            }

            await _wizard.OpenAsync(presetSubcategoriaId: presetSub);
        }

        // Sincroniza la barra de scroll superior de la Lista con la inferior (ancho + posicion).
        if (_view == "lista")
        {
            try { await JS.InvokeVoidAsync("ecorexBoardList.syncScroll"); }
            catch (Microsoft.JSInterop.JSException) { /* el JS aun no cargo */ }
            catch (InvalidOperationException) { /* prerender: sin JS todavia */ }
        }
    }

    /// <summary>El wizard creo la actividad: refrescar el tablero para que aparezca la tarjeta.</summary>
    private async Task OnWizardCreatedAsync(TaskItemDetailDto _)
        => await ReloadAsync();

    /// <summary>Crear actividad desde el tablero: SIEMPRE el WIZARD grande (4 pasos), con este tablero y
    /// columna preseleccionados para que la actividad caiga aqui. Reemplaza al modal rapido.</summary>
    private async Task OpenWizardOnBoardAsync(Guid? columnId = null)
    {
        if (_wizard is null) { return; }
