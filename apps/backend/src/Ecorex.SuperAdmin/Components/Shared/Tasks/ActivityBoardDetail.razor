    // Una corrida de columnas CONSECUTIVAS con el mismo valor en un nivel de la cabecera (grupo,
    // titulo o subtitulo): se fusionan en una celda con colspan.
    private sealed record HeadRun(string? Value, int Span, int Start);

    private static List<HeadRun> MergeRuns(List<ListCol> cols, Func<ListCol, string?> sel)
    {
        var runs = new List<HeadRun>();
        var i = 0;
        while (i < cols.Count)
        {
            var v = sel(cols[i]) ?? string.Empty;
            var start = i;
            var span = 0;
            while (i < cols.Count && string.Equals(sel(cols[i]) ?? string.Empty, v, StringComparison.Ordinal)) { span++; i++; }
            runs.Add(new HeadRun(v, span, start));
        }
        return runs;
    }

