@using Ecorex.Application.Tenancy
@using Ecorex.Application.Actividades
@using Ecorex.Application.DataLookups
@using Ecorex.Application.Forms
@using Ecorex.Application.Forms.Lookups
@using Ecorex.Domain.Enums
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject IActivityBoardService BoardsSvc
@inject ITaskBoardService ColumnsSvc
@inject ITaskItemService TasksSvc
@inject ITaskFieldService FieldSvc
@inject IDataLookupService LookupSvc
@inject IFormLookupService FormLookupSvc
@inject IFormResponseService FormResponsesSvc
@inject IFormDefinitionService FormDefSvc
@inject ITenantUserService TenantUsersSvc
@inject IActivityTypeService TypesSvc
@inject IActividadCatalogoService CatalogoSvc
@inject ITaskBroadcaster Broadcaster
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory

@* ============================================================
   PANTALLA 2 del prototipo 'work' (ECOREX.dc.html, boardOpen):
   cabecera del tablero, filas de filtro por chips, alcances,
   switcher de vistas y kanban/lista por COLUMNAS del tablero.
   Fiel al pixel del fuente del prototipo.
   ============================================================ *@

@if (_detail is not null)
{
    <div class="ab-dhead">
        <button class="ab-back" @onclick="@(() => OnBack.InvokeAsync())">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
            Todos los tableros
        </button>
        <div class="ab-dtitlerow">
            <h1 class="ab-dtitle">@_detail.Name</h1>
            <span class="ab-dstatus"><span class="ab-dot" style="background:@AbUi.BoardStatusColor(_detail.Status)"></span>@AbUi.BoardStatusLabel(_detail.Status)</span>
            <span class="ab-ddue">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                @AbUi.BoardDeadline(_detail.DueDate)
            </span>
            <button class="ab-dedit" title="Editar tablero" @onclick="OpenEditBoard">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            </button>
        </div>
        <p class="ab-dsub">Toca cualquier valor para filtrar las tareas del tablero.</p>

        @* ---- Filas de filtro (Estado / Asignados / Fecha limite / Etiquetas) ---- *@
        @if (_filtersVisible)
        {
            <div class="ab-frows">
                <div class="ab-frow-lbl">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>
                    Estado
                </div>
                <div class="ab-chips">
                    @foreach (var (col, idx) in _detail.Columns.Select((c, i) => (c, i)))
                    {
                        var colId = col.Id;
                        <button class="ab-chip @(_fColumns.Contains(colId) ? "on" : "")" @onclick="@(() => ToggleColumnFilterAsync(colId))">
                            <span class="ab-dot" style="background:@AbUi.ColumnDot(idx)"></span>@col.Name
                        </button>
                    }
                </div>

                <div class="ab-frow-lbl">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="3.2"/><path d="M22 21v-2a4 4 0 0 0-3-3.85"/></svg>
                    Asignados
                </div>
                <div class="ab-chips">
                    @foreach (var m in _members)
                    {
                        var memberId = m.TenantUserId;
                        <button class="ab-chip @(_fUsers.Contains(memberId) ? "on" : "")" @onclick="@(() => ToggleUserFilterAsync(memberId))">
                            <span class="ab-chip-av" style="background:@AbUi.AvatarBg(m.Initials)">@m.Initials</span>@m.DisplayName
                        </button>
                    }
                    @if (_members.Count == 0)
                    {
                        <span style="font-size:12.5px;color:var(--ink-3)">Sin miembros todavia</span>
                    }
                </div>

                <div class="ab-frow-lbl">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    Fecha limite
                </div>
                <div class="ab-chips">
                    <button class="ab-chip @(_fDue == "hoy" ? "on" : "")" @onclick="@(() => ToggleDueFilterAsync("hoy"))">Hoy</button>
                    <button class="ab-chip @(_fDue == "manana" ? "on" : "")" @onclick="@(() => ToggleDueFilterAsync("manana"))">Manana</button>
                    <button class="ab-chip @(_fDue == "fecha" ? "on" : "")" @onclick="@(() => ToggleDueFilterAsync("fecha"))">Con fecha</button>
                    @if (_fDue == "fecha")
                    {
                        <input type="date" class="ab-due-input" value="@(_fDueOn?.ToString("yyyy-MM-dd"))" @onchange="OnDueOnChangedAsync" />
                    }
                </div>

                <div class="ab-frow-lbl">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v5l9 9 7-7-9-9H3Z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg>
                    Etiquetas
                </div>
                <div class="ab-chips">
                    @foreach (var tag in _boardTags)
                    {
                        var tagId = tag.Id;
                        <button class="ab-tagchip @(_fTags.Contains(tagId) ? "on" : "")"
                                style="background:@AbUi.TagSoft(tag.Color);color:@AbUi.TagFg(tag.Color)"
                                @onclick="@(() => ToggleTagFilterAsync(tagId))">@tag.Name</button>
                    }
                    @if (_boardTags.Count == 0)
                    {
                        <span style="font-size:12.5px;color:var(--ink-3)">Sin etiquetas en este tablero</span>
                    }
                    @if (FilterCount > 0)
                    {
                        <button class="ab-clear-inline" @onclick="ClearFiltersAsync">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                            Limpiar (@FilterCount)
                        </button>
                    }
                </div>
            </div>
        }

        @* ---- Pestanas de alcance ---- *@
        <div class="ab-scopes">
            <button class="ab-scope @(_scope == ActivityBoardScope.Team ? "on" : "")" @onclick="@(() => SetScopeAsync(ActivityBoardScope.Team))">
                Todas del equipo<span class="ab-scope-n">@_detail.ScopeCounters.Team</span>
            </button>
            <button class="ab-scope @(_scope == ActivityBoardScope.Mine ? "on" : "")" @onclick="@(() => SetScopeAsync(ActivityBoardScope.Mine))">
                Pendientes mios<span class="ab-scope-n">@_detail.ScopeCounters.Mine</span>
            </button>
            <button class="ab-scope @(_scope == ActivityBoardScope.Unassigned ? "on" : "")" @onclick="@(() => SetScopeAsync(ActivityBoardScope.Unassigned))">
                No asignados<span class="ab-scope-n">@_detail.ScopeCounters.Unassigned</span>
            </button>
            <button class="ab-scope @(_scope == ActivityBoardScope.Done ? "on" : "")" @onclick="@(() => SetScopeAsync(ActivityBoardScope.Done))">
                Terminados<span class="ab-scope-n">@_detail.ScopeCounters.Done</span>
            </button>
        </div>

        @* ---- Switcher de vistas ---- *@
        <div class="ab-tabs">
            <button class="ab-tab @(_view == "tablero" ? "on" : "")" @onclick="@(() => _view = "tablero")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                Tablero
            </button>
            <button class="ab-tab @(_view == "lista" ? "on" : "")" @onclick="@(() => _view = "lista")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                Lista
            </button>
            <button class="ab-tab @(_view == "calendario" ? "on" : "")" @onclick="@(() => _view = "calendario")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                Calendario
            </button>
            <button class="ab-tab @(_view == "gantt" ? "on" : "")" @onclick="@(() => _view = "gantt")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="9" height="3" rx="1"/><rect x="8" y="11" width="11" height="3" rx="1"/><rect x="5" y="17" width="8" height="3" rx="1"/></svg>
                Gantt
            </button>
            <button class="ab-tab-add" title="Proxima ola">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
            <div class="ab-tabs-right">
                @* En la vista Lista el boton Filtrar vive junto a "Agrupar por" (barra de la lista). *@
                @if (_view != "lista")
                {
                    <button class="ab-btn-filter @(_filtersVisible || FilterCount > 0 ? "active" : "")" @onclick="@(() => _filtersVisible = !_filtersVisible)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M7 12h10M11 18h2"/></svg>
                        Filtrar
                        @if (FilterCount > 0)
                        {
                            <span class="ab-filter-badge">@FilterCount</span>
                        }
                    </button>
                }
                <button class="ab-btn-filter" title="Configurar los campos personalizados de este tablero" @onclick="OpenFieldsConfig">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
                    Campos
                </button>
                <button class="ab-btn-filter" title="Configurar las columnas de la vista Lista" @onclick="OpenListConfig">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18M3 12h18M3 19h18"/><path d="M9 5v14"/></svg>
                    Columnas
                </button>
                <button class="ab-btn-task" @onclick="@(() => OpenWizardOnBoardAsync())">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Actividad
                </button>
            </div>
        </div>
    </div>

    @* ---- VISTA TABLERO (kanban por columnas del tablero) ---- *@
    @if (_view == "tablero")
    {
        <div class="ab-kanban" style="grid-template-columns:repeat(@_detail.Columns.Count,minmax(0,1fr))">
            @foreach (var (col, idx) in _detail.Columns.Select((c, i) => (c, i)))
            {
                var column = col;
                var colIdx = idx;
                <div>
                    <div class="ab-col-head">
                        <div class="ab-col-name">@column.Name</div>
                        <span class="ab-col-count" style="background:@AbUi.ColumnBadgeBg(colIdx);color:@AbUi.ColumnBadgeFg(colIdx)">@column.Cards.Count</span>
                        <div class="ab-menu-anchor" style="margin-left:auto">
                            <button class="ab-col-menu" title="Opciones de columna" @onclick="@(() => ToggleColMenu(column.Id))" @onclick:stopPropagation="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>
                            </button>
                            @if (_colMenuId == column.Id)
                            {
                                <div class="ab-dd-pop ab-menu-pop">
                                    <button class="ab-dd-opt" @onclick="@(() => OpenRenameColumn(column))">Renombrar columna</button>
                                    <button class="ab-dd-opt" @onclick="@(() => ToggleColumnDoneAsync(column))">
                                        @(column.IsDone ? "Desmarcar columna final" : "Marcar como columna final")
                                    </button>
                                    <button class="ab-dd-opt" @onclick="OpenAddColumn">Agregar columna al final</button>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="ab-col-body @(_dragOverColumnId == column.Id ? "dragover" : "")"
                         ondragover="event.preventDefault()"
                         @ondragenter="@(() => _dragOverColumnId = column.Id)"
                         @ondragleave="@(() => { if (_dragOverColumnId == column.Id) { _dragOverColumnId = null; } })"
                         @ondrop="@(() => OnDropAsync(column))">
                        @foreach (var card in column.Cards)
                        {
                            var c = card;
                            <div class="ab-card @(_dragTaskId == c.Id ? "dragging" : "")" draggable="true"
                                 ondragover="event.preventDefault()"
                                 @onclick="@(() => OpenTaskAsync(c.Id))"
                                 @ondragstart="@(() => _dragTaskId = c.Id)"
                                 @ondrop="@(() => OnDropOnCardAsync(column, c))"
                                 @ondrop:stopPropagation="true"
                                 @ondragend="@(() => { _dragTaskId = null; _dragOverColumnId = null; })">
                                <div class="ab-card-top">
                                    @if (c.IsSubtask)
                                    {
                                        <span class="ab-subtask-badge" title="Subtarea de @c.ParentNumber">&#8627; @c.ParentNumber</span>
                                    }
                                    <div class="ab-card-title">@c.Title</div>
                                    @if (c.Status is TaskItemStatus.Done or TaskItemStatus.Suspended or TaskItemStatus.Closed)
                                    {
                                        <span class="tk-status @TaskUi.StatusClass(c.Status)" style="flex:none;font-size:10px;padding:1px 7px;align-self:flex-start;">@TaskUi.StatusLabel(c.Status)</span>
                                    }
                                    <div class="ab-menu-anchor">
                                        <button class="ab-card-menu" title="@c.Number" @onclick="@(() => ToggleCardMenu(c.Id))" @onclick:stopPropagation="true">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>
                                        </button>
                                        @if (_cardMenuId == c.Id)
                                        {
                                            <div class="ab-dd-pop ab-menu-pop" @onclick:stopPropagation="true">
                                                <button class="ab-dd-opt" @onclick="@(() => OpenFromMenuAsync(c.Id))">Abrir</button>
                                                <button class="ab-dd-opt" @onclick="@(() => _cardMoveOpen = !_cardMoveOpen)">
                                                    <span>Mover a</span>
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--ink-3)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                                                </button>
                                                @if (_cardMoveOpen)
                                                {
                                                    @foreach (var (mcol, midx) in _detail.Columns.Select((x, i) => (x, i)))
                                                    {
                                                        var moveTarget = mcol;
                                                        <button class="ab-dd-opt ab-menu-sub @(moveTarget.Id == c.ColumnId ? "sel" : "")"
                                                                @onclick="@(() => MoveFromMenuAsync(c, moveTarget))">
                                                            <span class="ab-dot" style="background:@AbUi.ColumnDot(midx)"></span>@mcol.Name
                                                        </button>
                                                    }
                                                }
                                                @if (!_cardArchiveConfirm)
                                                {
                                                    <button class="ab-dd-opt danger" @onclick="@(() => _cardArchiveConfirm = true)">Archivar</button>
                                                }
                                                else
                                                {
                                                    <button class="ab-dd-opt danger" @onclick="@(() => ArchiveFromMenuAsync(c))">Confirmar archivado</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <p class="ab-card-desc">@Truncate(c.Description!, 110)</p>
                                }
                                <div class="ab-card-progrow">
                                    <span class="lbl">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h9M3 6h.01M3 12h.01M3 18h.01"/></svg>
                                        Progreso
                                    </span>
                                    <strong>@(c.ChecklistDone + c.SubtaskDone)/@(c.ChecklistTotal + c.SubtaskTotal)</strong>
                                </div>
                                <div class="ab-card-bar"><i style="width:@(c.ChecklistPct)%;background:@AbUi.ColumnProgressColor(colIdx)"></i></div>
                                <div class="ab-card-assign">
                                    <span class="lbl">Asignado a</span>
                                    <div class="ab-avatars">
                                        @foreach (var person in CardPeople(c))
                                        {
                                            <span class="ab-av sm" style="background:@AbUi.AvatarBg(person.Initials)" title="@person.DisplayName">@person.Initials</span>
                                        }
                                        @if (CardPeople(c).Count == 0)
                                        {
                                            <span style="font-size:11.5px;color:var(--ink-3)">Sin asignar</span>
                                        }
                                    </div>
                                </div>
                                <div class="ab-card-foot">
                                    <span class="ab-card-due" style="color:@AbUi.CardDueColor(c.DueDate, column.IsDone)">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                                        @(c.DueDate is DateTimeOffset dd ? AbUi.CardDue(dd) : "Sin fecha")
                                    </span>
                                    <div class="ab-card-counts">
                                        @{
                                            var enColumnaDesde = c.ColumnEnteredAt ?? c.CreatedAt;
                                        }
                                        <span class="ab-card-age" title="Tiempo en esta columna"
                                              style="color:@AbUi.TimeInColumnColor(enColumnaDesde, column.IsDone)">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>@AbUi.TimeInColumn(enColumnaDesde)
                                        </span>
                                        <span title="Adjuntos">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 9.5 12 18a4 4 0 0 1-6-6l8-8a2.5 2.5 0 0 1 4 4l-8 8a1 1 0 0 1-1.5-1.5L16 7"/></svg>@c.AttachmentsCount
                                        </span>
                                        <span title="Comentarios">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>@c.CommentsCount
                                        </span>
                                        <span title="Checklist">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h12M9 12h12M9 18h12"/><path d="m3 6 1 1 2-2M3 12l1 1 2-2M3 18l1 1 2-2"/></svg>@c.ChecklistDone/@c.ChecklistTotal
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        <button class="ab-addtask" @onclick="@(() => OpenWizardOnBoardAsync(column.Id))">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                            Anadir actividad
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @* ---- VISTA LISTA (configurable por tablero, Ola 2 ADR-0065) ---- *@
    @if (_view == "lista")
    {
        var lcols = VisibleListColumns();
        var display = BuildDisplayRows(lcols);
        var totalRows = display.TotalUnits;
        var totalPages = display.TotalPages;
        <div class="ab-listwrap">
            @* Agrupador (ADR-0065): agrupa las filas por el campo elegido; suma las columnas
               numericas por grupo (en el encabezado del grupo) y un total general al final. *@
            <div class="tkl-groupbar">
                @* Filtro primero, luego el agrupador (peticion del usuario). *@
                <button class="ab-btn-filter @(_filtersVisible || FilterCount > 0 ? "active" : "")" @onclick="@(() => _filtersVisible = !_filtersVisible)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M7 12h10M11 18h2"/></svg>
                    Filtrar
                    @if (FilterCount > 0)
                    {
                        <span class="ab-filter-badge">@FilterCount</span>
                    }
                </button>
                <span class="tkl-groupbar-sep"></span>
                <span class="tkl-groupbar-lbl">Agrupar por</span>
                <select class="tkl-groupsel" @bind="_groupBy" @bind:after="OnGroupByChanged">
                    <option value="">(sin agrupar)</option>
                    <option value="@TaskListViewConfig.KeyStage">Etapa</option>
                    <option value="@TaskListViewConfig.KeyStatus">Estado</option>
                    <option value="@TaskListViewConfig.KeyAssignee">Encargado</option>
                    <option value="@TaskListViewConfig.KeyPriority">Prioridad</option>
                    <option value="@GroupRequester">Solicitante</option>
                    @foreach (var gc in GroupableFieldColumns())
                    {
                        <option value="@gc.Key">@gc.Title</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(_groupBy))
                {
                    <span class="tkl-groupbar-hint">Agrupado por <strong>@GroupByLabel()</strong> &#183; totales numericos por grupo y total general al final.</span>
                }
            </div>
            @if (lcols.Count == 0)
            {
                <div class="ab-list"><div class="ab-empty" style="padding:24px 22px;">No hay columnas visibles. Usa el boton <strong>Columnas</strong> para elegir cuales mostrar.</div></div>
            }
            else
            {
                @* Barra de scroll horizontal SUPERIOR, sincronizada con la inferior (JS ecorexBoardList). *@
                <div class="tkl-topscroll"><div class="tkl-topscroll-inner"></div></div>
                <div class="tkl-scroll">
                    <table class="tkl">
                        <thead>
                            @{
                                var _hasGroup = lcols.Any(x => !string.IsNullOrWhiteSpace(x.Group));
                                var _hasSub = lcols.Any(x => !string.IsNullOrWhiteSpace(x.Subtitle));
                            }
                            @* Nivel 1: GRUPO (supra-titulo), fusiona consecutivos con el mismo grupo. *@
                            @if (_hasGroup)
                            {
                                <tr>
                                    @foreach (var run in MergeRuns(lcols, x => x.Group))
                                    {
                                        <th colspan="@run.Span" class="tkl-group @(run.Start == 0 ? "tkl-pin" : "")">@run.Value</th>
                                    }
                                </tr>
                            }
                            @* Nivel 2: TITULO (fusiona consecutivos con el mismo titulo). Aqui va el color del encabezado. *@
                            <tr>
                                @foreach (var run in MergeRuns(lcols, x => x.Title))
                                {
                                    <th colspan="@run.Span" class="tkl-th-main @(run.Start == 0 ? "tkl-pin" : "")" style="@ColHeadStyle(lcols[run.Start])">@run.Value</th>
                                }
                            </tr>
                            @* Nivel 3: SUBTITULO (fusiona consecutivos con el mismo subtitulo). *@
                            @if (_hasSub)
                            {
                                <tr>
                                    @foreach (var run in MergeRuns(lcols, x => x.Subtitle))
                                    {
                                        <th colspan="@run.Span" class="tkl-subrow @(run.Start == 0 ? "tkl-pin" : "")">@run.Value</th>
                                    }
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @foreach (var row in display.Rows)
                            {
                                @if (row.IsGroupHeader)
                                {
                                    <tr class="tkl-grouprow">
                                        @for (var ci = 0; ci < lcols.Count; ci++)
                                        {
                                            var gcol = lcols[ci];
                                            <td class="@(ci == 0 ? "tkl-pin" : "")">
                                                @if (ci == 0)
                                                {
                                                    <span class="tkl-group-label">@row.GroupValue<span class="tkl-group-count">@row.GroupCount</span></span>
                                                }
                                                else if (row.Sums is not null && row.Sums.TryGetValue(gcol.Key, out var gs))
                                                {
                                                    <strong class="tkl-sum">@FmtColTotal(gcol, gs)</strong>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                                else if (row.DetailKind == 1)
                                {
                                    var dcolsH = VisibleDetailColumns();
                                    <tr class="tkl-detailhead">
                                        <td class="tkl-pin"></td>
                                        <td colspan="@Math.Max(1, lcols.Count - 1)">
                                            <div class="tkl-dgrid tkl-dgrid-head" style="grid-template-columns:repeat(@dcolsH.Count,minmax(90px,1fr));">
                                                @foreach (var dc in dcolsH) { <span>@DetailColLabel(dc)</span> }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (row.DetailKind == 2)
                                {
                                    var dcolsR = VisibleDetailColumns();
                                    <tr class="tkl-detailrow">
                                        <td class="tkl-pin"></td>
                                        <td colspan="@Math.Max(1, lcols.Count - 1)">
                                            <div class="tkl-dgrid" style="grid-template-columns:repeat(@dcolsR.Count,minmax(90px,1fr));">
                                                @foreach (var dc in dcolsR) { <span>@DetailCellText(row.DetailCells, dc.Key)</span> }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var c = row.Card!;
                                    var stage = row.Column!;
                                    var sIdx = row.ColIdx;
                                    <tr class="tkl-row @(row.Depth > 0 ? "tkl-childrow" : "")" @onclick="@(() => OpenTaskAsync(c.Id))">
                                        @for (var ci = 0; ci < lcols.Count; ci++)
                                        {
                                            var lcol = lcols[ci];
                                            var key = lcol.Key;
                                            <td class="@(ci == 0 ? "tkl-pin" : "")" style="@ColCellStyle(lcol)">
                                                @if (key == TaskListViewConfig.KeyTitle)
                                                {
                                                    <div class="ab-lr-title" style="@(row.Depth > 0 ? "padding-left:20px;" : "")">
                                                        <div>@if (row.HasKids) { <button class="tkl-expander" title="@(HasDetail ? "Ver items" : "Ver subtareas")" @onclick:stopPropagation="true" @onclick="@(() => ToggleExpand(c.Id))">@(row.Expanded ? "\u2212" : "+")</button> } @if (c.IsSubtask) { <span class="ab-subtask-badge" title="Subtarea de @c.ParentNumber">&#8627;</span> } @c.Title</div>
                                                        <div>@(c.Description ?? "")</div>
                                                    </div>
                                                }
                                                else if (key == TaskListViewConfig.KeyNumber)
                                                {
                                                    <span class="tkl-mono">@c.Number</span>
                                                }
                                                else if (key == TaskListViewConfig.KeyStage)
                                                {
                                                    <span class="ab-lr-status"><span class="ab-dot" style="background:@AbUi.ColumnDot(sIdx)"></span>@stage.Name</span>
                                                }
                                                else if (key == TaskListViewConfig.KeyStatus)
                                                {
                                                    <span class="tk-status @TaskUi.StatusClass(c.Status)" style="font-size:11px;padding:2px 9px;">@TaskUi.StatusLabel(c.Status)</span>
                                                }
                                                else if (key == TaskListViewConfig.KeyAssignee)
                                                {
                                                    <div class="ab-avatars">
                                                        @foreach (var person in CardPeople(c).Take(3))
                                                        {
                                                            <span class="ab-av sm" style="background:@AbUi.AvatarBg(person.Initials)" title="@person.DisplayName">@person.Initials</span>
                                                        }
                                                        @if (CardPeople(c).Count == 0)
                                                        {
                                                            <span style="font-size:11.5px;color:var(--ink-3)">Sin asignar</span>
                                                        }
                                                    </div>
                                                }
                                                else if (key == TaskListViewConfig.KeyPriority)
                                                {
                                                    <span class="ab-prio" style="background:@AbUi.PrioritySoft(c.Priority);color:@AbUi.PriorityColor(c.Priority)">@TaskUi.PriorityLabel(c.Priority)</span>
                                                }
                                                else if (key == TaskListViewConfig.KeyProgress)
                                                {
                                                    <div class="ab-lr-prog"><div class="bar"><i style="width:@(c.ChecklistPct)%;background:@AbUi.ColumnProgressColor(sIdx)"></i></div><span class="pct">@(c.ChecklistPct)%</span></div>
                                                }
                                                else if (key == TaskListViewConfig.KeyDue)
                                                {
                                                    <span class="ab-lr-due" style="color:@AbUi.CardDueColor(c.DueDate, stage.IsDone)">@(c.DueDate is DateTimeOffset dd ? AbUi.CardDue(dd) : "-")</span>
                                                }
                                                else if (key == TaskListViewConfig.KeyStart)
                                                {
                                                    <span>@(c.StartDate is DateTimeOffset sd ? AbUi.CardDue(sd) : "-")</span>
                                                }
                                                else if (key == TaskListViewConfig.KeyCreated)
                                                {
                                                    <span>@AbUi.CardDue(c.CreatedAt)</span>
                                                }
                                                else if (key == TaskListViewConfig.KeyTags)
                                                {
                                                    <div class="tkl-tags">
                                                        @foreach (var tg in c.Tags.Take(3))
                                                        {
                                                            <span class="tkl-tag" style="background:@(string.IsNullOrWhiteSpace(tg.Color) ? "var(--surface-3)" : tg.Color + "22");color:@(string.IsNullOrWhiteSpace(tg.Color) ? "var(--ink-2)" : tg.Color)">@tg.Name</span>
                                                        }
                                                    </div>
                                                }
                                                else if (key.StartsWith("form:"))
                                                {
                                                    <span class="tkl-cf">@FormCellText(key, c)</span>
                                                }
                                                else
                                                {
                                                    <span class="tkl-cf">@CustomCellText(key, c)</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            @if (totalRows == 0)
                            {
                                <tr><td colspan="@lcols.Count" class="tkl-empty">No hay tareas que coincidan con los filtros.</td></tr>
                            }
                        </tbody>
                        @if (display.NumCols.Count > 0)
                        {
                            <tfoot>
                                <tr class="tkl-totalrow">
                                    @for (var ci = 0; ci < lcols.Count; ci++)
                                    {
                                        var tcol = lcols[ci];
                                        <td class="@(ci == 0 ? "tkl-pin" : "")">
                                            @if (ci == 0)
                                            {
                                                <strong>TOTAL GENERAL</strong>
                                            }
                                            else if (display.Grand.TryGetValue(tcol.Key, out var ts))
                                            {
                                                <strong class="tkl-sum">@FmtColTotal(tcol, ts)</strong>
                                            }
                                        </td>
                                    }
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
                @if (totalPages > 1)
                {
                    <div class="tkl-pager">
                        <span class="tkl-pager-info">@totalRows tareas &#183; pagina @_listPage de @totalPages</span>
                        <div class="tkl-pager-btns">
                            <button class="tkl-pager-btn" disabled="@(_listPage <= 1)" @onclick="@(() => _listPage = 1)" title="Primera">&#171;</button>
                            <button class="tkl-pager-btn" disabled="@(_listPage <= 1)" @onclick="@(() => _listPage -= 1)" title="Anterior">&#8249;</button>
                            <button class="tkl-pager-btn" disabled="@(_listPage >= totalPages)" @onclick="@(() => _listPage += 1)" title="Siguiente">&#8250;</button>
                            <button class="tkl-pager-btn" disabled="@(_listPage >= totalPages)" @onclick="@(() => _listPage = totalPages)" title="Ultima">&#187;</button>
                        </div>
                    </div>
                }
            }
        </div>
    }

    @* ---- Configurador de columnas de la Lista (Ola 2 ADR-0065) ---- *@
    @if (_lcOpen)
    {
        <div class="modal-overlay" @onclick="@(() => _lcOpen = false)">
            <div class="modal-dialog" style="max-width:1080px;width:96vw;max-height:88vh;display:flex;flex-direction:column;" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Columnas de la lista &#183; @_detail.Name</h3>
                    <button class="modal-close" @onclick="@(() => _lcOpen = false)">&times;</button>
                </div>
                <div class="modal-body" style="flex:1;overflow:auto;">
                    <p class="tkl-cfg-hint">Elige que columnas se ven en la vista Lista, su orden, color y titulo/subtitulo. Es compartida por tablero: todos ven lo mismo. El encabezado y la primera columna quedan fijos al desplazar.</p>

                    <div class="lc-addform">
                        <div class="lc-addform-top">
                            <label>Agregar campos de un formulario</label>
                            <select class="ab-select" @onchange="OnPickFormAsync">
                                <option value="">-- Elige un formulario --</option>
                                @foreach (var bf in _bfForms)
                                {
                                    <option value="@bf.DefinitionId" selected="@(_bfDefId == bf.DefinitionId)">@bf.Title @(bf.IsConcept ? "(concepto)" : "(paso)")</option>
                                }
                            </select>
                        </div>
                        @if (_bfForms.Count == 0)
                        {
                            <div class="tkl-cfg-hint" style="margin:0;">Este tablero aun no tiene formularios asociados (concepto o pasos del flujo).</div>
                        }
                        else if (_bfDefId is not null)
                        {
                            @if (_bfFields.Count == 0)
                            {
                                <div class="tkl-cfg-hint" style="margin:0;">Ese formulario no tiene campos.</div>
                            }
                            else
                            {
                                <div class="lc-fieldpick">
                                    @foreach (var q in _bfFields)
                                    {
                                        var code = q.FieldCode;
                                        <label class="lc-fieldchk">
                                            <input type="checkbox" checked="@_bfSel.Contains(code)" @onchange="@(e => ToggleBfField(code, (bool)(e.Value ?? false)))" />
                                            <span>@q.Label</span>
                                        </label>
                                    }
                                </div>
                                <button type="button" class="btn btn-xs btn-primary" @onclick="AddFormFields" disabled="@(_bfSel.Count == 0)">Agregar como columnas (@_bfSel.Count)</button>
                            }
                        }
                    </div>

                    @* Detalle expandible (GridDetail): elegir UNA grilla de UN formulario + sus columnas. *@
                    <div class="lc-addform">
                        <div class="lc-addform-top">
                            <label>Detalle (items) &#183; grilla expandible</label>
                            <select class="ab-select" @bind="_dcSel" @bind:after="OnDetailSourceChanged">
                                <option value="">-- Sin detalle --</option>
                                @foreach (var src in _detailSources)
                                {
                                    <option value="@($"{src.FormDefId}:{src.GridFieldCode}")">@src.FormTitle &#183; @src.GridLabel</option>
                                }
                            </select>
                        </div>
                        @if (_detailSources.Count == 0)
                        {
                            <div class="tkl-cfg-hint" style="margin:0;">Ningun formulario del tablero tiene una grilla (GridDetail) para usar como detalle.</div>
                        }
                        else if (_dcCols.Count > 0)
                        {
                            <div class="tkl-cfg-hint" style="margin:0 0 6px;">Al expandir una fila (con "+") se ven estas columnas del detalle. Elige cuales y su orden.</div>
                            <table class="lc-tbl" style="max-width:560px;">
                                <thead><tr><th></th><th>Ver</th><th>Columna</th><th>Titulo</th></tr></thead>
                                <tbody>
                                    @for (var i = 0; i < _dcCols.Count; i++)
                                    {
                                        var d = _dcCols[i];
                                        var di = i;
                                        <tr class="@(d.Visible ? "" : "lc-off")">
                                            <td class="lc-move">
                                                <button type="button" title="Subir" disabled="@(di == 0)" @onclick="@(() => DcMove(di, -1))">&#9650;</button>
                                                <button type="button" title="Bajar" disabled="@(di == _dcCols.Count - 1)" @onclick="@(() => DcMove(di, 1))">&#9660;</button>
                                            </td>
                                            <td><input type="checkbox" checked="@d.Visible" @onchange="@(e => d.Visible = (bool)(e.Value ?? false))" /></td>
                                            <td><span class="lc-name">@d.Label</span></td>
                                            <td><input class="ab-input" placeholder="@d.Label" @bind="d.Title" maxlength="40" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <p class="tkl-cfg-hint" style="margin:0 0 8px;">Tip: pon el mismo <strong>Grupo</strong> en columnas seguidas para que compartan un supra-titulo que las abarque. Hay <strong>dos</strong> colores por columna: <strong>Encab.</strong> tine el encabezado y <strong>Columna</strong> tine TODA la columna (las celdas de esa columna en cada fila).</p>
                    <table class="lc-tbl">
                        <thead><tr><th></th><th>Ver</th><th>Campo</th><th>Grupo</th><th>Titulo</th><th>Subtitulo</th><th>Encab.</th><th>Columna</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _lc.Count; i++)
                            {
                                var r = _lc[i];
                                var idx = i;
                                <tr class="@(r.Visible ? "" : "lc-off")">
                                    <td class="lc-move">
                                        <button type="button" title="Subir" disabled="@(idx == 0)" @onclick="@(() => LcMove(idx, -1))">&#9650;</button>
                                        <button type="button" title="Bajar" disabled="@(idx == _lc.Count - 1)" @onclick="@(() => LcMove(idx, 1))">&#9660;</button>
                                    </td>
                                    <td><input type="checkbox" checked="@r.Visible" @onchange="@(e => r.Visible = (bool)(e.Value ?? false))" /></td>
                                    <td><span class="lc-name">@r.DefaultLabel</span>@if (!r.Builtin) { <span class="lc-badge">campo</span> }</td>
                                    <td><input class="ab-input" placeholder="(sin grupo)" @bind="r.Group" maxlength="40" /></td>
                                    <td><input class="ab-input" placeholder="@r.DefaultLabel" @bind="r.Title" maxlength="60" /></td>
                                    <td><input class="ab-input" placeholder="-" @bind="r.Subtitle" maxlength="60" /></td>
                                    <td class="lc-color">
                                        <input type="color" value="@(string.IsNullOrWhiteSpace(r.Color) ? "#7c5cff" : r.Color)" @onchange="@(e => r.Color = e.Value?.ToString() ?? string.Empty)" />
                                        @if (!string.IsNullOrWhiteSpace(r.Color))
                                        {
                                            <button type="button" class="lc-clear" title="Sin color de encabezado" @onclick="@(() => r.Color = string.Empty)">&times;</button>
                                        }
                                    </td>
                                    <td class="lc-color">
                                        <input type="color" value="@(string.IsNullOrWhiteSpace(r.CellColor) ? "#7c5cff" : r.CellColor)" @onchange="@(e => r.CellColor = e.Value?.ToString() ?? string.Empty)" />
                                        @if (!string.IsNullOrWhiteSpace(r.CellColor))
                                        {
                                            <button type="button" class="lc-clear" title="Sin color de columna" @onclick="@(() => r.CellColor = string.Empty)">&times;</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-foot">
                    <button class="btn btn-outline-secondary" @onclick="ResetListConfigAsync">Restablecer a columnas por defecto</button>
                    <div style="flex:1"></div>
                    <button class="btn btn-outline-secondary" @onclick="@(() => _lcOpen = false)">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveListConfigAsync">Guardar</button>
                </div>
            </div>
        </div>
    }

    @* ---- VISTA CALENDARIO (fuente: bloque isCalendario del prototipo) ---- *@
    @if (_view == "calendario")
    {
        <div class="ab-calwrap">
            <div class="ab-cal">
                <div class="ab-cal-head">
                    <div class="ab-cal-title">@AbUi.MonthTitle(_calMonth)</div>
                    <div class="ab-cal-nav">
                        <button class="ab-cal-btn" title="Mes anterior" @onclick="@(() => _calMonth = _calMonth.AddMonths(-1))">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
                        </button>
                        <button class="ab-cal-btn" title="Mes siguiente" @onclick="@(() => _calMonth = _calMonth.AddMonths(1))">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                        </button>
                    </div>
                </div>
                <div class="ab-cal-week">
                    @foreach (var wd in CalWeekdays)
                    {
                        <div>@wd</div>
                    }
                </div>
                <div class="ab-cal-grid">
                    @foreach (var cell in CalCells())
                    {
                        if (!cell.Valid)
                        {
                            <div class="ab-cal-cell off"></div>
                        }
                        else
                        {
                            var cellDate = cell.Date;
                            <div class="ab-cal-cell @(cell.IsToday ? "today" : "")" @onclick="@(() => OpenWizardOnBoardAsync())">
                                <span class="ab-cal-num @(cell.IsToday ? "today" : "")">@cell.Date.Day</span>
                                @foreach (var (colIdx, card) in cell.Chips.Take(3))
                                {
                                    var chipCard = card;
                                    <div class="ab-cal-chip" style="border-left:3px solid @AbUi.ColumnDot(colIdx)" title="@chipCard.Title"
                                         @onclick="@(() => OpenTaskAsync(chipCard.Id))" @onclick:stopPropagation="true">@chipCard.Title</div>
                                }
                                @if (cell.Chips.Count > 3)
                                {
                                    <div class="ab-cal-more">+@(cell.Chips.Count - 3)</div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @* ---- VISTA GANTT (fuente: bloque isGantt del prototipo, ventana de 14 dias) ---- *@
    @if (_view == "gantt")
    {
        <div class="ab-ganttwrap">
            <div class="ab-gantt">
                <div class="ab-gantt-head">
                    <div class="ab-gantt-lbl">TAREA - @AbUi.MonthUpper(_ganttStart) @_ganttStart.Year</div>
                    <div class="ab-gantt-days">
                        @foreach (var d in GanttDays())
                        {
                            <div class="ab-gantt-day @(d.Weekend ? "we" : "")">@d.Date.Day</div>
                        }
                    </div>
                    <div class="ab-gantt-nav">
                        <button class="ab-cal-btn" title="14 dias atras" @onclick="@(() => _ganttStart = _ganttStart.AddDays(-14))">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
                        </button>
                        <button class="ab-cal-btn" title="14 dias adelante" @onclick="@(() => _ganttStart = _ganttStart.AddDays(14))">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                        </button>
                    </div>
                </div>
                @foreach (var row in GanttRows())
                {
                    var g = row;
                    <div class="ab-gantt-row">
                        <div class="ab-gantt-task" @onclick="@(() => OpenTaskAsync(g.Card.Id))">
                            <span class="ab-gantt-dot" style="background:@AbUi.ColumnDot(g.ColIdx)"></span>
                            <span class="ab-gantt-name">@g.Card.Title</span>
                        </div>
                        <div class="ab-gantt-track">
                            @if (GanttTodayLeft() is string todayLeft)
                            {
                                <div class="ab-gantt-today" style="left:@todayLeft"></div>
                            }
                            <div class="ab-gantt-bar" style="left:@g.Left;width:@g.Width;background:@AbUi.ColumnDot(g.ColIdx)"
                                 @onclick="@(() => OpenTaskAsync(g.Card.Id))">@(g.Card.ChecklistDone + g.Card.SubtaskDone)/@(g.Card.ChecklistTotal + g.Card.SubtaskTotal)</div>
                        </div>
                    </div>
                }
                @if (!GanttRows().Any())
                {
                    <div class="ab-empty" style="padding:24px 22px;">No hay tareas con fechas dentro de la ventana visible.</div>
                }
            </div>
        </div>
    }

    @if (_colMenuId is not null || _cardMenuId is not null)
    {
        <div class="ab-scrim" @onclick="CloseMenus"></div>
    }
}

@* ---- Modal de creacion rapida de tarea ---- *@
@if (_qcOpen && _detail is not null)
{
    <div class="ab-modal-overlay" @onclick="@(() => _qcOpen = false)">
        <div class="ab-modal wide ab-quick-modal" @onclick:stopPropagation="true">
            <div class="ab-modal-head">
                <h3>Nueva actividad</h3>
                <button class="ab-modal-x" @onclick="@(() => _qcOpen = false)" aria-label="Cerrar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="ab-modal-body">
                <div class="ab-field">
                    <label>Titulo</label>
                    <input class="ab-input" @bind="_qcTitle" maxlength="200" placeholder="Que hay que hacer?" />
                </div>
                <div class="ab-field">
                    <label>Descripcion</label>
                    <textarea class="ab-textarea" @bind="_qcDesc" placeholder="Detalles para el equipo (opcional)"></textarea>
                </div>
                <div class="ab-field">
                    <label>Columna</label>
                    <select class="ab-select" @bind="_qcColumnId">
                        @foreach (var col in _detail.Columns)
                        {
                            <option value="@col.Id">@col.Name</option>
                        }
                    </select>
                </div>
                <div class="ab-field">
                    <label>Prioridad</label>
                    <div class="ab-prio-opts">
                        @foreach (var p in new[] { TaskPriority.High, TaskPriority.Medium, TaskPriority.Low })
                        {
                            var prio = p;
                            <button class="ab-prio-opt @(_qcPriority == prio ? "on" : "")" @onclick="@(() => _qcPriority = prio)">@TaskUi.PriorityLabel(prio)</button>
                        }
                    </div>
                </div>
                <div class="ab-field">
                    <label>Encargado</label>
                    <select class="ab-select" @bind="_qcAssignee">
                        <option value="">Sin asignar</option>
                        @foreach (var u in _users)
                        {
                            <option value="@u.Id">@TaskUi.UserLabel(u)</option>
                        }
                    </select>
                </div>
                <div class="ab-field">
                    <label>Fecha limite</label>
                    <input type="date" class="ab-input" @bind="_qcDue" />
                </div>
                <div class="ab-field">
                    <label>Etiquetas</label>
                    <div class="ab-tag-opts">
                        @foreach (var tag in _tags)
                        {
                            var tagId = tag.Id;
                            <button class="ab-tagchip @(_qcTagIds.Contains(tagId) ? "on" : "")"
                                    style="background:@AbUi.TagSoft(tag.Color);color:@AbUi.TagFg(tag.Color)"
                                    @onclick="@(() => { if (!_qcTagIds.Remove(tagId)) { _qcTagIds.Add(tagId); } })">@tag.Name</button>
                        }
                        @if (_tags.Count == 0)
                        {
                            <span style="font-size:12.5px;color:var(--ink-3)">El tenant no tiene etiquetas.</span>
                        }
                    </div>
                </div>
                <div class="ab-field">
                    <label>Actividad (concepto)</label>
                    @* Ola 6: crear-desde-tablero ofrece SOLO actividades sin proceso (las de
                       proceso se crean desde el menu "Mis Procesos"). *@
                    <select class="ab-select" @bind="_qcSubId">
                        <option value="">Automatico (tipo por defecto)</option>
                        @foreach (var s in _freeSubs)
                        {
                            <option value="@s.Id">@s.Nombre</option>
                        }
                    </select>
                </div>
                @if (_qcError is not null)
                {
                    <div class="ab-field-error">@_qcError</div>
                }
            </div>
            <div class="ab-modal-foot">
                <button class="ab-btn-secondary" @onclick="@(() => _qcOpen = false)">Cancelar</button>
                <button class="ab-btn-commit" disabled="@(_busy || string.IsNullOrWhiteSpace(_qcTitle))" @onclick="QuickCreateAsync">Crear actividad</button>
            </div>
        </div>
    </div>
}

