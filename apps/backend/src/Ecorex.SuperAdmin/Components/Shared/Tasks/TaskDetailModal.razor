    // Tamano de render: eventos (inicio/fin) como circulos de buen tamano (antes 38px se veian diminutos
    // frente a las tareas); tareas mas anchas/altas para las etiquetas. Los eventos se re-centran en
    // FlowNodeLeft/Top para que crecer el circulo NO descoloque las aristas (mantienen su centro).
    private const int FlowEventSize = 72;
    private static bool FlowIsEvent(TaskFlowNodeDto n) => n.NodeType is WorkflowNodeType.StartEvent or WorkflowNodeType.EndEvent;
    private static int FlowEventOrigW(TaskFlowNodeDto n) => Math.Min(n.W, 38);
    private static int FlowEventOrigH(TaskFlowNodeDto n) => Math.Min(n.H, 38);
    private static int FlowNodeW(TaskFlowNodeDto n) => FlowIsEvent(n) ? FlowEventSize : Math.Max(n.W, 132);
    private static int FlowNodeH(TaskFlowNodeDto n) => FlowIsEvent(n) ? FlowEventSize : Math.Max(n.H, 112);

    // Arrastre "un poco": desplazamiento por nodo (solo de sesion, no se persiste) para reacomodar el
    // diagrama a gusto. Se suma a la posicion calculada. Se usa HTML5 drag (ondragstart/ondragend), que
    // NO manda un evento por cada pixel -> nada de lag en Blazor Server (a diferencia de pointermove).
    private readonly Dictionary<Guid, (int dx, int dy)> _flowOffsets = new();
    private Guid? _flowDragNode;
    private double _flowDragStartX, _flowDragStartY;

    private int FlowOffX(Guid id) => _flowOffsets.TryGetValue(id, out var o) ? o.dx : 0;
    private int FlowOffY(Guid id) => _flowOffsets.TryGetValue(id, out var o) ? o.dy : 0;
    // Base con padding 30 (deja aire para el re-centrado de los eventos, que restan hasta ~18px).
    private int FlowNodeLeft(TaskFlowDiagramDto flow, TaskFlowNodeDto n)
        => (int)((n.X - flow.MinX) * FlowXScale) + 30 + FlowOffX(n.NodeId)
           - (FlowIsEvent(n) ? (FlowEventSize - FlowEventOrigW(n)) / 2 : 0);
    private int FlowNodeTop(TaskFlowDiagramDto flow, TaskFlowNodeDto n)
        => (n.Y - flow.MinY) + 30 + FlowOffY(n.NodeId)
           - (FlowIsEvent(n) ? (FlowEventSize - FlowEventOrigH(n)) / 2 : 0);
    private int FlowCanvasW(TaskFlowDiagramDto flow) => flow.Nodes.Count == 0 ? 200 : flow.Nodes.Max(n => FlowNodeLeft(flow, n) + FlowNodeW(n)) + 20;
    private int FlowCanvasH(TaskFlowDiagramDto flow) => flow.Nodes.Count == 0 ? 140 : flow.Nodes.Max(n => FlowNodeTop(flow, n) + FlowNodeH(n)) + 20;

    private void FlowDragStart(TaskFlowNodeDto n, DragEventArgs e)
    {
        _flowDragNode = n.NodeId;
        _flowDragStartX = e.ClientX;
        _flowDragStartY = e.ClientY;
    }

    private void FlowDragEnd(DragEventArgs e)
    {
        if (_flowDragNode is not Guid id) { return; }
        // El canvas esta escalado por CSS zoom: el delta en pantalla se divide por el zoom.
        var z = _flowZoom <= 0 ? 1 : _flowZoom;
        var dx = (int)((e.ClientX - _flowDragStartX) / z);
        var dy = (int)((e.ClientY - _flowDragStartY) / z);
        var cur = _flowOffsets.TryGetValue(id, out var o) ? o : (dx: 0, dy: 0);
        _flowOffsets[id] = (cur.dx + dx, cur.dy + dy);
        _flowDragNode = null;
    }

    // Zoom del diagrama (CSS zoom sobre el canvas; el scroller reajusta las barras).
    private double _flowZoom = 1;
    private string FlowZoomStr => _flowZoom.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private void FlowZoomIn() => _flowZoom = Math.Min(1.6, Math.Round(_flowZoom + 0.15, 2));
    private void FlowZoomOut() => _flowZoom = Math.Max(0.5, Math.Round(_flowZoom - 0.15, 2));
    private void FlowZoomReset() => _flowZoom = 1;

    private static string FlowShortName(string? label)
    {
        if (string.IsNullOrWhiteSpace(label)) { return ""; }
        var at = label.IndexOf('@');
        var name = at > 0 ? label[..at] : label;
        return name.Length <= 16 ? name : name[..16] + "...";
    }

    private static string FlowShortDate(DateTimeOffset? d)
        => d is DateTimeOffset dt ? dt.ToLocalTime().ToString("dd MMM HH:mm") : "-";

    private static string FlowWaiting(DateTimeOffset? since)
    {
        if (since is not DateTimeOffset s) { return ""; }
        var span = DateTimeOffset.Now - s;
        if (span.TotalMinutes < 1) { return "recien"; }
        if (span.TotalHours < 1) { return $"{(int)span.TotalMinutes}m"; }
        if (span.TotalDays < 1) { return $"{(int)span.TotalHours}h"; }
        return $"{(int)span.TotalDays}d {span.Hours}h";
    }

    /// <summary>Path bezier del edge del borde derecho del origen al izquierdo del destino, usando el
    /// posicionamiento compactado y los tamanos de render. Devuelve el punto medio para la etiqueta.</summary>
    private (string D, int Sx, int Sy, int Tx, int Ty, int Lx, int Ly)? FlowEdgePath(TaskFlowDiagramDto flow, TaskFlowEdgeDto e)
    {
        var s = flow.Nodes.FirstOrDefault(n => n.NodeId == e.SourceNodeId);
        var t = flow.Nodes.FirstOrDefault(n => n.NodeId == e.TargetNodeId);
        if (s is null || t is null) { return null; }
        var sx = FlowNodeLeft(flow, s) + FlowNodeW(s); var sy = FlowNodeTop(flow, s) + FlowNodeH(s) / 2;
        var tx = FlowNodeLeft(flow, t); var ty = FlowNodeTop(flow, t) + FlowNodeH(t) / 2;
        var mx = (sx + tx) / 2;
        var d = $"M {sx} {sy} C {mx} {sy} {mx} {ty} {tx} {ty}";
        return (d, sx, sy, tx, ty, mx, (sy + ty) / 2 - 4);
    }

    // Posicion en pantalla (fixed) del menu de nodo abierto, para que NO lo recorte el scroller del diagrama.
    private int _flowMenuLeft;
    private int _flowMenuTop;

    private async Task ToggleFlowMenu(TaskFlowNodeDto n)
    {
        if (_flowMenuNodeId == n.NodeId)
        {
            _flowMenuNodeId = null;
