    // ==== Campos personalizados del tablero (ADR-0065) ====

    private void LoadCustomFieldValues(string? json)
    {
        _customValues.Clear();
        if (string.IsNullOrWhiteSpace(json)) { return; }
        try
        {
            var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string?>>(json);
            if (dict is not null)
            {
                foreach (var (k, v) in dict) { _customValues[k] = v; }
            }
        }
        catch (System.Text.Json.JsonException) { /* json invalido: se ignora */ }
    }

    private string GetCustomValue(string key) => _customValues.TryGetValue(key, out var v) ? v ?? "" : "";

    private void SetCustomValue(string key, string? value)
    {
        _customValues[key] = string.IsNullOrWhiteSpace(value) ? null : value;
        _customDirty = true;
        RecalcCustomCalculated();   // cualquier campo puede alimentar una formula
    }

    // Ancho del campo del tablero (rejilla de 12): Column 1 = 1/3 (col-md-4), 2 = 2/3 (col-md-8), 3 = completo.
    private static string CustomColClass(int column) => column switch
    {
        1 => "col-md-4",
        2 => "col-md-8",
        _ => "col-12",
    };

    private static DataLookupConfig? CustomLookupCfgOf(TaskFieldDto f) => DataLookupConfig.TryParse(f.Options);

    // Lista del Directorio: sin config valida (o sin perfil) igual funciona = todos los terceros.
    private static DirectoryLookupConfig CustomDirectoryCfgOf(TaskFieldDto f)
        => DirectoryLookupConfig.TryParse(f.Options) ?? new DirectoryLookupConfig();

    /// <summary>
    /// Rehace los calculados en memoria (aritmetica sobre unas pocas claves; no toca la BD). Reusa
    /// el motor compartido via el servicio, que resuelve las formulas del tablero de la tarea.
    /// </summary>
    private void RecalcCustomCalculated()
    {
        var hasCalc = _customFields.Any(f => f.FieldType == TerceroFieldType.Calculated && !string.IsNullOrWhiteSpace(f.Formula));
        if (!hasCalc || _detail?.Item.BoardId is not Guid boardId)
        {
            _customCalculated = new(StringComparer.Ordinal);
            return;
        }
        // Fire-and-forget seguro: la evaluacion es rapida y no bloquea el render; al volver, refresca.
        _ = RecalcCustomCalculatedAsync(boardId);
    }

    private async Task RecalcCustomCalculatedAsync(Guid boardId)
    {
        var snapshot = new Dictionary<string, string?>(_customValues, StringComparer.Ordinal);
        var result = await FieldSvc.ComputeCalculatedAsync(boardId, snapshot);
        _customCalculated = result.ToDictionary(x => x.Key, x => x.Value, StringComparer.Ordinal);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveCustomFieldsAsync()
    {
        if (_detail is null) { return; }
        _busy = true;
        _customError = null;
        try
        {
            var taskId = _detail.Item.Id;
            // Materializa los calculados antes de guardar (ADR-0029): reportes/API leen el numero sin
            // reimplementar el motor.
            if (_detail.Item.BoardId is Guid boardId)
            {
                var calc = await FieldSvc.ComputeCalculatedAsync(boardId, new Dictionary<string, string?>(_customValues, StringComparer.Ordinal));
                foreach (var (k, v) in calc) { _customValues[k] = v; }
            }
            // Solo persiste las claves que siguen siendo campos del tablero y tienen valor.
            var keys = _customFields.Select(f => f.FieldKey).ToHashSet(StringComparer.Ordinal);
            var dict = _customValues
                .Where(kv => keys.Contains(kv.Key) && !string.IsNullOrWhiteSpace(kv.Value))
                .ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.Ordinal);
            var payload = dict.Count == 0 ? null : System.Text.Json.JsonSerializer.Serialize(dict);

            var result = await TasksSvc.UpdateCustomFieldsAsync(taskId, payload, await ActorAsync(), await ActorNameAsync());
            if (!result.IsOk)
            {
                _customError = result.Error;
                await ReloadAsync(taskId);
                return;
            }
            _detail = result.Value;
            LoadCustomFieldValues(_detail!.CustomFieldsJson);
            _customDirty = false;
            RecalcCustomCalculated();
            await NotifyChangedAsync(_detail.Item.Id, _detail.Item.Status);
        }
        finally { _busy = false; }
    }

    private async Task SaveDueAsync()
    {
        if (_editDue is null)
        {
            await ApplyUpdateAsync(BuildUpdate(clearDue: true));
            return;
        }
        // ToUniversalTime: Npgsql solo acepta DateTimeOffset UTC en timestamptz.
        var due = new DateTimeOffset(_editDue.Value.Date.AddHours(23).AddMinutes(59), DateTimeOffset.Now.Offset).ToUniversalTime();
        await ApplyUpdateAsync(BuildUpdate(dueDate: due));
    }

    /// <summary>Guarda la fecha de INICIO (planificada) de la tarea. Con la fecha de entrega, define la
    /// barra del Gantt (inicio -> entrega). Granularidad de dia (el Gantt es por dias); la hora no aplica.</summary>
    private async Task SaveStartAsync()
    {
        _openMenu = null;
        if (_editStart is null)
        {
            await ApplyUpdateAsync(BuildUpdate(clearStart: true));
            return;
        }
        var start = new DateTimeOffset(_editStart.Value.Date.AddHours(8), DateTimeOffset.Now.Offset).ToUniversalTime();
        await ApplyUpdateAsync(BuildUpdate(startDate: start));
    }

