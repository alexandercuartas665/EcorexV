    /// <summary>Guardado UNICO de la caja combinada: si el cronometro tiene tiempo acumulado, se registra
    /// ese (Timer); si no, se usa el HH:MM manual. Un solo boton para ambos modos.</summary>
    private async Task SaveWorkLogAsync()
    {
        if (_detail is null) { return; }
        _workLogError = null;

        // El tiempo MANUAL (HH:MM que el usuario escribio) es AUTORITATIVO: si tecleo algo, se guarda eso.
        // El cronometro solo se usa cuando NO hay manual. Antes el cronometro (>0) tenia precedencia y un
        // valor acumulado/corriendo pisaba silenciosamente los minutos escritos (p.ej. 35m -> guardaba horas).
        var manualSeconds = (_manualHours ?? 0) * 3600 + (_manualMinutes ?? 0) * 60;
        int seconds;
        WorkLogKind kind;
        if (manualSeconds > 0)
        {
            seconds = manualSeconds;
            kind = WorkLogKind.Manual;
        }
        else
        {
            seconds = await JS.InvokeAsync<int>("ecorexTaskTimer.getSeconds");
            kind = WorkLogKind.Timer;
        }
        if (seconds <= 0)
        {
            _workLogError = "Inicia el cronometro o ingresa una duracion (HH:MM).";
            return;
        }

        await AddWorkLogAsync(seconds, _timerNote, kind);
        if (_workLogError is null)
        {
            if (kind == WorkLogKind.Timer)
            {
                await JS.InvokeVoidAsync("ecorexTaskTimer.reset");
                _timerRunning = false;
            }
            _manualHours = _manualMinutes = null;
            _timerNote = "";
        }
    }

    private async Task AddWorkLogAsync(int seconds, string note, WorkLogKind kind)
    {
        if (_detail is null) { return; }
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var tenantUser = _users.FirstOrDefault(u => u.PlatformUserId == actor);
            if (tenantUser is null)
            {
                _workLogError = "Tu usuario no pertenece al tenant (no se puede registrar tiempo).";
                return;
            }
            var result = await TasksSvc.AddWorkLogAsync(
                new AddTaskWorkLogRequest(_detail.Item.Id, tenantUser.Id, seconds,
                    string.IsNullOrWhiteSpace(note) ? null : note.Trim(), kind, LogActivity: true),
                actor, await ActorNameAsync());
            if (!result.IsOk)
            {
                _workLogError = result.Error;
                return;
            }
            await ReloadAsync(_detail.Item.Id);
            await NotifyChangedAsync(_detail!.Item.Id, _detail.Item.Status);
        }
        finally
        {
            _busy = false;
        }
    }

    // ===== Copiar datos del contacto (email/telefono/nombre) desde el Resumen =====

    // Boton pequeno "copiar" (icono de dos cuadritos) para comunicarse rapido con el contacto: copia el
    // valor al portapapeles y muestra "Copiado" ~1.4s en su lugar.
    private RenderFragment CopyButton(string? value, string title) => @<button type="button" title="@title"
            style="background:transparent;border:0;padding:2px;cursor:pointer;display:inline-flex;align-items:center;color:var(--ink-3, var(--muted-foreground));flex:none;"
            @onclick="() => CopyContactAsync(value)">
        @if (_copiedValue == value && !string.IsNullOrEmpty(value))
        {
            <span style="font-size:11px;font-weight:700;color:var(--ok,#0f766e);white-space:nowrap;">Copiado</span>
        }
        else
        {
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        }
    </button>;

    private async Task CopyContactAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) { return; }
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", value); } catch { /* portapapeles bloqueado */ }
        _copiedValue = value;
        _ = ClearCopiedAsync(value);
    }

    private async Task ClearCopiedAsync(string value)
    {
        await Task.Delay(1400);
        if (_copiedValue == value) { _copiedValue = null; await InvokeAsync(StateHasChanged); }
    }

    // ===== Comentarios y adjuntos =====

    // ===== Bitacora enriquecida: adjuntos en el comentario + mencion de usuarios =====
    private sealed record CommentAtt(string Url, string Name, bool IsImage);
    private readonly List<CommentAtt> _commentAtts = new();
    private bool _commentUploading;
    private bool _mentionOpen;
    private string? _commentError;

    private async Task AddCommentAsync()
    {
        if (_detail is null) { return; }
        if (string.IsNullOrWhiteSpace(_newComment) && _commentAtts.Count == 0) { return; }
        _busy = true;
        try
        {
            // El texto lleva las URLs de los adjuntos (una por linea); el render de la Bitacora las
            // convierte en preview de imagen o enlace de archivo. Los adjuntos YA estan en Documentos.
            var text = (_newComment ?? string.Empty).Trim();
            if (_commentAtts.Count > 0)
            {
                var urls = string.Join("\n", _commentAtts.Select(a => a.Url));
                text = string.IsNullOrEmpty(text) ? urls : text + "\n" + urls;
            }
            var result = await TasksSvc.AddCommentAsync(_detail.Item.Id, text, await ActorAsync(), await ActorNameAsync());
            if (result.IsOk)
            {
                _newComment = "";
                _commentAtts.Clear();
                _mentionOpen = false;
                _commentError = null;
                await ReloadAsync(_detail.Item.Id);
            }
            else { _actionError = result.Error; }
        }
        finally { _busy = false; }
    }

    /// <summary>Adjunta imagen(es)/archivo(s) al comentario: sube CADA uno (queda en Documentos via
    /// AddAttachment) y lo apila para enviarse con el comentario (preview inline en la Bitacora).</summary>
    private async Task OnCommentFilesAsync(InputFileChangeEventArgs e)
    {
        if (_detail is null) { return; }
        _commentError = null; _commentUploading = true; _busy = true;
        var errores = new List<string>();
        try
        {
            var actor = await ActorAsync();
            var actorName = await ActorNameAsync();
            foreach (var file in e.GetMultipleFiles(10))
            {
                var saved = await StoreAttachmentAsync(file, errores);
                if (saved is null) { continue; }
                var name = RecortarNombreAtt(file.Name);
                var result = await TasksSvc.AddAttachmentAsync(
                    new AddTaskAttachmentRequest(_detail.Item.Id, name, saved.Value.Url, saved.Value.ContentType, saved.Value.Size),
                    actor, actorName);
                if (!result.IsOk) { errores.Add(result.Error ?? $"No se pudo registrar {file.Name}."); continue; }
                _commentAtts.Add(new CommentAtt(saved.Value.Url, name, IsImageUrl(saved.Value.Url)));
            }
            await ReloadAsync(_detail.Item.Id); // refresca el tab Documentos
        }
        catch (InvalidOperationException) { errores.Add("Solo se pueden adjuntar 10 archivos a la vez."); }
        finally { _commentUploading = false; _busy = false; if (errores.Count > 0) { _commentError = string.Join(" ", errores); } }
    }

    /// <summary>Inserta una mencion "@Usuario" en el comentario.</summary>
    private void InsertMention(TenantUserDto u)
    {
        var handle = "@" + TaskUi.UserLabel(u);
        _newComment = string.IsNullOrWhiteSpace(_newComment) ? handle + " " : _newComment.TrimEnd() + " " + handle + " ";
        _mentionOpen = false;
    }

    private static bool IsImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) { return false; }
        var u = url.Split('?')[0].ToLowerInvariant();
        return u.EndsWith(".png") || u.EndsWith(".jpg") || u.EndsWith(".jpeg") || u.EndsWith(".gif") || u.EndsWith(".webp") || u.EndsWith(".bmp");
    }

    /// <summary>Separa un comentario en texto + adjuntos (lineas que son URLs), para el render de la Bitacora.</summary>
    private static (string Text, List<(string Url, string Name, bool IsImage)> Atts) ParseComment(string? raw)
    {
        var atts = new List<(string, string, bool)>();
        if (string.IsNullOrEmpty(raw)) { return (string.Empty, atts); }
        var textLines = new List<string>();
        foreach (var line in raw.Split('\n'))
        {
            var t = line.Trim();
            if (t.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)
                || t.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                || t.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            {
                var name = System.IO.Path.GetFileName(t.Split('?')[0]);
                atts.Add((t, string.IsNullOrEmpty(name) ? t : name, IsImageUrl(t)));
            }
            else { textLines.Add(line); }
        }
        return (string.Join("\n", textLines).Trim(), atts);
    }

    private async Task OnAttachFilesAsync(InputFileChangeEventArgs e)
    {
        if (_detail is null) { return; }
        _attError = null;
        _attDragOver = false;
        _attUploading = true;
        _busy = true;
        var errores = new List<string>();
        try
        {
            var actor = await ActorAsync();
            var actorName = await ActorNameAsync();
            foreach (var file in e.GetMultipleFiles(10))
            {
                var saved = await StoreAttachmentAsync(file, errores);
                if (saved is null) { continue; }
                var result = await TasksSvc.AddAttachmentAsync(
                    new AddTaskAttachmentRequest(_detail.Item.Id, RecortarNombreAtt(file.Name), saved.Value.Url, saved.Value.ContentType, saved.Value.Size),
                    actor, actorName);
                if (!result.IsOk) { errores.Add(result.Error ?? $"No se pudo registrar {file.Name}."); }
            }
            await ReloadAsync(_detail.Item.Id);
        }
        catch (InvalidOperationException)
        {
            errores.Add("Solo se pueden subir 10 archivos a la vez.");
        }
        finally
        {
            _attUploading = false;
            _busy = false;
            if (errores.Count > 0) { _attError = string.Join(" ", errores); }
        }
    }

    // Guarda el archivo en wwwroot/uploads/tasks/{tenant}/{guid}.{ext} (mismo patron que Inventario)
    // y devuelve (url, tamano, contentType). Valida extension (lista blanca) y tamano; carpeta por
    // tenant + nombre Guid = aislamiento total entre tenants.
    private async Task<(string Url, long Size, string? ContentType)?> StoreAttachmentAsync(IBrowserFile file, List<string> errores)
    {
        if (TenantCtx.TenantId is not Guid tenantId) { errores.Add("Sin tenant activo."); return null; }
        // Se admite CUALQUIER tipo de archivo (documentacion .html, prototipos .vsdx, binarios): la seguridad
        // la da el SERVIDO (Content-Disposition: attachment + nosniff para todo lo no inline-seguro, ver
        // Program.cs), NO una lista blanca de extensiones. Solo se conserva el limite de tamano.
        var ext = Path.GetExtension(file.Name);
        var cap = VideoExt.Contains(ext) ? MaxVideoBytes : MaxAttBytes;
        if (file.Size > cap)
        {
            errores.Add($"{file.Name}: supera {cap / (1024 * 1024)} MB.");
            return null;
        }
        try
        {
            var dir = Path.Combine(Env.WebRootPath, "uploads", "tasks", tenantId.ToString("N"));
            Directory.CreateDirectory(dir);
            var stored = $"{Guid.NewGuid():N}{ext.ToLowerInvariant()}";
            await using var srcStream = file.OpenReadStream(cap);
            await using (var dst = File.Create(Path.Combine(dir, stored)))
            {
                await srcStream.CopyToAsync(dst);
            }
            return ($"/uploads/tasks/{tenantId:N}/{stored}", file.Size,
                    string.IsNullOrWhiteSpace(file.ContentType) ? null : file.ContentType);
        }
        catch (Exception)
        {
            errores.Add($"{file.Name}: error al guardar.");
            return null;
        }
    }

    private static string RecortarNombreAtt(string name)
    {
        var n = (name ?? "archivo").Trim();
        return n.Length > 180 ? n[..180] : n;
    }

    private async Task AddAttachmentAsync()
    {
        if (_detail is null) { return; }
        _attError = null;
        if (string.IsNullOrWhiteSpace(_attName) || string.IsNullOrWhiteSpace(_attUrl))
        {
            _attError = "Nombre y URL son obligatorios.";
            return;
        }
        if (!Uri.TryCreate(_attUrl.Trim(), UriKind.Absolute, out _))
        {
            _attError = "La URL no es valida.";
            return;
        }
        _busy = true;
        try
        {
            var result = await TasksSvc.AddAttachmentAsync(
                new AddTaskAttachmentRequest(_detail.Item.Id, _attName.Trim(), _attUrl.Trim(), null, 0),
                await ActorAsync(), await ActorNameAsync());
            if (!result.IsOk)
            {
                _attError = result.Error;
                return;
            }
            _attName = _attUrl = "";
            await ReloadAsync(_detail.Item.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAttachmentAsync(Guid attachmentId)
    {
        if (_detail is null) { return; }
        _busy = true;
        try
        {
            await TasksSvc.DeleteAttachmentAsync(attachmentId);
            await ReloadAsync(_detail.Item.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NotifyChangedAsync(Guid taskId, TaskItemStatus status)
    {
        if (await TenantIdAsync() is Guid tenantId)
        {
            await Broadcaster.TaskChangedAsync(tenantId, taskId, status);
        }
        await OnChanged.InvokeAsync();
    }

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task<string> ActorNameAsync()
    {
        if (AuthState is null) { return "Usuario"; }
        var st = await AuthState;
        return st.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
    }

    private async Task<Guid?> TenantIdAsync()
    {
        if (AuthState is null) { return null; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out var id) ? id : null;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ecorexTaskTimer.reset"); } catch { /* circuito cerrado */ }
    }
