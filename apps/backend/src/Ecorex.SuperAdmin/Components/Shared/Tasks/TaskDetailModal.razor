    private async Task AttachTagAsync(Guid tagId)
    {
        if (_detail is null) { return; }
        _busy = true;
        _actionError = null;
        try
        {
            var result = await TasksSvc.AttachTagAsync(_detail.Item.Id, tagId);
            // El servicio es el guardian de la restriccion por columna: si rechaza, se muestra el
            // motivo (p.ej. la etiqueta no esta permitida en la columna actual).
            if (!result.IsOk) { _actionError = result.Error; return; }
            _tagMenuOpen = false;
            // Actualizacion LOCAL de las etiquetas, sin recargar todo el detalle. Un ReloadAsync
            // aqui reejecuta GetDetailAsync (6+ consultas contra la BD, por tunel en dev) SOLO para
            // reflejar una etiqueta; ademas era donde se disparaba el fallo de render. La etiqueta ya
            // se guardo; basta reflejarla en el DTO en memoria.
            AplicarEtiquetas(AgregarTag(tagId));
            await NotifyChangedAsync(_detail!.Item.Id, _detail.Item.Status);
        }
        finally { _busy = false; }
    }

