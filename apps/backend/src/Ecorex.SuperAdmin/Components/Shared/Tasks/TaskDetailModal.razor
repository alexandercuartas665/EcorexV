    // Extension en mayusculas (para el icono/etiqueta del documento sin miniatura).
    private static string AttExt(TaskItemAttachmentDto att)
    {
        var name = att.FileName ?? "";
        var dot = name.LastIndexOf('.');
        var ext = dot >= 0 && dot < name.Length - 1 ? name[(dot + 1)..] : "";
        return string.IsNullOrWhiteSpace(ext) ? "DOC" : ext.ToUpperInvariant();
    }

    // Es imagen (por MimeType o por extension) -> se puede pintar miniatura/preview directo.
    private static bool IsImageAtt(TaskItemAttachmentDto att)
    {
        if (!string.IsNullOrEmpty(att.MimeType) && att.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            return true;
        return AttExt(att) is "PNG" or "JPG" or "JPEG" or "GIF" or "WEBP" or "BMP" or "SVG" or "AVIF";
    }

    // Es PDF -> se puede embeber en un iframe para vista previa.
    private static bool IsPdfAtt(TaskItemAttachmentDto att)
    {
        if (!string.IsNullOrEmpty(att.MimeType) && att.MimeType.Contains("pdf", StringComparison.OrdinalIgnoreCase))
            return true;
        return AttExt(att) == "PDF";
    }

    // Tamano legible del archivo para las tarjetas de la galeria.
    private static string FormatSize(long bytes)
    {
        if (bytes <= 0) return "-";
        string[] u = { "B", "KB", "MB", "GB", "TB" };
        double v = bytes; int i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return i == 0 ? $"{(long)v} {u[i]}" : $"{v:0.#} {u[i]}";
    }

