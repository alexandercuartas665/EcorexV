    /// <summary>Abre una cotizacion en el modal editor. Editable solo si es borrador y la tarea NO esta cerrada.</summary>
    private void OpenConceptForm(TaskConceptFormItemDto it)
    {
        if (_conceptForms is null || _detail is null) { return; }
        var taskClosed = _detail.Item.Status == TaskItemStatus.Closed;
        var finalized = it.Status == FormResponseStatus.Submitted;
        var mode = (!taskClosed && !finalized) ? FormRenderMode.Fill : FormRenderMode.ReadOnly;
        var title = _conceptForms.FormTitle + (string.IsNullOrWhiteSpace(it.Titulo) ? "" : $" - {it.Titulo}");
        _openForm = new OpenFormState(_conceptForms.DefinitionId, it.ResponseId, it.Reference, title, mode, IsStep: false, Step: null);
    }

    /// <summary>"Agregar cotizacion": crea un borrador nuevo y lo abre para diligenciar.</summary>
    private async Task AddConceptFormAsync()
    {
        if (_detail is null || _busy) { return; }
        _busy = true;
        try
        {
            var res = await FormResponsesSvc.CreateTaskConceptFormAsync(_detail.Item.Id);
            if (res.IsOk && res.Value is not null)
            {
                await ReloadAsync(_detail.Item.Id);
                var created = _conceptForms?.Items.FirstOrDefault(x => x.ResponseId == res.Value.ResponseId);
                if (created is not null) { OpenConceptForm(created); }
            }
        }
        finally { _busy = false; }
    }

