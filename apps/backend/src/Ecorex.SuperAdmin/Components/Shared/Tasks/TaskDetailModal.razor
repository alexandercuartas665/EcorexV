    /// <summary>Estilo de la tarjeta de un nodo Task: barra de acento SIEMPRE y, si el nodo tiene color
    /// CONFIGURADO en el editor, un tinte suave para que ese color se vea claro (no una linea fina).</summary>
    private static string FlowNodeCardStyle(TaskFlowNodeDto n, string accent, bool isGw, bool isEvent)
