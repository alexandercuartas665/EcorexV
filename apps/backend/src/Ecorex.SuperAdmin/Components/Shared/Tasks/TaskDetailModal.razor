@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Ecorex.Application.Forms
@using Ecorex.Application.Forms.Lookups
@using Ecorex.Application.Tenancy
@using Ecorex.Application.Workflows
@using Ecorex.Application.DataLookups
@using Ecorex.Domain.Enums
@using Ecorex.Domain.Rules
@using Ecorex.SuperAdmin.Components.Shared.Forms
@using Ecorex.SuperAdmin.Components.Shared.Lookups
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject ITaskItemService TasksSvc
@inject ITaskFieldService FieldSvc
@inject IDataLookupService LookupSvc
@inject ITenantUserService TenantUsersSvc
@inject IActivityTypeService TypesSvc
@inject IProjectService ProjectsSvc
@inject IActivityBoardService BoardsSvc
@inject IFormResponseService FormResponsesSvc
@inject IWorkflowInboxService InboxSvc
@inject ITaskBroadcaster Broadcaster
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject Ecorex.Application.Common.ITenantContext TenantCtx

@if (_detail is not null)
{
    var item = _detail.Item;
    var readOnly = item.Status == TaskItemStatus.Closed;
    var targets = TaskItemStateMachine.AllowedTargets(item.Status);
    @* El fondo NO cierra la tarea: un click o arrastre accidental afuera la cerraba (muy molesto al
       diligenciar/dibujar). Se cierra solo con el boton X (tb-modal-close). *@
    <div class="modal-overlay" style="overscroll-behavior:contain">
        <div class="tk-detail tk-detail-tabbed @(_flowDiagram is not null ? "tk-detail-flow" : "")" @onclick="CloseMenus">
            @* ===== Hero: numero + titulo + meta pills ===== *@
            <div class="tk-detail-head">
                <div class="tk-detail-head-main">
                    <div class="tk-detail-number">
                        @item.Number
                        @if (item.IsArchived)
                        {
                            <span class="tk-status st-closed" style="margin-left:8px;">Archivada</span>
                        }
                    </div>
                    @if (_editingTitle && !readOnly)
                    {
                        <div>
                            <input class="form-control tk-detail-title-input" @bind="_editTitle" maxlength="200" />
                            <div style="margin-top:8px;display:flex;gap:8px;">
                                <button class="btn btn-sm btn-primary" @onclick="SaveTitleAsync" disabled="@_busy">Guardar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _editingTitle = false)">Cancelar</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <h2 class="tk-detail-title" style="@(string.IsNullOrEmpty(item.Color) ? "" : $"border-left:4px solid {item.Color};padding-left:10px;")"
                            @onclick="@(() => { if (!readOnly) { _editingTitle = true; _editTitle = item.Title; } })"
                            title="@(readOnly ? "Tarea cerrada (solo lectura)" : "Clic para editar el titulo")">@item.Title</h2>
                    }
                </div>
                <button class="tb-modal-close" @onclick="CloseAsync" aria-label="Cerrar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            @if (_conflict is not null)
            {
                <div class="tk-conflict">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    <span>Otro usuario modifico la tarea. Se recargo el detalle con los datos mas recientes.</span>
                    <button class="tk-conflict-x" @onclick="@(() => _conflict = null)">&times;</button>
                </div>
            }
            @if (_actionError is not null)
            {
                <div class="tk-conflict tk-action-error">
                    <span>@_actionError</span>
                    <button class="tk-conflict-x" @onclick="@(() => _actionError = null)">&times;</button>
                </div>
            }
            @if (_reloadError is not null && _detail is not null)
            {
                <div class="tk-conflict tk-action-error">
                    <span>@_reloadError</span>
                    <button class="btn btn-xs" @onclick="@(() => ReloadAsync(_detail!.Item.Id))" disabled="@_busy">Reintentar</button>
                    <button class="tk-conflict-x" @onclick="@(() => _reloadError = null)">&times;</button>
                </div>
            }
            @if (_moveNote is not null)
            {
                <div class="tk-conflict tk-move-note">
                    <span>@_moveNote</span>
                    <button class="tk-conflict-x" @onclick="@(() => _moveNote = null)">&times;</button>
                </div>
            }
            @* Prompt de motivo de cierre (opcional) al mover a una columna final del tablero. *@
            @if (_pendingCloseColumn is not null)
            {
                <div class="tk-closeask-overlay" @onclick="@(() => _pendingCloseColumn = null)" @onclick:stopPropagation="true">
                    <div class="tk-closeask" @onclick:stopPropagation="true">
                        <div class="tk-closeask-h">Motivo de cierre <span>(opcional)</span></div>
                        <p class="tk-closeask-sub">Vas a mover la tarea a <strong>@_pendingCloseColumn.Name</strong>. Elige un motivo o ciérrala sin motivo.</p>
                        <div class="tk-closeask-opts">
                            @foreach (var motivo in _closeReasons)
                            {
                                var m = motivo;
                                <button class="tk-closeask-opt" @onclick="@(() => ConfirmCloseAsync(m))" disabled="@_busy">@m</button>
                            }
                        </div>
                        <div class="tk-closeask-foot">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _pendingCloseColumn = null)" disabled="@_busy">Cancelar</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => ConfirmCloseAsync(null))" disabled="@_busy">Cerrar sin motivo</button>
                        </div>
                    </div>
                </div>
            }

            <div class="tk-detail-pills" @onclick:stopPropagation="true">
                @* Encargado *@
                <div class="tk-pill-anchor">
                    <button class="tk-pill" @onclick="@(() => ToggleMenu("assignee"))" disabled="@readOnly" title="Reasignar encargado">
                        <span class="tb-avatar">@TaskUi.InitialsOf(AssigneeEmail(item.AssigneeTenantUserId))</span>
                        <span>@(AssigneeEmail(item.AssigneeTenantUserId) ?? "Sin asignar")</span>
                    </button>
                    @if (_openMenu == "assignee")
                    {
                        <div class="tk-pill-pop">
                            <button class="tk-pill-item" @onclick="@(() => AssignAsync(null))">Sin asignar</button>
                            @foreach (var u in _users)
                            {
                                <button class="tk-pill-item @(item.AssigneeTenantUserId == u.Id ? "on" : "")" @onclick="@(() => AssignAsync(u.Id))">@TaskUi.UserLabel(u)</button>
                            }
                        </div>
                    }
                </div>

                @* Fecha inicio (planificada, para pintar la barra del Gantt junto con la fecha de entrega) *@
                <div class="tk-pill-anchor">
                    <button class="tk-pill" @onclick="@(() => ToggleMenu("start"))" disabled="@readOnly" title="Fecha de inicio (para el Gantt)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
                        <span>@(item.StartDate is null ? "Inicio" : TaskUi.FormatDue(item.StartDate.Value))</span>
                    </button>
                    @if (_openMenu == "start")
                    {
                        <div class="tk-pill-pop" style="padding:12px;">
                            <input type="date" class="form-control" @bind="_editStart" />
                            <div style="display:flex;gap:6px;margin-top:8px;">
                                <button class="btn btn-sm btn-primary" @onclick="SaveStartAsync" disabled="@_busy">Guardar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="@(async () => { _editStart = null; await SaveStartAsync(); })" disabled="@_busy">Quitar</button>
                            </div>
                        </div>
                    }
                </div>

                @* Fecha entrega *@
                <div class="tk-pill-anchor">
                    <button class="tk-pill @(TaskUi.IsOverdue(item.DueDate, item.Status) ? "late" : "")" @onclick="@(() => ToggleMenu("due"))" disabled="@readOnly" title="Cambiar fecha de entrega">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <span>@(item.DueDate is null ? "Sin fecha" : TaskUi.FormatDue(item.DueDate.Value))</span>
                    </button>
                    @if (_openMenu == "due")
                    {
                        <div class="tk-pill-pop" style="padding:12px;">
                            <input type="date" class="form-control" @bind="_editDue" />
                            <div style="display:flex;gap:6px;margin-top:8px;">
                                <button class="btn btn-sm btn-primary" @onclick="SaveDueAsync" disabled="@_busy">Guardar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="@(async () => { _editDue = null; await SaveDueAsync(); })" disabled="@_busy">Quitar</button>
                            </div>
                        </div>
                    }
                </div>

                @* Tiempo usado (read-only) *@
                <span class="tk-pill static" title="Tiempo total registrado en el worklog">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>@TaskUi.FormatDuration(_totalSeconds)</span>
                </span>

                @* Prioridad *@
                <div class="tk-pill-anchor">
                    <button class="tk-pill" @onclick="@(() => ToggleMenu("priority"))" disabled="@readOnly" title="Cambiar prioridad">
                        <PriorityChip Priority="item.Priority" />
                    </button>
                    @if (_openMenu == "priority")
                    {
                        <div class="tk-pill-pop">
                            @foreach (var p in new[] { TaskPriority.High, TaskPriority.Medium, TaskPriority.Low })
                            {
                                <button class="tk-pill-item @(item.Priority == p ? "on" : "")" @onclick="@(() => SavePriorityAsync(p))"><PriorityChip Priority="p" /></button>
                            }
                        </div>
                    }
                </div>

                @* Estado (solo transiciones validas) *@
                <div class="tk-pill-anchor">
                    <button class="tk-pill" @onclick="@(() => ToggleMenu("status"))" disabled="@(targets.Count == 0)" title="@(targets.Count == 0 ? "La tarea esta cerrada (solo lectura)" : "Cambiar estado")">
                        <span class="tk-status @TaskUi.StatusClass(item.Status)">@TaskUi.StatusLabel(item.Status)</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px;"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    @if (_openMenu == "status")
                    {
                        <div class="tk-pill-pop">
                            @foreach (var s in targets)
                            {
                                <button class="tk-pill-item" @onclick="@(() => ChangeStatusAsync(s))"><span class="tk-status @TaskUi.StatusClass(s)">@TaskUi.StatusLabel(s)</span></button>
                            }
                        </div>
                    }
                </div>

                @* Mover a: columna del tablero de actividades (ADR-0020, ola 2) *@
                @if (item.BoardId is not null && _boardColumns.Count > 0)
                {
                    <div class="tk-pill-anchor">
                        <button class="tk-pill tk-moveto" @onclick="@(() => ToggleMenu("moveto"))" disabled="@readOnly" title="Mover a otra columna del tablero">
                            <span style="color:var(--ink-3, var(--muted-foreground));">Mover a:</span>
                            <span style="display:inline-flex;align-items:center;gap:6px;font-weight:600;">
                                <span style="width:8px;height:8px;border-radius:50%;flex:none;background:@CurrentColumnDot()"></span>
                                @(CurrentColumnName() ?? "Sin columna")
                            </span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px;"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        @if (_openMenu == "moveto")
                        {
                            <div class="tk-pill-pop">
                                @foreach (var (col, idx) in _boardColumns.Select((c, i) => (c, i)))
                                {
                                    var target = col;
                                    var dotColor = AbUi.ColumnDot(idx);
                                    <button class="tk-pill-item @(item.ColumnId == target.Id ? "on" : "")" @onclick="@(() => MoveToColumnAsync(target))">
                                        <span style="width:8px;height:8px;border-radius:50%;flex:none;background:@dotColor;margin-right:6px;"></span>@target.Name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                <span style="flex:1;"></span>

                @* Acciones rapidas *@
                @if (item.Status == TaskItemStatus.Suspended)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => ChangeStatusAsync(TaskItemStatus.InProgress))" disabled="@_busy">Reanudar</button>
                }
                else if (TaskItemStateMachine.CanTransition(item.Status, TaskItemStatus.Suspended))
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => ChangeStatusAsync(TaskItemStatus.Suspended))" disabled="@_busy">Suspender</button>
                }
                @if (TaskItemStateMachine.CanTransition(item.Status, TaskItemStatus.Closed))
                {
                    @if (_confirmClose)
                    {
                        <span class="tk-confirm">
                            Cerrar definitivamente?
                            <button class="btn btn-sm btn-outline-danger" @onclick="@(() => ChangeStatusAsync(TaskItemStatus.Closed))" disabled="@_busy">Si, cerrar</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _confirmClose = false)">No</button>
                        </span>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => _confirmClose = true)" disabled="@_busy">Cerrar</button>
                    }
                }
                @* Archivado = visibilidad (no transicion de estado): permitido incluso en Closed. *@
                @if (item.IsArchived)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RestoreAsync" disabled="@_busy" title="Devuelve la tarea a los listados">Restaurar</button>
                }
                else if (_confirmArchive)
                {
                    <span class="tk-confirm">
                        Archivar la tarea?
                        <button class="btn btn-sm btn-outline-danger" @onclick="ArchiveAsync" disabled="@_busy">Si, archivar</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _confirmArchive = false)">No</button>
                    </span>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _confirmArchive = true)" disabled="@_busy" title="Saca la tarea de los listados sin perder su historia">Archivar</button>
                }
            </div>

            @* ===== FLUJO DEL PROCESO (ADR-0051): solo si la tarea viene de un flujo ===== *@
            @if (_flowDiagram is TaskFlowDiagramDto flow)
            {
                var abandonedIds = flow.Nodes.Where(x => x.IsAbandoned).Select(x => x.NodeId).ToHashSet();
                <div class="tk-flow-card">
                    <div class="tk-flow-cardhead">
                        <div>
                            <div class="tk-flow-name">@flow.FlowName</div>
                            <div class="tk-flow-hint">Abre el menu de un nodo para anotar o cerrar. Solo el paso actual asignado a ti es cerrable, y en orden.</div>
                        </div>
                        <div class="tk-flow-headright">
                            <div class="tk-flow-legend">
                                <span><span class="tk-flow-key" style="background:var(--t-blue)"></span>Automatico</span>
                                <span><span class="tk-flow-key" style="background:var(--t-violet)"></span>Manual</span>
                                <span><span class="tk-flow-key" style="background:var(--t-green)"></span>Cerrado</span>
                            </div>
                            <div class="tk-flow-zoom">
                                <button class="tk-flow-zbtn" title="Alejar" @onclick="FlowZoomOut">&#8722;</button>
                                <span class="tk-flow-zval">@((int)Math.Round(_flowZoom * 100))%</span>
                                <button class="tk-flow-zbtn" title="Acercar" @onclick="FlowZoomIn">&#43;</button>
                                <button class="tk-flow-zbtn" title="Restablecer zoom" @onclick="FlowZoomReset">&#10530;</button>
                            </div>
                        </div>
                    </div>
                    <div class="tk-flow-scroller">
                        @* Clic en el fondo del diagrama CIERRA el menu de nodo abierto (los nodos hacen
                           stopPropagation, asi que su clic no llega aqui). Evita que el menu quede "abierto siempre". *@
                        <div class="tk-flow-canvas" style="width:@(FlowCanvasW(flow))px;height:@(FlowCanvasH(flow))px;zoom:@FlowZoomStr"
                             @onclick="@(() => _flowMenuNodeId = null)">
                            <svg class="tk-flow-edges" width="@(FlowCanvasW(flow))" height="@(FlowCanvasH(flow))">
                                <defs>
                                    <marker id="tkflowarrow" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 z" fill="var(--ink-3)" /></marker>
                                    <marker id="tkflowarrow-a" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 z" fill="var(--t-green, #16a34a)" /></marker>
                                    <marker id="tkflowarrow-r" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 z" fill="var(--t-rose, #dc2626)" /></marker>
                                </defs>
                                @foreach (var e in flow.Edges)
                                {
                                    var p = FlowEdgePath(flow, e);
                                    if (p is null) { continue; }
                                    @* Rama DESCARTADA (compuerta tomo otra ruta): arista en gris punteado. *@
                                    var isAband = abandonedIds.Contains(e.TargetNodeId) || abandonedIds.Contains(e.SourceNodeId);
                                    var stroke = isAband ? "var(--line-2)" : FlowEdgeStroke(e.Kind);
                                    <path d="@p.Value.D" fill="none" stroke="@stroke" stroke-width="2" stroke-dasharray="@(isAband ? "4 4" : null)" marker-end="url(#@(isAband ? "tkflowarrow" : FlowEdgeMarker(e.Kind)))" opacity="@(isAband ? "0.55" : "1")" />
                                    <circle cx="@p.Value.Sx" cy="@p.Value.Sy" r="3.5" fill="@stroke" opacity="@(isAband ? "0.55" : "1")" />
                                    <circle cx="@p.Value.Tx" cy="@p.Value.Ty" r="3.5" fill="@stroke" opacity="@(isAband ? "0.55" : "1")" />
                                }
                            </svg>
                            @* Etiquetas de aristas condicionales como divs (evita el choque de <text> con Razor). *@
                            @foreach (var e in flow.Edges)
                            {
                                if (!e.IsCondition || string.IsNullOrWhiteSpace(e.Label)) { continue; }
                                var p = FlowEdgePath(flow, e);
                                if (p is null) { continue; }
                                <div class="tk-flow-elabel" style="left:@(p.Value.Lx)px;top:@(p.Value.Ly)px">@e.Label</div>
                            }
                            @foreach (var n in flow.Nodes)
                            {
                                var nn = n;
                                var isGw = nn.NodeType == WorkflowNodeType.ExclusiveGateway;
                                var isEvent = nn.NodeType is WorkflowNodeType.StartEvent or WorkflowNodeType.EndEvent;
                                @* Puede accionar el paso vigente: el asignado, o un OWNER/ADMIN (gobierna el flujo).
                                   Incluye pasos CON formulario: se pueden cerrar directo (el formulario es opcional). *@
                                var canAct = nn.IsCurrent && nn.StepId is not null && nn.IsMine;
                                // Color configurado del nodo (editor de flujos) si lo tiene; si no, azul (auto) / violeta.
                                var accent = FlowNodeColor(nn.Color) ?? (nn.IsAuto ? "var(--t-blue)" : "var(--t-violet)");
                                <div class="tk-flow-node @(isGw ? "gw" : "") @(isEvent ? "ev" : "") @(nn.State == TaskFlowNodeState.Completed ? "done" : "") @(nn.IsCurrent ? "current" : "") @(nn.IsAbandoned ? "abandoned" : "") @(_flowDragNode == nn.NodeId ? "dragging" : "")"
                                     style="left:@(FlowNodeLeft(flow, nn))px;top:@(FlowNodeTop(flow, nn))px;width:@(FlowNodeW(nn))px;height:@(FlowNodeH(nn))px;@FlowNodeCardStyle(nn, accent, isGw, isEvent)"
                                     draggable="true"
                                     @ondragstart="@(e => FlowDragStart(nn, e))" @ondragstart:stopPropagation="true"
                                     @ondragend="FlowDragEnd" @ondragend:stopPropagation="true"
                                     @onclick:stopPropagation="true">
                                    @if (isGw)
                                    {
                                        @* Color configurado del nodo (si lo tiene) en el borde del diamante. *@
                                        <div class="tk-flow-gw" style="@(FlowNodeColor(nn.Color) is string gc ? $"border-color:{gc};border-width:2px;background:color-mix(in srgb, {gc} 16%, var(--surface));" : "")"></div>
                                        <button class="tk-flow-dots tk-flow-gw-dots" title="Ver paso" data-flow-anchor="@nn.NodeId" @onclick="@(() => ToggleFlowMenu(nn))">&#8943;</button>
                                        @if (nn.TeamNotes is { Count: > 0 } gwn) { <span class="tk-flow-notecount" title="@(gwn.Count) nota(s) del equipo">&#128172; @gwn.Count</span> }
                                        @if (!string.IsNullOrWhiteSpace(nn.Name))
                                        {
                                            <div style="position:absolute;top:100%;left:50%;transform:translateX(-50%);margin-top:3px;font-size:11px;line-height:1.2;text-align:center;white-space:nowrap;color:var(--ink-2);font-weight:600;pointer-events:none;">@nn.Name</div>
                                        }
                                    }
                                    else if (isEvent)
                                    {
                                        @* Color configurado del nodo (si lo tiene) en el aro del evento. *@
                                        <div class="tk-flow-ev-dot @(nn.NodeType == WorkflowNodeType.EndEvent ? "end" : "")" style="@(FlowNodeColor(nn.Color) is string ec ? $"border-color:{ec};background:color-mix(in srgb, {ec} 18%, var(--surface));" : "")"></div>
                                        <button class="tk-flow-dots tk-flow-gw-dots" title="Ver paso" data-flow-anchor="@nn.NodeId" @onclick="@(() => ToggleFlowMenu(nn))">&#8943;</button>
                                        @if (nn.TeamNotes is { Count: > 0 } gwn) { <span class="tk-flow-notecount" title="@(gwn.Count) nota(s) del equipo">&#128172; @gwn.Count</span> }
                                        @if (!string.IsNullOrWhiteSpace(nn.Name))
                                        {
                                            <div style="position:absolute;top:100%;left:50%;transform:translateX(-50%);margin-top:3px;font-size:11px;line-height:1.2;text-align:center;white-space:nowrap;color:var(--ink-2);font-weight:600;pointer-events:none;">@nn.Name</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="tk-flow-node-body">
                                            <div class="tk-flow-node-title">
                                                <span class="tk-flow-node-name">@(nn.Name ?? "(paso)")</span>
                                                <button class="tk-flow-dots" title="Menu del paso" data-flow-anchor="@nn.NodeId" @onclick="@(() => ToggleFlowMenu(nn))">&#8943;</button>
                                            </div>
                                            <div class="tk-flow-meta">
                                                @if (!string.IsNullOrWhiteSpace(nn.CargoLabel) || !string.IsNullOrWhiteSpace(nn.AssigneeLabel))
                                                {
                                                    <div class="tk-flow-metarow" title="Cargo: @(nn.CargoLabel ?? "-") &#183; Usuario: @(nn.AssigneeLabel ?? "sin asignar")">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                                        <span>@FlowCargoLine(nn)</span>
                                                    </div>
                                                }
                                                @if (nn.LastActivityAt is not null)
                                                {
                                                    <div class="tk-flow-metarow" title="Ultima actividad reportada">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                                        <span>@FlowShortDate(nn.LastActivityAt)</span>
                                                    </div>
                                                }
                                                @if (nn.WaitingSince is not null)
                                                {
                                                    <div class="tk-flow-metarow wait" title="Tiempo en espera de este paso">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 22h14M5 2h14M17 22v-4.2a2 2 0 0 0-.6-1.4L12 12l-4.4 4.4a2 2 0 0 0-.6 1.4V22M7 2v4.2a2 2 0 0 0 .6 1.4L12 12l4.4-4.4A2 2 0 0 0 17 6.2V2" /></svg>
                                                        <span>en espera @FlowWaiting(nn.WaitingSince)</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="tk-flow-badges">
                                                @if (nn.IsAuto) { <span class="tk-flow-badge auto">AUTOMATICO</span> }
                                                @if (nn.State == TaskFlowNodeState.Completed) { <span class="tk-flow-badge done">CERRADO</span> }
                                                @if (nn.HasNote) { <span title="Tiene anotacion del paso">&#128172;</span> }
                                                @if (nn.TeamNotes is { Count: > 0 } tnc) { <span class="tk-flow-badge notes" title="@(tnc.Count) nota(s) del equipo">&#128172; @tnc.Count</span> }
                                            </div>
                                            @* Nota dejada en la CONFIGURACION del nodo (editor de flujos): descripcion/instruccion del paso. *@
                                            @if (!string.IsNullOrWhiteSpace(nn.ConfigNote))
                                            {
                                                <div class="tk-flow-confignote" title="@nn.ConfigNote" style="margin-top:6px;font-size:11px;line-height:1.35;color:var(--ink-3);background:var(--surface-2);border-left:2px solid @accent;border-radius:6px;padding:5px 7px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;">@nn.ConfigNote</div>
                                            }
                                        </div>
                                    }
                                    @* El menu del nodo se renderiza a NIVEL RAIZ (popover fijo), no aqui dentro,
                                       para que NO lo recorte el scroller ni lo descoloque el zoom del canvas. *@
                                </div>
                            }
                        </div>
                    </div>
                    @if (_actionError is not null)
                    {
                        <div class="tk-field-error" style="margin-top:10px;">@_actionError</div>
                    }
                </div>
            }

            @* ===== Split: contenido con tabs (izq) + Bitacora en columna lateral (der) ===== *@
            <div class="tk-detail-split">
              <div class="tk-detail-left">
                @* Descripcion: SIEMPRE visible, encima de los tabs (cualquier tab) *@
                    @* Descripcion *@
                    <div class="tk-card">
                        <div class="tk-card-head">
                            <h3>Descripcion</h3>
                            <div style="display:flex;gap:8px;align-items:center;">
                                @if (!_editingDesc && !string.IsNullOrWhiteSpace(_detail.Description))
                                {
                                    <button class="tb-modal-section-action" @onclick="CopyDescriptionAsync" title="Copiar toda la descripcion">@(_descCopied ? "Copiado" : "Copiar")</button>
                                }
                                @if (!readOnly && !_editingDesc)
                                {
                                    <button class="tb-modal-section-action" @onclick="@(() => { _editingDesc = true; _editDesc = _detail.Description ?? ""; })">Editar</button>
                                }
                            </div>
                        </div>
                        @if (_editingDesc)
                        {
                            <textarea class="form-control" rows="4" @bind="_editDesc" placeholder="Que detalles importantes debe saber el equipo?"></textarea>
                            <div style="display:flex;gap:8px;margin-top:8px;">
                                <button class="btn btn-sm btn-primary" @onclick="SaveDescriptionAsync" disabled="@_busy">Guardar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _editingDesc = false)">Cancelar</button>
                            </div>
                        }
                        else if (string.IsNullOrWhiteSpace(_detail.Description))
                        {
                            <div class="tb-desc-empty" @onclick="@(() => { if (!readOnly) { _editingDesc = true; _editDesc = ""; } })">
                                @(readOnly ? "Sin descripcion." : "Agrega una descripcion mas detallada...")
                            </div>
                        }
                        else
                        {
                            <div class="tk-desc-text">@_detail.Description</div>
                        }
                    </div>

                <div class="tk-detail-tabs">
                    <button type="button" class="tk-tab @(_modalTab == "detalle" ? "active" : "")" @onclick='@(() => _modalTab = "detalle")'>Detalle</button>
                    <button type="button" class="tk-tab @(_modalTab == "formularios" ? "active" : "")" @onclick='@(() => _modalTab = "formularios")'>Formularios@(_generos.Sum(g => g.Items.Count) is var _nForms && _nForms > 0 ? $" ({_nForms})" : "")</button>
                    <button type="button" class="tk-tab @(_modalTab == "documentos" ? "active" : "")" @onclick='@(() => _modalTab = "documentos")'>Documentos@(_detail.Attachments.Count > 0 ? $" ({_detail.Attachments.Count})" : "")</button>
                </div>

                @* ===== Tab: Detalle (cuerpo 2 columnas) ===== *@
                @if (_modalTab == "detalle")
                {
            <div class="tk-detail-body">
                <div class="tk-detail-main">
                    @* Campos personalizados del tablero (ADR-0065) *@
                    @if (_customFields.Count > 0)
                    {
                        <div class="tk-card">
                            <div class="tk-card-head">
                                <h3>Campos del tablero</h3>
                                @if (!readOnly && _customDirty)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="SaveCustomFieldsAsync" disabled="@_busy">Guardar campos</button>
                                }
                            </div>
                            <div class="row g-2 tk-customfields">
                                @foreach (var f in _customFields)
                                {
                                    if (f.FieldType == TerceroFieldType.Separator)
                                    {
                                        <div class="col-12"><div class="tk-fld-sep">@f.Label</div></div>
                                    }
                                    else
                                    {
                                        <div class="@CustomColClass(f.Column) field">
                                            <label class="form-label">@f.Label</label>
                                            @if (f.FieldType == TerceroFieldType.Select)
                                            {
                                                <select class="form-control" disabled="@readOnly"
                                                        value="@GetCustomValue(f.FieldKey)"
                                                        @onchange="@(e => SetCustomValue(f.FieldKey, e.Value?.ToString()))">
                                                    <option value="">(Sin valor)</option>
                                                    @foreach (var opt in TaskFieldUi.SplitOptions(f.Options))
                                                    {
                                                        <option value="@opt">@opt</option>
                                                    }
                                                </select>
                                            }
                                            else if (f.FieldType == TerceroFieldType.TextArea)
                                            {
                                                <textarea class="form-control" rows="2" disabled="@readOnly"
                                                          value="@GetCustomValue(f.FieldKey)"
                                                          @onchange="@(e => SetCustomValue(f.FieldKey, e.Value?.ToString()))"></textarea>
                                            }
                                            else if (f.FieldType == TerceroFieldType.Lookup)
                                            {
                                                @if (CustomLookupCfgOf(f) is { } lkCfg)
                                                {
                                                    <DataLookupField Config="lkCfg"
                                                                     Value="@GetCustomValue(f.FieldKey)"
                                                                     ValueChanged="v => SetCustomValue(f.FieldKey, v)"
                                                                     FormValues="_customValues"
                                                                     ActorUserId="@(_actorTenantUserId ?? Guid.Empty)"
                                                                     Disabled="@readOnly"
                                                                     Placeholder="@($"Buscar {f.Label.ToLowerInvariant()}...")" />
                                                }
                                                else
                                                {
                                                    <div class="tk-fld-help">Este campo aun no tiene configurada su tabla de origen.</div>
                                                }
                                            }
                                            else if (f.FieldType == TerceroFieldType.DirectoryLookup)
                                            {
                                                <DirectoryLookupField Config="CustomDirectoryCfgOf(f)"
                                                                      Value="@GetCustomValue(f.FieldKey)"
                                                                      ValueChanged="v => SetCustomValue(f.FieldKey, v)"
                                                                      Disabled="@readOnly"
                                                                      Placeholder="@($"Buscar {f.Label.ToLowerInvariant()}...")" />
                                            }
                                            else if (f.FieldType == TerceroFieldType.Calculated)
                                            {
                                                <input class="form-control tk-fld-calc" type="text" readonly
                                                       value="@(_customCalculated.GetValueOrDefault(f.FieldKey) ?? "")"
                                                       title="@($"Calculado: {f.Formula}")" />
                                                @if (_customCalculated.TryGetValue(f.FieldKey, out var cv) && cv is null)
                                                {
                                                    <small class="tk-fld-help">No se puede calcular con los datos actuales.</small>
                                                }
                                            }
                                            else
                                            {
                                                <input class="form-control" type="@TaskFieldUi.InputType(f.FieldType)" disabled="@readOnly"
                                                       value="@GetCustomValue(f.FieldKey)"
                                                       @onchange="@(e => SetCustomValue(f.FieldKey, e.Value?.ToString()))" />
                                            }
                                            @if (!string.IsNullOrWhiteSpace(f.Description))
                                            {
                                                <small class="tk-fld-help">@f.Description</small>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                            @if (_customError is not null)
                            {
                                <div class="tk-field-error" style="margin-top:8px;">@_customError</div>
                            }
                        </div>
                    }

                    @* Registro de tiempo: UNA sola caja combinada (cronometro EN VIVO o HH:MM manual, con un
                       solo Guardar). El HISTORIAL ya no vive aqui: cada registro queda en la BITACORA (columna
                       derecha), para no tener dos historiales. El "Total" se mantiene como resumen. *@
                    <div class="tk-card">
                        <div class="tk-card-head">
                            <h3>Registro de tiempo</h3>
                            <span class="tk-worklog-total">Total: <strong>@TaskUi.FormatDuration(_totalSeconds)</strong></span>
                        </div>

                        @if (!readOnly)
                        {
                            <div class="tk-timer">
                                <span class="tk-timer-display" id="tk-timer-display">00:00:00</span>
                                @if (_timerRunning)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="PauseTimerAsync">Pausar</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="StartTimerAsync">Iniciar</button>
                                }
                                <span class="tk-manual-lbl" style="opacity:.7;">o</span>
                                <input type="number" class="form-control form-control-sm tk-manual-num" @bind="_manualHours" min="0" max="23" placeholder="HH" />
                                <span>:</span>
                                <input type="number" class="form-control form-control-sm tk-manual-num" @bind="_manualMinutes" min="0" max="59" placeholder="MM" />
                                <input class="form-control form-control-sm tk-timer-note" @bind="_timerNote" placeholder="Nota del avance..." />
                                <button class="btn btn-sm btn-outline-success" @onclick="SaveWorkLogAsync" disabled="@_busy">Guardar</button>
                            </div>
                            @if (_workLogError is not null)
                            {
                                <div class="tk-field-error">@_workLogError</div>
                            }
                            <p class="tk-empty-note" style="margin-top:6px;">Cronometra con Iniciar, o escribe horas:minutos. Cada registro queda en la Bitacora.</p>
                        }
                    </div>
                    @* Subtareas (tareas hijas, ADR-0065): tareas completas colgadas de esta; el
                       "Avance" de arriba agrega su progreso. Clic en una la abre en este mismo modal. *@
                    <div class="tk-card tk-subtasks">
                        <div class="tk-card-head">
                            <h3>Subtareas</h3>
                            <span class="tk-check-count" style="font-size:12px;color:var(--ink-3, var(--muted-foreground));"><strong>@SubtaskDone()/@SubtaskTotal()</strong></span>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:8px;">
                            @if (SubtaskTotal() == 0)
                            {
                                <p class="tk-empty-note">Sin subtareas.</p>
                            }
                            @foreach (var st in _detail.Subtasks ?? (IReadOnlyList<TaskItemSummaryDto>)Array.Empty<TaskItemSummaryDto>())
                            {
                                var sub = st;
                                <div class="tk-subtask-row" @onclick="@(() => OpenSubtaskAsync(sub.Id))" title="Abrir subtarea @sub.Number">
                                    <span class="tk-status @TaskUi.StatusClass(sub.Status)">@TaskUi.StatusLabel(sub.Status)</span>
                                    <span class="tk-subtask-num">@sub.Number</span>
                                    <span class="tk-subtask-title">@sub.Title</span>
                                </div>
                            }
                            @if (!readOnly)
                            {
                                <div class="tk-check-add">
                                    <input class="form-control form-control-sm" @bind="_newSubtaskText" maxlength="200" placeholder="Nueva subtarea..." />
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddSubtaskAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newSubtaskText))">Agregar subtarea</button>
                                </div>
                            }
                        </div>
                    </div>
                    @* Lista de chequeo: MOVIDA al rail (2a columna, debajo del Resumen) por peticion del usuario. *@
                </div>

                <div class="tk-detail-side">
                    @* Flujo (runtime, ola F2, ADR-0036): paso current del flujo y, si el usuario
                       es candidato, Atender directo (completar/aprobar). Los pasos con formulario
                       se atienden por la seccion "Formularios del paso" de arriba. *@
                    @if (_flowSteps.Count > 0)
                    {
                        <div class="tk-card">
                            <div class="tk-card-head"><h3>Flujo</h3></div>
                            @foreach (var fs in _flowSteps)
                            {
                                var step = fs;
                                <div class="tk-summary-row" style="align-items:flex-start;gap:8px;flex-direction:column;">
                                    <div style="display:flex;align-items:center;gap:8px;width:100%;">
                                        <span style="flex:1;min-width:0;">
                                            <strong style="display:block;">@(step.NodeName ?? "(paso sin nombre)")</strong>
                                            <span style="font-size:11px;color:var(--muted-foreground);">@step.ProcessName @(step.IsMine ? "- Tuyo" : step.AssignedToTenantUserId is null ? "- Sin reclamar" : $"- de {step.AssignedToLabel}")</span>
                                        </span>
                                        @if (step.IsClaimable)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => ClaimFlowStepAsync(step))" disabled="@_busy">Tomar</button>
                                        }
                                    </div>
                                    @if (!step.HasForm)
                                    {
                                        <div style="display:flex;gap:6px;flex-wrap:wrap;width:100%;">
                                            @if (step.IsGatewayAhead && step.ApprovalOptions.Count > 0)
                                            {
                                                @foreach (var option in step.ApprovalOptions)
                                                {
                                                    var opt = option;
                                                    <button class="btn btn-sm btn-primary" @onclick="@(() => CompleteFlowStepAsync(step, opt))" disabled="@_busy">@opt</button>
                                                }
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-primary" @onclick="@(() => CompleteFlowStepAsync(step, null))" disabled="@_busy">Completar paso</button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="font-size:11px;color:var(--muted-foreground);">Este paso se completa en "Formularios del paso".</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>
                }

                @* ===== Tab: Formularios (cotizaciones del concepto como tarjetas + formularios del flujo) ===== *@
                @if (_modalTab == "formularios")
                {
                    var taskClosed = _detail!.Item.Status == TaskItemStatus.Closed;
                    <div class="tk-tabpane">
                        @{
                            var allForms = _generos.SelectMany(g => g.Items.Select(it => (Genero: g, Item: it))).ToList();
                            // El formulario del paso ACTUAL se pinta como una tarjeta mas; se cruza por ResponseId
                            // con _stepForms para saber cual es el paso (boton "Diligenciar" + ruta/cierre de compuerta).
                            var stepById = _stepForms
                                .GroupBy(s => s.ResponseId)
                                .ToDictionary(gp => gp.Key, gp => gp.First());
                        }
                        @* --- Formularios de la tarea en UNA lista uniforme: TODOS los tipos/generos se ven igual,
                             incluido el del paso ACTUAL (su tarjeta trae "Diligenciar"). El boton "+ Agregar
                             formulario" pregunta el tipo cuando hay varios. --- *@
                        @if (_generos.Count > 0)
                        {
                            <div class="tk-card">
                                <div class="tk-card-head" style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
                                    <h3>Formularios</h3>
                                    @if (!taskClosed && _addableGeneros.Count > 0)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="OnAddFormClick" disabled="@_busy">+ Agregar formulario</button>
                                    }
                                </div>
                                @if (allForms.Count == 0)
                                {
                                    <p class="tk-empty-note">Aun no hay formularios.@(taskClosed ? "" : " Usa \"Agregar formulario\" para crear el primero.")</p>
                                }
                                else
                                {
                                    <div class="tk-quote-grid">
                                        @foreach (var pair in allForms)
                                        {
                                            var g = pair.Genero;
                                            var it = pair.Item;
                                            var finalized = it.Status == FormResponseStatus.Submitted;
                                            TaskStepFormDto? sf = stepById.TryGetValue(it.ResponseId, out var _sf) ? _sf : null;
                                            var isStep = sf is not null;
                                            var stepPending = sf?.LinkStatus == FormFlowLinkStatus.Pending;
                                            <div class="tk-quote-card @(finalized ? "is-final" : "") @(it.IsActive ? "is-active" : "")">
                                                <div class="tk-quote-main" @onclick="@(() => OpenFormItem(g, it, sf))">
                                                    <strong>@(string.IsNullOrWhiteSpace(it.Titulo) ? "Sin numero" : it.Titulo)</strong>
                                                    <span class="tk-quote-sub">
                                                        <span style="display:inline-block;padding:1px 8px;border-radius:999px;background:var(--surface-3,#f0f0f2);color:var(--ink-2,#5C5C66);font-size:11px;font-weight:600;">@g.FormTitle</span>
                                                        @if (g.Inherited)
                                                        {
                                                            <span style="display:inline-block;padding:1px 8px;border-radius:999px;background:#eef2ff;color:#4338ca;font-size:11px;font-weight:600;" title="Formulario de la tarea padre (salto de flujo). Solo consulta.">&#128279; Tarea padre</span>
                                                        }
                                                        @if (isStep)
                                                        {
                                                            <span>&nbsp;&middot; Paso: @(sf!.NodeName ?? "(sin nombre)")</span>
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(it.Cliente))
                                                        {
                                                            <span>&nbsp;&middot; @it.Cliente</span>
                                                        }
                                                    </span>
                                                    <span class="tk-quote-meta">
                                                        @if (it.IsActive)
                                                        {
                                                            <span class="tk-quote-active" title="Formulario activo por defecto de este tipo">&#9733; Activo</span>
                                                        }
                                                        @if (isStep && stepPending)
                                                        {
                                                            <span class="tk-status st-pending">Pendiente</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="tk-status @(finalized ? "st-done" : "st-pending")">@(finalized ? "Finalizada" : "Borrador")</span>
                                                        }
                                                        <span>@it.CreatedAt.ToLocalTime().ToString("dd MMM")</span>
                                                    </span>
                                                </div>
                                                <div class="tk-quote-actions">
                                                    @{ var primaryActive = !g.Inherited && (isStep ? (stepPending && !taskClosed) : (!finalized && !taskClosed)); }
                                                    <button class="btn btn-xs @(primaryActive ? "btn-primary" : "")" @onclick="@(() => OpenFormItem(g, it, sf))" disabled="@_busy">@(primaryActive ? "Diligenciar" : "Ver")</button>
                                                    @* Los HEREDADOS del padre son SOLO consulta: sin activar / copiar / reabrir / eliminar. *@
                                                    @if (!g.Inherited)
                                                    {
                                                        @* "Marcar activo" en CUALQUIER formulario NO activo del genero (incluido el del paso
                                                           actual): asi se puede volver a activar el otro. Un solo activo por (genero, tarea). *@
                                                        @if (!it.IsActive && g.Items.Count > 1 && !taskClosed)
                                                        {
                                                            <button class="btn btn-xs" @onclick="@(() => SetActiveConceptFormAsync(it))" disabled="@_busy" title="Marcar como formulario activo por defecto de este tipo">Marcar activo</button>
                                                        }
                                                        @if (!taskClosed)
                                                        {
                                                            <button class="btn btn-xs" @onclick="@(() => DuplicateConceptFormAsync(it))" disabled="@_busy" title="Crear una copia">Copiar</button>
                                                        }
                                                        @if (!isStep && finalized && !taskClosed)
                                                        {
                                                            <button class="btn btn-xs" @onclick="@(() => ReopenConceptFormAsync(it))" disabled="@_busy" title="Reabrir para editar">Reabrir</button>
                                                        }
                                                        @if (!finalized && !taskClosed)
                                                        {
                                                            <button class="btn btn-xs tk-btn-danger" @onclick="@(() => DeleteConceptFormAsync(it))" disabled="@_busy" title="Eliminar formulario">Eliminar</button>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (_generos.Count == 0)
                        {
                            <div class="tk-card"><p class="tk-empty-note">Esta actividad no tiene formularios asociados (ni por el concepto ni por el flujo).</p></div>
                        }
                    </div>
                }

                @* ===== Tab: Documentos (galeria / lista / visor con mini-galeria) ===== *@
                @if (_modalTab == "documentos")
                {
                    <div class="tk-tabpane">
                        <div class="tk-doc-toolbar">
                            <div class="tk-doc-modes">
                                <button type="button" class="tk-doc-mode @(_docMode == "galeria" ? "active" : "")" @onclick='@(() => _docMode = "galeria")' title="Galeria">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                                    Galeria
                                </button>
                                <button type="button" class="tk-doc-mode @(_docMode == "lista" ? "active" : "")" @onclick='@(() => _docMode = "lista")' title="Lista">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                                    Lista
                                </button>
                                <button type="button" class="tk-doc-mode @(_docMode == "visor" ? "active" : "")" @onclick='@(() => _docMode = "visor")' title="Visor" disabled="@(_detail.Attachments.Count == 0)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    Visor
                                </button>
                            </div>
                            <span class="tk-doc-count">@_detail.Attachments.Count documento(s)</span>
                        </div>

                        @if (_detail.Attachments.Count == 0)
                        {
                            <p class="tk-empty-note">Sin documentos.</p>
                        }
                        else if (_docMode == "galeria")
                        {
                            <div class="tk-doc-gallery">
                                @foreach (var att in _detail.Attachments)
                                {
                                    var a = att;
                                    <div class="tk-doc-tile" @onclick="@(() => OpenDocViewer(a))">
                                        <div class="tk-doc-thumb">
                                            @if (IsImageAtt(a))
                                            {
                                                <img src="@a.Url" alt="@a.FileName" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="tk-doc-ext">@AttExt(a)</span>
                                            }
                                        </div>
                                        <div class="tk-doc-tile-name" title="@a.FileName">@a.FileName</div>
                                        <div class="tk-doc-tile-meta">@FormatSize(a.SizeBytes) - @TaskUi.FormatRelative(a.CreatedAt)</div>
                                    </div>
                                }
                            </div>
                        }
                        else if (_docMode == "lista")
                        {
                            @foreach (var att in _detail.Attachments)
                            {
                                var a = att;
                                <div class="tk-attachment">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 17.93 8.8l-8.59 8.57a2 2 0 1 1-2.83-2.83l8.49-8.48"/></svg>
                                    <a href="@a.Url" target="_blank" rel="noopener" download="@a.FileName" class="tk-attachment-name">@a.FileName</a>
                                    <span class="tk-attachment-meta">@(a.UploadedByName ?? "-") - @TaskUi.FormatRelative(a.CreatedAt)</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => OpenDocViewer(a))">Ver</button>
                                    @if (!readOnly)
                                    {
                                        <button class="tk-tag-x" title="Eliminar adjunto" @onclick="@(() => DeleteAttachmentAsync(a.Id))">&times;</button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @* Visor: mini-galeria a la izquierda + preview del documento activo *@
                            <div class="tk-doc-viewer">
                                <div class="tk-doc-filmstrip">
                                    @{ var vi = 0; }
                                    @foreach (var att in _detail.Attachments)
                                    {
                                        var a = att; var idx = vi++;
                                        <button type="button" class="tk-doc-frame @(idx == _docIndex ? "active" : "")" @onclick="@(() => _docIndex = idx)" title="@a.FileName">
                                            @if (IsImageAtt(a))
                                            {
                                                <img src="@a.Url" alt="@a.FileName" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="tk-doc-ext sm">@AttExt(a)</span>
                                            }
                                        </button>
                                    }
                                </div>
                                <div class="tk-doc-stage">
                                    @{ var cur = _detail.Attachments[Math.Clamp(_docIndex, 0, _detail.Attachments.Count - 1)]; }
                                    <div class="tk-doc-stage-head">
                                        <button type="button" class="tk-doc-nav" @onclick="DocPrev" disabled="@(_docIndex <= 0)" title="Anterior">&#8249;</button>
                                        <span class="tk-doc-stage-name" title="@cur.FileName">@cur.FileName</span>
                                        <button type="button" class="tk-doc-nav" @onclick="DocNext" disabled="@(_docIndex >= _detail.Attachments.Count - 1)" title="Siguiente">&#8250;</button>
                                        <a href="@cur.Url" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">Abrir</a>
                                    </div>
                                    <div class="tk-doc-canvas">
                                        @if (IsImageAtt(cur))
                                        {
                                            <img src="@cur.Url" alt="@cur.FileName" />
                                        }
                                        else if (IsPdfAtt(cur))
                                        {
                                            <iframe src="@cur.Url" title="@cur.FileName"></iframe>
                                        }
                                        else
                                        {
                                            <div class="tk-doc-noview">
                                                <span class="tk-doc-ext lg">@AttExt(cur)</span>
                                                <p>Vista previa no disponible para este tipo de archivo.</p>
                                                <a href="@cur.Url" target="_blank" rel="noopener" download="@cur.FileName" class="btn btn-sm btn-primary">Descargar</a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!readOnly)
                        {
                            @* Subida real: arrastra o elige archivos. El <InputFile> cubre la zona (transparente). *@
                            <div class="tk-drop @(_attDragOver ? "over" : "")"
                                 @ondragenter:preventDefault="true" @ondragenter="() => _attDragOver = true"
                                 @ondragover:preventDefault="true"
                                 @ondragleave:preventDefault="true" @ondragleave="() => _attDragOver = false"
                                 @ondrop:preventDefault="true" @ondrop="() => _attDragOver = false">
                                <InputFile class="tk-drop-input" multiple OnChange="OnAttachFilesAsync" disabled="@(_busy || _attUploading)" />
                                <svg class="tk-drop-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3m0 0L8 7m4-4 4 4M20 17v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/></svg>
                                <div class="tk-drop-title">@(_attUploading ? "Subiendo archivos..." : "Arrastra tus archivos aqui o haz clic para elegir")</div>
                                <div class="tk-drop-hint">PDF, imagenes, video (mp4), Office, texto o comprimidos. Hasta @(MaxAttBytes / (1024 * 1024)) MB (video @(MaxVideoBytes / (1024 * 1024)) MB).</div>
                            </div>
                            <details class="tk-att-url">
                                <summary>o adjuntar por enlace (URL)</summary>
                                <div class="tk-attachment-add">
                                    <input class="form-control form-control-sm" @bind="_attName" placeholder="Nombre del archivo" />
                                    <input class="form-control form-control-sm" @bind="_attUrl" placeholder="https://..." />
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddAttachmentAsync" disabled="@_busy">Agregar</button>
                                </div>
                            </details>
                            @if (_attError is not null)
                            {
                                <div class="tk-field-error">@_attError</div>
                            }
                        }
                    </div>
                }
              </div>

              @* ===== Columna lateral (rail): Resumen arriba + Bitacora ===== *@
              <aside class="tk-detail-rail">
                    @* Resumen *@
                    <div class="tk-card">
                        <div class="tk-card-head"><h3>Resumen</h3></div>
                        <div class="tk-summary">
                            <div class="tk-summary-row"><span>Tipo</span><strong>@TypeLabel(item.ActivityTypeId, item.ActivityTypeName ?? item.SubcategoriaName)</strong></div>
                            <div class="tk-summary-row">
                                <span>Proyecto</span>
                                @if (item.ProjectId is Guid pid && _projects.FirstOrDefault(p => p.Id == pid) is ProjectDto proj)
                                {
                                    <a href="/proyectos/@proj.Id" class="tk-link">@proj.Code - @proj.Name</a>
                                }
                                else
                                {
                                    <strong>Sin proyecto</strong>
                                }
                            </div>
                            <div class="tk-summary-row">
                                <span>Contacto</span>
                                <span style="display:inline-flex;align-items:center;gap:6px;min-width:0;">
                                    <strong style="overflow:hidden;text-overflow:ellipsis;">@(_detail.RequesterName ?? "-")</strong>
                                    @if (!string.IsNullOrWhiteSpace(_detail.RequesterName))
                                    {
                                        @CopyButton(_detail.RequesterName, "Copiar nombre")
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_detail.RequesterEmail))
                            {
                                <div class="tk-summary-row">
                                    <span>Email</span>
                                    <span style="display:inline-flex;align-items:center;gap:6px;min-width:0;">
                                        <a href="mailto:@_detail.RequesterEmail" class="tk-link" style="overflow:hidden;text-overflow:ellipsis;">@_detail.RequesterEmail</a>
                                        @CopyButton(_detail.RequesterEmail, "Copiar correo")
                                    </span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.RequesterPhone))
                            {
                                <div class="tk-summary-row">
                                    <span>Telefono</span>
                                    <span style="display:inline-flex;align-items:center;gap:6px;min-width:0;">
                                        <a href="tel:@_detail.RequesterPhone" class="tk-link" style="overflow:hidden;text-overflow:ellipsis;">@_detail.RequesterPhone</a>
                                        @CopyButton(_detail.RequesterPhone, "Copiar telefono")
                                    </span>
                                </div>
                            }
                            @if (_detail.CcEmails.Count > 0)
                            {
                                <div class="tk-summary-row"><span>CC</span><strong>@string.Join(", ", _detail.CcEmails)</strong></div>
                            }
                            <div class="tk-summary-row"><span>Creada</span><strong>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong></div>
                            <div class="tk-summary-row"><span>Entrega</span><strong>@(item.DueDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "Sin fecha")</strong></div>
                            @if (item.ClosedAt is not null)
                            {
                                <div class="tk-summary-row"><span>Cerrada</span><strong>@item.ClosedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.CloseReason))
                            {
                                <div class="tk-summary-row"><span>Motivo de cierre</span><strong>@item.CloseReason</strong></div>
                            }
                            @* Avance de la lista de chequeo (ADR-0020): la barra del sidebar usa el checklist. *@
                            <div class="tk-summary-row tk-avance-row"><span>Avance</span><strong>@ProgressDone()/@ProgressTotal()</strong></div>
                            <div class="tk-progress-bar"><i style="width:@(ProgressPctCombined())%;background:@ProgressColor()"></i></div>
                            <div class="tk-summary-row tk-tags-row">
                                <span>Etiquetas</span>
                                <span class="tk-tags-edit">
                                    @foreach (var tag in item.Tags)
                                    {
                                        var t = tag;
                                        <span class="tk-tag" style="@(string.IsNullOrWhiteSpace(t.Color) ? "" : $"background:{t.Color};color:#fff;")">
                                            @t.Name
                                            @if (!readOnly)
                                            {
                                                <span class="tk-tag-remove" title="Quitar etiqueta" @onclick="@(() => DetachTagAsync(t.Id))">&times;</span>
                                            }
                                        </span>
                                    }
                                    @if (item.Tags.Count == 0)
                                    {
                                        <span class="tk-tags-none">Sin etiquetas</span>
                                    }
                                    @if (!readOnly)
                                    {
                                        <span class="tk-tag-add-wrap">
                                            <button class="tk-tag-add" title="Agregar etiqueta" @onclick="@(() => _tagMenuOpen = !_tagMenuOpen)">+ Etiqueta</button>
                                            @if (_tagMenuOpen)
                                            {
                                                var yaPuestas = item.Tags.Select(x => x.Id).ToHashSet();
                                                var disponibles = _assignableTags.Where(x => !yaPuestas.Contains(x.Id)).ToList();
                                                <div class="tk-tag-menu">
                                                    @if (disponibles.Count == 0)
                                                    {
                                                        <div class="tk-tag-menu-empty">
                                                            @(_assignableTags.Count == 0
                                                                ? "La columna no tiene etiquetas permitidas."
                                                                : "Ya tiene todas las etiquetas disponibles.")
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var opt in disponibles)
                                                        {
                                                            var o = opt;
                                                            <button class="tk-tag-menu-opt" @onclick="@(() => AttachTagAsync(o.Id))">
                                                                <span class="tk-tag-dot" style="background:@(string.IsNullOrWhiteSpace(o.Color) ? "#94a3b8" : o.Color)"></span>@o.Name
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                    @* Lista de chequeo: en el rail, DEBAJO del Resumen (2a columna) por peticion del usuario. *@
                    <div class="tk-card tk-checklist">
                        <div class="tk-card-head">
                            <h3>Lista de chequeo</h3>
                            <span class="tk-check-count" style="font-size:12px;color:var(--ink-3, var(--muted-foreground));"><strong>@ChecklistDone()/@_detail.Checklist.Count</strong></span>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:10px;">
                            @if (_detail.Checklist.Count == 0)
                            {
                                <p class="tk-empty-note">Sin items de chequeo.</p>
                            }
                            @foreach (var ck in _detail.Checklist)
                            {
                                var checkItem = ck;
                                <div class="tk-check-row">
                                    <button class="tk-check-box @(checkItem.IsCompleted ? "done" : "")" @onclick="@(() => ToggleChecklistAsync(checkItem))" disabled="@readOnly" aria-label="Completar item">
                                        @if (checkItem.IsCompleted)
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17 19 7"/></svg>
                                        }
                                    </button>
                                    <span class="tk-check-txt @(checkItem.IsCompleted ? "done" : "")">@checkItem.Text</span>
                                    @if (!readOnly)
                                    {
                                        <button class="tk-check-del" title="Eliminar item" @onclick="@(() => RemoveChecklistAsync(checkItem.Id))">&times;</button>
                                    }
                                </div>
                            }
                            @if (!readOnly)
                            {
                                <div class="tk-check-add">
                                    <input class="form-control form-control-sm" @bind="_newCheckText" maxlength="300" placeholder="Nuevo item..." />
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddChecklistAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newCheckText))">Agregar item</button>
                                </div>
                            }
                        </div>
                    </div>
              </aside>

              @* ===== 3a columna: BITACORA (columna propia) ===== *@
              <aside class="tk-detail-bitacora-col">
                    <div class="tk-card tk-detail-bitacora">
                    <div class="tk-card-head"><h3>Bitacora</h3></div>
                    @if (!readOnly)
                    {
                        <div class="tk-comment-box">
                            <textarea class="form-control" rows="2" @bind="_newComment" placeholder="Escribe un comentario... (usa @@ para mencionar)"></textarea>
                            @* Adjuntos ya subidos, listos para enviar con el comentario. *@
                            @if (_commentAtts.Count > 0)
                            {
                                <div class="tk-comment-atts">
                                    @foreach (var ca in _commentAtts)
                                    {
                                        var att = ca;
                                        <span class="tk-comment-att">
                                            @if (att.IsImage) { <img src="@att.Url" alt="@att.Name" /> } else { <span class="tk-comment-att-ic">&#128206;</span> }
                                            <span class="tk-comment-att-nm">@att.Name</span>
                                            <button class="tk-comment-att-x" title="Quitar" @onclick="@(() => _commentAtts.Remove(att))">&times;</button>
                                        </span>
                                    }
                                </div>
                            }
                            <div class="tk-comment-tools">
                                <label class="tk-comment-tool" title="Adjuntar imagen o archivo">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
                                    <InputFile class="tk-comment-file" multiple OnChange="OnCommentFilesAsync" disabled="@(_busy || _commentUploading)" />
                                </label>
                                <div class="tk-mention-wrap">
                                    <button type="button" class="tk-comment-tool" title="Mencionar a un usuario" @onclick="@(() => _mentionOpen = !_mentionOpen)">@@</button>
                                    @if (_mentionOpen)
                                    {
                                        <div class="tk-mention-menu">
                                            @foreach (var u in _users.Take(50))
                                            {
                                                var uu = u;
                                                <button type="button" class="tk-mention-item" @onclick="@(() => InsertMention(uu))">
                                                    <span class="tb-avatar">@TaskUi.InitialsOf(uu.Email)</span>@uu.Email
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (_commentUploading) { <span class="tk-empty-note" style="margin:0;">Subiendo...</span> }
                                <button class="btn btn-sm btn-primary" style="margin-left:auto;" @onclick="AddCommentAsync" disabled="@(_busy || (string.IsNullOrWhiteSpace(_newComment) && _commentAtts.Count == 0))">Comentar</button>
                            </div>
                            @if (_commentError is not null) { <div class="tk-field-error" style="margin-top:4px;">@_commentError</div> }
                        </div>
                    }
                    <div class="tk-activity-list">
                        @if (_detail.RecentActivity.Count == 0)
                        {
                            <p class="tk-empty-note">Sin actividad reciente.</p>
                        }
                        @foreach (var a in _detail.RecentActivity)
                        {
                            <div class="tk-activity-item">
                                <span class="tb-avatar" title="@a.ActorName">@TaskUi.InitialsOf(a.ActorName)</span>
                                <div class="tk-activity-body">
                                    @if (a.Type == TaskActivityType.Comment)
                                    {
                                        var parsed = ParseComment(a.Text);
                                        <div class="tk-activity-bubble">
                                            <div class="tk-activity-meta"><strong>@a.ActorName</strong> <span>@TaskUi.FormatRelative(a.CreatedAt)</span></div>
                                            @if (!string.IsNullOrWhiteSpace(parsed.Text)) { <p>@parsed.Text</p> }
                                            @if (parsed.Atts.Count > 0)
                                            {
                                                <div class="tk-activity-atts">
                                                    @foreach (var at in parsed.Atts)
                                                    {
                                                        @if (at.IsImage)
                                                        {
                                                            <a href="@at.Url" target="_blank" rel="noopener"><img class="tk-activity-img" src="@at.Url" alt="@at.Name" /></a>
                                                        }
                                                        else
                                                        {
                                                            <a class="tk-activity-file" href="@at.Url" target="_blank" rel="noopener">&#128206; @at.Name</a>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="tk-activity-action"><strong>@a.ActorName</strong> @a.Text <span>@TaskUi.FormatRelative(a.CreatedAt)</span></div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    </div>
              </aside>
            </div>
        </div>
    </div>
}

@* ===== Modal editor de un formulario (cotizacion del concepto o formulario del paso) ===== *@
@if (_openForm is not null)
{
    @* El fondo NO cierra el formulario (se perdia lo diligenciado por un click/arrastre afuera). Cierra
       con el boton X o "Listo" (ambos autoguardan). *@
    <div class="modal-overlay" style="z-index:60;overscroll-behavior:contain">
        <div class="modal-dialog" style="@FormModalWidthStyle()" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@_openForm.Title</h3>
                <button class="modal-close" @onclick="CloseOpenFormWithSaveAsync">&times;</button>
            </div>
            <div class="modal-body">
                <DynamicFormRenderer @ref="_openFormRenderer"
                                     DefinitionId="@_openForm.DefinitionId"
                                     ResponseId="@_openForm.ResponseId"
                                     Reference="@_openForm.Reference"
                                     Mode="@_openForm.Mode"
                                     SubmittedByTenantUserId="@_actorTenantUserId"
                                     TaskTokens="@BuildTaskTokens()"
                                     EmbeddedInTask="true"
                                     ApprovalOptions="@(_openForm.Step is { IsGatewayAhead: true } gs ? gs.ApprovalOptions : null)"
                                     OnOpenFormRequested="@OnConvertToFormAsync"
                                     OnSubmitted="@(_openForm.IsStep ? OnStepFormSubmittedAsync : OnConceptFormSubmittedAsync)" />
            </div>
            @* "Listo": guarda el borrador y cierra (igual que el wizard de crear tarea). No envia; el
               commit definitivo sigue en el boton "Enviar" del propio formulario. *@
            <div style="display:flex;justify-content:flex-end;gap:10px;padding:12px 20px;border-top:1px solid var(--line)">
                <button class="btn btn-primary" disabled="@_busy" @onclick="CloseOpenFormWithSaveAsync">Listo</button>
            </div>
        </div>
    </div>
}

@* ===== Selector "Agregar formulario": cuando hay VARIOS tipos (generos) configurados, pregunta cual
       agregar antes de crear el borrador. Con un solo tipo no aparece (se agrega directo). ===== *@
@if (_addPickerOpen)
{
    <div class="modal-overlay" style="z-index:61;overscroll-behavior:contain" @onmousedown="@(() => _addPickerOpen = false)">
        <div class="modal-dialog" style="max-width:380px;" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
            <div class="modal-head">
                <h3>Agregar formulario</h3>
                <button class="modal-close" @onclick="@(() => _addPickerOpen = false)">&times;</button>
            </div>
            <div class="modal-body">
                <p class="tk-empty-note" style="margin:0 0 10px;">Elige el tipo de formulario a agregar:</p>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    @foreach (var opt in _addableGeneros)
                    {
                        <button class="btn btn-primary" style="justify-content:flex-start;width:100%;" @onclick="@(() => PickAddGeneroAsync(opt.DefinitionId))" disabled="@_busy">@opt.Title</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ===== Menu del nodo del diagrama, como popover FIJO a nivel raiz (no lo recorta el scroller ni lo
       descoloca el zoom del canvas). Se ancla a la posicion en pantalla del boton del nodo. ===== *@
@if (_flowDiagram is not null && _flowMenuNodeId is Guid _openMenuId
     && _flowDiagram.Nodes.FirstOrDefault(x => x.NodeId == _openMenuId) is TaskFlowNodeDto mnode)
{
    var maccent = FlowNodeColor(mnode.Color) ?? (mnode.IsAuto ? "var(--t-blue)" : "var(--t-violet)");
    var mcanAct = mnode.IsCurrent && mnode.StepId is not null && mnode.IsMine;
    <div class="tk-flow-menu-backdrop" @onclick="@(() => _flowMenuNodeId = null)"></div>
    <div class="tk-flow-menu tk-flow-menu-fixed" style="left:@(_flowMenuLeft)px;top:@(_flowMenuTop)px;" @onclick:stopPropagation="true">
        @if (!string.IsNullOrWhiteSpace(mnode.ConfigNote))
        {
            <div class="tk-flow-menu-note" style="margin:0 0 8px;padding:6px 8px;background:var(--surface-2);border-radius:6px;border-left:2px solid @maccent;white-space:pre-wrap;">@mnode.ConfigNote</div>
        }
        @if (mnode.IsAuto)
        {
            <div class="tk-flow-menu-t">PASO AUTOMATICO</div>
            <div class="tk-flow-menu-note">Lo atiende el agente@(string.IsNullOrWhiteSpace(mnode.AgentName) ? "" : " " + mnode.AgentName). El cierre por agente llega en una proxima ola.</div>
        }
        else if (mcanAct && (mnode.Routes is { Count: > 0 } || mnode.ApprovalOptions.Count > 0))
        {
            <div class="tk-flow-menu-t">QUE RUTA TOMAR?</div>
            @if (mnode.Routes is { Count: > 0 } routes)
            {
                @foreach (var r in routes)
                {
                    var rr = r;
                    @* Compuerta ATENDIDA: la rama se sigue por su DESTINO (ADR-0072). Un paso Task con compuerta
                       AUTOMATICA adelante: se completa con el approvalResult (nombre) y el motor enruta. *@
                    <button class="tk-flow-route @FlowRouteClass(rr.Kind)" disabled="@_busy"
                            @onclick="@(() => (mnode.NodeType == WorkflowNodeType.ExclusiveGateway && rr.TargetNodeId is Guid tgt)
                                ? ChooseGatewayRouteAsync(mnode.StepId!.Value, tgt, _flowNote)
                                : CompleteFlowNodeAsync(mnode.StepId!.Value, rr.Option, _flowNote))">
                        <span class="tk-flow-route-opt">@rr.Option</span>
                        @if (!string.IsNullOrWhiteSpace(rr.TargetName) && !string.Equals(rr.TargetName, rr.Option, StringComparison.Ordinal))
                        {
                            <span class="tk-flow-route-to">&#8594; @rr.TargetName</span>
                        }
                    </button>
                }
            }
            else
            {
                @foreach (var opt in mnode.ApprovalOptions)
                {
                    var o = opt;
                    <button class="tk-flow-route" disabled="@_busy" @onclick="@(() => CompleteFlowNodeAsync(mnode.StepId!.Value, o, _flowNote))">&#8594; @o</button>
                }
            }
            <textarea class="tk-flow-textarea" placeholder="Anotacion (opcional)..." @bind="_flowNote"></textarea>
            <div class="tk-flow-menu-note" style="margin-top:6px;">Al elegir, el sistema toma esa ruta y la actividad pasa al usuario que corresponda.</div>
        }
        else if (mcanAct)
        {
            <div class="tk-flow-menu-t">CERRAR ACTIVIDAD</div>
            <textarea class="tk-flow-textarea" placeholder="Anotacion al cerrar (opcional)..." @bind="_flowNote"></textarea>
            <button class="tk-flow-close" disabled="@_busy" @onclick="@(() => CompleteFlowNodeAsync(mnode.StepId!.Value, null, _flowNote))">Cerrar actividad</button>
            @if (mnode.HasForm)
            {
                <button class="tk-flow-link" disabled="@_busy" @onclick="@(() => { _modalTab = "formularios"; _flowMenuNodeId = null; })">Diligenciar formulario</button>
                <div class="tk-flow-menu-note" style="margin-top:6px;">Este paso tiene formulario: puedes diligenciarlo o cerrar la actividad directamente.</div>
            }
        }
        else if (mnode.IsClaimable && mnode.StepId is not null)
        {
            <div class="tk-flow-menu-t">PASO SIN RECLAMAR</div>
            <button class="tk-flow-close" disabled="@_busy" @onclick="@(() => ClaimFlowNodeAsync(mnode.StepId!.Value))">Tomar este paso</button>
        }
        else
        {
            <div class="tk-flow-menu-t">@FlowStateLabel(mnode.State)</div>
            <div class="tk-flow-menu-note">@(string.IsNullOrWhiteSpace(mnode.Note) ? "Sin anotacion." : mnode.Note)</div>
            @if (mnode.CanReopen && mnode.ReopenStepId is not null)
            {
                <button class="tk-flow-reopen" disabled="@_busy" @onclick="@(() => ReopenFlowNodeAsync(mnode.ReopenStepId!.Value))">Reabrir actividad</button>
                <div class="tk-flow-menu-note" style="margin-top:6px;">Vuelve este paso a pendiente. Disponible mientras no se haya cerrado un paso posterior.</div>
            }
        }
        @* Notas COLABORATIVAS del equipo (ADR-0071): cualquiera con acceso a la tarea deja recados en
           CUALQUIER nodo, incluso pasos futuros de los que no es encargado. Siempre visible. *@
        <div class="tk-flow-team">
            <div class="tk-flow-menu-t" style="margin-top:12px;">NOTAS DEL EQUIPO</div>
            @if (mnode.TeamNotes is { Count: > 0 } tnotes)
            {
                <div class="tk-flow-notes">
                    @foreach (var note in tnotes)
                    {
                        <div class="tk-flow-note-item">
                            <div class="tk-flow-note-head">
                                <span class="tk-flow-note-author">@note.AuthorName</span>
                                <span class="tk-flow-note-date">@FlowShortDate(note.CreatedAt)</span>
                            </div>
                            <div class="tk-flow-note-text">@note.Text</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="tk-flow-menu-note">Sin notas todavia. Deja un recado para el equipo.</div>
            }
            <textarea class="tk-flow-textarea" placeholder="Escribe una nota para el equipo..." @bind="_teamNote"></textarea>
            <button class="tk-flow-link" disabled="@_busy" @onclick="@(() => AddTeamNoteAsync(mnode.NodeId))">Agregar nota</button>
        </div>
    </div>
}

@code {
    // Detalle de tarea del nucleo (FASE 3), estilo prototipo Linear/Height:
    // hero con pills editables, worklog con cronometro (JS interop), actividad y adjuntos.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    /// <summary>Se dispara tras cualquier mutacion exitosa para que el tablero refresque.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Contexto de la tarea para los tokens {tareas.campo} de los formularios (concepto/paso):
    /// el cliente/contacto, correo, telefono, etc. de ESTA tarea. Asi un campo del formulario puede
    /// prellenarse con {tareas.cliente} sin volver a escribirlo. Fuera de una tarea, el token queda vacio.</summary>
    private IReadOnlyDictionary<string, string?>? BuildTaskTokens()
    {
        if (_detail is null) { return null; }
        return new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase)
        {
            ["cliente"] = _detail.RequesterName,
            ["contacto"] = _detail.RequesterName,
            ["solicitante"] = _detail.RequesterName,
            ["email"] = _detail.RequesterEmail,
            ["correo"] = _detail.RequesterEmail,
            ["telefono"] = _detail.RequesterPhone,
            ["titulo"] = _detail.Item.Title,
            ["numero"] = _detail.Item.Number,
        };
    }

    private TaskItemDetailDto? _detail;
    private long _totalSeconds;
    private List<TenantUserDto> _users = new();
    private List<ActivityTypeDto> _types = new();
    private List<ProjectDto> _projects = new();

    // Campos personalizados del tablero (ADR-0065): definiciones + valores capturados + calculados.
    private IReadOnlyList<TaskFieldDto> _customFields = [];
    private readonly Dictionary<string, string?> _customValues = new(StringComparer.Ordinal);
    private Dictionary<string, string?> _customCalculated = new(StringComparer.Ordinal);
    private bool _customDirty;
    private string? _customError;

    private bool _busy;
    private string? _openMenu;
    private bool _editingTitle;
    private string _editTitle = "";
    private bool _editingDesc;
    private string _editDesc = "";
    private bool _descCopied;

    /// <summary>Copia TODA la descripcion de la tarea al portapapeles y muestra un "Copiado" breve.</summary>
    private async Task CopyDescriptionAsync()
    {
        if (string.IsNullOrWhiteSpace(_detail?.Description)) { return; }
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _detail.Description);
            _descCopied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _descCopied = false;
        }
        catch (Microsoft.JSInterop.JSException) { /* portapapeles no disponible: se ignora en silencio */ }
        catch (InvalidOperationException) { /* prerender: sin JS todavia */ }
    }
    private DateTime? _editDue;
    private DateTime? _editStart;
    private bool _confirmClose;
    private bool _confirmArchive;
    private string? _conflict;
    private string? _actionError;
    private string? _reloadError;

    // Worklog
    private bool _timerRunning;
    private string _timerNote = "";
    private int? _manualHours;
    private int? _manualMinutes;
    private string? _workLogError;

    // Valor recien copiado al portapapeles (email/telefono/nombre del contacto): muestra "Copiado" ~1.4s.
    private string? _copiedValue;

    private string _newComment = "";
    private string _attName = "";
    private string _attUrl = "";
    private string? _attError;
    private bool _attDragOver;
    private bool _attUploading;
    private const long MaxAttBytes = 25 * 1024 * 1024; // 25 MB por archivo (no video)
    private const long MaxVideoBytes = 200 * 1024 * 1024; // 200 MB para video (evidencias mas pesadas)
    private static readonly HashSet<string> VideoExt = new(StringComparer.OrdinalIgnoreCase)
    {
        ".mp4", ".webm", ".mov", ".m4v", ".mkv", ".avi", ".ogg"
    };

    // Tablero de actividades (ADR-0020, ola 2): columnas para "Mover a", checklist y asignados.
    private List<ActivityBoardColumnDto> _boardColumns = new();
    private List<string> _closeReasons = new();
    // Prompt de motivo de cierre: columna final pendiente de confirmar + su indice de drop.
    private ActivityBoardColumnDto? _pendingCloseColumn;
    private int _pendingCloseSort;
    private string? _moveNote;
    private string _newCheckText = "";
    private string _addAssigneeId = "";

    // Etiquetas asignables a la tarea (las permitidas por su columna, o todo el catalogo si la
    // columna no restringe). Se recargan con la tarea porque cambian al mover de columna.
    private List<TaskItemTagDto> _assignableTags = new();
    private bool _tagMenuOpen;

    // Formularios del paso del flujo (FASE 4 ola 2, ADR-0015).
    private List<TaskStepFormDto> _stepForms = new();
    // Formularios de la tarea por GENERO (una definicion = un genero): concepto + flujo + derivados. Se pintan
    // en UNA lista uniforme (los generos vacios no aportan items). Excluye la respuesta del paso ACTUAL (esa se
    // ve en "Formularios del proceso"). El conjunto completo (incl. vacios) alimenta el selector de "+ Agregar".
    private IReadOnlyList<TaskConceptFormsDto> _generos = [];
    // Tipos de formulario que se pueden agregar (los generos configurados). Si hay varios, el boton "+ Agregar"
    // abre un modal para elegir cual.
    private List<(Guid DefinitionId, string Title)> _addableGeneros = new();
    private bool _addPickerOpen;
    // Formulario abierto en el modal editor (una cotizacion del concepto o un formulario del paso).
    private OpenFormState? _openForm;
    private Guid? _actorTenantUserId;

    /// <summary>Estado del modal editor: que respuesta se esta viendo/editando y en que modo.</summary>
    private sealed record OpenFormState(
        Guid DefinitionId, Guid ResponseId, string? Reference, string Title,
        FormRenderMode Mode, bool IsStep, TaskStepFormDto? Step,
        Ecorex.Domain.Enums.FormCardLayout Layout = Ecorex.Domain.Enums.FormCardLayout.Normal);

    /// <summary>Ancho del modal del formulario segun su CardLayout (Normal/Ancho/Completo), para que el
    /// formulario no salga en un modal chico. Sin ApplyCardWidth, la tarjeta LLENA el modal, asi que el
    /// tamano del modal es el ancho efectivo del formulario.</summary>
    private string FormModalWidthStyle() => _openForm?.Layout switch
    {
        Ecorex.Domain.Enums.FormCardLayout.Completo => "width:min(1600px,96vw);max-width:96vw;",
        Ecorex.Domain.Enums.FormCardLayout.Ancho => "width:min(1200px,94vw);max-width:94vw;",
        _ => "width:min(880px,94vw);max-width:94vw;",
    };

    // Pasos del flujo atendibles por el usuario (bandeja, ola F2, ADR-0036).
    private List<PendingStepDto> _flowSteps = new();

    // Diagrama del flujo de la tarea (ADR-0051): grafo + estado por nodo, para pintar el proceso.
    private TaskFlowDiagramDto? _flowDiagram;
    private Guid? _flowMenuNodeId;   // nodo cuyo menu (anotar/cerrar/rutas) esta abierto
    private string _flowNote = "";   // anotacion del menu del nodo actual (cierre/ruta)
    private string _teamNote = "";   // nota colaborativa del equipo (ADR-0071), por nodo

    // Tabs del modal (ADR-0051): Detalle / Formularios / Documentos, con la Bitacora en columna lateral.
    private string _modalTab = "detalle";
    // Vista de documentos: galeria / lista / visor (con mini-galeria) + indice del documento en el visor.
    private string _docMode = "galeria";
    private int _docIndex;

    public async Task OpenAsync(Guid taskId)
    {
        _users = (await TenantUsersSvc.ListAsync()).ToList();
        _types = (await TypesSvc.ListAsync(includeArchived: true)).ToList();
        _projects = (await ProjectsSvc.ListAsync(includeArchived: true)).ToList();
        _editingTitle = _editingDesc = _confirmClose = _confirmArchive = false;
        _conflict = _actionError = _workLogError = _attError = _moveNote = null;
        _openMenu = null;
        _timerRunning = false;
        // El cronometro vive en un singleton JS a nivel de PAGINA: si no se reinicia al abrir, un valor
        // acumulado de OTRA tarea (o de una sesion anterior) sobrevive y luego PISA el tiempo manual al
        // guardar. Se reinicia a 0 en cada apertura para que cada tarea arranque limpia.
        try { await JS.InvokeVoidAsync("ecorexTaskTimer.reset"); } catch { /* aun sin render: best-effort */ }
        _timerNote = _newComment = _attName = _attUrl = "";
        _newCheckText = "";
        _addAssigneeId = "";
        _tagMenuOpen = false;
        _manualHours = _manualMinutes = null;
        // Diagrama del flujo: al abrir OTRA tarea, reinicia zoom y los desplazamientos de arrastre.
        _flowOffsets.Clear();
        _flowZoom = 1;
        _flowDragNode = null;
        // Tabs/visor de documentos: al abrir OTRA tarea, vuelve al Detalle y a la galeria.
        _modalTab = "detalle";
        _docMode = "galeria";
        _docIndex = 0;
        await ReloadAsync(taskId);
        StateHasChanged();
    }

    // Serializa recargas solapadas del modal (una mutacion + su ReloadAsync vs. otra recarga por
    // broadcast) para que no corran a la vez sobre el mismo DbContext.
    private readonly SemaphoreSlim _reloadLock = new(1, 1);

    private async Task ReloadAsync(Guid taskId)
    {
        // Recarga AISLADA + RESILIENTE. La recarga encadena ~10 consultas; si comparte el DbContext del
        // circuito con la recarga del tablero (que se dispara por broadcast tras una mutacion) EF lanza
        // "second operation on this context instance". Por eso corre en un scope EF PROPIO
        // (ScopeFactory.CreateAsyncScope) con AmbientTenantContext.Begin para que el filtro global por
        // tenant resuelva fuera del circuito, y serializada por _reloadLock. Un error transitorio de BD
        // NO debe tumbar el circuito Blazor: se captura, se avisa para reintentar y el modal sigue usable.
        await _reloadLock.WaitAsync();
        try
        {
            var tenantId = await TenantIdAsync();
            var actor = await ActorAsync();
            if (tenantId is Guid tg)
            {
                using var ambient = Ecorex.SuperAdmin.Auth.AmbientTenantContext.Begin(tg, actor);
                await using var scope = ScopeFactory.CreateAsyncScope();
                var sp = scope.ServiceProvider;
                await ReloadCoreAsync(taskId, actor,
                    sp.GetRequiredService<ITaskItemService>(),
                    sp.GetRequiredService<IFormResponseService>(),
                    sp.GetRequiredService<IWorkflowInboxService>(),
                    sp.GetRequiredService<IActivityBoardService>(),
                    sp.GetRequiredService<ITaskFieldService>());
            }
            else
            {
                // Sin tenant en el claim (caso raro): cae a los servicios del circuito.
                await ReloadCoreAsync(taskId, actor, TasksSvc, FormResponsesSvc, InboxSvc, BoardsSvc, FieldSvc);
            }
        }
        finally
        {
            _reloadLock.Release();
        }
    }

    // Cuerpo de la recarga contra los servicios que se le pasen (los del scope FRESCO en el caso normal).
    private async Task ReloadCoreAsync(Guid taskId, Guid actor,
        ITaskItemService tasksSvc, IFormResponseService formsSvc, IWorkflowInboxService inboxSvc,
        IActivityBoardService boardsSvc, ITaskFieldService fieldSvc)
    {
        try
        {
        _detail = await tasksSvc.GetDetailAsync(taskId);
        if (_detail is not null)
        {
            _totalSeconds = _detail.TotalWorkSeconds;
            _editDue = _detail.Item.DueDate?.ToLocalTime().DateTime.Date;
            _editStart = _detail.Item.StartDate?.ToLocalTime().DateTime.Date;
            // Paso(s) ACTUAL(es) del flujo: crea borrador+link idempotente si el nodo tiene formulario. Se carga
            // PRIMERO para que ese formulario ya EXISTA como respuesta y aparezca como tarjeta en _generos; ademas
            // aporta la metadata (NodeName, ruta/compuerta) para el boton "Diligenciar" de esa tarjeta.
            _stepForms = (await formsSvc.GetTaskStepFormsAsync(taskId)).ToList();
            // Formularios de la tarea por GENERO (concepto + flujo + derivados), incluidos los vacios y el del
            // paso actual (que se pinta como una tarjeta mas, cruzado por ResponseId con _stepForms).
            _generos = (await formsSvc.GetTaskFormGenerosAsync(taskId)).ToList();
            // Tipos que ofrece el boton "+ Agregar" (generos configurados; los HEREDADOS del padre no se agregan aqui).
            _addableGeneros = _generos.Where(g => !g.Inherited).Select(g => (g.DefinitionId, g.FormTitle)).ToList();
            // Etiquetas que se pueden poner AQUI: las de la columna (restriccion) o el catalogo.
            _assignableTags = (await tasksSvc.ListAssignableTagsForTaskAsync(taskId)).ToList();
            _actorTenantUserId = _users.FirstOrDefault(u => u.PlatformUserId == actor)?.Id;
            // Pasos del flujo de ESTA tarea que el usuario puede atender (bandeja, ola F2).
            // La query ya se limita a instancias Running; filtramos a esta tarea.
            _flowSteps = _actorTenantUserId is Guid me
                ? (await inboxSvc.GetMyPendingStepsAsync(me)).Where(s => s.TaskItemId == taskId).ToList()
                : new List<PendingStepDto>();
            _flowDiagram = null;
            _flowMenuNodeId = null;
            _flowNote = "";
            // Columnas del tablero para el dropdown "Mover a" (solo si la tarea esta en un tablero).
            _boardColumns = new List<ActivityBoardColumnDto>();
            _closeReasons = new List<string>();
            if (_detail.Item.BoardId is Guid boardId)
            {
                var board = await boardsSvc.GetBoardDetailAsync(boardId, new ActivityBoardDetailFilter());
                if (board.IsOk)
                {
                    _boardColumns = board.Value!.Columns.ToList();
                    _closeReasons = (board.Value.CloseReasons ?? Array.Empty<string>()).ToList();
                }
            }

            // Campos personalizados del tablero (ADR-0065): definiciones del board + valores capturados.
            _customFields = _detail.Item.BoardId is Guid cfBoardId
                ? await fieldSvc.ListByBoardAsync(cfBoardId)
                : [];
            LoadCustomFieldValues(_detail.CustomFieldsJson);
            _customDirty = false;
            RecalcCustomCalculated();

            // Diagrama del flujo (ADR-0051): OPCIONAL y al FINAL, para que su carga no afecte lo esencial.
            // Si falla (p.ej. un corte transitorio de la BD por el tunel de dev), se degrada a "sin
            // diagrama" SIN tumbar el circuito ni impedir abrir la tarea. Ensancha el modal y pinta el
            // estado del flujo; el menu de cada nodo actual mio permite cerrar EN ORDEN con nota.
            if (_actorTenantUserId is Guid meForFlow)
            {
                try
                {
                    _flowDiagram = await inboxSvc.GetTaskFlowDiagramAsync(taskId, meForFlow);
                }
                catch (Exception ex)
                {
                    _flowDiagram = null;
                    Console.Error.WriteLine($"[TaskDetailModal] diagrama de flujo no disponible: {ex.Message}");
                }
            }
        }
            _reloadError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _reloadError = "No se pudo recargar la tarea (revisa la conexion). Reintenta.";
            Console.Error.WriteLine($"[TaskDetailModal] recarga fallida: {ex.Message}");
        }
    }

    // ===== Tablero de actividades: mover a columna (ADR-0020) =====

    private string? CurrentColumnName()
        => _boardColumns.FirstOrDefault(c => c.Id == _detail?.Item.ColumnId)?.Name;

    private string CurrentColumnDot()
    {
        var idx = _boardColumns.FindIndex(c => c.Id == _detail?.Item.ColumnId);
        return idx < 0 ? "var(--ink-3, #A2A2AC)" : AbUi.ColumnDot(idx);
    }

    private string ProgressColor()
    {
        var idx = _boardColumns.FindIndex(c => c.Id == _detail?.Item.ColumnId);
        return idx < 0 ? "var(--brand, var(--primary))" : AbUi.ColumnProgressColor(idx);
    }

    private int ChecklistDone() => _detail?.Checklist.Count(c => c.IsCompleted) ?? 0;

    private int ChecklistPct()
        => _detail is null || _detail.Checklist.Count == 0
            ? 0
            : (int)Math.Round(ChecklistDone() * 100.0 / _detail.Checklist.Count, MidpointRounding.AwayFromZero);

    // Subtareas + progreso COMBINADO (checklist + subtareas): lo que muestra la barra "Avance".
    // El % del padre agrega las subtareas terminadas (decision ADR-0065).
    private int SubtaskDone() => _detail?.Subtasks?.Count(s => s.Status is TaskItemStatus.Done or TaskItemStatus.Closed) ?? 0;
    private int SubtaskTotal() => _detail?.Subtasks?.Count ?? 0;
    private int ProgressDone() => ChecklistDone() + SubtaskDone();
    private int ProgressTotal() => (_detail?.Checklist.Count ?? 0) + SubtaskTotal();
    private int ProgressPctCombined()
    {
        var total = ProgressTotal();
        return total == 0 ? 0 : (int)Math.Round(ProgressDone() * 100.0 / total, MidpointRounding.AwayFromZero);
    }

    private string _newSubtaskText = "";

    private async Task AddSubtaskAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_newSubtaskText)) { return; }
        _busy = true;
        try
        {
            var result = await TasksSvc.CreateSubtaskAsync(
                _detail.Item.Id, _newSubtaskText.Trim(), null, await ActorAsync(), await ActorNameAsync());
            if (!result.IsOk)
            {
                _actionError = result.Error;
                return;
            }
            _newSubtaskText = "";
            await ReloadAsync(_detail!.Item.Id);
            await NotifyChangedAsync(_detail!.Item.Id, _detail.Item.Status);
        }
        finally { _busy = false; }
    }

    // Abre una subtarea (o vuelve al padre) recargando el MISMO modal con esa tarea.
    private async Task OpenSubtaskAsync(Guid taskId) => await ReloadAsync(taskId);

    private async Task MoveToColumnAsync(ActivityBoardColumnDto target)
    {
        if (_detail is null) { return; }
        if (_detail.Item.ColumnId == target.Id) { _openMenu = null; return; }
        // Si la columna destino es FINAL y el tablero tiene motivos configurados, se pregunta el motivo
        // (opcional) antes de mover. En cualquier otro caso, se mueve directo (comportamiento de siempre).
        if (target.IsDone && _closeReasons.Count > 0)
        {
            _pendingCloseColumn = target;
            _pendingCloseSort = target.Cards.Count == 0 ? 0 : target.Cards.Max(c => c.BoardSortOrder) + 1;
            _openMenu = null;
            return;
        }
        await DoMoveAsync(target, target.Cards.Count == 0 ? 0 : target.Cards.Max(c => c.BoardSortOrder) + 1, null);
    }

    /// <summary>Confirma el movimiento a la columna final pendiente con el motivo elegido (o sin motivo).</summary>
    private async Task ConfirmCloseAsync(string? reason)
    {
        if (_pendingCloseColumn is null) { return; }
        var col = _pendingCloseColumn;
        var sort = _pendingCloseSort;
        _pendingCloseColumn = null;
        await DoMoveAsync(col, sort, reason);
    }

    private async Task DoMoveAsync(ActivityBoardColumnDto target, int sortOrder, string? closeReason)
    {
        if (_detail is null) { return; }
        _busy = true;
        _moveNote = null;
        try
        {
            var taskId = _detail.Item.Id;
            var result = await BoardsSvc.MoveTaskAsync(taskId, target.Id, sortOrder, await ActorAsync(), await ActorNameAsync(), closeReason);
            if (!result.IsOk)
            {
                _actionError = result.Error;
                return;
            }
            _moveNote = result.Value!.StatusNote;
            await ReloadAsync(taskId);
            await NotifyChangedAsync(taskId, result.Value.Status);
        }
        finally
        {
            _busy = false;
            _openMenu = null;
        }
    }

    // ===== Etiquetas (varias por tarea; la columna puede restringir cuales) =====

    private async Task AttachTagAsync(Guid tagId)
    {
        if (_detail is null) { return; }
        _busy = true;
        _actionError = null;
        try
        {
            var result = await TasksSvc.AttachTagAsync(_detail.Item.Id, tagId);
            // El servicio es el guardian de la restriccion por columna: si rechaza, se muestra el
            // motivo (p.ej. la etiqueta no esta permitida en la columna actual).
            if (!result.IsOk) { _actionError = result.Error; return; }
            _tagMenuOpen = false;
            // Actualizacion LOCAL de las etiquetas, sin recargar todo el detalle. Un ReloadAsync
            // aqui reejecuta GetDetailAsync (6+ consultas contra la BD, por tunel en dev) SOLO para
            // reflejar una etiqueta; ademas era donde se disparaba el fallo de render. La etiqueta ya
            // se guardo; basta reflejarla en el DTO en memoria.
            AplicarEtiquetas(AgregarTag(tagId));
            await NotifyChangedAsync(_detail!.Item.Id, _detail.Item.Status);
        }
        finally { _busy = false; }
    }

