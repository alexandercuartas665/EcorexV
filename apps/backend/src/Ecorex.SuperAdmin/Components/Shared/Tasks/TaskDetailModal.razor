    /// <summary>Linea del footer del nodo: cargo y (si hay) el usuario que lo ocupa. "Cargo: Usuario".</summary>
    private static string FlowCargoLine(TaskFlowNodeDto n)
    {
        var user = FlowShortName(n.AssigneeLabel);
        if (!string.IsNullOrWhiteSpace(n.CargoLabel) && !string.IsNullOrWhiteSpace(user)) { return $"{n.CargoLabel}: {user}"; }
        if (!string.IsNullOrWhiteSpace(n.CargoLabel)) { return n.CargoLabel!; }
        return string.IsNullOrWhiteSpace(user) ? "sin asignar" : user;
