    /// <summary>Lista de etiquetas con la nueva agregada (si no estaba ya), ordenada por nombre.</summary>
    private IReadOnlyList<TaskItemTagDto> AgregarTag(Guid tagId)
    {
        if (_detail!.Item.Tags.Any(t => t.Id == tagId)) { return _detail.Item.Tags; }
        var dto = _assignableTags.FirstOrDefault(t => t.Id == tagId);
        if (dto is null) { return _detail.Item.Tags; }
        return _detail.Item.Tags.Append(dto).OrderBy(t => t.Name).ToList();
    }

