        // clampa para que quepa en el viewport. Si falla, cae a 0,0 (raro) sin romper el circuito.
        try
        {
            var rect = await JS.InvokeAsync<FlowAnchorRect?>("ecorexFlow.anchorRect", n.NodeId);
            _flowMenuLeft = rect?.Left ?? 0;
            _flowMenuTop = rect?.Top ?? 0;
        }
        catch { _flowMenuLeft = 0; _flowMenuTop = 0; }
    }

