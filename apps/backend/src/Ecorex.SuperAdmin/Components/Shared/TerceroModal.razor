@* TerceroModal: editor compartido de Tercero (crear / editar) reusado por Directorio General
   (000232) y Cargador de contactos (000740). Un contacto ES un cliente: ambos modulos se
   alimentan de los MISMOS registros (Tercero). Contiene el modal grande (pestanas Datos /
   Relaciones / Contacto Cliente / Actividades) y el sub-modal de contacto de relacion. El host
   lo invoca por @@ref: OpenCreate() / OpenEditAsync(id) / OpenContacto(parentId, c) y refresca su
   propia lista al recibir OnChanged. Estilos scoped en TerceroModal.razor.css (copia de los dg-*
   del Directorio para fidelidad milimetrica). Solo ASCII. *@
@using System.Text.Json
@using System.Globalization
@using Ecorex.Application.Directorio
@using Ecorex.Application.Catalogos
@using Ecorex.Application.Formulas
@using Ecorex.Application.Gestor
@using Ecorex.Application.Roles
@using Ecorex.Domain.Enums
@using Ecorex.Application.Forms
@using Ecorex.SuperAdmin.Auth
@using Ecorex.SuperAdmin.Components.Shared.Forms
@inject ITerceroService TerceroSvc
@inject ITerceroFieldService FieldSvc
@inject ITerceroFormService FormsSvc
@inject IGestorContactosService GestorSvc
@inject Ecorex.Application.Crm.IConceptoActividadService ConceptosSvc
@inject ICurrentPermissions Perms
@inject Ecorex.Application.Tenancy.ITaskItemService TasksSvc
@inject Ecorex.Application.Catalogos.ICiudadCatalogService CiudadSvc
@inject Ecorex.Application.Asesores.IAsesorService AsesorSvc

@* ===================== MODAL CONTACTO (agregar / editar contacto de un tercero) ===================== *@
@if (_coOpen)
{
    <div class="dg-overlay sm" @onclick="CloseContacto">
        <div class="dg-modal sm" @onclick:stopPropagation="true">
            <div class="dg-as-head">
                <div>
                    <div class="dg-as-kicker">@(_coEditId is null ? "AGREGAR CONTACTO" : "EDITAR CONTACTO")</div>
                    <div class="dg-as-title">@(string.IsNullOrWhiteSpace(_coNombre) ? "Nuevo contacto" : _coNombre)</div>
                    <div class="dg-as-sub">Persona de contacto vinculada a este tercero.</div>
                </div>
                <button class="dg-close" @onclick="CloseContacto">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="dg-co-body">
                <div style="min-width:0">
                    <label class="dg-flabel">Nombre <span class="dg-req">*</span></label>
                    <input class="dg-input" @bind="_coNombre" />
                </div>
                <div style="min-width:0">
                    <label class="dg-flabel">Cargo</label>
                    <input class="dg-input" @bind="_coCargo" />
                </div>
                <div style="min-width:0">
                    <label class="dg-flabel">Correo</label>
                    <input class="dg-input" @bind="_coEmail" />
                </div>
                <div style="min-width:0">
                    <label class="dg-flabel">Telefono</label>
                    <input class="dg-input" @bind="_coTelefono" />
                </div>
                @if (_coError is not null)
                {
                    <div class="dg-note-err" style="grid-column:1/-1">@_coError</div>
                }
            </div>
            <div class="dg-m-foot">
                <span class="dg-foot-note"></span>
                <div class="dg-foot-actions">
                    <button class="dg-btn-ghost" @onclick="CloseContacto" disabled="@_busy">Cancelar</button>
                    <button class="dg-btn-new" @onclick="SaveContactoAsync" disabled="@_busy">Guardar contacto</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===================== MODAL CREAR / EDITAR ===================== *@
@if (_modalOpen)
{
    <div class="dg-overlay" @onclick="BackOrCloseAsync">
        <div class="dg-modal" @onclick:stopPropagation="true">
            <div class="dg-m-head">
                <span class="dg-m-av" style="background:@AvatarColor(TituloModal())">@Initials(TituloModal())</span>
                <div style="flex:1;min-width:0">
                    @* El kicker dice en que directorio se esta trabajando: es lo que decide la ficha. *@
                    <div class="dg-m-kicker">@(_editingId is not null ? "EDITAR TERCERO" : _returnToParentId is not null ? "NUEVO CONTACTO" : "NUEVO TERCERO") &middot; @DirectorioNombre().ToUpperInvariant()</div>
                    <div class="dg-m-title">@TituloModal()</div>
                </div>
                <button class="dg-close" @onclick="BackOrCloseAsync">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="dg-m-tabs">
                <button class="dg-m-tab @(_mTab == "datos" ? "active" : "")" @onclick='() => _mTab = "datos"'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" /></svg>Datos
                </button>
                <button class="dg-m-tab @(_mTab == "rel" ? "active" : "")" @onclick='() => _mTab = "rel"'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 8v8M18 8v2a4 4 0 0 1-4 4H6" /></svg>Relaciones
                    @if (_editingId is not null && _relContactos.Count > 0)
                    {
                        <span class="dg-m-tab-badge" title="@_relContactos.Count contacto(s) relacionado(s)">@_relContactos.Count</span>
                    }
                </button>
                <button class="dg-m-tab @(_mTab == "notas" ? "active" : "")" @onclick='() => _mTab = "notas"'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>Contacto Cliente
                </button>
                <button class="dg-m-tab @(_mTab == "acts" ? "active" : "")" @onclick='() => _mTab = "acts"'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>Actividades
                </button>
            </div>

            <div class="dg-m-body">
                <div class="dg-m-main">
                    @if (_mTab == "datos")
                    {
                        @* ---- Fichas apiladas. La primera es PUBLICO (los datos basicos, que viven en
                             columnas de la tabla) y siempre esta. Debajo, la ficha del DIRECTORIO desde
                             el que se abrio el modal: el tercero ya no se clasifica con chips. ---- *@
                        <div class="dg-fichas">
                            <div class="dg-ficha">
                                <div class="dg-ficha-head">
                                    <span class="dg-ficha-ic" style="background:var(--brand-soft);color:var(--brand)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" /></svg>
                                    </span>
                                    <div style="flex:1;min-width:0">
                                        <div class="dg-ficha-title">Publico</div>
                                        <div class="dg-ficha-desc">Datos basicos del tercero, visibles en todos los directorios</div>
                                    </div>
                                </div>
                                <div class="dg-ficha-body">
                                @* CRITERIO DE BUSQUEDA: identificador (IDE), telefono o correo. Trae el
                                   registro existente y lo carga en el modal, para no duplicar terceros. *@
                                <div class="dg-idbox dg-topbox">
                                    <div class="dg-busca-row">
                                        <div style="flex:1;min-width:0">
                                            <label class="dg-idbox-lbl">CRITERIO BUSQUEDA</label>
                                            <input class="dg-input tall" placeholder="Identificador, telefono o correo..."
                                                   value="@_criterio"
                                                   @oninput="e => _criterio = e.Value?.ToString() ?? string.Empty"
                                                   @onkeydown="OnCriterioKeyDown" />
                                        </div>
                                        <button class="dg-btn-cfg dg-busca-btn" @onclick="BuscarCriterioAsync" disabled="@_busy">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                                            Buscar
                                        </button>
                                    </div>
                                    @if (_criterioMsg is not null)
                                    {
                                        <div class="dg-idnote">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" /></svg>
                                            @_criterioMsg
                                        </div>
                                    }
                                </div>

                                <div class="dg-fields">
                                    @* --- Fila de identificacion: codigo / IDE / clase --- *@
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Codigo</label>
                                        <input class="dg-input" disabled title="Campo pendiente de definir: no se guarda todavia." />
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">IDE</label>
                                        <input class="dg-input" maxlength="20" placeholder="Maximo 20 caracteres" @bind="_mIdValor" />
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Clase</label>
                                        <input class="dg-input" disabled title="Campo pendiente de definir: no se guarda todavia." />
                                    </div>

                                    @* --- Empresa --- *@
                                    <div style="min-width:0" class="dg-fld-sep-row">
                                        <div class="dg-fld-sep">EMPRESA</div>
                                    </div>
                                    <div style="min-width:0" class="dg-fld-med">
                                        <label class="dg-flabel">Nombre empresa</label>
                                        <input class="dg-input" @bind="_empNombre" disabled="@EmpresaBloqueada" />
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Telefono empresa</label>
                                        <input class="dg-input" @bind="_empTelefono" disabled="@EmpresaBloqueada" />
                                    </div>
                                    @if (EmpresaBloqueada)
                                    {
                                        <div style="min-width:0" class="dg-fld-full">
                                            <p class="dg-hint">La empresa de este contacto se edita abriendola desde el listado.</p>
                                        </div>
                                    }

                                    @* --- Contacto --- *@
                                    <div style="min-width:0" class="dg-fld-sep-row">
                                        <div class="dg-fld-sep">CONTACTO</div>
                                    </div>
                                    <div style="min-width:0" class="dg-fld-med">
                                        <label class="dg-flabel">Contacto</label>
                                        <input class="dg-input" @bind="_conNombre" disabled="@ContactoBloqueado" />
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Cargo</label>
                                        <input class="dg-input" @bind="_conCargo" disabled="@ContactoBloqueado" />
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Telefono contacto</label>
                                        <input class="dg-input" @bind="_conTelefono" disabled="@ContactoBloqueado" />
                                    </div>
                                    <div style="min-width:0" class="dg-fld-med">
                                        <label class="dg-flabel">Correo electronico</label>
                                        <input class="dg-input" type="email" @bind="_conEmail" disabled="@ContactoBloqueado" />
                                    </div>
                                    @if (ContactoBloqueado)
                                    {
                                        <div style="min-width:0" class="dg-fld-full">
                                            <p class="dg-hint">Los contactos de esta empresa se agregan y editan en la pestana <strong>Relaciones</strong>.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="min-width:0" class="dg-fld-full">
                                            <p class="dg-hint">Debe quedar al menos un telefono: el de la empresa o el del contacto.</p>
                                        </div>
                                    }

                                    @* --- Ubicacion y auditoria --- *@
                                    <div style="min-width:0" class="dg-fld-sep-row">
                                        <div class="dg-fld-sep">UBICACION</div>
                                    </div>
                                    @* Ciudad: autocomplete contra el catalogo GLOBAL de ciudades (municipios de
                                       Colombia). Restringe la entrada a ciudades reales (se escribe para filtrar y se
                                       elige de la lista); se sigue guardando el NOMBRE en Tercero.Ciudad (string). *@
                                    <div style="min-width:0;position:relative" @onfocusout="OnCiudadBlur">
                                        <label class="dg-flabel">Ciudad</label>
                                        <input class="dg-input" placeholder="Buscar ciudad..." autocomplete="off"
                                               value="@_ciudadQuery"
                                               @oninput="OnCiudadInput"
                                               @onfocus="OnCiudadFocus" />
                                        @if (_ciudadOpen && _ciudadMatches.Count > 0)
                                        {
                                            <div class="dg-ciudad-menu">
                                                @foreach (var c in _ciudadMatches)
                                                {
                                                    var cc = c;
                                                    <button type="button" class="dg-ciudad-opt"
                                                            @onmousedown:preventDefault="true"
                                                            @onclick="() => SelectCiudad(cc)">
                                                        <span class="dg-ciudad-opt-name">@cc.Nombre</span>
                                                        @if (!string.IsNullOrWhiteSpace(cc.Departamento))
                                                        {
                                                            <span class="dg-ciudad-opt-dep">@cc.Departamento</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Pais</label>
                                        <input class="dg-input" disabled title="Campo pendiente de definir: no se guarda todavia." />
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Sector / Industria</label>
                                        <input class="dg-input" @bind="_mSector" />
                                    </div>

                                    @* Auditoria del alta: se muestra, no se captura. *@
                                    @if (_editingId is not null)
                                    {
                                        <div style="min-width:0">
                                            <label class="dg-flabel">Fecha de creacion</label>
                                            <input class="dg-input dg-input-ro" readonly
                                                   value="@(_mCreatedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "-")" />
                                        </div>
                                        <div style="min-width:0" class="dg-fld-med">
                                            <label class="dg-flabel">Usuario</label>
                                            <input class="dg-input dg-input-ro" readonly value="@(_mCreadoPor ?? "-")" />
                                        </div>
                                    }

                                    <div style="min-width:0" class="dg-fld-med">
                                        <label class="dg-flabel">Vendedor asignado</label>
                                        <select class="dg-input" @bind="MVendedorAsesorIdStr">
                                            <option value="">-- Sin asesor --</option>
                                            @foreach (var a in _asesorOptions)
                                            {
                                                <option value="@a.Id">@a.Nombre</option>
                                            }
                                        </select>
                                        @if (_mVendedorAsesorId is null && !string.IsNullOrWhiteSpace(_mVendedor))
                                        {
                                            <div style="font-size:11px;color:var(--ink-3);margin-top:3px;">Texto anterior: @_mVendedor</div>
                                        }
                                    </div>
                                    <div style="min-width:0">
                                        <label class="dg-flabel">Estado</label>
                                        <select class="dg-input" value="@_mEstado" @onchange="e => _mEstado = Enum.Parse<TerceroEstado>(e.Value!.ToString()!)">
                                            <option value="@TerceroEstado.Activo">Activo</option>
                                            <option value="@TerceroEstado.Prospecto">Prospecto</option>
                                        </select>
                                    </div>
                                </div>
                                </div>
                            </div>
                            @* La ficha del directorio queda SIEMPRE abierta: no se colapsa. Por eso no
                               hay chevron ni click en su cabecera. *@
                                        @foreach (var fc in VisibleFichas())
                                        {
                                            var fcFields = FieldsFor(fc.Key);
                                            <div class="dg-ficha">
                                                <div class="dg-ficha-head">
                                                    <span class="dg-ficha-ic" style="background:var(@fc.Bg);color:var(@fc.Color)">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="@fc.IconPath" /></svg>
                                                    </span>
                                                    <div style="flex:1;min-width:0">
                                                        <div class="dg-ficha-title">@fc.Title</div>
                                                        <div class="dg-ficha-desc">@fc.Desc</div>
                                                    </div>
                                                    <span class="dg-ficha-count">@fcFields.Count campos</span>
                                                </div>
                                                <div class="dg-ficha-body">
                                                        @if (fcFields.Count == 0)
                                                        {
                                                            <div class="dg-empty-note">Esta ficha no tiene campos. Configuralos con el boton "Configurar campos".</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="dg-fields">
                                                                @foreach (var f in fcFields)
                                                                {
                                                                    @* El ancho sale de la rejilla de 3: 1 = 1/3, 2 = 2/3, 3 = fila entera.
                                                                       Un separador siempre ocupa la fila (es un titulo, no un dato). *@
                                                                    <div style="min-width:0" class="@WidthClass(f)">
                                                                        @if (f.FieldType == TerceroFieldType.Separator)
                                                                        {
                                                                            <div class="dg-fld-sep">@f.Label</div>
                                                                        }
                                                                        else if (!string.IsNullOrWhiteSpace(f.RepeatWithFieldKey))
                                                                        {
                                                                            @* Se pide tantas veces como diga el campo que lo gobierna. *@
                                                                            <label class="dg-flabel">@f.Label</label>
                                                                            var rc = RepeatCount(fc.Key, f.RepeatWithFieldKey!);
                                                                            if (rc <= 0)
                                                                            {
                                                                                <div class="dg-rep-hint">Indica "@FieldLabel(f.RepeatWithFieldKey!)" para capturar @f.Label.</div>
                                                                            }
                                                                            else
                                                                            {
                                                                                var rvals = RepeatValues(fc.Key, f.FieldKey, rc);
                                                                                for (var ri = 0; ri < rc; ri++)
                                                                                {
                                                                                    var idx = ri;
                                                                                    <div class="dg-rep-row">
                                                                                        <span class="dg-rep-idx">@(idx + 1)</span>
                                                                                        <input class="dg-input" type="@InputType(f.FieldType)" value="@rvals[idx]"
                                                                                               @onchange="e => SetRepeatValue(fc.Key, f.FieldKey, idx, rc, e.Value?.ToString())" />
                                                                                    </div>
                                                                                }
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <label class="dg-flabel">@f.Label</label>
                                                                            @switch (f.FieldType)
                                                                            {
                                                                                case TerceroFieldType.Select:
                                                                                    <select class="dg-input" value="@GetFicha(fc.Key, f.FieldKey)" @onchange="e => SetFicha(fc.Key, f.FieldKey, e.Value?.ToString())">
                                                                                        <option value="">-</option>
                                                                                        @foreach (var o in SplitOptions(f.Options))
                                                                                        {
                                                                                            <option value="@o">@o</option>
                                                                                        }
                                                                                    </select>
                                                                                    break;
                                                                                case TerceroFieldType.TextArea:
                                                                                    <textarea class="dg-input dg-textarea" value="@GetFicha(fc.Key, f.FieldKey)" @onchange="e => SetFicha(fc.Key, f.FieldKey, e.Value?.ToString())"></textarea>
                                                                                    break;
                                                                                case TerceroFieldType.Lookup:
                                                                                    @* Lista alimentada por el Contenedor de datos. Se guarda el Id de la
                                                                                       fila; la cascada mira el formulario COMPLETO (todas las fichas). *@
                                                                                    @if (LookupCfg(f) is { } lkCfg)
                                                                                    {
                                                                                        <DataLookupField Config="lkCfg"
                                                                                                         Value="@GetFicha(fc.Key, f.FieldKey)"
                                                                                                         ValueChanged="v => SetFicha(fc.Key, f.FieldKey, v)"
                                                                                                         FormValues="TodosLosValores()"
                                                                                                         OnAutofill="AplicarAutollenado"
                                                                                                         ActorUserId="_actorId"
                                                                                                         Placeholder="@($"Buscar {f.Label.ToLowerInvariant()}...")" />
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <div class="dg-calc-warn">Este campo aun no tiene configurada su tabla de origen.</div>
                                                                                    }
                                                                                    break;
                                                                                case TerceroFieldType.Calculated:
                                                                                    @* No se captura: sale de la formula y se recalcula al escribir en sus
                                                                                       origenes (ADR-0029). Vacio = no se pudo calcular (division por cero,
                                                                                       formula rota o ciclo), y se dice, en vez de mostrar un cero enganoso. *@
                                                                                    <div class="dg-calc">
                                                                                        <input class="dg-input dg-input-ro" type="text" readonly
                                                                                               value="@(_calculated.GetValueOrDefault(f.FieldKey) ?? "")" />
                                                                                        <span class="dg-calc-ic" title="@($"Calculado: {f.Formula}")">fx</span>
                                                                                    </div>
                                                                                    @if (_calculated.TryGetValue(f.FieldKey, out var cv) && cv is null)
                                                                                    {
                                                                                        <div class="dg-calc-warn">No se puede calcular con los datos actuales.</div>
                                                                                    }
                                                                                    break;
                                                                                default:
                                                                                    <input class="dg-input" type="@InputType(f.FieldType)" value="@GetFicha(fc.Key, f.FieldKey)" @onchange="e => SetFicha(fc.Key, f.FieldKey, e.Value?.ToString())" />
                                                                                    break;
                                                                            }
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                            </div>
                                        }
                            @if (DirectorioFicha() is null)
                            {
                                <p class="dg-dir-note">
                                    Estas en el directorio <strong>Publico</strong>: aqui solo se capturan los datos
                                    basicos. Para llenar una ficha (fiscal, comercial, cartera, proveedor o laboral),
                                    abre el tercero desde ese directorio.
                                </p>
                            }
                        </div>
                    }
                    else if (_mTab == "rel")
                    {
                        @if (_editingId is null)
                        {
                            <div class="dg-ph">
                                <div>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 8v8M18 8v2a4 4 0 0 1-4 4H6" /></svg>
                                    <h4>Relaciones</h4>
                                    <p>Guarda el tercero primero para vincularle contactos y relaciones.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="dg-rel">
                                <div class="dg-rel-head">
                                    <div>
                                        <div class="dg-sec-lbl">CONTACTOS DE RELACION</div>
                                        <p class="dg-rel-note">Personas de contacto vinculadas a este tercero (reportan, gestionan o representan).</p>
                                    </div>
                                    <button class="dg-kids-add" @onclick="() => OpenCreateContactAsync(_editingId!.Value, _editingId)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                                        Agregar contacto
                                    </button>
                                </div>
                                @if (_relContactos.Count == 0)
                                {
                                    <div class="dg-empty-note">Sin contactos de relacion todavia.</div>
                                }
                                else
                                {
                                    <div class="dg-rel-list">
                                        @foreach (var k in _relContactos)
                                        {
                                            <div class="dg-kid">
                                                <span class="dg-kid-av" style="background:@AvatarColor(k.Nombre)">@Initials(k.Nombre)</span>
                                                <div style="flex:1;min-width:0">
                                                    <div class="dg-kid-name">@k.Nombre</div>
                                                    <div class="dg-kid-cargo">@(string.IsNullOrWhiteSpace(k.Cargo) ? "Contacto" : k.Cargo)</div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(k.Email))
                                                {
                                                    <span class="dg-kid-meta">@k.Email</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(k.Telefono))
                                                {
                                                    <span class="dg-kid-meta">@k.Telefono</span>
                                                }
                                                <div class="dg-kid-acts">
                                                    @if (k.EsTercero)
                                                    {
                                                        <button class="dg-act edit" title="Editar contacto" @onclick="() => OpenEditAsync(k.Id, _editingId)">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                                        </button>
                                                        <button class="dg-act del" title="Quitar de la empresa" @onclick="() => UnassignContactoAsync(k.Id)" disabled="@_busy">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="dg-act edit" title="Editar contacto" @onclick="() => OpenContacto(_editingId!.Value, k)">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                                        </button>
                                                        <button class="dg-act del" title="Eliminar contacto" @onclick="() => DeleteContactoAsync(_editingId!.Value, k.Id)" disabled="@_busy">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /></svg>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_mTab == "notas")
                    {
                        @if (_editingId is null)
                        {
                            <div class="dg-ph">
                                <div>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                                    <h4>Contacto Cliente</h4>
                                    <p>Guarda el tercero primero para registrar notas y gestiones.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="dg-notas">
                                @* --- Gestion por CONCEPTO de actividad (000125): una sola fila de botones
                                     (pildoras); cada uno abre su formulario/compositor. Sin conceptos, aviso. --- *@
                                @if (_conceptos.Count == 0)
                                {
                                    <div class="dg-empty-note">No hay conceptos de actividad configurados. Crealos en <strong>Conceptos de actividades</strong> (000125) para registrar gestiones.</div>
                                }
                                else
                                {
                                    <div class="dg-concepto-bar">
                                        @foreach (var c in _conceptos)
                                        {
                                            var cc = c;
                                            <button type="button" class="dg-concepto-pill @(_noteConcepto?.Id == cc.Id ? "on" : "")" @onclick="() => SelectConcepto(cc)">
                                                <span class="dg-concepto-ico">@((MarkupString)ConceptoIcon(cc))</span>
                                                <span class="dg-concepto-name">@cc.Name</span>
                                            </button>
                                        }
                                    </div>

                                    @if (_noteConcepto is { } conc)
                                    {
                                        <div class="dg-concepto-panel">
                                            <div class="dg-concepto-panel-head">
                                                <div>
                                                    <div class="dg-sec-lbl">NUEVA @conc.Name.ToUpperInvariant()@(conc.HandlesValues ? " (maneja valor)" : "")</div>
                                                    @if (!string.IsNullOrWhiteSpace(conc.Description))
                                                    {
                                                        <p class="dg-concepto-desc">@conc.Description</p>
                                                    }
                                                </div>
                                                <button type="button" class="dg-concepto-close" title="Cerrar" @onclick="() => { _noteConcepto = null; _noteError = null; }">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                                                </button>
                                            </div>
                                            @{
                                                var needsProc = ProcFieldsRequired(conc);
                                                var procOk = !needsProc || ProcFieldsComplete(conc);
                                            }
                                            @* Datos del PROCESO (fuera del formulario): titulo + valor (si maneja valor) +
                                               fecha (si es evento de agenda). Alimentan el modulo de Oportunidades / la agenda. *@
                                            @if (needsProc)
                                            {
                                                <div class="dg-proc">
                                                    <div class="dg-proc-row dg-proc-titulo">
                                                        <label class="dg-flabel">TITULO *</label>
                                                        <input class="dg-input" placeholder="Titulo de la gestion" @bind="_procTitulo" />
                                                    </div>
                                                    @if (conc.HandlesValues)
                                                    {
                                                        <div class="dg-proc-row dg-proc-valor">
                                                            <label class="dg-flabel">VALOR *</label>
                                                            <input class="dg-input" type="number" min="0" step="any" placeholder="0" @bind="_procValor" />
                                                        </div>
                                                    }
                                                    @if (conc.Mode == Ecorex.Domain.Enums.ConceptoActividadMode.CalendarEvent)
                                                    {
                                                        <div class="dg-proc-row dg-proc-fecha">
                                                            <label class="dg-flabel">FECHA DE LA PROXIMA ACTIVIDAD *</label>
                                                            <input class="dg-input" type="date" value="@(_procFecha?.ToString("yyyy-MM-dd"))" @onchange="e => { _procFecha = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : (DateTime?)null; }" />
                                                        </div>
                                                    }
                                                    @if (!procOk) { <p class="dg-concepto-hint">Completa los datos del proceso para continuar.</p> }
                                                    @* El error se muestra AQUI, junto a los campos que faltan: abajo del
                                                       formulario quedaba fuera de pantalla y el boton decia "Enviado". *@
                                                    @if (_noteError is not null) { <div class="dg-note-err dg-proc-err">@_noteError</div> }
                                                </div>
                                            }
                                            @* El formulario se muestra SIEMPRE: esconderlo hasta completar el proceso
                                               se leia como "no carga". El envio ya valida los campos de proceso
                                               (ver OnConceptoFormSubmittedAsync), asi que no hace falta ocultarlo. *@
                                            @if (conc.FormDefinitionId is Guid cfid)
                                            {
                                                <div class="dg-form-host" @key="@($"conc-{conc.Id}")">
                                                    <DynamicFormRenderer DefinitionId="@cfid"
                                                                         Mode="FormRenderMode.Fill"
                                                                         ShowHeader="false"
                                                                         OnSubmitted="OnConceptoFormSubmittedAsync" />
                                                </div>
                                                @if (_noteError is not null && !needsProc) { <div class="dg-note-err">@_noteError</div> }
                                            }
                                            else
                                            {
                                                <textarea class="dg-input dg-textarea" placeholder="Detalle de @conc.Name..." @bind="_noteText"></textarea>
                                                @if (_noteError is not null) { <div class="dg-note-err">@_noteError</div> }
                                                <div class="dg-note-actions">
                                                    <button class="dg-btn-new" @onclick="AddConceptoNotaAsync" disabled="@(_busy || !procOk)">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                                                        Registrar @conc.Name
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="dg-concepto-hint">Elige un concepto para registrar la gestion con el cliente.</p>
                                    }
                                }

                                @* --- Timeline --- *@
                                @if (_notas.Count == 0)
                                {
                                    <div class="dg-empty-note">Sin gestiones registradas todavia.</div>
                                }
                                else
                                {
                                    <div class="dg-note-list">
                                        @foreach (var n in _notas)
                                        {
                                            var ni = AccionInfo(n.Accion);
                                            <div class="dg-note-item">
                                                <div class="dg-note-item-head">
                                                    <span class="dg-note-tag" style="background:var(@ni.Bg);color:var(@ni.Color)">@ni.Label</span>
                                                    @if (!string.IsNullOrWhiteSpace(n.Categoria))
                                                    {
                                                        <span class="dg-note-cat">@n.Categoria@(string.IsNullOrWhiteSpace(n.Subcategoria) ? "" : " / " + n.Subcategoria)</span>
                                                    }
                                                    @if (n.Valor is decimal nv)
                                                    {
                                                        <span class="dg-note-cat" style="font-weight:700;color:var(--t-green)">@MoneyFmt(nv)</span>
                                                    }
                                                    <span class="dg-note-date">@n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                                    <button class="dg-act del" title="Eliminar" @onclick="() => DeleteNotaAsync(n.Id)" disabled="@_busy">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /></svg>
                                                    </button>
                                                </div>
                                                <div class="dg-note-text">@n.Texto</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="dg-ph">
                            <div>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                                <h4>Actividades</h4>
                                <p>Actividades ligadas a Tareas (000270). Disponible en una proxima iteracion.</p>
                            </div>
                        </div>
                    }
                </div>

                @if (_mTab == "datos")
                {
                    @* ===== Tercera columna. En el prototipo era el panel de muestra "Prospecto de
                         cliente"; su destino real son los FORMULARIOS dinamicos del tercero. Las
                         respuestas se anclan por Reference = "TERCERO:{id}" (mismo patron que el
                         arranque form-first), asi que cada tercero tiene la suya por formulario.
                         Debajo, solo en el Cargador (CrmWiring), van sus oportunidades. ===== *@
                    <aside class="dg-prosp">
                        <div class="dg-prosp-head">
                            <span class="dg-prosp-ic">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" /></svg>
                            </span>
                            <div style="flex:1;min-width:0">
                                <div class="dg-prosp-t">Formularios</div>
                                <div class="dg-prosp-s">Datos adicionales del tercero</div>
                            </div>
                            @* Badge: cuantos formularios tiene asignados este tercero. *@
                            <span class="dg-form-badge @(_forms.Count == 0 ? "zero" : "")"
                                  title="@_forms.Count formulario(s) asignado(s)">@_forms.Count</span>
                        </div>
                        @if (_editingId is null)
                        {
                            <p class="dg-aside-note">Guarda el tercero primero para llenar sus formularios asociados.</p>
                        }
                        else if (_forms.Count == 0)
                        {
                            <p class="dg-aside-note">Sin formularios asociados. Se eligen con el boton "Configurar campos" del Directorio General.</p>
                        }
                        else
                        {
                            @* Lista para elegir cual formulario llenar; el elegido se despliega debajo. *@
                            <div class="dg-form-list">
                                @foreach (var f in _forms)
                                {
                                    var ff = f;
                                    var on = _formSel == ff.FormDefinitionId;
                                    <button class="dg-form-item @(on ? "on" : "")"
                                            @onclick="() => _formSel = on ? null : ff.FormDefinitionId">
                                        <span class="dg-form-item-ic">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" /></svg>
                                        </span>
                                        <span class="dg-form-item-txt">
                                            <span class="dg-form-item-name">@ff.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(ff.Code))
                                            {
                                                <span class="dg-form-item-code">@ff.Code</span>
                                            }
                                        </span>
                                        <span class="dg-form-item-chev" style="transform:rotate(@(on ? "90deg" : "0deg"))">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
                                        </span>
                                    </button>
                                    @if (on)
                                    {
                                        <div class="dg-form-host" @key="ff.FormDefinitionId">
                                            <DynamicFormRenderer DefinitionId="@ff.FormDefinitionId"
                                                                 Reference="@ITerceroFormService.ReferenceFor(_editingId.Value)"
                                                                 Mode="FormRenderMode.Fill"
                                                                 ShowHeader="false" />
                                        </div>
                                    }
                                }
                            </div>
                            @if (_formSel is null)
                            {
                                <p class="dg-aside-note">Elige un formulario de la lista para llenarlo con los datos de este tercero.</p>
                            }
                        }

                        @if (CrmWiring && _editingId is not null)
                        {
                            @* ---- Oportunidades del tercero (Cargador de contactos 000740) ---- *@
                            <div class="dg-prosp-sep"></div>
                            <div class="dg-prosp-head">
                                <span class="dg-prosp-ic">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 19-9-9 19-2-8-8-2z" /></svg>
                                </span>
                                <div style="flex:1;min-width:0">
                                    <div class="dg-prosp-t">Oportunidades</div>
                                    <div class="dg-prosp-s">
                                        @_opps.Count(IsOpen) abiertas &#183; @MoneyFmt(_opps.Where(IsOpen).Sum(o => o.Valor))
                                        @if (_opps.Count(o => !IsOpen(o)) > 0)
                                        {
                                            <text>&nbsp;&#183; @_opps.Count(o => !IsOpen(o)) cerradas</text>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (_opps.Count == 0)
                            {
                                <div class="dg-empty-note">Sin oportunidades.</div>
                            }
                            else
                            {
                                <div class="tm-opp-list">
                                    @foreach (var o in _opps)
                                    {
                                        var oi = OppChip(o);
                                        <div class="tm-opp">
                                            <div class="tm-opp-name">@o.Nombre</div>
                                            <div class="tm-opp-foot">
                                                <span class="tm-etapa" style="background:@oi.Bg;color:@oi.Fg">@oi.Label</span>
                                                <span class="dg-money">@MoneyFmt(o.Valor)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @* Sin "agregar oportunidad" suelto: se crean desde la pildora "Oportunidad"
                               de la pestana Contacto Cliente, que las liga a su gestion. *@
                        }
                    </aside>
                }
            </div>

            <div class="dg-m-foot">
                @if (_modalError is not null)
                {
                    <span class="dg-m-error">@_modalError</span>
                }
                else
                {
                    <span class="dg-foot-note">Los campos y las fichas por perfil se guardan con el tercero.</span>
                }
                <div class="dg-foot-actions">
                    <button class="dg-btn-ghost" @onclick="BackOrCloseAsync" disabled="@_busy">@(_returnToParentId is not null ? "Volver" : "Cancelar")</button>
                    <button class="dg-btn-save" @onclick="SaveAsync" disabled="@_busy">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8M7 3v5h8" /></svg>
                        @(_editingId is null ? "Crear tercero" : "Guardar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Se dispara tras cualquier cambio persistente (crear/editar tercero, alta/baja de
    /// contacto de relacion, nota que crea cita/oportunidad) para que el host refresque su lista.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Cuando true (Cargador de contactos 000740) habilita el cableado CRM: muestra las
    /// oportunidades del tercero en el aside, la fecha de "Proxima atencion" y crea cita/oportunidad
    /// al registrar esas notas. En Directorio General (false) las notas son solo bitacora.</summary>
    [Parameter] public bool CrmWiring { get; set; }

    /// <summary>
    /// Directorio desde el que se abrio el modal. Decide DOS cosas: que ficha adicional se edita
    /// (una sola, ademas de Publico) y que perfil se marca al guardar, para que el tercero quede
    /// listado en ese directorio. En Publico no hay ficha adicional ni perfil que marcar.
    /// </summary>
    [Parameter] public TerceroTabTipo Directorio { get; set; } = TerceroTabTipo.Publico;

    // Actor para el alta de tareas-proceso (quien registra la gestion).
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private bool _busy;
    private List<OportunidadDto> _opps = new();

    // ---- Formularios asociados (3a columna). Respuestas ancladas por Reference = "TERCERO:{id}". ----
    private List<TerceroFormLinkDto> _forms = new();
    private Guid? _formSel;

    // ---- Permisos (sub-permisos nombrados del Directorio General, ADR-0033) ----
    private bool _canCrearEmpresa = true;

    // ---- Modal crear / editar ----
    private bool _modalOpen;
    private Guid? _editingId;
    // Empresa a la que pertenece este tercero (Persona). Al CREAR un contacto asociado se fija a la
    // empresa padre; al EDITAR se carga la existente para PRESERVARLA (antes se mandaba null y editar
    // una persona la desvinculaba de su empresa). null para empresas y personas individuales.
    private Guid? _empresaId;
    // Cuando se crea/edita un contacto DESDE la pestana Relaciones de una empresa, se recuerda esa
    // empresa para VOLVER a ella (a su pestana Relaciones) al guardar o cancelar. Con una sola
    // instancia de modal evitamos anidar dos TerceroModal sobre el mismo DbContext scoped.
    private Guid? _returnToParentId;
    private string _mTab = "datos";
    private TerceroTipo _mTipo = TerceroTipo.Empresa;
    private TerceroPerfil _mPerfiles = TerceroPerfil.Ninguno;
    private TerceroEstado _mEstado = TerceroEstado.Activo;
    private TerceroIdTipo _mIdTipo = TerceroIdTipo.Nit;
    private string _mIdValor = "";
    private string _mNombre = "";
    private string _mVendedor = "";
    // Vendedor asignado desde el catalogo de asesores (000074). _mVendedor queda como texto legado.
    private Guid? _mVendedorAsesorId;
    private List<Ecorex.Application.Asesores.AsesorOptionDto> _asesorOptions = new();
    private string MVendedorAsesorIdStr
    {
        get => _mVendedorAsesorId?.ToString() ?? "";
        set => _mVendedorAsesorId = Guid.TryParse(value, out var g) ? g : (Guid?)null;
    }
    private string _mCiudad = "";
    // Autocomplete de ciudad (catalogo global): _ciudadQuery es el texto que se ve/filtra; el valor
    // confirmado vive en _mCiudad (solo se escribe al elegir una ciudad real de la lista).
    private string _ciudadQuery = "";
    private bool _ciudadOpen;
    private IReadOnlyList<CiudadDto> _ciudadMatches = Array.Empty<CiudadDto>();
    private string _mSector = "";
    private readonly Dictionary<string, Dictionary<string, string>> _fichaValues = new(StringComparer.Ordinal);
    private string? _modalError;

    // ---- Formulario Publico: bloque EMPRESA y bloque CONTACTO ----
    // El formulario captura los dos lados a la vez. Al crear, se da de alta lo que este lleno: solo
    // empresa, solo contacto, o los dos vinculados (una empresa y su persona). Al editar solo se
    // toca el registro abierto; el otro bloque queda de consulta.
    private string _empNombre = "";
    private string _empTelefono = "";
    private string _conNombre = "";
    private string _conCargo = "";
    private string _conTelefono = "";
    private string _conEmail = "";

    // Auditoria de alta (solo lectura).
    private DateTimeOffset? _mCreatedAt;
    private string? _mCreadoPor;

    // Criterio de busqueda (IDE / telefono / correo) que carga un registro existente.
    private string _criterio = "";
    private string? _criterioMsg;

    /// <summary>Editando una PERSONA ya vinculada: su empresa no se edita desde aqui.</summary>
    private bool EmpresaBloqueada => _editingId is not null && _mTipo == TerceroTipo.Persona;

    /// <summary>Editando una EMPRESA: sus contactos se gestionan en la pestana Relaciones.</summary>
    private bool ContactoBloqueado => _editingId is not null && _mTipo == TerceroTipo.Empresa;

    // ---- Tab Relaciones (contactos del tercero en edicion) ----
    private IReadOnlyList<TerceroContactoDto> _relContactos = Array.Empty<TerceroContactoDto>();

    // ---- Editor de contacto (sub-modal de la pestana Relaciones y de la tabla del host) ----
    private bool _coOpen;
    private Guid _coParentId;
    private Guid? _coEditId;
    private string _coNombre = "", _coCargo = "", _coEmail = "", _coTelefono = "";
    private string? _coError;

    // ---- Tab Contacto Cliente (gestiones por concepto de actividad, 000125) ----
    private IReadOnlyList<TerceroNotaDto> _notas = Array.Empty<TerceroNotaDto>();
    private string _noteText = "";
    // Datos del PROCESO (fuera del formulario): titulo, valor (si maneja valor) y fecha de la proxima
