<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixture BPMN real del vault (flujo 00001) para los tests de import del WorkflowEngine. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ecorex.Infrastructure\Ecorex.Infrastructure.csproj" />
    <!-- Migraciones del proveedor SQL Server: MigrateAsync con MigrationsAssembly
         "Ecorex.Infrastructure.SqlServer" necesita el ensamblado en el output (ADR-001). -->
    <ProjectReference Include="..\..\src\Ecorex.Infrastructure.SqlServer\Ecorex.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Ecorex.Application\Ecorex.Application.csproj" />
    <ProjectReference Include="..\..\src\Ecorex.Shared\Ecorex.Shared.csproj" />
    <ProjectReference Include="..\..\src\Ecorex.Api\Ecorex.Api.csproj" />
    <!-- SuperAdmin: orquestacion del refresco (ProcessRunner + ImportRunLog) que encadena las derivadas
         cuando se sincroniza su tabla origen (ADR-0127). Con alias 'superadmin' para que su clase global
         Program no choque con la de Ecorex.Api (ambas son top-level); el WebApplicationFactory<Program> de
         las pruebas de API sigue resolviendo la de Api. -->
    <ProjectReference Include="..\..\src\Ecorex.SuperAdmin\Ecorex.SuperAdmin.csproj" Aliases="superadmin" />
  </ItemGroup>

</Project>
